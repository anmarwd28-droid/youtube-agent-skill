[{"text": "What if gravity disappeared… for just five seconds?", "start": 0.0, "end": 3.71, "words": [["What", 0.0, 0.23], ["if", 0.27, 0.35], ["gravity", 0.43, 1.0], ["disappeared…", 1.07, 1.89], ["for", 2.28, 2.42], ["just", 2.47, 2.67], ["five", 2.73, 3.03], ["seconds?", 3.08, 3.71]]}, {"text": "Instantly, you'd weigh nothing. And you'd start to drift up.", "start": 4.04, "end": 7.42, "words": [["Instantly,", 4.04, 4.7], ["you'd", 4.74, 4.91], ["weigh", 4.96, 5.12], ["nothing.", 5.18, 5.68], ["And", 6.06, 6.19], ["you'd", 6.25, 6.4], ["start", 6.42, 6.65], ["to", 6.69, 6.73], ["drift", 6.79, 7.07], ["up.", 7.14, 7.42]]}, {"text": "Because Earth spins. At the equator, the ground carries you at about sixteen hundred and seventy kilometres an hour.", "start": 7.74, "end": 14.2, "words": [["Because", 7.74, 8.08], ["Earth", 8.15, 8.36], ["spins.", 8.42, 9.12], ["At", 9.57, 9.71], ["the", 9.74, 9.82], ["equator,", 9.88, 10.41], ["the", 10.44, 10.52], ["ground", 10.56, 10.81], ["carries", 10.88, 11.19], ["you", 11.24, 11.32], ["at", 11.39, 11.46], ["about", 11.49, 11.71], ["sixteen", 11.8, 12.25], ["hundred", 12.32, 12.57], ["and", 12.61, 12.68], ["seventy", 12.75, 13.13], ["kilometres", 13.19, 13.66], ["an", 13.7, 13.76], ["hour.", 13.79, 14.2]]}, {"text": "With nothing holding you down, you'd fly off in a straight line… as the ground curves away below you.", "start": 14.58, "end": 20.41, "words": [["With", 14.58, 14.77], ["nothing", 14.85, 15.14], ["holding", 15.21, 15.49], ["you", 15.55, 15.62], ["down,", 15.7, 16.2], ["you'd", 16.35, 16.52], ["fly", 16.58, 16.88], ["off", 16.96, 17.12], ["in", 17.18, 17.25], ["a", 17.29, 17.32], ["straight", 17.38, 17.66], ["line…", 17.71, 18.16], ["as", 18.48, 18.66], ["the", 18.72, 18.79], ["ground", 18.84, 19.14], ["curves", 19.2, 19.47], ["away", 19.52, 19.73], ["below", 19.78, 20.03], ["you.", 20.1, 20.41]]}, {"text": "After five seconds: forty centimetres up. People, cars, even the oceans… all lifting off together.", "start": 20.92, "end": 27.85, "words": [["After", 20.92, 21.21], ["five", 21.3, 21.63], ["seconds:", 21.68, 22.22], ["forty", 22.35, 22.64], ["centimetres", 22.7, 23.2], ["up.", 23.27, 23.57], ["People,", 23.85, 24.36], ["cars,", 24.47, 25.03], ["even", 25.08, 25.26], ["the", 25.3, 25.37], ["oceans…", 25.44, 26.09], ["all", 26.41, 26.64], ["lifting", 26.73, 27.05], ["off", 27.11, 27.26], ["together.", 27.31, 27.85]]}, {"text": "But the air is the real problem. Air pressure is just the weight of the air above you. Take that weight away, and the whole sky starts rising toward space… faster every second.", "start": 28.18, "end": 38.27, "words": [["But", 28.18, 28.35], ["the", 28.39, 28.47], ["air", 28.55, 28.73], ["is", 28.78, 28.85], ["the", 28.9, 28.97], ["real", 29.02, 29.2], ["problem.", 29.26, 29.78], ["Air", 30.06, 30.29], ["pressure", 30.36, 30.75], ["is", 30.81, 30.91], ["just", 30.96, 31.15], ["the", 31.18, 31.25], ["weight", 31.3, 31.45], ["of", 31.48, 31.52], ["the", 31.56, 31.63], ["air", 31.67, 31.81], ["above", 31.86, 32.09], ["you.", 32.12, 32.43], ["Take", 32.75, 33.02], ["that", 33.05, 33.18], ["weight", 33.24, 33.41], ["away,", 33.45, 33.95], ["and", 33.99, 34.26], ["the", 34.3, 34.37], ["whole", 34.42, 34.68], ["sky", 34.71, 35.02], ["starts", 35.09, 35.36], ["rising", 35.45, 35.82], ["toward", 35.88, 36.11], ["space…", 36.15, 36.78], ["faster", 37.11, 37.52], ["every", 37.58, 37.76], ["second.", 37.8, 38.27]]}, {"text": "Deep underground, rock squeezed by its own weight springs back. The ground shakes everywhere at once.", "start": 38.96, "end": 44.76, "words": [["Deep", 38.96, 39.22], ["underground,", 39.28, 39.83], ["rock", 39.89, 40.11], ["squeezed", 40.19, 40.66], ["by", 40.7, 40.82], ["its", 40.88, 40.99], ["own", 41.04, 41.19], ["weight", 41.26, 41.51], ["springs", 41.56, 41.92], ["back.", 41.99, 42.47], ["The", 42.79, 42.91], ["ground", 42.97, 43.22], ["shakes", 43.29, 43.59], ["everywhere", 43.71, 44.16], ["at", 44.2, 44.26], ["once.", 44.31, 44.76]]}, {"text": "Weirdly, astronauts on the Space Station wouldn't notice a thing. They already float, because they're constantly falling around Earth.", "start": 45.2, "end": 52.22, "words": [["Weirdly,", 45.2, 45.7], ["astronauts", 45.73, 46.32], ["on", 46.36, 46.43], ["the", 46.45, 46.52], ["Space", 46.54, 46.81], ["Station", 46.83, 47.18], ["wouldn't", 47.25, 47.5], ["notice", 47.53, 47.77], ["a", 47.81, 47.84], ["thing.", 47.9, 48.34], ["They", 48.67, 48.83], ["already", 48.88, 49.13], ["float,", 49.19, 49.73], ["because", 49.84, 50.12], ["they're", 50.14, 50.4], ["constantly", 50.52, 51.12], ["falling", 51.2, 51.51], ["around", 51.56, 51.79], ["Earth.", 51.85, 52.22]]}, {"text": "Then gravity snaps back. Everything drops. And the rising air comes crashing down, with powerful winds everywhere.", "start": 52.83, "end": 60.33, "words": [["Then", 52.83, 53.01], ["gravity", 53.08, 53.48], ["snaps", 53.53, 53.86], ["back.", 53.93, 54.36], ["Everything", 54.74, 55.17], ["drops.", 55.23, 55.85], ["And", 56.1, 56.25], ["the", 56.28, 56.35], ["rising", 56.42, 56.83], ["air", 56.89, 57.04], ["comes", 57.1, 57.32], ["crashing", 57.39, 57.82], ["down,", 57.89, 58.39], ["with", 58.54, 58.72], ["powerful", 58.78, 59.26], ["winds", 59.33, 59.69], ["everywhere.", 59.76, 60.33]]}, {"text": "Five seconds. Where would you want to be when it happens? Tell me in the comments.", "start": 60.84, "end": 65.85, "words": [["Five", 60.84, 61.15], ["seconds.", 61.2, 61.81], ["Where", 62.25, 62.48], ["would", 62.51, 62.66], ["you", 62.68, 62.75], ["want", 62.81, 62.98], ["to", 63.02, 63.09], ["be", 63.15, 63.24], ["when", 63.27, 63.4], ["it", 63.44, 63.51], ["happens?", 63.55, 64.13], ["Tell", 64.57, 64.77], ["me", 64.82, 64.89], ["in", 64.92, 64.98], ["the", 65.0, 65.07], ["comments.", 65.11, 65.85]]}]