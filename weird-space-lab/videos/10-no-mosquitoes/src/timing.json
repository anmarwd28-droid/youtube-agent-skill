[{"text": "What if every mosquito on Earth vanished?", "start": 0.0, "end": 2.32, "words": [["What", 0.0, 0.22], ["if", 0.26, 0.34], ["every", 0.45, 0.72], ["mosquito", 0.79, 1.26], ["on", 1.33, 1.42], ["Earth", 1.46, 1.65], ["vanished?", 1.73, 2.32]]}, {"text": "They're the deadliest animal for humans. Malaria alone, which they spread, kills around six hundred thousand people a year.", "start": 2.65, "end": 9.87, "words": [["They're", 2.65, 2.87], ["the", 2.9, 2.97], ["deadliest", 3.05, 3.54], ["animal", 3.6, 3.89], ["for", 3.94, 4.04], ["humans.", 4.09, 4.63], ["Malaria", 5.07, 5.56], ["alone,", 5.62, 6.01], ["which", 6.04, 6.2], ["they", 6.24, 6.35], ["spread,", 6.41, 7.01], ["kills", 7.22, 7.51], ["around", 7.56, 7.84], ["six", 7.95, 8.21], ["hundred", 8.27, 8.52], ["thousand", 8.58, 8.96], ["people", 9.02, 9.3], ["a", 9.33, 9.36], ["year.", 9.43, 9.87]]}, {"text": "Add dengue, Zika and yellow fever, and mosquitoes make hundreds of millions of people sick every year.", "start": 10.47, "end": 16.59, "words": [["Add", 10.47, 10.77], ["dengue,", 10.8, 11.46], ["Zika", 11.61, 12.11], ["and", 12.17, 12.26], ["yellow", 12.32, 12.55], ["fever,", 12.61, 13.11], ["and", 13.26, 13.41], ["mosquitoes", 13.47, 14.13], ["make", 14.22, 14.41], ["hundreds", 14.47, 14.81], ["of", 14.85, 14.91], ["millions", 15.0, 15.35], ["of", 15.38, 15.44], ["people", 15.49, 15.79], ["sick", 15.82, 16.01], ["every", 16.06, 16.23], ["year.", 16.27, 16.59]]}, {"text": "But there are more than three thousand five hundred kinds of mosquito, and only a small fraction bite people.", "start": 16.92, "end": 22.33, "words": [["But", 16.92, 17.07], ["there", 17.09, 17.23], ["are", 17.26, 17.37], ["more", 17.4, 17.54], ["than", 17.57, 17.7], ["three", 17.76, 18.01], ["thousand", 18.05, 18.44], ["five", 18.51, 18.75], ["hundred", 18.79, 19.03], ["kinds", 19.07, 19.32], ["of", 19.35, 19.41], ["mosquito,", 19.47, 20.13], ["and", 20.31, 20.46], ["only", 20.52, 20.71], ["a", 20.76, 20.79], ["small", 20.86, 21.15], ["fraction", 21.21, 21.59], ["bite", 21.65, 21.85], ["people.", 21.89, 22.33]]}, {"text": "Their larvae feed fish and frogs, and some adults even pollinate flowers.", "start": 22.65, "end": 27.35, "words": [["Their", 22.65, 22.85], ["larvae", 22.91, 23.27], ["feed", 23.32, 23.63], ["fish", 23.74, 24.0], ["and", 24.03, 24.11], ["frogs,", 24.17, 24.81], ["and", 24.96, 25.12], ["some", 25.18, 25.36], ["adults", 25.38, 25.82], ["even", 25.94, 26.18], ["pollinate", 26.25, 26.73], ["flowers.", 26.76, 27.35]]}, {"text": "Many scientists think nature would mostly adapt, and other insects would fill the gap.", "start": 27.96, "end": 32.62, "words": [["Many", 27.96, 28.18], ["scientists", 28.23, 28.77], ["think", 28.8, 28.99], ["nature", 29.07, 29.37], ["would", 29.41, 29.56], ["mostly", 29.61, 29.93], ["adapt,", 29.99, 30.57], ["and", 30.89, 31.06], ["other", 31.11, 31.29], ["insects", 31.36, 31.73], ["would", 31.77, 31.9], ["fill", 31.94, 32.08], ["the", 32.12, 32.19], ["gap.", 32.23, 32.62]]}, {"text": "That's why researchers are testing ways to remove only the species that spread disease.", "start": 33.13, "end": 37.76, "words": [["That's", 33.13, 33.4], ["why", 33.44, 33.56], ["researchers", 33.66, 34.21], ["are", 34.26, 34.38], ["testing", 34.41, 34.78], ["ways", 34.85, 35.11], ["to", 35.16, 35.22], ["remove", 35.32, 35.73], ["only", 35.8, 36.08], ["the", 36.14, 36.21], ["species", 36.26, 36.74], ["that", 36.78, 36.91], ["spread", 36.94, 37.17], ["disease.", 37.21, 37.76]]}, {"text": "Should we get rid of them? Tell me in the comments.", "start": 38.36, "end": 41.01, "words": [["Should", 38.36, 38.57], ["we", 38.6, 38.66], ["get", 38.71, 38.82], ["rid", 38.87, 38.99], ["of", 39.02, 39.07], ["them?", 39.1, 39.4], ["Tell", 39.73, 39.93], ["me", 39.97, 40.02], ["in", 40.07, 40.11], ["the", 40.13, 40.2], ["comments.", 40.25, 41.01]]}]