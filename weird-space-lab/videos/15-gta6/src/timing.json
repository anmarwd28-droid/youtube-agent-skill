[{"text": "GTA 6 comes out this week… and the numbers behind it are insane.", "start": 0.0, "end": 4.31, "words": [["GTA", 0.0, 0.51], ["6", 0.63, 0.87], ["comes", 0.94, 1.15], ["out", 1.2, 1.32], ["this", 1.37, 1.51], ["week…", 1.59, 2.01], ["and", 2.33, 2.47], ["the", 2.52, 2.59], ["numbers", 2.63, 2.93], ["behind", 2.98, 3.29], ["it", 3.34, 3.42], ["are", 3.48, 3.63], ["insane.", 3.67, 4.31]]}, {"text": "GTA 5 came out in 2013. That's a thirteen-year wait. A baby born that day is now a teenager.", "start": 4.82, "end": 11.76, "words": [["GTA", 4.82, 5.28], ["5", 5.4, 5.64], ["came", 5.71, 5.89], ["out", 5.91, 6.03], ["in", 6.06, 6.11], ["2013.", 6.17, 7.36], ["That's", 7.61, 7.83], ["a", 7.86, 7.89], ["thirteen-year", 7.99, 8.7], ["wait.", 8.78, 9.22], ["A", 9.46, 9.54], ["baby", 9.69, 9.97], ["born", 10.03, 10.26], ["that", 10.31, 10.45], ["day", 10.51, 10.67], ["is", 10.72, 10.8], ["now", 10.86, 10.97], ["a", 11.03, 11.05], ["teenager.", 11.11, 11.76]]}, {"text": "GTA 5 has sold over 230 million copies. Stack them as game cases, and the tower would reach almost 3,000 kilometers into space. That's seven times higher than the Space Station.", "start": 12.2, "end": 24.34, "words": [["GTA", 12.2, 12.64], ["5", 12.76, 13.0], ["has", 13.07, 13.19], ["sold", 13.25, 13.47], ["over", 13.5, 13.68], ["230", 13.79, 14.78], ["million", 14.85, 15.12], ["copies.", 15.17, 15.81], ["Stack", 16.14, 16.45], ["them", 16.51, 16.62], ["as", 16.67, 16.75], ["game", 16.82, 17.05], ["cases,", 17.1, 17.69], ["and", 17.87, 18.02], ["the", 18.07, 18.14], ["tower", 18.18, 18.47], ["would", 18.52, 18.67], ["reach", 18.72, 18.94], ["almost", 19.03, 19.43], ["3,000", 19.52, 20.19], ["kilometers", 20.25, 20.82], ["into", 20.93, 21.13], ["space.", 21.19, 21.73], ["That's", 22.18, 22.4], ["seven", 22.44, 22.73], ["times", 22.78, 23.04], ["higher", 23.08, 23.29], ["than", 23.32, 23.43], ["the", 23.46, 23.53], ["Space", 23.56, 23.8], ["Station.", 23.82, 24.34]]}, {"text": "The first GTA 6 trailer 