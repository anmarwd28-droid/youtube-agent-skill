[{"text": "What if humans could breathe underwater?", "start": 0.0, "end": 1.72, "words": [["What", 0.0, 0.21], ["if", 0.26, 0.31], ["humans", 0.36, 0.64], ["could", 0.67, 0.81], ["breathe", 0.84, 1.02], ["underwater?", 1.07, 1.72]]}, {"text": "Fish get oxygen with gills. But water holds about thirty times less oxygen than air.", "start": 2.04, "end": 7.14, "words": [["Fish", 2.04, 2.29], ["get", 2.35, 2.51], ["oxygen", 2.58, 3.09], ["with", 3.13, 3.26], ["gills.", 3.31, 3.8], ["But", 4.12, 4.28], ["water", 4.33, 4.56], ["holds", 4.62, 4.83], ["about", 4.87, 5.1], ["thirty", 5.18, 5.49], ["times", 5.54, 5.8], ["less", 5.86, 6.05], ["oxygen", 6.12, 6.56], ["than", 6.59, 6.72], ["air.", 6.77, 7.14]]}, {"text": "And water is about eight hundred times denser than air, so pumping it in and out of our lungs would be exhausting.", "start": 7.46, "end": 13.26, "words": [["And", 7.46, 7.63], ["water", 7.72, 8.01], ["is", 8.05, 8.09], ["about", 8.14, 8.38], ["eight", 8.47, 8.7], ["hundred", 8.74, 9.01], ["times", 9.04, 9.33], ["denser", 9.42, 9.75], ["than", 9.79, 9.91], ["air,", 9.95, 10.31], ["so", 10.52, 10.67], ["pumping", 10.76, 11.09], ["it", 11.15, 11.21], ["in", 11.29, 11.41], ["and", 11.46, 11.55], ["out", 11.61, 11.71], ["of", 11.75, 11.8], ["our", 11.84, 11.94], ["lungs", 11.99, 12.26], ["would", 12.29, 12.43], ["be", 12.47, 12.54], ["exhausting.", 12.57, 13.26]]}, {"text": "That's why fish don't breathe in and out. Water flows one way, straight across their gills.", "start": 13.7, "end": 18.46, "words": [["That's", 13.7, 13.94], ["why", 13.97, 14.08], ["fish", 14.16, 14.37], ["don't", 14.41, 14.59], ["breathe", 14.63, 14.85], ["in", 14.9, 14.95], ["and", 15.02, 15.09], ["out.", 15.15, 15.5], ["Water", 15.82, 16.11], ["flows", 16.16, 16.42], ["one", 16.49, 16.67], ["way,", 16.72, 17.05], ["straight", 17.1, 17.38], ["across", 17.4, 17.7], ["their", 17.74, 17.88], ["gills.", 17.91, 18.46]]}, {"text": "Scientists have tested liquid breathing with oxygen-rich liquids called perfluorocarbons. Mice have survived breathing them.", "start": 18.97, "end": 26.12, "words": [["Scientists", 18.97, 19.57], ["have", 19.62, 19.76], ["tested", 19.81, 20.17], ["liquid", 20.23, 20.53], ["breathing", 20.56, 20.9], ["with", 20.93, 21.07], ["oxygen-rich", 21.15, 21.93], ["liquids", 22.0, 22.43], ["called", 22.5, 22.73], ["perfluorocarbons.", 22.77, 23.8], ["Mice", 24.4, 24.68], ["have", 24.71, 24.85], ["survived", 24.88, 25.38], ["breathing", 25.41, 25.75], ["them.", 25.8, 26.12]]}, {"text": "Doctors have even trialled it to help premature babies with damaged lungs.", "start": 26.63, "end": 30.55, "words": [["Doctors", 26.63, 27.1], ["have", 27.14, 27.3], ["even", 27.36, 27.64], ["trialled", 27.7, 28.11], ["it", 28.16, 28.22], ["to", 28.26, 28.32], ["help", 28.39, 28.55], ["premature", 28.61, 29.08], ["babies", 29.13, 29.43], ["with", 29.47, 29.58], ["damaged", 29.63, 29.95], ["lungs.", 30.01, 30.55]]}, {"text": "But to live in the sea, we'd still face the cold and the pressure. Every ten metres down adds the weight of another whole atmosphere.", "start": 30.99, "end": 38.71, "words": [["But", 30.99, 31.15], ["to", 31.18, 31.24], ["live", 31.32, 31.48], ["in", 31.5, 31.56], ["the", 31.58, 31.65], ["sea,", 31.71, 32.01], ["we'd", 32.04, 32.2], ["still", 32.24, 32.53], ["face", 32.62, 32.89], ["the", 32.94, 33.01], ["cold", 33.07, 33.48], ["and", 33.55, 33.8], ["the", 33.85, 33.92], ["pressure.", 33.97, 34.55], ["Every", 35.16, 35.46], ["ten", 35.52, 35.74], ["metres", 35.81, 36.12], ["down", 36.18, 36.52], ["adds", 36.61, 36.9], ["the", 36.94, 37.02], ["weight", 37.07, 37.27], ["of", 37.3, 37.35], ["another", 37.41, 37.7], ["whole", 37.76, 37.98], ["atmosphere.", 38.01, 38.71]]}, {"text": "Where would you explore first? Tell me in the comments.", "start": 39.22, "end": 42.35, "words": [["Where", 39.22, 39.44], ["would", 39.46, 39.6], ["you", 39.64, 39.72], ["explore", 39.79, 40.16], ["first?", 40.22, 40.72], ["Tell", 41.04, 41.25], ["me", 41.3, 41.35], ["in", 41.4, 41.45], ["the", 41.48, 41.55], ["comments.", 41.59, 42.35]]}]