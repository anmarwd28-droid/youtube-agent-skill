[{"text": "What if you were invisible in real life?", "start": 0.0, "end": 2.04, "words": [["What", 0.0, 0.23], ["if", 0.27, 0.34], ["you", 0.4, 0.46], ["were", 0.53, 0.7], ["invisible", 0.73, 1.29], ["in", 1.32, 1.39], ["real", 1.45, 1.61], ["life?", 1.66, 2.04]]}, {"text": "To be invisible, light has to pass straight through you, without bouncing off or being absorbed.", "start": 2.48, "end": 7.73, "words": [["To", 2.48, 2.59], ["be", 2.66, 2.75], ["invisible,", 2.8, 3.4], ["light", 3.46, 3.68], ["has", 3.73, 3.88], ["to", 3.92, 3.98], ["pass", 4.05, 4.3], ["straight", 4.33, 4.63], ["through", 4.66, 4.89], ["you,", 4.92, 5.21], ["without", 5.46, 5.77], ["bouncing", 5.83, 6.21], ["off", 6.28, 6.5], ["or", 6.58, 6.76], ["being", 6.87, 7.09], ["absorbed.", 7.14, 7.73]]}, {"text": "But your eyes only see by catching light. The retina at the back has to absorb it.", "start": 8.06, "end": 12.49, "words": [["But", 8.06, 8.21], ["your", 8.26, 8.38], ["eyes", 8.44, 8.63], ["only", 8.67, 8.85], ["see", 8.89, 9.03], ["by", 9.07, 9.16], ["catching", 9.22, 9.52], ["light.", 9.58, 9.93], ["The", 10.25, 10.38], ["retina", 10.47, 10.87], ["at", 10.93, 11.01], ["the", 11.05, 11.12], ["back", 11.18, 11.42], ["has", 11.49, 11.69], ["to", 11.75, 11.81], ["absorb", 11.89, 12.24], ["it.", 12.29, 12.49]]}, {"text": "So if light passed straight through your eyes… you'd be completely blind.", "start": 12.88, "end": 17.11, "words": [["So", 12.88, 13.03], ["if", 13.1, 13.17], ["light", 13.25, 13.46], ["passed", 13.51, 13.79], ["straight", 13.82, 14.14], ["through", 14.16, 14.37], ["your", 14.41, 14.54], ["eyes…", 14.61, 15.08], ["you'd", 15.59, 15.77], ["be", 15.8, 15.89], ["completely", 15.94, 16.49], ["blind.", 16.54, 17.11]]}, {"text": "And if you kept your eyes visible, so you could see, people would spot two eyeballs floating in the air.", "start": 17.5, "end": 23.46, "words": [["And", 17.5, 17.64], ["if", 17.69, 17.76], ["you", 17.81, 17.89], ["kept", 17.98, 18.23], ["your", 18.26, 18.39], ["eyes", 18.46, 18.66], ["visible,", 18.71, 19.3], ["so", 19.54, 19.67], ["you", 19.75, 19.84], ["could", 19.89, 20.05], ["see,", 20.12, 20.64], ["people", 20.82, 21.13], ["would", 21.16, 21.33], ["spot", 21.36, 21.68], ["two", 21.72, 21.91], ["eyeballs", 22.0, 22.46], ["floating", 22.52, 22.86], ["in", 22.89, 22.94], ["the", 22.96, 23.03], ["air.", 23.09, 23.46]]}, {"text": "Real scientists are building invisibility cloaks. So far, they only work for some colours, or for tiny objects.", "start": 24.16, "end": 30.28, "words": [["Real", 24.16, 24.42], ["scientists", 24.5, 25.09], ["are", 25.12, 25.23], ["building", 25.26, 25.54], ["invisibility", 25.59, 26.29], ["cloaks.", 26.34, 26.85], ["So", 27.3, 27.5], ["far,", 27.59, 27.82], ["they", 27.84, 27.96], ["only", 28.02, 28.17], ["work", 28.21, 28.36], ["for", 28.41, 28.5], ["some", 28.55, 28.7], ["colours,", 28.75, 29.15], ["or", 29.18, 29.25], ["for", 29.29, 29.4], ["tiny", 29.44, 29.69], ["objects.", 29.76, 30.28]]}, {"text": "Would you still want to be invisible, if it meant being blind? Tell me in the comments.", "start": 30.72, "end": 35.57, "words": [["Would", 30.72, 30.91], ["you", 30.94, 31.02], ["still", 31.1, 31.38], ["want", 31.44, 31.59], ["to", 31.63, 31.67], ["be", 31.73, 31.81], ["invisible,", 31.86, 32.53], ["if", 32.68, 32.81], ["it", 32.87, 32.94], ["meant", 32.98, 33.15], ["being", 33.18, 33.37], ["blind?", 33.42, 33.92], ["Tell", 34.31, 34.51], ["me", 34.55, 34.61], ["in", 34.64, 34.69], ["the", 34.71, 34.78], ["comments.", 34.82, 35.57]]}]