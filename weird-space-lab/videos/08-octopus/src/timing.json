[{"text": "Octopuses have three hearts… and blue blood.", "start": 0.0, "end": 2.98, "words": [["Octopuses", 0.0, 0.73], ["have", 0.79, 0.93], ["three", 0.96, 1.17], ["hearts…", 1.23, 1.76], ["and", 2.04, 2.21], ["blue", 2.26, 2.47], ["blood.", 2.51, 2.98]]}, {"text": "Two hearts pump blood through the gills, to pick up oxygen. The third pumps it to the rest of the body.", "start": 3.5, "end": 9.01, "words": [["Two", 3.5, 3.74], ["hearts", 3.85, 4.13], ["pump", 4.26, 4.53], ["blood", 4.61, 4.87], ["through", 4.89, 5.07], ["the", 5.1, 5.17], ["gills,", 5.2, 5.55], ["to", 5.57, 5.64], ["pick", 5.7, 5.85], ["up", 5.9, 5.98], ["oxygen.", 6.05, 6.72], ["The", 7.0, 7.14], ["third", 7.21, 7.46], ["pumps", 7.54, 7.83], ["it", 7.87, 7.94], ["to", 7.98, 8.02], ["the", 8.08, 8.15], ["rest", 8.19, 8.35], ["of", 8.38, 8.43], ["the", 8.46, 8.53], ["body.", 8.57, 9.01]]}, {"text": "And here's the weird part: that third heart stops beating when the octopus swims. That's why they'd rather crawl.", "start": 9.39, "end": 16.53, "words": [["And", 9.39, 9.55], ["here's", 9.62, 9.85], ["the", 9.88, 9.95], ["weird", 10.01, 10.23], ["part:", 10.29, 10.68], ["that", 11.19, 11.38], ["third", 11.46, 11.78], ["heart", 11.85, 12.09], ["stops", 12.16, 12.5], ["beating", 12.62, 13.03], ["when", 13.18, 13.35], ["the", 13.38, 13.44], ["octopus", 13.49, 13.98], ["swims.", 14.04, 14.64], ["That's", 15.02, 15.3], ["why", 15.34, 15.46], ["they'd", 15.51, 15.69], ["rather", 15.72, 15.93], ["crawl.", 15.99, 16.53]]}, {"text": "Their blood is blue because it carries oxygen with copper, not iron like ours.", "start": 16.97, "end": 21.65, "words": [["Their", 16.97, 17.17], ["blood", 17.22, 17.41], ["is", 17.45, 17.53], ["blue", 17.6, 17.89], ["because", 17.94, 18.18], ["it", 18.22, 18.27], ["carries", 18.32, 18.67], ["oxygen", 18.76, 19.33], ["with", 19.41, 19.56], ["copper,", 19.62, 20.22], ["not", 20.43, 20.63], ["iron", 20.69, 20.94], ["like", 20.99, 21.15], ["ours.", 21.2, 21.65]]}, {"text": "Copper works better in cold water with little oxygen, deep in the ocean.", "start": 22.46, "end": 26.77, "words": [["Copper", 22.46, 22.84], ["works", 22.88, 23.13], ["better", 23.17, 23.39], ["in", 23.43, 23.49], ["cold", 23.57, 23.85], ["water", 23.91, 24.2], ["with", 24.24, 24.38], ["little", 24.43, 24.65], ["oxygen,", 24.68, 25.38], ["deep", 25.76, 25.99], ["in", 26.04, 26.1], ["the", 26.13, 26.2], ["ocean.", 26.27, 26.77]]}, {"text": "And two thirds of an octopus's brain cells are in its arms. Each arm can touch, taste and react on its own.", "start": 27.1, "end": 33.76, "words": [["And", 27.1, 27.26], ["two", 27.32, 27.52], ["thirds", 27.6, 27.88], ["of", 27.91, 27.97], ["an", 28.01, 28.07], ["octopus's", 28.14, 28.72], ["brain", 28.78, 29.02], ["cells", 29.08, 29.36], ["are", 29.4, 29.49], ["in", 29.52, 29.57], ["its", 29.62, 29.73], ["arms.", 29.77, 30.27], ["Each", 30.96, 31.23], ["arm", 31.28, 31.48], ["can", 31.53, 31.67], ["touch,", 31.73, 32.08], ["taste", 32.12, 32.5], ["and", 32.54, 32.64], ["react", 32.69, 33.06], ["on", 33.12, 33.19], ["its", 33.24, 33.34], ["own.", 33.4, 33.76]]}, {"text": "Which animal should I cover next? Tell me in the comments.", "start": 34.27, "end": 37.29, "words": [["Which", 34.27, 34.49], ["animal", 34.54, 34.8], ["should", 34.83, 34.98], ["I", 35.02, 35.04], ["cover", 35.1, 35.32], ["next?", 35.39, 35.79], ["Tell", 36.0, 36.19], ["me", 36.23, 36.29], ["in", 36.33, 36.37], ["the", 36.4, 36.47], ["comments.", 36.5, 37.29]]}]