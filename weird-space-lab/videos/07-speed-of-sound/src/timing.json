[{"text": "What if you could run at the speed of sound?", "start": 0.0, "end": 2.08, "words": [["What", 0.0, 0.23], ["if", 0.27, 0.35], ["you", 0.41, 0.49], ["could", 0.56, 0.71], ["run", 0.78, 0.94], ["at", 0.99, 1.06], ["the", 1.09, 1.16], ["speed", 1.21, 1.46], ["of", 1.51, 1.56], ["sound?", 1.61, 2.08]]}, {"text": "That's about twelve hundred kilometres an hour. Almost thirty times faster than Usain Bolt.", "start": 2.52, "end": 7.51, "words": [["That's", 2.52, 2.75], ["about", 2.77, 3.01], ["twelve", 3.04, 3.34], ["hundred", 3.38, 3.61], ["kilometres", 3.66, 4.18], ["an", 4.23, 4.3], ["hour.", 4.33, 4.78], ["Almost", 5.03, 5.39], ["thirty", 5.45, 5.72], ["times", 5.78, 6.04], ["faster", 6.09, 6.48], ["than", 6.53, 6.65], ["Usain", 6.73, 7.05], ["Bolt.", 7.12, 7.51]]}, {"text": "The first problem is the air. At that speed, it would push against you with a force of about five tonnes.", "start": 7.89, "end": 14.37, "words": [["The", 7.89, 8.01], ["first", 8.08, 8.31], ["problem", 8.37, 8.77], ["is", 8.84, 8.94], ["the", 8.99, 9.06], ["air.", 9.12, 9.53], ["At", 9.86, 10.02], ["that", 10.08, 10.26], ["speed,", 10.33, 10.84], ["it", 10.97, 11.09], ["would", 11.12, 11.27], ["push", 11.32, 11.56], ["against", 11.61, 11.92], ["you", 11.98, 12.1], ["with", 12.25, 12.43], ["a", 12.47, 12.5], ["force", 12.59, 12.88], ["of", 12.91, 12.98], ["about", 13.05, 13.32], ["five", 13.43, 13.76], ["tonnes.", 13.82, 14.37]]}, {"text": "And you'd break the sound barrier. Everyone you pass would hear a sharp crack, like a bullet flying by.", "start": 14.81, "end": 20.89, "words": [["And", 14.81, 14.95], ["you'd", 15.01, 15.19], ["break", 15.23, 15.46], ["the", 15.52, 15.59], ["sound", 15.66, 15.93], ["barrier.", 15.99, 16.5], ["Everyone", 16.67, 17.11], ["you", 17.15, 17.23], ["pass", 17.32, 17.67], ["would", 17.72, 17.87], ["hear", 17.9, 18.02], ["a", 18.07, 18.1], ["sharp", 18.18, 18.47], ["crack,", 18.56, 19.13], ["like", 19.41, 19.59], ["a", 19.61, 19.64], ["bullet", 19.73, 20.02], ["flying", 20.07, 20.38], ["by.", 20.43, 20.89]]}, {"text": "Your reaction time is about a quarter of a second. In that time, you'd already cover eighty-five metres.", "start": 21.4, "end": 27.11, "words": [["Your", 21.4, 21.57], ["reaction", 21.64, 22.21], ["time", 22.27, 22.59], ["is", 22.63, 22.71], ["about", 22.75, 22.95], ["a", 22.99, 23.01], ["quarter", 23.06, 23.3], ["of", 23.34, 23.38], ["a", 23.43, 23.45], ["second.", 23.52, 24.0], ["In", 24.44, 24.58], ["that", 24.64, 24.8], ["time,", 24.84, 25.15], ["you'd", 25.17, 25.33], ["already", 25.38, 25.68], ["cover", 25.74, 26.0], ["eighty-five", 26.09, 26.59], ["metres.", 26.63, 27.11]]}, {"text": "So every pole, every car, every person in your way… you'd hit before you even saw it.", "start": 27.49, "end": 33.58, "words": [["So", 27.49, 27.64], ["every", 27.72, 27.93], ["pole,", 27.99, 28.5], ["every", 28.78, 29.06], ["car,", 29.12, 29.65], ["every", 29.77, 30.02], ["person", 30.08, 30.44], ["in", 30.5, 30.57], ["your", 30.61, 30.74], ["way…", 30.81, 31.32], ["you'd", 31.83, 32.03], ["hit", 32.1, 32.31], ["before", 32.37, 32.62], ["you", 32.66, 32.73], ["even", 32.79, 32.97], ["saw", 33.04, 33.27], ["it.", 33.34, 33.58]]}, {"text": "And the air slamming into you would heat the front of your body by almost sixty degrees.", "start": 33.96, "end": 38.32, "words": [["And", 33.96, 34.11], ["the", 34.16, 34.23], ["air", 34.28, 34.48], ["slamming", 34.55, 35.09], ["into", 35.14, 35.29], ["you", 35.35, 35.43], ["would", 35.5, 35.67], ["heat", 35.71, 35.9], ["the", 35.94, 36.01], ["front", 36.07, 36.25], ["of", 36.28, 36.33], ["your", 36.36, 36.47], ["body", 36.51, 36.76], ["by", 36.8, 36.91], ["almost", 36.97, 37.26], ["sixty", 37.31, 37.64], ["degrees.", 37.69, 38.32]]}, {"text": "Still want this superpower? Tell me in the comments.", "start": 38.93, "end": 42.12, "words": [["Still", 38.93, 39.22], ["want", 39.28, 39.46], ["this", 39.5, 39.62], ["superpower?", 39.66, 40.47], ["Tell", 40.75, 40.97], ["me", 41.02, 41.