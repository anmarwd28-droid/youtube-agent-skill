[{"text": "What if Earth's magnetic field disappeared?", "start": 0.0, "end": 2.35, "words": [["What", 0.0, 0.23], ["if", 0.28, 0.36], ["Earth's", 0.45, 0.72], ["magnetic", 0.77, 1.22], ["field", 1.28, 1.54], ["disappeared?", 1.6, 2.35]]}, {"text": "Deep below us, molten iron flows in Earth's outer core, and creates a giant invisible shield.", "start": 2.73, "end": 8.23, "words": [["Deep", 2.73, 2.98], ["below", 3.04, 3.34], ["us,", 3.42, 3.61], ["molten", 3.69, 4.08], ["iron", 4.14, 4.37], ["flows", 4.42, 4.75], ["in", 4.79, 4.87], ["Earth's", 4.91, 5.12], ["outer", 5.16, 5.34], ["core,", 5.41, 5.88], ["and", 6.15, 6.32], ["creates", 6.38, 6.73], ["a", 6.77, 6.8], ["giant", 6.88, 7.2], ["invisible", 7.23, 7.71], ["shield.", 7.74, 8.23]]}, {"text": "Without it, compasses would stop pointing north. Sea turtles and some birds that use the field to find their way would get lost.", "start": 8.67, "end": 15.71, "words": [["Without", 8.67, 9.07], ["it,", 9.11, 9.31], ["compasses", 9.48, 10.04], ["would", 10.1, 10.25], ["stop", 10.29, 10.53], ["pointing", 10.6, 10.91], ["north.", 10.97, 11.42], ["Sea", 12.12, 12.38], ["turtles", 12.42, 12.75], ["and", 12.78, 12.86], ["some", 12.91, 13.07], ["birds", 13.11, 13.4], ["that", 13.43, 13.54], ["use", 13.58, 13.75], ["the", 13.78, 13.85], ["field", 13.9, 14.12], ["to", 14.15, 14.2], ["find", 14.24, 14.44], ["their", 14.48, 14.61], ["way", 14.65, 14.78], ["would", 14.81, 14.95], ["get", 14.99, 15.1], ["lost.", 15.16, 15.71]]}, {"text": "The solar wind, a stream of charged particles from the Sun, would hit our upper atmosphere directly.", "start": 16.09, "end": 21.9, "words": [["The", 16.09, 16.22], ["solar", 16.31, 16.66], ["wind,", 16.73, 17.27], ["a", 17.33, 17.4], ["stream", 17.55, 17.91], ["of", 17.97, 18.03], ["charged", 18.1, 18.45], ["particles", 18.49, 18.91], ["from", 18.95, 19.07], ["the", 19.11, 19.18], ["Sun,", 19.23, 19.73], ["would", 19.9, 20.09], ["hit", 20.13, 20.26], ["our", 20.3, 20.41], ["upper", 20.47, 20.68], ["atmosphere", 20.73, 21.25], ["directly.", 21.28, 21.9]]}, {"text": "Satellites would take far more radiation damage.", "start": 22.5, "end": 25.11, "words": [["Satellites", 22.5, 23.07], ["would", 23.1, 23.25], ["take", 23.28, 23.45], ["far", 23.51, 23.71], ["more", 23.78, 23.94], ["radiation", 24.0, 24.53], ["damage.", 24.59, 25.11]]}, {"text": "And over millions of years, the solar wind could strip away some of our air and water, as scientists think happened on Mars.", "start": 25.5, "end": 31.91, "words": [["And", 25.5, 25.65], ["over", 25.7, 25.89], ["millions", 26.01, 26.4], ["of", 26.45, 26.5], ["years,", 26.57, 26.95], ["the", 26.97, 27.04], ["solar", 27.13, 27.48], ["wind", 27.54, 27.72], ["could", 27.77, 27.92], ["strip", 27.95, 28.15], ["away", 28.2, 28.4], ["some", 28.46, 28.61], ["of", 28.64, 28.7], ["our", 28.76, 28.87], ["air", 28.93, 29.06], ["and", 29.11, 29.18], ["water,", 29.23, 29.72], ["as", 29.93, 30.08], ["scientists", 30.15, 30.68], ["think", 30.71, 30.89], ["happened", 30.94, 31.23], ["on", 31.27, 31.34], ["Mars.", 31.39, 31.91]]}, {"text": "The good news? The field has weakened and flipped many times before, and life survived.", "start": 32.36, "end": 37.77, "words": [["The", 32.36, 32.47], ["good", 32.53, 32.68], ["news?", 32.73, 33.2], ["The", 33.53, 33.66], ["field", 33.73, 33.97], ["has", 34.03, 34.17], ["weakened", 34.28, 34.69], ["and", 34.73, 34.81], ["flipped", 34.86, 35.13], ["many", 35.15, 35.32], ["times", 35.36, 35.6], ["before,", 35.66, 36.25], ["and", 36.57, 36.74], ["life", 36.83, 37.05], ["survived.", 37.08, 37.77]]}, {"text": "Would you notice if your compass stopped working? Tell me in the comments.", "start": 38.37, "end": 42.17, "words": [["Would", 38.37, 38.56], ["you", 38.59, 38.67], ["notice", 38.79, 39.09], ["if", 39.12, 39.2], ["your", 39.23, 39.33], ["compass", 39.39, 39.68], ["stopped", 39.72, 40.0], ["working?", 40.03, 40.52], ["Tell", 40.84, 41.05], ["me", 41.1, 41.16], ["in", 41.19, 41.24], ["the", 41.26, 41.33], ["comments.", 41.37, 42.17]]}]