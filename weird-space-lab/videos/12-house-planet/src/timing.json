[{"text": "What if you lived on a planet the size of a house?", "start": 0.0, "end": 2.26, "words": [["What", 0.0, 0.23], ["if", 0.27, 0.34], ["you", 0.37, 0.45], ["lived", 0.53, 0.72], ["on", 0.76, 0.81], ["a", 0.86, 0.88], ["planet", 0.94, 1.25], ["the", 1.3, 1.37], ["size", 1.41, 1.62], ["of", 1.65, 1.7], ["a", 1.73, 1.75], ["house?", 1.81, 2.26]]}, {"text": "Make it out of rock, like Earth, about ten metres across.", "start": 2.71, "end": 6.56, "words": [["Make", 2.71, 2.94], ["it", 2.96, 3.02], ["out", 3.04, 3.13], ["of", 3.17, 3.22], ["rock,", 3.27, 3.71], ["like", 3.99, 4.26], ["Earth,", 4.33, 4.82], ["about", 5.03, 5.29], ["ten", 5.33, 5.53], ["metres", 5.6, 5.88], ["across.", 5.92, 6.56]]}, {"text": "Its gravity would be about a million times weaker than Earth's.", "start": 7.0, "end": 10.16, "words": [["Its", 7.0, 7.19], ["gravity", 7.25, 7.71], ["would", 7.75, 7.89], ["be", 7.93, 8.0], ["about", 8.03, 8.24], ["a", 8.27, 8.29], ["million", 8.41, 8.74], ["times", 8.8, 9.14], ["weaker", 9.22, 9.48], ["than", 9.53, 9.65], ["Earth's.", 9.71, 10.16]]}, {"text": "To escape it forever, you'd only need to move at about one centimetre per second. That's slower than an ant walking.", "start": 10.48, "end": 17.34, "words": [["To", 10.48, 10.6], ["escape", 10.68, 11.01], ["it", 11.04, 11.1], ["forever,", 11.15, 11.76], ["you'd", 11.94, 12.12], ["only", 12.17, 12.38], ["need", 12.45, 12.63], ["to", 12.68, 12.74], ["move", 12.83, 13.13], ["at", 13.19, 13.29], ["about", 13.33, 13.58], ["one", 13.68, 13.96], ["centimetre", 14.03, 14.59], ["per", 14.64, 14.78], ["second.", 14.83, 15.31], ["That's", 15.7, 15.95], ["slower", 15.97, 16.31], ["than", 16.35, 16.46], ["an", 16.52, 16.59], ["ant", 16.65, 16.79], ["walking.", 16.85, 17.34]]}, {"text": "So one normal step, and you'd drift off into space. Forever.", "start": 17.59, "end": 21.9, "words": [["So", 17.59, 17.76], ["one", 17.84, 18.03], ["normal", 18.08, 18.38], ["step,", 18.44, 18.89], ["and", 18.95, 19.16], ["you'd", 19.2, 19.36], ["drift", 19.39, 19.69], ["off", 19.75, 19.92], ["into", 19.98, 20.13], ["space.", 20.19, 20.77], ["Forever.", 21.21, 21.9]]}, {"text": "It couldn't hold on to any air, either. You'd need a spacesuit just to stand there.", "start": 22.5, "end": 26.75, "words": [["It", 22.5, 22.64], ["couldn't", 22.69, 22.95], ["hold", 23.0, 23.18], ["on", 23.25, 23.35], ["to", 23.38, 23.43], ["any", 23.51, 23.72], ["air,", 23.78, 23.96], ["either.", 23.99, 24.38], ["You'd", 24.71, 24.89], ["need", 24.93, 25.08], ["a", 25.11, 25.15], ["spacesuit", 25.19, 25.76], ["just", 25.83, 26.02], ["to", 26.05, 26.11], ["stand", 26.16, 26.41], ["there.", 26.46, 26.75]]}, {"text": "Rocks this small really exist in space, and spacecraft that land on them have to grab on, or bounce away.", "start": 27.35, "end": 33.97, "words": [["Rocks", 27.35, 27.7], ["this", 27.77, 27.92], ["small", 27.98, 28.38], ["really", 28.55, 28.84], ["exist", 28.91, 29.23], ["in", 29.29, 29.36], ["space,", 29.43, 29.98], ["and", 30.3, 30.46], ["spacecraft", 30.53, 31.16], ["that", 31.2, 31.32], ["land", 31.39, 31.64], ["on", 31.71, 31.78], ["them", 31.81, 31.96], ["have", 32.03, 32.17], ["to", 32.2, 32.24], ["grab", 32.3, 32.57], ["on,", 32.66, 33.01], ["or", 33.12, 33.24], ["bounce", 33.3, 33.53], ["away.", 33.56, 33.97]]}, {"text": "Would you visit it? Tell me in the comments.", "start": 34.41, "end": 36.5, "words": [["Would", 34.41, 34.6], ["you", 34.62, 34.69], ["visit", 34.75, 35.0], ["it?", 35.05, 35.23], ["Tell", 35.34, 35.52], ["me", 35.56, 35.61], ["in", 35.63, 35.68], ["the", 35.7, 35.77], ["comments.", 35.8, 36.5]]}]