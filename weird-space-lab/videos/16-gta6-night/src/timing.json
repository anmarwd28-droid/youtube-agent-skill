[{"text": "This is what happens the night GTA 6 comes out.", "start": 0.0, "end": 2.66, "words": [["This", 0.0, 0.21], ["is", 0.27, 0.35], ["what", 0.38, 0.52], ["happens", 0.58, 0.94], ["the", 1.0, 1.07], ["night", 1.13, 1.29], ["GTA", 1.32, 1.76], ["6", 1.79, 2.0], ["comes", 2.07, 2.29], ["out.", 2.33, 2.66]]}, {"text": "At midnight, millions of players grab their controllers… starting in New Zealand, then all around the world.", "start": 2.98, "end": 9.03, "words": [["At", 2.98, 3.15], ["midnight,", 3.26, 3.74], ["millions", 3.89, 4.32], ["of", 4.35, 4.41], ["players", 4.47, 4.78], ["grab", 4.83, 5.05], ["their", 5.1, 5.21], ["controllers…", 5.25, 6.01], ["starting", 6.46, 6.84], ["in", 6.88, 6.93], ["New", 6.97, 7.07], ["Zealand,", 7.13, 7.59], ["then", 7.71, 7.87], ["all", 7.96, 8.19], ["around", 8.24, 8.46], ["the", 8.5, 8.57], ["world.", 8.62, 9.03]]}, {"text": "But first, the download. GTA 6 is up to 212 gigabytes. That won't even fit on a 128-gigabyte phone.", "start": 9.42, "end": 17.32, "words": [["But", 9.42, 9.59], ["first,", 9.66, 9.98], ["the", 10.01, 10.08], ["download.", 10.14, 10.74], ["GTA", 11.12, 11.59], ["6", 11.63, 11.91], ["is", 12.06, 12.2], ["up", 12.26, 12.35], ["to", 12.4, 12.46], ["212", 12.57, 13.47], ["gigabytes.", 13.54, 14.27], ["That", 14.55, 14.71], ["won't", 14.76, 14.93], ["even", 14.96, 15.14], ["fit", 15.2, 15.35], ["on", 15.41, 15.46], ["a", 15.5, 15.52], ["128-gigabyte", 15.59, 16.83], ["phone.", 16.87, 17.32]]}, {"text": "On a fast 100-megabit connection, that's almost five hours. On a slow one, almost a full day.", "start": 17.7, "end": 24.27, "words": [["On", 17.7, 17.86], ["a", 17.89, 17.93], ["fast", 18.0, 18.34], ["100-megabit", 18.4, 19.3], ["connection,", 19.34, 19.95], ["that's", 20.1, 20.32], ["almost", 20.35, 20.65], ["five", 20.72, 20.99], ["hours.", 21.02, 21.51], ["On", 21.84, 22.01], ["a", 22.05, 22.08], ["slow", 22.15, 22.45], ["one,", 22.54, 22.87], ["almost", 23.08, 23.49], ["a", 23.53, 23.56], ["full", 23.61, 23.81], ["day.", 23.87, 24.27]]}, {"text": "That's why Rockstar let players preload it nine days early.", "start": 24.77, "end": 28.2, "words": [["That's", 24.77, 25.01], ["why", 25.04, 25.17], ["Rockstar", 25.29, 25.81], ["let", 25.88, 26.04], ["players", 26.09, 26.41], ["preload", 26.49, 26.93], ["it", 26.97, 27.06], ["nine", 27.21, 27.48], ["days", 27.52, 27.71], ["early.", 27.76, 28.2]]}, {"text": "Then comes the money. GTA 5 made over 800 million dollars in its first day, and one billion in just three days. A world record.", "start": 28.64, "end": 38.23, "words": [["Then", 28.64, 28.84], ["comes", 28.91, 29.14], ["the", 29.19, 29.27], ["money.", 29.33, 29.72], ["GTA", 30.42, 30.95], ["5", 31.02, 31.35], ["made", 31.44, 31.6], ["over", 31.64, 31.81], ["800", 31.93, 32.38], ["million", 32.43, 32.66], ["dollars", 32.7, 33.06], ["in", 33.13, 33.24], ["its", 33.28, 33.39], ["first", 33.45, 33.7], ["day,", 33.76, 34.27], ["and", 34.45, 34.61], ["one", 34.7, 34.95], ["billion", 34.99, 35.41], ["in", 35.49, 35.57], ["just", 35.64, 35.83], ["three", 35.87, 36.09], ["days.", 36.13, 36.64], ["A", 37.15, 37.24], ["world", 37.36, 37.66], ["record.", 37.73, 38.23]]}, {"text": "Analysts expect GTA 6 to beat it.", "start": 38.61, "end": 41.24, "words": [["Analysts", 38.61, 39.14], ["expect", 39.18, 39.54], ["GTA", 39.6, 40.13], ["6", 40.2, 40.48], ["to", 40.58, 40.65], ["beat", 40.73, 40.92], ["it.", 40.98, 41.24]]}, {"text": "And for the next few nights… a lot of people won't be sleeping.", "start": 41.56, "end": 44.66, "words": [["And", 41.56, 41.71], ["for", 41.77, 41.87], ["the", 41.91, 41.98], ["next", 42.04, 42.21], ["few", 42.26, 42.39], ["nights…", 42.45, 42.97], ["a", 43.25, 43.3], ["lot", 43.4, 43.55], ["of", 43.58, 43.63], ["people", 43.65, 43.87], ["won't", 43.9, 44.05], ["be", 44.08, 44.15], ["sleeping.", 44.18, 44.66]]}, {"text": "Are you staying up for midnight? Tell me in the comments.", "start": 45.05, "end": 48.3, "words": [["Are", 45.05, 45.21], ["you", 4