[{"text": "What if you could teleport anywhere on Earth, instantly?", "start": 0.0, "end": 2.5, "words": [["What", 0.0, 0.23], ["if", 0.27, 0.33], ["you", 0.36, 0.43], ["could", 0.48, 0.61], ["teleport", 0.64, 1.13], ["anywhere", 1.2, 1.54], ["on", 1.58, 1.65], ["Earth,", 1.7, 1.92], ["instantly?", 1.94, 2.5]]}, {"text": "Sounds perfect. But there's a catch: your speed comes with you.", "start": 2.82, "end": 6.9, "words": [["Sounds", 2.82, 3.15], ["perfect.", 3.22, 3.77], ["But", 4.21, 4.37], ["there's", 4.39, 4.6], ["a", 4.63, 4.67], ["catch:", 4.72, 5.26], ["your", 5.43, 5.6], ["speed", 5.67, 6.0], ["comes", 6.06, 6.29], ["with", 6.34, 6.51], ["you.", 6.56, 6.9]]}, {"text": "Right now, Earth's spin is carrying you east. At the equator, that's about sixteen hundred and seventy kilometres an hour.", "start": 7.22, "end": 13.83, "words": [["Right", 7.22, 7.44], ["now,", 7.5, 7.75], ["Earth's", 7.8, 8.03], ["spin", 8.06, 8.35], ["is", 8.42, 8.49], ["carrying", 8.54, 8.85], ["you", 8.89, 8.97], ["east.", 9.04, 9.46], ["At", 9.9, 10.07], ["the", 10.1, 10.17], ["equator,", 10.23, 10.8], ["that's", 10.89, 11.12], ["about", 11.15, 11.37], ["sixteen", 11.46, 11.96], ["hundred", 12.04, 12.32], ["and", 12.35, 12.43], ["seventy", 12.5, 12.81], ["kilometres", 12.86, 13.29], ["an", 13.34, 13.4], ["hour.", 13.44, 13.83]]}, {"text": "Teleport from the equator to the North Pole, where the ground barely moves… and you'd arrive still flying sideways at that speed.", "start": 14.27, "end": 22.28, "words": [["Teleport", 14.27, 14.9], ["from", 14.93, 15.07], ["the", 15.11, 15.17], ["equator", 15.24, 15.7], ["to", 15.77, 15.86], ["the", 15.92, 15.99], ["North", 16.06, 16.29], ["Pole,", 16.36, 16.88], ["where", 17.05, 17.24], ["the", 17.28, 17.34], ["ground", 17.41, 17.77], ["barely", 17.87, 18.22], ["moves…", 18.3, 18.97], ["and", 19.3, 19.42], ["you'd", 19.48, 19.63], ["arrive", 19.66, 20.0], ["still", 20.04, 20.26], ["flying", 20.34, 20.73], ["sideways", 20.83, 21.34], ["at", 21.37, 21.45], ["that", 21.49, 21.65], ["speed.", 21.72, 22.28]]}, {"text": "That's faster than a bullet from a pistol.", "start": 22.79, "end": 24.76, "words": [["That's", 22.79, 23.06], ["faster", 23.11, 23.49], ["than", 23.52, 23.64], ["a", 23.68, 23.71], ["bullet", 23.77, 24.01], ["from", 24.03, 24.15], ["a", 24.2, 24.22], ["pistol.", 24.28, 24.76]]}, {"text": "Teleport to the top of Mount Everest, and the air would suddenly have only a third of the oxygen. Your ears would pop, and you'd struggle to breathe.", "start": 25.27, "end": 33.16, "words": [["Teleport", 25.27, 25.87], ["to", 25.9, 25.96], ["the", 26.02, 26.09], ["top", 26.12, 26.34], ["of", 26.39, 26.45], ["Mount", 26.52, 26.69], ["Everest,", 26.75, 27.2], ["and", 27.38, 27.53], ["the", 27.57, 27.64], ["air", 27.7, 27.85], ["would", 27.9, 28.05], ["suddenly", 28.12, 28.51], ["have", 28.57, 28.76], ["only", 28.79, 28.98], ["a", 29.04, 29.07], ["third", 29.14, 29.35], ["of", 29.39, 29.43], ["the", 29.47, 29.54], ["oxygen.", 29.61, 30.19], ["Your", 30.63, 30.81], ["ears", 30.91, 31.17], ["would", 31.21, 31.38], ["pop,", 31.44, 31.89], ["and", 31.92, 32.04], ["you'd", 32.09, 32.24], ["struggle", 32.27, 32.61], ["to", 32.63, 32.68], ["breathe.", 32.73, 33.16]]}, {"text": "So where would you teleport first? Tell me in the comments.", "start": 33.67, "end": 36.97, "words": [["So", 33.67, 33.82], ["where", 33.87, 34.04], ["would", 34.06, 34.2], ["you", 34.23, 34.3], ["teleport", 34.35, 34.84], ["first?", 34.91, 35.38], ["Tell", 35.55, 35.77], ["me", 35.82, 35.88], ["in", 35.91, 35.96], ["the", 35.99, 36.06], ["comments.", 36.11, 36.97]]}]