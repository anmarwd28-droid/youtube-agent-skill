[{"text": "What if a black hole the size of a marble appeared in your room?", "start": 0.0, "end": 2.76, "words": [["What", 0.0, 0.2], ["if", 0.23, 0.3], ["a", 0.36, 0.38], ["black", 0.45, 0.72], ["hole", 0.77, 1.0], ["the", 1.03, 1.1], ["size", 1.14, 1.36], ["of", 1.38, 1.43], ["a", 1.47, 1.5], ["marble", 1.56, 1.83], ["appeared", 1.86, 2.11], ["in", 2.14, 2.18], ["your", 2.22, 2.31], ["room?", 2.36, 2.76]]}, {"text": "A black hole that small would weigh as much as the entire Earth.", "start": 3.2, "end": 6.46, "words": [["A", 3.2, 3.29], ["black", 3.37, 3.62], ["hole", 3.67, 3.88], ["that", 3.9, 4.02], ["small", 4.1, 4.4], ["would", 4.43, 4.59], ["weigh", 4.62, 4.78], ["as", 4.82, 4.89], ["much", 4.96, 5.14], ["as", 5.19, 5.26], ["the", 5.31, 5.38], ["entire", 5.45, 5.92], ["Earth.", 5.99, 6.46]]}, {"text": "One metre away, its pull would be forty trillion times stronger than gravity.", "start": 6.84, "end": 11.31, "words": [["One", 6.84, 7.13], ["metre", 7.17, 7.45], ["away,", 7.49, 7.79], ["its", 7.81, 7.93], ["pull", 7.99, 8.19], ["would", 8.23, 8.37], ["be", 8.39, 8.5], ["forty", 8.63, 9.01], ["trillion", 9.12, 9.68], ["times", 9.75, 10.08], ["stronger", 10.12, 10.49], ["than", 10.53, 10.65], ["gravity.", 10.69, 11.31]]}, {"text": "You, the furniture, the walls… everything would fall in faster than you could blink.", "start": 11.75, "end": 16.78, "words": [["You,", 11.75, 12.19], ["the", 12.21, 12.29], ["furniture,", 12.35, 12.97], ["the", 13.04, 13.15], ["walls…", 13.21, 13.93], ["everything", 14.44, 14.84], ["would", 14.87, 15.01], ["fall", 15.05, 15.23], ["in", 15.29, 15.35], ["faster", 15.43, 15.84], ["than", 15.88, 16.0], ["you", 16.05, 16.11], ["could", 16.16, 16.29], ["blink.", 16.31, 16.78]]}, {"text": "Squeezed around it, all that matter would heat up and flash brighter than the Sun.", "start": 17.38, "end": 21.41, "words": [["Squeezed", 17.38, 17.8], ["around", 17.83, 18.1], ["it,", 18.15, 18.36], ["all", 18.4, 18.68], ["that", 18.74, 18.88], ["matte