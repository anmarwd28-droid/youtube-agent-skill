[{"text": "In Germany, GTA 6 costs about five hours of work. In Nigeria… about a month and a half.", "start": 0.0, "end": 6.11, "words": [["In", 0.0, 0.16], ["Germany,", 0.23, 0.64], ["GTA", 0.69, 1.15], ["6", 1.21, 1.45], ["costs", 1.52, 1.82], ["about", 1.86, 2.08], ["five", 2.15, 2.46], ["hours", 2.5, 2.77], ["of", 2.82, 2.88], ["work.", 2.95, 3.34], ["In", 3.73, 3.87], ["Nigeria…", 3.91, 4.75], ["about", 5.07, 5.29], ["a", 5.33, 5.35], ["month", 5.4, 5.56], ["and", 5.58, 5.65], ["a", 5.68, 5.7], ["half.", 5.76, 6.11]]}, {"text": "GTA 6 costs 80 dollars. So how long would you work on minimum wage to buy it?", "start": 6.55, "end": 11.38, "words": [["GTA", 6.55, 6.98], ["6", 7.05, 7.29], ["costs", 7.37, 7.67], ["80", 7.79, 8.01], ["dollars.", 8.08, 8.64], ["So", 8.96, 9.1], ["how", 9.17, 9.29], ["long", 9.33, 9.47], ["would", 9.51, 9.64], ["you", 9.66, 9.73], ["work", 9.79, 9.95], ["on", 10.01, 10.08], ["minimum", 10.14, 10.45], ["wage", 10.52, 10.77], ["to", 10.81, 10.87], ["buy", 10.94, 11.11], ["it?", 11.15, 11.38]]}, {"text": "In Germany and the UK, about five hours. Less than one work day.", "start": 11.98, "end": 15.97, "words": [["In", 11.98, 12.13], ["Germany", 12.2, 12.55], ["and", 12.59, 12.65], ["the", 12.69, 12.76], ["UK,", 12.82, 13.21], ["about", 13.23, 13.46], ["five", 13.51, 13.78], ["hours.", 13.82, 14.27], ["Less", 14.65, 14.88], ["than", 14.92, 15.06], ["one", 15.13, 15.31], ["work", 15.35, 15.56], ["day.", 15.62, 15.97]]}, {"text": "In the United States, on the federal minimum wage, eleven hours.", "start": 16.42, "end": 20.3, "words": [["In", 16.42, 16.55], ["the", 16.59, 16.66], ["United", 16.74, 17.09], ["States,", 17.14, 17.54], ["on", 17.59, 17.72], ["the", 17.75, 17.82], ["federal", 17.89, 18.23], ["minimum", 18.29, 18.62], ["wage,", 18.68, 19.19], ["eleven", 19.4, 19.76], ["hours.", 19.81, 20.3]]}, {"text": "In Brazil, about eight full work days.", "start": 20.63, "end": 22.78, "words": [["In", 20.63, 20.77], ["Brazil,", 20.83, 21.26], [