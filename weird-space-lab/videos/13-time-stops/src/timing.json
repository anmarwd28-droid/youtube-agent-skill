[{"text": "What if time stopped for five seconds… for everyone except you?", "start": 0.0, "end": 4.24, "words": [["What", 0.0, 0.22], ["if", 0.26, 0.33], ["time", 0.38, 0.69], ["stopped", 0.77, 1.22], ["for", 1.26, 1.38], ["five", 1.44, 1.71], ["seconds…", 1.74, 2.33], ["for", 2.77, 2.93], ["everyone", 3.01, 3.45], ["except", 3.48, 3.8], ["you?", 3.84, 4.24]]}, {"text": "Cars, people and birds would freeze in place. Sounds fun, right?", "start": 4.84, "end": 8.9, "words": [["Cars,", 4.84, 5.34], ["people", 5.39, 5.71], ["and", 5.75, 5.83], ["birds", 5.89, 6.19], ["would", 6.24, 6.38], ["freeze", 6.43, 6.7], ["in", 6.73, 6.79], ["place.", 6.85, 7.37], ["Sounds", 7.81, 8.19], ["fun,", 8.23, 8.49], ["right?", 8.52, 8.9]]}, {"text": "But light would freeze too. No light would reach your eyes, so everything would go completely dark.", "start": 9.42, "end": 14.68, "words": [["But", 9.42, 9.6], ["light", 9.68, 9.9], ["would", 9.94, 10.09], ["freeze", 10.14, 10.4], ["too.", 10.44, 10.87], ["No", 11.38, 11.55], ["light", 11.64, 11.85], ["would", 11.89, 12.03], ["reach", 12.07, 12.26], ["your", 12.29, 12.42], ["eyes,", 12.49, 12.74], ["so", 12.76, 12.86], ["everything", 12.95, 13.25], ["would", 13.28, 13.42], ["go", 13.46, 13.57], ["completely", 13.64, 14.15], ["dark.", 14.2, 14.68]]}, {"text": "Sound needs moving air, so there would be total silence.", "start": 15.37, "end": 18.82, "words": [["Sound", 15.37, 15.78], ["needs", 15.85, 16.08], ["moving", 16.15, 16.44], ["air,", 16.5, 16.93], ["so", 17.08, 17.21], ["there", 17.26, 17.4], ["would", 17.43, 17.57], ["be", 17.6, 17.7], ["total", 17.77, 18.14], ["silence.", 18.2, 18.82]]}, {"text": "And the air itself would be frozen. Every molecule stuck in place, like an invisible wall. You couldn't even take a breath.", "start": 19.14, "end": 27.46, "words": [["And", 19.14, 19.3], ["the", 19.34, 19.42], ["air", 19.5, 19.74], ["itself", 19.8, 20.2], ["would", 20.25, 20.4], ["be", 20.43, 20.52], ["frozen.", 20.56, 21.13], ["Every", 21.57, 21.9], ["molecule", 21.98, 22.49], ["stuck", 22.52, 22.76], ["in", 22.81, 22.87], ["place,", 22.94, 23.53], ["like", 23.86, 24.05], ["an", 24.08, 24.14], ["invisible", 24.18, 24.71], ["wall.", 24.75, 25.3], ["You", 26.0, 26.11], ["couldn't", 26.17, 26.43], ["even", 26.46, 26.63], ["take", 26.67, 26.84], ["a", 26.87, 26.9], ["breath.", 26.96, 27.46]]}, {"text": "You'd be trapped in the dark, unable to move or breathe.", "start": 27.84, "end": 30.98, "words": [["You'd", 27.84, 28.05], ["be", 28.1, 28.2], ["trapped", 28.25, 28.68], ["in", 28.71, 28.77], ["the", 28.8, 28.87], ["dark,", 28.93, 29.42], ["unable", 29.54, 29.93], ["to", 29.97, 30.04], ["move", 30.12, 30.31], ["or", 30.35, 30.42], ["breathe.", 30.46, 30.98]]}, {"text": "Then time starts again… and nobody would ever know anything happened.", "start": 31.42, "end": 35.25, "words": [["Then", 31.42, 31.61], ["time", 31.68, 31.97], ["starts", 32.02, 32.31], ["again…", 32.36, 32.94], ["and", 33.22, 33.39], ["nobody", 33.47, 33.78], ["would", 33.81, 33.95], ["ever", 34.02, 34.24], ["know", 34.28, 34.41], ["anything", 34.47, 34.74], ["happened.", 34.8, 35.25]]}, {"text": "Would you still want to stop time? Tell me in the comments.", "start": 35.69, "end": 39.38, "words": [["Would", 35.69, 35.88], ["you", 35.92, 36.01], ["still", 36.13, 36.45], ["want", 36.54, 36.68], ["to", 36.7, 36.74], ["stop", 36.79, 37.06], ["time?", 37.13, 37.63], ["Tell", 38.07, 38.26], ["me", 38.29, 38.35], ["in", 38.38, 38.43], ["the", 38.45, 38.52], ["comments.", 38.57, 39.38]]}]