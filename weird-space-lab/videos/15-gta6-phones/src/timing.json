[{"text": "What if GTA 6 could run on every phone? People would play it everywhere: on the street, on the bus, in cafés.", "start": 0.0, "end": 6.99, "words": [["What", 0.0, 0.23], ["if", 0.27, 0.34], ["GTA", 0.41, 0.97], ["6", 1.04, 1.29], ["could", 1.36, 1.5], ["run", 1.53, 1.66], ["on", 1.71, 1.78], ["every", 1.82, 2.0], ["phone?", 2.04, 2.46], ["People", 2.9, 3.2], ["would", 3.23, 3.38], ["play", 3.41, 3.6], ["it", 3.65, 3.73], ["everywhere:", 3.81, 4.31], ["on", 4.33, 4.45], ["the", 4.48, 4.55], ["street,", 4.61, 4.98], ["on", 5.02, 5.08], ["the", 5.12, 5.19], ["bus,", 5.24, 5.74], ["in", 6.01, 6.15], ["cafés.", 6.24, 6.99]]}, {"text": "But it comes out on November nineteenth, only on PlayStation 5 and Xbox Series.", "start": 7.43, "end": 11.87, "words": [["But", 7.43, 7.58], ["it", 7.62, 7.67], ["comes", 7.72, 7.95], ["out", 8.0, 8.13], ["on", 8.17, 8.23], ["November", 8.28, 8.65], ["nineteenth,", 8.72, 9.3], ["only", 9.47, 9.74], ["on", 9.8, 9.87], ["PlayStation", 9.93, 10.48], ["5", 10.56, 10.77], ["and", 10.84, 10.91], ["Xbox", 10.96, 11.32], ["Series.", 11.36, 11.87]]}, {"text": "And it's over two hundred gigabytes, while lots of phones only have a hundred and twenty-eight.", "start": 12.19, "end": 17.05, "words": [["And", 12.19, 12.33], ["it's", 12.39, 12.52], ["over", 12.55, 12.75], ["two", 12.82, 13.05], ["hundred", 13.12, 13.39], ["gigabytes,", 13.43, 14.07], ["while", 14.13, 14.37], ["lots", 14.43, 14.69], ["of", 14.73, 14.8], ["phones", 14.86, 15.23], ["only", 15.35, 15.65], ["have", 15.71, 15.87], ["a", 15.9, 15.93], ["hundred", 16.0, 16.28], ["and", 16.3, 16.37], ["twenty-eight.", 16.41, 17.05]]}, {"text": "The PlayStation 5's graphics chip is several times stronger than the best phones.", "start": 17.44, "end": 21.61, "words": [["The", 17.44, 17.55], ["PlayStation", 17.6, 18.16], ["5's", 18.25, 18.47], ["graphics", 18.52, 19.0], ["chip", 19.04, 19.28], ["is", 19.34, 19.42], ["several", 19.49, 19.81], ["times", 19.85, 20.11], ["stronger", 20.14, 20.54], ["than", 20.58, 20.7], ["the", 20.73, 20.8], ["best", 20.84, 21.02], ["phones.", 21.07, 21.61]]}, {"text": "If it did run on a phone, it would heat up fast and slow itself down to protect its parts.", "start": 21.99, "end": 26.96, "words": [["If", 21.99, 22.14], ["it", 22.21, 22.29], ["did", 22.35, 22.54], ["run", 22.59, 22.75], ["on", 22.8, 22.87], ["a", 22.92, 22.94], ["phone,", 23.0, 23.51], ["it", 23.66, 23.78], ["would", 23.81, 23.96], ["heat", 24.01, 24.18], ["up", 24.23, 24.32], ["fast", 24.4, 24.77], ["and", 24.83, 24.91], ["slow", 24.95, 25.16], ["itself", 25.2, 25.5], ["down", 25.55, 25.79], ["to", 25.81, 25.87], ["protect", 25.93, 26.24], ["its", 26.29, 26.39], ["parts.", 26.43, 26.96]]}, {"text": "A PlayStation draws about two hundred watts while gaming. At that power, a phone battery would be empty in about six minutes.", "start": 27.56, "end": 34.35, "words": [["A", 27.56, 27.64], ["PlayStation", 27.72, 28.35], ["draws", 28.4, 28.63], ["about", 28.68, 28.9], ["two", 28.94, 29.13], ["hundred", 29.19, 29.44], ["watts", 29.49, 29.79], ["while", 29.84, 30.01], ["gaming.", 30.05, 30.53], ["At", 30.98, 31.15], ["that", 31.2, 31.39], ["power,", 31.47, 31.86], ["a", 31.88, 31.91], ["phone", 31.97, 32.22], ["battery", 32.25, 32.56], ["would", 32.6, 32.75], ["be", 32.79, 32.87], ["empty", 32.91, 33.18], ["in", 33.22, 33.26], ["about", 33.31, 33.53], ["six", 33.6, 33.82], ["minutes.", 33.9, 34.35]]}, {"text": "And if millions downloaded it at once, internet networks around the world would jam.", "start": 34.68, "end": 39.43, "words": [["And", 34.68, 34.82], ["if", 34.86, 34.95], ["millions", 35.06, 35.46], ["downloaded", 35.51, 36.06], ["it", 36.12, 36.2], ["at", 36.26, 36.34], ["once,", 36.42, 36.91], ["internet", 37.29, 37.69], ["networks", 37.76, 38.14], ["around", 38.17, 38.37], ["the", 38.39, 38.46], ["world", 38.5, 38.68], ["would", 38.72, 38.87], ["jam.", 38.9, 39.43]]}, {"text": "But there is a way: cloud gaming. The game runs on a distant computer, and your phone only receives the picture.", "start": 39.87, "end": 46.35, "words": [["But", 39.87, 40.02], ["there", 40.05, 40.22], ["is", 40.25, 40.33], ["a", 40.38, 40.41], ["way:", 40.47, 40.92], ["cloud", 41.25, 41.57], ["gaming.", 41.63, 42.14], ["The", 42.47, 42.6], ["game", 42.67, 42.94], ["runs", 42.99, 43.25], ["on", 43.29, 43.36], ["a", 43.41, 43.43], ["distant", 43.5, 43.8], ["computer,", 43.85, 44.45], ["and", 44.57, 44.72], ["your", 44.77, 44.88], ["phone", 44.93, 45.19], ["only", 45.22, 45.37], ["receives", 45.44, 45.74], ["the", 45.77, 45.84], ["picture.", 45.87, 46.35]]}, {"text": "The twist? Your phone today is several times stronger than the PlayStation 3 that ran GTA 5 in twenty thirteen.", "start": 46.86, "end": 53.79, "words": [["The", 46.86, 46.98], ["twist?", 47.03, 47.56], ["Your", 48.26, 48.42], ["phone", 48.46, 48.68], ["today", 48.72, 49.1], ["is", 49.17, 49.26], ["several", 49.34, 49.67], ["times", 49.73, 49.98], ["stronger", 50.02, 50.38], ["than", 50.41, 50.51], ["the", 50.55, 50.62], ["PlayStation", 50.65, 51.22], ["3", 51.3, 51.48], ["that", 51.55, 51.66], ["ran", 51.71, 51.87], ["GTA", 51.95, 52.38], ["5", 52.41, 52.69], ["in", 52.74, 52.8], ["twenty", 52.85, 53.09], ["thirteen.", 53.14, 53.79]]}, {"text": "Would you play it on your phone? Tell me in the comments.", "start": 54.3, "end": 57.17, "words": [["Would", 54.3, 54.47], ["you", 54.5, 54.57], ["play", 54.61, 54.74], ["it", 54.79, 54.83], ["on", 54.87, 54.93], ["your", 54.96, 55.06], ["phone?", 55.1, 55.49], ["Tell", 55.94, 56.13], ["me", 56.18, 56.24], ["in", 56.27, 56.32], ["the", 56.35, 56.42], ["comments.", 56.46, 57.17]]}]