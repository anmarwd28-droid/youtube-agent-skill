[{"text": "What if friction disappeared for five seconds?", "start": 0.0, "end": 2.47, "words": [["What", 0.0, 0.22], ["if", 0.26, 0.31], ["friction", 0.38, 0.78], ["disappeared", 0.86, 1.39], ["for", 1.43, 1.54], ["five", 1.6, 1.87], ["seconds?", 1.9, 2.47]]}, {"text": "First, you'd fall. Walking only works because your shoes grip the ground.", "start": 2.91, "end": 7.13, "words": [["First,", 2.91, 3.24], ["you'd", 3.26, 3.42], ["fall.", 3.47, 3.91], ["Walking", 4.42, 4.82], ["only", 4.9, 5.14], ["works", 5.2, 5.46], ["because", 5.5, 5.8], ["your", 5.84, 5.97], ["shoes", 6.01, 6.26], ["grip", 6.3, 6.49], ["the", 6.55, 6.62], ["ground.", 6.65, 7.13]]}, {"text": "Cars would slide helplessly. Tyres need friction to steer, and brakes need it to stop.", "start": 7.51, "end": 13.2, "words": [["Cars", 7.51, 7.81], ["would", 7.86, 8.02], ["slide", 8.07, 8.52], ["helplessly.", 8.57, 9.28], ["Tyres", 9.72, 10.18], ["need", 10.25, 10.41], ["friction", 10.47, 10.81], ["to", 10.87, 10.93], ["steer,", 10.99, 11.56], ["and", 11.74, 11.89], ["brakes", 11.95, 12.24], ["need", 12.29, 12.45], ["it", 12.48, 12.54], ["to", 12.57, 12.64], ["stop.", 12.69, 13.2]]}, {"text": "Knots would slip loose, and nails would start sliding out of the walls. Friction is what holds them in place.", "start": 13.64, "end": 20.21, "words": [["Knots", 13.64, 14.0], ["would", 14.06, 14.23], ["slip", 14.29, 14.55], ["loose,", 14.63, 15.12], ["and", 15.36, 15.52], ["nails", 15.6, 15.86], ["would", 15.91, 16.06], ["start", 16.09, 16.34], ["sliding", 16.39, 16.77], ["out", 16.81, 16.92], ["of", 16.95, 17.0], ["the", 17.03, 17.1], ["walls.", 17.14, 17.62], ["Friction", 18.23, 18.65], ["is", 18.7, 18.79], ["what", 18.83, 18.99], ["holds", 19.05, 19.33], ["them", 19.37, 19.49], ["in", 19.54, 19.6], ["place.", 19.67, 20.21]]}, {"text": "Even your clothes would start to come apart. Only friction stops their threads from sliding loose.", "start": 20.66, "end": 26.11, "words": [["Even", 20.66, 20.91], ["your", 20.96, 21.1], ["clothes", 21.15, 21.49], ["would", 21.52, 21.68], ["start", 21.7, 21.91], ["to", 21.94, 22.0], ["come", 22.06, 22.22], ["apart.", 22.25, 22.73], ["Only", 23.34, 23.61], ["friction", 23.71, 24.11], ["stops", 24.18, 24.49], ["their", 24.53, 24.68], ["threads", 24.74, 25.07], ["from", 25.1, 25.24], ["sliding", 25.3, 25.65], ["loose.", 25.69, 26.11]]}, {"text": "And anything on a slope, from rocks to parked cars, would start sliding downhill.", "start": 26.49, "end": 31.51, "words": [["And", 26.49, 26.66], ["anything", 26.73, 27.1], ["on", 27.14, 27.21], ["a", 27.25, 27.28], ["slope,", 27.33, 27.82], ["from", 28.06, 28.25], ["rocks", 28.34, 28.63], ["to", 28.66, 28.73], ["parked", 28.79, 29.06], ["cars,", 29.12, 29.65], ["would", 29.98, 30.16], ["start", 30.2, 30.44], ["sliding", 30.5, 30.87], ["downhill.", 30.93, 31.51]]}, {"text": "When friction comes back, everything that was sliding would screech to a stop.", "start": 31.84, "end": 35.74, "words": [["When", 31.84, 32.01], ["friction", 32.09, 32.45], ["comes", 32.51, 32.74], ["back,", 32.82, 33.24], ["everything", 33.41, 33.85], ["that", 33.89, 33.99], ["was", 34.03, 34.12], ["sliding", 34.17, 34.54], ["would", 34.58, 34.71], ["screech", 34.75, 35.05], ["to", 35.1, 35.16], ["a", 35.23, 35.26], ["stop.", 35.3, 35.74]]}, {"text": "What would you grab first? Tell me in the comments.", "start": 36.18, "end": 38.55, "words": [["What", 36.18, 36.35], ["would", 36.37, 36.5], ["you", 36.54, 36.61], ["grab", 36.65, 36.91], ["first?", 37.0, 37.33], ["Tell", 37.35, 37.49], ["me", 37.52, 37.58], ["in", 37.6, 37.65], ["the", 37.67, 37.74], ["comments.", 37.78, 38.55]]}]