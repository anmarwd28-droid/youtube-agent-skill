[{"text": "What if all eight billion people on Earth jumped at the same time?", "start": 0.0, "end": 3.62, "words": [["What", 0.0, 0.2], ["if", 0.23, 0.3], ["all", 0.38, 0.65], ["eight", 0.77, 0.99], ["billion", 1.06, 1.45], ["people", 1.51, 1.8], ["on", 1.83, 1.92], ["Earth", 1.96, 2.17], ["jumped", 2.35, 2.66], ["at", 2.68, 2.74], ["the", 2.77, 2.84], ["same", 2.88, 3.11], ["time?", 3.15, 3.62]]}, {"text": "Together, we weigh about four hundred million tonnes.", "start": 4.06, "end": 6.9, "words": [["Together,", 4.06, 4.53], ["we", 4.55, 4.66], ["weigh", 4.7, 4.85], ["about", 4.89, 5.1], ["four", 5.18, 5.45], ["hundred", 5.5, 5.77], ["million", 5.85, 6.19], ["tonnes.", 6.25, 6.9]]}, {"text": "Sounds like a lot? Earth is about fifteen trillion times heavier.", "start": 7.22, "end": 11.42, "words": [["Sounds", 7.22, 7.5], ["like", 7.54, 7.65], ["a", 7.69, 7.71], ["lot?", 7.75, 8.15], ["Earth", 8.85, 9.09], ["is", 9.14, 9.23], ["about", 9.28, 9.51], ["fifteen", 9.58, 10.01], ["trillion", 10.07, 10.54], ["times", 10.6, 10.87], ["heavier.", 10.93, 11.42]]}, {"text": "When we push off, Earth moves the other way… by less than the width of an atom.", "start": 11.75, "end": 16.08, "words": [["When", 11.75, 11.92], ["we", 11.96, 12.04], ["push", 12.1, 12.32], ["off,", 12.4, 12.76], ["Earth", 12.83, 13.04], ["moves", 13.11, 13.3], ["the", 13.34, 13.41], ["other", 13.46, 13.61], ["way…", 13.66, 14.19], ["by", 14.51, 14.66], ["less", 14.74, 14.95], ["than", 14.98, 15.11], ["the", 15.14, 15.21], ["width", 15.26, 15.44], ["of", 15.48, 15.53], ["an", 15.58, 15.64], ["atom.", 15.69, 16.08]]}, {"text": "And when we land, it moves right back. Nobody would feel a thing.", "start": 16.41, "end": 20.39, "words": [["And", 16.41, 16.56], ["when", 16.61, 16.75], ["we", 16.79, 16.88], ["land,", 16.96, 17.4], ["it", 17.47, 17.61], ["moves", 17.68, 17.91], ["right", 17.97, 18.17], ["back.", 18.22, 18.65], ["Nobody", 19.16, 19.48], ["would", 19.5, 19.64], ["feel", 19.68, 19.83], ["a", 19.88, 19.9], ["thing.", 19.96, 20.39]]}, {"text": "Seismometers near big crowds might pick up a tiny tremor… and that's it.", "start": 20.99, "end": 25.34, "words": [["Seismometers", 20.99, 21.9], ["near", 21.95, 22.11], ["big", 22.18, 22.34], ["crowds", 22.4, 22.77], ["might", 22.82, 22.99], ["pick", 23.02, 23.16], ["up", 23.21, 23.29], ["a", 23.34, 23.36], ["tiny", 23.41, 23.65], ["tremor…", 23.7, 24.22], ["and", 24.54, 24.72], ["that's", 24.76, 24.98], ["it.", 25.05, 25.34]]}, {"text": "The hardest part? Getting eight billion people, in every time zone, to jump at the exact same second.", "start": 25.73, "end": 32.6, "words": [["The", 25.73, 25.86], ["hardest", 25.91, 26.2], ["part?", 26.25, 26.63], ["Getting", 27.14, 27.45], ["eight", 27.54, 27.75], ["billion", 27.79, 28.11], ["people,", 28.16, 28.64], ["in", 28.89, 29.05], ["every", 29.16, 29.45], ["time", 29.5, 29.79], ["zone,", 29.84, 30.27], ["to", 30.59, 30.72], ["jump", 30.84, 31.07], ["at", 31.11, 31.18], ["the", 31.22, 31.3], ["exact", 31.36, 31.82], ["same", 31.86, 32.09], ["second.", 32.14, 32.6]]}, {"text": "Would you join in? Tell me in the comments.", "start": 33.04, "end": 35.62, "words": [["Would", 33.04, 33.23], ["you", 33.26, 33.33], ["join", 33.39, 33.63], ["in?", 33.7, 34.01], ["Tell", 34.39, 34.57], ["me", 34.62, 34.67], ["in", 34.69, 34.74], ["the", 34.76, 34.83], ["comments.", 34.86, 35.62]]}]