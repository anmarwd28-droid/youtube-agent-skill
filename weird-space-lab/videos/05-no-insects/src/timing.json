[{"text": "What if every insect on Earth disappeared?", "start": 0.0, "end": 2.58, "words": [["What", 0.0, 0.21], ["if", 0.26, 0.33], ["every", 0.44, 0.79], ["insect", 0.87, 1.3], ["on", 1.36, 1.45], ["Earth", 1.51, 1.72], ["disappeared?", 1.81, 2.58]]}, {"text": "No more mosquitoes sounds great… but three out of four of our main food crops depend partly on pollinators like bees.", "start": 3.27, "end": 9.62, "words": [["No", 3.27, 3.42], ["more", 3.48, 3.62], ["mosquitoes", 3.66, 4.12], ["sounds", 4.16, 4.4], ["great…", 4.45, 4.88], ["but", 5.2, 5.36], ["three", 5.4, 5.61], ["out", 5.64, 5.75], ["of", 5.77, 5.83], ["four", 5.88, 6.05], ["of", 6.09, 6.14], ["our", 6.19, 6.29], ["main", 6.35, 6.54], ["food", 6.62, 6.85], ["crops", 6.91, 7.28], ["depend", 7.33, 7.65], ["partly", 7.72, 8.03], ["on", 8.09, 8.16], ["pollinators", 8.22, 8.8], ["like", 8.85, 9.01], ["bees.", 9.06, 9.62]]}, {"text": "Apples, almonds, coffee and chocolate would become rare and expensive.", "start": 10.23, "end": 14.69, "words": [["Apples,", 10.23, 10.81], ["almonds,", 10.86, 11.46], ["coffee", 11.57, 12.05], ["and", 12.1, 12.25], ["chocolate", 12.32, 12.88], ["would", 13.0, 13.2], ["become", 13.23, 13.56], ["rare", 13.63, 13.86], ["and", 13.9, 13.97], ["expensive.", 14.01, 14.69]]}, {"text": "We'd still have wheat, rice and corn, because the wind pollinates them. But our plates would get a lot more boring.", "start": 15.13, "end": 20.89, "words": [["We'd", 15.13, 15.32], ["still", 15.35, 15.57], ["have", 15.64, 15.77], ["wheat,", 15.8, 16.13], ["rice", 16.24, 16.58], ["and", 16.61, 16.71], ["corn,", 16.78, 17.1], ["because", 17.12, 17.36], ["the", 17.38, 17.45], ["wind", 17.5, 17.68], ["pollinates", 17.75, 18.3], ["them.", 18.34, 18.63], ["But", 19.02, 19.17], ["our", 19.2, 19.31], ["plates", 19.36, 19.61], ["would", 19.63, 19.77], ["get", 19.8, 19.91], ["a", 19.95, 19.97], ["lot", 20.03, 20.18], ["more", 20.22, 20.38], ["boring.", 20.41, 20.89]]}, {"text": "Birds, frogs, bats and fish that eat insects would start to starve.", "start": 21.33, "end": 24.81, "words": [["Birds,", 21.33, 21.71], ["frogs,", 21.75, 22.2], ["bats", 22.26, 22.57], ["and", 22.6, 22.7], ["fish", 22.78, 23.03], ["that", 23.07, 23.2], ["eat", 23.24, 23.37], ["insects", 23.43, 23.81], ["would", 23.84, 23.97], ["start", 24.0, 24.2], ["to", 24.23, 24.29], ["starve.", 24.32, 24.81]]}, {"text": "And insects help break down dead plants, dung and bodies. Without them, waste would rot much more slowly, and soil would get poorer.", "start": 25.19, "end": 33.56, "words": [["And", 25.19, 25.37], ["insects", 25.44, 25.82], ["help", 25.87, 26.02], ["break", 26.08, 26.29], ["down", 26.34, 26.54], ["dead", 26.6, 26.78], ["plants,", 26.85, 27.4], ["dung", 27.49, 27.7], ["and", 27.75, 27.82], ["bodies.", 27.86, 28.42], ["Without", 28.8, 29.15], ["them,", 29.19, 29.5], ["waste", 29.71, 30.02], ["would", 30.07, 30.24], ["rot", 30.31, 30.58], ["much", 30.73, 31.01], ["more", 31.08, 31.25], ["slowly,", 31.3, 31.89], ["and", 32.14, 32.3], ["soil", 32.39, 32.67], ["would", 32.72, 32.86], ["get", 32.89, 33.01], ["poorer.", 33.06, 33.56]]}, {"text": "Which insect would you miss the most? Tell me in the comments.", "start": 34.17, "end": 37.76, "words": [["Which", 34.17, 34.39], ["insect", 34.45, 34.81], ["would", 34.83, 34.97], ["you", 34.99, 35.06], ["miss", 35.1, 35.26], ["the", 35.29, 35.36], ["most?", 35.41, 35.89], ["Tell", 36.4, 36.59], ["me", 36.64, 36.7], ["in", 36.73, 36.78], ["the", 36.81, 36.88], ["comments.", 36.93, 37.76]]}]