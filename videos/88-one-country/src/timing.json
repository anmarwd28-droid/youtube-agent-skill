[{"text": "ماذا لو اختفَت كلُّ الحدودِ غداً، وصارَ العالمُ كلُّه دولةً واحدة؟", "start": 0.0, "end": 4.6, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.44], ["اختفَت", 0.46, 0.85], ["كلُّ", 0.91, 1.15], ["الحدودِ", 1.17, 1.61], ["غداً،", 1.67, 2.16], ["وصارَ", 2.32, 2.73], ["العالمُ", 2.76, 3.2], ["كلُّه", 3.26, 3.55], ["دولةً", 3.66, 4.06], ["واحدة؟", 4.11, 4.6]]}, {"text": "نحوُ مئةٍ وخمسٍ وتسعينَ دولةً تصبحُ بلداً واحداً، بعاصمةٍ واحدة.", "start": 5.06, "end": 10.6, "words": [["نحوُ", 5.06, 5.39], ["مئةٍ", 5.45, 5.82], ["وخمسٍ", 5.88, 6.27], ["وتسعينَ", 6.32, 6.78], ["دولةً", 6.83, 7.33], ["تصبحُ", 7.63, 8.15], ["بلداً", 8.2, 8.54], ["واحداً،", 8.62, 9.15], ["بعاصمةٍ", 9.29, 10.04], ["واحدة.", 10.1, 10.6]]}, {"text": "لا جوازاتِ سفرٍ ولا تأشيرات: تسافرُ إلى أيِّ مكانٍ كأنّه مدينةٌ مجاورة.", "start": 10.96, "end": 16.34, "words": [["لا", 10.96, 11.08], ["جوازاتِ", 11.15, 11.67], ["سفرٍ", 11.75, 12.13], ["ولا", 12.2, 12.38], ["تأشيرات:", 12.42, 13.14], ["تسافرُ", 13.44, 13.98], ["إلى", 14.01, 14.14], ["أيِّ", 14.2, 14.41], ["مكانٍ", 14.43, 14.79], ["كأنّه", 14.87, 15.19], ["مدينةٌ", 15.24, 15.7], ["مجاورة.", 15.73, 16.34]]}, {"text": "وعملةٌ واحدةٌ للجميع، فلا تخسرُ شيئاً عندَ تبديلِ العملات.", "start": 16.64, "end": 21.25, "words": [["وعملةٌ", 16.64, 17.19], ["واحدةٌ", 17.28, 17.77], ["للجميع،", 17.83, 18.59], ["فلا", 18.73, 18.94], ["تخسرُ", 18.99, 19.39], ["شيئاً", 19.43, 19.86], ["عندَ", 19.97, 20.25], ["تبديلِ", 20.31, 20.63], ["العملات.", 20.64, 21.25]]}, {"text": "لكنَّ سعرَ فائدةٍ واحداً لا يناسبُ اقتصاداتٍ مختلفة، كما حدثَ لدولِ اليورو في أزمةِ الدَّيْن.", "start": 21.63, "end": 28.18, "words": [["لكنَّ", 21.63, 22.02], ["سعرَ", 22.08, 22.34], ["فائدةٍ", 22.4, 22.81], ["واحداً", 22.88, 23.25], ["لا", 23.3, 23.39], ["يناسبُ", 23.45, 23.87], ["اقتصاداتٍ", 23.89, 24.47], ["مختلفة،", 24.51, 25.26], ["كما", 25.59, 25.87], ["حدثَ", 25.95, 26.33], ["لدولِ", 26.4, 26.85], ["اليورو", 26.88, 27.21], ["في", 27.25, 27.33], ["أزمةِ", 27.38, 27.7], ["الدَّيْن.", 27.73, 