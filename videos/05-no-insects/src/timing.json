[{"text": "تخيّلْ أن تستيقظَ غداً… ولا توجدُ حشرةٌ واحدةٌ على الأرض.", "start": 0.0, "end": 4.54, "words": [["تخيّلْ", 0.0, 0.52], ["أن", 0.56, 0.65], ["تستيقظَ", 0.7, 1.26], ["غداً…", 1.33, 1.88], ["ولا", 2.19, 2.42], ["توجدُ", 2.47, 2.81], ["حشرةٌ", 2.89, 3.35], ["واحدةٌ", 3.41, 3.85], ["على", 3.92, 4.02], ["الأرض.", 4.05, 4.54]]}, {"text": "لا بعوضَ ولا ذباب… يبدو حلماً، أليسَ كذلك؟", "start": 4.84, "end": 8.5, "words": [["لا", 4.84, 4.97], ["بعوضَ", 5.04, 5.48], ["ولا", 5.53, 5.69], ["ذباب…", 5.76, 6.37], ["يبدو", 6.69, 6.95], ["حلماً،", 7.01, 7.54], ["أليسَ", 7.58, 7.87], ["كذلك؟", 7.92, 8.5]]}, {"text": "لكنّ هذا الحلمَ سيتحوّلُ إلى كابوسٍ… خلالَ أشهرٍ فقط.", "start": 8.81, "end": 12.85, "words": [["لكنّ", 8.81, 9.18], ["هذا", 9.22, 9.39], ["الحلمَ", 9.42, 9.76], ["سيتحوّلُ", 9.8, 10.38], ["إلى", 10.41, 10.52], ["كابوسٍ…", 10.6, 11.18], ["خلالَ", 11.55, 11.94], ["أشهرٍ", 11.98, 12.33], ["فقط.", 12.39, 12.85]]}, {"text": "فنحوُ ثلاثةِ أرباعِ أنواعِ المحاصيلِ الغذائيةِ في العالم، تعتمدُ على الملقّحات… وأغلبُها حشرات.", "start": 13.17, "end": 20.26, "words": [["فنحوُ", 13.17, 13.57], ["ثلاثةِ", 13.63, 14.11], ["أرباعِ", 14.15, 14.54], ["أنواعِ", 14.57, 14.95], ["المحاصيلِ", 14.98, 15.56], ["الغذائيةِ", 15.57, 16.16], ["في", 16.21, 16.27], ["العالم،", 16.29, 16.85], ["تعتمدُ", 17.22, 17.67], ["على", 17.72, 17.81], ["الملقّحات…", 17.83, 18.79], ["وأغلبُها", 19.05, 19.59], ["حشرات.", 19.66, 20.26]]}, {"text": "فتصبحُ فواكهُ كثيرةٌ نادرةً وغاليةً جداً: التفاحُ والفراولةُ والكرز… وحتى الكاكاو.", "start": 20.57, "end": 27.45, "words": [["فتصبحُ", 20.57, 21.1], ["فواكهُ", 21.14, 21.61], ["كثيرةٌ", 21.68, 22.2], ["نادرةً", 22.27, 22.77], ["وغاليةً", 22.83, 23.3], ["جداً:", 23.36, 23.82], ["التفاحُ", 24.05, 24.64], ["والفراولةُ", 24.66, 25.36], ["والكرز…", 25.6, 26.37], ["وحتى", 26.55, 26.87], ["الكاكاو.", 26.88, 27.45]]}, {"text": "أمّا القمحُ والأرزُّ والذرة، فتبقى… لأنّ الرياحَ تلقّحُها.", "start": 27.74, "end": 32.17, "words": [["أمّا", 27.74, 27.96], ["القمحُ", 27.98, 28.4], ["والأرزُّ", 28.43, 28.99], ["والذرة،", 29.04, 29.65], ["فتبقى…", 29.79, 30.51], ["لأنّ", 30.72, 31.02], ["الرياحَ", 31.05, 31.42], ["تلقّحُها.", 31.46, 32.17]]}, {"text": "ثمّ تأتي المشكلةُ الأكبر: طيورٌ وضفادعُ وسحالٍ كثيرة، تعيشُ على أكلِ الحشرات.", "start": 32.41, "end": 37.97, "words": [["ثمّ", 32.41, 32.66], ["تأتي", 32.71, 32.9], ["المشكلةُ", 32.93, 33.4], ["الأكبر:", 33.43, 33.97], ["طيورٌ", 34.26, 34.65], ["وضفادعُ", 34.69, 35.28], ["وسحالٍ", 35.33, 35.79], ["كثيرة،", 35.85, 36.45], ["تعيشُ", 36.61, 36.94], ["على", 36.98, 37.08], ["أكلِ", 37.13, 37.33], ["الحشرات.", 37.35, 37.97]]}, {"text": "وبدونِها، تجوع… فتنهارُ سلسلةٌ كاملةٌ من الحيوانات.", "start": 38.26, "end": 42.69, "words": [["وبدونِها،", 38.26, 38.86], ["تجوع…", 38.92, 39.52], ["فتنهارُ", 39.85, 40.51], ["سلسلةٌ", 40.58, 41.09], ["كاملةٌ", 41.17, 41.69], ["من", 41.75, 41.88], ["الحيوانات.", 41.94, 42.69]]}, {"text": "وهناك عملٌ لا نراه: الحشراتُ تحلّلُ الأوراقَ الميتةَ والجيف، وتعيدُها غذاءً للتربة.", "start": 43.13, "end": 49.56, "words": [["وهناك", 43.13, 43.53], ["عملٌ", 43.64, 43.93], ["لا", 44.01, 44.1], ["نراه:", 44.15, 44.65], ["الحشراتُ", 44.9, 45.53], ["تحلّلُ", 45.59, 46.02], ["الأوراقَ", 46.05, 46.49], ["الميتةَ", 46.51, 47.02], ["والجيف،", 47.08, 47.66], ["وتعيدُها", 47.87, 48.5], ["غذاءً", 48.56, 48.94], ["للتربة.", 48.96, 49.56]]}, {"text": "فبدونِها، تتراكمُ الأوراقُ والفضلات، وتفقدُ التربةُ خصوبتَها شيئاً فشيئاً.", "start": 49.89, "end": 55.43, "words": [["فبدونِها،", 49.89, 50.56], ["تتراكمُ", 50.6, 51.17], ["الأوراقُ", 51.19, 51.66], ["والفضلات،", 51.7, 52.49], ["وتفقدُ", 52.7, 53.31], ["التربةُ", 53.34, 53.83], ["خصوبتَها", 53.88, 54.51], ["شيئاً", 54.58, 54.8], ["فشيئاً.", 54.85, 55.43]]}, {"text": "الحشراتُ صغيرةٌ جداً… لكنّها تحملُ العالمَ على ظهرِها.", "start": 55.75, "end": 59.88, "words": [["الحشراتُ", 55.75, 56.34], ["صغيرةٌ", 56.41, 56.85], ["جداً…", 56.92, 57.48], ["لكنّها", 57.73, 58.2], ["تحملُ", 58.27, 58.66], ["العالمَ", 58.69, 59.06], ["على", 59.12, 59.25], ["ظهرِها.", 59.32, 59.88]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 60.21, "end": 66.41, "words": [["والآن", 60.21, 60.54], ["دورُك:", 60.59, 61.12], ["ماذا", 61.33, 61.57], ["لو…؟", 61.62, 62.14], ["اكتبْ", 62.52, 62.92], ["سؤالَك", 62.94, 63.38], ["في", 63.5, 63.55], ["التعليقات،", 63.59, 64.41], ["وقد", 64.59, 64.9], ["يكونُ", 64.96, 65.24], ["الفيديو", 65.26, 65.57], ["القادم.", 65.6, 66.41]]}]