[{"text": "ماذا لو اختفت كلُّ الحشراتِ من الأرض… غداً؟", "start": 0.0, "end": 3.31, "words": [["ماذا", 0.0, 0.29], ["لو", 0.31, 0.43], ["اختفت", 0.46, 0.82], ["كلُّ", 0.88, 1.09], ["الحشراتِ", 1.11, 1.64], ["من", 1.67, 1.75], ["الأرض…", 1.79, 2.45], ["غداً؟", 2.79, 3.31]]}, {"text": "قد تفرحُ في البداية: لا بعوضَ ولا ذباب.", "start": 3.84, "end": 6.99, "words": [["قد", 3.84, 3.97], ["تفرحُ", 4.02, 4.4], ["في", 4.43, 4.49], ["البداية:", 4.52, 5.16], ["لا", 5.55, 5.68], ["بعوضَ", 5.75, 6.2], ["ولا", 6.25, 6.42], ["ذباب.", 6.48, 6.99]]}, {"text": "لكنّ نحوَ ثلاثةِ أرباعِ أنواعِ المحاصيلِ الغذائيةِ في العالم، تعتمدُ على الملقّحات… وأغلبُها حشرات.", "start": 7.28, "end": 15.13, "words": [["لكنّ", 7.28, 7.62], ["نحوَ", 7.67, 8.09], ["ثلاثةِ", 8.24, 8.84], ["أرباعِ", 8.9, 9.39], ["أنواعِ", 9.4, 9.75], ["المحاصيلِ", 9.76, 10.37], ["الغذائيةِ", 10.39, 10.99], ["في", 11.03, 11.09], ["العالم،", 11.11, 11.69], ["تعتمدُ", 12.03, 12.49], ["على", 12.57, 12.68], ["الملقّحات…", 12.71, 13.65], ["وأغلبُها", 13.9, 14.48], ["حشرات.", 14.54, 15.13]]}, {"text": "فتصبحُ فواكهُ كثيرةٌ نادرةً وغاليةً جداً: التفاحُ والفراولةُ والكرز… وحتى الكاكاو.", "start": 15.42, "end": 22.36, "words": [["فتصبحُ", 15.42, 16.03], ["فواكهُ", 16.09, 16.54], ["كثيرةٌ", 16.6, 17.08], ["نادرةً", 17.16, 17.7], ["وغاليةً", 17.81, 18.32], ["جداً:", 18.37, 18.81], ["التفاحُ", 19.05, 19.69], ["والفراولةُ", 19.73, 20.39], ["والكرز…", 20.45, 21.16], ["وحتى", 21.34, 21.72], ["الكاكاو.", 21.75, 22.36]]}, {"text": "أمّا القمحُ والأرزُّ والذرة، فتبقى… لأنّ الرياحَ تلقّحُها.", "start": 22.68, "end": 27.14, "words": [["أمّا", 22.68, 22.92], ["القمحُ", 22.94, 23.39], ["والأرزُّ", 23.42, 24.02], ["والذرة،", 24.07, 24.59], ["فتبقى…", 24.66, 25.51], ["لأنّ", 25.74, 26.02], ["الرياحَ", 26.04, 26.4], ["تلقّحُها.", 26.43, 27.14]]}, {"text": "ثمّ تأتي المشكلةُ الأكبر: طيورٌ وضفادعُ وسحالٍ كثيرة، تعيشُ على أكلِ الحشرات.", "start": 27.47, "end": 33.31, "words": [["ثمّ", 27.47, 27.71], ["تأتي", 27.8, 28.0], ["المشكلةُ", 28.03, 28.55], ["الأكبر:", 28.58, 29.2], ["طيورٌ", 29.43, 29.84], ["وضفادعُ", 29.9, 30.57], ["وسحالٍ", 30.59, 31.08], ["كثيرة،", 31.15, 31.72], ["تعيشُ", 31.89, 32.22], ["على", 32.28, 32.38], ["أكلِ", 32.43, 32.62], ["الحشرات.", 32.65, 33.31]]}, {"text": "وبدونِها، تجوع… فتنهارُ سلسلةٌ كاملةٌ من الحيوانات.", "start": 33.62, "end": 37.67, "words": [["وبدونِها،", 33.62, 34.37], ["تجوع…", 34.41, 35.1], ["فتنهارُ", 35.31, 35.88], ["سلسلةٌ", 35.93, 36.38], ["كاملةٌ", 36.44, 36.86], ["من", 36.88, 36.99], ["الحيوانات.", 37.02, 37.67]]}, {"text": "وهناك عملٌ لا نراه: الحشراتُ تحلّلُ الأوراقَ الميتةَ والجيف، وتعيدُها غذاءً للتربة.", "start": 38.0, "end": 44.87, "words": [["وهناك", 38.0, 38.37], ["عملٌ", 38.49, 38.77], ["لا", 38.85, 38.92], ["نراه:", 38.99, 39.45], ["الحشراتُ", 39.62, 40.24], ["تحلّلُ", 40.31, 40.73], ["الأوراقَ", 40.75, 41.19], ["الميتةَ", 41.22, 41.94], ["والجيف،", 42.17, 42.88], ["وتعيدُها", 43.07, 43.77], ["غذاءً", 43.85, 44.23], ["للتربة.", 44.27, 44.87]]}, {"text": "فبدونِها، تتراكمُ الأوراقُ والفضلات، وتفقدُ التربةُ خصوبتَها شيئاً فشيئاً.", "start": 45.19, "end": 51.22, "words": [["فبدونِها،", 45.19, 46.06], ["تتراكمُ", 46.23, 46.92], ["الأوراقُ", 46.94, 47.48], ["والفضلات،", 47.52, 48.24], ["وتفقدُ", 48.48, 49.04], ["التربةُ", 49.06, 49.56], ["خصوبتَها", 49.62, 50.27], ["شيئاً", 50.35, 50.64], ["فشيئاً.", 50.7, 51.22]]}, {"text": "الحشراتُ صغيرةٌ جداً… لكنّها تحملُ العالمَ على ظهرِها.", "start": 51.55, "end": 55.39, "words": [["الحشراتُ", 51.55, 52.12], ["صغيرةٌ", 52.18, 52.62], ["جداً…", 52.69, 53.21], ["لكنّها", 53.42, 53.86], ["تحملُ", 53.93, 54.27], ["العالمَ", 54.29, 54.67], ["على", 54.72, 54.84], ["ظهرِها.", 54.9, 55.39]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 55.72, "end": 61.02, "words": [["والآن", 55.72, 56.01], ["دورُك:", 56.06, 56.52], ["ماذا", 56.67, 56.89], ["لو…؟", 56.94, 57.4], ["اكتبْ", 57.78, 58.13], ["سؤالَك", 58.16, 58.53], ["في", 58.59, 58.63], ["التعليقات،", 58.65, 59.26], ["وقد", 59.29, 59.54], ["يكونُ", 59.58, 59.86], ["الفيديو", 59.88, 60.19], ["القادم.", 60.21, 61.02]]}]