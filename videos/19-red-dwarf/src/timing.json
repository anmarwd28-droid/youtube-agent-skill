[{"text": "ماذا لو تحوّلتِ الشمسُ فجأةً إلى قزمٍ أحمر؟", "start": 0.0, "end": 2.88, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.41], ["تحوّلتِ", 0.46, 1.02], ["الشمسُ", 1.03, 1.38], ["فجأةً", 1.44, 1.85], ["إلى", 1.88, 1.99], ["قزمٍ", 2.06, 2.37], ["أحمر؟", 2.4, 2.88]]}, {"text": "القزمُ الأحمرُ نجمٌ أصغرُ وأبردُ بكثير… وهو أكثرُ النجومِ انتشاراً في مجرّتنا.", "start": 3.42, "end": 9.59, "words": [["القزمُ", 3.42, 3.87], ["الأحمرُ", 3.89, 4.32], ["نجمٌ", 4.38, 4.68], ["أصغرُ", 4.74, 5.2], ["وأبردُ", 5.34, 5.9], ["بكثير…", 5.94, 6.59], ["وهو", 7.14, 7.34], ["أكثرُ", 7.41, 7.75], ["النجومِ", 7.77, 8.2], ["انتشاراً", 8.21, 8.68], ["في", 8.74, 8.8], ["مجرّتنا.", 8.86, 9.59]]}, {"text": "ستبدو الشمسُ أصغرَ بنحوِ سبعِ مرّات، ويصبحُ النهارُ برتقالياً خافتاً… أعتمَ من الغسق.", "start": 10.14, "end": 16.89, "words": [["ستبدو", 10.14, 10.53], ["الشمسُ", 10.55, 10.9], ["أصغرَ", 10.94, 11.32], ["بنحوِ", 11.34, 11.66], ["سبعِ", 11.7, 11.99], ["مرّات،", 12.01, 12.59], ["ويصبحُ", 12.84, 13.42], ["النهارُ", 13.44, 13.89], ["برتقالياً", 13.92, 14.56], ["خافتاً…", 14.62, 15.27], ["أعتمَ", 15.56, 16.02], ["من", 16.08, 16.2], ["الغسق.", 16.25, 16.89]]}, {"text": "لكنّ المفاجأةَ في الجاذبية: كتلتُها تصبحُ نحوَ ثُمنِ كتلةِ الشمس، فلا تستطيعُ الإمساكَ بالأرض.", "start": 17.34, "end": 24.54, "words": [["لكنّ", 17.34, 17.69], ["المفاجأةَ", 17.72, 18.33], ["في", 18.39, 18.45], ["الجاذبية:", 18.47, 19.28], ["كتلتُها", 19.63, 20.21], ["تصبحُ", 20.28, 20.7], ["نحوَ", 20.75, 20.99], ["ثُمنِ", 21.04, 21.28], ["كتلةِ", 21.36, 21.7], ["الشمس،", 21.72, 22.3], ["فلا", 22.63, 22.87], ["تستطيعُ", 22.94, 23.45], ["الإمساكَ", 23.48, 23.95], ["بالأرض.", 24.0, 24.54]]}, {"text": "فتنطلقُ الأرضُ وكلُّ الكواكبِ بعيداً في الفضاء… ولا تعودُ أبداً.", "start": 24.79, "end": 29.91, "words": [["فتنطلقُ", 24.79, 25.59], ["الأرضُ", 25.61, 26.03], ["وكلُّ", 26.06, 26.47], ["الكواكبِ", 26.49, 27.23], ["بعيداً", 27.31, 27.76], ["في", 27.81, 27.86], ["الفضاء…", 27.9, 28.5], ["ولا", 28.83, 29.06], ["تعودُ", 29.12, 29.42], ["أبداً.", 29.45, 29.91]]}, {"text": "كلَّ سنةٍ نبتعدُ أكثرَ من ثمانمئةِ مليونِ كيلومتر، فيخفتُ الضوءُ والدفءُ بسرعة.", "start": 30.41, "end": 36.48, "words": [["كلَّ", 30.41, 30.66], ["سنةٍ", 30.71, 31.05], ["نبتعدُ", 31.09, 31.57], ["أكثرَ", 31.61, 31.95], ["من", 32.01, 32.1], ["ثمانمئةِ", 32.16, 32.75], ["مليونِ", 32.8, 33.11], ["كيلومتر،", 33.17, 33.83], ["فيخفتُ", 34.16, 34.69], ["الضوءُ", 34.73, 35.19], ["والدفءُ", 35.4, 35.86], ["بسرعة.", 35.91, 36.48]]}, {"text": "تتجمّدُ المحيطات، وتهبطُ الحرارةُ إلى أكثرَ من مئتي درجةٍ تحتَ الصفر.", "start": 36.8, "end": 42.07, "words": [["تتجمّدُ", 36.8, 37.4], ["المحيطات،", 37.42, 38.27], ["وتهبطُ", 38.44, 39.0], ["الحرارةُ", 39.03, 39.64], ["إلى", 39.71, 39.84], ["أكثرَ", 39.89, 40.24], ["من", 40.29, 40.39], ["مئتي", 40.42, 40.8], ["درجةٍ", 40.87, 41.28], ["تحتَ", 41.34, 41.55], ["الصفر.", 41.58, 42.07]]}, {"text": "وبعدَ آلافِ السنين… حتى الهواءُ نفسُه يتجمّدُ ويتساقطُ ثلجاً.", "start": 42.36, "end": 47.34, "words": [["وبعدَ", 42.36, 42.79], ["آلافِ", 42.84, 43.16], ["السنين…", 43.19, 43.9], ["حتى", 44.2, 44.51], ["الهواءُ", 44.53, 44.91], ["نفسُه", 44.98, 45.36], ["يتجمّدُ", 45.46, 46.14], ["ويتساقطُ", 46.16, 46.83], ["ثلجاً.", 46.89, 47.34]]}, {"text": "والغريب؟ قد تهيمُ في مجرّتِنا ملياراتُ الكواكبِ مثلَها، بلا نجم.", "start": 47.65, "end": 52.77, "words": [["والغريب؟", 47.65, 48.32], ["قد", 48.67, 48.83], ["تهيمُ", 48.87, 49.21], ["في", 49.27, 49.33], ["مجرّتِنا", 49.4, 50.03], ["ملياراتُ", 50.11, 50.63], ["الكواكبِ", 50.66, 51.22], ["مثلَها،", 51.27, 51.86], ["بلا", 52.05, 52.29], ["نجم.", 52.34, 52.77]]}, {"text": "أمّا الأقزامُ الحمراءُ فتعيشُ تريليوناتِ السنين… وقد تدورُ حولَها عوالمُ صالحةٌ للحياة، مثلَ بروكسيما بي.", "start": 53.07, "end": 61.07, "words": [["أمّا", 53.07, 53.34], ["الأقزامُ", 53.35, 53.89], ["الحمراءُ", 53.93, 54.45], ["فتعيشُ", 54.52, 54.98], ["تريليوناتِ", 55.01, 55.58], ["السنين…", 55.59, 56.22], ["وقد", 56.52, 56.8], ["تدورُ", 56.85, 57.17], ["حولَها", 57.24, 57.6], ["عوالمُ", 57.68, 58.14], ["صالحةٌ", 58.2, 58.71], ["للحياة،", 58.77, 59.52], ["مثلَ", 59.77, 60.08], ["بروكسيما", 60.13, 60.64], ["بي.", 60.72, 61.07]]}, {"text": "لكنِ اطمئنّ: شمسُنا لن تصبحَ قزماً أحمرَ أبداً. اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 61.51, "end": 69.8, "words": [["لكنِ", 61.51, 61.83], ["اطمئنّ:", 61.86, 62.53], ["شمسُنا", 62.97, 63.47], ["لن", 63.54, 63.67], ["تصبحَ", 63.74, 64.23], ["قزماً", 64.28, 64.68], ["أحمرَ", 64.72, 65.15], ["أبداً.", 65.18, 65.72], ["اكتبْ", 65.97, 66.36], ["سؤالَك", 66.39, 66.72], ["في", 66.81, 66.88], ["التعليقات،", 66.91, 67.73], ["وقد", 67.91, 68.24], ["يكونُ", 68.3, 68.64], ["الفيديو", 68.66, 68.97], ["القادم.", 69.0, 69.8]]}]