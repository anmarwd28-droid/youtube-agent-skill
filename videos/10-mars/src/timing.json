[{"text": "ماذا لو انتقلتَ للعيشِ على المريخ؟", "start": 0.0, "end": 1.96, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.43], ["انتقلتَ", 0.45, 0.87], ["للعيشِ", 0.91, 1.24], ["على", 1.28, 1.36], ["المريخ؟", 1.39, 1.96]]}, {"text": "الرحلةُ وحدَها تستغرقُ نحوَ سبعةِ أشهر.", "start": 2.39, "end": 5.13, "words": [["الرحلةُ", 2.39, 2.88], ["وحدَها", 2.94, 3.33], ["تستغرقُ", 3.4, 3.94], ["نحوَ", 3.99, 4.23], ["سبعةِ", 4.28, 4.64], ["أشهر.", 4.69, 5.13]]}, {"text": "وعندما تصل، تشعرُ أنّ جسمَك خفيف! فالجاذبيةُ هنا أقلُّ من نصفِ جاذبيةِ الأرض… فتقفزُ أعلى بنحوِ مرّتينِ ونصف.", "start": 5.45, "end": 14.66, "words": [["وعندما", 5.45, 5.91], ["تصل،", 5.97, 6.49], ["تشعرُ", 6.7, 7.13], ["أنّ", 7.17, 7.35], ["جسمَك", 7.42, 7.75], ["خفيف!", 7.87, 8.43], ["فالجاذبيةُ", 8.74, 9.5], ["هنا", 9.54, 9.88], ["أقلُّ", 10.11, 10.56], ["من", 10.59, 10.67], ["نصفِ", 10.7, 10.94], ["جاذبيةِ", 11.01, 11.47], ["الأرض…", 11.49, 12.01], ["فتقفزُ", 12.25, 12.86], ["أعلى", 12.92, 13.17], ["بنحوِ", 13.25, 13.6], ["مرّتينِ", 13.64, 14.14], ["ونصف.", 14.2, 14.66]]}, {"text": "لكن لا تخلعْ بدلتَك أبداً. فالهواءُ رقيقٌ جداً، ومعظمُه ثاني أكسيدِ الكربون… وبدونِ البدلة تفقدُ وعيَك خلالَ ثوانٍ.", "start": 15.05, "end": 23.73, "words": [["لكن", 15.05, 15.34], ["لا", 15.39, 15.49], ["تخلعْ", 15.57, 15.96], ["بدلتَك", 15.99, 16.45], ["أبداً.", 16.54, 17.0], ["فالهواءُ", 17.28, 17.75], ["رقيقٌ", 17.79, 18.18], ["جداً،", 18.24, 18.74], ["ومعظمُه", 18.88, 19.53], ["ثاني", 19.63, 19.86], ["أكسيدِ", 19.91, 20.21], ["الكربون…", 20.24, 20.9], ["وبدونِ", 21.21, 21.69], ["البدلة", 21.72, 22.12], ["تفقدُ", 22.16, 22.56], ["وعيَك", 22.61, 22.91], ["خلالَ", 22.98, 23.22], ["ثوانٍ.", 23.27, 23.73]]}, {"text": "والبردُ قاسٍ: متوسّطُ الحرارةِ نحوَ ستّينَ درجةً تحتَ الصفر.", "start": 24.09, "end": 29.16, "words": [["والبردُ", 24.09, 24.51], ["قاسٍ:", 24.58, 25.1], ["متوسّطُ", 25.3, 26.0], ["الحرارةِ", 26.03, 26.62], ["نحوَ", 26.69, 26.95], ["ستّينَ", 26.99, 27.39], ["درجةً", 27.45, 28.0], ["تحتَ", 28.31, 28.61], ["الصفر.", 28.63, 29.16]]}, {"text": "والسماءُ نهاراً بلونٍ ورديٍّ مُغبرّ… أمّا الغروبُ، فأزرق!", "start": 29.52, "end": 33.96, "words": [["والسماءُ", 29.52, 30.02], ["نهاراً", 30.08, 30.51], ["بلونٍ", 30.57, 30.92], ["ورديٍّ", 30.99, 31.43], ["مُغبرّ…", 31.45, 32.04], ["أمّا", 32.24, 32.51], ["الغروبُ،", 32.52, 33.18], ["فأزرق!", 33.24, 33.96]]}, {"text": "وأحياناً تهبُّ عواصفُ غبار، تغطّي الكوكبَ كلَّه لأسابيع.", "start": 34.19, "end": 38.87, "words": [["وأحياناً", 34.19, 34.85], ["تهبُّ", 35.04, 35.45], ["عواصفُ", 35.48, 35.99], ["غبار،", 36.04, 36.61], ["تغطّي", 36.77, 37.19], ["الكوكبَ", 37.21, 37.69], ["كلَّه", 37.72, 38.05], ["لأسابيع.", 38.13, 38.87]]}, {"text": "ولأنّ المريخَ بلا مجالٍ مغناطيسيٍّ يحميه، ستعيشُ تحتَ التربة، أو داخلَ ملاجئَ سميكة… هرباً من الإشعاع.", "start": 39.23, "end": 47.26, "words": [["ولأنّ", 39.23, 39.59], ["المريخَ", 39.61, 40.01], ["بلا", 40.05, 40.23], ["مجالٍ", 40.27, 40.63], ["مغناطيسيٍّ", 40.68, 41.4], ["يحميه،", 41.41, 42.09], ["ستعيشُ", 42.39, 42.93], ["تحتَ", 42.99, 43.24], ["التربة،", 43.26, 43.82], ["أو", 43.94, 44.07], ["داخلَ", 44.15, 44.48], ["ملاجئَ", 44.52, 44.94], ["سميكة…", 44.99, 45.6], ["هرباً", 46.02, 46.39], ["من", 46.43, 46.54], ["الإشعاع.", 46.59, 47.26]]}, {"text": "وتزرعُ طعامَك في بيوتٍ زجاجية، وتستخرجُ الماءَ من الجليدِ المدفون.", "start": 47.62, "end": 52.48, "words": [["وتزرعُ", 47.62, 48.15], ["طعامَك", 48.2, 48.6], ["في", 48.68, 48.76], ["بيوتٍ", 48.84, 49.15], ["زجاجية،", 49.2, 49.96], ["وتستخرجُ", 50.19, 50.93], ["الماءَ", 50.96, 51.25], ["من", 51.27, 51.39], ["الجليدِ", 51.43, 51.81], ["المدفون.", 51.84, 52.48]]}, {"text": "اليومُ هنا أطولُ بقليلٍ من يومِ الأرض… لكنّ السنةَ تقاربُ سنتينِ من سنواتِنا.", "start": 52.9, "end": 58.57, "words": [["اليومُ", 52.9, 53.31], ["هنا", 53.36, 53.6], ["أطولُ", 53.66, 54.07], ["بقليلٍ", 54.1, 54.54], ["من", 54.59, 54.7], ["يومِ", 54.74, 54.9], ["الأرض…", 54.93, 55.46], ["لكنّ", 55.76, 56.13], ["السنةَ", 56.16, 56.63], ["تقاربُ", 56.68, 57.12], ["سنتينِ", 57.18, 57.66], ["من", 57.7, 57.8], ["سنواتِنا.", 57.84, 58.57]]}, {"text": "فهل كنتَ ستذهب؟ اكتبْ رأيَك في التعليقات… وقد يكونُ سؤالُك الفيديو القادم.", "start": 58.82, "end": 64.64, "words": [["فهل", 58.82, 59.01], ["كنتَ", 59.08, 59.3], ["ستذهب؟", 59.36, 60.01], ["اكتبْ", 60.29, 60.69], ["رأيَك", 60.71, 60.99], ["في", 61.05, 61.09], ["التعليقات…", 61.12, 61.93], ["وقد", 62.21, 62.52], ["يكونُ", 62.57, 62.87], ["سؤالُك", 62.93, 63.38], ["الفيديو", 63.49, 63.85], ["القادم.", 63.88, 64.64]]}]