[{"text": "ماذا لو اختفتِ الشمسُ الآن… في لحظةٍ واحدة؟", "start": 0.0, "end": 3.59, "words": [["ماذا", 0.0, 0.33], ["لو", 0.37, 0.5], ["اختفتِ", 0.53, 0.99], ["الشمسُ", 1.01, 1.41], ["الآن…", 1.44, 2.01], ["في", 2.39, 2.52], ["لحظةٍ", 2.58, 2.96], ["واحدة؟", 3.04, 3.59]]}, {"text": "لا ضوء، ولا دفء، ولا شيءَ يُمسكُ الأرضَ في مكانها.", "start": 4.03, "end": 8.78, "words": [["لا", 4.03, 4.19], ["ضوء،", 4.31, 4.72], ["ولا", 5.05, 5.33], ["دفء،", 5.4, 5.89], ["ولا", 6.21, 6.48], ["شيءَ", 6.57, 6.87], ["يُمسكُ", 6.93, 7.42], ["الأرضَ", 7.46, 7.88], ["في", 7.93, 8.01], ["مكانها.", 8.08, 8.78]]}, {"text": "سنتابعُ ما يحدثُ من الثانيةِ الأولى حتى مليونِ سنة. وفي النهاية ستعرفُ مَن ينجو حقّاً… والجوابُ ليس الإنسان.", "start": 9.47, "end": 19.55, "words": [["سنتابعُ", 9.47, 10.19], ["ما", 10.25, 10.31], ["يحدثُ", 10.37, 10.76], ["من", 10.82, 10.93], ["الثانيةِ", 10.98, 11.51], ["الأولى", 11.54, 12.02], ["حتى", 12.34, 12.72], ["مليونِ", 12.79, 13.17], ["سنة.", 13.22, 13.64], ["وفي", 14.03, 14.29], ["النهاية", 14.31, 14.99], ["ستعرفُ", 15.23, 15.85], ["مَن", 15.92, 16.03], ["ينجو", 16.09, 16.36], ["حقّاً…", 16.43, 17.02], ["والجوابُ", 17.34, 18.01], ["ليس", 18.08, 18.3], ["الإنسان.", 18.36, 19.55]]}, {"text": "في الثانيةِ الأولى… لا يحدثُ شيء. الشمسُ ما زالت في السماء، والناسُ يمشون في الشوارع كأيِّ يومٍ عاديّ.", "start": 21.95, "end": 29.74, "words": [["في", 21.95, 22.11], ["الثانيةِ", 22.15, 22.65], ["الأولى…", 22.68, 23.31], ["لا", 23.55, 23.67], ["يحدثُ", 23.74, 24.15], ["شيء.", 24.24, 24.66], ["الشمسُ", 24.89, 25.38], ["ما", 25.43, 25.49], ["زالت", 25.59, 25.83], ["في", 25.89, 25.95], ["السماء،", 25.97, 26.6], ["والناسُ", 26.86, 27.38], ["يمشون", 27.44, 27.79], ["في", 27.86, 27.93], ["الشوارع", 27.95, 28.42], ["كأيِّ", 28.5, 28.88], ["يومٍ", 28.91, 29.18], ["عاديّ.", 29.24, 29.74]]}, {"text": "السببُ أنّ ضوءَ الشمس يحتاجُ ثمانيَ دقائقَ وعشرين ثانيةً ليصلَ إلينا. فنحن الآن نرى شمساً لم تعدْ موجودة.", "start": 30.11, "end": 38.86, "words": [["السببُ", 30.11, 30.68], ["أنّ", 30.74, 30.9], ["ضوءَ", 30.97, 31.22], ["الشمس", 31.24, 31.65], ["يحتاجُ", 31.72, 32.15], ["ثمانيَ", 32.2, 32.62], ["دقائقَ", 32.68, 33.32], ["وعشرين", 33.58, 34.15], ["ثانيةً", 34.27, 34.92], ["ليصلَ", 35.15, 35.59], ["إلينا.", 35.64, 36.13], ["فنحن", 36.5, 36.86], ["الآن", 36.9, 37.21], ["نرى", 37.23, 37.42], ["شمساً", 37.5, 37.85], ["لم", 37.89, 37.98], ["تعدْ", 38.05, 38.29], ["موجودة.", 38.31, 38.86]]}, {"text": "خلال هذه الدقائق يكملُ العالمُ حياتَه: طائراتٌ تُقلع، وأطفالٌ في المدارس، ولا أحدَ يعرفُ أنّ العدَّ التنازليَّ قد بدأ.", "start": 39.18, "end": 47.98, "words": [["خلال", 39.18, 39.49], ["هذه", 39.56, 39.78], ["الدقائق", 39.81, 40.35], ["يكملُ", 40.41, 40.75], ["العالمُ", 40.77, 41.13], ["حياتَه:", 41.19, 41.72], ["طائراتٌ", 42.11, 42.72], ["تُقلع،", 42.8, 43.26], ["وأطفالٌ", 43.34, 43.86], ["في", 43.92, 43.98], ["المدارس،", 44.0, 44.71], ["ولا", 45.03, 45.28], ["أحدَ", 45.31, 45.65], ["يعرفُ", 45.72, 46.08], ["أنّ", 46.13, 46.3], ["العدَّ", 46.33, 46.69], ["التنازليَّ", 46.72, 47.35], ["قد", 47.41, 47.54], ["بدأ.", 47.57, 47.98]]}, {"text": "والأغربُ أنّ الأرضَ تواصلُ الدورانَ حول مكانٍ فارغ. فالجاذبيّةُ أيضاً تنتقلُ بسرعةِ الضوء، ولا يصلُ خبرُها قبله.", "start": 48.36, "end": 57.5, "words": [["والأغربُ", 48.36, 48.92], ["أنّ", 48.98, 49.13], ["الأرضَ", 49.17, 49.52], ["تواصلُ", 49.57, 50.05], ["الدورانَ", 50.07, 50.78], ["حول", 51.02, 51.25], ["مكانٍ", 51.32, 51.65], ["فارغ.", 51.72, 52.15], ["فالجاذبيّةُ", 52.47, 53.34], ["أيضاً", 53.4, 53.8], ["تنتقلُ", 54.04, 54.58], ["بسرعةِ", 54.62, 55.07], ["الضوء،", 55.1, 55.59], ["ولا", 55.83, 56.07], ["يصلُ", 56.13, 56.49], ["خبرُها", 56.56, 56.96], ["قبله.", 57.04, 57.5]]}, {"text": "ثمّ تنتهي الدقائقُ الثماني. ينطفئُ النهارُ دفعةً واحدة، كأنّ أحداً أطفأ المصباح. ونصفُ العالم الذي كان في الليل لا يلاحظُ شيئاً بعد.", "start": 57.8, "end": 67.94, "words": [["ثمّ", 57.8, 58.06], ["تنتهي", 58.1, 58.41], ["الدقائقُ", 58.43, 59.07], ["الثماني.", 59.09, 59.73], ["ينطفئُ", 60.04, 60.54], ["النهارُ", 60.55, 60.97], ["دفعةً", 61.03, 61.41], ["واحدة،", 61.48, 61.96], ["كأنّ", 62.23, 62.53], ["أحداً", 62.57, 62.96], ["أطفأ", 62.99, 63.29], ["المصباح.", 63.32, 63.96], ["ونصفُ", 64.27, 64.66], ["العالم", 64.69, 65.08], ["الذي", 65.14, 65.42], ["كان", 65.49, 65.67], ["في", 65.76, 65.8], ["الليل", 65.84, 66.2], ["لا", 66.51, 66.64], ["يلاحظُ", 66.71, 67.13], ["شيئاً", 67.18, 67.45], ["بعد.", 67.5, 67.94]]}, {"text": "وفي اللحظةِ نفسِها تُفلتُ الأرضُ من مدارِها، وتنطلقُ في خطٍّ مستقيم بسرعةِ مئةٍ وسبعةِ آلافِ كيلومترٍ في الساعة.", "start": 68.24, "end": 77.12, "words": [["وفي", 68.24, 68.5], ["اللحظةِ", 68.52, 68.98], ["نفسِها", 69.05, 69.55], ["تُفلتُ", 69.78, 70.19], ["الأرضُ", 70.23, 70.54], ["من", 70.6, 70.69], ["مدارِها،", 70.72, 71.4], ["وتنطلقُ", 71.6, 72.34], ["في", 72.4, 72.47], ["خطٍّ", 72.58, 72.87], ["مستقيم", 72.88, 73.49], ["بسرعةِ", 73.8, 74.36], ["مئةٍ", 74.43, 74.79], ["وسبعةِ", 74.87, 75.37], ["آلافِ", 75.43, 75.76], ["كيلومترٍ", 75.84, 76.38], ["في", 76.44, 76.49], ["الساعة.", 76.53, 77.12]]}, {"text": "لن نشعرَ بأيِّ اهتزاز، فكلُّ ما على الأرض يتحرّكُ معها. والقمرُ يبقى يدورُ حولَنا. لكن… هل سنراه؟", "start": 77.56, "end": 86.55, "words": [["لن", 77.56, 77.75], ["نشعرَ", 77.78, 78.18], ["بأيِّ", 78.24, 78.53], ["اهتزاز،", 78.55, 79.28], ["فكلُّ", 79.4, 79.85], ["ما", 79.89, 79.97], ["على", 80.01, 80.14], ["الأرض", 80.18, 80.48], ["يتحرّكُ", 80.54, 81.02], ["معها.", 81.08, 81.58], ["والقمرُ", 81.91, 82.46], ["يبقى", 82.51, 82.76], ["يدورُ", 82.81, 83.1], ["حولَنا.", 83.17, 83.76], ["لكن…", 84.15, 84.88], ["هل", 85.2, 85.39], ["سنراه؟", 85.45, 86.55]]}, {"text": "لا. بعد لحظاتٍ يختفي القمرُ من السماء، فهو لا يضيءُ بنفسِه، بل يعكسُ ضوءَ الشمس.", "start": 88.95, "end": 95.53, "words": [["لا.", 88.95, 89.38], ["بعد", 89.79, 90.03], ["لحظاتٍ", 90.1, 90.63], ["يختفي", 90.75, 91.09], ["القمرُ", 91.12, 91.55], ["من", 91.6, 91.69], ["السماء،", 91.75, 92.3], ["فهو", 92.49, 92.73], ["لا", 92.82, 92.87], ["يضيءُ", 92.93, 93.25], ["بنفسِه،", 93.28, 93.9], ["بل", 94.13, 94.27], ["يعكسُ", 94.31, 94.67], ["ضوءَ", 94.73, 94.95], ["الشمس.", 94.96, 95.53]]}, {"text": "أمّا الكواكبُ فتبقى مضيئةً قليلاً، لأنّ آخرَ ضوءٍ من الشمس ما زال مسافراً إليها. المشتري مثلاً يظلُّ يلمعُ نحوَ ساعةٍ كاملة، ثمّ ينطفئ.", "start": 95.76, "end": 106.27, "words": [["أمّا", 95.76, 96.0], ["الكواكبُ", 96.02, 96.61], ["فتبقى", 96.67, 97.06], ["مضيئةً", 97.12, 97.56], ["قليلاً،", 97.63, 98.19], ["لأنّ", 98.42, 98.75], ["آخرَ", 98.81, 99.19], ["ضوءٍ", 99.27, 99.53], ["من", 99.57, 99.68], ["الشمس", 99.74, 100.04], ["ما", 100.15, 100.2], ["زال", 100.29, 100.44], ["مسافراً", 100.54, 101.0], ["إليها.", 101.04, 101.51], ["المشتري", 101.98, 102.45], ["مثلاً", 102.51, 102.94], ["يظلُّ", 103.09, 103.52], ["يلمعُ", 103.55, 103.91], ["نحوَ", 103.94, 104.18], ["ساعةٍ", 104.23, 104.58], ["كاملة،", 104.63, 105.21], ["ثمّ", 105.38, 105.63], ["ينطفئ.", 105.67, 106.27]]}, {"text": "الأقمارُ الصناعيّةُ تفقدُ ألواحَها الشمسيّة وتعيشُ على بطّاريّاتِها. والكواكبُ كلُّها تتفرّقُ في الفضاء، كلُّ واحدٍ في طريق.", "start": 106.65, "end": 116.09, "words": [["الأقمارُ", 106.65, 107.14], ["الصناعيّةُ", 107.17, 107.85], ["تفقدُ", 107.92, 108.33], ["ألواحَها", 108.37, 108.85], ["الشمسيّة", 108.87, 109.58], ["وتعيشُ", 109.79, 110.32], ["على", 110.36, 110.46], ["بطّاريّاتِها.", 110.53, 111.52], ["والكواكبُ", 111.8, 112.56], ["كلُّها", 112.62, 113.03], ["تتفرّقُ", 113.09, 113.64], ["في", 113.69, 113.75], ["الفضاء،", 113.77, 114.47], ["كلُّ", 114.68, 114.98], ["واحدٍ", 115.03, 115.4], ["في", 115.44, 115.51], ["طريق.", 115.59, 116.09]]}, {"text": "حتى المدُّ والجزرُ يضعف، فالشمسُ كانت تصنعُ ثلثَه تقريباً، ويبقى للقمرِ الباقي.", "start": 116.37, "end": 122.65, "words": [["حتى", 116.37, 116.67], ["المدُّ", 116.7, 117.06], ["والجزرُ", 117.08, 117.57], ["يضعف،", 117.63, 118.25], ["فالشمسُ", 118.43, 118.89], ["كانت", 118.95, 119.17], ["تصنعُ", 119.2, 119.62], ["ثلثَه", 119.7, 120.08], ["تقريباً،", 120.16, 120.88], ["ويبقى", 121.09, 121.56], ["للقمرِ", 121.6, 122.03], ["الباقي.", 122.05, 122.65]]}, {"text": "وبعدها تظهرُ أجملُ سماءٍ رآها البشر: آلافُ النجومِ ودربُ التبّانة، في وقتِ الظهيرة.", "start": 122.93, "end": 129.6, "words": [["وبعدها", 122.93, 123.52], ["تظهرُ", 123.58, 124.0], ["أجملُ", 124.06, 124.44], ["سماءٍ", 124.51, 124.93], ["رآها", 125.01, 125.32], ["البشر:", 125.35, 125.96], ["آلافُ", 126.29, 126.69], ["النجومِ", 126.72, 127.2], ["ودربُ", 127.23, 127.58], ["التبّانة،", 127.6, 128.33], ["في", 128.54, 128.64], ["وقتِ", 128.71, 128.93], ["الظهيرة.", 128.96, 129.6]]}, {"text": "لكنّ هذا الجمالَ هو بدايةُ المشكلة.", "start": 129.92, "end": 132.74, "words": [["لكنّ", 129.92, 130.32], ["هذا", 130.36, 130.54], ["الجمالَ", 130.56, 131.0], ["هو", 131.05, 131.13], ["بدايةُ", 131.22, 131.59], ["المشكلة.", 131.62, 132.74]]}, {"text": "بعد يومٍ واحد، لا يطلعُ الفجر. في الحقولِ يتوقّفُ النباتُ عن صنعِ غذائِه، فالبناءُ الضوئيُّ لا يعملُ بلا ضوء.", "start": 135.14, "end": 143.57, "words": [["بعد", 135.14, 135.41], ["يومٍ", 135.49, 135.75], ["واحد،", 135.81, 136.23], ["لا", 136.3, 136.45], ["يطلعُ", 136.51, 136.84], ["الفجر.", 136.86, 137.43], ["في", 137.74, 137.85], ["الحقولِ", 137.87, 138.45], ["يتوقّفُ", 138.47, 139.05], ["النباتُ", 139.08, 139.52], ["عن", 139.58, 139.67], ["صنعِ", 139.73, 140.02], ["غذائِه،", 140.06, 140.69], ["فالبناءُ", 140.89, 141.42], ["الضوئيُّ", 141.45, 142.17], ["لا", 142.32, 142.47], ["يعملُ", 142.53, 142.9], ["بلا", 142.96, 143.13], ["ضوء.", 143.19, 143.57]]}, {"text": "الطيورُ لا تعرفُ متى تستيقظ، والأزهارُ لا تتفتّح، والحيواناتُ الليليّةُ تخرجُ ولا تعود.", "start": 143.99, "end": 150.55, "words": [["الطيورُ", 143.99, 144.48], ["لا", 144.53, 144.62], ["تعرفُ", 144.68, 145.03], ["متى", 145.09, 145.27], ["تستيقظ،", 145.34, 146.05], ["والأزهارُ", 146.26, 146.84], ["لا", 146.89, 146.97], ["تتفتّح،", 147.03, 147.85], ["والحيواناتُ", 148.03, 148.77], ["الليليّةُ", 148.79, 149.37], ["تخرجُ", 149.44, 149.84], ["ولا", 149.87, 150.05], ["تعود.", 150.09, 150.55]]}, {"text": "الحرارةُ تنخفضُ، لكن ببطء. فالهواءُ والمحيطاتُ يحتفظان بدفءِ الشمس، مثلَ ليلٍ طويلٍ لا ينتهي.", "start": 150.93, "end": 158.26, "words": [["الحرارةُ", 150.93, 151.51], ["تنخفضُ،", 151.57, 152.27], ["لكن", 152.34, 152.63], ["ببطء.", 152.68, 153.17], ["فالهواءُ", 153.54, 154.03], ["والمحيطاتُ", 154.08, 154.72], ["يحتفظان", 154.77, 155.28], ["بدفءِ", 155.34, 155.63], ["الشمس،", 155.66, 156.35], ["مثلَ", 156.55, 156.84], ["ليلٍ", 156.9, 157.14], ["طويلٍ", 157.21, 157.54], ["لا", 157.58, 157.66], ["ينتهي.", 157.71, 158.26]]}, {"text": "والطقسُ نفسُه يبدأُ بالهدوء، فالشمسُ هي التي تحرّكُ الرياحَ وتبخّرُ ماءَ البحار لتصنعَ المطر.", "start": 158.57, "end": 165.44, "words": [["والطقسُ", 158.57, 159.02], ["نفسُه", 159.07, 159.36], ["يبدأُ", 159.43, 159.74], ["بالهدوء،", 159.79, 160.43], ["فالشمسُ", 160.71, 161.21], ["هي", 161.24, 161.38], ["التي", 161.4, 161.66], ["تحرّكُ", 161.73, 162.19], ["الرياحَ", 162.22, 162.85], ["وتبخّرُ", 163.13, 163.79], ["ماءَ", 163.84, 164.02], ["البحار", 164.04, 164.44], ["لتصنعَ", 164.48, 164.91], ["المطر.", 164.93, 165.44]]}, {"text": "والكهرباءُ ما زالت تعمل، والمدنُ مضاءة. الخطرُ الحقيقيُّ لم يبدأْ بعد. فماذا يحدثُ حين ينفدُ هذا الدفء؟", "start": 165.76, "end": 173.87, "words": [["والكهرباءُ", 165.76, 166.4], ["ما", 166.43, 166.49], ["زالت", 166.57, 166.8], ["تعمل،", 166.82, 167.32], ["والمدنُ", 167.47, 167.94], ["مضاءة.", 167.99, 168.54], ["الخطرُ", 168.86, 169.3], ["الحقيقيُّ", 169.32, 169.89], ["لم", 169.91, 170.05], ["يبدأْ", 170.12, 170.42], ["بعد.", 170.45, 170.84], ["فماذا", 171.17, 171.57], ["يحدثُ", 171.63, 172.04], ["حين", 172.11, 172.29], ["ينفدُ", 172.36, 172.71], ["هذا", 172.76, 172.92], ["الدفء؟", 172.94, 173.87]]}, {"text": "بعد أسبوع، يهبطُ متوسّطُ حرارةِ الأرض من خمسَ عشرةَ درجةً فوق الصفر إلى نحوِ ثماني عشرةَ درجةً تحت الصفر.", "start": 176.27, "end": 183.85, "words": [["بعد", 176.27, 176.55], ["أسبوع،", 176.61, 177.11], ["يهبطُ", 177.22, 177.61], ["متوسّطُ", 177.65, 178.23], ["حرارةِ", 178.29, 178.69], ["الأرض", 178.71, 179.0], ["من", 179.08, 179.14], ["خمسَ", 179.22, 179.48], ["عشرةَ", 179.53, 179.87], ["درجةً", 179.91, 180.46], ["فوق", 180.77, 181.03], ["الصفر", 181.1, 181.46], ["إلى", 181.52, 181.64], ["نحوِ", 181.71, 181.91], ["ثماني", 181.97, 182.29], ["عشرةَ", 182.33, 182.66], ["درجةً", 182.72, 183.13], ["تحت", 183.17, 183.34], ["الصفر.", 183.37, 183.85]]}, {"text": "الصحارى تتجمّدُ أوّلاً، فهواؤها الجافُّ لا يحبسُ الحرارة. والرمالُ التي كانت تحرقُ الأقدامَ يغطّيها الصقيع.", "start": 184.33, "end": 192.43, "words": [["الصحارى", 184.33, 184.81], ["تتجمّدُ", 184.84, 185.47], ["أوّلاً،", 185.53, 186.21], ["فهواؤها", 186.37, 186.97], ["الجافُّ", 186.99, 187.43], ["لا", 187.46, 187.53], ["يحبسُ", 187.58, 187.92], ["الحرارة.", 187.94, 188.53], ["والرمالُ", 188.83, 189.31], ["التي", 189.32, 189.57], ["كانت", 189.64, 189.89], ["تحرقُ", 189.91, 190.25], ["الأقدامَ", 190.27, 190.88], ["يغطّيها", 191.18, 191.78], ["الصقيع.", 191.81, 192.43]]}, {"text": "أمّا المدنُ الساحليّةُ فتبقى أدفأَ قليلاً، لأنّ البحرَ يعملُ كمدفأةٍ عملاقة.", "start": 192.79, "end": 198.92, "words": [["أمّا", 192.79, 193.04], ["المدنُ", 193.06, 193.44], ["الساحليّةُ", 193.48, 194.33], ["فتبقى", 194.59, 195.13], ["أدفأَ", 195.15, 195.5], ["قليلاً،", 195.57, 196.15], ["لأنّ", 196.38, 196.66], ["البحرَ", 196.69, 197.08], ["يعملُ", 197.12, 197.5], ["كمدفأةٍ", 197.53, 198.23], ["عملاقة.", 198.28, 198.92]]}, {"text": "بخارُ الماءِ في الجوِّ يسقطُ ثلجاً فوق العالمِ كلِّه، حتى في البلادِ التي لم ترَ الثلجَ من قبل.", "start": 199.24, "end": 206.02, "words": [["بخارُ", 199.24, 199.68], ["الماءِ", 199.7, 200.0], ["في", 200.06, 200.12], ["الجوِّ", 200.14, 200.66], ["يسقطُ", 200.9, 201.41], ["ثلجاً", 201.49, 201.84], ["فوق", 201.91, 202.13], ["العالمِ", 202.2, 202.6], ["كلِّه،", 202.66, 203.21], ["حتى", 203.47, 203.78], ["في", 203.83, 203.89], ["البلادِ", 203.93, 204.32], ["التي", 204.34, 204.59], ["لم", 204.65, 204.76], ["ترَ", 204.84, 205.0], ["الثلجَ", 205.02, 205.4], ["من", 205.45, 205.53], ["قبل.", 205.62, 206.02]]}, {"text": "تتجمّدُ الأنهارُ والبحيرات، وتنفجرُ أنابيبُ الماء، والناسُ يتجمّعون حول أيِّ مصدرٍ للحرارة.", "start": 206.45, "end": 214.49, "words": [["تتجمّدُ", 206.45, 207.12], ["الأنهارُ", 207.15, 207.69], ["والبحيرات،", 207.71, 208.61], ["وتنفجرُ", 208.81, 209.59], ["أنابيبُ", 209.65, 210.08], ["الماء،", 210.1, 210.61], ["والناسُ", 210.89, 211.38], ["يتجمّعون", 211.43, 212.4], ["حول", 212.58, 212.87], ["أيِّ", 212.95, 213.23], ["مصدرٍ", 213.26, 213.73], ["للحرارة.", 213.75, 214.49]]}, {"text": "وكلُّ ساعةٍ تمرُّ أبردُ من التي قبلَها، بلا نهارٍ يعيدُ الدفء.", "start": 214.87, "end": 221.09, "words": [["وكلُّ", 214.87, 215.37], ["ساعةٍ", 215.42, 215.9], ["تمرُّ", 215.98, 216.57], ["أبردُ", 216.65, 217.16], ["من", 217.21, 217.32], ["التي", 217.37, 217.65], ["قبلَها،", 217.77, 218.42], ["بلا", 218.86, 219.14], ["نهارٍ", 219.21, 219.69], ["يعيدُ", 219.77, 220.1], ["الدفء.", 220.12, 221.09]]}, {"text": "بعد شهر، يبدأُ سطحُ البحرِ بالتجمّد. السفنُ تعلقُ في الموانئ، والجليدُ يزحفُ من الشواطئ نحو عُرضِ البحر.", "start": 223.49, "end": 231.46, "words": [["بعد", 223.49, 223.74], ["شهر،", 223.85, 224.21], ["يبدأُ", 224.3, 224.67], ["سطحُ", 224.72, 225.0], ["البحرِ", 225.02, 225.37], ["بالتجمّد.", 225.4, 226.11], ["السفنُ", 226.49, 226.96], ["تعلقُ", 227.01, 227.43], ["في", 227.5, 227.55], ["الموانئ،", 227.59, 228.33], ["والجليدُ", 228.54, 229.05], ["يزحفُ", 229.11, 229.54], ["من", 229.58, 229.69], ["الشواطئ", 229.73, 230.27], ["نحو", 230.33, 230.58], ["عُرضِ", 230.66, 230.89], ["البحر.", 230.93, 231.46]]}, {"text": "معظمُ النباتاتِ الصغيرةِ ماتت. والحيواناتُ التي تأكلُ العشبَ تتبعُها، ثمّ الحيواناتُ المفترسة. السلسلةُ الغذائيّةُ تنهارُ حلقةً بعد حلقة.", "start": 231.85, "end": 242.02, "words": [["معظمُ", 231.85, 232.19], ["النباتاتِ", 232.22, 232.79], ["الصغيرةِ", 232.81, 233.38], ["ماتت.", 233.45, 233.94], ["والحيواناتُ", 234.22, 234.9], ["التي", 234.93, 235.18], ["تأكلُ", 235.25, 235.6], ["العشبَ", 235.61, 236.12], ["تتبعُها،", 236.21, 237.04], ["ثمّ", 237.25, 237.49], ["الحيواناتُ", 237.51, 238.08], ["المفترسة.", 238.1, 238.87], ["السلسلةُ", 239.2, 239.79], ["الغذائيّةُ", 239.81, 240.43], ["تنهارُ", 240.47, 240.82], ["حلقةً", 240.88, 241.29], ["بعد", 241.32, 241.48], ["حلقة.", 241.56, 242.02]]}, {"text": "لكنّ الأشجارَ الكبيرةَ تفاجئُنا: فهي تخزّنُ السكّرَ في جذوعِها، وبعضُها قد يصمدُ سنوات.", "start": 242.46, "end": 249.38, "words": [["لكنّ", 242.46, 242.81], ["الأشجارَ", 242.84, 243.32], ["الكبيرةَ", 243.35, 243.84], ["تفاجئُنا:", 243.87, 244.69], ["فهي", 245.01, 245.27], ["تخزّنُ", 245.35, 245.92], ["السكّرَ", 245.94, 246.42], ["في", 246.46, 246.53], ["جذوعِها،", 246.61, 247.37], ["وبعضُها", 247.58, 248.11], ["قد", 248.19, 248.34], ["يصمدُ", 248.4, 248.75], ["سنوات.", 248.81, 249.38]]}, {"text": "وفي البحر تموتُ الطحالبُ المجهريّةُ التي تصنعُ نصفَ أكسجينِ الأرض. لكن لا تقلق: في الهواءِ من الأكسجين ما يكفينا آلافَ السنين.", "start": 249.76, "end": 259.78, "words": [["وفي", 249.76, 249.98], ["البحر", 250.02, 250.38], ["تموتُ", 250.46, 250.83], ["الطحالبُ", 250.85, 251.49], ["المجهريّةُ", 251.51, 252.36], ["التي", 252.69, 253.05], ["تصنعُ", 253.13, 253.51], ["نصفَ", 253.55, 253.84], ["أكسجينِ", 253.87, 254.4], ["الأرض.", 254.44, 254.94], ["لكن", 255.26, 255.52], ["لا", 255.54, 255.61], ["تقلق:", 255.67, 256.2], ["في", 256.41, 256.52], ["الهواءِ", 256.55, 256.97], ["من", 257.01, 257.1], ["الأكسجين", 257.14, 257.86], ["ما", 258.04, 258.18], ["يكفينا", 258.24, 258.7], ["آلافَ", 258.76, 259.13], ["السنين.", 259.15, 259.78]]}, {"text": "وطعامُ البشر؟ مخزونُ الحبوبِ في العالم يكفي أشهراً قليلةً فقط.", "start": 260.11, "end": 265.71, "words": [["وطعامُ", 260.11, 260.64], ["البشر؟", 260.66, 261.3], ["مخزونُ", 261.68, 262.18], ["الحبوبِ", 262.21, 262.74], ["في", 262.8, 262.86], ["العالم", 262.89, 263.38], ["يكفي", 263.76, 264.11], ["أشهراً", 264.19, 264.62], ["قليلةً", 264.7, 265.18], ["فقط.", 265.23, 265.71]]}, {"text": "والأسوأُ لم يأتِ بعد.", "start": 266.04, "end": 268.07, "words": [["والأسوأُ", 266.04, 266.69], ["لم", 266.73, 266.85], ["يأتِ", 266.92, 267.13], ["بعد.", 267.18, 268.07]]}, {"text": "بعد سنة، تصلُ الحرارةُ إلى نحوِ ثلاثٍ وسبعين درجةً تحت الصفر. صار العالمُ كلُّه مثلَ شتاءِ القطبِ الجنوبيّ.", "start": 270.47, "end": 278.61, "words": [["بعد", 270.47, 270.71], ["سنة،", 270.83, 271.27], ["تصلُ", 271.44, 271.82], ["الحرارةُ", 271.84, 272.42], ["إلى", 272.49, 272.62], ["نحوِ", 272.68, 272.93], ["ثلاثٍ", 273.0, 273.37], ["وسبعين", 273.42, 273.86], ["درجةً", 273.94, 274.41], ["تحت", 274.45, 274.64], ["الصفر.", 274.68, 275.18], ["صار", 275.62, 275.84], ["العالمُ", 275.89, 276.3], ["كلُّه", 276.36, 276.68], ["مثلَ", 276.8, 277.05], ["شتاءِ", 277.12, 277.48], ["القطبِ", 277.51, 277.85], ["الجنوبيّ.", 277.88, 278.61]]}, {"text": "ولا يستطيعُ إنسانٌ أن يقفَ في الخارج دقائقَ دون ملابسَ خاصّة.", "start": 278.93, "end": 283.17, "words": [["ولا", 278.93, 279.17], ["يستطيعُ", 279.22, 279.71], ["إنسانٌ", 279.76, 280.2], ["أن", 280.28, 280.38], ["يقفَ", 280.45, 280.79], ["في", 280.85, 280.91], ["الخارج", 280.94, 281.3], ["دقائقَ", 281.37, 281.87], ["دون", 281.92, 282.08], ["ملابسَ", 282.17, 282.58], ["خاصّة.", 282.66, 283.17]]}, {"text": "المحيطاتُ يغطّيها جليدٌ سميك. لكن هنا مفاجأة: الجليدُ يعزلُ الماءَ تحتَه كالغطاء، فيبقى سائلاً في الأعماق.", "start": 283.55, "end": 291.69, "words": [["المحيطاتُ", 283.55, 284.19], ["يغطّيها", 284.25, 284.78], ["جليدٌ", 284.88, 285.23], ["سميك.", 285.3, 285.79], ["لكن", 286.12, 286.42], ["هنا", 286.47, 286.65], ["مفاجأة:", 286.72, 287.47], ["الجليدُ", 287.74, 288.24], ["يعزلُ", 288.3, 288.73], ["الماءَ", 288.75, 289.06], ["تحتَه", 289.1, 289.39], ["كالغطاء،", 289.5, 290.09], ["فيبقى", 290.29, 290.67], ["سائلاً", 290.73, 291.07], ["في", 291.11, 291.16], ["الأعماق.", 291.19, 291.69]]}, {"text": "فأين يعيشُ البشر؟ تحت الأرض. في ملاجئَ عميقة، قربَ حرارةِ باطنِ الأرض، كما تدفّئُ آيسلندا بيوتَها اليوم من ينابيعِها الحارّة.", "start": 292.11, "end": 301.67, "words": [["فأين", 292.11, 292.4], ["يعيشُ", 292.47, 292.74], ["البشر؟", 292.76, 293.27], ["تحت", 293.57, 293.79], ["الأرض.", 293.84, 294.29], ["في", 294.61, 294.71], ["ملاجئَ", 294.78, 295.23], ["عميقة،", 295.27, 295.92], ["قربَ", 296.08, 296.36], ["حرارةِ", 296.42, 296.82], ["باطنِ", 296.89, 297.18], ["الأرض،", 297.21, 297.69], ["كما", 297.87, 298.09], ["تدفّئُ", 298.15, 298.62], ["آيسلندا", 298.68, 299.25], ["بيوتَها", 299.52, 299.97], ["اليوم", 299.99, 300.3], ["من", 300.4, 300.55], ["ينابيعِها", 300.6, 301.12], ["الحارّة.", 301.15, 301.67]]}, {"text": "مفاعلاتٌ نوويّةٌ تعطي الكهرباء، ومصابيحُ تزرعُ الخضارَ بلا شمس. وغوّاصاتٌ تختبئُ في الماءِ الدافئ تحت الجليد.", "start": 302.08, "end": 310.57, "words": [["مفاعلاتٌ", 302.08, 302.7], ["نوويّةٌ", 302.74, 303.33], ["تعطي", 303.38, 303.6], ["الكهرباء،", 303.63, 304.37], ["ومصابيحُ", 304.57, 305.3], ["تزرعُ", 305.37, 305.75], ["الخضارَ", 305.78, 306.26], ["بلا", 306.32, 306.51], ["شمس.", 306.58, 307.09], ["وغوّاصاتٌ", 307.37, 308.26], ["تختبئُ", 308.33, 308.83], ["في", 308.89, 308.96], ["الماءِ", 308.99, 309.28], ["الدافئ", 309.3, 309.69], ["تحت", 309.75, 309.95], ["الجليد.", 309.99, 310.57]]}, {"text": "لكنّ هذه الملاجئَ لا تتّسعُ إلّا لعددٍ قليلٍ من البشر.", "start": 310.9, "end": 315.67, "words": [["لكنّ", 310.9, 311.26], ["هذه", 311.31, 311.59], ["الملاجئَ", 311.63, 312.32], ["لا", 312.57, 312.74], ["تتّسعُ", 312.8, 313.43], ["إلّا", 313.52, 313.8], ["لعددٍ", 313.88, 314.45], ["قليلٍ", 314.56, 314.91], ["من", 314.94, 315.05], ["البشر.", 315.11, 315.67]]}, {"text": "حياةٌ صعبة، لكنّها ممكنة. إلى متى؟ فالشيءُ الأغربُ لم يحدثْ بعد.", "start": 315.99, "end": 322.34, "words": [["حياةٌ", 315.99, 316.43], ["صعبة،", 316.51, 317.03], ["لكنّها", 317.2, 317.66], ["ممكنة.", 317.71, 318.3], ["إلى", 318.58, 318.79], ["متى؟", 318.87, 319.32], ["فالشيءُ", 319.6, 320.14], ["الأغربُ", 320.17, 320.82], ["لم", 320.95, 321.14], ["يحدثْ", 321.2, 321.59], ["بعد.", 321.61, 322.34]]}, {"text": "بعد مئةِ سنة، لم يبقَ على السطح إنسانٌ واحد. البردُ هناك تجاوزَ أبردَ ما سجّلَه البشرُ على الأرض، وما زال يهبط.", "start": 324.74, "end": 333.47, "words": [["بعد", 324.74, 324.98], ["مئةِ", 325.03, 325.28], ["سنة،", 325.36, 325.77], ["لم", 325.93, 326.09], ["يبقَ", 326.17, 326.4], ["على", 326.46, 326.58], ["السطح", 326.61, 326.98], ["إنسانٌ", 327.1, 327.51], ["واحد.", 327.58, 328.01], ["البردُ", 328.49, 328.92], ["هناك", 328.97, 329.34], ["تجاوزَ", 329.42, 329.99], ["أبردَ", 330.04, 330.46], ["ما", 330.5, 330.57], ["سجّلَه", 330.65, 331.04], ["البشرُ", 331.07, 331.47], ["على", 331.51, 331.65], ["الأرض،", 331.67, 332.19], ["وما", 332.42, 332.66], ["زال", 332.75, 332.92], ["يهبط.", 333.01, 333.47]]}, {"text": "لكن تحت الأرض وُلد جيلٌ كاملٌ لم يرَ الشمسَ قطّ. يعرفونها من الصورِ والحكايات، كما نعرفُ نحن الديناصورات.", "start": 333.78, "end": 341.78, "words": [["لكن", 333.78, 334.05], ["تحت", 334.1, 334.3], ["الأرض", 334.34, 334.69], ["وُلد", 334.8, 335.06], ["جيلٌ", 335.19, 335.55], ["كاملٌ", 335.63, 336.09], ["لم", 336.2, 336.35], ["يرَ", 336.43, 336.56], ["الشمسَ", 336.59, 336.96], ["قطّ.", 337.02, 337.42], ["يعرفونها", 337.84, 338.48], ["من", 338.54, 338.64], ["الصورِ", 338.7, 339.04], ["والحكايات،", 339.07, 339.89], ["كما", 340.14, 340.35], ["نعرفُ", 340.41, 340.73], ["نحن", 340.77, 340.99], ["الديناصورات.", 341.01, 341.78]]}, {"text": "مدنُهم أنفاقٌ وقاعات، تدفّئُها حرارةُ باطنِ الأرض وتنيرُها المفاعلات. وتحت المصابيح تنمو حقولٌ صغيرةٌ من القمحِ والخضار.", "start": 342.09, "end": 351.88, "words": [["مدنُهم", 342.09, 342.6], ["أنفاقٌ", 342.67, 343.09], ["وقاعات،", 343.13, 343.85], ["تدفّئُها", 344.06, 344.77], ["حرارةُ", 344.84, 345.33], ["باطنِ", 345.39, 345.7], ["الأرض", 345.73, 346.06], ["وتنيرُها", 346.37, 347.03], ["المفاعلات.", 347.06, 348.01], ["وتحت", 348.32, 348.68], ["المصابيح", 348.73, 349.29], ["تنمو", 349.36, 349.65], ["حقولٌ", 349.7, 350.09], ["صغيرةٌ", 350.17, 350.68], ["من", 350.71, 350.82], ["القمحِ", 350.87, 351.25], ["والخضار.", 351.27, 351.88]]}, {"text": "كلُّ قطرةِ ماءٍ يُعادُ استعمالُها، وكلُّ نفَسٍ من الهواء محسوب.", "start": 352.19, "end": 356.78, "words": [["كلُّ", 352.19, 352.44], ["قطرةِ", 352.48, 352.84], ["ماءٍ", 352.9, 353.19], ["يُعادُ", 353.23, 353.52], ["استعمالُها،", 353.55, 354.42], ["وكلُّ", 354.57, 355.0], ["نفَسٍ", 355.03, 355.46], ["من", 355.53, 355.66], ["الهواء", 355.72, 356.13], ["محسوب.", 356.19, 356.78]]}, {"text": "ومَن يصعدُ إلى السطح يلبسُ بدلةً ثقيلة، ويرى مدنَ أجدادِه مدفونةً تحت الثلج، تحت سماءٍ لا تعرفُ النهار.", "start": 357.05, "end": 365.16, "words": [["ومَن", 357.05, 357.3], ["يصعدُ", 357.36, 357.75], ["إلى", 357.77, 357.88], ["السطح", 357.9, 358.31], ["يلبسُ", 358.39, 358.75], ["بدلةً", 358.82, 359.22], ["ثقيلة،", 359.27, 359.89], ["ويرى", 360.17, 360.56], ["مدنَ", 360.61, 360.93], ["أجدادِه", 360.98, 361.48], ["مدفونةً", 361.54, 362.13], ["تحت", 362.17, 362.39], ["الثلج،", 362.44, 363.0], ["تحت", 363.28, 363.51], ["سماءٍ", 363.62, 364.02], ["لا", 364.08, 364.15], ["تعرفُ", 364.21, 364.55], ["النهار.", 364.58, 365.16]]}, {"text": "لكنّ الأغربَ ما زال في الطريق.", "start": 365.48, "end": 367.93, "words": [["لكنّ", 365.48, 365.87], ["الأغربَ", 365.9, 366.4], ["ما", 366.46, 366.52], ["زال", 366.6, 366.76], ["في", 366.84, 366.9], ["الطريق.", 366.92, 367.93]]}, {"text": "بعد ألفِ سنة، تغيّرَ وجهُ الأرض تماماً. فبعد قرونٍ من البرد حدث ما لا يُصدَّق: الهواءُ نفسُه بدأ يتجمّد.", "start": 370.33, "end": 378.87, "words": [["بعد", 370.33, 370.61], ["ألفِ", 370.67, 370.9], ["سنة،", 370.97, 371.48], ["تغيّرَ", 371.64, 372.14], ["وجهُ", 372.19, 372.45], ["الأرض", 372.48, 372.78], ["تماماً.", 372.89, 373.47], ["فبعد", 373.78, 374.09], ["قرونٍ", 374.2, 374.54], ["من", 374.58, 374.71], ["البرد", 374.77, 375.06], ["حدث", 375.13, 375.41], ["ما", 375.51, 375.58], ["لا", 375.64, 375.71], ["يُصدَّق:", 375.74, 376.4], ["الهواءُ", 376.72, 377.18], ["نفسُه", 377.23, 377.68], ["بدأ", 377.82, 378.12], ["يتجمّد.", 378.17, 378.87]]}, {"text": "حين تقتربُ الحرارةُ من مئتَي درجةٍ تحت الصفر، يتحوّلُ الأكسجينُ والنيتروجينُ إلى سائل، ثمّ يسقطان ثلجاً أبيضَ مائلاً إلى الزرقة.", "start": 379.18, "end": 388.57, "words": [["حين", 379.18, 379.45], ["تقتربُ", 379.53, 380.03], ["الحرارةُ", 380.05, 380.6], ["من", 380.65, 380.74], ["مئتَي", 380.78, 381.12], ["درجةٍ", 381.19, 381.64], ["تحت", 381.7, 381.92], ["الصفر،", 381.98, 382.59], ["يتحوّلُ", 382.86, 383.49], ["الأكسجينُ", 383.52, 384.14], ["والنيتروجينُ", 384.16, 384.83], ["إلى", 384.88, 385.01], ["سائل،", 385.09, 385.68], ["ثمّ", 385.89, 386.14], ["يسقطان", 386.19, 386.67], ["ثلجاً", 386.76, 387.1], ["أبيضَ", 387.13, 387.49], ["مائلاً", 387.55, 387.85], ["إلى", 387.89, 388.01], ["الزرقة.", 388.04, 388.57]]}, {"text": "وقرناً بعد قرن، يستقرُّ الغلافُ الجوّيُّ على الأرض. ولو سقط كلُّه، لصنع طبقةً سُمكُها نحوُ عشرةِ أمتار.", "start": 388.99, "end": 397.07, "words": [["وقرناً", 388.99, 389.5], ["بعد", 389.56, 389.73], ["قرن،", 389.85, 390.25], ["يستقرُّ", 390.3, 390.87], ["الغلافُ", 390.89, 391.42], ["الجوّيُّ", 391.43, 391.94], ["على", 391.96, 392.08], ["الأرض.", 392.11, 392.59], ["ولو", 392.9, 393.13], ["سقط", 393.19, 393.47], ["كلُّه،", 393.59, 394.09], ["لصنع", 394.25, 394.68], ["طبقةً", 394.79, 395.28], ["سُمكُها", 395.35, 395.78], ["نحوُ", 395.86, 396.08], ["عشرةِ", 396.14, 396.5], ["أمتار.", 396.55, 397.07]]}, {"text": "وكلّما رقَّ الهواء، خفتَ الصوتُ على السطح، وسكنتِ الرياح، واختفى السحاب. السماءُ سوداء، ونجومُها ثابتةٌ لا تتلألأ.", "start": 397.38, "end": 406.33, "words": [["وكلّما", 397.38, 397.85], ["رقَّ", 397.91, 398.13], ["الهواء،", 398.15, 398.75], ["خفتَ", 398.95, 399.24], ["الصوتُ", 399.26, 399.59], ["على", 399.65, 399.75], ["السطح،", 399.77, 400.34], ["وسكنتِ", 400.51, 401.11], ["الرياح،", 401.13, 401.68], ["واختفى", 401.85, 402.24], ["السحاب.", 402.26, 402.83], ["السماءُ", 403.14, 403.54], ["سوداء،", 403.59, 404.14], ["ونجومُها", 404.31, 404.93], ["ثابتةٌ", 405.01, 405.39], ["لا", 405.51, 405.59], ["تتلألأ.", 405.65, 406.33]]}, {"text": "وتصلُ إلى السطح أشعّةٌ كونيّةٌ كان الهواءُ يحمينا منها.", "start": 406.71, "end": 410.75, "words": [["وتصلُ", 406.71, 407.18], ["إلى", 407.23, 407.34], ["السطح", 407.38, 407.75], ["أشعّةٌ", 407.83, 408.4], ["كونيّةٌ", 408.48, 409.1], ["كان", 409.18, 409.37], ["الهواءُ", 409.4, 409.82], ["يحمينا", 409.85, 410.24], ["منها.", 410.31, 410.75]]}, {"text": "أمّا جليدُ المحيط فصار بسُمكِ مئاتِ الأمتار. لكن في القاع، على عمقِ آلافِ الأمتار، ما زال هناك دفء.", "start": 411.12, "end": 419.22, "words": [["أمّا", 411.12, 411.39], ["جليدُ", 411.45, 411.76], ["المحيط", 411.78, 412.24], ["فصار", 412.28, 412.66], ["بسُمكِ", 412.74, 413.35], ["مئاتِ", 413.44, 413.82], ["الأمتار.", 413.86, 414.49], ["لكن", 414.93, 415.18], ["في", 415.24, 415.29], ["القاع،", 415.32, 415.92], ["على", 416.1, 416.27], ["عمقِ", 416.34, 416.62], ["آلافِ", 416.68, 417.03], ["الأمتار،", 417.06, 417.78], ["ما", 417.96, 418.06], ["زال", 418.14, 418.34], ["هناك", 418.4, 418.68], ["دفء.", 418.79, 419.22]]}, {"text": "إنّها الينابيعُ الحارّةُ في قاعِ المحيط: ماءٌ يخرجُ من باطنِ الأرض، وحرارتُه قد تصلُ إلى أربعِمئةِ درجة.", "start": 419.55, "end": 427.42, "words": [["إنّها", 419.55, 419.91], ["الينابيعُ", 419.93, 420.57], ["الحارّةُ", 420.59, 421.11], ["في", 421.16, 421.24], ["قاعِ", 421.32, 421.57], ["المحيط:", 421.59, 422.23], ["ماءٌ", 422.61, 422.89], ["يخرجُ", 422.98, 423.37], ["من", 423.41, 423.51], ["باطنِ", 423.56, 423.87], ["الأرض،", 423.9, 424.46], ["وحرارتُه", 424.63, 425.39], ["قد", 425.48, 425.61], ["تصلُ", 425.65, 426.01], ["إلى", 426.06, 426.19], ["أربعِمئةِ", 426.23, 426.87], ["درجة.", 426.92, 427.42]]}, {"text": "وحولَها عالَمٌ كاملٌ لم يرَ الشمسَ يوماً: بكتيريا تصنعُ غذاءَها من الكيمياء لا من الضوء، وديدانٌ عملاقةٌ تعيشُ عليها.", "start": 427.7, "end": 436.71, "words": [["وحولَها", 427.7, 428.23], ["عالَمٌ", 428.3, 428.68], ["كاملٌ", 428.77, 429.25], ["لم", 429.58, 429.75], ["يرَ", 429.81, 429.96], ["الشمسَ", 429.98, 430.34], ["يوماً:", 430.39, 430.82], ["بكتيريا", 431.15, 431.66], ["تصنعُ", 431.7, 432.1], ["غذاءَها", 432.13, 432.6], ["من", 432.65, 432.75], ["الكيمياء", 432.79, 433.25], ["لا", 433.33, 433.41], ["من", 433.46, 433.56], ["الضوء،", 433.61, 434.18], ["وديدانٌ", 434.45, 435.1], ["عملاقةٌ", 435.19, 435.81], ["تعيشُ", 435.87, 436.2], ["عليها.", 436.24, 436.71]]}, {"text": "اكتشفها العلماءُ عامَ ألفٍ وتسعِمئةٍ وسبعةٍ وسبعين، وفوجئوا بحياةٍ لا تحتاجُ إلى ضوءِ الشمس.", "start": 437.03, "end": 444.55, "words": [["اكتشفها", 437.03, 437.71], ["العلماءُ", 437.73, 438.27], ["عامَ", 438.39, 438.62], ["ألفٍ", 438.67, 439.01], ["وتسعِمئةٍ", 439.06, 439.79], ["وسبعةٍ", 439.86, 440.38], ["وسبعين،", 440.43, 441.2], ["وفوجئوا", 441.48, 442.11], ["بحياةٍ", 442.14, 442.7], ["لا", 442.77, 442.85], ["تحتاجُ", 442.91, 443.38], ["إلى", 443.43, 443.56], ["ضوءِ", 443.64, 443.87], ["الشمس.", 443.89, 444.55]]}, {"text": "هذه الكائناتُ لا تعرفُ أنّ الشمسَ اختفت. فهل تصمدُ إلى النهاية؟", "start": 444.94, "end": 450.16, "words": [["هذه", 444.94, 445.25], ["الكائناتُ", 445.3, 446.01], ["لا", 446.06, 446.15], ["تعرفُ", 446.2, 446.57], ["أنّ", 446.62, 446.78], ["الشمسَ", 446.81, 447.16], ["اختفت.", 447.18, 447.74], ["فهل", 448.06, 448.34], ["تصمدُ", 448.4, 448.87], ["إلى", 448.91, 449.04], ["النهاية؟", 449.07, 450.16]]}, {"text": "بعد مليونِ سنة، تجمّدتِ المحيطاتُ حتى أعماقِها تقريباً، واقتربتْ حرارةُ السطح من مئتين وأربعين درجةً تحت الصفر.", "start": 452.56, "end": 461.2, "words": [["بعد", 452.56, 452.81], ["مليونِ", 452.89, 453.21], ["سنة،", 453.28, 453.64], ["تجمّدتِ", 453.82, 454.35], ["المحيطاتُ", 454.39, 454.95], ["حتى", 455.02, 455.27], ["أعماقِها", 455.3, 455.85], ["تقريباً،", 455.91, 456.53], ["واقتربتْ", 456.79, 457.46], ["حرارةُ", 457.5, 457.95], ["السطح", 457.97, 458.33], ["من", 458.45, 458.54], ["مئتين", 458.59, 459.1], ["وأربعين", 459.18, 459.68], ["درجةً", 459.75, 460.31], ["تحت", 460.38, 460.61], ["الصفر.", 460.65, 461.2]]}, {"text": "والأرضُ ابتعدتْ عن مكانِ الشمسِ القديم نحوَ مئةِ سنةٍ ضوئيّة. كوكبٌ مظلمٌ يسبحُ وحيداً بين النجوم.", "start": 461.56, "end": 468.98, "words": [["والأرضُ", 461.56, 461.95], ["ابتعدتْ", 461.98, 462.5], ["عن", 462.52, 462.63], ["مكانِ", 462.66, 462.98], ["الشمسِ", 463.0, 463.34], ["القديم", 463.36, 463.89], ["نحوَ", 464.2, 464.5], ["مئةِ", 464.54, 464.83], ["سنةٍ", 464.89, 465.24], ["ضوئيّة.", 465.3, 465.83], ["كوكبٌ", 466.19, 466.7], ["مظلمٌ", 466.75, 467.19], ["يسبحُ", 467.31, 467.73], ["وحيداً", 467.76, 468.16], ["بين", 468.2, 468.38], ["النجوم.", 468.41, 468.98]]}, {"text": "ولو مرَّ بها مسافرٌ من حضارةٍ أخرى، لرأى كرةً من الجليد، ولن يتخيّلَ أنّ تحتها مدناً ومحيطاتٍ وحياة.", "start": 469.34, "end": 477.27, "words": [["ولو", 469.34, 469.57], ["مرَّ", 469.62, 469.83], ["بها", 469.87, 470.05], ["مسافرٌ", 470.11, 470.64], ["من", 470.7, 470.79], ["حضارةٍ", 470.84, 471.27], ["أخرى،", 471.3, 471.79], ["لرأى", 471.99, 472.31], ["كرةً", 472.38, 472.76], ["من", 472.8, 472.9], ["الجليد،", 472.95, 473.54], ["ولن", 473.7, 473.97], ["يتخيّلَ", 474.03, 474.65], ["أنّ", 474.7, 474.85], ["تحتها", 474.91, 475.33], ["مدناً", 475.4, 475.85], ["ومحيطاتٍ", 476.02, 476.72], ["وحياة.", 476.78, 477.27]]}, {"text": "وليست وحدَها: يقدّرُ العلماءُ أنّ في مجرّتِنا ملياراتِ الكواكبِ الشاردةِ التي لا شمسَ لها.", "start": 477.52, "end": 484.36, "words": [["وليست", 477.52, 477.92], ["وحدَها:", 477.98, 478.49], ["يقدّرُ", 478.79, 479.36], ["العلماءُ", 479.38, 479.88], ["أنّ", 479.93, 480.07], ["في", 480.13, 480.18], ["مجرّتِنا", 480.26, 480.94], ["ملياراتِ", 481.19, 481.75], ["الكواكبِ", 481.77, 482.3], ["الشاردةِ", 482.31, 483.0], ["التي", 483.22, 483.54], ["لا", 483.58, 483.64], ["شمسَ", 483.7, 483.96], ["لها.", 483.99, 484.36]]}, {"text": "وهنا المفاجأةُ التي وعدتُك بها: الحياةُ لم تنتهِ.", "start": 484.66, "end": 488.47, "words": [["وهنا", 484.66, 484.98], ["المفاجأةُ", 485.0, 485.72], ["التي", 485.76, 486.02], ["وعدتُك", 486.09, 486.41], ["بها:", 486.52, 486.89], ["الحياةُ", 487.25, 487.69], ["لم", 487.75, 487.85], ["تنتهِ.", 487.9, 488.47]]}, {"text": "في أعماقِ الصخور، وحولَ الينابيعِ الحارّة، ما زالت كائناتٌ مجهريّةٌ تعيش، تتغذّى على حرارةِ باطنِ الأرض. وهذه الحرارةُ تكفي ملياراتِ السنين.", "start": 488.84, "end": 500.19, "words": [["في", 488.84, 488.97], ["أعماقِ", 489.03, 489.41], ["الصخور،", 489.44, 490.11], ["وحولَ", 490.16, 490.54], ["الينابيعِ", 490.56, 491.03], ["الحارّة،", 491.05, 491.69], ["ما", 491.92, 492.01], ["زالت", 492.13, 492.37], ["كائناتٌ", 492.44, 492.93], ["مجهريّةٌ", 492.97, 493.6], ["تعيش،", 493.67, 494.36], ["تتغذّى", 494.56, 495.31], ["على", 495.43, 495.65], ["حرارةِ", 495.73, 496.13], ["باطنِ", 496.19, 496.48], ["الأرض.", 496.51, 496.96], ["وهذه", 497.33, 497.73], ["الحرارةُ", 497.76, 498.49], ["تكفي", 498.67, 498.99], ["ملياراتِ", 499.07, 499.61], ["السنين.", 499.63, 500.19]]}, {"text": "الشمسُ أعطتْنا الضوء، لكنّ الأرضَ تحملُ ناراً في قلبِها.", "start": 500.56, "end": 504.9, "words": [["الشمسُ", 500.56, 501.01], ["أعطتْنا", 501.07, 501.56], ["الضوء،", 501.58, 502.13], ["لكنّ", 502.32, 502.64], ["الأرضَ", 502.66, 503.02], ["تحملُ", 503.07, 503.5], ["ناراً", 503.57, 503.84], ["في", 503.89, 503.95], ["قلبِها.", 504.06, 504.9]]}, {"text": "والخبرُ الجيّد: الشمسُ لن تختفي. أمامَها نحوُ خمسةِ مليارات سنة.", "start": 507.3, "end": 513.14, "words": [["والخبرُ", 507.3, 507.88], ["الجيّد:", 507.9, 508.61], ["الشمسُ", 508.86, 509.34], ["لن", 509.38, 509.48], ["تختفي.", 509.54, 510.2], ["أمامَها", 510.41, 510.95], ["نحوُ", 511.03, 511.41], ["خمسةِ", 511.5, 512.06], ["مليارات", 512.13, 512.63], ["سنة.", 512.75, 513.14]]}, {"text": "لو اختفتِ الشمسُ فعلاً، أين تختبئ: في ملجأٍ تحت الأرض، أم في غوّاصةٍ تحت الجليد؟", "start": 513.58, "end": 520.62, "words": [["لو", 513.58, 513.79], ["اختفتِ", 513.83, 514.31], ["الشمسُ", 514.34, 514.72], ["فعلاً،", 514.79, 515.42], ["أين", 515.59, 515.87], ["تختبئ:", 515.98, 516.66], ["في", 516.87, 517.03], ["ملجأٍ", 517.15, 517.63], ["تحت", 517.71, 517.95], ["الأرض،", 518.0, 518.56], ["أم", 518.74, 518.88], ["في", 518.93, 519.0], ["غوّاصةٍ", 519.12, 519.73], ["تحت", 519.8, 519.99], ["الجليد؟", 520.04, 520.62]]}, {"text": "اكتبْ جوابَك في التعليقات، واشتركْ حتى لا يفوتَك السؤالُ القادم.", "start": 520.86, "end": 525.92, "words": [["اكتبْ", 520.86, 521.29], ["جوابَك", 521.33, 521.77], ["في", 521.88, 521.95], ["التعليقات،", 521.98, 522.86], ["واشتركْ", 523.01, 523.6], ["حتى", 523.65, 524.0], ["لا", 524.08, 524.16], ["يفوتَك", 524.23, 524.66], ["السؤالُ", 524.73, 525.09], ["القادم.", 525.11, 525.92]]}]