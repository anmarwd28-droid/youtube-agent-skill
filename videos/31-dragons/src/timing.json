[{"text": "ماذا لو كانت التنانينُ موجودةً فعلاً؟", "start": 0.0, "end": 2.3, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.43], ["كانت", 0.49, 0.73], ["التنانينُ", 0.79, 1.26], ["موجودةً", 1.31, 1.81], ["فعلاً؟", 1.86, 2.3]]}, {"text": "أوّلاً، لن تكونَ عملاقة: أكبرُ حيوانٍ طارَ في التاريخ كان جناحاه بعرضِ أحدَ عشرَ متراً، ووزنُه ربعُ طنٍّ فقط.", "start": 2.65, "end": 11.31, "words": [["أوّلاً،", 2.65, 3.2], ["لن", 3.34, 3.51], ["تكونَ", 3.56, 3.92], ["عملاقة:", 3.97, 4.57], ["أكبرُ", 4.88, 5.27], ["حيوانٍ", 5.34, 5.88], ["طارَ", 5.94, 6.15], ["في", 6.19, 6.27], ["التاريخ", 6.29, 6.75], ["كان", 6.8, 6.99], ["جناحاه", 7.07, 7.54], ["بعرضِ", 7.64, 8.01], ["أحدَ", 8.05, 8.36], ["عشرَ", 8.41, 8.71], ["متراً،", 8.75, 9.32], ["ووزنُه", 9.58, 10.14], ["ربعُ", 10.24, 10.47], ["طنٍّ", 10.54, 10.82], ["فقط.", 10.86, 11.31]]}, {"text": "ولن يملكَ أربعَ أرجلٍ وجناحين: كلُّ الفقاريّاتِ لها أربعةُ أطرافٍ فقط، فجناحاه هما ذراعاه.", "start": 11.61, "end": 18.84, "words": [["ولن", 11.61, 11.9], ["يملكَ", 11.96, 12.31], ["أربعَ", 12.33, 12.67], ["أرجلٍ", 12.69, 13.08], ["وجناحين:", 13.13, 13.89], ["كلُّ", 14.18, 14.44], ["الفقاريّاتِ", 14.47, 15.19], ["لها", 15.21, 15.39], ["أربعةُ", 15.41, 15.87], ["أطرافٍ", 15.89, 16.31], ["فقط،", 16.38, 16.89], ["فجناحاه", 17.05, 17.75], ["هما", 17.89, 18.11], ["ذراعاه.", 18.22, 18.84]]}, {"text": "أمّا النار؟ ممكنة! الأبقارُ تُخرجُ غازَ الميثانِ كلَّ يوم، وتنّينٌ يخزّنُه يحتاجُ شرارةً فقط.", "start": 19.13, "end": 26.41, "words": [["أمّا", 19.13, 19.42], ["النار؟", 19.45, 19.98], ["ممكنة!", 20.27, 20.9], ["الأبقارُ", 21.26, 21.71], ["تُخرجُ", 21.76, 22.11], ["غازَ", 22.16, 22.36], ["الميثانِ", 22.37, 22.8], ["كلَّ", 22.85, 23.04], ["يوم،", 23.07, 23.42], ["وتنّينٌ", 23.63, 24.18], ["يخزّنُه", 24.24, 24.85], ["يحتاجُ", 25.12, 25.53], ["شرارةً", 25.58, 26.0], ["فقط.", 26.04, 26.41]]}, {"text": "وتنّينٌ بوزنِ طنٍّ يحتاجُ لحماً بحجمِ خروفٍ كلَّ يوم.", "start": 26.69, "end": 30.44, "words": [["وتنّينٌ", 26.69, 27.26], ["بوزنِ", 27.33, 27.63], ["طنٍّ", 27.7, 27.97], ["يحتاجُ", 27.98, 28.36], ["لحماً", 28.4, 28.79], ["بحجمِ", 29.02, 29.41], ["خروفٍ", 29.47, 29.79], ["كلَّ", 29.85, 30.06], ["يوم.", 30.09, 30.44]]}, {"text": "وستُغلقُ المطارات، وتُبنى المدنُ بأسقفٍ لا تحترق.", "start": 30.72, "end": 34.33, "words": [["وستُغلقُ", 30.72, 31.37], ["المطارات،", 31.39, 32.08], ["وتُبنى", 32.27, 32.66], ["المدنُ", 32.68, 33.09], ["بأسقفٍ", 33.16, 33.63], ["لا", 33.68, 33.75], ["تحترق.", 33.8, 34.33]]}, {"text": "والغريب؟ التنّينُ موجودٌ فعلاً: تنّينُ كومودو، طولُه ثلاثةُ أمتار، وعضّتُه سامّة.", "start": 34.61, "end": 40.72, "words": [["والغريب؟", 34.61, 35.25], ["التنّينُ", 35.46, 35.91], ["موجودٌ", 35.96, 36.28], ["فعلاً:", 36.35, 36.73], ["تنّينُ", 36.94, 37.34], ["كومودو،", 37.38, 37.95], ["طولُه", 38.1, 38.36], ["ثلاثةُ", 38.45, 38.86], ["أمتار،", 38.91, 39.49], ["وعضّتُه", 39.66, 40.17], ["سامّة.", 40.26, 40.72]]}, {"text": "هل تريدُ تنّيناً أليفاً؟ اكتبْ في التعليقات.", "start": 41.1, "end": 44.35, "words": [["هل", 41.1, 41.29], ["تريدُ", 41.35, 41.68], ["تنّيناً", 41.74, 42.15], ["أليفاً؟", 42.18, 42.7], ["اكتبْ", 42.91, 43.31], ["في", 43.33, 43.39], ["التعليقات.", 43.41, 44.35]]}]