[{"text": "ماذا لو كانت التنانينُ موجودةً فعلاً؟", "start": 0.0, "end": 2.26, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.42], ["كانت", 0.48, 0.72], ["التنانينُ", 0.78, 1.25], ["موجودةً", 1.3, 1.76], ["فعلاً؟", 1.82, 2.26]]}, {"text": "أوّلاً، لن تكونَ عملاقة: أكبرُ حيوانٍ طارَ في التاريخ كان جناحاه بعرضِ أحدَ عشرَ متراً، ووزنُه ربعُ طنٍّ فقط.", "start": 2.57, "end": 11.38, "words": [["أوّلاً،", 2.57, 3.16], ["لن", 3.26, 3.41], ["تكونَ", 3.48, 3.83], ["عملاقة:", 3.89, 4.55], ["أكبرُ", 4.78, 5.21], ["حيوانٍ", 5.29, 5.79], ["طارَ", 5.9, 6.13], ["في", 6.18, 6.24], ["التاريخ", 6.26, 6.73], ["كان", 6.79, 6.99], ["جناحاه", 7.07, 7.55], ["بعرضِ", 7.66, 8.01], ["أحدَ", 8.06, 8.35], ["عشرَ", 8.37, 8.62], ["متراً،", 8.66, 9.12], ["ووزنُه", 9.43, 10.04], ["ربعُ", 10.19, 10.49], ["طنٍّ", 10.58, 10.88], ["فقط.", 10.91, 11.38]]}, {"text": "ولن يملكَ أربعَ أرجلٍ وجناحين: كلُّ الفقاريّاتِ لها أربعةُ أطرافٍ فقط، فجناحاه هما ذراعاه.", "start": 11.68, "end": 19.01, "words": [["ولن", 11.68, 11.95], ["يملكَ", 12.02, 12.39], ["أربعَ", 12.42, 12.79], ["أرجلٍ", 12.82, 13.2], ["وجناحين:", 13.26, 14.03], ["كلُّ", 14.34, 14.59], ["الفقاريّاتِ", 14.62, 15.35], ["لها", 15.41, 15.56], ["أربعةُ", 15.6, 16.03], ["أطرافٍ", 16.08, 16.49], ["فقط،", 16.54, 17.03], ["فجناحاه", 17.23, 17.91], ["هما", 18.08, 18.32], ["ذراعاه.", 18.4, 19.01]]}, {"text": "أمّا النار؟ ممكنة! الأبقارُ تُخرجُ غازَ الميثانِ كلَّ يوم، وتنّينٌ يخزّنُه يحتاجُ شرارةً فقط… وفماً لا يحترق.", "start": 19.37, "end": 27.9, "words": [["أمّا", 19.37, 19.62], ["النار؟", 19.64, 20.16], ["ممكنة!", 20.32, 20.94], ["الأبقارُ", 21.25, 21.72], ["تُخرجُ", 21.77, 22.16], ["غازَ", 22.21, 22.42], ["الميثانِ", 22.44, 22.84], ["كلَّ", 22.88, 23.08], ["يوم،", 23.12, 23.45], ["وتنّينٌ", 23.7, 24.32], ["يخزّنُه", 24.39, 25.0], ["يحتاجُ", 25.1, 25.47], ["شرارةً", 25.54, 26.01], ["فقط…", 26.06, 26.51], ["وفماً", 26.75, 27.2], ["لا", 27.26, 27.32], ["يحترق.", 27.36, 27.9]]}, {"text": "ولكي يطيرَ، يحتاجُ عظاماً مجوّفةً خفيفةً كعظامِ الطيور، وعضلاتِ صدرٍ هائلة.", "start": 28.14, "end": 34.01, "words": [["ولكي", 28.14, 28.55], ["يطيرَ،", 28.57, 29.11], ["يحتاجُ", 29.29, 29.73], ["عظاماً", 29.79, 30.23], ["مجوّفةً", 30.28, 30.94], ["خفيفةً", 31.0, 31.52], ["كعظامِ", 31.58, 32.0], ["الطيور،", 32.01, 32.53], ["وعضلاتِ", 32.74, 33.26], ["صدرٍ", 33.32, 33.56], ["هائلة.", 33.6, 34.01]]}, {"text": "وتنّينٌ بوزنِ طنٍّ يحتاجُ لحماً بحجمِ خروفٍ كلَّ يوم.", "start": 34.22, "end": 38.1, "words": [["وتنّينٌ", 34.22, 34.78], ["بوزنِ", 34.87, 35.27], ["طنٍّ", 35.35, 35.83], ["يحتاجُ", 36.0, 36.4], ["لحماً", 36.44, 36.72], ["بحجمِ", 36.77, 37.13], ["خروفٍ", 37.19, 37.51], ["كلَّ", 37.57, 37.77], ["يوم.", 37.8, 38.1]]}, {"text": "وستُغلقُ المطارات، وتُبنى المدنُ بأسقفٍ لا تحترق.", "start": 38.38, "end": 42.39, "words": [["وستُغلقُ", 38.38, 39.07], ["المطارات،", 39.09, 39.86], ["وتُبنى", 40.01, 40.48], ["المدنُ", 40.51, 40.97], ["بأسقفٍ", 41.02, 41.62], ["لا", 41.69, 41.76], ["تحترق.", 41.82, 42.39]]}, {"text": "والغريب؟ التنّينُ موجودٌ فعلاً: تنّينُ كومودو، طولُه ثلاثةُ أمتار، وعضّتُه سامّة.", "start": 42.71, "end": 50.03, "words": [["والغريب؟", 42.71, 43.41], ["التنّينُ", 43.69, 44.23], ["موجودٌ", 44.28, 44.73], ["فعلاً:", 44.81, 45.31], ["تنّينُ", 45.64, 46.12], ["كومودو،", 46.19, 46.86], ["طولُه", 47.07, 47.44], ["ثلاثةُ", 47.55, 48.04], ["أمتار،", 48.1, 48.67], ["وعضّتُه", 48.8, 49.42], ["سامّة.", 49.54, 50.03]]}, {"text": "هل تريدُ تنّيناً أليفاً؟ اكتبْ في التعليقات.", "start": 50.35, "end": 53.73, "words": [["هل", 50.35, 50.5], ["تريدُ", 50.56, 50.85], ["تنّيناً", 50.9, 51.29], ["أليفاً؟", 51.33, 51.91], ["اكتبْ", 52.19, 52.58], ["في", 52.6, 52.66], ["التعليقات.", 52.7, 53.73]]}]