[{"text": "ماذا لو تدمّرتِ الأرضُ فجأة؟ في لحظةٍ واحدة، يتشقّقُ كوكبُنا ويتحوّلُ إلى سحابةٍ من الصخور.", "start": 0.0, "end": 7.62, "words": [["ماذا", 0.0, 0.3], ["لو", 0.33, 0.43], ["تدمّرتِ", 0.48, 1.01], ["الأرضُ", 1.04, 1.33], ["فجأة؟", 1.39, 1.89], ["في", 2.19, 2.3], ["لحظةٍ", 2.37, 2.75], ["واحدة،", 2.83, 3.4], ["يتشقّقُ", 3.56, 4.32], ["كوكبُنا", 4.4, 5.05], ["ويتحوّلُ", 5.25, 6.13], ["إلى", 6.19, 6.3], ["سحابةٍ", 6.4, 6.85], ["من", 6.87, 6.99], ["الصخور.", 7.05, 7.62]]}, {"text": "ولتفجيرِ الأرضِ نحتاجُ طاقةً هائلة: كلَّ ما تُطلقُه الشمسُ في أسبوعٍ كامل.", "start": 7.98, "end": 13.1, "words": [["ولتفجيرِ", 7.98, 8.56], ["الأرضِ", 8.58, 8.9], ["نحتاجُ", 8.95, 9.33], ["طاقةً", 9.39, 9.8], ["هائلة:", 9.85, 10.34], ["كلَّ", 10.65, 10.96], ["ما", 11.02, 11.08], ["تُطلقُه", 11.15, 11.62], ["الشمسُ", 11.64, 12.01], ["في", 12.04, 12.12], ["أسبوعٍ", 12.17, 12.56], ["كامل.", 12.63, 13.1]]}, {"text": "تنطلقُ الصخورُ بسرعةٍ مرعبة، وتضربُ القمرَ بعدَ ساعاتٍ قليلة.", "start": 13.46, "end": 18.18, "words": [["تنطلقُ", 13.46, 14.03], ["الصخورُ", 14.04, 14.5], ["بسرعةٍ", 14.54, 15.02], ["مرعبة،", 15.07, 15.64], ["وتضربُ", 15.91, 16.45], ["القمرَ", 16.49, 16.93], ["بعدَ", 16.98, 17.21], ["ساعاتٍ", 17.25, 17.6], ["قليلة.", 17.66, 18.18]]}, {"text": "لكنّ القمرَ لا يسقط… بل يصبحُ كوكباً صغيراً يدورُ وحدَه حولَ الشمس.", "start": 18.48, "end": 23.77, "words": [["لكنّ", 18.48, 18.85], ["القمرَ", 18.88, 19.3], ["لا", 19.36, 19.43], ["يسقط…", 19.49, 20.07], ["بل", 20.39, 20.52], ["يصبحُ", 20.56, 20.93], ["كوكباً", 21.0, 21.47], ["صغيراً", 21.54, 22.07], ["يدورُ", 22.25, 22.61], ["وحدَه", 22.63, 22.92], ["حولَ", 22.98, 23.18], ["الشمس.", 23.21, 23.77]]}, {"text": "ومعَ الأرض، تختفي الحياةُ الوحيدةُ التي نعرفُها في الكون.", "start": 24.09, "end": 28.13, "words": [["ومعَ", 24.09, 24.45], ["الأرض،", 24.47, 24.88], ["تختفي", 24.9, 25.26], ["الحياةُ", 25.29, 25.67], ["الوحيدةُ", 25.69, 26.27], ["التي", 26.55, 26.88], ["نعرفُها", 26.93, 27.42], ["في", 27.49, 27.55], ["الكون.", 27.59, 28.13]]}, {"text": "بعدَ دقائق، يصلُ ضوءُ الانفجارِ إلى المريخ: النجمُ الأزرقُ في سمائِه يلمعُ… ثمّ يختفي.", "start": 28.51, "end": 35.75, "words": [["بعدَ", 28.51, 28.78], ["دقائق،", 28.83, 29.51], ["يصلُ", 29.69, 30.07], ["ضوءُ", 30.13, 30.35], ["الانفجارِ", 30.37, 31.01], ["إلى", 31.06, 31.2], ["المريخ:", 31.23, 31.87], ["النجمُ", 32.19, 32.6], ["الأزرقُ", 32.64, 33.13], ["في", 33.19, 33.26], ["سمائِه", 33.34, 33.81], ["يلمعُ…", 33.9, 34.56], ["ثمّ", 34.89, 35.14], ["يختفي.", 35.18, 35.75]]}, {"text": "لكنّ شيئاً منّا يبقى: إشاراتُ الراديو تسافرُ في الفضاءِ منذُ أكثرَ من مئةِ عام.", "start": 36.07, "end": 41.41, "words": [["لكنّ", 36.07, 36.41], ["شيئاً", 36.48, 36.74], ["منّا", 36.79, 37.0], ["يبقى:", 37.05, 37.49], ["إشاراتُ", 37.73, 38.3], ["الراديو", 38.32, 38.72], ["تسافرُ", 38.77, 39.24], ["في", 39.29, 39.35], ["الفضاءِ", 39.38, 39.83], ["منذُ", 39.89, 40.1], ["أكثرَ", 40.16, 40.47], ["من", 40.52, 40.61], ["مئةِ", 40.65, 40.98], ["عام.", 41.04, 41.41]]}, {"text": "ومسبارا فوياجر يحملانِ أسطوانتينِ ذهبيّتينِ فيهما أصواتُ الأرض… رسالةً من عالمٍ لم يعُدْ موجوداً.", "start": 41.73, "end": 49.75, "words": [["ومسبارا", 41.73, 42.38], ["فوياجر", 42.43, 42.95], ["يحملانِ", 42.98, 43.48], ["أسطوانتينِ", 43.51, 44.31], ["ذهبيّتينِ", 44.37, 45.14], ["فيهما", 45.2, 45.69], ["أصواتُ", 45.95, 46.42], ["الأرض…", 46.44, 47.04], ["رسالةً", 47.36, 47.95], ["من", 47.97, 48.09], ["عالمٍ", 48.16, 48.58], ["لم", 48.69, 48.83], ["يعُدْ", 48.91, 49.13], ["موجوداً.", 49.16, 49.75]]}, {"text": "أمّا الحطامُ، فينتشرُ حلقةً حولَ الشمس، وقد يضربُ المريخَ والزهرةَ ملايينَ السنين.", "start": 50.12, "end": 56.82, "words": [["أمّا", 50.12, 50.38], ["الحطامُ،", 50.4, 51.11], ["فينتشرُ", 51.25, 51.91], ["حلقةً", 51.97, 52.44], ["حولَ", 52.5, 52.74], ["الشمس،", 52.76, 53.36], ["وقد", 53.51, 53.85], ["يضربُ", 53.93, 54.3], ["المريخَ", 54.33, 54.88], ["والزهرةَ", 54.94, 55.61], ["ملايينَ", 55.81, 56.26], ["السنين.", 56.28, 56.82]]}, {"text": "والمفاجأة؟ الأرضُ قد تُدمَّرُ فعلاً يوماً ما: بعدَ نحوِ خمسةِ ملياراتِ سنة تنتفخُ الشمس، وقد تبتلعُها.", "start": 57.13, "end": 66.19, "words": [["والمفاجأة؟", 57.13, 58.03], ["الأرضُ", 58.47, 58.94], ["قد", 59.0, 59.13], ["تُدمَّرُ", 59.16, 59.63], ["فعلاً", 59.7, 60.01], ["يوماً", 60.06, 60.34], ["ما:", 60.38, 60.76], ["بعدَ", 61.14, 61.39], ["نحوِ", 61.44, 61.71], ["خمسةِ", 61.79, 62.23], ["ملياراتِ", 62.29, 62.84], ["سنة", 62.9, 63.23], ["تنتفخُ", 63.51, 64.23], ["الشمس،", 64.25, 64.9], ["وقد", 65.05, 65.39], ["تبتلعُها.", 65.42, 66.19]]}, {"text": "هل تظنُّ أنّ البشرَ سيرحلونَ قبلَ ذلك؟ اكتبْ في التعليقات… واشتركْ.", "start": 66.63, "end": 72.21, "words": [["هل", 66.63, 66.8], ["تظنُّ", 66.86, 67.26], ["أنّ", 67.3, 67.48], ["البشرَ", 67.51, 67.97], ["سيرحلونَ", 68.02, 68.6], ["قبلَ", 68.69, 68.92], ["ذلك؟", 68.97, 69.45], ["اكتبْ", 69.78, 70.14], ["في", 70.16, 70.22], ["التعليقات…", 70.25, 71.1], ["واشتركْ.", 71.38, 72.21]]}]