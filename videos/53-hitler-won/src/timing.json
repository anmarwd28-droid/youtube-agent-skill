[{"text": "ماذا لو انتصرَ هتلرُ في الحربِ العالميّةِ الثانية؟", "start": 0.0, "end": 3.03, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.48], ["انتصرَ", 0.51, 0.94], ["هتلرُ", 1.0, 1.38], ["في", 1.44, 1.5], ["الحربِ", 1.52, 1.82], ["العالميّةِ", 1.85, 2.37], ["الثانية؟", 2.39, 3.03]]}, {"text": "عامَ ألفٍ وتسعِمئةٍ واثنينِ وأربعين، كانت جيوشُه تحتلُّ معظمَ أوروبّا، من فرنسا حتّى نهرِ الفولغا.", "start": 3.47, "end": 11.46, "words": [["عامَ", 3.47, 3.75], ["ألفٍ", 3.79, 4.1], ["وتسعِمئةٍ", 4.13, 4.87], ["واثنينِ", 4.93, 5.29], ["وأربعين،", 5.35, 6.03], ["كانت", 6.4, 6.68], ["جيوشُه", 6.75, 7.26], ["تحتلُّ", 7.33, 7.79], ["معظمَ", 7.84, 8.21], ["أوروبّا،", 8.26, 8.9], ["من", 9.1, 9.25], ["فرنسا", 9.31, 9.88], ["حتّى", 10.12, 10.53], ["نهرِ", 10.61, 10.84], ["الفولغا.", 10.87, 11.46]]}, {"text": "لكنّها انكسرت في ستالينغراد، ونفدَ وقودُها، وصنعت أمريكا وحدَها نحوَ ثلاثِمئةِ ألفِ طائرة.", "start": 11.84, "end": 19.11, "words": [["لكنّها", 11.84, 12.26], ["انكسرت", 12.28, 12.79], ["في", 12.85, 12.92], ["ستالينغراد،", 12.96, 13.78], ["ونفدَ", 13.96, 14.51], ["وقودُها،", 14.57, 15.29], ["وصنعت", 15.5, 16.08], ["أمريكا", 16.14, 16.64], ["وحدَها", 16.68, 17.16], ["نحوَ", 17.28, 17.53], ["ثلاثِمئةِ", 17.59, 18.32], ["ألفِ", 18.37, 18.6], ["طائرة.", 18.66, 19.11]]}, {"text": "لو انتصرَ هتلر، لاستمرّت الإبادةُ التي قتلت ستّةَ ملايينِ يهوديّ وملايينَ غيرَهم، ولهُجِّرَ عشراتُ الملايينِ من شرقِ أوروبّا.", "start": 19.55, "end": 28.87, "words": [["لو", 19.55, 19.74], ["انتصرَ", 19.78, 20.27], ["هتلر،", 20.33, 20.87], ["لاستمرّت", 21.08, 21.66], ["الإبادةُ", 21.7, 22.19], ["التي", 22.21, 22.43], ["قتلت", 22.55, 22.92], ["ستّةَ", 23.0, 23.5], ["ملايينِ", 23.57, 24.02], ["يهوديّ", 24.05, 24.59], ["وملايينَ", 24.82, 25.43], ["غيرَهم،", 25.5, 26.09], ["ولهُجِّرَ", 26.28, 26.95], ["عشراتُ", 27.0, 27.47], ["الملايينِ", 27.49, 27.97], ["من", 27.99, 28.07], ["شرقِ", 28.13, 28.39], ["أوروبّا.", 28.41, 28.87]]}, {"text": "ولما وُلدت الأممُ المتّحدة، ولا الإعلانُ العالميُّ لحقوقِ الإنسان.", "start": 29.23, "end": 34.17, "words": [["ولما", 29.23, 29.63], ["وُلدت", 29.66, 30.09], ["الأممُ", 30.15, 30.6], ["المتّحدة،", 30.63, 31.52], ["ولا", 31.72, 31.95], ["الإعلانُ", 31.97, 32.45], ["العالميُّ", 32.47, 33.04], ["لحقوقِ", 33.08, 33.52], ["الإنسان.", 33.54, 34.17]]}, {"text": "والعِلم؟ أوّلُ صاروخٍ وصلَ إلى الفضاءِ كان ألمانيّاً، عامَ ألفٍ وتسعِمئةٍ وأربعةٍ وأربعين.", "start": 34.54, "end": 41.98, "words": [["والعِلم؟", 34.54, 35.18], ["أوّلُ", 35.34, 35.73], ["صاروخٍ", 35.8, 36.28], ["وصلَ", 36.37, 36.71], ["إلى", 36.74, 36.87], ["الفضاءِ", 36.91, 37.52], ["كان", 37.79, 38.06], ["ألمانيّاً،", 38.13, 38.93], ["عامَ", 39.16, 39.47], ["ألفٍ", 39.52, 39.83], ["وتسعِمئةٍ", 39.89, 40.68], ["وأربعةٍ", 40.75, 41.28], ["وأربعين.", 41.34, 41.98]]}, {"text": "صمّمَه فون براون سلاحاً، وبعدَ الحربِ صمّمَ في أمريكا الصاروخَ الذي أوصلَ البشرَ إلى القمر.", "start": 42.36, "end": 49.27, "words": [["صمّمَه", 42.36, 42.85], ["فون", 42.97, 43.18], ["براون", 43.25, 43.55], ["سلاحاً،", 43.61, 44.26], ["وبعدَ", 44.5, 44.93], ["الحربِ", 44.97, 45.35], ["صمّمَ", 45.42, 45.74], ["في", 45.8, 45.89], ["أمريكا", 45.94, 46.41], ["الصاروخَ", 46.64, 47.33], ["الذي", 47.36, 47.65], ["أوصلَ", 47.7, 48.11], ["البشرَ", 48.13, 48.55], ["إلى", 48.59, 48.7], ["القمر.", 48.74, 49.27]]}, {"text": "في عالمٍ يحكمُه هتلر، ربّما بقيت الصواريخُ أسلحةً فقط.", "start": 49.6, "end": 54.18, "words": [["في", 49.6, 49.71], ["عالمٍ", 49.83, 50.18], ["يحكمُه", 50.25, 50.77], ["هتلر،", 50.83, 51.38], ["ربّما", 51.63, 52.0], ["بقيت", 52.07, 52.42], ["الصواريخُ", 52.49, 53.08], ["أسلحةً", 53.12, 53.68], ["فقط.", 53.73, 54.18]]}, {"text": "أمّا القنبلةُ الذرّيّة، فبدأتها أمريكا خوفاً من أن يصنعَها هتلرُ أوّلاً.", "start": 54.51, "end": 60.15, "words": [["أمّا", 54.51, 54.75], ["القنبلةُ", 54.79, 55.36], ["الذرّيّة،", 55.38, 56.18], ["فبدأتها", 56.35, 57.0], ["أمريكا", 57.06, 57.53], ["خوفاً", 57.59, 57.96], ["من", 58.0, 58.11], ["أن", 58.15, 58.27], ["يصنعَها", 58.32, 58.85], ["هتلرُ", 58.92, 59.43], ["أوّلاً.", 59.51, 60.15]]}, {"text": "والمفاجأة؟ الانشطارُ النوويُّ اكتُشِفَ في برلين نفسِها، عامَ ألفٍ وتسعِمئةٍ وثمانيةٍ وثلاثين!", "start": 60.52, "end": 67.87, "words": [["والمفاجأة؟", 60.52, 61.43], ["الانشطارُ", 61.74, 62.38], ["النوويُّ", 62.4, 63.02], ["اكتُشِفَ", 63.03, 63.59], ["في", 63.63, 63.72], ["برلين", 63.77, 64.14], ["نفسِها،", 64.18, 64.78], ["عامَ", 65.11, 65.39], ["ألفٍ", 65.43, 65.71], ["وتسعِمئةٍ", 65.76, 66.42], ["وثمانيةٍ", 66.48, 67.08], ["وثلاثين!", 67.14, 67.87]]}, {"text": "لكنّ قوانينَ هتلر أجبرت كثيراً من أبرزِ العلماءِ على الرحيل، مثلَ أينشتاين وليزه مايتنر.", "start": 68.24, "end": 74.45, "words": [["لكنّ", 68.24, 68.63], ["قوانينَ", 68.7, 69.15], ["هتلر", 69.21, 69.57], ["أجبرت", 69.62, 70.04], ["كثيراً", 70.1, 70.51], ["من", 70.54, 70.65], ["أبرزِ", 70.68, 71.03], ["العلماءِ", 71.05, 71.56], ["على", 71.62, 71.75], ["الرحيل،", 71.77, 72.41], ["مثلَ", 72.68, 72.97], ["أينشتاين", 73.02, 73.56], ["وليزه", 73.62, 73.93], ["مايتنر.", 73.97, 74.45]]}, {"text": "فصنعَ أعداؤه القنبلةَ بمساعدةِ علماءَ هربوا منه.", "start": 74.77, "end": 78.51, "words": [["فصنعَ", 74.77, 75.33], ["أعداؤه", 75.35, 75.81], ["القنبلةَ", 75.86, 76.38], ["بمساعدةِ", 76.5, 77.29], ["علماءَ", 77.36, 77.82], ["هربوا", 77.84, 78.16], ["منه.", 78.18, 78.51]]}, {"text": "برأيك، هل كان يمكنُ أن ينتصرَ فعلاً؟ اكتبْ في التعليقات، واشتركْ.", "start": 78.95, "end": 84.1, "words": [["برأيك،", 78.95, 79.59], ["هل", 79.83, 79.98], ["كان", 80.05, 80.21], ["يمكنُ", 80.27, 80.6], ["أن", 80.64, 80.71], ["ينتصرَ", 80.77, 81.23], ["فعلاً؟", 81.29, 81.79], ["اكتبْ", 82.04, 82.37], ["في", 82.4, 82.45], ["التعليقات،", 82.49, 83.19], ["واشتركْ.", 83.24, 84.1]]}]