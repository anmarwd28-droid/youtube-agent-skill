[{"text": "ماذا لو توقّفَ المطرُ في العالمِ كلِّه… لسنةٍ كاملة؟", "start": 0.0, "end": 3.96, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.45], ["توقّفَ", 0.51, 0.92], ["المطرُ", 0.94, 1.35], ["في", 1.39, 1.45], ["العالمِ", 1.47, 1.83], ["كلِّه…", 1.9, 2.44], ["لسنةٍ", 2.76, 3.31], ["كاملة؟", 3.39, 3.96]]}, {"text": "في الأيامِ الأولى، لن تلاحظَ شيئاً. فالسدودُ والأنهارُ ما زالت ممتلئة.", "start": 4.28, "end": 9.61, "words": [["في", 4.28, 4.39], ["الأيامِ", 4.42, 4.89], ["الأولى،", 4.91, 5.47], ["لن", 5.62, 5.79], ["تلاحظَ", 5.85, 6.37], ["شيئاً.", 6.42, 6.97], ["فالسدودُ", 7.25, 7.89], ["والأنهارُ", 7.93, 8.51], ["ما", 8.56, 8.62], ["زالت", 8.7, 8.93], ["ممتلئة.", 8.99, 9.61]]}, {"text": "لكن بعدَ أسابيع، تجفُّ التربة… وتذبلُ المحاصيل.", "start": 9.89, "end": 14.26, "words": [["لكن", 9.89, 10.18], ["بعدَ", 10.22, 10.45], ["أسابيع،", 10.48, 11.19], ["تجفُّ", 11.37, 11.85], ["التربة…", 11.88, 12.55], ["وتذبلُ", 12.72, 13.41], ["المحاصيل.", 13.43, 14.26]]}, {"text": "فنحوُ ثمانينَ في المئةِ من أراضي العالمِ الزراعية تعتمدُ على المطرِ وحدَه، وتنتجُ أكثرَ من نصفِ غذائِنا.", "start": 14.5, "end": 21.66, "words": [["فنحوُ", 14.5, 14.94], ["ثمانينَ", 15.02, 15.46], ["في", 15.53, 15.59], ["المئةِ", 15.63, 15.99], ["من", 16.03, 16.1], ["أراضي", 16.14, 16.41], ["العالمِ", 16.43, 16.8], ["الزراعية", 16.82, 17.47], ["تعتمدُ", 17.68, 18.22], ["على", 18.29, 18.39], ["المطرِ", 18.41, 18.82], ["وحدَه،", 18.85, 19.43], ["وتنتجُ", 19.64, 20.26], ["أكثرَ", 20.32, 20.63], ["من", 20.68, 20.76], ["نصفِ", 20.78, 21.02], ["غذائِنا.", 21.07, 21.66]]}, {"text": "والأنهارُ تنحسر: دجلةُ والفرات يتحوّلانِ إلى جداولَ ضعيفة، وتظهرُ قيعانُها المتشقّقة.", "start": 21.98, "end": 28.87, "words": [["والأنهارُ", 21.98, 22.56], ["تنحسر:", 22.6, 23.25], ["دجلةُ", 23.56, 24.04], ["والفرات", 24.1, 24.59], ["يتحوّلانِ", 24.65, 25.37], ["إلى", 25.39, 25.51], ["جداولَ", 25.58, 25.99], ["ضعيفة،", 26.05, 26.59], ["وتظهرُ", 26.84, 27.43], ["قيعانُها", 27.47, 27.96], ["المتشقّقة.", 27.98, 28.87]]}, {"text": "والسدودُ تفرغ، فتقلُّ الكهرباءُ التي تنتجُها.", "start": 29.19, "end": 32.59, "words": [["والسدودُ", 29.19, 29.71], ["تفرغ،", 29.78, 30.32], ["فتقلُّ", 30.44, 31.0], ["الكهرباءُ", 31.02, 31.62], ["التي", 31.65, 31.89], ["تنتجُها.", 31.94, 32.59]]}, {"text": "والناسُ يحفرونَ الآبارَ أعمقَ فأعمق، فتنخفضُ المياهُ الجوفية.", "start": 32.89, "end": 37.47, "words": [["والناسُ", 32.89, 33.32], ["يحفرونَ", 33.37, 33.82], ["الآبارَ", 33.84, 34.28], ["أعمقَ", 34.31, 34.76], ["فأعمق،", 34.81, 35.4], ["فتنخفضُ", 35.6, 36.3], ["المياهُ", 36.34, 36.72], ["الجوفية.", 36.74, 37.47]]}, {"text": "والغاباتُ تجفّ، فتشتعلُ الحرائقُ بسهولة… والعواصفُ الترابيةُ تملأُ السماء.", "start": 37.73, "end": 43.98, "words": [["والغاباتُ", 37.73, 38.3], ["تجفّ،", 38.36, 39.02], ["فتشتعلُ", 39.23, 39.89], ["الحرائقُ", 39.91, 40.52], ["بسهولة…", 40.56, 41.26], ["والعواصفُ", 41.51, 42.23], ["الترابيةُ", 42.25, 42.99], ["تملأُ", 43.06, 43.41], ["السماء.", 43.43, 43.98]]}, {"text": "وعندما يعودُ المطرُ أخيراً، قد يسبّبُ فيضانات… لأنّ الأرضَ الجافّةَ الصلبة لا تمتصُّ الماءَ بسرعة.", "start": 44.36, "end": 51.95, "words": [["وعندما", 44.36, 44.85], ["يعودُ", 44.88, 45.2], ["المطرُ", 45.22, 45.66], ["أخيراً،", 45.71, 46.35], ["قد", 46.52, 46.68], ["يسبّبُ", 46.74, 47.21], ["فيضانات…", 47.26, 48.08], ["لأنّ", 48.4, 48.75], ["الأرضَ", 48.77, 49.15], ["الجافّةَ", 49.18, 49.73], ["الصلبة", 49.75, 50.25], ["لا", 50.42, 50.57], ["تمتصُّ", 50.63, 51.08], ["الماءَ", 51.11, 51.35], ["بسرعة.", 51.4, 51.95]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 52.23, "end": 58.56, "words": [["والآن", 52.23, 52.56], ["دورُك:", 52.6, 53.12], ["ماذا", 53.39, 53.66], ["لو…؟", 53.72, 54.21], ["اكتبْ", 54.53, 54.95], ["سؤالَك", 54.98, 55.36], ["في", 55.47, 55.54], ["التعليقات،", 55.56, 56.44], ["وقد", 56.61, 56.95], ["يكونُ", 57.01, 57.32], ["الفيديو", 57.35, 57.7], ["القادم.", 57.73, 58.56]]}]