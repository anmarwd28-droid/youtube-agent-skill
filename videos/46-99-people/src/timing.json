[{"text": "ماذا لو بقيَ في العالمِ تسعةٌ وتسعونَ شخصاً فقط؟", "start": 0.0, "end": 3.32, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.45], ["بقيَ", 0.51, 0.82], ["في", 0.88, 0.94], ["العالمِ", 0.97, 1.41], ["تسعةٌ", 1.45, 1.94], ["وتسعونَ", 1.99, 2.44], ["شخصاً", 2.51, 2.8], ["فقط؟", 2.84, 3.32]]}, {"text": "لو توزّعوا على اليابسة، لكان نصيبُ كلِّ واحدٍ منهم مليوناً ونصفَ مليونِ كيلومترٍ مربّع… وقد يعيشُ عمرَه دونَ أن يرى إنساناً آخر.", "start": 3.7, "end": 13.65, "words": [["لو", 3.7, 3.84], ["توزّعوا", 3.9, 4.39], ["على", 4.41, 4.53], ["اليابسة،", 4.55, 5.26], ["لكان", 5.47, 5.79], ["نصيبُ", 5.88, 6.29], ["كلِّ", 6.36, 6.63], ["واحدٍ", 6.66, 6.98], ["منهم", 7.01, 7.4], ["مليوناً", 7.72, 8.29], ["ونصفَ", 8.36, 8.75], ["مليونِ", 8.8, 9.15], ["كيلومترٍ", 9.21, 9.72], ["مربّع…", 9.75, 10.44], ["وقد", 10.76, 11.11], ["يعيشُ", 11.19, 11.55], ["عمرَه", 11.6, 11.94], ["دونَ", 12.03, 12.26], ["أن", 12.32, 12.37], ["يرى", 12.43, 12.67], ["إنساناً", 12.72, 13.14], ["آخر.", 13.18, 13.65]]}, {"text": "خلالَ أيامٍ تتوقّفُ محطّاتُ الكهرباء، فتُظلِمُ المدنُ ويصمتُ الإنترنت.", "start": 14.04, "end": 19.85, "words": [["خلالَ", 14.04, 14.38], ["أيامٍ", 14.44, 14.93], ["تتوقّفُ", 14.99, 15.58], ["محطّاتُ", 15.64, 16.15], ["الكهرباء،", 16.17, 16.98], ["فتُظلِمُ", 17.19, 17.77], ["المدنُ", 17.8, 18.34], ["ويصمتُ", 18.59, 19.11], ["الإنترنت.", 19.13, 19.85]]}, {"text": "الطعامُ الطازجُ يفسُدُ سريعاً، لكنّ المعلّباتِ في المتاجرِ تكفيهم سنواتٍ طويلة.", "start": 20.29, "end": 25.82, "words": [["الطعامُ", 20.29, 20.77], ["الطازجُ", 20.79, 21.39], ["يفسُدُ", 21.45, 21.84], ["سريعاً،", 21.9, 22.45], ["لكنّ", 22.62, 22.98], ["المعلّباتِ", 23.01, 23.71], ["في", 23.75, 23.81], ["المتاجرِ", 23.85, 24.4], ["تكفيهم", 24.46, 24.84], ["سنواتٍ", 24.93, 25.3], ["طويلة.", 25.36, 25.82]]}, {"text": "ونحوُ أربعِمئةِ مفاعلٍ نوويٍّ تُطفئُ نفسَها تلقائياً… لكنّ وقودَها يحتاجُ تبريداً، وبلا كهرباءَ قد يتسرّبُ الإشعاع.", "start": 26.18, "end": 35.4, "words": [["ونحوُ", 26.18, 26.59], ["أربعِمئةِ", 26.64, 27.28], ["مفاعلٍ", 27.36, 27.85], ["نوويٍّ", 27.89, 28.61], ["تُطفئُ", 28.84, 29.23], ["نفسَها", 29.3, 29.65], ["تلقائياً…", 29.7, 30.49], ["لكنّ", 30.79, 31.16], ["وقودَها", 31.21, 31.65], ["يحتاجُ", 31.7, 32.1], ["تبريداً،", 32.15, 32.8], ["وبلا", 32.99, 33.39], ["كهرباءَ", 33.46, 33.99], ["قد", 34.06, 34.23], ["يتسرّبُ", 34.28, 34.81], ["الإشعاع.", 34.83, 35.4]]}, {"text": "بعدَ سنوات، تشقُّ النباتاتُ الشوارع، وتعودُ الحيواناتُ إلى المدن.", "start": 35.82, "end": 40.43, "words": [["بعدَ", 35.82, 36.05], ["سنوات،", 36.11, 36.57], ["تشقُّ", 36.69, 37.09], ["النباتاتُ", 37.1, 37.7], ["الشوارع،", 37.72, 38.39], ["وتعودُ", 38.57, 39.06], ["الحيواناتُ", 39.08, 39.69], ["إلى", 39.74, 39.86], ["المدن.", 39.89, 40.43]]}, {"text": "ومن سبعةِ آلافِ لغة، لا يبقى إلا القليل… وتضيعُ معارفُ كثيرة: لا مصانعَ ولا أدوية.", "start": 40.7, "end": 47.14, "words": [["ومن", 40.7, 40.95], ["سبعةِ", 40.99, 41.35], ["آلافِ", 41.4, 41.7], ["لغة،", 41.75, 42.05], ["لا", 42.09, 42.17], ["يبقى", 42.23, 42.48], ["إلا", 42.5, 42.63], ["القليل…", 42.67, 43.3], ["وتضيعُ", 43.75, 44.3], ["معارفُ", 44.36, 44.79], ["كثيرة:", 44.85, 45.5], ["لا", 45.71, 45.82], ["مصانعَ", 45.88, 46.35], ["ولا", 46.37, 46.54], ["أدوية.", 46.58, 47.14]]}, {"text": "فإنِ اجتمعوا، صاروا قريةً واحدةً صغيرة، تعيشُ على الزراعةِ والصيد.", "start": 47.41, "end": 52.33, "words": [["فإنِ", 47.41, 47.75], ["اجتمعوا،", 47.77, 48.46], ["صاروا", 48.7, 49.01], ["قريةً", 49.04, 49.42], ["واحدةً", 49.47, 49.89], ["صغيرة،", 49.95, 50.48], ["تعيشُ", 50.69, 51.04], ["على", 51.08, 51.19], ["الزراعةِ", 51.21, 51.7], ["والصيد.", 51.75, 52.33]]}, {"text": "لكنْ هل يكفي هذا العددُ لتستمرَّ البشرية؟ الخطرُ هو زواجُ الأقارب، الذي يُضعِفُ الأجيالَ القادمة.", "start": 52.65, "end": 60.03, "words": [["لكنْ", 52.65, 52.99], ["هل", 53.03, 53.19], ["يكفي", 53.26, 53.51], ["هذا", 53.59, 53.8], ["العددُ", 53.82, 54.26], ["لتستمرَّ", 54.31, 54.88], ["البشرية؟", 54.9, 55.65], ["الخطرُ", 55.97, 56.51], ["هو", 56.56, 56.7], ["زواجُ", 56.82, 57.17], ["الأقارب،", 57.2, 57.91], ["الذي", 58.04, 58.37], ["يُضعِفُ", 58.42, 58.86], ["الأجيالَ", 58.9, 59.36], ["القادمة.", 59.4, 60.03]]}, {"text": "والمفاجأة؟ حسبتْ دراسةٌ أنّ ثمانيةً وتسعين شخصاً يكفون لرحلةٍ فضائيّةٍ تدومُ ستّةَ آلافِ سنة… بشرطِ اختيارِ الأزواجِ بعناية.", "start": 60.42, "end": 71.13, "words": [["والمفاجأة؟", 60.42, 61.29], ["حسبتْ", 61.57, 62.05], ["دراسةٌ", 62.1, 62.62], ["أنّ", 62.69, 62.86], ["ثمانيةً", 62.93, 63.52], ["وتسعين", 63.55, 64.05], ["شخصاً", 64.14, 64.61], ["يكفون", 64.99, 65.42], ["لرحلةٍ", 65.49, 66.08], ["فضائيّةٍ", 66.17, 66.8], ["تدومُ", 66.9, 67.3], ["ستّةَ", 67.37, 67.78], ["آلافِ", 67.85, 68.24], ["سنة…", 68.31, 68.73], ["بشرطِ", 69.11, 69.52], ["اختيارِ", 69.54, 69.96], ["الأزواجِ", 69.98, 70.47], ["بعناية.", 70.52, 71.13]]}, {"text": "هل تنجو لو كنتَ منهم؟ اكتبْ في التعليقات… واشتركْ.", "start": 71.52, "end": 76.02, "words": [["هل", 71.52, 71.73], ["تنجو", 71.8, 72.11], ["لو", 72.14, 72.25], ["كنتَ", 72.3, 72.56], ["منهم؟", 72.62, 73.08], ["اكتبْ", 73.36, 73.77], ["في", 73.79, 73.86], ["التعليقات…", 73.9, 74.87], ["واشتركْ.", 75.15, 76.02]]}]