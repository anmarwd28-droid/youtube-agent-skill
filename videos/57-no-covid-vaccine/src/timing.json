[{"text": "ماذا لو لم يُكتشَفْ لقاحُ كورونا أبداً؟", "start": 0.0, "end": 2.63, "words": [["ماذا", 0.0, 0.33], ["لو", 0.36, 0.48], ["لم", 0.52, 0.65], ["يُكتشَفْ", 0.73, 1.24], ["لقاحُ", 1.26, 1.68], ["كورونا", 1.74, 2.04], ["أبداً؟", 2.08, 2.63]]}, {"text": "في عامِ ألفينِ وعشرين، صُنِعَ اللقاحُ في أقلَّ من سنة، وهو أسرعُ لقاحٍ في التاريخ. الرقمُ القياسيُّ قبلَه كان أربعَ سنوات.", "start": 3.01, "end": 12.35, "words": [["في", 3.01, 3.12], ["عامِ", 3.22, 3.44], ["ألفينِ", 3.48, 3.9], ["وعشرين،", 3.96, 4.7], ["صُنِعَ", 4.91, 5.29], ["اللقاحُ", 5.31, 5.84], ["في", 5.89, 5.98], ["أقلَّ", 6.05, 6.44], ["من", 6.49, 6.58], ["سنة،", 6.64, 7.11], ["وهو", 7.31, 7.56], ["أسرعُ", 7.65, 8.05], ["لقاحٍ", 8.07, 8.47], ["في", 8.52, 8.58], ["التاريخ.", 8.6, 9.16], ["الرقمُ", 9.53, 9.93], ["القياسيُّ", 9.95, 10.61], ["قبلَه", 10.68, 11.09], ["كان", 11.24, 11.46], ["أربعَ", 11.48, 11.8], ["سنوات.", 11.84, 12.35]]}, {"text": "من دونِه، يبقى العالمُ في الإغلاق. ففي ذروتِه، طُلِبَ من نحوِ أربعةِ ملياراتِ إنسانٍ البقاءُ في بيوتِهم.", "start": 12.78, "end": 20.72, "words": [["من", 12.78, 12.92], ["دونِه،", 12.97, 13.49], ["يبقى", 13.64, 13.98], ["العالمُ", 14.0, 14.48], ["في", 14.52, 14.58], ["الإغلاق.", 14.62, 15.16], ["ففي", 15.49, 15.77], ["ذروتِه،", 15.85, 16.51], ["طُلِبَ", 16.68, 17.03], ["من", 17.08, 17.19], ["نحوِ", 17.25, 17.55], ["أربعةِ", 17.61, 18.08], ["ملياراتِ", 18.13, 18.58], ["إنسانٍ", 18.63, 19.14], ["البقاءُ", 19.41, 19.98], ["في", 20.02, 20.09], ["بيوتِهم.", 20.16, 20.72]]}, {"text": "وتمتلئُ المستشفياتُ مرّةً بعدَ مرّة، حتّى ينفدَ الأكسجين، وينامَ المرضى في الممرّات.", "start": 21.02, "end": 27.06, "words": [["وتمتلئُ", 21.02, 21.63], ["المستشفياتُ", 21.65, 22.41], ["مرّةً", 22.48, 22.87], ["بعدَ", 22.91, 23.13], ["مرّة،", 23.18, 23.7], ["حتّى", 23.86, 24.15], ["ينفدَ", 24.21, 24.52], ["الأكسجين،", 24.55, 25.33], ["وينامَ", 25.48, 25.98], ["المرضى", 26.01, 26.33], ["في", 26.38, 26.44], ["الممرّات.", 26.46, 27.06]]}, {"text": "وكلُّ إصابةٍ جديدةٍ فرصةٌ لأن يتحوّرَ الفيروس. متحوّرُ أوميكرون وحدَه حملَ أكثرَ من ثلاثينَ طفرةً في بروتينِ الشوكة.", "start": 27.43, "end": 36.61, "words": [["وكلُّ", 27.43, 27.85], ["إصابةٍ", 27.88, 28.33], ["جديدةٍ", 28.4, 28.86], ["فرصةٌ", 28.94, 29.47], ["لأن", 29.73, 29.98], ["يتحوّرَ", 30.04, 30.6], ["الفيروس.", 30.63, 31.23], ["متحوّرُ", 31.54, 32.21], ["أوميكرون", 32.25, 32.68], ["وحدَه", 32.72, 33.11], ["حملَ", 33.42, 33.7], ["أكثرَ", 33.76, 34.1], ["من", 34.15, 34.23], ["ثلاثينَ", 34.3, 34.76], ["طفرةً", 34.83, 35.35], ["في", 35.52, 35.64], ["بروتينِ", 35.71, 36.07], ["الشوكة.", 36.1, 36.61]]}, {"text": "وتقدّرُ دراسةٌ في مجلّةِ لانسيت أنّ اللقاحاتِ أنقذتْ نحوَ عشرينَ مليونَ حياةٍ في سنتِها الأولى وحدَها، أغلبُها من كبارِ السنّ.", "start": 36.91, "end": 45.92, "words": [["وتقدّرُ", 36.91, 37.58], ["دراسةٌ", 37.64, 38.13], ["في", 38.17, 38.24], ["مجلّةِ", 38.3, 38.78], ["لانسيت", 38.84, 39.21], ["أنّ", 39.29, 39.44], ["اللقاحاتِ", 39.46, 40.07], ["أنقذتْ", 40.14, 40.63], ["نحوَ", 40.67, 40.94], ["عشرينَ", 40.97, 41.39], ["مليونَ", 41.44, 41.73], ["حياةٍ", 41.78, 42.28], ["في", 42.67, 42.8], ["سنتِها", 42.88, 43.28], ["الأولى", 43.3, 43.6], ["وحدَها،", 43.66, 44.26], ["أغلبُها", 44.43, 44.94], ["من", 44.99, 45.08], ["كبارِ", 45.14, 45.44], ["السنّ.", 45.47, 45.92]]}, {"text": "وفي ذروةِ الوباء، أُغلِقتِ المدارسُ أمامَ مليارٍ وستِّمئةِ مليونِ طالب، وتوقّفتْ أغلبُ الرحلات. ومن دونِ لقاح، يطولُ هذا سنوات.", "start": 46.3, "end": 56.49, "words": [["وفي", 46.3, 46.53], ["ذروةِ", 46.6, 46.93], ["الوباء،", 46.95, 47.6], ["أُغلِقتِ", 47.73, 48.32], ["المدارسُ", 48.36, 48.95], ["أمامَ", 48.99, 49.39], ["مليارٍ", 49.42, 49.91], ["وستِّمئةِ", 49.96, 50.57], ["مليونِ", 50.62, 50.92], ["طالب،", 50.99, 51.49], ["وتوقّفتْ", 51.82, 52.64], ["أغلبُ", 52.66, 53.02], ["الرحلات.", 53.05, 53.7], ["ومن", 54.02, 54.34], ["دونِ", 54.38, 54.62], ["لقاح،", 54.67, 55.21], ["يطولُ", 55.23, 55.62], ["هذا", 55.68, 55.89], ["سنوات.", 55.92, 56.49]]}, {"text": "في النهاية، تُصيبُ العدوى الجميعَ تقريباً، فيكتسبونَ مناعة. لكنّها مناعةٌ تضعفُ مع الوقت، وثمنُها ملايينُ الأرواح.", "start": 56.87, "end": 65.48, "words": [["في", 56.87, 56.98], ["النهاية،", 57.01, 57.55], ["تُصيبُ", 57.59, 57.98], ["العدوى", 58.0, 58.36], ["الجميعَ", 58.39, 58.84], ["تقريباً،", 58.86, 59.54], ["فيكتسبونَ", 59.69, 60.52], ["مناعة.", 60.58, 61.05], ["لكنّها", 61.36, 61.81], ["مناعةٌ", 61.88, 62.4], ["تضعفُ", 62.46, 62.89], ["مع", 62.95, 63.05], ["الوقت،", 63.1, 63.6], ["وثمنُها", 63.75, 64.38], ["ملايينُ", 64.44, 64.84], ["الأرواح.", 64.86, 65.48]]}, {"text": "والعلاجُ وحدَه لا يكفي. دواءٌ قديمٌ رخيصٌ اسمُه ديكساميثازون، خفّضَ الوفيّاتِ بينَ مرضى أجهزةِ التنفّسِ بمقدارِ الثُّلث، لكنّه لا يمنعُ العدوى.", "start": 65.79, "end": 76.83, "words": [["والعلاجُ", 65.79, 66.39], ["وحدَه", 66.42, 66.72], ["لا", 66.84, 66.91], ["يكفي.", 66.97, 67.44], ["دواءٌ", 67.71, 68.1], ["قديمٌ", 68.22, 68.59], ["رخيصٌ", 68.66, 69.13], ["اسمُه", 69.18, 69.73], ["ديكساميثازون،", 69.88, 70.97], ["خفّضَ", 71.22, 71.59], ["الوفيّاتِ", 71.61, 72.27], ["بينَ", 72.33, 72.55], ["مرضى", 72.59, 72.85], ["أجهزةِ", 72.88, 73.34], ["التنفّسِ", 73.36, 73.92], ["بمقدارِ", 73.97, 74.44], ["الثُّلث،", 74.47, 75.0], ["لكنّه", 75.28, 75.69], ["لا", 75.77, 75.87], ["يمنعُ", 75.93, 76.25], ["العدوى.", 76.28, 76.83]]}, {"text": "والغريب: أنّ اللقاحَ قامَ على فكرةٍ رفضَها الجميعُ عقوداً. العالِمةُ كاتالين كاريكو خُفِّضتْ رتبتُها بسببِها، ثمّ نالتْ جائزةَ نوبل.", "start": 77.08, "end": 87.99, "words": [["والغريب:", 77.08, 77.76], ["أنّ", 78.04, 78.24], ["اللقاحَ", 78.28, 78.77], ["قامَ", 78.82, 79.08], ["على", 79.12, 79.27], ["فكرةٍ", 79.36, 79.91], ["رفضَها", 80.19, 80.67], ["الجميعُ", 80.7, 81.22], ["عقوداً.", 81.27, 81.95], ["العالِمةُ", 82.28, 82.93], ["كاتالين", 83.0, 83.43], ["كاريكو", 83.52, 83.97], ["خُفِّضتْ", 84.21, 84.78], ["رتبتُها", 84.81, 85.26], ["بسببِها،", 85.33, 86.09], ["ثمّ", 86.26, 86.53], ["نالتْ", 86.58, 86.98], ["جائزةَ", 87.08, 87.53], ["نوبل.", 87.58, 87.99]]}, {"text": "واليومَ، تُجرَّبُ التقنيةُ نفسُها ضدَّ السرطان.", "start": 88.36, "end": 91.95, "words": [["واليومَ،", 88.36, 88.99], ["تُجرَّبُ", 89.15, 89.71], ["التقنيةُ", 89.73, 90.31], ["نفسُها", 90.37, 90.87], ["ضدَّ", 90.99, 91.27], ["السرطان.", 91.29, 91.95]]}, {"text": "برأيك، ما الاكتشافُ الذي غيّرَ العالمَ أكثر؟ اكتبْ في التعليقات، واشتركْ.", "start": 92.28, "end": 97.9, "words": [["برأيك،", 92.28, 92.71], ["ما", 92.73, 92.81], ["الاكتشافُ", 92.85, 93.48], ["الذي", 93.51, 93.8], ["غيّرَ", 93.89, 94.2], ["العالمَ", 94.24, 94.63], ["أكثر؟", 94.66, 95.1], ["اكتبْ", 95.54, 95.99], ["في", 96.02, 96.08], ["التعليقات،", 96.13, 96.98], ["واشتركْ.", 97.05, 97.9]]}]