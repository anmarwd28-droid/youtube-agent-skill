[{"text": "تخيّلْ أن تستيقظَ صباحاً… فترى بغدادَ بيضاء.", "start": 0.0, "end": 3.46, "words": [["تخيّلْ", 0.0, 0.5], ["أن", 0.52, 0.6], ["تستيقظَ", 0.66, 1.16], ["صباحاً…", 1.23, 1.86], ["فترى", 2.15, 2.48], ["بغدادَ", 2.54, 2.93], ["بيضاء.", 2.97, 3.46]]}, {"text": "والثلجُ لا يتوقّف. يتساقطُ يوماً بعدَ يوم… لسنةٍ كاملة.", "start": 3.75, "end": 8.22, "words": [["والثلجُ", 3.75, 4.17], ["لا", 4.21, 4.27], ["يتوقّف.", 4.33, 4.99], ["يتساقطُ", 5.29, 5.92], ["يوماً", 5.98, 6.26], ["بعدَ", 6.3, 6.49], ["يوم…", 6.55, 6.92], ["لسنةٍ", 7.21, 7.69], ["كاملة.", 7.75, 8.22]]}, {"text": "فماذا لو… بقيتِ الثلوجُ تتساقطُ لمدّةِ سنة؟", "start": 8.51, "end": 12.19, "words": [["فماذا", 8.51, 8.88], ["لو…", 8.92, 9.29], ["بقيتِ", 9.69, 10.11], ["الثلوجُ", 10.14, 10.61], ["تتساقطُ", 10.67, 11.29], ["لمدّةِ", 11.33, 11.75], ["سنة؟", 11.82, 12.19]]}, {"text": "قد يبدو هذا مستحيلاً، لكنّ بغدادَ رأتِ الثلجَ فعلاً، في عامِ ألفينِ وثمانية، لأوّلِ مرّةٍ منذُ نحوِ مئةِ عام.", "start": 12.43, "end": 20.7, "words": [["قد", 12.43, 12.6], ["يبدو", 12.63, 12.79], ["هذا", 12.83, 12.97], ["مستحيلاً،", 13.02, 13.7], ["لكنّ", 14.05, 14.4], ["بغدادَ", 14.44, 14.91], ["رأتِ", 15.01, 15.27], ["الثلجَ", 15.29, 15.59], ["فعلاً،", 15.66, 16.15], ["في", 16.29, 16.38], ["عامِ", 16.49, 16.7], ["ألفينِ", 16.74, 17.17], ["وثمانية،", 17.23, 17.97], ["لأوّلِ", 18.17, 18.63], ["مرّةٍ", 18.69, 19.19], ["منذُ", 19.41, 19.67], ["نحوِ", 19.73, 19.96], ["مئةِ", 19.98, 20.29], ["عام.", 20.39, 20.7]]}, {"text": "لكنّه ذابَ في ساعات. فماذا لو لم يذُب؟", "start": 21.01, "end": 23.93, "words": [["لكنّه", 21.01, 21.42], ["ذابَ", 21.51, 21.7], ["في", 21.75, 21.83], ["ساعات.", 21.9, 22.41], ["فماذا", 22.67, 23.06], ["لو", 23.11, 23.24], ["لم", 23.29, 23.38], ["يذُب؟", 23.45, 23.93]]}, {"text": "في اليومِ الأوّل، تبدو المدينةُ كلوحةٍ جميلة.", "start": 24.24, "end": 27.27, "words": [["في", 24.24, 24.35], ["اليومِ", 24.37, 24.62], ["الأوّل،", 24.65, 25.14], ["تبدو", 25.27, 25.52], ["المدينةُ", 25.54, 26.09], ["كلوحةٍ", 26.16, 26.64], ["جميلة.", 26.73, 27.27]]}, {"text": "الأطفالُ يخرجونَ للّعب، والناسُ يلتقطونَ الصور، والنخيلُ يلبسُ ثوباً أبيض.", "start": 27.6, "end": 33.08, "words": [["الأطفالُ", 27.6, 28.06], ["يخرجونَ", 28.1, 28.59], ["للّعب،", 28.64, 29.27], ["والناسُ", 29.43, 29.8], ["يلتقطونَ", 29.84, 30.38], ["الصور،", 30.41, 30.95], ["والنخيلُ", 31.18, 31.78], ["يلبسُ", 31.83, 32.24], ["ثوباً", 32.31, 32.6], ["أبيض.", 32.62, 33.08]]}, {"text": "لكنّ الحرارةَ تنخفضُ تحتَ الصفر، والماءُ في الأنابيبِ يبدأُ بالتجمّد.", "start": 33.34, "end": 38.55, "words": [["لكنّ", 33.34, 33.72], ["الحرارةَ", 33.75, 34.35], ["تنخفضُ", 34.4, 34.98], ["تحتَ", 35.04, 35.28], ["الصفر،", 35.31, 35.85], ["والماءُ", 36.09, 36.47], ["في", 36.5, 36.56], ["الأنابيبِ", 36.58, 37.22], ["يبدأُ", 37.47, 37.81], ["بالتجمّد.", 37.86, 38.55]]}, {"text": "لكنّ الثلجَ يستمرّ.", "start": 38.87, "end": 40.2, "words": [["لكنّ", 38.87, 39.23], ["الثلجَ", 39.25, 39.58], ["يستمرّ.", 39.6, 40.2]]}, {"text": "بعدَ أسبوع، قد يتجاوزُ ارتفاعُه المترَ في بعضِ الأماكن.", "start": 40.53, "end": 44.44, "words": [["بعدَ", 40.53, 40.78], ["أسبوع،", 40.82, 41.38], ["قد", 41.46, 41.66], ["يتجاوزُ", 41.71, 42.31], ["ارتفاعُه", 42.33, 42.9], ["المترَ", 42.96, 43.35], ["في", 43.41, 43.49], ["بعضِ", 43.55, 43.78], ["الأماكن.", 43.8, 44.44]]}, {"text": "الطرقُ تُغلق، والمدارسُ تتوقّف، والسيّاراتُ تختفي تحتَ البياض.", "start": 44.72, "end": 49.71, "words": [["الطرقُ", 44.72, 45.31], ["تُغلق،", 45.39, 46.01], ["والمدارسُ", 46.18, 46.8], ["تتوقّف،", 46.85, 47.58], ["والسيّاراتُ", 47.75, 48.41], ["تختفي", 48.47, 48.83], ["تحتَ", 48.9, 49.12], ["البياض.", 49.16, 49.71]]}, {"text": "وأسلاكُ الكهرباء تثقلُ بالجليد… وقد تنقطعُ الكهرباءُ عن أحياءٍ كاملة.", "start": 50.04, "end": 55.75, "words": [["وأسلاكُ", 50.04, 50.55], ["الكهرباء", 50.58, 51.21], ["تثقلُ", 51.28, 51.83], ["بالجليد…", 51.87, 52.56], ["وقد", 52.8, 53.12], ["تنقطعُ", 53.16, 53.73], ["الكهرباءُ", 53.75, 54.45], ["عن", 54.51, 54.65], ["أحياءٍ", 54.68, 55.17], ["كاملة.", 55.24, 55.75]]}, {"text": "والمستشفياتُ والأفرانُ تعملُ بصعوبة، والناسُ يشعلونَ النارَ للتدفئة.", "start": 56.08, "end": 60.7, "words": [["والمستشفياتُ", 56.08, 56.85], ["والأفرانُ", 56.89, 57.43], ["تعملُ", 57.49, 57.8], ["بصعوبة،", 57.85, 58.5], ["والناسُ", 58.68, 59.07], ["يشعلونَ", 59.12, 59.65], ["النارَ", 59.67, 59.98], ["للتدفئة.", 60.01, 60.7]]}, {"text": "والمشكلةُ الأخطرُ فوقَ رؤوسِنا: السطوح.", "start": 61.02, "end": 64.16, "words": [["والمشكلةُ", 61.02, 61.65], ["الأخطرُ", 61.68, 62.16], ["فوقَ", 62.19, 62.45], ["رؤوسِنا:", 62.5, 63.11], ["السطوح.", 63.39, 64.16]]}, {"text": "مترٌ واحدٌ من الثلجِ الرطب، قد يزنُ مئاتِ الكيلوغرامات على كلِّ مترٍ مربّع.", "start": 64.54, "end": 69.8, "words": [["مترٌ", 64.54, 64.89], ["واحدٌ", 64.94, 65.29], ["من", 65.33, 65.43], ["الثلجِ", 65.48, 65.84], ["الرطب،", 65.86, 66.4], ["قد", 66.61, 66.78], ["يزنُ", 66.85, 67.16], ["مئاتِ", 67.21, 67.56], ["الكيلوغرامات", 67.58, 68.29], ["على", 68.37, 68.5], ["كلِّ", 68.58, 68.82], ["مترٍ", 68.85, 69.14], ["مربّع.", 69.16, 69.8]]}, {"text": "وبيوتُنا في المناطقِ الحارّة، لم تُبنَ لتحملَ هذا الوزن.", "start": 70.08, "end": 74.07, "words": [["وبيوتُنا", 70.08, 70.76], ["في", 70.82, 70.88], ["المناطقِ", 70.9, 71.38], ["الحارّة،", 71.4, 72.09], ["لم", 72.26, 72.43], ["تُبنَ", 72.5, 72.76], ["لتحملَ", 72.81, 73.29], ["هذا", 73.34, 73.51], ["الوزن.", 73.54, 74.07]]}, {"text": "بعدَ شهر، يصلُ الثلجُ إلى الطابقِ الأوّل.", "start": 74.51, "end": 77.18, "words": [["بعدَ", 74.51, 74.76], ["شهر،", 74.84, 75.15], ["يصلُ", 75.19, 75.57], ["الثلجُ", 75.59, 76.0], ["إلى", 76.02, 76.11], ["الطابقِ", 76.15, 76.59], ["الأوّل.", 76.61, 77.18]]}, {"text": "يخرجُ الناسُ من النوافذِ بدلَ الأبواب، والطعامُ لا يصلُ إلى الأسواق.", "start": 77.51, "end": 82.15, "words": [["يخرجُ", 77.51, 77.98], ["الناسُ", 78.01, 78.34], ["من", 78.38, 78.49], ["النوافذِ", 78.54, 79.11], ["بدلَ", 79.16, 79.4], ["الأبواب،", 79.44, 80.16], ["والطعامُ", 80.4, 80.92], ["لا", 80.97, 81.03], ["يصلُ", 81.08, 81.41], ["إلى", 81.43, 81.51], ["الأسواق.", 81.55, 82.15]]}, {"text": "والمزارعُ تختفي تحتَ الثلج، فلا زراعةَ ولا حصاد.", "start": 82.48, "end": 86.66, "words": [["والمزارعُ", 82.48, 83.1], ["تختفي", 83.16, 83.52], ["تحتَ", 83.59, 83.81], ["الثلج،", 83.85, 84.4], ["فلا", 84.61, 84.84], ["زراعةَ", 84.92, 85.56], ["ولا", 85.72, 85.95], ["حصاد.", 86.01, 86.66]]}, {"text": "والحيواناتُ تبحثُ عن طعامٍ فلا تجد، والطيورُ تهاجرُ إن استطاعت.", "start": 86.94, "end": 91.72, "words": [["والحيواناتُ", 86.94, 87.7], ["تبحثُ", 87.77, 88.14], ["عن", 88.19, 88.28], ["طعامٍ", 88.35, 88.72], ["فلا", 88.78, 88.95], ["تجد،", 89.01, 89.54], ["والطيورُ", 89.75, 90.29], ["تهاجرُ", 90.36, 90.87], ["إن", 90.93, 91.01], ["استطاعت.", 91.05, 91.72]]}, {"text": "والسماءُ لا تصفو أبداً… فالغيومُ التي تصنعُ الثلج، تحجبُ الشمسَ أيضاً.", "start": 92.04, "end": 97.41, "words": [["والسماءُ", 92.04, 92.64], ["لا", 92.68, 92.75], ["تصفو", 92.81, 93.14], ["أبداً…", 93.16, 93.7], ["فالغيومُ", 93.98, 94.58], ["التي", 94.6, 94.83], ["تصنعُ", 94.9, 95.27], ["الثلج،", 95.29, 95.9], ["تحجبُ", 96.11, 96.51], ["الشمسَ", 96.54, 96.92], ["أيضاً.", 96.94, 97.41]]}, {"text": "وهنا تبدأُ حلقةٌ خطيرة.", "start": 97.73, "end": 99.53, "words": [["وهنا", 97.73, 98.06], ["تبدأُ", 98.12, 98.44], ["حلقةٌ", 98.5, 98.91], ["خطيرة.", 98.97, 99.53]]}, {"text": "الثلجُ الأبيضُ يعكسُ ضوءَ الشمس. والثلجُ الطازجُ قد يعكسُ نحوَ تسعينَ في المئةِ منه.", "start": 99.86, "end": 105.45, "words": [["الثلجُ", 99.86, 100.26], ["الأبيضُ", 100.29, 100.72], ["يعكسُ", 100.76, 101.12], ["ضوءَ", 101.17, 101.39], ["الشمس.", 101.41, 102.02], ["والثلجُ", 102.3, 102.74], ["الطازجُ", 102.76, 103.28], ["قد", 103.33, 103.48], ["يعكسُ", 103.53, 103.85], ["نحوَ", 103.91, 104.14], ["تسعينَ", 104.19, 104.59], ["في", 104.64, 104.71], ["المئةِ", 104.73, 105.08], ["منه.", 105.13, 105.45]]}, {"text": "تماماً كما تشعرُ بالحرّ إذا لبستَ ملابسَ سوداءَ في الصيف… أمّا البيضاءُ فتعكسُه.", "start": 105.84, "end": 111.9, "words": [["تماماً", 105.84, 106.28], ["كما", 106.33, 106.53], ["تشعرُ", 106.6, 106.94], ["بالحرّ", 106.98, 107.57], ["إذا", 107.84, 108.08], ["لبستَ", 108.14, 108.47], ["ملابسَ", 108.53, 108.91], ["سوداءَ", 108.94, 109.27], ["في", 109.31, 109.38], ["الصيف…", 109.4, 109.95], ["أمّا", 110.32, 110.56], ["البيضاءُ", 110.58, 111.11], ["فتعكسُه.", 111.14, 111.9]]}, {"text": "فتبردُ الأرضُ أكثر… فيتساقطُ ثلجٌ أكثر… فتبردُ أكثر.", "start": 112.16, "end": 116.89, "words": [["فتبردُ", 112.16, 112.79], ["الأرضُ", 112.83, 113.17], ["أكثر…", 113.22, 113.72], ["فيتساقطُ", 113.95, 114.65], ["ثلجٌ", 114.72, 115.04], ["أكثر…", 115.08, 115.58], ["فتبردُ", 115.84, 116.4], ["أكثر.", 116.45, 116.89]]}, {"text": "ولكي يتساقطَ كلُّ هذا الثلج، يجبُ أن يتبخّرَ الماءُ أوّلاً من البحار.", "start": 117.2, "end": 122.39, "words": [["ولكي", 117.2, 117.61], ["يتساقطَ", 117.64, 118.44], ["كلُّ", 118.51, 118.8], ["هذا", 118.84, 119.05], ["الثلج،", 119.07, 119.65], ["يجبُ", 119.88, 120.24], ["أن", 120.29, 120.37], ["يتبخّرَ", 120.42, 120.94], ["الماءُ", 120.96, 121.24], ["أوّلاً", 121.29, 121.65], ["من", 121.68, 121.79], ["البحار.", 121.83, 122.39]]}, {"text": "فإذا تساقطَ ثلجاً ولم يعُد إليها، يبدأُ مستوى البحارِ بالانخفاض.", "start": 122.66, "end": 127.36, "words": [["فإذا", 122.66, 122.96], ["تساقطَ", 123.02, 123.52], ["ثلجاً", 123.59, 124.01], ["ولم", 124.08, 124.32], ["يعُد", 124.38, 124.61], ["إليها،", 124.63, 125.14], ["يبدأُ", 125.38, 125.76], ["مستوى", 125.81, 126.13], ["البحارِ", 126.15, 126.57], ["بالانخفاض.", 126.61, 127.36]]}, {"text": "بعدَ ستّةِ أشهر، يحدثُ شيءٌ في الطبقاتِ السفلى من الثلج.", "start": 127.79, "end": 131.84, "words": [["بعدَ", 127.79, 128.05], ["ستّةِ", 128.12, 128.49], ["أشهر،", 128.56, 129.06], ["يحدثُ", 129.23, 129.68], ["شيءٌ", 129.76, 130.1], ["في", 130.16, 130.21], ["الطبقاتِ", 130.24, 130.77], ["السفلى", 130.8, 131.12], ["من", 131.17, 131.27], ["الثلج.", 131.33, 131.84]]}, {"text": "وزنُ الثلجِ فوقَها يضغطُها… فتتحوّلُ ببطءٍ إلى جليدٍ صلب.", "start": 132.23, "end": 136.93, "words": [["وزنُ", 132.23, 132.55], ["الثلجِ", 132.59, 132.95], ["فوقَها", 133.0, 133.46], ["يضغطُها…", 133.51, 134.27], ["فتتحوّلُ", 134.54, 135.35], ["ببطءٍ", 135.4, 135.81], ["إلى", 135.88, 136.02], ["جليدٍ", 136.1, 136.44], ["صلب.", 136.53, 136.93]]}, {"text": "هكذا بالضبط، تتكوّنُ الأنهارُ الجليديةُ في القطبين.", "start": 137.36, "end": 141.12, "words": [["هكذا", 137.36, 137.75], ["بالضبط،", 137.8, 138.36], ["تتكوّنُ", 138.5, 139.16], ["الأنهارُ", 139.18, 139.63], ["الجليديةُ", 139.66, 140.28], ["في", 140.35, 140.4], ["القطبين.", 140.43, 141.12]]}, {"text": "وبعدَ سنة، تصبحُ المدينةُ تحتَ عشراتِ الأمتار.", "start": 141.49, "end": 145.08, "words": [["وبعدَ", 141.49, 141.87], ["سنة،", 141.94, 142.34], ["تصبحُ", 142.51, 143.02], ["المدينةُ", 143.06, 143.65], ["تحتَ", 143.72, 144.0], ["عشراتِ", 144.04, 144.49], ["الأمتار.", 144.51, 145.08]]}, {"text": "لا تظهرُ إلا قممُ المآذنِ والأبراج… فوقَ بحرٍ أبيضَ صامت.", "start": 145.39, "end": 149.9, "words": [["لا", 145.39, 145.51], ["تظهرُ", 145.57, 145.96], ["إلا", 146.02, 146.24], ["قممُ", 146.32, 146.65], ["المآذنِ", 146.67, 147.19], ["والأبراج…", 147.24, 148.01], ["فوقَ", 148.21, 148.55], ["بحرٍ", 148.6, 148.92], ["أبيضَ", 148.99, 149.34], ["صامت.", 149.42, 149.9]]}, {"text": "وإذا لم يذُب هذا الجليدُ في الصيف، يبدأُ ما يسمّيهِ العلماءُ عصراً جليدياً.", "start": 150.2, "end": 155.33, "words": [["وإذا", 150.2, 150.51], ["لم", 150.53, 150.67], ["يذُب", 150.73, 151.03], ["هذا", 151.12, 151.3], ["الجليدُ", 151.32, 151.72], ["في", 151.76, 151.82], ["الصيف،", 151.86, 152.36], ["يبدأُ", 152.67, 153.05], ["ما", 153.11, 153.18], ["يسمّيهِ", 153.24, 153.76], ["العلماءُ", 153.78, 154.31], ["عصراً", 154.33, 154.67], ["جليدياً.", 154.7, 155.33]]}, {"text": "وهذا ليسَ خيالاً بالكامل.", "start": 155.63, "end": 157.26, "words": [["وهذا", 155.63, 156.0], ["ليسَ", 156.05, 156.27], ["خيالاً", 156.33, 156.68], ["بالكامل.", 156.7, 157.26]]}, {"text": "قبلَ نحوِ سبعمئةِ مليونِ سنة، تجمّدتِ الأرضُ كلُّها تقريباً، وصارتْ كرةً من الثلج.", "start": 157.57, "end": 163.78, "words": [["قبلَ", 157.57, 157.83], ["نحوِ", 157.87, 158.12], ["سبعمئةِ", 158.19, 158.88], ["مليونِ", 158.94, 159.25], ["سنة،", 159.32, 159.78], ["تجمّدتِ", 159.97, 160.61], ["الأرضُ", 160.65, 161.0], ["كلُّها", 161.05, 161.4], ["تقريباً،", 161.46, 162.12], ["وصارتْ", 162.3, 162.76], ["كرةً", 162.79, 163.12], ["من", 163.13, 163.24], ["الثلج.", 163.28, 163.78]]}, {"text": "ومعَ ذلك، نجتِ الحياة… في المحيطات، وقربَ البراكين.", "start": 164.07, "end": 168.61, "words": [["ومعَ", 164.07, 164.44], ["ذلك،", 164.49, 164.97], ["نجتِ", 165.11, 165.37], ["الحياة…", 165.41, 166.02], ["في", 166.42, 166.51], ["المحيطات،", 166.56, 167.43], ["وقربَ", 167.53, 167.93], ["البراكين.", 167.95, 168.61]]}, {"text": "ويعتقدُ العلماءُ أنّ البراكينَ هي التي أنقذتِ الأرض، حينَ ملأتِ الجوَّ بثاني أكسيدِ الكربون، فدفّأتْها من جديد.", "start": 168.9, "end": 176.81, "words": [["ويعتقدُ", 168.9, 169.56], ["العلماءُ", 169.59, 170.14], ["أنّ", 170.18, 170.31], ["البراكينَ", 170.34, 170.85], ["هي", 170.89, 171.04], ["التي", 171.06, 171.28], ["أنقذتِ", 171.35, 171.77], ["الأرض،", 171.8, 172.29], ["حينَ", 172.44, 172.69], ["ملأتِ", 172.72, 173.02], ["الجوَّ", 173.06, 173.57], ["بثاني", 173.82, 174.2], ["أكسيدِ", 174.23, 174.57], ["الكربون،", 174.59, 175.26], ["فدفّأتْها", 175.43, 176.13], ["من", 176.17, 176.25], ["جديد.", 176.31, 176.81]]}, {"text": "لكن… هل يمكنُ أن يحدثَ هذا في بغدادَ حقّاً؟", "start": 177.16, "end": 180.6, "words": [["لكن…", 177.16, 177.77], ["هل", 178.06, 178.22], ["يمكنُ", 178.26, 178.57], ["أن", 178.62, 178.71], ["يحدثَ", 178.77, 179.19], ["هذا", 179.25, 179.49], ["في", 179.55, 179.62], ["بغدادَ", 179.68, 180.04], ["حقّاً؟", 180.08, 180.6]]}, {"text": "لا. فالثلجُ يحتاجُ برداً طويلاً ورطوبةً كبيرة، وشمسُ بغدادَ لا تسمحُ بذلك.", "start": 180.83, "end": 187.33, "words": [["لا.", 180.83, 181.17], ["فالثلجُ", 181.48, 182.06], ["يحتاجُ", 182.13, 182.56], ["برداً", 182.61, 182.94], ["طويلاً", 183.0, 183.52], ["ورطوبةً", 183.68, 184.35], ["كبيرة،", 184.43, 185.05], ["وشمسُ", 185.27, 185.74], ["بغدادَ", 185.78, 186.2], ["لا", 186.25, 186.33], ["تسمحُ", 186.36, 186.75], ["بذلك.", 186.78, 187.33]]}, {"text": "لكنّ أماكنَ أخرى على الأرض تقتربُ من هذا الخيال.", "start": 187.62, "end": 190.94, "words": [["لكنّ", 187.62, 188.0], ["أماكنَ", 188.05, 188.47], ["أخرى", 188.5, 188.78], ["على", 188.82, 188.95], ["الأرض", 188.98, 189.28], ["تقتربُ", 189.53, 190.03], ["من", 190.09, 190.17], ["هذا", 190.22, 190.39], ["الخيال.", 190.42, 190.94]]}, {"text": "في جبلِ بيكر بأمريكا، تساقطَ في موسمٍ واحدٍ نحوُ تسعةٍ وعشرينَ متراً من الثلج.", "start": 191.3, "end": 196.78, "words": [["في", 191.3, 191.4], ["جبلِ", 191.51, 191.8], ["بيكر", 191.85, 192.1], ["بأمريكا،", 192.16, 192.78], ["تساقطَ", 192.92, 193.43], ["في", 193.49, 193.56], ["موسمٍ", 193.63, 194.01], ["واحدٍ", 194.08, 194.51], ["نحوُ", 194.57, 194.83], ["تسعةٍ", 194.86, 195.28], ["وعشرينَ", 195.36, 195.79], ["متراً", 195.85, 196.12], ["من", 196.13, 196.24], ["الثلج.", 196.29, 196.78]]}, {"text": "أي ما يعادلُ بنايةً من عشرةِ طوابق.", "start": 197.08, "end": 199.92, "words": [["أي", 197.08, 197.25], ["ما", 197.28, 197.35], ["يعادلُ", 197.41, 197.86], ["بنايةً", 197.92, 198.45], ["من", 198.68, 198.82], ["عشرةِ", 198.88, 199.33], ["طوابق.", 199.39, 199.92]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 200.31, "end": 205.88, "words": [["والآن", 200.31, 200.6], ["دورُك:", 200.64, 201.11], ["ماذا", 201.32, 201.56], ["لو…؟", 201.6, 202.12], ["اكتبْ", 202.5, 202.92], ["سؤالَك", 202.94, 203.28], ["في", 203.33, 203.37], ["التعليقات،", 203.41, 204.24], ["وقد", 204.34, 204.64], ["يكونُ", 204.7, 204.99], ["الفيديو", 205.01, 205.3], ["القادم.", 205.32, 205.88]]}, {"text": "واشتركْ في «ماذا لو؟ Lab»… حتى لا يفوتَك السؤالُ القادم.", "start": 206.16, "end": 210.75, "words": [["واشتركْ", 206.16, 206.7], ["في", 206.74, 206.81], ["«ماذا", 206.84, 207.11], ["لو؟", 207.16, 207.56], ["Lab»…", 207.74, 208.37], ["حتى", 208.64, 208.99], ["لا", 209.05, 209.12], ["يفوتَك", 209.18, 209.55], ["السؤالُ", 209.62, 209.98], ["القادم.", 210.0, 210.75]]}]