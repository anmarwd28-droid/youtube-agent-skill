[{"text": "تخيّلْ أن تستيقظَ صباحاً… فترى العالمَ كلَّه أبيض.", "start": 0.0, "end": 3.9, "words": [["تخيّلْ", 0.0, 0.48], ["أن", 0.5, 0.56], ["تستيقظَ", 0.6, 1.14], ["صباحاً…", 1.22, 1.9], ["فترى", 2.12, 2.48], ["العالمَ", 2.51, 2.94], ["كلَّه", 2.98, 3.3], ["أبيض.", 3.38, 3.9]]}, {"text": "من القاهرةِ إلى بغداد، ومن الهندِ إلى البرازيل… الثلجُ يتساقطُ في كلِّ مكان.", "start": 4.09, "end": 9.97, "words": [["من", 4.09, 4.23], ["القاهرةِ", 4.28, 4.88], ["إلى", 4.92, 5.04], ["بغداد،", 5.11, 5.75], ["ومن", 5.91, 6.2], ["الهندِ", 6.27, 6.62], ["إلى", 6.64, 6.73], ["البرازيل…", 6.77, 7.59], ["الثلجُ", 7.88, 8.36], ["يتساقطُ", 8.39, 8.99], ["في", 9.04, 9.1], ["كلِّ", 9.18, 9.39], ["مكان.", 9.43, 9.97]]}, {"text": "ولا يتوقّف. يوماً بعدَ يوم… لسنةٍ كاملة.", "start": 10.19, "end": 13.97, "words": [["ولا", 10.19, 10.43], ["يتوقّف.", 10.47, 11.2], ["يوماً", 11.49, 11.85], ["بعدَ", 11.9, 12.12], ["يوم…", 12.18, 12.65], ["لسنةٍ", 12.91, 13.39], ["كاملة.", 13.46, 13.97]]}, {"text": "فماذا لو… بقيتِ الثلوجُ تتساقطُ على الأرضِ كلِّها لمدّةِ سنة؟", "start": 14.26, "end": 19.14, "words": [["فماذا", 14.26, 14.73], ["لو…", 14.78, 15.22], ["بقيتِ", 15.57, 16.01], ["الثلوجُ", 16.03, 16.52], ["تتساقطُ", 16.59, 17.23], ["على", 17.3, 17.43], ["الأرضِ", 17.46, 17.77], ["كلِّها", 17.84, 18.17], ["لمدّةِ", 18.22, 18.63], ["سنة؟", 18.69, 19.14]]}, {"text": "في اليومِ الأوّل، يبدو الأمرُ كحلمٍ جميل.", "start": 19.49, "end": 22.33, "words": [["في", 19.49, 19.59], ["اليومِ", 19.61, 19.89], ["الأوّل،", 19.9, 20.46], ["يبدو", 20.64, 20.9], ["الأمرُ", 20.92, 21.27], ["كحلمٍ", 21.32, 21.73], ["جميل.", 21.8, 22.33]]}, {"text": "الصحراءُ الكبرى تصبحُ بيضاء، والنخيلُ والغاباتُ الاستوائية تلبسُ ثوباً أبيض.", "start": 22.64, "end": 28.28, "words": [["الصحراءُ", 22.64, 23.34], ["الكبرى", 23.36, 23.8], ["تصبحُ", 23.86, 24.28], ["بيضاء،", 24.32, 24.94], ["والنخيلُ", 25.15, 25.65], ["والغاباتُ", 25.68, 26.23], ["الاستوائية", 26.25, 26.96], ["تلبسُ", 26.98, 27.39], ["ثوباً", 27.46, 27.78], ["أبيض.", 27.81, 28.28]]}, {"text": "لكنّ أكثرَ مدنِ العالم لم تُبنَ للثلج. فلا كاسحات، ولا تدفئةَ كافية.", "start": 28.65, "end": 34.54, "words": [["لكنّ", 28.65, 29.01], ["أكثرَ", 29.06, 29.42], ["مدنِ", 29.48, 29.76], ["العالم", 29.78, 30.2], ["لم", 30.31, 30.49], ["تُبنَ", 30.58, 30.84], ["للثلج.", 30.88, 31.5], ["فلا", 31.82, 32.04], ["كاسحات،", 32.1, 32.88], ["ولا", 33.08, 33.34], ["تدفئةَ", 33.41, 33.92], ["كافية.", 33.99, 34.54]]}, {"text": "بعدَ أسبوع، تتوقّفُ حركةُ العالم.", "start": 34.91, "end": 37.22, "words": [["بعدَ", 34.91, 35.16], ["أسبوع،", 35.18, 35.62], ["تتوقّفُ", 35.64, 36.19], ["حركةُ", 36.26, 36.64], ["العالم.", 36.66, 37.22]]}, {"text": "المطاراتُ تُغلق، والطرقُ تُقطع، والسفنُ تعلقُ في الموانئ.", "start": 37.53, "end": 42.01, "words": [["المطاراتُ", 37.53, 38.13], ["تُغلق،", 38.19, 38.74], ["والطرقُ", 38.81, 39.29], ["تُقطع،", 39.35, 39.96], ["والسفنُ", 40.16, 40.68], ["تعلقُ", 40.74, 41.15], ["في", 41.2, 41.26], ["الموانئ.", 41.3, 42.01]]}, {"text": "وأسلاكُ الكهرباء تثقلُ بالجليد، فتنطفئُ مدنٌ كاملة.", "start": 42.24, "end": 47.03, "words": [["وأسلاكُ", 42.24, 42.79], ["الكهرباء", 42.82, 43.49], ["تثقلُ", 43.65, 44.19], ["بالجليد،", 44.25, 45.02], ["فتنطفئُ", 45.2, 46.0], ["مدنٌ", 46.07, 46.41], ["كاملة.", 46.5, 47.03]]}, {"text": "والسطوحُ في البلادِ الحارّة، لا تحتملُ مئاتِ الكيلوغرامات من الثلجِ على كلِّ مترٍ مربّع.", "start": 47.34, "end": 53.51, "words": [["والسطوحُ", 47.34, 47.91], ["في", 47.96, 48.02], ["البلادِ", 48.05, 48.42], ["الحارّة،", 48.45, 49.08], ["لا", 49.24, 49.37], ["تحتملُ", 49.42, 49.93], ["مئاتِ", 49.99, 50.33], ["الكيلوغرامات", 50.35, 51.04], ["من", 51.09, 51.2], ["الثلجِ", 51.26, 51.76], ["على", 52.0, 52.23], ["كلِّ", 52.3, 52.52], ["مترٍ", 52.55, 52.86], ["مربّع.", 52.9, 53.51]]}, {"text": "بعدَ شهر، تأتي المشكلةُ الأكبر: الطعام.", "start": 53.78, "end": 56.73, "words": [["بعدَ", 53.78, 54.02], ["شهر،", 54.1, 54.37], ["تأتي", 54.4, 54.64], ["المشكلةُ", 54.66, 55.16], ["الأكبر:", 55.18, 55.79], ["الطعام.", 55.98, 56.73]]}, {"text": "فالقمحُ والأرزُّ والذرة… تموتُ تحتَ الثلج.", "start": 56.96, "end": 60.36, "words": [["فالقمحُ", 56.96, 57.57], ["والأرزُّ", 57.6, 58.18], ["والذرة…", 58.21, 58.82], ["تموتُ", 59.05, 59.45], ["تحتَ", 59.51, 59.74], ["الثلج.", 59.77, 60.36]]}, {"text": "ومخزونُ الحبوبِ في العالم، لا يكفي إلا لأشهرٍ قليلة.", "start": 60.56, "end": 64.1, "words": [["ومخزونُ", 60.56, 61.16], ["الحبوبِ", 61.2, 61.6], ["في", 61.64, 61.7], ["العالم،", 61.73, 62.28], ["لا", 62.43, 62.54], ["يكفي", 62.6, 62.84], ["إلا", 62.91, 63.09], ["لأشهرٍ", 63.13, 63.52], ["قليلة.", 63.6, 64.1]]}, {"text": "والغاباتُ الاستوائية لا تتحمّلُ الصقيع، فتموتُ أشجارُها وحيواناتُها.", "start": 64.4, "end": 69.46, "words": [["والغاباتُ", 64.4, 64.99], ["الاستوائية", 65.02, 65.67], ["لا", 65.71, 65.78], ["تتحمّلُ", 65.84, 66.34], ["الصقيع،", 66.36, 67.08], ["فتموتُ", 67.31, 67.84], ["أشجارُها", 67.88, 68.48], ["وحيواناتُها.", 68.53, 69.46]]}, {"text": "والسماءُ لا تصفو أبداً… فالغيومُ التي تصنعُ الثلج، تحجبُ الشمسَ أيضاً.", "start": 69.69, "end": 74.73, "words": [["والسماءُ", 69.69, 70.26], ["لا", 70.32, 70.39], ["تصفو", 70.46, 70.76], ["أبداً…", 70.79, 71.31], ["فالغيومُ", 71.51, 72.04], ["التي", 72.06, 72.28], ["تصنعُ", 72.34, 72.71], ["الثلج،", 72.74, 73.33], ["تحجبُ", 73.49, 73.87], ["الشمسَ", 73.9, 74.26], ["أيضاً.", 74.28, 74.73]]}, {"text": "وهنا تبدأُ حلقةٌ خطيرة.", "start": 75.06, "end": 77.15, "words": [["وهنا", 75.06, 75.5], ["تبدأُ", 75.58, 75.93], ["حلقةٌ", 76.01, 76.46], ["خطيرة.", 76.53, 77.15]]}, {"text": "الثلجُ الطازجُ يعكسُ نحوَ تسعينَ في المئةِ من ضوءِ الشمس.", "start": 77.47, "end": 81.15, "words": [["الثلجُ", 77.47, 77.88], ["الطازجُ", 77.9, 78.46], ["يعكسُ", 78.55, 79.01], ["نحوَ", 79.06, 79.3], ["تسعينَ", 79.33, 79.73], ["في", 79.78, 79.84], ["المئةِ", 79.88, 80.24], ["من", 80.28, 80.33], ["ضوءِ", 80.38, 80.57], ["الشمس.", 80.6, 81.15]]}, {"text": "فتبردُ الأرضُ أكثر… فيتساقطُ ثلجٌ أكثر… فتبردُ أكثر.", "start": 81.48, "end": 86.39, "words": [["فتبردُ", 81.48, 82.04], ["الأرضُ", 82.07, 82.43], ["أكثر…", 82.48, 83.07], ["فيتساقطُ", 83.35, 84.05], ["ثلجٌ", 84.1, 84.39], ["أكثر…", 84.44, 85.0], ["فتبردُ", 85.28, 85.82], ["أكثر.", 85.87, 86.39]]}, {"text": "ولكي يتساقطَ كلُّ هذا الثلج، يجبُ أن يتبخّرَ الماءُ أوّلاً من البحار.", "start": 86.7, "end": 91.87, "words": [["ولكي", 86.7, 87.09], ["يتساقطَ", 87.11, 87.78], ["كلُّ", 87.84, 88.1], ["هذا", 88.13, 88.33], ["الثلج،", 88.36, 88.99], ["يجبُ", 89.19, 89.55], ["أن", 89.59, 89.67], ["يتبخّرَ", 89.73, 90.31], ["الماءُ", 90.34, 90.66], ["أوّلاً", 90.71, 91.09], ["من", 91.13, 91.23], ["البحار.", 91.28, 91.87]]}, {"text": "فإذا لم يعُد إليها، ينخفضُ مستوى البحارِ في العالمِ كلِّه.", "start": 92.25, "end": 96.18, "words": [["فإذا", 92.25, 92.54], ["لم", 92.58, 92.69], ["يعُد", 92.76, 92.93], ["إليها،", 92.98, 93.52], ["ينخفضُ", 93.67, 94.32], ["مستوى", 94.39, 94.74], ["البحارِ", 94.76, 95.2], ["في", 95.26, 95.32], ["العالمِ", 95.34, 95.72], ["كلِّه.", 95.78, 96.18]]}, {"text": "في آخرِ عصرٍ جليدي، كان البحرُ أقلَّ من اليوم بنحوِ مئةٍ وعشرينَ متراً.", "start": 96.59, "end": 101.97, "words": [["في", 96.59, 96.71], ["آخرِ", 96.79, 97.07], ["عصرٍ", 97.13, 97.47], ["جليدي،", 97.52, 98.12], ["كان", 98.27, 98.46], ["البحرُ", 98.51, 98.89], ["أقلَّ", 98.94, 99.31], ["من", 99.33, 99.44], ["اليوم", 99.49, 99.87], ["بنحوِ", 100.18, 100.64], ["مئةٍ", 100.69, 101.04], ["وعشرينَ", 101.09, 101.5], ["متراً.", 101.54, 101.97]]}, {"text": "بعدَ ستّةِ أشهر، يضغطُ وزنُ الثلجِ على الطبقاتِ السفلى… فتتحوّلُ إلى جليدٍ صلب.", "start": 102.4, "end": 108.33, "words": [["بعدَ", 102.4, 102.62], ["ستّةِ", 102.69, 103.03], ["أشهر،", 103.08, 103.62], ["يضغطُ", 103.82, 104.22], ["وزنُ", 104.25, 104.49], ["الثلجِ", 104.5, 104.87], ["على", 104.92, 105.02], ["الطبقاتِ", 105.05, 105.55], ["السفلى…", 105.57, 106.15], ["فتتحوّلُ", 106.46, 107.25], ["إلى", 107.29, 107.42], ["جليدٍ", 107.5, 107.83], ["صلب.", 107.93, 108.33]]}, {"text": "هكذا بالضبط، تتكوّنُ الأنهارُ الجليدية.", "start": 108.65, "end": 111.69, "words": [["هكذا", 108.65, 109.04], ["بالضبط،", 109.11, 109.72], ["تتكوّنُ", 109.89, 110.48], ["الأنهارُ", 110.5, 110.94], ["الجليدية.", 110.97, 111.69]]}, {"text": "وبعدَ سنة، تختفي المدنُ تحتَ عشراتِ الأمتار، وتتجمّدُ الأنهارُ والبحيرات.", "start": 112.01, "end": 117.11, "words": [["وبعدَ", 112.01, 112.4], ["سنة،", 112.45, 112.73], ["تختفي", 112.78, 113.14], ["المدنُ", 113.16, 113.53], ["تحتَ", 113.59, 113.84], ["عشراتِ", 113.88, 114.29], ["الأمتار،", 114.31, 114.92], ["وتتجمّدُ", 115.12, 115.86], ["الأنهارُ", 115.88, 116.37], ["والبحيرات.", 116.39, 117.11]]}, {"text": "وإذا لم يذُب هذا الجليدُ في الصيف، يبدأُ عصرٌ جليديٌّ جديد.", "start": 117.49, "end": 121.56, "words": [["وإذا", 117.49, 117.85], ["لم", 117.91, 118.03], ["يذُب", 118.1, 118.32], ["هذا", 118.39, 118.54], ["الجليدُ", 118.56, 118.92], ["في", 118.97, 119.03], ["الصيف،", 119.06, 119.57], ["يبدأُ", 119.81, 120.16], ["عصرٌ", 120.22, 120.57], ["جليديٌّ", 120.63, 121.06], ["جديد.", 121.09, 121.56]]}, {"text": "وهذا ليسَ خيالاً بالكامل.", "start": 121.94, "end": 123.46, "words": [["وهذا", 121.94, 122.24], ["ليسَ", 122.28, 122.49], ["خيالاً", 122.54, 122.85], ["بالكامل.", 122.88, 123.46]]}, {"text": "قبلَ نحوِ سبعمئةِ مليونِ سنة، تجمّدتِ الأرضُ كلُّها تقريباً، وصارتْ كرةً من الثلج.", "start": 123.84, "end": 130.07, "words": [["قبلَ", 123.84, 124.1], ["نحوِ", 124.15, 124.38], ["سبعمئةِ", 124.44, 125.1], ["مليونِ", 125.17, 125.49], ["سنة،", 125.55, 125.97], ["تجمّدتِ", 126.25, 126.85], ["الأرضُ", 126.89, 127.22], ["كلُّها", 127.28, 127.61], ["تقريباً،", 127.65, 128.34], ["وصارتْ", 128.53, 128.98], ["كرةً", 129.0, 129.34], ["من", 129.37, 129.46], ["الثلج.", 129.52, 130.07]]}, {"text": "ومعَ ذلك، نجتِ الحياة… في المحيطات، وقربَ البراكين.", "start": 130.35, "end": 134.76, "words": [["ومعَ", 130.35, 130.71], ["ذلك،", 130.76, 131.15], ["نجتِ", 131.17, 131.46], ["الحياة…", 131.5, 132.11], ["في", 132.48, 132.59], ["المحيطات،", 132.62, 133.35], ["وقربَ", 133.51, 134.04], ["البراكين.", 134.06, 134.76]]}, {"text": "والبراكينُ هي التي أنقذتِ الأرض، حينَ ملأتِ الجوَّ بثاني أكسيدِ الكربون، فدفّأتْها من جديد.", "start": 135.07, "end": 141.9, "words": [["والبراكينُ", 135.07, 135.77], ["هي", 135.81, 135.94], ["التي", 135.98, 136.24], ["أنقذتِ", 136.32, 136.93], ["الأرض،", 136.96, 137.53], ["حينَ", 137.69, 137.97], ["ملأتِ", 138.03, 138.41], ["الجوَّ", 138.45, 138.83], ["بثاني", 138.88, 139.23], ["أكسيدِ", 139.25, 139.56], ["الكربون،", 139.59, 140.25], ["فدفّأتْها", 140.46, 141.2], ["من", 141.25, 141.32], ["جديد.", 141.38, 141.9]]}, {"text": "لكن… هل يمكنُ أن يحدثَ هذا اليوم؟", "start": 142.22, "end": 145.06, "words": [["لكن…", 142.22, 142.77], ["هل", 143.08, 143.27], ["يمكنُ", 143.32, 143.69], ["أن", 143.73, 143.82], ["يحدثَ", 143.87, 144.26], ["هذا", 144.31, 144.5], ["اليوم؟", 144.52, 145.06]]}, {"text": "لا. فالهواءُ البارد لا يحملُ إلا القليلَ من بخارِ الماء.", "start": 145.38, "end": 149.04, "words": [["لا.", 145.38, 145.74], ["فالهواءُ", 146.01, 146.51], ["البارد", 146.53, 146.87], ["لا", 146.91, 146.98], ["يحملُ", 147.03, 147.41], ["إلا", 147.47, 147.64], ["القليلَ", 147.67, 148.09], ["من", 148.13, 148.22], ["بخارِ", 148.27, 148.6], ["الماء.", 148.62, 149.04]]}, {"text": "فكلّما بردَ العالم، قلَّ الثلج. أي أنّ الثلجَ يوقفُ نفسَه بنفسِه.", "start": 149.36, "end": 154.7, "words": [["فكلّما", 149.36, 149.9], ["بردَ", 149.95, 150.25], ["العالم،", 150.27, 150.87], ["قلَّ", 151.08, 151.37], ["الثلج.", 151.39, 152.06], ["أي", 152.33, 152.5], ["أنّ", 152.52, 152.69], ["الثلجَ", 152.73, 153.12], ["يوقفُ", 153.18, 153.56], ["نفسَه", 153.63, 154.01], ["بنفسِه.", 154.1, 154.7]]}, {"text": "لكنّ بعضَ الأماكن تقتربُ من هذا الخيال. ففي جبلِ بيكر بأمريكا، تساقطَ في موسمٍ واحد نحوُ تسعةٍ وعشرينَ متراً من الثلج.", "start": 155.09, "end": 163.84, "words": [["لكنّ", 155.09, 155.45], ["بعضَ", 155.5, 155.71], ["الأماكن", 155.74, 156.19], ["تقتربُ", 156.24, 156.68], ["من", 156.72, 156.8], ["هذا", 156.85, 157.01], ["الخيال.", 157.04, 157.58], ["ففي", 157.91, 158.16], ["جبلِ", 158.28, 158.58], ["بيكر", 158.64, 158.92], ["بأمريكا،", 158.97, 159.68], ["تساقطَ", 159.83, 160.39], ["في", 160.44, 160.52], ["موسمٍ", 160.61, 161.06], ["واحد", 161.16, 161.5], ["نحوُ", 161.54, 161.78], ["تسعةٍ", 161.83, 162.25], ["وعشرينَ", 162.31, 162.76], ["متراً", 162.81, 163.1], ["من", 163.12, 163.22], ["الثلج.", 163.28, 163.84]]}, {"text": "أي ما يعادلُ بنايةً من عشرةِ طوابق.", "start": 164.16, "end": 166.73, "words": [["أي", 164.16, 164.32], ["ما", 164.35, 164.42], ["يعادلُ", 164.49, 164.94], ["بنايةً", 164.99, 165.49], ["من", 165.52, 165.64], ["عشرةِ", 165.69, 166.08], ["طوابق.", 166.15, 166.73]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 167.11, "end": 173.4, "words": [["والآن", 167.11, 167.44], ["دورُك:", 167.49, 167.99], ["ماذا", 168.23, 168.5], ["لو…؟", 168.54, 169.09], ["اكتبْ", 169.53, 169.96], ["سؤالَك", 169.98, 170.39], ["في", 170.48, 170.55], ["التعليقات،", 170.57, 171.5], ["وقد", 171.68, 171.99], ["يكونُ", 172.05, 172.38], ["الفيديو", 172.41, 172.7], ["القادم.", 172.72, 173.4]]}, {"text": "واشتركْ في «ماذا لو؟ Lab»… حتى لا يفوتَك السؤالُ القادم.", "start": 173.67, "end": 178.89, "words": [["واشتركْ", 173.67, 174.17], ["في", 174.21, 174.42], ["«ماذا", 174.59, 175.0], ["لو؟", 175.04, 175.5], ["Lab»…", 175.74, 176.31], ["حتى", 176.69, 176.96], ["لا", 177.01, 177.06], ["يفوتَك", 177.11, 177.54], ["السؤالُ", 177.61, 178.03], ["القادم.", 178.05, 178.89]]}]