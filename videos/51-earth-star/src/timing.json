[{"text": "ماذا لو تحوّلتِ الأرضُ إلى شمس؟", "start": 0.0, "end": 2.07, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.42], ["تحوّلتِ", 0.48, 0.95], ["الأرضُ", 0.99, 1.31], ["إلى", 1.35, 1.49], ["شمس؟", 1.56, 2.07]]}, {"text": "الشمسُ تلمعُ لأنّ قلبَها يدمجُ الهيدروجين، بحرارةِ خمسةَ عشرَ مليونَ درجة.", "start": 2.47, "end": 8.47, "words": [["الشمسُ", 2.47, 2.89], ["تلمعُ", 2.96, 3.4], ["لأنّ", 3.51, 3.8], ["قلبَها", 3.87, 4.27], ["يدمجُ", 4.37, 4.77], ["الهيدروجين،", 4.79, 5.69], ["بحرارةِ", 5.85, 6.64], ["خمسةَ", 6.76, 7.23], ["عشرَ", 7.29, 7.59], ["مليونَ", 7.64, 7.93], ["درجة.", 7.99, 8.47]]}, {"text": "أمّا قلبُ الأرض، فحرارتُه نحوَ ستّةِ آلافِ درجةٍ فقط.", "start": 8.78, "end": 13.12, "words": [["أمّا", 8.78, 9.03], ["قلبُ", 9.09, 9.31], ["الأرض،", 9.35, 9.87], ["فحرارتُه", 10.03, 10.81], ["نحوَ", 10.88, 11.13], ["ستّةِ", 11.2, 11.62], ["آلافِ", 11.69, 12.09], ["درجةٍ", 12.16, 12.56], ["فقط.", 12.63, 13.12]]}, {"text": "ولكي تشتعلَ الأرض، تحتاجُ كتلةً أكبرَ من كتلتِها بأكثرَ من خمسةٍ وعشرينَ ألفَ مرّة.", "start": 13.42, "end": 19.63, "words": [["ولكي", 13.42, 13.83], ["تشتعلَ", 13.89, 14.36], ["الأرض،", 14.38, 14.9], ["تحتاجُ", 15.06, 15.49], ["كتلةً", 15.56, 15.97], ["أكبرَ", 16.02, 16.39], ["من", 16.43, 16.51], ["كتلتِها", 16.56, 17.15], ["بأكثرَ", 17.38, 17.84], ["من", 17.88, 17.98], ["خمسةٍ", 18.05, 18.47], ["وعشرينَ", 18.53, 18.92], ["ألفَ", 18.95, 19.17], ["مرّة.", 19.21, 19.63]]}, {"text": "ويجبُ أن تكونَ من الهيدروجين… لكنّها من الحديدِ والصخر.", "start": 19.93, "end": 24.15, "words": [["ويجبُ", 19.93, 20.45], ["أن", 20.5, 20.58], ["تكونَ", 20.63, 20.96], ["من", 21.01, 21.12], ["الهيدروجين…", 21.18, 22.14], ["لكنّها", 22.46, 22.95], ["من", 23.0, 23.1], ["الحديدِ", 23.15, 23.56], ["والصخر.", 23.59, 24.15]]}, {"text": "لنفترضْ أنّها ابتلعتْ سحابةً عملاقةً من الهيدروجين.", "start": 24.53, "end": 27.82, "words": [["لنفترضْ", 24.53, 25.08], ["أنّها", 25.1, 25.31], ["ابتلعتْ", 25.33, 25.8], ["سحابةً", 25.82, 26.3], ["عملاقةً", 26.34, 26.86], ["من", 26.89, 26.99], ["الهيدروجين.", 27.04, 27.82]]}, {"text": "ستصبحُ جاذبيّتُها أقوى بآلافِ المرّات، فيسقطُ القمرُ عليها في أقلَّ من ساعة.", "start": 28.14, "end": 34.27, "words": [["ستصبحُ", 28.14, 28.7], ["جاذبيّتُها", 28.77, 29.68], ["أقوى", 29.95, 30.37], ["بآلافِ", 30.43, 30.87], ["المرّات،", 30.89, 31.51], ["فيسقطُ", 31.83, 32.39], ["القمرُ", 32.43, 32.86], ["عليها", 32.91, 33.19], ["في", 33.24, 33.32], ["أقلَّ", 33.37, 33.67], ["من", 33.7, 33.8], ["ساعة.", 33.84, 34.27]]}, {"text": "المحيطاتُ تغلي، والجبالُ تذوب، ولا تبقى حياة.", "start": 34.6, "end": 38.51, "words": [["المحيطاتُ", 34.6, 35.25], ["تغلي،", 35.32, 35.86], ["والجبالُ", 36.11, 36.68], ["تذوب،", 36.72, 37.31], ["ولا", 37.49, 37.71], ["تبقى", 37.76, 38.05], ["حياة.", 38.08, 38.51]]}, {"text": "وبعدَ ملايينِ السنين، يشتعلُ قلبُها أخيراً… نجماً أحمرَ بحجمِ المشتري.", "start": 38.84, "end": 44.55, "words": [["وبعدَ", 38.84, 39.25], ["ملايينِ", 39.31, 39.73], ["السنين،", 39.75, 40.4], ["يشتعلُ", 40.63, 41.19], ["قلبُها", 41.27, 41.7], ["أخيراً…", 41.75, 42.47], ["نجماً", 42.74, 43.09], ["أحمرَ", 43.14, 43.54], ["بحجمِ", 43.59, 43.94], ["المشتري.", 43.95, 44.55]]}, {"text": "ومن المرّيخ، ستظهرُ في السماءِ شمسٌ ثانيةٌ حمراء.", "start": 44.85, "end": 48.18, "words": [["ومن", 44.85, 45.13], ["المرّيخ،", 45.19, 45.7], ["ستظهرُ", 45.73, 46.2], ["في", 46.25, 46.32], ["السماءِ", 46.35, 46.74], ["شمسٌ", 46.79, 47.09], ["ثانيةٌ", 47.16, 47.55], ["حمراء.", 47.62, 48.18]]}, {"text": "والمفاجأة؟ هذه الشمسُ الصغيرةُ ستعيشُ أكثرَ من ستّةِ تريليوناتِ سنة… وشمسُنا عشرةَ ملياراتٍ فقط.", "start": 48.54, "end": 55.94, "words": [["والمفاجأة؟", 48.54, 49.39], ["هذه", 49.69, 49.98], ["الشمسُ", 50.03, 50.34], ["الصغيرةُ", 50.36, 50.88], ["ستعيشُ", 50.93, 51.37], ["أكثرَ", 51.42, 51.73], ["من", 51.78, 51.86], ["ستّةِ", 51.92, 52.26], ["تريليوناتِ", 52.31, 52.92], ["سنة…", 52.99, 53.38], ["وشمسُنا", 53.7, 54.29], ["عشرةَ", 54.37, 54.83], ["ملياراتٍ", 54.88, 55.4], ["فقط.", 55.47, 55.94]]}, {"text": "هل كنتَ تتوقّعُ هذا؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 56.3, "end": 61.49, "words": [["هل", 56.3, 56.45], ["كنتَ", 56.51, 56.75], ["تتوقّعُ", 56.8, 57.44], ["هذا؟", 57.5, 58.0], ["اكتبْ", 58.33, 58.68], ["جوابَك", 58.71, 59.18], ["في", 59.29, 59.36], ["التعليقات…", 59.38, 60.3], ["واشتركْ.", 60.58, 61.49]]}]