[{"text": "ماذا لو كانت الأرضُ… على شكلِ دونات؟", "start": 0.0, "end": 2.87, "words": [["ماذا", 0.0, 0.27], ["لو", 0.29, 0.4], ["كانت", 0.44, 0.69], ["الأرضُ…", 0.73, 1.42], ["على", 1.71, 1.9], ["شكلِ", 2.01, 2.28], ["دونات؟", 2.32, 2.87]]}, {"text": "كوكبٌ بثقبٍ كبيرٍ في وسطِه، ولكي يبقى بهذا الشكل، عليه أن يدورَ بسرعةٍ هائلة.", "start": 3.22, "end": 9.24, "words": [["كوكبٌ", 3.22, 3.66], ["بثقبٍ", 3.7, 4.12], ["كبيرٍ", 4.18, 4.5], ["في", 4.56, 4.62], ["وسطِه،", 4.7, 5.24], ["ولكي", 5.53, 5.96], ["يبقى", 5.98, 6.26], ["بهذا", 6.3, 6.63], ["الشكل،", 6.65, 7.22], ["عليه", 7.38, 7.69], ["أن", 7.74, 7.83], ["يدورَ", 7.87, 8.13], ["بسرعةٍ", 8.17, 8.68], ["هائلة.", 8.75, 9.24]]}, {"text": "فاليومُ كلُّه أقلُّ من ثلاثِ ساعات، وتشرقُ الشمسُ وتغيبُ أكثرَ من ثماني مرّاتٍ في يومِنا الحاليّ.", "start": 9.53, "end": 16.88, "words": [["فاليومُ", 9.53, 10.01], ["كلُّه", 10.07, 10.37], ["أقلُّ", 10.46, 10.82], ["من", 10.84, 10.94], ["ثلاثِ", 10.98, 11.3], ["ساعات،", 11.37, 11.92], ["وتشرقُ", 12.11, 12.68], ["الشمسُ", 12.7, 13.21], ["وتغيبُ", 13.25, 13.82], ["أكثرَ", 13.96, 14.34], ["من", 14.38, 14.47], ["ثماني", 14.54, 14.9], ["مرّاتٍ", 14.95, 15.5], ["في", 15.8, 15.92], ["يومِنا", 16.0, 16.31], ["الحاليّ.", 16.34, 16.88]]}, {"text": "والجاذبيّةُ تتغيّرُ من مكانٍ لآخر: عندَ القطبينِ نحوُ ثلثَيْ جاذبيّتِنا، وعندَ خطِّ الاستواءِ أقلُّ من ثلثِها.", "start": 17.29, "end": 25.29, "words": [["والجاذبيّةُ", 17.29, 18.07], ["تتغيّرُ", 18.11, 18.66], ["من", 18.69, 18.77], ["مكانٍ", 18.82, 19.16], ["لآخر:", 19.2, 19.78], ["عندَ", 20.09, 20.35], ["القطبينِ", 20.38, 20.96], ["نحوُ", 21.0, 21.25], ["ثلثَيْ", 21.32, 21.7], ["جاذبيّتِنا،", 21.73, 22.65], ["وعندَ", 22.85, 23.23], ["خطِّ", 23.31, 23.58], ["الاستواءِ", 23.59, 24.17], ["أقلُّ", 24.22, 24.57], ["من", 24.59, 24.67], ["ثلثِها.", 24.72, 25.29]]}, {"text": "فإذا قفزتَ هناك، ترتفعُ أكثرَ من ثلاثةِ أضعافِ قفزتِك اليوم.", "start": 25.6, "end": 30.56, "words": [["فإذا", 25.6, 25.94], ["قفزتَ", 26.01, 26.44], ["هناك،", 26.5, 27.09], ["ترتفعُ", 27.26, 27.86], ["أكثرَ", 27.9, 28.25], ["من", 28.3, 28.4], ["ثلاثةِ", 28.46, 28.92], ["أضعافِ", 28.97, 29.41], ["قفزتِك", 29.51, 30.01], ["اليوم.", 30.06, 30.56]]}, {"text": "والأجملُ: من داخلِ الثقب، ترى الجانبَ الآخرَ من الكوكبِ معلّقاً فوقَ رأسِك… قوساً عملاقاً من الجبالِ والبحار.", "start": 30.86, "end": 39.18, "words": [["والأجملُ:", 30.86, 31.75], ["من", 31.9, 32.03], ["داخلِ", 32.07, 32.36], ["الثقب،", 32.38, 32.94], ["ترى", 33.1, 33.3], ["الجانبَ", 33.32, 33.75], ["الآخرَ", 33.77, 34.21], ["من", 34.26, 34.34], ["الكوكبِ", 34.37, 34.98], ["معلّقاً", 35.18, 35.77], ["فوقَ", 35.83, 36.07], ["رأسِك…", 36.14, 36.72], ["قوساً", 37.03, 37.4], ["عملاقاً", 37.45, 37.94], ["من", 37.98, 38.08], ["الجبالِ", 38.12, 38.52], ["والبحار.", 38.56, 39.18]]}, {"text": "لكنّ الدورانَ السريعَ قد يصنعُ رياحاً وعواصفَ أعنفَ بكثيرٍ ممّا نعرف.", "start": 39.48, "end": 44.6, "words": [["لكنّ", 39.48, 39.83], ["الدورانَ", 39.86, 40.3], ["السريعَ", 40.32, 40.91], ["قد", 41.11, 41.28], ["يصنعُ", 41.33, 41.71], ["رياحاً", 41.75, 42.23], ["وعواصفَ", 42.27, 42.89], ["أعنفَ", 42.91, 43.28], ["بكثيرٍ", 43.34, 43.84], ["ممّا", 43.86, 44.09], ["نعرف.", 44.14, 44.6]]}, {"text": "والأغرب؟ لا نعرفُ في الطبيعةِ طريقةً تصنعُ كوكباً كهذا، فالجاذبيّةُ تجعلُ الأجسامَ الكبيرةَ كُرات.", "start": 44.91, "end": 52.74, "words": [["والأغرب؟", 44.91, 45.59], ["لا", 45.86, 45.99], ["نعرفُ", 46.03, 46.37], ["في", 46.43, 46.5], ["الطبيعةِ", 46.53, 47.09], ["طريقةً", 47.16, 47.67], ["تصنعُ", 47.72, 48.13], ["كوكباً", 48.2, 48.63], ["كهذا،", 48.69, 49.27], ["فالجاذبيّةُ", 49.57, 50.4], ["تجعلُ", 50.45, 50.8], ["الأجسامَ", 50.83, 51.26], ["الكبيرةَ", 51.28, 51.94], ["كُرات.", 52.14, 52.74]]}, {"text": "وحتّى لو وُجد، فقد يتشقّقُ أو ينهارُ مع أيِّ اصطدامٍ قويّ.", "start": 53.05, "end": 57.67, "words": [["وحتّى", 53.05, 53.44], ["لو", 53.51, 53.62], ["وُجد،", 53.64, 54.21], ["فقد", 54.37, 54.68], ["يتشقّقُ", 54.72, 55.43], ["أو", 55.47, 55.59], ["ينهارُ", 55.65, 56.06], ["مع", 56.12, 56.27], ["أيِّ", 56.32, 56.58], ["اصطدامٍ", 56.6, 57.1], ["قويّ.", 57.19, 57.67]]}, {"text": "لو عشتَ على أرضٍ دونات، أينَ تسكن: داخلَ الثقبِ أم خارجَه؟ اكتبْ في التعليقات، واشتركْ.", "start": 58.18, "end": 65.06, "words": [["لو", 58.18, 58.38], ["عشتَ", 58.4, 58.71], ["على", 58.77, 58.92], ["أرضٍ", 58.99, 59.28], ["دونات،", 59.33, 59.91], ["أينَ", 59.95, 60.21], ["تسكن:", 60.27, 60.8], ["داخلَ", 60.98, 61.36], ["الثقبِ", 61.38, 61.79], ["أم", 61.82, 61.93], ["خارجَه؟", 62.01, 62.57], ["اكتبْ", 62.89, 63.29], ["في", 63.31, 63.38], ["التعليقات،", 63.41, 64.21], ["واشتركْ.", 64.25, 65.06]]}]