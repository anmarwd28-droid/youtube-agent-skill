[{"text": "ماذا لو كان لديك أربعُ أذرعٍ بدلَ ذراعَين؟", "start": 0.0, "end": 2.97, "words": [["ماذا", 0.0, 0.27], ["لو", 0.29, 0.38], ["كان", 0.43, 0.59], ["لديك", 0.65, 0.99], ["أربعُ", 1.06, 1.45], ["أذرعٍ", 1.49, 1.95], ["بدلَ", 2.03, 2.31], ["ذراعَين؟", 2.37, 2.97]]}, {"text": "يطبخُ الطاهي بأربعِ أيدٍ، ويحملُ العاملُ ضِعفَ الطوب، وتكتبُ وتأكلُ وتمسكُ هاتفَك معاً.", "start": 3.38, "end": 9.68, "words": [["يطبخُ", 3.38, 3.79], ["الطاهي", 3.81, 4.13], ["بأربعِ", 4.2, 4.63], ["أيدٍ،", 4.66, 5.21], ["ويحملُ", 5.35, 5.86], ["العاملُ", 5.89, 6.27], ["ضِعفَ", 6.34, 6.57], ["الطوب،", 6.59, 7.15], ["وتكتبُ", 7.31, 7.84], ["وتأكلُ", 7.86, 8.34], ["وتمسكُ", 8.37, 8.81], ["هاتفَك", 8.86, 9.21], ["معاً.", 9.31, 9.68]]}, {"text": "لكنَّ الدماغَ يجبُ أن يتغيّر: فالقشرةُ الحركيّةُ ستكبرُ لتحرّكَ يدَين جديدتَين.", "start": 9.97, "end": 16.24, "words": [["لكنَّ", 9.97, 10.33], ["الدماغَ", 10.36, 10.8], ["يجبُ", 10.86, 11.17], ["أن", 11.21, 11.29], ["يتغيّر:", 11.33, 12.05], ["فالقشرةُ", 12.27, 12.89], ["الحركيّةُ", 12.92, 13.55], ["ستكبرُ", 13.62, 14.19], ["لتحرّكَ", 14.44, 15.12], ["يدَين", 15.17, 15.44], ["جديدتَين.", 15.55, 16.24]]}, {"text": "وكلُّ ذراعٍ نحوُ خمسةٍ بالمئةِ من وزنِك، فيثقلُ جسمُك، ويعملُ قلبُك أكثر، وتحتاجُ طعاماً أكثر.", "start": 16.59, "end": 24.14, "words": [["وكلُّ", 16.59, 17.02], ["ذراعٍ", 17.07, 17.45], ["نحوُ", 17.51, 17.77], ["خمسةٍ", 17.83, 18.3], ["بالمئةِ", 18.38, 18.81], ["من", 18.86, 18.94], ["وزنِك،", 18.98, 19.45], ["فيثقلُ", 19.7, 20.28], ["جسمُك،", 20.33, 20.88], ["ويعملُ", 21.05, 21.65], ["قلبُك", 21.73, 22.08], ["أكثر،", 22.16, 22.59], ["وتحتاجُ", 22.64, 23.21], ["طعاماً", 23.27, 23.65], ["أكثر.", 23.67, 24.14]]}, {"text": "والعالمُ كلُّه مصمَّمٌ لذراعَين: القمصانُ والسُّتراتُ ومقاعدُ السيّاراتِ وأحزمةُ الأمان.", "start": 24.46, "end": 31.67, "words": [["والعالمُ", 24.46, 24.98], ["كلُّه", 25.03, 25.4], ["مصمَّمٌ", 25.52, 26.1], ["لذراعَين:", 26.16, 26.93], ["القمصانُ", 27.26, 28.0], ["والسُّتراتُ", 28.15, 28.85], ["ومقاعدُ", 28.89, 29.44], ["السيّاراتِ", 29.47, 30.16], ["وأحزمةُ", 30.41, 31.13], ["الأمان.", 31.15, 31.67]]}, {"text": "وفي السباحة؟ معظمُ الدفعِ يأتي من الذراعَين، فقد تتحطّمُ الأرقامُ القياسيّة.", "start": 32.05, "end": 37.42, "words": [["وفي", 32.05, 32.28], ["السباحة؟", 32.3, 33.01], ["معظمُ", 33.25, 33.63], ["الدفعِ", 33.66, 34.09], ["يأتي", 34.11, 34.34], ["من", 34.39, 34.49], ["الذراعَين،", 34.54, 35.25], ["فقد", 35.28, 35.57], ["تتحطّمُ", 35.6, 36.22], ["الأرقامُ", 36.25, 36.7], ["القياسيّة.", 36.72, 37.42]]}, {"text": "والغريب؟ لا يملكُ أيُّ حيوانٍ فقاريٍّ على اليابسةِ أكثرَ من أربعةِ أطراف، فكلُّها ورثَتْها من سمكةٍ عاشَتْ قبلَ نحوِ ثلاثمئةٍ وسبعينَ مليونَ سنة.", "start": 37.8, "end": 48.89, "words": [["والغريب؟", 37.8, 38.42], ["لا", 38.7, 38.85], ["يملكُ", 38.88, 39.28], ["أيُّ", 39.36, 39.64], ["حيوانٍ", 39.69, 40.18], ["فقاريٍّ", 40.25, 40.8], ["على", 40.84, 40.97], ["اليابسةِ", 40.99, 41.62], ["أكثرَ", 42.01, 42.4], ["من", 42.43, 42.5], ["أربعةِ", 42.54, 42.92], ["أطراف،", 42.96, 43.48], ["فكلُّها", 43.76, 44.27], ["ورثَتْها", 44.34, 44.98], ["من", 45.19, 45.36], ["سمكةٍ", 45.43, 45.89], ["عاشَتْ", 45.96, 46.32], ["قبلَ", 46.37, 46.61], ["نحوِ", 46.66, 46.9], ["ثلاثمئةٍ", 46.96, 47.66], ["وسبعينَ", 47.72, 48.11], ["مليونَ", 48.16, 48.48], ["سنة.", 48.54, 48.89]]}, {"text": "حتّى أجنحةُ الطيورِ والخفافيشِ أذرعٌ معدَّلة، أمّا الحشراتُ فلها ستُّ أرجل.", "start": 49.33, "end": 55.79, "words": [["حتّى", 49.33, 49.76], ["أجنحةُ", 49.81, 50.35], ["الطيورِ", 50.38, 50.8], ["والخفافيشِ", 50.84, 51.73], ["أذرعٌ", 51.91, 52.4], ["معدَّلة،", 52.43, 53.16], ["أمّا", 53.32, 53.62], ["الحشراتُ", 53.64, 54.42], ["فلها", 54.59, 54.97], ["ستُّ", 55.04, 55.32], ["أرجل.", 55.34, 55.79]]}, {"text": "ماذا ستفعلُ بذراعَيك الإضافيّتَين؟ اكتبْ في التعليقات، واشتركْ.", "start": 56.23, "end": 61.21, "words": [["ماذا", 56.23, 56.44], ["ستفعلُ", 56.49, 56.97], ["بذراعَيك", 57.03, 57.54], ["الإضافيّتَين؟", 57.59, 58.46], ["اكتبْ", 58.78, 59.16], ["في", 59.19, 59.26], ["التعليقات،", 59.29, 60.14], ["واشتركْ.", 60.26, 61.21]]}]