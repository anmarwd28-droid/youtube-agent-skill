[{"text": "ماذا لو لم تكنْ هناكَ تكنولوجيا؟ في لحظةٍ واحدة، يتوقّفُ كلُّ ما يعملُ بالكهرباءِ أو الوقود.", "start": 0.0, "end": 6.71, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.48], ["لم", 0.53, 0.64], ["تكنْ", 0.71, 0.99], ["هناكَ", 1.01, 1.3], ["تكنولوجيا؟", 1.33, 2.02], ["في", 2.51, 2.61], ["لحظةٍ", 2.68, 3.03], ["واحدة،", 3.11, 3.63], ["يتوقّفُ", 3.83, 4.48], ["كلُّ", 4.55, 4.84], ["ما", 4.88, 4.95], ["يعملُ", 4.99, 5.31], ["بالكهرباءِ", 5.35, 5.99], ["أو", 6.01, 6.11], ["الوقود.", 6.13, 6.71]]}, {"text": "تنطفئُ الشاشات، وتموتُ الهواتف، وتسكتُ ملياراتُ الأجهزةِ في وقتٍ واحد.", "start": 7.07, "end": 13.18, "words": [["تنطفئُ", 7.07, 7.57], ["الشاشات،", 7.61, 8.35], ["وتموتُ", 8.54, 9.06], ["الهواتف،", 9.08, 9.78], ["وتسكتُ", 10.01, 10.61], ["ملياراتُ", 10.68, 11.21], ["الأجهزةِ", 11.25, 11.96], ["في", 12.16, 12.27], ["وقتٍ", 12.35, 12.62], ["واحد.", 12.7, 13.18]]}, {"text": "تتوقّفُ السيّاراتُ في الطرقات، وتنجرفُ السفنُ في البحار، ولا تُقلِعُ أيُّ طائرة.", "start": 13.58, "end": 19.56, "words": [["تتوقّفُ", 13.58, 14.2], ["السيّاراتُ", 14.22, 14.8], ["في", 14.86, 14.92], ["الطرقات،", 14.94, 15.66], ["وتنجرفُ", 15.88, 16.57], ["السفنُ", 16.59, 16.98], ["في", 17.04, 17.08], ["البحار،", 17.11, 17.76], ["ولا", 18.07, 18.32], ["تُقلِعُ", 18.39, 18.79], ["أيُّ", 18.83, 19.06], ["طائرة.", 19.11, 19.56]]}, {"text": "وبلا مضخّات، تجفُّ صنابيرُ المدنِ خلالَ أيام، فيعودُ الناسُ إلى الأنهارِ والآبار.", "start": 19.98, "end": 26.11, "words": [["وبلا", 19.98, 20.33], ["مضخّات،", 20.39, 21.06], ["تجفُّ", 21.23, 21.7], ["صنابيرُ", 21.75, 22.26], ["المدنِ", 22.28, 22.71], ["خلالَ", 22.78, 23.09], ["أيام،", 23.13, 23.64], ["فيعودُ", 23.92, 24.35], ["الناسُ", 24.37, 24.7], ["إلى", 24.74, 24.83], ["الأنهارِ", 24.87, 25.38], ["والآبار.", 25.41, 26.11]]}, {"text": "وبلا شاحنات، تفرغُ المتاجرُ في ثلاثةِ أيام.", "start": 26.44, "end": 30.05, "words": [["وبلا", 26.44, 26.81], ["شاحنات،", 26.89, 27.57], ["تفرغُ", 27.82, 28.26], ["المتاجرُ", 28.29, 28.92], ["في", 28.97, 29.04], ["ثلاثةِ", 29.11, 29.54], ["أيام.", 29.57, 30.05]]}, {"text": "والأخطر؟ نحوُ نصفِ البشرِ يأكلونَ بفضلِ أسمدةٍ تصنعُها المصانع.", "start": 30.37, "end": 35.52, "words": [["والأخطر؟", 30.37, 31.08], ["نحوُ", 31.41, 31.71], ["نصفِ", 31.78, 32.02], ["البشرِ", 32.05, 32.53], ["يأكلونَ", 32.55, 33.12], ["بفضلِ", 33.27, 33.68], ["أسمدةٍ", 33.72, 34.24], ["تصنعُها", 34.31, 34.81], ["المصانع.", 34.84, 35.52]]}, {"text": "والمستشفياتُ تبقى بلا أجهزةٍ ولا أدويةٍ جديدة.", "start": 35.9, "end": 39.22, "words": [["والمستشفياتُ", 35.9, 36.75], ["تبقى", 36.82, 37.09], ["بلا", 37.15, 37.33], ["أجهزةٍ", 37.37, 37.95], ["ولا", 38.03, 38.2], ["أدويةٍ", 38.23, 38.65], ["جديدة.", 38.71, 39.22]]}, {"text": "فيعودُ الناسُ إلى الخيولِ والمحاريثِ والزراعةِ باليد، كما عاشَ أجدادُنا.", "start": 39.66, "end": 44.59, "words": [["فيعودُ", 39.66, 40.09], ["الناسُ", 40.11, 40.47], ["إلى", 40.53, 40.65], ["الخيولِ", 40.67, 41.17], ["والمحاريثِ", 41.22, 41.9], ["والزراعةِ", 41.97, 42.56], ["باليد،", 42.62, 43.21], ["كما", 43.38, 43.6], ["عاشَ", 43.64, 43.91], ["أجدادُنا.", 43.93, 44.59]]}, {"text": "لكنّ هذه الطريقةَ أطعمتْ قبلَ مئتي عامٍ نحوَ مليارِ إنسانٍ فقط… واليومَ نحنُ أكثرُ من ثمانيةِ مليارات.", "start": 44.97, "end": 52.98, "words": [["لكنّ", 44.97, 45.34], ["هذه", 45.38, 45.62], ["الطريقةَ", 45.66, 46.28], ["أطعمتْ", 46.34, 46.82], ["قبلَ", 46.89, 47.12], ["مئتي", 47.17, 47.53], ["عامٍ", 47.62, 48.0], ["نحوَ", 48.37, 48.66], ["مليارِ", 48.7, 49.16], ["إنسانٍ", 49.2, 49.62], ["فقط…", 49.69, 50.25], ["واليومَ", 50.56, 50.99], ["نحنُ", 51.03, 51.27], ["أكثرُ", 51.32, 51.66], ["من", 51.72, 51.8], ["ثمانيةِ", 51.86, 52.35], ["مليارات.", 52.41, 52.98]]}, {"text": "والمفاجأة؟ لم يعشْ أسلافُنا يوماً بلا تكنولوجيا: صنعوا أدواتٍ من الحجرِ قبلَ أكثرَ من ثلاثةِ ملايينِ سنة.", "start": 53.41, "end": 61.91, "words": [["والمفاجأة؟", 53.41, 54.25], ["لم", 54.5, 54.66], ["يعشْ", 54.74, 54.98], ["أسلافُنا", 55.01, 55.52], ["يوماً", 55.58, 55.99], ["بلا", 56.16, 56.37], ["تكنولوجيا:", 56.41, 57.17], ["صنعوا", 57.6, 57.98], ["أدواتٍ", 58.0, 58.56], ["من", 58.61, 58.73], ["الحجرِ", 58.78, 59.38], ["قبلَ", 59.59, 59.9], ["أكثرَ", 59.95, 60.41], ["من", 60.44, 60.53], ["ثلاثةِ", 60.59, 61.05], ["ملايينِ", 61.1, 61.46], ["سنة.", 61.51, 61.91]]}, {"text": "هل تنجو بلا تكنولوجيا؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 62.23, "end": 66.97, "words": [["هل", 62.23, 62.38], ["تنجو", 62.43, 62.69], ["بلا", 62.74, 62.89], ["تكنولوجيا؟", 62.94, 63.69], ["اكتبْ", 63.94, 64.34], ["جوابَك", 64.38, 64.85], ["في", 64.97, 65.04], ["التعليقات…", 65.06, 65.89], ["واشتركْ.", 66.13, 66.97]]}]