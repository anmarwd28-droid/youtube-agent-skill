[{"text": "ماذا لو لم تُخترَعِ العجلةُ أبداً؟", "start": 0.0, "end": 2.16, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.42], ["لم", 0.48, 0.57], ["تُخترَعِ", 0.64, 1.08], ["العجلةُ", 1.1, 1.66], ["أبداً؟", 1.71, 2.16]]}, {"text": "قبلَ نحوِ خمسةِ آلافٍ وخمسِمئةِ سنة، صنعَ الإنسانُ أوّلَ عجلة… والآن، تخيّلْ أنّها لم توجدْ قطّ.", "start": 2.57, "end": 10.21, "words": [["قبلَ", 2.57, 2.82], ["نحوِ", 2.86, 3.08], ["خمسةِ", 3.15, 3.51], ["آلافٍ", 3.59, 3.98], ["وخمسِمئةِ", 4.04, 4.81], ["سنة،", 4.85, 5.34], ["صنعَ", 5.61, 5.93], ["الإنسانُ", 5.96, 6.49], ["أوّلَ", 6.55, 6.93], ["عجلة…", 6.98, 7.5], ["والآن،", 7.75, 8.35], ["تخيّلْ", 8.54, 8.99], ["أنّها", 9.01, 9.25], ["لم", 9.3, 9.39], ["توجدْ", 9.47, 9.78], ["قطّ.", 9.83, 10.21]]}, {"text": "لا سيّارات، ولا درّاجات، ولا قطارات… أكثرُ من مليارِ مركبةٍ تختفي من الطرقات.", "start": 10.52, "end": 16.11, "words": [["لا", 10.52, 10.63], ["سيّارات،", 10.7, 11.3], ["ولا", 11.32, 11.48], ["درّاجات،", 11.53, 12.13], ["ولا", 12.16, 12.33], ["قطارات…", 12.38, 13.03], ["أكثرُ", 13.26, 13.69], ["من", 13.73, 13.84], ["مليارِ", 13.9, 14.31], ["مركبةٍ", 14.37, 14.88], ["تختفي", 14.95, 15.31], ["من", 15.37, 15.45], ["الطرقات.", 15.5, 16.11]]}, {"text": "وحتى الطائرات لن تطير: فقلبُ المحرّكِ النفّاثِ عجلاتٌ بشفراتٍ تدور.", "start": 16.48, "end": 21.76, "words": [["وحتى", 16.48, 16.83], ["الطائرات", 16.86, 17.37], ["لن", 17.41, 17.52], ["تطير:", 17.55, 18.11], ["فقلبُ", 18.41, 18.83], ["المحرّكِ", 18.86, 19.35], ["النفّاثِ", 19.37, 19.95], ["عجلاتٌ", 20.05, 20.59], ["بشفراتٍ", 20.66, 21.16], ["تدور.", 21.22, 21.76]]}, {"text": "والأغرب؟ نحوُ تسعينَ بالمئةِ من كهرباءِ العالمِ تأتي من عجلاتٍ عملاقةٍ تدور… اسمُها التوربينات.", "start": 22.01, "end": 28.97, "words": [["والأغرب؟", 22.01, 22.62], ["نحوُ", 22.87, 23.12], ["تسعينَ", 23.17, 23.55], ["بالمئةِ", 23.61, 24.02], ["من", 24.07, 24.15], ["كهرباءِ", 24.21, 24.61], ["العالمِ", 24.64, 25.15], ["تأتي", 25.37, 25.62], ["من", 25.67, 25.76], ["عجلاتٍ", 25.82, 26.25], ["عملاقةٍ", 26.31, 26.88], ["تدور…", 26.94, 27.46], ["اسمُها", 27.69, 28.17], ["التوربينات.", 28.19, 28.97]]}, {"text": "فبلا عجلة: مدنٌ مظلمة، ومصانعُ متوقّفة، ولا ساعاتٍ بتروس.", "start": 29.19, "end": 34.46, "words": [["فبلا", 29.19, 29.52], ["عجلة:", 29.56, 30.05], ["مدنٌ", 30.3, 30.66], ["مظلمة،", 30.72, 31.28], ["ومصانعُ", 31.43, 31.97], ["متوقّفة،", 32.01, 32.79], ["ولا", 32.97, 33.23], ["ساعاتٍ", 33.31, 33.76], ["بتروس.", 33.83, 34.46]]}, {"text": "ستنقلُ البضائعَ على ظهورِ الحيوانات، أو تسحبُها على زلّاجاتٍ خشبيّة… ببطءٍ شديد.", "start": 34.76, "end": 41.1, "words": [["ستنقلُ", 34.76, 35.26], ["البضائعَ", 35.28, 35.98], ["على", 36.14, 36.32], ["ظهورِ", 36.39, 36.68], ["الحيوانات،", 36.7, 37.45], ["أو", 37.62, 37.73], ["تسحبُها", 37.79, 38.26], ["على", 38.31, 38.43], ["زلّاجاتٍ", 38.5, 38.99], ["خشبيّة…", 39.06, 39.81], ["ببطءٍ", 40.14, 40.55], ["شديد.", 40.62, 41.1]]}, {"text": "والغريب؟ حضاراتٌ قديمةٌ في أمريكا صنعتْ ألعاباً لها عجلات… لكنّها لم تستخدمْها للنقلِ أبداً.", "start": 41.38, "end": 49.05, "words": [["والغريب؟", 41.38, 42.08], ["حضاراتٌ", 42.32, 42.81], ["قديمةٌ", 42.89, 43.34], ["في", 43.4, 43.47], ["أمريكا", 43.54, 43.92], ["صنعتْ", 43.98, 44.39], ["ألعاباً", 44.41, 44.98], ["لها", 45.3, 45.57], ["عجلات…", 45.59, 46.29], ["لكنّها", 46.57, 47.03], ["لم", 47.08, 47.18], ["تستخدمْها", 47.25, 47.97], ["للنقلِ", 48.09, 48.56], ["أبداً.", 48.59, 49.05]]}, {"text": "وبنتْ طرقاً جبليّةً بطولِ عشراتِ آلافِ الكيلومترات… يمشي عليها الناسُ والحيواناتُ فقط.", "start": 49.38, "end": 56.02, "words": [["وبنتْ", 49.38, 49.87], ["طرقاً", 49.94, 50.34], ["جبليّةً", 50.42, 51.14], ["بطولِ", 51.23, 51.58], ["عشراتِ", 51.63, 52.11], ["آلافِ", 52.16, 52.44], ["الكيلومترات…", 52.47, 53.34], ["يمشي", 53.72, 54.05], ["عليها", 54.09, 54.38], ["الناسُ", 54.41, 54.82], ["والحيواناتُ", 54.86, 55.51], ["فقط.", 55.55, 56.02]]}, {"text": "هل كنتَ ستعيشُ في عالمٍ بلا عجلات؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 56.34, "end": 62.23, "words": [["هل", 56.34, 56.49], ["كنتَ", 56.54, 56.76], ["ستعيشُ", 56.82, 57.28], ["في", 57.33, 57.4], ["عالمٍ", 57.49, 57.84], ["بلا", 57.89, 58.07], ["عجلات؟", 58.12, 58.8], ["اكتبْ", 59.08, 59.48], ["جوابَك", 59.51, 59.93], ["في", 59.99, 60.05], ["التعليقات…", 60.07, 60.94], ["واشتركْ.", 61.33, 62.23]]}]