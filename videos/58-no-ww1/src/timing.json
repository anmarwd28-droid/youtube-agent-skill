[{"text": "ماذا لو لم تَقُمِ الحربُ العالميّةُ الأولى؟", "start": 0.0, "end": 2.54, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.45], ["لم", 0.5, 0.6], ["تَقُمِ", 0.69, 1.01], ["الحربُ", 1.03, 1.42], ["العالميّةُ", 1.44, 2.03], ["الأولى؟", 2.06, 2.54]]}, {"text": "صيفَ عامِ ألفٍ وتسعِمئةٍ وأربعةَ عشر، أشعلت رصاصةٌ في سَراييفو حرباً شاركت فيها أكثرُ من ثلاثينَ دولة.", "start": 2.9, "end": 11.69, "words": [["صيفَ", 2.9, 3.2], ["عامِ", 3.27, 3.48], ["ألفٍ", 3.53, 3.82], ["وتسعِمئةٍ", 3.87, 4.69], ["وأربعةَ", 4.79, 5.33], ["عشر،", 5.36, 5.89], ["أشعلت", 6.12, 6.59], ["رصاصةٌ", 6.66, 7.29], ["في", 7.41, 7.52], ["سَراييفو", 7.63, 8.3], ["حرباً", 8.6, 8.97], ["شاركت", 9.04, 9.43], ["فيها", 9.48, 9.86], ["أكثرُ", 10.16, 10.61], ["من", 10.65, 10.74], ["ثلاثينَ", 10.81, 11.25], ["دولة.", 11.3, 11.69]]}, {"text": "أربعُ سنواتٍ في الخنادقِ والوَحْلِ والغاز، قُتِلَ فيها نحوُ عشرينَ مليونَ إنسان.", "start": 12.01, "end": 17.54, "words": [["أربعُ", 12.01, 12.37], ["سنواتٍ", 12.41, 12.89], ["في", 12.97, 13.02], ["الخنادقِ", 13.04, 13.65], ["والوَحْلِ", 13.71, 14.11], ["والغاز،", 14.15, 14.8], ["قُتِلَ", 15.04, 15.38], ["فيها", 15.45, 15.69], ["نحوُ", 15.77, 16.07], ["عشرينَ", 16.13, 16.53], ["مليونَ", 16.58, 16.93], ["إنسان.", 16.96, 17.54]]}, {"text": "ومعَ الجنودِ انتشرت إنفلونزا عامِ ألفٍ وتسعِمئةٍ وثمانيةَ عشر، فقتلت نحوَ خمسينَ مليوناً، أكثرَ من الحربِ نفسِها.", "start": 17.86, "end": 26.11, "words": [["ومعَ", 17.86, 18.19], ["الجنودِ", 18.22, 18.66], ["انتشرت", 18.68, 19.16], ["إنفلونزا", 19.24, 19.95], ["عامِ", 20.06, 20.34], ["ألفٍ", 20.39, 20.69], ["وتسعِمئةٍ", 20.75, 21.39], ["وثمانيةَ", 21.44, 21.91], ["عشر،", 21.94, 22.39], ["فقتلت", 22.71, 23.28], ["نحوَ", 23.35, 23.59], ["خمسينَ", 23.64, 23.97], ["مليوناً،", 24.02, 24.55], ["أكثرَ", 24.73, 25.09], ["من", 25.12, 25.22], ["الحربِ", 25.26, 25.57], ["نفسِها.", 25.6, 26.11]]}, {"text": "وفي نهايتِها سقطت أربعُ إمبراطوريّات: الروسيّة، والألمانيّة، والنمساويّة، والعثمانيّة.", "start": 26.42, "end": 33.59, "words": [["وفي", 26.42, 26.67], ["نهايتِها", 26.76, 27.47], ["سقطت", 27.63, 28.12], ["أربعُ", 28.16, 28.54], ["إمبراطوريّات:", 28.57, 29.48], ["الروسيّة،", 29.72, 30.52], ["والألمانيّة،", 30.67, 31.56], ["والنمساويّة،", 31.72, 32.6], ["والعثمانيّة.", 32.7, 33.59]]}, {"text": "وفي روسيا، قامت وسطَ الحربِ ثورةٌ أنجبت الاتّحادَ السوفيتيّ.", "start": 33.85, "end": 38.29, "words": [["وفي", 33.85, 34.11], ["روسيا،", 34.19, 34.71], ["قامت", 34.91, 35.22], ["وسطَ", 35.27, 35.56], ["الحربِ", 35.6, 35.98], ["ثورةٌ", 36.04, 36.47], ["أنجبت", 36.58, 37.01], ["الاتّحادَ", 37.08, 37.6], ["السوفيتيّ.", 37.63, 38.29]]}, {"text": "وتقاسمت بريطانيا وفرنسا أراضيَ العثمانيّين، ورسمتا حدوداً ما زالت قائمةً حتّى اليوم.", "start": 38.6, "end": 45.41, "words": [["وتقاسمت", 38.6, 39.39], ["بريطانيا", 39.45, 39.95], ["وفرنسا", 39.98, 40.58], ["أراضيَ", 40.61, 40.99], ["العثمانيّين،", 41.02, 41.95], ["ورسمتا", 42.26, 42.96], ["حدوداً", 43.04, 43.53], ["ما", 43.57, 43.64], ["زالت", 43.73, 44.0], ["قائمةً", 44.08, 44.62], ["حتّى", 44.67, 44.93], ["اليوم.", 44.95, 45.41]]}, {"text": "بلا هذه الحرب، ربّما بقيت تلك الإمبراطوريّات، وبدت خريطةُ العالمِ مختلفةً تماماً.", "start": 45.78, "end": 52.04, "words": [["بلا", 45.78, 45.99], ["هذه", 46.03, 46.29], ["الحرب،", 46.34, 46.92], ["ربّما", 47.12, 47.53], ["بقيت", 47.57, 47.93], ["تلك", 47.95, 48.18], ["الإمبراطوريّات،", 48.25, 49.35], ["وبدت", 49.55, 49.95], ["خريطةُ", 50.02, 50.45], ["العالمِ", 50.47, 50.88], ["مختلفةً", 50.92, 51.49], ["تماماً.", 51.52, 52.04]]}, {"text": "لكنّ الحربَ سرّعت العلمَ أيضاً: صُنِعت فيها أكثرُ من مئتي ألفِ طائرة، وظهرت أوّلُ دبّابة، وأوّلُ بنكٍ للدم.", "start": 52.47, "end": 60.7, "words": [["لكنّ", 52.47, 52.85], ["الحربَ", 52.88, 53.27], ["سرّعت", 53.33, 53.78], ["العلمَ", 53.82, 54.13], ["أيضاً:", 54.17, 54.66], ["صُنِعت", 55.03, 55.47], ["فيها", 55.52, 55.77], ["أكثرُ", 55.84, 56.19], ["من", 56.24, 56.33], ["مئتي", 56.35, 56.73], ["ألفِ", 56.8, 57.01], ["طائرة،", 57.06, 57.53], ["وظهرت", 57.74, 58.24], ["أوّلُ", 58.3, 58.58], ["دبّابة،", 58.65, 59.23], ["وأوّلُ", 59.38, 59.83], ["بنكٍ", 59.87, 60.16], ["للدم.", 60.2, 60.7]]}, {"text": "والمفاجأة؟ في خنادقِها جُرِحَ جنديٌّ بسيطٌ اسمُه أدولف هتلر.", "start": 61.01, "end": 65.82, "words": [["والمفاجأة؟", 61.01, 61.88], ["في", 62.15, 62.24], ["خنادقِها", 62.33, 62.93], ["جُرِحَ", 63.01, 63.33], ["جنديٌّ", 63.38, 63.78], ["بسيطٌ", 63.8, 64.27], ["اسمُه", 64.54, 64.94], ["أدولف", 64.98, 65.31], ["هتلر.", 65.38, 65.82]]}, {"text": "هزيمةُ ألمانيا ومعاهدةُ فرساي أغضبتاه، فقادَ العالمَ بعدَ عشرينَ عاماً إلى حربٍ قتلت أكثرَ من سبعينَ مليوناً.", "start": 66.13, "end": 74.19, "words": [["هزيمةُ", 66.13, 66.64], ["ألمانيا", 66.7, 67.12], ["ومعاهدةُ", 67.15, 67.8], ["فرساي", 67.87, 68.33], ["أغضبتاه،", 68.38, 69.18], ["فقادَ", 69.5, 69.93], ["العالمَ", 69.95, 70.34], ["بعدَ", 70.39, 70.59], ["عشرينَ", 70.62, 70.97], ["عاماً", 71.03, 71.34], ["إلى", 71.59, 71.77], ["حربٍ", 71.87, 72.18], ["قتلت", 72.27, 72.64], ["أكثرَ", 72.7, 73.05], ["من", 73.08, 73.19], ["سبعينَ", 73.25, 73.62], ["مليوناً.", 73.68, 74.19]]}, {"text": "بلا الحربِ الأولى، ربّما بقيَ هتلرُ رسّاماً فقيراً يبيعُ لوحاتٍ صغيرة.", "start": 74.5, "end": 79.86, "words": [["بلا", 74.5, 74.73], ["الحربِ", 74.76, 75.09], ["الأولى،", 75.12, 75.63], ["ربّما", 75.95, 76.29], ["بقيَ", 76.34, 76.68], ["هتلرُ", 76.75, 77.15], ["رسّاماً", 77.19, 77.68], ["فقيراً", 77.74, 78.29], ["يبيعُ", 78.4, 78.79], ["لوحاتٍ", 78.82, 79.23], ["صغيرة.", 79.28, 79.86]]}, {"text": "برأيك، هل كان العالمُ سيصبحُ أفضل؟ اكتبْ في التعليقات، واشتركْ.", "start": 80.38, "end": 86.01, "words": [["برأيك،", 80.38, 81.11], ["هل", 81.35, 81.53], ["كان", 81.59, 81.77], ["العالمُ", 81.82, 82.18], ["سيصبحُ", 82.22, 82.7], ["أفضل؟", 82.73, 83.3], ["اكتبْ", 83.63, 83.99], ["في", 84.01, 84.06], ["التعليقات،", 84.1, 84.94], ["واشتركْ.", 85.15, 86.01]]}]