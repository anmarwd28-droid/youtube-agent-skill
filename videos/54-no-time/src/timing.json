[{"text": "ماذا لو لم يكتشفِ الإنسانُ الوقت؟", "start": 0.0, "end": 2.24, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.49], ["لم", 0.56, 0.69], ["يكتشفِ", 0.78, 1.26], ["الإنسانُ", 1.29, 1.75], ["الوقت؟", 1.76, 2.24]]}, {"text": "منذُ آلافِ السنين، قاسَ البشرُ الزمنَ بالسماء: الشمسُ للأيّام، والقمرُ للشهور.", "start": 2.6, "end": 8.99, "words": [["منذُ", 2.6, 2.86], ["آلافِ", 2.94, 3.27], ["السنين،", 3.3, 4.08], ["قاسَ", 4.24, 4.53], ["البشرُ", 4.55, 5.0], ["الزمنَ", 5.03, 5.41], ["بالسماء:", 5.48, 6.12], ["الشمسُ", 6.43, 6.86], ["للأيّام،", 6.9, 7.59], ["والقمرُ", 7.73, 8.3], ["للشهور.", 8.36, 8.99]]}, {"text": "ولاحظَ المصريّونَ أنّ النيلَ يفيضُ كلَّ عامٍ تقريباً، فصنعوا تقويماً من ثلاثِمئةٍ وخمسةٍ وستّينَ يوماً.", "start": 9.4, "end": 16.98, "words": [["ولاحظَ", 9.4, 9.89], ["المصريّونَ", 9.91, 10.59], ["أنّ", 10.63, 10.81], ["النيلَ", 10.83, 11.16], ["يفيضُ", 11.21, 11.56], ["كلَّ", 11.63, 11.87], ["عامٍ", 11.94, 12.18], ["تقريباً،", 12.24, 12.96], ["فصنعوا", 13.12, 13.68], ["تقويماً", 13.72, 14.28], ["من", 14.34, 14.43], ["ثلاثِمئةٍ", 14.5, 15.26], ["وخمسةٍ", 15.35, 15.88], ["وستّينَ", 15.95, 16.48], ["يوماً.", 16.53, 16.98]]}, {"text": "بلا تقويم، لن نعرفَ متى نزرع، وربّما ما قامت المدنُ الأولى أصلاً.", "start": 17.4, "end": 22.68, "words": [["بلا", 17.4, 17.62], ["تقويم،", 17.67, 18.32], ["لن", 18.52, 18.71], ["نعرفَ", 18.77, 19.21], ["متى", 19.26, 19.48], ["نزرع،", 19.54, 20.12], ["وربّما", 20.39, 20.91], ["ما", 20.98, 21.04], ["قامت", 21.14, 21.45], ["المدنُ", 21.51, 21.88], ["الأولى", 21.91, 22.16], ["أصلاً.", 22.2, 22.68]]}, {"text": "ومن البابليّينَ جاءَ العددُ ستّون: ستّونَ دقيقة، وستّونَ ثانية.", "start": 22.98, "end": 28.26, "words": [["ومن", 22.98, 23.25], ["البابليّينَ", 23.32, 24.17], ["جاءَ", 24.46, 24.71], ["العددُ", 24.73, 25.11], ["ستّون:", 25.19, 25.79], ["ستّونَ", 25.94, 26.34], ["دقيقة،", 26.4, 27.04], ["وستّونَ", 27.2, 27.74], ["ثانية.", 27.79, 28.26]]}, {"text": "وفي البحر، بلا ساعةٍ دقيقة، لا تعرفُ السفينةُ مكانَها. قبلَ ثلاثةِ قرون، غرقَ أكثرُ من ألفٍ وأربعِمئةِ بحّارٍ بسببِ خطأٍ في تحديدِ المكان.", "start": 28.61, "end": 38.92, "words": [["وفي", 28.61, 28.84], ["البحر،", 28.87, 29.26], ["بلا", 29.28, 29.44], ["ساعةٍ", 29.51, 29.86], ["دقيقة،", 29.93, 30.56], ["لا", 30.72, 30.85], ["تعرفُ", 30.89, 31.23], ["السفينةُ", 31.25, 31.74], ["مكانَها.", 31.8, 32.36], ["قبلَ", 32.65, 32.9], ["ثلاثةِ", 32.96, 33.35], ["قرون،", 33.44, 33.97], ["غرقَ", 34.12, 34.52], ["أكثرُ", 34.55, 34.92], ["من", 34.96, 35.06], ["ألفٍ", 35.11, 35.42], ["وأربعِمئةِ", 35.47, 36.12], ["بحّارٍ", 36.18, 36.58], ["بسببِ", 36.63, 37.02], ["خطأٍ", 37.09, 37.52], ["في", 37.83, 37.95], ["تحديدِ", 38.02, 38.35], ["المكان.", 38.37, 38.92]]}, {"text": "حتّى صنعَ جون هاريسون ساعةً بحريّةً دقيقة.", "start": 39.32, "end": 42.35, "words": [["حتّى", 39.32, 39.61], ["صنعَ", 39.69, 40.02], ["جون", 40.09, 40.29], ["هاريسون", 40.33, 40.68], ["ساعةً", 40.75, 41.18], ["بحريّةً", 41.23, 41.75], ["دقيقة.", 41.8, 42.35]]}, {"text": "ثمّ جاءت القطارات، ولكلِّ مدينةٍ وقتُها الخاصّ، فاتّفقَ العالمُ على خطِّ غرينتش.", "start": 42.67, "end": 48.68, "words": [["ثمّ", 42.67, 42.91], ["جاءت", 42.98, 43.21], ["القطارات،", 43.26, 44.05], ["ولكلِّ", 44.24, 44.76], ["مدينةٍ", 44.8, 45.33], ["وقتُها", 45.41, 45.75], ["الخاصّ،", 45.79, 46.35], ["فاتّفقَ", 46.59, 47.17], ["العالمُ", 47.19, 47.61], ["على", 47.68, 47.77], ["خطِّ", 47.86, 48.11], ["غرينتش.", 48.15, 48.68]]}, {"text": "واليوم، في كلِّ قمرٍ من أقمارِ تحديدِ المواقع ساعةٌ ذرّيّة. خطأُ جزءٍ من مليونٍ من الثانية يُبعدُك ثلاثَمئةِ متر.", "start": 48.98, "end": 57.64, "words": [["واليوم،", 48.98, 49.57], ["في", 49.69, 49.81], ["كلِّ", 49.9, 50.13], ["قمرٍ", 50.18, 50.54], ["من", 50.56, 50.65], ["أقمارِ", 50.69, 51.09], ["تحديدِ", 51.13, 51.44], ["المواقع", 51.47, 51.99], ["ساعةٌ", 52.26, 52.7], ["ذرّيّة.", 52.76, 53.32], ["خطأُ", 53.64, 54.0], ["جزءٍ", 54.07, 54.41], ["من", 54.47, 54.59], ["مليونٍ", 54.63, 55.04], ["من", 55.06, 55.17], ["الثانية", 55.23, 55.76], ["يُبعدُك", 56.03, 56.52], ["ثلاثَمئةِ", 56.62, 57.19], ["متر.", 57.25, 57.64]]}, {"text": "بلا وقتٍ دقيق، تضيعُ الخرائط، وتتعطّلُ شبكاتُ الهاتفِ والبنوك.", "start": 58.03, "end": 62.59, "words": [["بلا", 58.03, 58.21], ["وقتٍ", 58.26, 58.54], ["دقيق،", 58.59, 58.98], ["تضيعُ", 59.0, 59.41], ["الخرائط،", 59.43, 60.1], ["وتتعطّلُ", 60.35, 61.09], ["شبكاتُ", 61.15, 61.58], ["الهاتفِ", 61.6, 61.97], ["والبنوك.", 62.02, 62.59]]}, {"text": "لكنّ المفاجأة: جسمُك يعرفُ الوقتَ أصلاً! في دماغِك ساعةٌ تدورُ كلَّ أربعٍ وعشرينَ ساعةً تقريباً.", "start": 63.03, "end": 70.15, "words": [["لكنّ", 63.03, 63.37], ["المفاجأة:", 63.39, 64.13], ["جسمُك", 64.38, 64.75], ["يعرفُ", 64.86, 65.17], ["الوقتَ", 65.19, 65.5], ["أصلاً!", 65.54, 66.04], ["في", 66.35, 66.48], ["دماغِك", 66.56, 66.97], ["ساعةٌ", 67.05, 67.41], ["تدورُ", 67.49, 67.86], ["كلَّ", 67.92, 68.15], ["أربعٍ", 68.2, 68.52], ["وعشرينَ", 68.58, 69.01], ["ساعةً", 69.09, 69.5], ["تقريباً.", 69.53, 70.15]]}, {"text": "فالإنسانُ لم يخترعِ الوقت، بل اكتشفَه في السماء، وفي نفسِه.", "start": 70.46, "end": 74.85, "words": [["فالإنسانُ", 70.46, 71.02], ["لم", 71.06, 71.17], ["يخترعِ", 71.25, 71.67], ["الوقت،", 71.69, 72.2], ["بل", 72.41, 72.57], ["اكتشفَه", 72.6, 73.12], ["في", 73.21, 73.28], ["السماء،", 73.32, 73.9], ["وفي", 74.07, 74.3], ["نفسِه.", 74.38, 74.85]]}, {"text": "برأيك، هل تستطيعُ العيشَ يوماً بلا ساعة؟ اكتبْ في التعليقات، واشتركْ.", "start": 75.23, "end": 81.18, "words": [["برأيك،", 75.23, 75.93], ["هل", 76.08, 76.28], ["تستطيعُ", 76.35, 76.89], ["العيشَ", 76.92, 77.32], ["يوماً", 77.36, 77.64], ["بلا", 77.68, 77.86], ["ساعة؟", 77.92, 78.47], ["اكتبْ", 78.75, 79.13], ["في", 79.17, 79.22], ["التعليقات،", 79.26, 80.12], ["واشتركْ.", 80.21, 81.18]]}]