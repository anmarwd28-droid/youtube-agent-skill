[{"text": "ماذا لو انفجرَ القمرُ فجأة؟", "start": 0.0, "end": 2.08, "words": [["ماذا", 0.0, 0.33], ["لو", 0.37, 0.51], ["انفجرَ", 0.56, 1.04], ["القمرُ", 1.07, 1.49], ["فجأة؟", 1.54, 2.08]]}, {"text": "تفجيرُه يحتاجُ طاقةً تُعادلُ كلَّ ما تُطلقُه الشمسُ في خمسِ دقائق.", "start": 2.4, "end": 7.15, "words": [["تفجيرُه", 2.4, 2.95], ["يحتاجُ", 3.03, 3.45], ["طاقةً", 3.5, 4.04], ["تُعادلُ", 4.17, 4.67], ["كلَّ", 4.72, 4.97], ["ما", 5.02, 5.1], ["تُطلقُه", 5.16, 5.65], ["الشمسُ", 5.7, 6.08], ["في", 6.13, 6.21], ["خمسِ", 6.29, 6.51], ["دقائق.", 6.57, 7.15]]}, {"text": "أي أكثرَ من ثلاثِمئةِ ألفِ ضعفِ النيزكِ الذي أنهى عصرَ الديناصورات.", "start": 7.58, "end": 12.67, "words": [["أي", 7.58, 7.77], ["أكثرَ", 7.83, 8.21], ["من", 8.26, 8.35], ["ثلاثِمئةِ", 8.41, 9.12], ["ألفِ", 9.17, 9.43], ["ضعفِ", 9.5, 9.76], ["النيزكِ", 9.79, 10.48], ["الذي", 10.73, 11.1], ["أنهى", 11.17, 11.45], ["عصرَ", 11.49, 11.82], ["الديناصورات.", 11.84, 12.67]]}, {"text": "في السماء، يتحوّلُ القمرُ إلى سحابةٍ هائلةٍ من الصخور، تلمعُ في ضوءِ الشمس.", "start": 13.11, "end": 19.2, "words": [["في", 13.11, 13.21], ["السماء،", 13.25, 13.83], ["يتحوّلُ", 14.0, 14.68], ["القمرُ", 14.7, 15.14], ["إلى", 15.19, 15.32], ["سحابةٍ", 15.41, 15.97], ["هائلةٍ", 16.07, 16.54], ["من", 16.58, 16.71], ["الصخور،", 16.75, 17.43], ["تلمعُ", 17.7, 18.15], ["في", 18.19, 18.27], ["ضوءِ", 18.36, 18.58], ["الشمس.", 18.6, 19.2]]}, {"text": "والقِطَعُ تبقى تدورُ حولَ الأرض، تتصادمُ وتتفتّت، وتنتشرُ على طولِ المدار… حتى تصيرَ حلقةً مثلَ حلقاتِ زُحَل.", "start": 19.53, "end": 28.36, "words": [["والقِطَعُ", 19.53, 20.05], ["تبقى", 20.12, 20.43], ["تدورُ", 20.49, 20.82], ["حولَ", 20.87, 21.08], ["الأرض،", 21.11, 21.59], ["تتصادمُ", 21.76, 22.41], ["وتتفتّت،", 22.43, 23.37], ["وتنتشرُ", 23.6, 24.31], ["على", 24.38, 24.52], ["طولِ", 24.61, 24.8], ["المدار…", 24.81, 25.52], ["حتى", 25.79, 26.1], ["تصيرَ", 26.13, 26.49], ["حلقةً", 26.57, 27.04], ["مثلَ", 27.09, 27.34], ["حلقاتِ", 27.41, 27.84], ["زُحَل.", 27.91, 28.36]]}, {"text": "وبعضُها يسقطُ علينا: شُهُبٌ تُضيءُ الليل، وصخورٌ قد تمحو مدينةً كاملة.", "start": 28.62, "end": 34.09, "words": [["وبعضُها", 28.62, 29.15], ["يسقطُ", 29.23, 29.61], ["علينا:", 29.69, 30.24], ["شُهُبٌ", 30.5, 30.93], ["تُضيءُ", 31.01, 31.34], ["الليل،", 31.36, 31.86], ["وصخورٌ", 31.97, 32.57], ["قد", 32.63, 32.75], ["تمحو", 32.79, 33.09], ["مدينةً", 33.12, 33.55], ["كاملة.", 33.61, 34.09]]}, {"text": "ومن دونِ القمر، يصغُرُ المدُّ والجزرُ إلى نحوِ الثلث.", "start": 34.4, "end": 38.01, "words": [["ومن", 34.4, 34.68], ["دونِ", 34.73, 34.9], ["القمر،", 34.93, 35.48], ["يصغُرُ", 35.68, 36.14], ["المدُّ", 36.18, 36.55], ["والجزرُ", 36.56, 37.02], ["إلى", 37.06, 37.17], ["نحوِ", 37.24, 37.49], ["الثلث.", 37.51, 38.01]]}, {"text": "والمرجانُ الذي يتكاثرُ على ضوءِ القمر، يفقدُ ساعتَه.", "start": 38.31, "end": 42.11, "words": [["والمرجانُ", 38.31, 38.89], ["الذي", 38.92, 39.17], ["يتكاثرُ", 39.21, 39.82], ["على", 39.88, 40.01], ["ضوءِ", 40.08, 40.27], ["القمر،", 40.3, 40.9], ["يفقدُ", 41.11, 41.51], ["ساعتَه.", 41.58, 42.11]]}, {"text": "والمفاجأة؟ بعدَ زمنٍ طويل، قد تتجمّعُ الصخورُ في قمرٍ جديد… كما وُلِدَ قمرُنا نفسُه من حطامِ اصطدامٍ عملاق.", "start": 42.43, "end": 51.05, "words": [["والمفاجأة؟", 42.43, 43.35], ["بعدَ", 43.73, 44.01], ["زمنٍ", 44.08, 44.38], ["طويل،", 44.48, 44.94], ["قد", 44.98, 45.12], ["تتجمّعُ", 45.15, 45.8], ["الصخورُ", 45.82, 46.28], ["في", 46.32, 46.39], ["قمرٍ", 46.49, 46.82], ["جديد…", 46.89, 47.51], ["كما", 47.83, 48.09], ["وُلِدَ", 48.13, 48.47], ["قمرُنا", 48.54, 48.97], ["نفسُه", 49.05, 49.4], ["من", 49.46, 49.55], ["حطامِ", 49.61, 49.97], ["اصطدامٍ", 49.99, 50.43], ["عملاق.", 50.49, 51.05]]}, {"text": "حلقةٌ أم قمر؟ اكتبْ رأيَك في التعليقات… واشتركْ.", "start": 51.37, "end": 55.77, "words": [["حلقةٌ", 51.37, 51.87], ["أم", 51.95, 52.07], ["قمر؟", 52.15, 52.63], ["اكتبْ", 52.8, 53.22], ["رأيَك", 53.24, 53.52], ["في", 53.64, 53.71], ["التعليقات…", 53.73, 54.53], ["واشتركْ.", 54.86, 55.77]]}]