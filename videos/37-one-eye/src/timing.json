[{"text": "ماذا لو وُلِدَ كلُّ البشرِ بعينٍ واحدةٍ فقط… في وسطِ الوجه؟", "start": 0.0, "end": 4.16, "words": [["ماذا", 0.0, 0.27], ["لو", 0.31, 0.42], ["وُلِدَ", 0.43, 0.76], ["كلُّ", 0.8, 1.03], ["البشرِ", 1.06, 1.44], ["بعينٍ", 1.5, 1.83], ["واحدةٍ", 1.9, 2.29], ["فقط…", 2.36, 2.88], ["في", 3.18, 3.3], ["وسطِ", 3.39, 3.59], ["الوجه؟", 3.61, 4.16]]}, {"text": "عيناكَ الآنَ تريانِ صورتَينِ مختلفتَينِ قليلاً… ودماغُكَ يقارنُهما ليقيسَ المسافة.", "start": 4.46, "end": 11.02, "words": [["عيناكَ", 4.46, 4.92], ["الآنَ", 4.95, 5.28], ["تريانِ", 5.35, 5.76], ["صورتَينِ", 5.83, 6.4], ["مختلفتَينِ", 6.44, 7.17], ["قليلاً…", 7.26, 7.81], ["ودماغُكَ", 8.17, 8.96], ["يقارنُهما", 9.06, 9.85], ["ليقيسَ", 9.91, 10.37], ["المسافة.", 10.39, 11.02]]}, {"text": "بعينٍ واحدة، يفقدُ العالمُ عُمقَه… فالتقاطُ كرةٍ، أو صبُّ الماءِ في كوب، يصبحُ أصعبَ بكثير.", "start": 11.32, "end": 18.89, "words": [["بعينٍ", 11.32, 11.75], ["واحدة،", 11.81, 12.37], ["يفقدُ", 12.53, 12.91], ["العالمُ", 12.92, 13.33], ["عُمقَه…", 13.38, 13.93], ["فالتقاطُ", 14.24, 14.88], ["كرةٍ،", 14.94, 15.55], ["أو", 15.66, 15.8], ["صبُّ", 15.88, 16.11], ["الماءِ", 16.14, 16.43], ["في", 16.48, 16.56], ["كوب،", 16.64, 17.08], ["يصبحُ", 17.26, 17.76], ["أصعبَ", 17.83, 18.23], ["بكثير.", 18.27, 18.89]]}, {"text": "وتضيقُ رؤيتُك: من نحوِ مئتَي درجةٍ… إلى نحوِ مئةٍ وخمسين. فما يقتربُ من جانبِك، قد لا تراه.", "start": 19.14, "end": 26.55, "words": [["وتضيقُ", 19.14, 19.73], ["رؤيتُك:", 19.76, 20.34], ["من", 20.57, 20.7], ["نحوِ", 20.74, 20.97], ["مئتَي", 21.0, 21.29], ["درجةٍ…", 21.35, 22.05], ["إلى", 22.4, 22.61], ["نحوِ", 22.67, 22.94], ["مئةٍ", 23.0, 23.32], ["وخمسين.", 23.37, 24.0], ["فما", 24.25, 24.49], ["يقتربُ", 24.53, 25.02], ["من", 25.05, 25.15], ["جانبِك،", 25.2, 25.72], ["قد", 25.8, 25.97], ["لا", 26.02, 26.08], ["تراه.", 26.13, 26.55]]}, {"text": "والأخطر: لا عينَ احتياطيّة. إصابةٌ واحدة… وتصبحُ أعمى تماماً.", "start": 26.9, "end": 31.96, "words": [["والأخطر:", 26.9, 27.59], ["لا", 27.75, 27.92], ["عينَ", 27.95, 28.15], ["احتياطيّة.", 28.18, 28.92], ["إصابةٌ", 29.18, 29.68], ["واحدة…", 29.73, 30.23], ["وتصبحُ", 30.43, 31.06], ["أعمى", 31.1, 31.37], ["تماماً.", 31.43, 31.96]]}, {"text": "لكنّ دماغَك ذكيّ: يحرّكُ رأسَك قليلاً، ويقارنُ الأحجامَ والظلال… كما يفعلُ اليومَ مَن فقدَ عيناً.", "start": 32.22, "end": 39.46, "words": [["لكنّ", 32.22, 32.54], ["دماغَك", 32.61, 32.98], ["ذكيّ:", 33.1, 33.61], ["يحرّكُ", 33.8, 34.3], ["رأسَك", 34.37, 34.67], ["قليلاً،", 34.78, 35.34], ["ويقارنُ", 35.48, 36.18], ["الأحجامَ", 36.19, 36.68], ["والظلال…", 36.71, 37.36], ["كما", 37.62, 37.84], ["يفعلُ", 37.9, 38.2], ["اليومَ", 38.22, 38.52], ["مَن", 38.57, 38.66], ["فقدَ", 38.71, 39.0], ["عيناً.", 39.04, 39.46]]}, {"text": "ولن تكونَ هناك أفلامٌ ثلاثيّةُ الأبعاد… فهي تخدعُ عينَين، لا عيناً واحدة.", "start": 39.84, "end": 45.67, "words": [["ولن", 39.84, 40.09], ["تكونَ", 40.14, 40.48], ["هناك", 40.53, 40.84], ["أفلامٌ", 40.92, 41.39], ["ثلاثيّةُ", 41.46, 42.03], ["الأبعاد…", 42.05, 42.64], ["فهي", 43.03, 43.28], ["تخدعُ", 43.35, 43.73], ["عينَين،", 43.79, 44.36], ["لا", 44.57, 44.78], ["عيناً", 44.84, 45.13], ["واحدة.", 45.19, 45.67]]}, {"text": "والغريب؟ أسطورةُ العملاقِ ذي العينِ الواحدة… ربّما بدأتْ من جماجمِ فيلةٍ قزمة، فتحةُ الأنفِ فيها تشبهُ عيناً كبيرة.", "start": 46.06, "end": 54.76, "words": [["والغريب؟", 46.06, 46.72], ["أسطورةُ", 46.93, 47.45], ["العملاقِ", 47.47, 47.97], ["ذي", 48.03, 48.1], ["العينِ", 48.12, 48.44], ["الواحدة…", 48.46, 49.09], ["ربّما", 49.41, 49.77], ["بدأتْ", 49.83, 50.23], ["من", 50.25, 50.35], ["جماجمِ", 50.41, 50.9], ["فيلةٍ", 50.94, 51.32], ["قزمة،", 51.41, 51.98], ["فتحةُ", 52.22, 52.69], ["الأنفِ", 52.71, 53.1], ["فيها", 53.16, 53.49], ["تشبهُ", 53.56, 53.91], ["عيناً", 53.95, 54.22], ["كبيرة.", 54.27, 54.76]]}, {"text": "وفي الماءِ اليوم، كائنٌ صغيرٌ اسمُه «سايكلوبس»… يعيشُ فعلاً بعينٍ واحدة.", "start": 55.09, "end": 60.45, "words": [["وفي", 55.09, 55.34], ["الماءِ", 55.38, 55.67], ["اليوم،", 55.69, 56.15], ["كائنٌ", 56.35, 56.68], ["صغيرٌ", 56.76, 57.17], ["اسمُه", 57.21, 57.47], ["«سايكلوبس»…", 57.5, 58.33], ["يعيشُ", 58.77, 59.18], ["فعلاً", 59.22, 59.5], ["بعينٍ", 59.55, 59.87], ["واحدة.", 59.94, 60.45]]}, {"text": "هل كنتَ ستتأقلم؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 60.78, "end": 65.06, "words": [["هل", 60.78, 60.93], ["كنتَ", 60.99, 61.22], ["ستتأقلم؟", 61.27, 62.01], ["اكتبْ", 62.25, 62.61], ["جوابَك", 62.64, 63.01], ["في", 63.1, 63.16], ["التعليقات…", 63.18, 64.03], ["واشتركْ.", 64.24, 65.06]]}]