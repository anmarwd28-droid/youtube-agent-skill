[{"text": "ماذا لو كانَ للأرضِ قمرٌ ثانٍ… بحجمِ قمرِنا، لكن على نصفِ المسافة؟", "start": 0.0, "end": 5.4, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.42], ["كانَ", 0.49, 0.69], ["للأرضِ", 0.73, 1.1], ["قمرٌ", 1.2, 1.54], ["ثانٍ…", 1.61, 2.19], ["بحجمِ", 2.57, 3.04], ["قمرِنا،", 3.11, 3.77], ["لكن", 3.97, 4.27], ["على", 4.33, 4.43], ["نصفِ", 4.49, 4.71], ["المسافة؟", 4.74, 5.4]]}, {"text": "سيبدو في السماءِ أكبرَ بمرّتين، ويدورُ حولَ الأرضِ في عشرةِ أيّامٍ فقط.", "start": 5.99, "end": 11.44, "words": [["سيبدو", 5.99, 6.4], ["في", 6.44, 6.51], ["السماءِ", 6.54, 7.02], ["أكبرَ", 7.06, 7.44], ["بمرّتين،", 7.48, 8.37], ["ويدورُ", 8.58, 9.1], ["حولَ", 9.17, 9.42], ["الأرضِ", 9.45, 9.8], ["في", 9.86, 9.91], ["عشرةِ", 10.0, 10.45], ["أيّامٍ", 10.48, 10.9], ["فقط.", 10.96, 11.44]]}, {"text": "وفي ليالي اكتمالِ القمرين، يصبحُ الليلُ أضوأَ بخمسِ مرّات.", "start": 11.94, "end": 16.11, "words": [["وفي", 11.94, 12.17], ["ليالي", 12.22, 12.48], ["اكتمالِ", 12.5, 12.89], ["القمرين،", 12.91, 13.65], ["يصبحُ", 13.86, 14.35], ["الليلُ", 14.37, 14.7], ["أضوأَ", 14.73, 15.09], ["بخمسِ", 15.14, 15.53], ["مرّات.", 15.59, 16.11]]}, {"text": "لكنّ المفاجأةَ في البحر: المدُّ يصبحُ أعلى بعدّةِ مرّات، وتغمرُ المياهُ الشواطئَ المنخفضة.", "start": 16.54, "end": 23.53, "words": [["لكنّ", 16.54, 16.93], ["المفاجأةَ", 16.95, 17.6], ["في", 17.66, 17.72], ["البحر:", 17.75, 18.32], ["المدُّ", 18.55, 18.98], ["يصبحُ", 19.0, 19.48], ["أعلى", 19.52, 19.75], ["بعدّةِ", 19.84, 20.27], ["مرّات،", 20.34, 20.89], ["وتغمرُ", 21.13, 21.7], ["المياهُ", 21.72, 22.14], ["الشواطئَ", 22.15, 22.71], ["المنخفضة.", 22.73, 23.53]]}, {"text": "ويصبحُ كسوفُ الشمسِ حدثاً متكرّراً، بعد أن كانَ نادراً.", "start": 23.89, "end": 28.26, "words": [["ويصبحُ", 23.89, 24.54], ["كسوفُ", 24.61, 25.01], ["الشمسِ", 25.03, 25.43], ["حدثاً", 25.5, 25.91], ["متكرّراً،", 25.95, 26.84], ["بعد", 27.0, 27.24], ["أن", 27.31, 27.38], ["كانَ", 27.46, 27.66], ["نادراً.", 27.71, 28.26]]}, {"text": "لكنّ القمرين يتجاذبان… وعلى مدى ملايينِ السنين قد يصطدمان.", "start": 28.62, "end": 33.22, "words": [["لكنّ", 28.62, 28.95], ["القمرين", 28.97, 29.56], ["يتجاذبان…", 29.58, 30.52], ["وعلى", 30.82, 31.1], ["مدى", 31.16, 31.34], ["ملايينِ", 31.41, 31.79], ["السنين", 31.8, 32.15], ["قد", 32.22, 32.37], ["يصطدمان.", 32.43, 33.22]]}, {"text": "والغريب؟ بعضُ العلماءِ يعتقدون أنّ هذا حدثَ فعلاً: ربّما كانَ للأرضِ قمرانِ اندمجا في قمرِنا اليوم.", "start": 33.53, "end": 40.66, "words": [["والغريب؟", 33.53, 34.21], ["بعضُ", 34.41, 34.67], ["العلماءِ", 34.69, 35.17], ["يعتقدون", 35.2, 35.77], ["أنّ", 35.83, 35.97], ["هذا", 36.02, 36.21], ["حدثَ", 36.27, 36.56], ["فعلاً:", 36.63, 37.06], ["ربّما", 37.36, 37.74], ["كانَ", 37.81, 38.02], ["للأرضِ", 38.07, 38.48], ["قمرانِ", 38.56, 39.05], ["اندمجا", 39.08, 39.61], ["في", 39.67, 39.74], ["قمرِنا", 39.86, 40.22], ["اليوم.", 40.24, 40.66]]}, {"text": "بل إنّ الأرضَ تأسرُ أحياناً أقماراً صغيرةً مؤقّتة، مثلَ صخرةٍ بعرضِ عشرةِ أمتارٍ رافقتْنا شهرين في عامِ ألفين وأربعةٍ وعشرين.", "start": 41.04, "end": 50.21, "words": [["بل", 41.04, 41.19], ["إنّ", 41.24, 41.38], ["الأرضَ", 41.4, 41.75], ["تأسرُ", 41.81, 42.26], ["أحياناً", 42.3, 42.71], ["أقماراً", 42.75, 43.2], ["صغيرةً", 43.26, 43.79], ["مؤقّتة،", 43.83, 44.49], ["مثلَ", 44.81, 45.13], ["صخرةٍ", 45.21, 45.67], ["بعرضِ", 45.74, 46.08], ["عشرةِ", 46.13, 46.51], ["أمتارٍ", 46.55, 46.98], ["رافقتْنا", 47.31, 47.84], ["شهرين", 47.94, 48.38], ["في", 48.42, 48.48], ["عامِ", 48.58, 48.8], ["ألفين", 48.82, 49.14], ["وأربعةٍ", 49.19, 49.66], ["وعشرين.", 49.7, 50.21]]}, {"text": "اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 50.54, "end": 54.29, "words": [["اكتبْ", 50.54, 50.96], ["سؤالَك", 50.98, 51.35], ["في", 51.47, 51.54], ["التعليقات،", 51.56, 52.28], ["وقد", 52.49, 52.79], ["يكونُ", 52.85, 53.14], ["الفيديو", 53.16, 53.51], ["القادم.", 53.53, 54.29]]}]