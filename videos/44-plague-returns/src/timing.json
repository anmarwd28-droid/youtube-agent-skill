[{"text": "ماذا لو انتشرَ الطاعونُ مرّةً أخرى؟", "start": 0.0, "end": 2.25, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.44], ["انتشرَ", 0.49, 0.96], ["الطاعونُ", 0.99, 1.44], ["مرّةً", 1.47, 1.8], ["أخرى؟", 1.82, 2.25]]}, {"text": "قبلَ نحوِ سبعِمئةِ سنة، قتلَ «الموتُ الأسود» ما بينَ ثلثِ ونصفِ سكّانِ أوروبا، وملايينَ في آسيا وأفريقيا.", "start": 2.69, "end": 10.83, "words": [["قبلَ", 2.69, 2.95], ["نحوِ", 3.01, 3.25], ["سبعِمئةِ", 3.32, 3.9], ["سنة،", 3.96, 4.48], ["قتلَ", 4.69, 5.04], ["«الموتُ", 5.06, 5.51], ["الأسود»", 5.54, 6.19], ["ما", 6.36, 6.46], ["بينَ", 6.51, 6.73], ["ثلثِ", 6.8, 7.21], ["ونصفِ", 7.29, 7.71], ["سكّانِ", 7.78, 8.16], ["أوروبا،", 8.2, 8.8], ["وملايينَ", 9.01, 9.61], ["في", 9.66, 9.75], ["آسيا", 9.81, 10.11], ["وأفريقيا.", 10.14, 10.83]]}, {"text": "سببُه بكتيريا صغيرة، تنقلُها البراغيثُ من الفئرانِ إلى البشر.", "start": 11.27, "end": 15.84, "words": [["سببُه", 11.27, 11.73], ["بكتيريا", 11.81, 12.24], ["صغيرة،", 12.31, 12.95], ["تنقلُها", 13.12, 13.75], ["البراغيثُ", 13.77, 14.4], ["من", 14.43, 14.51], ["الفئرانِ", 14.56, 15.06], ["إلى", 15.11, 15.23], ["البشر.", 15.27, 15.84]]}, {"text": "وأخطرُ أشكالِه يصيبُ الرئتين، فينتقلُ بالسعالِ من شخصٍ إلى آخر.", "start": 16.16, "end": 21.09, "words": [["وأخطرُ", 16.16, 16.71], ["أشكالِه", 16.75, 17.3], ["يصيبُ", 17.39, 17.8], ["الرئتين،", 17.82, 18.68], ["فينتقلُ", 18.85, 19.52], ["بالسعالِ", 19.57, 20.03], ["من", 20.07, 20.16], ["شخصٍ", 20.21, 20.53], ["إلى", 20.56, 20.68], ["آخر.", 20.73, 21.09]]}, {"text": "قديمًا سارَ مع القوافلِ والسفنِ سنوات… أمّا اليوم، فالطائرةُ تنقلُه بينَ القارّاتِ في يومٍ واحد.", "start": 21.45, "end": 28.47, "words": [["قديمًا", 21.45, 21.94], ["سارَ", 22.01, 22.28], ["مع", 22.34, 22.45], ["القوافلِ", 22.5, 23.21], ["والسفنِ", 23.27, 23.73], ["سنوات…", 23.8, 24.48], ["أمّا", 24.79, 25.04], ["اليوم،", 25.07, 25.44], ["فالطائرةُ", 25.46, 26.11], ["تنقلُه", 26.17, 26.68], ["بينَ", 26.78, 26.98], ["القارّاتِ", 27.02, 27.53], ["في", 27.55, 27.63], ["يومٍ", 27.7, 27.93], ["واحد.", 27.99, 28.47]]}, {"text": "لكنّ الفرقَ الكبيرَ اليوم: المضادّاتُ الحيويّة. مع العلاجِ المبكّر، ينجو نحوُ تسعةٍ من كلِّ عشرة.", "start": 28.89, "end": 36.62, "words": [["لكنّ", 28.89, 29.25], ["الفرقَ", 29.28, 29.61], ["الكبيرَ", 29.63, 30.05], ["اليوم:", 30.07, 30.6], ["المضادّاتُ", 30.84, 31.67], ["الحيويّة.", 31.71, 32.47], ["مع", 32.83, 33.01], ["العلاجِ", 33.03, 33.45], ["المبكّر،", 33.47, 34.25], ["ينجو", 34.45, 34.81], ["نحوُ", 34.85, 35.1], ["تسعةٍ", 35.16, 35.68], ["من", 35.72, 35.83], ["كلِّ", 35.87, 36.08], ["عشرة.", 36.11, 36.62]]}, {"text": "ومعَ الحجرِ الصحّيِّ ومكافحةِ الفئران، تُحاصَرُ العدوى بسرعة.", "start": 36.92, "end": 41.63, "words": [["ومعَ", 36.92, 37.26], ["الحجرِ", 37.28, 37.71], ["الصحّيِّ", 37.72, 38.34], ["ومكافحةِ", 38.57, 39.3], ["الفئران،", 39.33, 40.01], ["تُحاصَرُ", 40.22, 40.72], ["العدوى", 40.74, 41.05], ["بسرعة.", 41.09, 41.63]]}, {"text": "والمفاجأة؟ الطاعونُ لم يختفِ أصلًا: ما زالت تُسجَّلُ مئاتُ الحالاتِ كلَّ عامٍ في العالم.", "start": 41.96, "end": 48.06, "words": [["والمفاجأة؟", 41.96, 42.88], ["الطاعونُ", 43.15, 43.64], ["لم", 43.68, 43.79], ["يختفِ", 43.86, 44.2], ["أصلًا:", 44.23, 44.73], ["ما", 45.01, 45.14], ["زالت", 45.22, 45.46], ["تُسجَّلُ", 45.5, 46.03], ["مئاتُ", 46.08, 46.39], ["الحالاتِ", 46.42, 46.87], ["كلَّ", 46.92, 47.19], ["عامٍ", 47.24, 47.44], ["في", 47.48, 47.54], ["العالم.", 47.57, 48.06]]}, {"text": "هل كنتَ تعرفُ هذا؟ اكتبْ في التعليقات… واشتركْ.", "start": 48.39, "end": 52.38, "words": [["هل", 48.39, 48.54], ["كنتَ", 48.6, 48.81], ["تعرفُ", 48.87, 49.21], ["هذا؟", 49.27, 49.74], ["اكتبْ", 49.85, 50.26], ["في", 50.29, 50.35], ["التعليقات…", 50.39, 51.26], ["واشتركْ.", 51.5, 52.38]]}]