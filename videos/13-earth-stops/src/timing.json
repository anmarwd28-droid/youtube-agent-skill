[{"text": "ماذا لو توقّفت الأرضُ عن الدوران… فجأة؟", "start": 0.0, "end": 3.46, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.42], ["توقّفت", 0.49, 1.04], ["الأرضُ", 1.11, 1.46], ["عن", 1.52, 1.65], ["الدوران…", 1.7, 2.5], ["فجأة؟", 2.87, 3.46]]}, {"text": "الأرضُ تدورُ حولَ نفسِها بسرعةٍ تقاربُ ألفاً وسبعَمئةِ كيلومترٍ في الساعة عندَ خطِّ الاستواء.", "start": 3.83, "end": 10.97, "words": [["الأرضُ", 3.83, 4.2], ["تدورُ", 4.27, 4.63], ["حولَ", 4.7, 4.93], ["نفسِها", 4.98, 5.36], ["بسرعةٍ", 5.43, 6.11], ["تقاربُ", 6.37, 6.92], ["ألفاً", 6.98, 7.36], ["وسبعَمئةِ", 7.42, 8.13], ["كيلومترٍ", 8.19, 8.73], ["في", 8.79, 8.84], ["الساعة", 8.87, 9.39], ["عندَ", 9.71, 10.0], ["خطِّ", 10.05, 10.31], ["الاستواء.", 10.33, 10.97]]}, {"text": "ولو توقّفت فجأة، فكلُّ ما ليسَ مثبّتاً بالصخر سيندفعُ شرقاً… أسرعَ من طائرةٍ نفّاثة.", "start": 11.4, "end": 18.67, "words": [["ولو", 11.4, 11.63], ["توقّفت", 11.69, 12.22], ["فجأة،", 12.28, 12.82], ["فكلُّ", 12.98, 13.48], ["ما", 13.51, 13.57], ["ليسَ", 13.63, 13.89], ["مثبّتاً", 13.94, 14.49], ["بالصخر", 14.54, 15.06], ["سيندفعُ", 15.2, 15.86], ["شرقاً…", 15.93, 16.51], ["أسرعَ", 16.87, 17.33], ["من", 17.36, 17.46], ["طائرةٍ", 17.52, 18.02], ["نفّاثة.", 18.05, 18.67]]}, {"text": "والهواءُ سيظلُّ مندفعاً: رياحٌ أقوى من أيِّ إعصارٍ عرفناه.", "start": 18.98, "end": 23.44, "words": [["والهواءُ", 18.98, 19.52], ["سيظلُّ", 19.57, 20.06], ["مندفعاً:", 20.1, 20.86], ["رياحٌ", 21.11, 21.58], ["أقوى", 21.65, 21.94], ["من", 21.98, 22.08], ["أيِّ", 22.12, 22.35], ["إعصارٍ", 22.37, 22.82], ["عرفناه.", 22.88, 23.44]]}, {"text": "والمحيطاتُ تندفعُ نحوَ الشواطئ، بأمواجٍ عملاقةٍ تجتاحُ اليابسة.", "start": 23.82, "end": 28.66, "words": [["والمحيطاتُ", 23.82, 24.51], ["تندفعُ", 24.55, 25.07], ["نحوَ", 25.1, 25.36], ["الشواطئ،", 25.38, 26.12], ["بأمواجٍ", 26.3, 26.89], ["عملاقةٍ", 26.93, 27.5], ["تجتاحُ", 27.57, 28.02], ["اليابسة.", 28.04, 28.66]]}, {"text": "ولو بقيت متوقّفة، فستنتقلُ مياهُ المحيطاتِ ببطءٍ نحو القطبين، وتظهرُ حولَ خطِّ الاستواءِ قارّةٌ واحدةٌ عملاقة.", "start": 28.99, "end": 37.55, "words": [["ولو", 28.99, 29.26], ["بقيت", 29.3, 29.63], ["متوقّفة،", 29.66, 30.49], ["فستنتقلُ", 30.64, 31.5], ["مياهُ", 31.56, 31.88], ["المحيطاتِ", 31.9, 32.48], ["ببطءٍ", 32.54, 32.96], ["نحو", 33.0, 33.2], ["القطبين،", 33.24, 33.92], ["وتظهرُ", 34.17, 34.76], ["حولَ", 34.83, 35.07], ["خطِّ", 35.13, 35.41], ["الاستواءِ", 35.43, 36.03], ["قارّةٌ", 36.1, 36.5], ["واحدةٌ", 36.57, 36.97], ["عملاقة.", 37.01, 37.55]]}, {"text": "ويصبحُ اليومُ الواحدُ سنةً كاملة: ستّةُ أشهرٍ من النهار… وستّةُ أشهرٍ من الليل.", "start": 37.87, "end": 44.29, "words": [["ويصبحُ", 37.87, 38.38], ["اليومُ", 38.41, 38.7], ["الواحدُ", 38.72, 39.14], ["سنةً", 39.2, 39.55], ["كاملة:", 39.62, 40.15], ["ستّةُ", 40.53, 40.96], ["أشهرٍ", 41.02, 41.4], ["من", 41.44, 41.56], ["النهار…", 41.61, 42.26], ["وستّةُ", 42.59, 43.17], ["أشهرٍ", 43.22, 43.64], ["من", 43.66, 43.78], ["الليل.", 43.84, 44.29]]}, {"text": "والخبرُ الجيّد؟ لا شيءَ يستطيعُ إيقافَها فجأة. فهي تتباطأُ ببطءٍ شديد، أجزاءً صغيرةً من الثانيةِ كلَّ قرن.", "start": 44.73, "end": 53.99, "words": [["والخبرُ", 44.73, 45.23], ["الجيّد؟", 45.26, 45.91], ["لا", 46.18, 46.3], ["شيءَ", 46.37, 46.6], ["يستطيعُ", 46.65, 47.16], ["إيقافَها", 47.23, 47.73], ["فجأة.", 47.8, 48.31], ["فهي", 48.63, 48.89], ["تتباطأُ", 48.95, 49.55], ["ببطءٍ", 49.62, 50.0], ["شديد،", 50.09, 50.69], ["أجزاءً", 50.9, 51.44], ["صغيرةً", 51.51, 52.04], ["من", 52.07, 52.19], ["الثانيةِ", 52.24, 52.93], ["كلَّ", 53.17, 53.52], ["قرن.", 53.59, 53.99]]}, {"text": "ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 54.31, "end": 59.49, "words": [["ماذا", 54.31, 54.58], ["لو…؟", 54.62, 55.16], ["اكتبْ", 55.44, 55.85], ["سؤالَك", 55.89, 56.34], ["في", 56.46, 56.53], ["التعليقات،", 56.55, 57.47], ["وقد", 57.68, 58.02], ["يكونُ", 58.07, 58.41], ["الفيديو", 58.43, 58.75], ["القادم.", 58.77, 59.49]]}]