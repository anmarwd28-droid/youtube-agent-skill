[{"text": "ماذا لو أصبحَ كلُّ البشرِ عُمياناً… في نفسِ اللحظة؟", "start": 0.0, "end": 3.87, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.46], ["أصبحَ", 0.5, 0.99], ["كلُّ", 1.04, 1.36], ["البشرِ", 1.38, 1.86], ["عُمياناً…", 1.93, 2.63], ["في", 2.88, 3.0], ["نفسِ", 3.06, 3.31], ["اللحظة؟", 3.33, 3.87]]}, {"text": "في هذه الثانية، نحوُ مليونِ إنسانٍ يطيرونَ في الجوّ… وطيّاروهم لا يرونَ شيئاً.", "start": 4.25, "end": 10.22, "words": [["في", 4.25, 4.37], ["هذه", 4.42, 4.64], ["الثانية،", 4.67, 5.33], ["نحوُ", 5.54, 5.88], ["مليونِ", 5.93, 6.29], ["إنسانٍ", 6.34, 6.77], ["يطيرونَ", 6.85, 7.29], ["في", 7.35, 7.42], ["الجوّ…", 7.44, 8.0], ["وطيّاروهم", 8.24, 9.15], ["لا", 9.24, 9.32], ["يرونَ", 9.37, 9.69], ["شيئاً.", 9.76, 10.22]]}, {"text": "الطيّارُ الآليُّ يُبقي الطائرةَ في السماء… لكنْ مَن يرى المَدْرَج؟ برجُ المراقبةِ أعمى أيضاً.", "start": 10.49, "end": 17.2, "words": [["الطيّارُ", 10.49, 11.06], ["الآليُّ", 11.1, 11.6], ["يُبقي", 11.62, 11.92], ["الطائرةَ", 11.95, 12.48], ["في", 12.54, 12.61], ["السماء…", 12.64, 13.23], ["لكنْ", 13.56, 13.91], ["مَن", 13.94, 14.05], ["يرى", 14.1, 14.26], ["المَدْرَج؟", 14.28, 14.91], ["برجُ", 15.23, 15.58], ["المراقبةِ", 15.6, 16.32], ["أعمى", 16.39, 16.68], ["أيضاً.", 16.72, 17.2]]}, {"text": "وعلى الأرض، ملايينُ السيّاراتِ تسيرُ الآن… وخلالَ ثوانٍ، تمتلئُ الطرقاتُ بالحوادث.", "start": 17.47, "end": 23.1, "words": [["وعلى", 17.47, 17.79], ["الأرض،", 17.82, 18.2], ["ملايينُ", 18.23, 18.62], ["السيّاراتِ", 18.65, 19.24], ["تسيرُ", 19.28, 19.59], ["الآن…", 19.61, 20.12], ["وخلالَ", 20.42, 20.88], ["ثوانٍ،", 20.95, 21.36], ["تمتلئُ", 21.41, 21.83], ["الطرقاتُ", 21.85, 22.37], ["بالحوادث.", 22.42, 23.1]]}, {"text": "وخلالَ أيّام: المصانعُ تتوقّف، والكهرباءُ تنطفئُ مدينةً بعدَ مدينة… ومَن سيزرعُ الطعام؟", "start": 23.41, "end": 30.98, "words": [["وخلالَ", 23.41, 23.85], ["أيّام:", 23.88, 24.42], ["المصانعُ", 24.72, 25.29], ["تتوقّف،", 25.34, 26.1], ["والكهرباءُ", 26.26, 26.98], ["تنطفئُ", 27.05, 27.67], ["مدينةً", 27.74, 28.26], ["بعدَ", 28.32, 28.55], ["مدينة…", 28.58, 29.12], ["ومَن", 29.48, 29.76], ["سيزرعُ", 29.83, 30.33], ["الطعام؟", 30.34, 30.98]]}, {"text": "أمّا دماغُك، فيخصّصُ نحوَ ثُلُثِ قشرتِه للرؤية… وفجأةً، صارَ هذا الجزءُ بلا عمل.", "start": 31.21, "end": 37.97, "words": [["أمّا", 31.21, 31.45], ["دماغُك،", 31.5, 32.1], ["فيخصّصُ", 32.25, 33.05], ["نحوَ", 33.13, 33.4], ["ثُلُثِ", 33.45, 33.81], ["قشرتِه", 33.88, 34.41], ["للرؤية…", 34.45, 35.03], ["وفجأةً،", 35.34, 36.13], ["صارَ", 36.36, 36.63], ["هذا", 36.69, 36.88], ["الجزءُ", 36.91, 37.31], ["بلا", 37.37, 37.53], ["عمل.", 37.57, 37.97]]}, {"text": "لكنّه لا يستسلم: بعدَ خمسةِ أيّامٍ فقط، يبدأُ بمعالجةِ اللمسِ والأصوات.", "start": 38.27, "end": 43.72, "words": [["لكنّه", 38.27, 38.68], ["لا", 38.77, 38.82], ["يستسلم:", 38.88, 39.54], ["بعدَ", 39.78, 40.01], ["خمسةِ", 40.07, 40.47], ["أيّامٍ", 40.52, 40.9], ["فقط،", 40.96, 41.42], ["يبدأُ", 41.62, 41.96], ["بمعالجةِ", 42.01, 42.67], ["اللمسِ", 42.69, 43.03], ["والأصوات.", 43.07, 43.72]]}, {"text": "والمفاجأة؟ ثلاثةٌ وأربعونَ مليونَ كفيفٍ يعيشونَ بيننا اليوم… سيصبحونَ معلّمي العالم.", "start": 44.02, "end": 50.5, "words": [["والمفاجأة؟", 44.02, 44.81], ["ثلاثةٌ", 45.16, 45.7], ["وأربعونَ", 45.76, 46.21], ["مليونَ", 46.25, 46.56], ["كفيفٍ", 46.63, 47.1], ["يعيشونَ", 47.32, 47.77], ["بيننا", 47.82, 48.12], ["اليوم…", 48.15, 48.59], ["سيصبحونَ", 48.95, 49.52], ["معلّمي", 49.58, 49.95], ["العالم.", 49.97, 50.5]]}, {"text": "يعلّمونَنا القراءةَ باللمس… وبعضُهم يرى بالصدى: نقرةٌ باللسان، فيعرفُ أينَ الجدار.", "start": 50.8, "end": 57.24, "words": [["يعلّمونَنا", 50.8, 51.45], ["القراءةَ", 51.48, 51.99], ["باللمس…", 52.05, 52.66], ["وبعضُهم", 52.96, 53.52], ["يرى", 53.59, 53.74], ["بالصدى:", 53.8, 54.36], ["نقرةٌ", 54.55, 54.97], ["باللسان،", 55.03, 55.7], ["فيعرفُ", 55.88, 56.4], ["أينَ", 56.45, 56.63], ["الجدار.", 56.66, 57.24]]}, {"text": "هل كنتَ ستنجو؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 57.56, "end": 62.18, "words": [["هل", 57.56, 57.75], ["كنتَ", 57.81, 58.04], ["ستنجو؟", 58.11, 58.76], ["اكتبْ", 58.93, 59.35], ["جوابَك", 59.4, 59.86], ["في", 59.98, 60.03], ["التعليقات…", 60.06, 60.89], ["واشتركْ.", 61.28, 62.18]]}]