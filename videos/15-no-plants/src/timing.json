[{"text": "ماذا لو اختفت كلُّ النباتاتِ من الأرض… في ليلةٍ واحدة؟", "start": 0.0, "end": 3.61, "words": [["ماذا", 0.0, 0.27], ["لو", 0.3, 0.42], ["اختفت", 0.44, 0.79], ["كلُّ", 0.86, 1.07], ["النباتاتِ", 1.09, 1.6], ["من", 1.65, 1.73], ["الأرض…", 1.79, 2.31], ["في", 2.61, 2.72], ["ليلةٍ", 2.77, 3.09], ["واحدة؟", 3.13, 3.61]]}, {"text": "تستيقظُ فتجدُ الشوارعَ بلا أشجار، والحدائقَ تراباً فقط… والنخيلُ اختفى.", "start": 3.96, "end": 9.69, "words": [["تستيقظُ", 3.96, 4.61], ["فتجدُ", 4.68, 5.14], ["الشوارعَ", 5.17, 5.72], ["بلا", 5.77, 5.94], ["أشجار،", 5.98, 6.61], ["والحدائقَ", 6.83, 7.5], ["تراباً", 7.55, 7.89], ["فقط…", 7.94, 8.46], ["والنخيلُ", 8.75, 9.2], ["اختفى.", 9.22, 9.69]]}, {"text": "الخبرُ الجيّد: لن نختنقَ فوراً، فالهواءُ يحملُ من الأكسجين ما يكفي آلافَ السنين.", "start": 9.98, "end": 16.13, "words": [["الخبرُ", 9.98, 10.39], ["الجيّد:", 10.41, 11.04], ["لن", 11.34, 11.54], ["نختنقَ", 11.61, 12.13], ["فوراً،", 12.18, 12.72], ["فالهواءُ", 12.84, 13.3], ["يحملُ", 13.38, 13.75], ["من", 13.78, 13.87], ["الأكسجين", 13.93, 14.61], ["ما", 14.8, 14.92], ["يكفي", 14.98, 15.22], ["آلافَ", 15.28, 15.56], ["السنين.", 15.58, 16.13]]}, {"text": "لكنّ المشكلةَ هي الطعام. فكلُّ ما نأكلُه يأتي من النباتات… حتى اللحمُ والحليب، لأنّ الحيواناتِ تأكلُ النبات.", "start": 16.48, "end": 24.7, "words": [["لكنّ", 16.48, 16.83], ["المشكلةَ", 16.86, 17.53], ["هي", 17.67, 17.86], ["الطعام.", 17.88, 18.43], ["فكلُّ", 18.66, 19.08], ["ما", 19.11, 19.17], ["نأكلُه", 19.21, 19.66], ["يأتي", 19.82, 20.09], ["من", 20.12, 20.21], ["النباتات…", 20.26, 20.97], ["حتى", 21.29, 21.64], ["اللحمُ", 21.66, 22.01], ["والحليب،", 22.04, 22.68], ["لأنّ", 22.87, 23.14], ["الحيواناتِ", 23.16, 23.73], ["تأكلُ", 23.78, 24.08], ["النبات.", 24.1, 24.7]]}, {"text": "وخلالَ أسابيع، تفرغُ رفوفُ الأسواق، وتبدأُ الحيواناتُ العاشبةُ بالموت… ثمّ المفترسة.", "start": 25.01, "end": 31.81, "words": [["وخلالَ", 25.01, 25.5], ["أسابيع،", 25.54, 26.34], ["تفرغُ", 26.52, 26.96], ["رفوفُ", 27.02, 27.35], ["الأسواق،", 27.38, 28.02], ["وتبدأُ", 28.17, 28.69], ["الحيواناتُ", 28.71, 29.29], ["العاشبةُ", 29.32, 29.9], ["بالموت…", 29.93, 30.48], ["ثمّ", 30.8, 31.05], ["المفترسة.", 31.07, 31.81]]}, {"text": "وبلا جذورٍ تمسكُ التربة، تجرفُها الرياحُ والأمطار: عواصفُ غبارٍ هائلة، وسيولٌ من الطين.", "start": 32.12, "end": 39.65, "words": [["وبلا", 32.12, 32.51], ["جذورٍ", 32.59, 33.04], ["تمسكُ", 33.11, 33.52], ["التربة،", 33.54, 34.1], ["تجرفُها", 34.31, 34.91], ["الرياحُ", 34.94, 35.39], ["والأمطار:", 35.41, 36.12], ["عواصفُ", 36.4, 36.98], ["غبارٍ", 37.02, 37.45], ["هائلة،", 37.52, 38.13], ["وسيولٌ", 38.28, 38.93], ["من", 38.96, 39.09], ["الطين.", 39.15, 39.65]]}, {"text": "ويقلُّ المطرُ في داخلِ القارّات، فالغاباتُ كانت تعيدُ بخارَ الماءِ إلى السماء.", "start": 39.96, "end": 45.24, "words": [["ويقلُّ", 39.96, 40.53], ["المطرُ", 40.54, 40.98], ["في", 41.04, 41.1], ["داخلِ", 41.18, 41.47], ["القارّات،", 41.51, 42.22], ["فالغاباتُ", 42.38, 42.98], ["كانت", 43.05, 43.31], ["تعيدُ", 43.34, 43.69], ["بخارَ", 43.74, 44.08], ["الماءِ", 44.12, 44.44], ["إلى", 44.45, 44.62], ["السماء.", 44.65, 45.24]]}, {"text": "ويرتفعُ ثاني أكسيدِ الكربون، فلا شيءَ يمتصُّه… فتسخنُ الأرضُ أكثر.", "start": 45.6, "end": 50.85, "words": [["ويرتفعُ", 45.6, 46.3], ["ثاني", 46.36, 46.55], ["أكسيدِ", 46.58, 46.85], ["الكربون،", 46.88, 47.59], ["فلا", 47.79, 48.07], ["شيءَ", 48.15, 48.44], ["يمتصُّه…", 48.48, 49.24], ["فتسخنُ", 49.47, 50.03], ["الأرضُ", 50.05, 50.33], ["أكثر.", 50.38, 50.85]]}, {"text": "ومن الفضاء، تتحوّلُ القارّاتُ الخضراءُ إلى بنّيٍّ باهت… كأنّها كوكبٌ آخر.", "start": 51.17, "end": 57.08, "words": [["ومن", 51.17, 51.41], ["الفضاء،", 51.48, 52.13], ["تتحوّلُ", 52.33, 53.0], ["القارّاتُ", 53.02, 53.56], ["الخضراءُ", 53.58, 54.14], ["إلى", 54.2, 54.34], ["بنّيٍّ", 54.41, 54.75], ["باهت…", 54.78, 55.33], ["كأنّها", 55.65, 56.03], ["كوكبٌ", 56.11, 56.56], ["آخر.", 56.62, 57.08]]}, {"text": "النباتاتُ لا تتكلّم… لكنّنا لا نعيشُ يوماً بدونها. اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 57.28, "end": 65.44, "words": [["النباتاتُ", 57.28, 57.85], ["لا", 57.91, 57.97], ["تتكلّم…", 58.02, 58.82], ["لكنّنا", 59.03, 59.54], ["لا", 59.59, 59.69], ["نعيشُ", 59.75, 60.13], ["يوماً", 60.18, 60.58], ["بدونها.", 60.73, 61.45], ["اكتبْ", 61.66, 62.06], ["سؤالَك", 62.09, 62.47], ["في", 62.57, 62.64], ["التعليقات،", 62.66, 63.52], ["وقد", 63.67, 64.01], ["يكونُ", 64.06, 64.34], ["الفيديو", 64.37, 64.66], ["القادم.", 64.68, 65.44]]}]