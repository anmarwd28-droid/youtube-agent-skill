[{"text": "ماذا لو اختفى الاحتكاكُ من العالمِ خمسَ ثوانٍ فقط؟", "start": 0.0, "end": 3.82, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.46], ["اختفى", 0.49, 0.81], ["الاحتكاكُ", 0.84, 1.47], ["من", 1.51, 1.61], ["العالمِ", 1.67, 2.24], ["خمسَ", 2.4, 2.74], ["ثوانٍ", 2.82, 3.22], ["فقط؟", 3.27, 3.82]]}, {"text": "الاحتكاكُ قوّةٌ خفيّة، تُمسكُ كلَّ شيءٍ في مكانِه… ولا ننتبهُ لها أبداً.", "start": 4.18, "end": 10.09, "words": [["الاحتكاكُ", 4.18, 4.82], ["قوّةٌ", 4.9, 5.33], ["خفيّة،", 5.42, 6.12], ["تُمسكُ", 6.26, 6.73], ["كلَّ", 6.8, 7.07], ["شيءٍ", 7.15, 7.43], ["في", 7.5, 7.57], ["مكانِه…", 7.64, 8.22], ["ولا", 8.64, 8.86], ["ننتبهُ", 8.92, 9.33], ["لها", 9.39, 9.55], ["أبداً.", 9.59, 10.09]]}, {"text": "في الثانيةِ الأولى، تنزلقُ قدمُك إلى الأمام، فالمشيُ نفسُه يحتاجُ إلى الاحتكاك.", "start": 10.45, "end": 16.31, "words": [["في", 10.45, 10.56], ["الثانيةِ", 10.59, 11.16], ["الأولى،", 11.19, 11.78], ["تنزلقُ", 11.95, 12.55], ["قدمُك", 12.63, 13.04], ["إلى", 13.14, 13.26], ["الأمام،", 13.29, 13.92], ["فالمشيُ", 14.07, 14.64], ["نفسُه", 14.7, 15.06], ["يحتاجُ", 15.11, 15.5], ["إلى", 15.53, 15.66], ["الاحتكاك.", 15.69, 16.31]]}, {"text": "وفي كلِّ شوارعِ العالم، يسقطُ المشاةُ دفعةً واحدة.", "start": 16.73, "end": 20.8, "words": [["وفي", 16.73, 17.0], ["كلِّ", 17.08, 17.32], ["شوارعِ", 17.38, 17.86], ["العالم،", 17.88, 18.45], ["يسقطُ", 18.65, 19.12], ["المشاةُ", 19.16, 19.71], ["دفعةً", 19.8, 20.25], ["واحدة.", 20.31, 20.8]]}, {"text": "السيّاراتُ لا تستطيعُ أن تتوقّفَ أو تنعطف، فالفراملُ والإطاراتُ تعملُ بالاحتكاك.", "start": 21.16, "end": 27.18, "words": [["السيّاراتُ", 21.16, 21.71], ["لا", 21.76, 21.83], ["تستطيعُ", 21.89, 22.38], ["أن", 22.44, 22.51], ["تتوقّفَ", 22.56, 23.2], ["أو", 23.23, 23.32], ["تنعطف،", 23.38, 24.03], ["فالفراملُ", 24.34, 24.97], ["والإطاراتُ", 25.0, 25.73], ["تعملُ", 25.95, 26.34], ["بالاحتكاك.", 26.39, 27.18]]}, {"text": "العُقَدُ تنحلّ، والمساميرُ تنزلقُ من الخشب، فيتفكّكُ الأثاثُ المثبّتُ بها.", "start": 27.48, "end": 33.31, "words": [["العُقَدُ", 27.48, 27.95], ["تنحلّ،", 27.98, 28.65], ["والمساميرُ", 28.85, 29.49], ["تنزلقُ", 29.54, 30.04], ["من", 30.08, 30.16], ["الخشب،", 30.2, 30.75], ["فيتفكّكُ", 31.02, 31.77], ["الأثاثُ", 31.8, 32.29], ["المثبّتُ", 32.31, 32.87], ["بها.", 32.91, 33.31]]}, {"text": "وفي السماء، يختفي احتكاكُ الهواء، فتتسارعُ قطراتُ المطرِ حتى نحوِ مئتي كيلومترٍ في الساعة.", "start": 33.61, "end": 40.14, "words": [["وفي", 33.61, 33.84], ["السماء،", 33.87, 34.45], ["يختفي", 34.61, 34.98], ["احتكاكُ", 35.0, 35.4], ["الهواء،", 35.42, 36.0], ["فتتسارعُ", 36.22, 36.97], ["قطراتُ", 37.02, 37.44], ["المطرِ", 37.48, 37.87], ["حتى", 37.92, 38.13], ["نحوِ", 38.19, 38.44], ["مئتي", 38.49, 38.87], ["كيلومترٍ", 38.93, 39.42], ["في", 39.46, 39.53], ["الساعة.", 39.56, 40.14]]}, {"text": "وعلى سفوحِ الجبال، تبدأُ الصخورُ والتربةُ بالانزلاق.", "start": 40.46, "end": 44.38, "words": [["وعلى", 40.46, 40.72], ["سفوحِ", 40.8, 41.16], ["الجبال،", 41.18, 41.9], ["تبدأُ", 42.08, 42.42], ["الصخورُ", 42.45, 42.96], ["والتربةُ", 42.98, 43.54], ["بالانزلاق.", 43.58, 44.38]]}, {"text": "ثم يعودُ الاحتكاكُ فجأة، فيكبحُ كلَّ ما كان ينزلق… وتتحوّلُ حركتُه إلى حرارة.", "start": 44.71, "end": 51.59, "words": [["ثم", 44.71, 44.94], ["يعودُ", 45.02, 45.34], ["الاحتكاكُ", 45.36, 45.95], ["فجأة،", 46.02, 46.64], ["فيكبحُ", 46.85, 47.48], ["كلَّ", 47.57, 47.87], ["ما", 47.93, 48.01], ["كان", 48.1, 48.33], ["ينزلق…", 48.4, 49.17], ["وتتحوّلُ", 49.41, 50.19], ["حركتُه", 50.25, 50.74], ["إلى", 50.81, 50.95], ["حرارة.", 51.03, 51.59]]}, {"text": "والمفاجأة: الاحتكاكُ داخلَ مفاصلِ ركبتيك أقلُّ من احتكاكِ الجليدِ على الجليد.", "start": 51.92, "end": 57.84, "words": [["والمفاجأة:", 51.92, 52.83], ["الاحتكاكُ", 53.07, 53.64], ["داخلَ", 53.71, 54.03], ["مفاصلِ", 54.1, 54.61], ["ركبتيك", 54.67, 55.23], ["أقلُّ", 55.55, 56.04], ["من", 56.06, 56.18], ["احتكاكِ", 56.2, 56.67], ["الجليدِ", 56.69, 57.09], ["على", 57.13, 57.26], ["الجليد.", 57.28, 57.84]]}, {"text": "ما أوّلُ شيءٍ كنتَ ستفعلُه في تلك الثواني الخمس؟ اكتبْ في التعليقات، واشتركْ.", "start": 58.28, "end": 64.6, "words": [["ما", 58.28, 58.46], ["أوّلُ", 58.52, 58.85], ["شيءٍ", 58.93, 59.25], ["كنتَ", 59.33, 59.59], ["ستفعلُه", 59.65, 60.24], ["في", 60.29, 60.37], ["تلك", 60.45, 60.65], ["الثواني", 60.72, 61.09], ["الخمس؟", 61.12, 61.72], ["اكتبْ", 62.04, 62.52], ["في", 62.54, 62.61], ["التعليقات،", 62.65, 63.58], ["واشتركْ.", 63.73, 64.6]]}]