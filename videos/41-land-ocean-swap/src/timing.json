[{"text": "ماذا لو تبادلتِ اليابسةُ والمحيطاتُ أماكنَها؟", "start": 0.0, "end": 2.98, "words": [["ماذا", 0.0, 0.27], ["لو", 0.3, 0.4], ["تبادلتِ", 0.44, 0.99], ["اليابسةُ", 1.01, 1.57], ["والمحيطاتُ", 1.61, 2.26], ["أماكنَها؟", 2.31, 2.98]]}, {"text": "اليوم يغطّي الماءُ أكثرَ من سبعين بالمئة من الأرض… وبعد التبادل ينقلب الرقم: الماءُ أقلُّ من الثُّلث.", "start": 3.42, "end": 10.87, "words": [["اليوم", 3.42, 3.76], ["يغطّي", 3.8, 4.13], ["الماءُ", 4.16, 4.47], ["أكثرَ", 4.53, 4.88], ["من", 4.91, 5.0], ["سبعين", 5.06, 5.4], ["بالمئة", 5.47, 5.77], ["من", 5.79, 5.9], ["الأرض…", 5.96, 6.47], ["وبعد", 6.79, 7.19], ["التبادل", 7.22, 7.74], ["ينقلب", 7.79, 8.22], ["الرقم:", 8.27, 8.87], ["الماءُ", 9.2, 9.61], ["أقلُّ", 9.66, 10.05], ["من", 10.08, 10.18], ["الثُّلث.", 10.25, 10.87]]}, {"text": "وقيعانُ المحيطات كلُّها متّصلة، فتصبح اليابسة قارّةً واحدةً عملاقة… والقارّاتُ بحارًا مغلقةً بأشكالها.", "start": 11.19, "end": 19.82, "words": [["وقيعانُ", 11.19, 11.84], ["المحيطات", 11.87, 12.45], ["كلُّها", 12.53, 12.89], ["متّصلة،", 12.93, 13.68], ["فتصبح", 13.96, 14.49], ["اليابسة", 14.55, 15.07], ["قارّةً", 15.15, 15.66], ["واحدةً", 15.73, 16.21], ["عملاقة…", 16.25, 16.95], ["والقارّاتُ", 17.28, 17.93], ["بحارًا", 17.98, 18.48], ["مغلقةً", 18.52, 19.04], ["بأشكالها.", 19.09, 19.82]]}, {"text": "وفي وسطها تظهر أطولُ سلسلةِ جبالٍ على الأرض: خمسةٌ وستّون ألفَ كيلومتر.", "start": 20.12, "end": 25.75, "words": [["وفي", 20.12, 20.35], ["وسطها", 20.45, 20.92], ["تظهر", 20.99, 21.3], ["أطولُ", 21.39, 21.8], ["سلسلةِ", 21.86, 22.33], ["جبالٍ", 22.4, 22.73], ["على", 22.79, 22.93], ["الأرض:", 22.94, 23.44], ["خمسةٌ", 23.74, 24.24], ["وستّون", 24.31, 24.87], ["ألفَ", 24.93, 25.16], ["كيلومتر.", 25.21, 25.75]]}, {"text": "وخندقُ ماريانا يصبح واديًا عمقُه أحدَ عشرَ كيلومترًا… لو وضعتَ فيه إيفرست، لما وصل إلى حافّته.", "start": 26.05, "end": 33.39, "words": [["وخندقُ", 26.05, 26.62], ["ماريانا", 26.68, 27.16], ["يصبح", 27.47, 27.86], ["واديًا", 27.96, 28.36], ["عمقُه", 28.41, 28.8], ["أحدَ", 28.87, 29.16], ["عشرَ", 29.2, 29.45], ["كيلومترًا…", 29.5, 30.09], ["لو", 30.51, 30.66], ["وضعتَ", 30.7, 31.07], ["فيه", 31.11, 31.3], ["إيفرست،", 31.39, 31.96], ["لما", 32.1, 32.32], ["وصل", 32.37, 32.64], ["إلى", 32.69, 32.8], ["حافّته.", 32.89, 33.39]]}, {"text": "لكن مع ماءٍ أقلّ، يقلّ التبخّرُ والمطر… وقلبُ القارّة، البعيدُ آلافَ الكيلومترات عن أيّ بحر، يصبح صحراءَ بلا نهاية.", "start": 33.81, "end": 42.92, "words": [["لكن", 33.81, 34.11], ["مع", 34.15, 34.28], ["ماءٍ", 34.37, 34.59], ["أقلّ،", 34.65, 35.21], ["يقلّ", 35.38, 35.72], ["التبخّرُ", 35.75, 36.26], ["والمطر…", 36.3, 36.88], ["وقلبُ", 37.14, 37.56], ["القارّة،", 37.58, 38.21], ["البعيدُ", 38.45, 39.02], ["آلافَ", 39.09, 39.49], ["الكيلومترات", 39.51, 40.15], ["عن", 40.21, 40.3], ["أيّ", 40.32, 40.51], ["بحر،", 40.55, 40.94], ["يصبح", 41.26, 41.63], ["صحراءَ", 41.74, 42.12], ["بلا", 42.17, 42.34], ["نهاية.", 42.4, 42.92]]}, {"text": "وبلا محيطٍ واسعٍ يخزّن الحرارة، قد يتجاوز الفرقُ بين الصيف والشتاء خمسين درجة.", "start": 43.29, "end": 49.59, "words": [["وبلا", 43.29, 43.67], ["محيطٍ", 43.72, 44.16], ["واسعٍ", 44.23, 44.7], ["يخزّن", 44.83, 45.35], ["الحرارة،", 45.4, 46.06], ["قد", 46.23, 46.39], ["يتجاوز", 46.46, 47.04], ["الفرقُ", 47.1, 47.46], ["بين", 47.52, 47.71], ["الصيف", 47.75, 48.05], ["والشتاء", 48.15, 48.62], ["خمسين", 48.69, 49.04], ["درجة.", 49.12, 49.59]]}, {"text": "والبحارُ المغلقة لا تنقل الدفءَ بين خطّ الاستواء والقطبين: الاستواءُ أحرّ، والقطبان أبرد.", "start": 49.97, "end": 56.47, "words": [["والبحارُ", 49.97, 50.47], ["المغلقة", 50.49, 50.97], ["لا", 50.99, 51.07], ["تنقل", 51.14, 51.5], ["الدفءَ", 51.55, 51.91], ["بين", 51.95, 52.13], ["خطّ", 52.21, 52.47], ["الاستواء", 52.49, 52.97], ["والقطبين:", 53.05, 53.76], ["الاستواءُ", 54.03, 54.66], ["أحرّ،", 54.68, 55.3], ["والقطبان", 55.47, 55.99], ["أبرد.", 56.02, 56.47]]}, {"text": "والبشر؟ سيعيش أغلبُهم على شواطئ هذه البحار… فاليوم يعيش نحوُ أربعين بالمئة منهم قربَ السواحل.", "start": 56.8, "end": 63.45, "words": [["والبشر؟", 56.8, 57.45], ["سيعيش", 57.73, 58.18], ["أغلبُهم", 58.27, 58.69], ["على", 58.76, 58.86], ["شواطئ", 58.93, 59.26], ["هذه", 59.29, 59.5], ["البحار…", 59.54, 60.13], ["فاليوم", 60.45, 60.84], ["يعيش", 60.88, 61.14], ["نحوُ", 61.26, 61.5], ["أربعين", 61.53, 61.88], ["بالمئة", 61.96, 62.27], ["منهم", 62.3, 62.55], ["قربَ", 62.61, 62.82], ["السواحل.", 62.84, 63.45]]}, {"text": "والمفاجأة؟ الأرضُ عاشت شيئًا قريبًا من هذا: قبل نحو مئتين وخمسين مليون سنة، كانت اليابسةُ قارّةً واحدة اسمُها بانجيا… وقلبُها صحراءُ حارقة.", "start": 63.83, "end": 74.56, "words": [["والمفاجأة؟", 63.83, 64.7], ["الأرضُ", 65.03, 65.4], ["عاشت", 65.46, 65.74], ["شيئًا", 65.78, 66.03], ["قريبًا", 66.07, 66.43], ["من", 66.46, 66.56], ["هذا:", 66.61, 67.06], ["قبل", 67.39, 67.63], ["نحو", 67.69, 67.88], ["مئتين", 67.93, 68.28], ["وخمسين", 68.35, 68.74], ["مليون", 68.82, 69.11], ["سنة،", 69.16, 69.61], ["كانت", 69.82, 70.11], ["اليابسةُ", 70.16, 70.67], ["قارّةً", 70.74, 71.15], ["واحدة", 71.2, 71.5], ["اسمُها", 71.52, 71.8], ["بانجيا…", 71.87, 72.47], ["وقلبُها", 72.75, 73.38], ["صحراءُ", 73.46, 73.91], ["حارقة.", 73.98, 74.56]]}, {"text": "أين كنتَ ستعيش؟ اكتبْ جوابك في التعليقات… واشتركْ.", "start": 74.8, "end": 79.18, "words": [["أين", 74.8, 75.05], ["كنتَ", 75.13, 75.36], ["ستعيش؟", 75.42, 76.15], ["اكتبْ", 76.39, 76.74], ["جوابك", 76.77, 77.11], ["في", 77.21, 77.27], ["التعليقات…", 77.29, 78.06], ["واشتركْ.", 78.33, 79.18]]}]