[{"text": "ماذا لو كانت الديناصوراتُ ما زالت حيّةً حتى اليوم؟", "start": 0.0, "end": 3.46, "words": [["ماذا", 0.0, 0.31], ["لو", 0.35, 0.45], ["كانت", 0.51, 0.76], ["الديناصوراتُ", 0.8, 1.49], ["ما", 1.54, 1.6], ["زالت", 1.67, 1.89], ["حيّةً", 1.95, 2.53], ["حتى", 2.67, 2.94], ["اليوم؟", 2.96, 3.46]]}, {"text": "قبلَ ستّةٍ وستّين مليونَ سنة، ضربَ الأرضَ كويكبٌ عرضُه نحوُ عشرةِ كيلومترات، فأنهى عصرَها.", "start": 4.04, "end": 11.45, "words": [["قبلَ", 4.04, 4.31], ["ستّةٍ", 4.38, 4.76], ["وستّين", 4.84, 5.38], ["مليونَ", 5.42, 5.78], ["سنة،", 5.85, 6.32], ["ضربَ", 6.69, 7.01], ["الأرضَ", 7.04, 7.38], ["كويكبٌ", 7.44, 7.96], ["عرضُه", 8.07, 8.36], ["نحوُ", 8.45, 8.7], ["عشرةِ", 8.75, 9.14], ["كيلومترات،", 9.2, 9.95], ["فأنهى", 10.26, 10.72], ["عصرَها.", 10.74, 11.45]]}, {"text": "لكن تخيّلْ لو أنّه أخطأَ الأرض.", "start": 11.71, "end": 13.82, "words": [["لكن", 11.71, 11.98], ["تخيّلْ", 12.02, 12.43], ["لو", 12.46, 12.59], ["أنّه", 12.61, 12.86], ["أخطأَ", 12.93, 13.27], ["الأرض.", 13.29, 13.82]]}, {"text": "في شارعِك، يمرُّ ديناصورٌ طولُه أكثرُ من ثلاثين متراً، ووزنُه كوزنِ عشرةِ فيلة.", "start": 14.12, "end": 20.45, "words": [["في", 14.12, 14.24], ["شارعِك،", 14.33, 14.95], ["يمرُّ", 15.19, 15.57], ["ديناصورٌ", 15.62, 16.21], ["طولُه", 16.31, 16.61], ["أكثرُ", 16.73, 17.08], ["من", 17.12, 17.19], ["ثلاثين", 17.24, 17.6], ["متراً،", 17.68, 18.19], ["ووزنُه", 18.43, 18.99], ["كوزنِ", 19.11, 19.5], ["عشرةِ", 19.56, 19.96], ["فيلة.", 20.02, 20.45]]}, {"text": "يأكلُ مئاتِ الكيلوغراماتِ من النباتِ كلَّ يوم، فتختفي الحدائقُ والمزارع.", "start": 20.86, "end": 25.79, "words": [["يأكلُ", 20.86, 21.27], ["مئاتِ", 21.33, 21.65], ["الكيلوغراماتِ", 21.68, 22.38], ["من", 22.42, 22.55], ["النباتِ", 22.59, 23.0], ["كلَّ", 23.03, 23.28], ["يوم،", 23.32, 23.7], ["فتختفي", 23.94, 24.49], ["الحدائقُ", 24.51, 25.05], ["والمزارع.", 25.08, 25.79]]}, {"text": "أمّا التيرانوصور، فعضّتُه من أقوى العضّاتِ التي عرفناها، تطحنُ العظامَ طحناً.", "start": 26.17, "end": 31.87, "words": [["أمّا", 26.17, 26.41], ["التيرانوصور،", 26.44, 27.36], ["فعضّتُه", 27.41, 28.07], ["من", 28.11, 28.21], ["أقوى", 28.26, 28.53], ["العضّاتِ", 28.55, 29.07], ["التي", 29.09, 29.32], ["عرفناها،", 29.36, 30.15], ["تطحنُ", 30.33, 30.84], ["العظامَ", 30.86, 31.31], ["طحناً.", 31.38, 31.87]]}, {"text": "لكنّه ليس سريعاً جدّاً: نحوَ عشرينَ كيلومتراً في الساعة، فقد يسبقُه عدّاءٌ سريع.", "start": 32.2, "end": 38.66, "words": [["لكنّه", 32.2, 32.6], ["ليس", 32.67, 32.88], ["سريعاً", 33.0, 33.36], ["جدّاً:", 33.41, 33.95], ["نحوَ", 34.16, 34.48], ["عشرينَ", 34.52, 34.94], ["كيلومتراً", 35.0, 35.5], ["في", 35.55, 35.61], ["الساعة،", 35.64, 36.26], ["فقد", 36.47, 36.79], ["يسبقُه", 36.85, 37.41], ["عدّاءٌ", 37.52, 38.0], ["سريع.", 38.09, 38.66]]}, {"text": "ستحتاجُ المدنُ إلى أسوارٍ عالية، وتصبحُ الماشيةُ وجبةً سهلة.", "start": 39.05, "end": 43.62, "words": [["ستحتاجُ", 39.05, 39.59], ["المدنُ", 39.6, 40.02], ["إلى", 40.08, 40.22], ["أسوارٍ", 40.27, 40.75], ["عالية،", 40.86, 41.4], ["وتصبحُ", 41.59, 42.2], ["الماشيةُ", 42.23, 42.71], ["وجبةً", 42.76, 43.18], ["سهلة.", 43.24, 43.62]]}, {"text": "وربّما لم نكن هنا أصلاً، فالثدييّاتُ عاشت صغيرةً في ظلِّها ملايينَ السنين.", "start": 43.91, "end": 48.95, "words": [["وربّما", 43.91, 44.3], ["لم", 44.36, 44.45], ["نكن", 44.51, 44.74], ["هنا", 44.79, 44.98], ["أصلاً،", 45.0, 45.57], ["فالثدييّاتُ", 45.74, 46.59], ["عاشت", 46.67, 46.95], ["صغيرةً", 47.02, 47.47], ["في", 47.53, 47.59], ["ظلِّها", 47.66, 47.97], ["ملايينَ", 48.04, 48.42], ["السنين.", 48.45, 48.95]]}, {"text": "والمفاجأة: الديناصوراتُ لم تنقرضْ كلُّها. فالطيورُ ديناصوراتٌ حيّة، ومن أقربِ أقاربِ التيرانوصور… الدجاجة!", "start": 49.28, "end": 58.53, "words": [["والمفاجأة:", 49.28, 50.14], ["الديناصوراتُ", 50.39, 51.33], ["لم", 51.46, 51.63], ["تنقرضْ", 51.71, 52.17], ["كلُّها.", 52.22, 52.74], ["فالطيورُ", 53.03, 53.52], ["ديناصوراتٌ", 53.58, 54.2], ["حيّة،", 54.27, 54.72], ["ومن", 54.9, 55.17], ["أقربِ", 55.23, 55.65], ["أقاربِ", 55.69, 56.12], ["التيرانوصور…", 56.15, 57.12], ["الدجاجة!", 57.73, 58.53]]}, {"text": "لو عاشت الديناصوراتُ معنا، أيُّها تريدُ أن تراه؟ اكتبْ في التعليقات، واشتركْ.", "start": 59.04, "end": 65.67, "words": [["لو", 59.04, 59.22], ["عاشت", 59.3, 59.65], ["الديناصوراتُ", 59.71, 60.5], ["معنا،", 60.56, 61.06], ["أيُّها", 61.27, 61.7], ["تريدُ", 61.77, 62.09], ["أن", 62.14, 62.22], ["تراه؟", 62.27, 62.79], ["اكتبْ", 63.17, 63.55], ["في", 63.58, 63.65], ["التعليقات،", 63.68, 64.61], ["واشتركْ.", 64.68, 65.67]]}]