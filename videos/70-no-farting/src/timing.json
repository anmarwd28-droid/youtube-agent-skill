[{"text": "ماذا لو لم يستطعِ الإنسانُ إطلاقَ الريحِ أبداً؟", "start": 0.0, "end": 2.9, "words": [["ماذا", 0.0, 0.31], ["لو", 0.35, 0.48], ["لم", 0.52, 0.63], ["يستطعِ", 0.69, 1.09], ["الإنسانُ", 1.11, 1.64], ["إطلاقَ", 1.67, 2.04], ["الريحِ", 2.07, 2.39], ["أبداً؟", 2.43, 2.9]]}, {"text": "قد تضحك، لكنّ جسمَك يصنعُ كلَّ يومٍ نحوَ لترٍ كاملٍ من الغازات.", "start": 3.29, "end": 8.46, "words": [["قد", 3.29, 3.45], ["تضحك،", 3.5, 4.14], ["لكنّ", 4.42, 4.78], ["جسمَك", 4.87, 5.24], ["يصنعُ", 5.33, 5.69], ["كلَّ", 5.75, 6.0], ["يومٍ", 6.05, 6.43], ["نحوَ", 6.58, 6.91], ["لترٍ", 6.95, 7.27], ["كاملٍ", 7.34, 7.65], ["من", 7.67, 7.79], ["الغازات.", 7.84, 8.46]]}, {"text": "تصنعُها تريليوناتُ البكتيريا في أمعائِك، وهي تهضمُ طعامَك.", "start": 8.9, "end": 13.06, "words": [["تصنعُها", 8.9, 9.53], ["تريليوناتُ", 9.6, 10.16], ["البكتيريا", 10.18, 10.7], ["في", 10.74, 10.83], ["أمعائِك،", 10.89, 11.52], ["وهي", 11.73, 11.99], ["تهضمُ", 12.07, 12.45], ["طعامَك.", 12.5, 13.06]]}, {"text": "ويُطلقُ الإنسانُ الريحَ عادةً نحوَ خمسَ عشرةَ مرّةً في اليوم.", "start": 13.44, "end": 17.96, "words": [["ويُطلقُ", 13.44, 14.03], ["الإنسانُ", 14.06, 14.56], ["الريحَ", 14.58, 14.94], ["عادةً", 14.98, 15.52], ["نحوَ", 15.8, 16.11], ["خمسَ", 16.17, 16.48], ["عشرةَ", 16.53, 16.95], ["مرّةً", 17.01, 17.38], ["في", 17.43, 17.48], ["اليوم.", 17.51, 17.96]]}, {"text": "بدونِ مخرج، تتجمّعُ الغازات، فتنتفخُ البطن، ويأتي ألمٌ وتشنّجات.", "start": 18.4, "end": 24.18, "words": [["بدونِ", 18.4, 18.76], ["مخرج،", 18.82, 19.26], ["تتجمّعُ", 19.28, 19.95], ["الغازات،", 19.97, 20.66], ["فتنتفخُ", 20.85, 21.57], ["البطن،", 21.59, 22.18], ["ويأتي", 22.33, 22.84], ["ألمٌ", 22.89, 23.24], ["وتشنّجات.", 23.29, 24.18]]}, {"text": "لكنّ الجسمَ ذكيّ: جزءٌ من الغازاتِ يمرُّ إلى الدم… ثمّ يخرجُ مع أنفاسِك.", "start": 24.53, "end": 30.31, "words": [["لكنّ", 24.53, 24.88], ["الجسمَ", 24.9, 25.25], ["ذكيّ:", 25.31, 25.87], ["جزءٌ", 26.16, 26.49], ["من", 26.54, 26.64], ["الغازاتِ", 26.68, 27.16], ["يمرُّ", 27.2, 27.55], ["إلى", 27.59, 27.71], ["الدم…", 27.75, 28.29], ["ثمّ", 28.58, 28.89], ["يخرجُ", 28.94, 29.37], ["مع", 29.43, 29.56], ["أنفاسِك.", 29.63, 30.31]]}, {"text": "بل إنّ الأطباءَ يكشفونَ بعضَ أمراضِ الهضمِ بقياسِ غازِ الهيدروجينِ في النَّفَس.", "start": 30.6, "end": 35.83, "words": [["بل", 30.6, 30.74], ["إنّ", 30.78, 30.88], ["الأطباءَ", 30.91, 31.61], ["يكشفونَ", 31.83, 32.37], ["بعضَ", 32.43, 32.62], ["أمراضِ", 32.63, 32.92], ["الهضمِ", 32.95, 33.4], ["بقياسِ", 33.59, 34.05], ["غازِ", 34.1, 34.3], ["الهيدروجينِ", 34.32, 35.02], ["في", 35.12, 35.24], ["النَّفَس.", 35.27, 35.83]]}, {"text": "لكنْ في هذا العالم، قد تخرجُ بعضُ الروائحِ أيضاً… من فمِك.", "start": 36.12, "end": 40.4, "words": [["لكنْ", 36.12, 36.38], ["في", 36.42, 36.48], ["هذا", 36.55, 36.72], ["العالم،", 36.74, 37.3], ["قد", 37.47, 37.59], ["تخرجُ", 37.64, 38.0], ["بعضُ", 38.06, 38.28], ["الروائحِ", 38.3, 38.9], ["أيضاً…", 38.94, 39.5], ["من", 39.8, 39.91], ["فمِك.", 39.97, 40.4]]}, {"text": "وفي المستشفيات، ينتظرُ الأطبّاءُ بعدَ العمليّةِ أن يُطلقَ المريضُ الريح، فهي علامةٌ أنّ أمعاءَه عادت للعمل.", "start": 40.88, "end": 49.12, "words": [["وفي", 40.88, 41.11], ["المستشفيات،", 41.12, 42.06], ["ينتظرُ", 42.26, 42.77], ["الأطبّاءُ", 42.79, 43.41], ["بعدَ", 43.47, 43.66], ["العمليّةِ", 43.69, 44.33], ["أن", 44.56, 44.74], ["يُطلقَ", 44.8, 45.22], ["المريضُ", 45.24, 45.66], ["الريح،", 45.67, 46.18], ["فهي", 46.45, 46.74], ["علامةٌ", 46.82, 47.27], ["أنّ", 47.33, 47.53], ["أمعاءَه", 47.56, 48.11], ["عادت", 48.25, 48.56], ["للعمل.", 48.62, 49.12]]}, {"text": "والأغرب؟ أسماكُ الرَّنْكة تتواصلُ في ظلامِ البحرِ بفقاعاتٍ تُطلقُها من الخلف، لها صوتٌ كالطقطقة.", "start": 49.43, "end": 56.6, "words": [["والأغرب؟", 49.43, 50.14], ["أسماكُ", 50.34, 50.82], ["الرَّنْكة", 50.84, 51.23], ["تتواصلُ", 51.26, 51.93], ["في", 51.98, 52.06], ["ظلامِ", 52.12, 52.41], ["البحرِ", 52.43, 52.79], ["بفقاعاتٍ", 52.85, 53.6], ["تُطلقُها", 53.67, 54.18], ["من", 54.23, 54.33], ["الخلف،", 54.38, 54.94], ["لها", 55.2, 55.41], ["صوتٌ", 55.52, 55.8], ["كالطقطقة.", 55.87, 56.6]]}, {"text": "هل تريدُ عالماً بلا ريح؟ اكتبْ رأيَك في التعليقات، واشتركْ.", "start": 56.98, "end": 61.3, "words": [["هل", 56.98, 57.14], ["تريدُ", 57.2, 57.5], ["عالماً", 57.58, 57.94], ["بلا", 58.0, 58.16], ["ريح؟", 58.22, 58.64], ["اكتبْ", 59.02, 59.43], ["رأيَك", 59.45, 59.74], ["في", 59.84, 59.91], ["التعليقات،", 59.93, 60.49], ["واشتركْ.", 60.51, 61.3]]}]