[{"text": "ماذا لو كانت الأرضُ مسطّحةً مثلَ قرص؟", "start": 0.0, "end": 2.61, "words": [["ماذا", 0.0, 0.27], ["لو", 0.3, 0.41], ["كانت", 0.45, 0.7], ["الأرضُ", 0.74, 1.06], ["مسطّحةً", 1.1, 1.83], ["مثلَ", 1.87, 2.1], ["قرص؟", 2.16, 2.61]]}, {"text": "أوّلاً، لن تبقى مسطّحة: الجاذبيّةُ تسحبُ أيَّ جسمٍ بحجمِ الأرضِ نحوَ مركزِه… حتى يصبحَ كرة.", "start": 2.93, "end": 10.51, "words": [["أوّلاً،", 2.93, 3.56], ["لن", 3.71, 3.84], ["تبقى", 3.9, 4.14], ["مسطّحة:", 4.19, 4.95], ["الجاذبيّةُ", 5.26, 5.99], ["تسحبُ", 6.05, 6.48], ["أيَّ", 6.54, 6.78], ["جسمٍ", 6.83, 7.22], ["بحجمِ", 7.29, 7.67], ["الأرضِ", 7.7, 8.03], ["نحوَ", 8.08, 8.34], ["مركزِه…", 8.38, 9.0], ["حتى", 9.36, 9.64], ["يصبحَ", 9.69, 10.09], ["كرة.", 10.14, 10.51]]}, {"text": "لكن لنفترضْ أنّها بقيت قرصاً… عندها ستشدُّك الجاذبيّةُ نحوَ مركزِ القرص، لا إلى الأسفل.", "start": 10.82, "end": 17.72, "words": [["لكن", 10.82, 11.12], ["لنفترضْ", 11.16, 11.74], ["أنّها", 11.77, 12.06], ["بقيت", 12.12, 12.47], ["قرصاً…", 12.55, 13.21], ["عندها", 13.38, 13.84], ["ستشدُّك", 13.96, 14.63], ["الجاذبيّةُ", 14.69, 15.39], ["نحوَ", 15.45, 15.69], ["مركزِ", 15.72, 16.05], ["القرص،", 16.08, 16.66], ["لا", 16.83, 16.96], ["إلى", 17.02, 17.14], ["الأسفل.", 17.17, 17.72]]}, {"text": "في المركزِ تقفُ مستقيماً، لكن كلّما ابتعدت مالت الأرضُ تحتَ قدميك… وكأنّك تصعدُ جبلاً لا ينتهي.", "start": 18.09, "end": 25.82, "words": [["في", 18.09, 18.2], ["المركزِ", 18.24, 18.75], ["تقفُ", 18.81, 19.17], ["مستقيماً،", 19.21, 20.03], ["لكن", 20.34, 20.63], ["كلّما", 20.7, 21.04], ["ابتعدت", 21.06, 21.56], ["مالت", 21.76, 22.07], ["الأرضُ", 22.13, 22.42], ["تحتَ", 22.46, 22.68], ["قدميك…", 22.73, 23.36], ["وكأنّك", 23.66, 24.2], ["تصعدُ", 24.31, 24.71], ["جبلاً", 24.76, 25.11], ["لا", 25.17, 25.24], ["ينتهي.", 25.29, 25.82]]}, {"text": "وستنزلقُ المحيطاتُ والهواءُ نحوَ المركز: بحرٌ هائلٌ في الوسط، وأطرافٌ جافّةٌ بلا هواء.", "start": 26.18, "end": 32.95, "words": [["وستنزلقُ", 26.18, 27.02], ["المحيطاتُ", 27.05, 27.67], ["والهواءُ", 27.71, 28.16], ["نحوَ", 28.21, 28.42], ["المركز:", 28.44, 29.06], ["بحرٌ", 29.36, 29.7], ["هائلٌ", 29.77, 30.09], ["في", 30.15, 30.21], ["الوسط،", 30.23, 30.86], ["وأطرافٌ", 31.08, 31.64], ["جافّةٌ", 31.75, 32.21], ["بلا", 32.27, 32.43], ["هواء.", 32.48, 32.95]]}, {"text": "ولن يكونَ هناك ليلٌ ونهارٌ كما نعرفهما: حين تشرقُ الشمس، يُضاءُ القرصُ كلُّه في اللحظةِ نفسِها.", "start": 33.25, "end": 40.38, "words": [["ولن", 33.25, 33.51], ["يكونَ", 33.58, 33.89], ["هناك", 33.94, 34.27], ["ليلٌ", 34.41, 34.74], ["ونهارٌ", 34.77, 35.25], ["كما", 35.32, 35.5], ["نعرفهما:", 35.55, 36.38], ["حين", 36.69, 36.94], ["تشرقُ", 37.0, 37.44], ["الشمس،", 37.45, 38.05], ["يُضاءُ", 38.13, 38.53], ["القرصُ", 38.56, 38.95], ["كلُّه", 39.02, 39.3], ["في", 39.39, 39.44], ["اللحظةِ", 39.45, 39.86], ["نفسِها.", 39.9, 40.38]]}, {"text": "ولن تختفيَ السفنُ خلفَ الأفق، بل تصغرُ فقط حتى يحجبَها الضباب.", "start": 40.81, "end": 45.71, "words": [["ولن", 40.81, 41.08], ["تختفيَ", 41.15, 41.66], ["السفنُ", 41.68, 42.1], ["خلفَ", 42.16, 42.39], ["الأفق،", 42.4, 42.98], ["بل", 43.25, 43.41], ["تصغرُ", 43.47, 43.86], ["فقط", 43.92, 44.22], ["حتى", 44.29, 44.55], ["يحجبَها", 44.6, 45.08], ["الضباب.", 45.1, 45.71]]}, {"text": "وإذا سافرتَ بعيداً عن الشمال، فستصلُ إلى الحافّة… جرفٌ صخريٌّ يطلُّ على الفضاء.", "start": 46.14, "end": 52.27, "words": [["وإذا", 46.14, 46.44], ["سافرتَ", 46.51, 46.91], ["بعيداً", 46.97, 47.31], ["عن", 47.36, 47.45], ["الشمال،", 47.47, 48.09], ["فستصلُ", 48.26, 48.96], ["إلى", 49.02, 49.15], ["الحافّة…", 49.18, 49.82], ["جرفٌ", 50.25, 50.56], ["صخريٌّ", 50.63, 51.09], ["يطلُّ", 51.14, 51.5], ["على", 51.55, 51.65], ["الفضاء.", 51.69, 52.27]]}, {"text": "لكنّنا نعرفُ أنّها كرة: ظلُّ الأرضِ على القمرِ في كلِّ خسوفٍ دائريٌّ دائماً.", "start": 52.58, "end": 58.02, "words": [["لكنّنا", 52.58, 53.08], ["نعرفُ", 53.15, 53.51], ["أنّها", 53.58, 53.85], ["كرة:", 53.93, 54.31], ["ظلُّ", 54.68, 54.96], ["الأرضِ", 54.98, 55.31], ["على", 55.39, 55.54], ["القمرِ", 55.58, 56.01], ["في", 56.06, 56.15], ["كلِّ", 56.24, 56.47], ["خسوفٍ", 56.52, 56.92], ["دائريٌّ", 56.99, 57.46], ["دائماً.", 57.48, 58.02]]}, {"text": "لو كانت مسطّحة… هل كنتَ ستزورُ الحافّة؟ اكتبْ في التعليقات.", "start": 58.4, "end": 63.39, "words": [["لو", 58.4, 58.54], ["كانت", 58.61, 58.84], ["مسطّحة…", 58.9, 59.66], ["هل", 59.99, 60.14], ["كنتَ", 60.2, 60.45], ["ستزورُ", 60.51, 61.02], ["الحافّة؟", 61.05, 61.74], ["اكتبْ", 62.02, 62.37], ["في", 62.39, 62.45], ["التعليقات.", 62.48, 63.39]]}]