[{"text": "ماذا لو لم تَقُمِ الحربُ العالميّةُ الثانية؟", "start": 0.0, "end": 2.58, "words": [["ماذا", 0.0, 0.31], ["لو", 0.35, 0.49], ["لم", 0.55, 0.65], ["تَقُمِ", 0.73, 1.04], ["الحربُ", 1.06, 1.41], ["العالميّةُ", 1.43, 2.01], ["الثانية؟", 2.03, 2.58]]}, {"text": "في الأوّلِ من سبتمبر عامَ ألفٍ وتسعِمئةٍ وتسعةٍ وثلاثين، بدأت أكبرُ حربٍ في التاريخ، ولم تنتهِ إلّا بعدَ ستِّ سنوات.", "start": 3.02, "end": 12.67, "words": [["في", 3.02, 3.12], ["الأوّلِ", 3.15, 3.51], ["من", 3.54, 3.63], ["سبتمبر", 3.69, 4.17], ["عامَ", 4.26, 4.46], ["ألفٍ", 4.49, 4.79], ["وتسعِمئةٍ", 4.87, 5.69], ["وتسعةٍ", 5.77, 6.36], ["وثلاثين،", 6.43, 7.27], ["بدأت", 7.58, 8.01], ["أكبرُ", 8.06, 8.46], ["حربٍ", 8.54, 8.86], ["في", 8.92, 8.99], ["التاريخ،", 9.02, 9.71], ["ولم", 9.91, 10.21], ["تنتهِ", 10.29, 10.8], ["إلّا", 10.86, 11.27], ["بعدَ", 11.4, 11.74], ["ستِّ", 11.81, 12.07], ["سنوات.", 12.1, 12.67]]}, {"text": "قُتِلَ فيها أكثرُ من سبعينَ مليونَ إنسان، نحوُ ثلاثةٍ من كلِّ مئةِ شخصٍ على الأرض.", "start": 13.1, "end": 19.32, "words": [["قُتِلَ", 13.1, 13.47], ["فيها", 13.51, 13.73], ["أكثرُ", 13.8, 14.18], ["من", 14.21, 14.29], ["سبعينَ", 14.36, 14.73], ["مليونَ", 14.78, 15.07], ["إنسان،", 15.12, 15.76], ["نحوُ", 16.0, 16.32], ["ثلاثةٍ", 16.39, 17.0], ["من", 17.07, 17.19], ["كلِّ", 17.26, 17.54], ["مئةِ", 17.58, 17.88], ["شخصٍ", 17.96, 18.41], ["على", 18.58, 18.79], ["الأرض.", 18.82, 19.32]]}, {"text": "لو لم تَقُم، لعاشَ هؤلاء، ولَوُلِدَ أبناؤهم وأحفادُهم: ملايينُ العائلاتِ التي لم توجدْ أبداً.", "start": 19.7, "end": 27.11, "words": [["لو", 19.7, 19.85], ["لم", 19.9, 20.0], ["تَقُم،", 20.1, 20.66], ["لعاشَ", 20.84, 21.29], ["هؤلاء،", 21.33, 22.04], ["ولَوُلِدَ", 22.24, 22.86], ["أبناؤهم", 22.91, 23.51], ["وأحفادُهم:", 23.59, 24.37], ["ملايينُ", 24.68, 25.18], ["العائلاتِ", 25.2, 25.76], ["التي", 25.77, 26.03], ["لم", 26.09, 26.18], ["توجدْ", 26.26, 26.56], ["أبداً.", 26.6, 27.11]]}, {"text": "ومدنٌ مثلُ وارسو، التي دُمِّرَ أكثرُ من ثمانينَ في المئةِ منها، كانت ستبقى كما هي.", "start": 27.38, "end": 33.74, "words": [["ومدنٌ", 27.38, 28.0], ["مثلُ", 28.07, 28.35], ["وارسو،", 28.41, 28.95], ["التي", 29.19, 29.54], ["دُمِّرَ", 29.61, 29.96], ["أكثرُ", 30.01, 30.38], ["من", 30.42, 30.51], ["ثمانينَ", 30.57, 31.02], ["في", 31.08, 31.15], ["المئةِ", 31.17, 31.53], ["منها،", 31.58, 32.03], ["كانت", 32.34, 32.6], ["ستبقى", 32.65, 33.08], ["كما", 33.15, 33.35], ["هي.", 33.4, 33.74]]}, {"text": "ولم تكنْ هيروشيما وناغازاكي لِتُضْرَبا بالقنبلةِ الذرّيّة.", "start": 34.11, "end": 38.38, "words": [["ولم", 34.11, 34.39], ["تكنْ", 34.46, 34.78], ["هيروشيما", 34.83, 35.52], ["وناغازاكي", 35.71, 36.4], ["لِتُضْرَبا", 36.44, 37.06], ["بالقنبلةِ", 37.14, 37.77], ["الذرّيّة.", 37.79, 38.38]]}, {"text": "لكنّ الحربَ سرّعتِ العلمَ بشكلٍ هائل.", "start": 38.81, "end": 41.49, "words": [["لكنّ", 38.81, 39.18], ["الحربَ", 39.22, 39.65], ["سرّعتِ", 39.72, 40.16], ["العلمَ", 40.18, 40.52], ["بشكلٍ", 40.56, 40.96], ["هائل.", 41.02, 41.49]]}, {"text": "البنسلين اكتُشِفَ عامَ ألفٍ وتسعِمئةٍ وثمانيةٍ وعشرين، لكنّ الحربَ وحدَها جعلت المصانعَ تُنتجُ منه ملايينَ الجُرعات.", "start": 42.0, "end": 50.5, "words": [["البنسلين", 42.0, 42.59], ["اكتُشِفَ", 42.63, 43.13], ["عامَ", 43.19, 43.41], ["ألفٍ", 43.45, 43.75], ["وتسعِمئةٍ", 43.8, 44.48], ["وثمانيةٍ", 44.53, 45.13], ["وعشرين،", 45.19, 45.86], ["لكنّ", 46.18, 46.54], ["الحربَ", 46.58, 46.93], ["وحدَها", 46.98, 47.54], ["جعلت", 47.75, 48.18], ["المصانعَ", 48.23, 48.77], ["تُنتجُ", 48.82, 49.2], ["منه", 49.24, 49.41], ["ملايينَ", 49.49, 49.88], ["الجُرعات.", 49.9, 50.5]]}, {"text": "وأوّلُ الحواسيبِ الإلكترونيّةِ بُنِيَت لكسرِ الشيفراتِ وحسابِ مساراتِ القذائف.", "start": 50.89, "end": 56.24, "words": [["وأوّلُ", 50.89, 51.31], ["الحواسيبِ", 51.34, 51.87], ["الإلكترونيّةِ", 51.9, 52.81], ["بُنِيَت", 53.14, 53.54], ["لكسرِ", 53.6, 53.96], ["الشيفراتِ", 53.98, 54.58], ["وحسابِ", 54.6, 55.08], ["مساراتِ", 55.11, 55.52], ["القذائف.", 55.54, 56.24]]}, {"text": "وأوّلُ مفاعلٍ نوويٍّ، وأوّلُ صاروخٍ يصلُ إلى الفضاء، وُلِدا في الحربِ أيضاً.", "start": 56.56, "end": 62.26, "words": [["وأوّلُ", 56.56, 57.05], ["مفاعلٍ", 57.1, 57.57], ["نوويٍّ،", 57.61, 58.32], ["وأوّلُ", 58.52, 59.04], ["صاروخٍ", 59.1, 59.58], ["يصلُ", 59.65, 59.96], ["إلى", 60.0, 60.09], ["الفضاء،", 60.13, 60.73], ["وُلِدا", 60.91, 61.31], ["في", 61.37, 61.43], ["الحربِ", 61.45, 61.79], ["أيضاً.", 61.82, 62.26]]}, {"text": "وبعدَها ضعُفتِ الإمبراطوريّات، فاستقلّت أكثرُ من ثمانينَ مستعمرة.", "start": 62.59, "end": 67.08, "words": [["وبعدَها", 62.59, 63.08], ["ضعُفتِ", 63.13, 63.46], ["الإمبراطوريّات،", 63.49, 64.62], ["فاستقلّت", 64.79, 65.46], ["أكثرُ", 65.53, 65.85], ["من", 65.89, 65.98], ["ثمانينَ", 66.03, 66.41], ["مستعمرة.", 66.45, 67.08]]}, {"text": "بلا الحرب، ربّما بقيَ كثيرٌ منها مستعمَراً لعقودٍ أطول.", "start": 67.46, "end": 71.74, "words": [["بلا", 67.46, 67.66], ["الحرب،", 67.69, 68.17], ["ربّما", 68.27, 68.6], ["بقيَ", 68.67, 68.98], ["كثيرٌ", 69.04, 69.42], ["منها", 69.46, 69.7], ["مستعمَراً", 69.76, 70.41], ["لعقودٍ", 70.74, 71.26], ["أطول.", 71.3, 71.74]]}, {"text": "والغريب؟ الميكرويف في مطبخِك وُلِدَ من رادارِ الحرب، حينَ ذابت قطعةُ شوكولاتة في جيبِ مهندسٍ قربَ جهازِ رادار.", "start": 72.12, "end": 79.57, "words": [["والغريب؟", 72.12, 72.82], ["الميكرويف", 73.14, 73.76], ["في", 73.81, 73.9], ["مطبخِك", 73.98, 74.47], ["وُلِدَ", 74.52, 74.78], ["من", 74.83, 74.88], ["رادارِ", 74.92, 75.22], ["الحرب،", 75.24, 75.8], ["حينَ", 75.97, 76.21], ["ذابت", 76.26, 76.53], ["قطعةُ", 76.6, 76.95], ["شوكولاتة", 77.01, 77.42], ["في", 77.47, 77.54], ["جيبِ", 77.61, 77.83], ["مهندسٍ", 77.88, 78.44], ["قربَ", 78.53, 78.77], ["جهازِ", 78.83, 79.1], ["رادار.", 79.14, 79.57]]}, {"text": "برأيك، هل كان العالمُ سيصبحُ أفضل؟ اكتبْ في التعليقات، واشتركْ.", "start": 80.27, "end": 84.94, "words": [["برأيك،", 80.27, 80.87], ["هل", 81.05, 81.19], ["كان", 81.26, 81.42], ["العالمُ", 81.45, 81.8], ["سيصبحُ", 81.85, 82.29], ["أفضل؟", 82.33, 82.8], ["اكتبْ", 83.18, 83.5], ["في", 83.52, 83.58], ["التعليقات،", 83.61, 84.17], ["واشتركْ.", 84.19, 84.94]]}]