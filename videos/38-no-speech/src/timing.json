[{"text": "ماذا لو فقدَ كلُّ البشرِ القدرةَ على الكلامِ… فجأةً؟", "start": 0.0, "end": 3.88, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.44], ["فقدَ", 0.49, 0.8], ["كلُّ", 0.87, 1.11], ["البشرِ", 1.14, 1.54], ["القدرةَ", 1.57, 2.06], ["على", 2.11, 2.22], ["الكلامِ…", 2.25, 2.83], ["فجأةً؟", 3.16, 3.88]]}, {"text": "يقولُ الواحدُ منّا نحوَ ستّةَ عشرَ ألفَ كلمةٍ في اليوم… وفجأةً، صمتٌ تامّ.", "start": 4.25, "end": 10.28, "words": [["يقولُ", 4.25, 4.61], ["الواحدُ", 4.63, 5.02], ["منّا", 5.06, 5.27], ["نحوَ", 5.35, 5.6], ["ستّةَ", 5.65, 6.14], ["عشرَ", 6.34, 6.71], ["ألفَ", 6.73, 6.97], ["كلمةٍ", 7.01, 7.43], ["في", 7.5, 7.57], ["اليوم…", 7.59, 8.1], ["وفجأةً،", 8.42, 9.24], ["صمتٌ", 9.42, 9.78], ["تامّ.", 9.86, 10.28]]}, {"text": "نحوُ سبعةِ آلافِ لغةٍ على الأرض… تسكتُ في لحظةٍ واحدة.", "start": 10.65, "end": 14.71, "words": [["نحوُ", 10.65, 10.94], ["سبعةِ", 11.02, 11.37], ["آلافِ", 11.42, 11.7], ["لغةٍ", 11.75, 12.07], ["على", 12.13, 12.25], ["الأرض…", 12.27, 12.85], ["تسكتُ", 13.17, 13.57], ["في", 13.64, 13.71], ["لحظةٍ", 13.77, 14.14], ["واحدة.", 14.21, 14.71]]}, {"text": "لا مكالماتٍ في الهواتف، والإذاعاتُ صامتة… والأغاني بلا كلمات.", "start": 15.08, "end": 19.63, "words": [["لا", 15.08, 15.22], ["مكالماتٍ", 15.27, 15.81], ["في", 15.87, 15.93], ["الهواتف،", 15.95, 16.58], ["والإذاعاتُ", 16.7, 17.31], ["صامتة…", 17.38, 17.98], ["والأغاني", 18.18, 18.73], ["بلا", 18.79, 18.97], ["كلمات.", 19.02, 19.63]]}, {"text": "والأخطر: الطوارئ. لا أحدَ يستطيعُ أن يصرخَ «انتبهْ!»… ولا أن يطلبَ الإسعافَ بصوته.", "start": 19.96, "end": 26.25, "words": [["والأخطر:", 19.96, 20.58], ["الطوارئ.", 20.75, 21.45], ["لا", 21.76, 21.89], ["أحدَ", 21.92, 22.2], ["يستطيعُ", 22.25, 22.63], ["أن", 22.66, 22.76], ["يصرخَ", 22.8, 23.25], ["«انتبهْ!»…", 23.28, 24.01], ["ولا", 24.31, 24.57], ["أن", 24.62, 24.74], ["يطلبَ", 24.8, 25.12], ["الإسعافَ", 25.15, 25.65], ["بصوته.", 25.69, 26.25]]}, {"text": "لكنّ البشرَ لن يبقَوا صامتين: الرسائلُ والكتابةُ ستصبحُ صوتَنا.", "start": 26.61, "end": 31.17, "words": [["لكنّ", 26.61, 26.93], ["البشرَ", 26.96, 27.34], ["لن", 27.39, 27.52], ["يبقَوا", 27.57, 27.84], ["صامتين:", 27.88, 28.53], ["الرسائلُ", 28.82, 29.43], ["والكتابةُ", 29.47, 30.07], ["ستصبحُ", 30.13, 30.61], ["صوتَنا.", 30.67, 31.17]]}, {"text": "ووجوهُنا تتكلّم: الفرحُ والخوفُ والغضبُ تفهمُها معظمُ الشعوبِ بلا كلمة.", "start": 31.43, "end": 37.06, "words": [["ووجوهُنا", 31.43, 32.05], ["تتكلّم:", 32.11, 32.88], ["الفرحُ", 33.06, 33.54], ["والخوفُ", 33.59, 34.04], ["والغضبُ", 34.06, 34.61], ["تفهمُها", 34.87, 35.45], ["معظمُ", 35.53, 35.91], ["الشعوبِ", 35.93, 36.33], ["بلا", 36.37, 36.54], ["كلمة.", 36.59, 37.06]]}, {"text": "والأهمّ: لغاتُ الإشارة. أكثرُ من ثلاثِمئةِ لغةٍ… يستخدمُها اليومَ ملايينُ الصُّمّ.", "start": 37.36, "end": 43.89, "words": [["والأهمّ:", 37.36, 38.07], ["لغاتُ", 38.23, 38.63], ["الإشارة.", 38.66, 39.27], ["أكثرُ", 39.58, 40.02], ["من", 40.05, 40.14], ["ثلاثِمئةِ", 40.18, 40.85], ["لغةٍ…", 40.9, 41.53], ["يستخدمُها", 41.84, 42.47], ["اليومَ", 42.49, 42.83], ["ملايينُ", 42.89, 43.35], ["الصُّمّ.", 43.38, 43.89]]}, {"text": "والغريب؟ في نيكاراغوا، أطفالٌ صُمٌّ اخترعوا وحدَهم لغةَ إشارةٍ كاملة… في سنواتٍ قليلة.", "start": 44.19, "end": 50.98, "words": [["والغريب؟", 44.19, 44.92], ["في", 45.19, 45.29], ["نيكاراغوا،", 45.37, 46.12], ["أطفالٌ", 46.22, 46.68], ["صُمٌّ", 46.78, 47.18], ["اخترعوا", 47.21, 47.7], ["وحدَهم", 47.74, 48.19], ["لغةَ", 48.26, 48.56], ["إشارةٍ", 48.6, 49.03], ["كاملة…", 49.1, 49.61], ["في", 49.88, 49.97], ["سنواتٍ", 50.04, 50.43], ["قليلة.", 50.5, 50.98]]}, {"text": "وفي الظلام؟ سنتكلّمُ باللمس… كما يفعلُ الصمُّ المكفوفون.", "start": 51.28, "end": 55.66, "words": [["وفي", 51.28, 51.52], ["الظلام؟", 51.56, 52.15], ["سنتكلّمُ", 52.35, 53.05], ["باللمس…", 53.1, 53.74], ["كما", 53.94, 54.17], ["يفعلُ", 54.24, 54.57], ["الصمُّ", 54.58, 54.93], ["المكفوفون.", 54.95, 55.66]]}, {"text": "هل كنتَ ستتأقلم؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 55.96, "end": 59.95, "words": [["هل", 55.96, 56.11], ["كنتَ", 56.16, 56.39], ["ستتأقلم؟", 56.44, 57.19], ["اكتبْ", 57.23, 57.6], ["جوابَك", 57.64, 58.06], ["في", 58.16, 58.22], ["التعليقات…", 58.25, 58.97], ["واشتركْ.", 59.14, 59.95]]}]