[{"text": "ماذا لو سقطَ نيزكٌ بحجمِ مدينةٍ على الأرض؟", "start": 0.0, "end": 3.11, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.45], ["سقطَ", 0.52, 0.89], ["نيزكٌ", 0.95, 1.41], ["بحجمِ", 1.47, 1.88], ["مدينةٍ", 1.94, 2.42], ["على", 2.47, 2.61], ["الأرض؟", 2.63, 3.11]]}, {"text": "صخرةٌ عرضُها عشرةُ كيلومترات، تندفعُ بسرعةِ عشرينَ كيلومتراً في الثانية.", "start": 3.54, "end": 9.21, "words": [["صخرةٌ", 3.54, 3.98], ["عرضُها", 4.1, 4.54], ["عشرةُ", 4.61, 5.05], ["كيلومترات،", 5.13, 5.99], ["تندفعُ", 6.42, 7.0], ["بسرعةِ", 7.05, 7.56], ["عشرينَ", 7.59, 7.98], ["كيلومتراً", 8.05, 8.52], ["في", 8.57, 8.63], ["الثانية.", 8.66, 9.21]]}, {"text": "تدخلُ الغلافَ الجوّيّ… فتتحوّلُ إلى كرةِ نارٍ أسطعَ من الشمس.", "start": 9.62, "end": 14.44, "words": [["تدخلُ", 9.62, 10.08], ["الغلافَ", 10.11, 10.55], ["الجوّيّ…", 10.59, 11.3], ["فتتحوّلُ", 11.56, 12.41], ["إلى", 12.46, 12.6], ["كرةِ", 12.67, 12.98], ["نارٍ", 13.03, 13.29], ["أسطعَ", 13.35, 13.71], ["من", 13.73, 13.84], ["الشمس.", 13.89, 14.44]]}, {"text": "ثمّ تضربُ الأرض، بطاقةٍ أقوى من كلِّ القنابلِ النوويةِ في العالمِ مجتمعةً… بآلافِ المرّات.", "start": 14.76, "end": 21.56, "words": [["ثمّ", 14.76, 15.02], ["تضربُ", 15.08, 15.43], ["الأرض،", 15.45, 15.97], ["بطاقةٍ", 16.14, 16.68], ["أقوى", 16.75, 17.08], ["من", 17.12, 17.23], ["كلِّ", 17.28, 17.53], ["القنابلِ", 17.55, 18.08], ["النوويةِ", 18.1, 18.75], ["في", 18.81, 18.88], ["العالمِ", 18.91, 19.41], ["مجتمعةً…", 19.45, 20.16], ["بآلافِ", 20.47, 20.94], ["المرّات.", 20.97, 21.56]]}, {"text": "حفرةٌ عرضُها نحوُ مئةٍ وثمانينَ كيلومتراً، وموجةُ صدمةٍ تسوّي الغاباتِ بالأرض.", "start": 21.92, "end": 28.03, "words": [["حفرةٌ", 21.92, 22.45], ["عرضُها", 22.56, 22.96], ["نحوُ", 23.03, 23.31], ["مئةٍ", 23.37, 23.71], ["وثمانينَ", 23.77, 24.3], ["كيلومتراً،", 24.37, 25.12], ["وموجةُ", 25.39, 25.95], ["صدمةٍ", 26.03, 26.47], ["تسوّي", 26.54, 26.9], ["الغاباتِ", 26.92, 27.41], ["بالأرض.", 27.47, 28.03]]}, {"text": "وإن سقطَ في البحر، تنطلقُ أمواجُ تسونامي بارتفاعِ مئاتِ الأمتار.", "start": 28.33, "end": 33.34, "words": [["وإن", 28.33, 28.61], ["سقطَ", 28.66, 29.04], ["في", 29.09, 29.15], ["البحر،", 29.19, 29.79], ["تنطلقُ", 29.95, 30.58], ["أمواجُ", 30.63, 31.06], ["تسونامي", 31.1, 31.71], ["بارتفاعِ", 31.87, 32.44], ["مئاتِ", 32.45, 32.76], ["الأمتار.", 32.79, 33.34]]}, {"text": "ثمّ يحدثُ الأسوأ: صخورٌ مشتعلةٌ تتساقطُ من السماءِ في كلِّ مكان، وتشعلُ الحرائق.", "start": 33.7, "end": 39.93, "words": [["ثمّ", 33.7, 33.95], ["يحدثُ", 33.99, 34.34], ["الأسوأ:", 34.38, 34.98], ["صخورٌ", 35.29, 35.82], ["مشتعلةٌ", 35.85, 36.48], ["تتساقطُ", 36.55, 37.13], ["من", 37.18, 37.27], ["السماءِ", 37.31, 37.69], ["في", 37.72, 37.79], ["كلِّ", 37.86, 38.06], ["مكان،", 38.08, 38.58], ["وتشعلُ", 38.77, 39.3], ["الحرائق.", 39.32, 39.93]]}, {"text": "ويرتفعُ الغبارُ والسخامُ إلى السماء، فيحجبُ الشمسَ لسنوات. فتبردُ الأرض، وتموتُ النباتات… ثمّ الحيواناتُ التي تأكلُها.", "start": 40.22, "end": 49.25, "words": [["ويرتفعُ", 40.22, 40.83], ["الغبارُ", 40.86, 41.31], ["والسخامُ", 41.34, 41.87], ["إلى", 41.9, 42.01], ["السماء،", 42.03, 42.61], ["فيحجبُ", 42.87, 43.38], ["الشمسَ", 43.4, 43.72], ["لسنوات.", 43.76, 44.38], ["فتبردُ", 44.69, 45.23], ["الأرض،", 45.27, 45.79], ["وتموتُ", 45.92, 46.38], ["النباتات…", 46.39, 47.18], ["ثمّ", 47.48, 47.73], ["الحيواناتُ", 47.75, 48.33], ["التي", 48.36, 48.59], ["تأكلُها.", 48.65, 49.25]]}, {"text": "وهذا ما حدثَ فعلاً قبلَ ستّةٍ وستّينَ مليونَ سنة… فانتهى عصرُ الديناصورات.", "start": 49.51, "end": 55.29, "words": [["وهذا", 49.51, 49.82], ["ما", 49.87, 49.92], ["حدثَ", 49.97, 50.27], ["فعلاً", 50.33, 50.75], ["قبلَ", 50.9, 51.17], ["ستّةٍ", 51.23, 51.71], ["وستّينَ", 51.97, 52.57], ["مليونَ", 52.63, 52.98], ["سنة…", 53.05, 53.46], ["فانتهى", 53.77, 54.17], ["عصرُ", 54.21, 54.5], ["الديناصورات.", 54.51, 55.29]]}, {"text": "لكن لا تقلق: العلماءُ يراقبونَ السماء. وفي عامِ ألفينِ واثنينِ وعشرين، نجحتْ مركبةٌ في تغييرِ مسارِ كويكبٍ صغير.", "start": 55.69, "end": 64.28, "words": [["لكن", 55.69, 55.94], ["لا", 55.98, 56.06], ["تقلق:", 56.11, 56.65], ["العلماءُ", 56.9, 57.51], ["يراقبونَ", 57.55, 58.09], ["السماء.", 58.11, 58.71], ["وفي", 59.09, 59.34], ["عامِ", 59.42, 59.59], ["ألفينِ", 59.63, 59.98], ["واثنينِ", 60.01, 60.35], ["وعشرين،", 60.38, 61.07], ["نجحتْ", 61.28, 61.75], ["مركبةٌ", 61.8, 62.32], ["في", 62.4, 62.47], ["تغييرِ", 62.57, 62.96], ["مسارِ", 63.01, 63.34], ["كويكبٍ", 63.39, 63.75], ["صغير.", 63.81, 64.28]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 64.61, "end": 71.24, "words": [["والآن", 64.61, 64.95], ["دورُك:", 64.98, 65.49], ["ماذا", 65.74, 66.02], ["لو…؟", 66.06, 66.63], ["اكتبْ", 67.14, 67.54], ["سؤالَك", 67.57, 67.97], ["في", 68.08, 68.14], ["التعليقات،", 68.16, 69.0], ["وقد", 69.15, 69.49], ["يكونُ", 69.56, 69.93], ["الفيديو", 69.96, 70.38], ["القادم.", 70.4, 71.24]]}]