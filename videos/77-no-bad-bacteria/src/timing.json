[{"text": "ماذا لو اختفتْ كلُّ البكتيريا الضارّةِ من العالمِ فجأة؟", "start": 0.0, "end": 3.51, "words": [["ماذا", 0.0, 0.31], ["لو", 0.35, 0.48], ["اختفتْ", 0.5, 0.96], ["كلُّ", 0.99, 1.26], ["البكتيريا", 1.29, 1.82], ["الضارّةِ", 1.85, 2.37], ["من", 2.4, 2.5], ["العالمِ", 2.55, 2.95], ["فجأة؟", 3.02, 3.51]]}, {"text": "في جسمِك الآنَ نحوُ ثمانيةٍ وثلاثينَ تريليونَ بكتيريا، أكثرُ من خلاياك نفسِها.", "start": 3.82, "end": 10.34, "words": [["في", 3.82, 3.94], ["جسمِك", 4.05, 4.47], ["الآنَ", 4.54, 5.02], ["نحوُ", 5.12, 5.42], ["ثمانيةٍ", 5.49, 6.17], ["وثلاثينَ", 6.26, 6.85], ["تريليونَ", 6.9, 7.55], ["بكتيريا،", 7.85, 8.57], ["أكثرُ", 8.8, 9.2], ["من", 9.24, 9.32], ["خلاياك", 9.38, 9.76], ["نفسِها.", 9.85, 10.34]]}, {"text": "معظمُها صديقة: تساعدُ على هضمِ طعامِك وتحميك. لكنّ القليلَ منها قاتل.", "start": 10.76, "end": 16.54, "words": [["معظمُها", 10.76, 11.32], ["صديقة:", 11.4, 12.02], ["تساعدُ", 12.25, 12.82], ["على", 12.88, 13.03], ["هضمِ", 13.08, 13.32], ["طعامِك", 13.38, 13.77], ["وتحميك.", 13.87, 14.58], ["لكنّ", 14.88, 15.24], ["القليلَ", 15.27, 15.66], ["منها", 15.72, 15.95], ["قاتل.", 16.07, 16.54]]}, {"text": "فالسُّلُّ وحدَه يقتلُ أكثرَ من مليونِ إنسانٍ كلَّ عام، والعدوى البكتيريّةُ ترتبطُ بواحدةٍ من كلِّ ثماني وفياتٍ في العالم.", "start": 16.85, "end": 25.46, "words": [["فالسُّلُّ", 16.85, 17.33], ["وحدَه", 17.36, 17.72], ["يقتلُ", 17.77, 18.18], ["أكثرَ", 18.24, 18.58], ["من", 18.61, 18.71], ["مليونِ", 18.76, 19.11], ["إنسانٍ", 19.17, 19.68], ["كلَّ", 19.82, 20.13], ["عام،", 20.18, 20.57], ["والعدوى", 20.8, 21.23], ["البكتيريّةُ", 21.26, 21.94], ["ترتبطُ", 22.02, 22.52], ["بواحدةٍ", 22.58, 23.28], ["من", 23.34, 23.46], ["كلِّ", 23.55, 23.84], ["ثماني", 23.88, 24.22], ["وفياتٍ", 24.29, 24.75], ["في", 24.81, 24.87], ["العالم.", 24.9, 25.46]]}, {"text": "بلا بكتيريا ضارّة: لا كوليرا، ولا طاعون، ولا تسمّمَ طعامٍ بكتيريّ.", "start": 25.84, "end": 31.54, "words": [["بلا", 25.84, 26.06], ["بكتيريا", 26.11, 26.55], ["ضارّة:", 26.62, 27.14], ["لا", 27.32, 27.46], ["كوليرا،", 27.54, 28.15], ["ولا", 28.33, 28.58], ["طاعون،", 28.66, 29.3], ["ولا", 29.45, 29.71], ["تسمّمَ", 29.77, 30.29], ["طعامٍ", 30.37, 30.78], ["بكتيريّ.", 30.85, 31.54]]}, {"text": "وتصبحُ العمليّاتُ الجراحيّةُ أكثرَ أماناً، ولا نخافُ من البكتيريا المقاومةِ للمضادّات.", "start": 31.87, "end": 38.35, "words": [["وتصبحُ", 31.87, 32.52], ["العمليّاتُ", 32.54, 33.16], ["الجراحيّةُ", 33.18, 33.89], ["أكثرَ", 33.96, 34.27], ["أماناً،", 34.32, 34.93], ["ولا", 35.26, 35.52], ["نخافُ", 35.56, 35.98], ["من", 36.02, 36.12], ["البكتيريا", 36.16, 36.67], ["المقاومةِ", 36.7, 37.42], ["للمضادّات.", 37.47, 38.35]]}, {"text": "لكنْ هنا المشكلة: من يحدّدُ أيُّها ضارّ؟", "start": 38.67, "end": 41.63, "words": [["لكنْ", 38.67, 38.99], ["هنا", 39.02, 39.18], ["المشكلة:", 39.21, 39.86], ["من", 40.16, 40.26], ["يحدّدُ", 40.36, 40.8], ["أيُّها", 40.85, 41.16], ["ضارّ؟", 41.23, 41.63]]}, {"text": "البكتيريا العنقوديّةُ تعيشُ في أنوفِ نحوِ ثلثِ البشرِ دونَ ضرر، لكنّها قد تقتلُ إذا دخلتِ الدم.", "start": 41.94, "end": 49.05, "words": [["البكتيريا", 41.94, 42.48], ["العنقوديّةُ", 42.5, 43.26], ["تعيشُ", 43.52, 43.93], ["في", 43.99, 44.07], ["أنوفِ", 44.14, 44.48], ["نحوِ", 44.53, 44.81], ["ثلثِ", 44.9, 45.23], ["البشرِ", 45.26, 45.87], ["دونَ", 46.01, 46.24], ["ضرر،", 46.31, 46.79], ["لكنّها", 47.02, 47.4], ["قد", 47.51, 47.62], ["تقتلُ", 47.67, 48.02], ["إذا", 48.04, 48.18], ["دخلتِ", 48.25, 48.59], ["الدم.", 48.61, 49.05]]}, {"text": "والإشريكيّةُ القولونيّةُ في أمعائك: معظمُ سلالاتِها مفيدة، وبعضُها خطير.", "start": 49.41, "end": 54.98, "words": [["والإشريكيّةُ", 49.41, 50.21], ["القولونيّةُ", 50.25, 50.98], ["في", 51.04, 51.12], ["أمعائك:", 51.16, 51.8], ["معظمُ", 52.0, 52.37], ["سلالاتِها", 52.43, 53.0], ["مفيدة،", 53.06, 53.63], ["وبعضُها", 53.81, 54.35], ["خطير.", 54.42, 54.98]]}, {"text": "والمفاجأة: جهازُ المناعةِ يتدرّبُ على الجراثيمِ منذُ ولادتِك، وبدونِها قد يرتبكُ ويهاجمُ أشياءَ بريئةً كحبوبِ اللقاح.", "start": 55.29, "end": 65.55, "words": [["والمفاجأة:", 55.29, 56.17], ["جهازُ", 56.44, 56.82], ["المناعةِ", 56.84, 57.38], ["يتدرّبُ", 57.53, 58.11], ["على", 58.15, 58.27], ["الجراثيمِ", 58.29, 58.94], ["منذُ", 59.06, 59.38], ["ولادتِك،", 59.41, 60.13], ["وبدونِها", 60.41, 61.12], ["قد", 61.23, 61.38], ["يرتبكُ", 61.45, 62.07], ["ويهاجمُ", 62.34, 63.02], ["أشياءَ", 63.05, 63.46], ["بريئةً", 63.51, 64.08], ["كحبوبِ", 64.32, 64.88], ["اللقاح.", 64.9, 65.55]]}, {"text": "هل كنتَ ستمسحُ البكتيريا الضارّة؟ اكتبْ في التعليقات، واشتركْ.", "start": 65.88, "end": 71.01, "words": [["هل", 65.88, 66.03], ["كنتَ", 66.07, 66.33], ["ستمسحُ", 66.37, 66.9], ["البكتيريا", 66.92, 67.44], ["الضارّة؟", 67.47, 68.14], ["اكتبْ", 68.52, 68.91], ["في", 68.93, 68.99], ["التعليقات،", 69.02, 69.9], ["واشتركْ.", 70.11, 71.01]]}]