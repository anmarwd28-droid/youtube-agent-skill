[{"text": "تخيّلْ أن تستيقظَ غداً… وكلُّ الحيواناتِ على الأرضِ قد اختفت. إلا الإنسان.", "start": 0.0, "end": 5.65, "words": [["تخيّلْ", 0.0, 0.45], ["أن", 0.48, 0.56], ["تستيقظَ", 0.6, 1.2], ["غداً…", 1.24, 1.74], ["وكلُّ", 2.0, 2.43], ["الحيواناتِ", 2.45, 3.1], ["على", 3.16, 3.26], ["الأرضِ", 3.29, 3.61], ["قد", 3.67, 3.81], ["اختفت.", 3.83, 4.42], ["إلا", 4.68, 4.89], ["الإنسان.", 4.91, 5.65]]}, {"text": "لا طيورَ في السماء، ولا أسماكَ في البحر… ولا حتى قطّةٌ في الشارع.", "start": 6.0, "end": 10.93, "words": [["لا", 6.0, 6.12], ["طيورَ", 6.2, 6.5], ["في", 6.56, 6.62], ["السماء،", 6.64, 7.21], ["ولا", 7.36, 7.61], ["أسماكَ", 7.63, 8.07], ["في", 8.13, 8.17], ["البحر…", 8.21, 8.77], ["ولا", 9.02, 9.28], ["حتى", 9.35, 9.67], ["قطّةٌ", 9.78, 10.21], ["في", 10.29, 10.33], ["الشارع.", 10.37, 10.93]]}, {"text": "أوّلُ ما ستلاحظُه هو الصمت. لا تغريد، ولا نباح، ولا طنين.", "start": 11.21, "end": 16.16, "words": [["أوّلُ", 11.21, 11.56], ["ما", 11.6, 11.67], ["ستلاحظُه", 11.74, 12.5], ["هو", 12.56, 12.74], ["الصمت.", 12.79, 13.3], ["لا", 13.61, 13.73], ["تغريد،", 13.78, 14.37], ["ولا", 14.48, 14.72], ["نباح،", 14.77, 15.24], ["ولا", 15.3, 15.56], ["طنين.", 15.63, 16.16]]}, {"text": "ثمّ تفتحُ الثلّاجة: لا لحم، ولا بيض، ولا حليب… ولا عسل.", "start": 16.51, "end": 21.05, "words": [["ثمّ", 16.51, 16.75], ["تفتحُ", 16.82, 17.21], ["الثلّاجة:", 17.22, 17.93], ["لا", 18.09, 18.2], ["لحم،", 18.26, 18.59], ["ولا", 18.61, 18.77], ["بيض،", 18.84, 19.14], ["ولا", 19.17, 19.38], ["حليب…", 19.42, 19.97], ["ولا", 20.22, 20.48], ["عسل.", 20.54, 21.05]]}, {"text": "وبدونِ النحلِ وبقيّةِ الملقّحات، تقلُّ الفواكهُ والخضارُ في كلِّ مكان.", "start": 21.21, "end": 26.53, "words": [["وبدونِ", 21.21, 21.7], ["النحلِ", 21.72, 22.15], ["وبقيّةِ", 22.21, 22.78], ["الملقّحات،", 22.8, 23.71], ["تقلُّ", 23.97, 24.36], ["الفواكهُ", 24.38, 25.0], ["والخضارُ", 25.02, 25.6], ["في", 25.65, 25.72], ["كلِّ", 25.79, 25.99], ["مكان.", 26.03, 26.53]]}, {"text": "وفي البحار، تموتُ الشعابُ المرجانية… لأنّها هي نفسُها حيوانات.", "start": 26.84, "end": 31.6, "words": [["وفي", 26.84, 27.06], ["البحار،", 27.1, 27.61], ["تموتُ", 27.66, 28.01], ["الشعابُ", 28.04, 28.47], ["المرجانية…", 28.49, 29.36], ["لأنّها", 29.63, 30.14], ["هي", 30.18, 30.37], ["نفسُها", 30.44, 30.85], ["حيوانات.", 30.92, 31.6]]}, {"text": "وتحتَ أقدامِنا، تختفي ديدانُ الأرض، التي تحرثُ التربةَ وتخصّبُها.", "start": 31.9, "end": 37.19, "words": [["وتحتَ", 31.9, 32.33], ["أقدامِنا،", 32.37, 33.13], ["تختفي", 33.31, 33.7], ["ديدانُ", 33.78, 34.13], ["الأرض،", 34.16, 34.62], ["التي", 34.86, 35.14], ["تحرثُ", 35.22, 35.64], ["التربةَ", 35.68, 36.2], ["وتخصّبُها.", 36.26, 37.19]]}, {"text": "أمّا الأشجارُ التي تعتمدُ على الطيورِ لنشرِ بذورِها، فلن تجدَ من يحملُها بعيداً.", "start": 37.5, "end": 43.08, "words": [["أمّا", 37.5, 37.74], ["الأشجارُ", 37.77, 38.3], ["التي", 38.31, 38.56], ["تعتمدُ", 38.61, 39.1], ["على", 39.16, 39.28], ["الطيورِ", 39.31, 39.77], ["لنشرِ", 39.8, 40.26], ["بذورِها،", 40.31, 41.01], ["فلن", 41.25, 41.53], ["تجدَ", 41.59, 41.91], ["من", 41.96, 42.06], ["يحملُها", 42.12, 42.5], ["بعيداً.", 42.56, 43.08]]}, {"text": "وسيعيشُ الإنسانُ على النباتاتِ وحدَها… في عالمٍ أفقر، وأكثرَ صمتاً، وأكثرَ وحدة.", "start": 43.41, "end": 49.89, "words": [["وسيعيشُ", 43.41, 44.09], ["الإنسانُ", 44.12, 44.64], ["على", 44.7, 44.8], ["النباتاتِ", 44.84, 45.44], ["وحدَها…", 45.49, 46.11], ["في", 46.36, 46.46], ["عالمٍ", 46.58, 46.96], ["أفقر،", 47.01, 47.62], ["وأكثرَ", 47.83, 48.34], ["صمتاً،", 48.41, 48.91], ["وأكثرَ", 48.99, 49.42], ["وحدة.", 49.46, 49.89]]}, {"text": "فنحنُ لا نعيشُ وحدَنا على هذا الكوكب… ولا نستطيعُ أن نعيشَ وحدَنا.", "start": 50.21, "end": 54.7, "words": [["فنحنُ", 50.21, 50.63], ["لا", 50.7, 50.78], ["نعيشُ", 50.83, 51.25], ["وحدَنا", 51.27, 51.61], ["على", 51.65, 51.78], ["هذا", 51.83, 51.98], ["الكوكب…", 52.01, 52.62], ["ولا", 52.94, 53.16], ["نستطيعُ", 53.21, 53.66], ["أن", 53.7, 53.78], ["نعيشَ", 53.8, 54.14], ["وحدَنا.", 54.18, 54.7]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 55.02, "end": 61.07, "words": [["والآن", 55.02, 55.32], ["دورُك:", 55.37, 55.9], ["ماذا", 56.15, 56.4], ["لو…؟", 56.45, 56.98], ["اكتبْ", 57.23, 57.61], ["سؤالَك", 57.64, 58.04], ["في", 58.1, 58.15], ["التعليقات،", 58.18, 59.06], ["وقد", 59.18, 59.52], ["يكونُ", 59.61, 59.93], ["الفيديو", 59.95, 60.27], ["القادم.", 60.29, 61.07]]}]