[{"text": "ماذا لو كانت الأرضُ على شكلِ مثلّث؟", "start": 0.0, "end": 2.38, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.42], ["كانت", 0.5, 0.76], ["الأرضُ", 0.84, 1.2], ["على", 1.26, 1.39], ["شكلِ", 1.46, 1.71], ["مثلّث؟", 1.75, 2.38]]}, {"text": "تخيّلْها هرماً بأربعةِ وجوهٍ مثلّثة، بنفسِ حجمِ الأرضِ اليوم.", "start": 2.8, "end": 7.64, "words": [["تخيّلْها", 2.8, 3.4], ["هرماً", 3.5, 3.87], ["بأربعةِ", 3.92, 4.5], ["وجوهٍ", 4.57, 4.93], ["مثلّثة،", 4.98, 5.78], ["بنفسِ", 6.03, 6.43], ["حجمِ", 6.51, 6.8], ["الأرضِ", 6.84, 7.16], ["اليوم.", 7.19, 7.64]]}, {"text": "الجاذبيّةُ تسحبُ كلَّ شيءٍ نحوَ المركز، وأقربُ نقطةٍ إلى المركزِ هي وسطُ كلِّ وجه.", "start": 8.06, "end": 14.69, "words": [["الجاذبيّةُ", 8.06, 8.86], ["تسحبُ", 8.93, 9.37], ["كلَّ", 9.44, 9.65], ["شيءٍ", 9.71, 9.98], ["نحوَ", 10.03, 10.29], ["المركز،", 10.31, 11.03], ["وأقربُ", 11.23, 11.76], ["نقطةٍ", 11.81, 12.21], ["إلى", 12.27, 12.42], ["المركزِ", 12.46, 13.13], ["هي", 13.28, 13.48], ["وسطُ", 13.55, 13.89], ["كلِّ", 13.96, 14.2], ["وجه.", 14.23, 14.69]]}, {"text": "فتجري المحيطاتُ والهواءُ إلى هناك، ويصيرُ العالمُ أربعةَ بحارٍ مستديرةٍ فقط.", "start": 15.0, "end": 20.9, "words": [["فتجري", 15.0, 15.51], ["المحيطاتُ", 15.53, 16.16], ["والهواءُ", 16.21, 16.68], ["إلى", 16.74, 16.86], ["هناك،", 16.9, 17.37], ["ويصيرُ", 17.64, 18.22], ["العالمُ", 18.25, 18.68], ["أربعةَ", 18.73, 19.24], ["بحارٍ", 19.3, 19.74], ["مستديرةٍ", 19.78, 20.38], ["فقط.", 20.43, 20.9]]}, {"text": "ابتعدْ عن البحر، فتشعرُ أنّ الأرضَ المستويةَ تصعدُ كجبل. وعندَ الحافّة، يصبحُ الميلُ نحوَ خمسٍ وخمسينَ درجة.", "start": 21.28, "end": 29.89, "words": [["ابتعدْ", 21.28, 21.72], ["عن", 21.75, 21.83], ["البحر،", 21.87, 22.44], ["فتشعرُ", 22.69, 23.3], ["أنّ", 23.35, 23.52], ["الأرضَ", 23.56, 23.89], ["المستويةَ", 23.92, 24.66], ["تصعدُ", 24.71, 25.15], ["كجبل.", 25.2, 25.79], ["وعندَ", 26.11, 26.5], ["الحافّة،", 26.53, 27.18], ["يصبحُ", 27.39, 27.86], ["الميلُ", 27.89, 28.2], ["نحوَ", 28.26, 28.5], ["خمسٍ", 28.54, 28.85], ["وخمسينَ", 28.9, 29.35], ["درجة.", 29.41, 29.89]]}, {"text": "أمّا الزوايا، فترتفعُ أكثرَ من ثمانيةِ آلافِ كيلومتر، فوقَ الغلافِ الجوّيّ، في الفضاءِ تماماً.", "start": 30.22, "end": 36.94, "words": [["أمّا", 30.22, 30.48], ["الزوايا،", 30.5, 31.05], ["فترتفعُ", 31.08, 31.74], ["أكثرَ", 31.8, 32.15], ["من", 32.19, 32.28], ["ثمانيةِ", 32.33, 32.83], ["آلافِ", 32.9, 33.2], ["كيلومتر،", 33.27, 33.92], ["فوقَ", 34.2, 34.54], ["الغلافِ", 34.56, 35.0], ["الجوّيّ،", 35.03, 35.67], ["في", 35.76, 35.85], ["الفضاءِ", 35.89, 36.34], ["تماماً.", 36.4, 36.94]]}, {"text": "لا هواءَ هناك ولا ماء، فقط صخرٌ متجمّدٌ تحتَ النجوم.", "start": 37.38, "end": 41.4, "words": [["لا", 37.38, 37.5], ["هواءَ", 37.57, 37.88], ["هناك", 37.93, 38.29], ["ولا", 38.35, 38.52], ["ماء،", 38.58, 39.0], ["فقط", 39.16, 39.47], ["صخرٌ", 39.55, 39.87], ["متجمّدٌ", 39.91, 40.55], ["تحتَ", 40.61, 40.83], ["النجوم.", 40.85, 41.4]]}, {"text": "والغريب: الشمسُ تُشرقُ في اللحظةِ نفسِها على ربعِ العالمِ كلِّه، لأنّ الوجهَ مُستوٍ.", "start": 41.89, "end": 48.1, "words": [["والغريب:", 41.89, 42.6], ["الشمسُ", 42.86, 43.29], ["تُشرقُ", 43.36, 43.8], ["في", 43.86, 43.92], ["اللحظةِ", 43.94, 44.38], ["نفسِها", 44.43, 44.85], ["على", 44.92, 45.07], ["ربعِ", 45.14, 45.39], ["العالمِ", 45.41, 45.86], ["كلِّه،", 45.91, 46.42], ["لأنّ", 46.68, 46.95], ["الوجهَ", 46.98, 47.38], ["مُستوٍ.", 47.43, 48.1]]}, {"text": "وتعيشُ أربعُ حضاراتٍ منفصلة، تفصلُها جبالٌ لا يعبرُها أحد.", "start": 48.32, "end": 53.15, "words": [["وتعيشُ", 48.32, 48.87], ["أربعُ", 48.92, 49.26], ["حضاراتٍ", 49.31, 49.8], ["منفصلة،", 49.84, 50.6], ["تفصلُها", 50.79, 51.34], ["جبالٌ", 51.44, 51.9], ["لا", 52.03, 52.16], ["يعبرُها", 52.23, 52.69], ["أحد.", 52.71, 53.15]]}, {"text": "لكنّ المفاجأة: هذا الشكلُ لا يدوم! فكلُّ جسمٍ أكبرَ من بضعِ مئاتِ الكيلومترات، تجعلُه جاذبيّتُه كرة.", "start": 53.57, "end": 61.73, "words": [["لكنّ", 53.57, 53.88], ["المفاجأة:", 53.91, 54.71], ["هذا", 54.9, 55.14], ["الشكلُ", 55.16, 55.58], ["لا", 55.62, 55.7], ["يدوم!", 55.76, 56.26], ["فكلُّ", 56.56, 56.97], ["جسمٍ", 57.02, 57.34], ["أكبرَ", 57.42, 57.83], ["من", 57.88, 57.98], ["بضعِ", 58.05, 58.35], ["مئاتِ", 58.4, 58.72], ["الكيلومترات،", 58.75, 59.64], ["تجعلُه", 59.81, 60.37], ["جاذبيّتُه", 60.49, 61.17], ["كرة.", 61.29, 61.73]]}, {"text": "فتنهارُ الزوايا، وتهتزُّ الأرضُ بزلازلَ هائلة، حتّى تعودَ كرةً من جديد.", "start": 62.05, "end": 67.83, "words": [["فتنهارُ", 62.05, 62.66], ["الزوايا،", 62.68, 63.39], ["وتهتزُّ", 63.56, 64.19], ["الأرضُ", 64.22, 64.56], ["بزلازلَ", 64.61, 65.16], ["هائلة،", 65.21, 65.82], ["حتّى", 65.99, 66.3], ["تعودَ", 66.36, 66.73], ["كرةً", 66.79, 67.15], ["من", 67.19, 67.27], ["جديد.", 67.33, 67.83]]}, {"text": "ولهذا، كلُّ الكواكبِ مستديرة.", "start": 68.15, "end": 70.83, "words": [["ولهذا،", 68.15, 68.96], ["كلُّ", 69.14, 69.42], ["الكواكبِ", 69.44, 70.04], ["مستديرة.", 70.1, 70.83]]}, {"text": "برأيك، أيُّ شكلٍ غريبٍ نجرّبُ في المرّةِ القادمة؟ اكتبْ في التعليقات، واشتركْ.", "start": 71.16, "end": 77.97, "words": [["برأيك،", 71.16, 71.9], ["أيُّ", 72.11, 72.39], ["شكلٍ", 72.43, 72.74], ["غريبٍ", 72.82, 73.26], ["نجرّبُ", 73.41, 73.93], ["في", 73.99, 74.04], ["المرّةِ", 74.07, 74.42], ["القادمة؟", 74.44, 75.11], ["اكتبْ", 75.43, 75.83], ["في", 75.86, 75.92], ["التعليقات،", 75.95, 76.9], ["واشتركْ.", 77.08, 77.97]]}]