[{"text": "ماذا لو عادَ فجأةً كلُّ البشرِ الذين عاشوا على الأرضِ يوماً؟", "start": 0.0, "end": 3.84, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.48], ["عادَ", 0.56, 0.79], ["فجأةً", 0.85, 1.39], ["كلُّ", 1.49, 1.78], ["البشرِ", 1.8, 2.22], ["الذين", 2.24, 2.53], ["عاشوا", 2.61, 2.88], ["على", 2.9, 3.01], ["الأرضِ", 3.04, 3.34], ["يوماً؟", 3.38, 3.84]]}, {"text": "وُلِدَ عبرَ التاريخِ نحوَ مئةٍ وسبعةَ عشرَ مليارَ إنسان، ويعيشُ اليومَ ثمانيةُ ملياراتٍ فقط.", "start": 4.17, "end": 11.41, "words": [["وُلِدَ", 4.17, 4.54], ["عبرَ", 4.59, 4.84], ["التاريخِ", 4.87, 5.34], ["نحوَ", 5.4, 5.65], ["مئةٍ", 5.7, 6.06], ["وسبعةَ", 6.12, 6.63], ["عشرَ", 6.68, 7.2], ["مليارَ", 7.44, 7.95], ["إنسان،", 8.0, 8.66], ["ويعيشُ", 8.9, 9.45], ["اليومَ", 9.47, 9.8], ["ثمانيةُ", 9.86, 10.38], ["ملياراتٍ", 10.43, 10.91], ["فقط.", 10.97, 11.41]]}, {"text": "فيعودُ نحوَ مئةٍ وتسعةِ ملياراتٍ: ثلاثةَ عشرَ شخصاً تقريباً لكلِّ واحدٍ منّا.", "start": 11.8, "end": 17.89, "words": [["فيعودُ", 11.8, 12.25], ["نحوَ", 12.31, 12.57], ["مئةٍ", 12.62, 12.98], ["وتسعةِ", 13.04, 13.53], ["ملياراتٍ:", 13.57, 14.19], ["ثلاثةَ", 14.47, 14.95], ["عشرَ", 15.01, 15.31], ["شخصاً", 15.39, 15.72], ["تقريباً", 15.77, 16.31], ["لكلِّ", 16.64, 17.05], ["واحدٍ", 17.08, 17.43], ["منّا.", 17.47, 17.89]]}, {"text": "تمتلئُ الشوارعُ والبيوتُ في كلِّ مدنِ العالمِ خلالَ دقائق.", "start": 18.27, "end": 22.06, "words": [["تمتلئُ", 18.27, 18.71], ["الشوارعُ", 18.74, 19.27], ["والبيوتُ", 19.32, 19.83], ["في", 19.89, 19.95], ["كلِّ", 20.03, 20.26], ["مدنِ", 20.29, 20.61], ["العالمِ", 20.63, 21.06], ["خلالَ", 21.09, 21.4], ["دقائق.", 21.44, 22.06]]}, {"text": "وطعامُ العالمِ يُزرَعُ لنحوِ ثمانيةِ ملياراتٍ فقط، فتفرغُ الرفوفُ بسرعة.", "start": 22.38, "end": 27.99, "words": [["وطعامُ", 22.38, 22.91], ["العالمِ", 22.93, 23.32], ["يُزرَعُ", 23.36, 23.74], ["لنحوِ", 23.77, 24.18], ["ثمانيةِ", 24.25, 24.74], ["ملياراتٍ", 24.8, 25.33], ["فقط،", 25.39, 25.9], ["فتفرغُ", 26.18, 26.8], ["الرفوفُ", 26.82, 27.31], ["بسرعة.", 27.35, 27.99]]}, {"text": "وكثيرٌ منهم عاشوا قبلَ اختراعِ الكتابة، ويتكلّمون لغاتٍ اختفَتْ منذُ زمنٍ بعيد.", "start": 28.32, "end": 34.21, "words": [["وكثيرٌ", 28.32, 28.84], ["منهم", 28.87, 29.12], ["عاشوا", 29.21, 29.52], ["قبلَ", 29.57, 29.8], ["اختراعِ", 29.83, 30.22], ["الكتابة،", 30.24, 30.98], ["ويتكلّمون", 31.18, 31.95], ["لغاتٍ", 32.01, 32.47], ["اختفَتْ", 32.51, 32.98], ["منذُ", 33.02, 33.24], ["زمنٍ", 33.31, 33.63], ["بعيد.", 33.69, 34.21]]}, {"text": "ومعظمُهم كانوا مزارعين أو صيّادين، لم يرَوا سيّارةً ولا مصباحاً كهربائيّاً قطّ.", "start": 34.54, "end": 40.58, "words": [["ومعظمُهم", 34.54, 35.27], ["كانوا", 35.36, 35.6], ["مزارعين", 35.62, 36.27], ["أو", 36.34, 36.43], ["صيّادين،", 36.49, 37.29], ["لم", 37.62, 37.79], ["يرَوا", 37.86, 38.07], ["سيّارةً", 38.13, 38.72], ["ولا", 38.77, 38.92], ["مصباحاً", 38.96, 39.46], ["كهربائيّاً", 39.53, 40.09], ["قطّ.", 40.15, 40.58]]}, {"text": "والمفاجأة؟ لو وقفوا جميعاً كتفاً إلى كتف، لاتّسعَ لهم مكانٌ بحجمِ بلجيكا تقريباً!", "start": 40.9, "end": 47.86, "words": [["والمفاجأة؟", 40.9, 41.87], ["لو", 42.07, 42.26], ["وقفوا", 42.31, 42.78], ["جميعاً", 42.82, 43.29], ["كتفاً", 43.39, 43.85], ["إلى", 43.92, 44.07], ["كتف،", 44.15, 44.71], ["لاتّسعَ", 44.95, 45.49], ["لهم", 45.51, 45.72], ["مكانٌ", 45.77, 46.2], ["بحجمِ", 46.27, 46.7], ["بلجيكا", 46.74, 47.15], ["تقريباً!", 47.19, 47.86]]}, {"text": "فالمشكلةُ ليست المكان… بل الطعامُ والماءُ والعمل.", "start": 48.18, "end": 52.28, "words": [["فالمشكلةُ", 48.18, 48.95], ["ليست", 49.02, 49.34], ["المكان…", 49.39, 50.03], ["بل", 50.35, 50.54], ["الطعامُ", 50.6, 51.13], ["والماءُ", 51.16, 51.61], ["والعمل.", 51.63, 52.28]]}, {"text": "مَن تريدُ أن تقابلَ من أجدادِك؟ اكتبْ في التعليقات، واشتركْ.", "start": 52.66, "end": 56.84, "words": [["مَن", 52.66, 52.84], ["تريدُ", 52.91, 53.24], ["أن", 53.3, 53.41], ["تقابلَ", 53.48, 53.91], ["من", 53.95, 54.04], ["أجدادِك؟", 54.07, 54.72], ["اكتبْ", 54.96, 55.32], ["في", 55.34, 55.4], ["التعليقات،", 55.44, 56.05], ["واشتركْ.", 56.08, 56.84]]}]