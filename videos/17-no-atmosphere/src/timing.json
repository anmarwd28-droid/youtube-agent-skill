[{"text": "ماذا لو اختفى الغلافُ الجوّيُّ من حولِ الأرض… فجأة؟", "start": 0.0, "end": 3.87, "words": [["ماذا", 0.0, 0.27], ["لو", 0.31, 0.43], ["اختفى", 0.45, 0.82], ["الغلافُ", 0.85, 1.31], ["الجوّيُّ", 1.33, 1.93], ["من", 1.95, 2.06], ["حولِ", 2.1, 2.33], ["الأرض…", 2.36, 2.84], ["فجأة؟", 3.26, 3.87]]}, {"text": "أوّلُ ما تلاحظُه: السماءُ تصبحُ سوداءَ في عزِّ النهار، وتظهرُ النجومُ بجانبِ الشمس.", "start": 4.27, "end": 10.69, "words": [["أوّلُ", 4.27, 4.61], ["ما", 4.66, 4.71], ["تلاحظُه:", 4.77, 5.45], ["السماءُ", 5.75, 6.27], ["تصبحُ", 6.32, 6.8], ["سوداءَ", 6.87, 7.35], ["في", 7.41, 7.48], ["عزِّ", 7.55, 7.84], ["النهار،", 7.86, 8.45], ["وتظهرُ", 8.65, 9.27], ["النجومُ", 9.29, 9.74], ["بجانبِ", 9.78, 10.14], ["الشمس.", 10.16, 10.69]]}, {"text": "ويختفي كلُّ صوت… فالصوتُ يحتاجُ الهواءَ لينتقل.", "start": 10.93, "end": 14.91, "words": [["ويختفي", 10.93, 11.49], ["كلُّ", 11.61, 11.89], ["صوت…", 11.95, 12.42], ["فالصوتُ", 12.69, 13.15], ["يحتاجُ", 13.2, 13.65], ["الهواءَ", 13.69, 14.12], ["لينتقل.", 14.16, 14.91]]}, {"text": "والطائراتُ والطيورُ لا تستطيعُ الطيران، فلا هواءَ يحملُها.", "start": 15.21, "end": 19.34, "words": [["والطائراتُ", 15.21, 15.93], ["والطيورُ", 15.95, 16.44], ["لا", 16.5, 16.56], ["تستطيعُ", 16.61, 17.09], ["الطيران،", 17.11, 17.79], ["فلا", 17.98, 18.23], ["هواءَ", 18.29, 18.62], ["يحملُها.", 18.68, 19.34]]}, {"text": "أمّا نحن… فبدونِ ضغطِ الهواء، نفقدُ الوعيَ خلالَ ثوانٍ.", "start": 19.64, "end": 24.29, "words": [["أمّا", 19.64, 20.03], ["نحن…", 20.13, 20.7], ["فبدونِ", 20.93, 21.41], ["ضغطِ", 21.48, 21.76], ["الهواء،", 21.79, 22.38], ["نفقدُ", 22.55, 22.98], ["الوعيَ", 23.01, 23.39], ["خلالَ", 23.46, 23.74], ["ثوانٍ.", 23.8, 24.29]]}, {"text": "والمحيطاتُ تبدأُ بالغليان! ليس لأنّها ساخنة، بل لأنّ الضغطَ انعدم… ثمّ يتجمّدُ سطحُها من البرد.", "start": 24.59, "end": 31.94, "words": [["والمحيطاتُ", 24.59, 25.33], ["تبدأُ", 25.41, 25.73], ["بالغليان!", 25.77, 26.52], ["ليس", 26.81, 27.0], ["لأنّها", 27.1, 27.4], ["ساخنة،", 27.48, 28.01], ["بل", 28.2, 28.36], ["لأنّ", 28.39, 28.62], ["الضغطَ", 28.65, 29.02], ["انعدم…", 29.04, 29.64], ["ثمّ", 29.99, 30.23], ["يتجمّدُ", 30.28, 30.84], ["سطحُها", 30.88, 31.3], ["من", 31.34, 31.44], ["البرد.", 31.5, 31.94]]}, {"text": "وبلا طبقةِ الأوزون، تصلُنا الأشعّةُ فوقَ البنفسجيّةِ كاملة… والنيازكُ تضربُ الأرضَ بدلَ أن تحترقَ في السماء.", "start": 32.29, "end": 40.38, "words": [["وبلا", 32.29, 32.61], ["طبقةِ", 32.67, 33.06], ["الأوزون،", 33.09, 33.66], ["تصلُنا", 33.84, 34.35], ["الأشعّةُ", 34.39, 34.99], ["فوقَ", 35.05, 35.28], ["البنفسجيّةِ", 35.3, 36.07], ["كاملة…", 36.13, 36.68], ["والنيازكُ", 36.97, 37.58], ["تضربُ", 37.64, 37.98], ["الأرضَ", 38.0, 38.49], ["بدلَ", 38.65, 39.02], ["أن", 39.07, 39.16], ["تحترقَ", 39.23, 39.74], ["في", 39.77, 39.84], ["السماء.", 39.87, 40.38]]}, {"text": "ويصبحُ النهارُ حارقاً، والليلُ متجمّداً… تماماً كما على سطحِ القمر.", "start": 40.7, "end": 45.76, "words": [["ويصبحُ", 40.7, 41.22], ["النهارُ", 41.24, 41.65], ["حارقاً،", 41.7, 42.23], ["والليلُ", 42.25, 42.56], ["متجمّداً…", 42.6, 43.4], ["تماماً", 43.78, 44.31], ["كما", 44.43, 44.69], ["على", 44.73, 44.87], ["سطحِ", 44.94, 45.19], ["القمر.", 45.21, 45.76]]}, {"text": "الغلافُ الجوّيُّ أرقُّ ممّا تتخيّل… لكنّه يحمي كلَّ حياة. اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 46.2, "end": 54.61, "words": [["الغلافُ", 46.2, 46.65], ["الجوّيُّ", 46.67, 47.23], ["أرقُّ", 47.27, 47.72], ["ممّا", 47.75, 48.01], ["تتخيّل…", 48.05, 48.82], ["لكنّه", 49.15, 49.55], ["يحمي", 49.63, 49.92], ["كلَّ", 49.98, 50.2], ["حياة.", 50.25, 50.71], ["اكتبْ", 51.04, 51.42], ["سؤالَك", 51.45, 51.91], ["في", 52.02, 52.08], ["التعليقات،", 52.12, 52.84], ["وقد", 52.9, 53.19], ["يكونُ", 53.24, 53.53], ["الفيديو", 53.56, 53.87], ["القادم.", 53.89, 54.61]]}]