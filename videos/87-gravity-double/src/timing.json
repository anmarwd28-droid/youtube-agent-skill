[{"text": "ماذا لو تضاعفَت جاذبيّةُ الأرضِ فجأةً، على كلِّ البشرِ معاً؟", "start": 0.0, "end": 4.31, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.42], ["تضاعفَت", 0.46, 0.96], ["جاذبيّةُ", 1.02, 1.6], ["الأرضِ", 1.64, 1.96], ["فجأةً،", 2.02, 2.68], ["على", 2.83, 3.01], ["كلِّ", 3.11, 3.35], ["البشرِ", 3.38, 3.8], ["معاً؟", 3.84, 4.31]]}, {"text": "في ثانية، يصبحُ وزنُك ضعفَين: من وزنُه سبعونَ كيلوغراماً، يشعرُ كأنّه مئةٌ وأربعون.", "start": 4.64, "end": 11.33, "words": [["في", 4.64, 4.77], ["ثانية،", 4.88, 5.46], ["يصبحُ", 5.61, 6.11], ["وزنُك", 6.18, 6.51], ["ضعفَين:", 6.57, 7.27], ["من", 7.51, 7.65], ["وزنُه", 7.7, 7.99], ["سبعونَ", 8.09, 8.47], ["كيلوغراماً،", 8.52, 9.24], ["يشعرُ", 9.46, 9.87], ["كأنّه", 9.94, 10.24], ["مئةٌ", 10.32, 10.66], ["وأربعون.", 10.72, 11.33]]}, {"text": "ينحني الناسُ في الشوارع، وتصبحُ كلُّ درجةِ سُلَّمٍ كصعودِ جبل.", "start": 11.67, "end": 16.35, "words": [["ينحني", 11.67, 12.1], ["الناسُ", 12.12, 12.48], ["في", 12.53, 12.6], ["الشوارع،", 12.62, 13.35], ["وتصبحُ", 13.49, 14.13], ["كلُّ", 14.2, 14.44], ["درجةِ", 14.47, 14.91], ["سُلَّمٍ", 14.96, 15.35], ["كصعودِ", 15.41, 15.84], ["جبل.", 15.91, 16.35]]}, {"text": "وقلبُك يضخُّ الدمَ إلى دماغِك بصعوبة، فإذا وقفتَ بسرعة، قد يُغمى عليك.", "start": 16.68, "end": 22.3, "words": [["وقلبُك", 16.68, 17.22], ["يضخُّ", 17.32, 17.74], ["الدمَ", 17.76, 18.09], ["إلى", 18.15, 18.3], ["دماغِك", 18.37, 18.75], ["بصعوبة،", 18.86, 19.6], ["فإذا", 19.81, 20.17], ["وقفتَ", 20.21, 20.57], ["بسرعة،", 20.63, 21.26], ["قد", 21.41, 21.56], ["يُغمى", 21.63, 21.85], ["عليك.", 21.89, 22.3]]}, {"text": "ومن الارتفاعِ نفسِه، تسقطُ بطاقةٍ مضاعفة، والكرةُ التي ترميها تقطعُ نصفَ المسافة.", "start": 22.77, "end": 28.95, "words": [["ومن", 22.77, 23.02], ["الارتفاعِ", 23.08, 23.65], ["نفسِه،", 23.67, 24.18], ["تسقطُ", 24.34, 24.75], ["بطاقةٍ", 24.82, 25.3], ["مضاعفة،", 25.34, 26.06], ["والكرةُ", 26.23, 26.7], ["التي", 26.73, 26.96], ["ترميها", 27.02, 27.53], ["تقطعُ", 27.69, 28.07], ["نصفَ", 28.12, 28.34], ["المسافة.", 28.36, 28.95]]}, {"text": "الجسورُ والمباني القديمةُ تحملُ فجأةً ضعفَ وزنِها، فقد يتشقّقُ بعضُها أو ينهار.", "start": 29.3, "end": 35.41, "words": [["الجسورُ", 29.3, 29.87], ["والمباني", 29.9, 30.31], ["القديمةُ", 30.34, 30.93], ["تحملُ", 31.22, 31.61], ["فجأةً", 31.67, 32.14], ["ضعفَ", 32.2, 32.45], ["وزنِها،", 32.51, 33.11], ["فقد", 33.25, 33.55], ["يتشقّقُ", 33.61, 34.25], ["بعضُها", 34.31, 34.7], ["أو", 34.75, 34.88], ["ينهار.", 34.91, 35.41]]}, {"text": "والطائراتُ تحتاجُ سرعةً أكبرَ لتُقلِع، والصواريخُ وقوداً أكثرَ بكثير.", "start": 35.71, "end": 40.63, "words": [["والطائراتُ", 35.71, 36.33], ["تحتاجُ", 36.39, 36.76], ["سرعةً", 36.8, 37.19], ["أكبرَ", 37.24, 37.63], ["لتُقلِع،", 37.66, 38.31], ["والصواريخُ", 38.57, 39.18], ["وقوداً", 39.22, 39.62], ["أكثرَ", 39.66, 39.98], ["بكثير.", 40.01, 40.63]]}, {"text": "حتى الهواءُ ينضغطُ قربَ الأرض، فيتضاعفُ ضغطُه، وتنمو الأشجارُ مع الزمنِ أقصر.", "start": 41.06, "end": 46.88, "words": [["حتى", 41.06, 41.34], ["الهواءُ", 41.37, 41.77], ["ينضغطُ", 41.83, 42.39], ["قربَ", 42.47, 42.73], ["الأرض،", 42.76, 43.28], ["فيتضاعفُ", 43.45, 44.14], ["ضغطُه،", 44.19, 44.74], ["وتنمو", 44.91, 45.3], ["الأشجارُ", 45.33, 45.81], ["مع", 45.85, 45.95], ["الزمنِ", 45.99, 46.34], ["أقصر.", 46.38, 46.88]]}, {"text": "والقمرُ يُشَدُّ نحونا في مدارٍ جديد، يقتربُ فيه إلى ثلثِ مسافتِه، فيعلو المدُّ كثيراً.", "start": 47.25, "end": 53.99, "words": [["والقمرُ", 47.25, 47.81], ["يُشَدُّ", 47.84, 48.29], ["نحونا", 48.32, 48.73], ["في", 48.81, 48.89], ["مدارٍ", 48.97, 49.33], ["جديد،", 49.4, 49.97], ["يقتربُ", 50.2, 50.7], ["فيه", 50.76, 50.97], ["إلى", 51.03, 51.16], ["ثلثِ", 51.23, 51.54], ["مسافتِه،", 51.59, 52.38], ["فيعلو", 52.58, 53.06], ["المدُّ", 53.08, 53.41], ["كثيراً.", 53.44, 53.99]]}, {"text": "والمفاجأة؟ جرّبتَ هذا من قبل: في أسفلِ منحدرِ الأفعوانيّة، تشعرُ بأكثرَ من ضعفِ وزنِك، لكن لثوانٍ فقط.", "start": 54.42, "end": 63.01, "words": [["والمفاجأة؟", 54.42, 55.34], ["جرّبتَ", 55.66, 56.05], ["هذا", 56.12, 56.3], ["من", 56.34, 56.44], ["قبل:", 56.51, 56.96], ["في", 57.19, 57.3], ["أسفلِ", 57.35, 57.67], ["منحدرِ", 57.71, 58.17], ["الأفعوانيّة،", 58.19, 59.15], ["تشعرُ", 59.33, 59.78], ["بأكثرَ", 59.81, 60.26], ["من", 60.3, 60.4], ["ضعفِ", 60.45, 60.71], ["وزنِك،", 60.77, 61.26], ["لكن", 61.5, 61.78], ["لثوانٍ", 61.82, 62.39], ["فقط.", 62.47, 63.01]]}, {"text": "هل كنتَ ستتحمّلُ يوماً واحداً؟ اكتبْ في التعليقات، واشتركْ.", "start": 63.29, "end": 67.76, "words": [["هل", 63.29, 63.45], ["كنتَ", 63.51, 63.76], ["ستتحمّلُ", 63.82, 64.52], ["يوماً", 64.56, 64.83], ["واحداً؟", 64.88, 65.43], ["اكتبْ", 65.71, 66.1], ["في", 66.13, 66.2], ["التعليقات،", 66.23, 66.97], ["واشتركْ.", 66.99, 67.76]]}]