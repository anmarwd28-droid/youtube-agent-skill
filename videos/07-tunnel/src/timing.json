[{"text": "ماذا لو حفرنا نفقاً يمرُّ من مركزِ الأرض… وقفزتَ فيه؟", "start": 0.0, "end": 4.35, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.41], ["حفرنا", 0.48, 0.88], ["نفقاً", 0.96, 1.39], ["يمرُّ", 1.47, 1.82], ["من", 1.86, 1.97], ["مركزِ", 2.02, 2.44], ["الأرض…", 2.46, 2.98], ["وقفزتَ", 3.3, 3.88], ["فيه؟", 3.94, 4.35]]}, {"text": "سيكونُ طولُ النفقِ نحوَ اثني عشرَ ألفاً وسبعِمئةِ كيلومتر، من جهةٍ إلى الجهةِ الأخرى من الكوكب.", "start": 4.78, "end": 11.39, "words": [["سيكونُ", 4.78, 5.24], ["طولُ", 5.29, 5.5], ["النفقِ", 5.51, 5.94], ["نحوَ", 5.99, 6.25], ["اثني", 6.27, 6.49], ["عشرَ", 6.57, 6.92], ["ألفاً", 6.94, 7.29], ["وسبعِمئةِ", 7.34, 8.08], ["كيلومتر،", 8.14, 8.85], ["من", 9.04, 9.18], ["جهةٍ", 9.27, 9.61], ["إلى", 9.68, 9.8], ["الجهةِ", 9.82, 10.21], ["الأخرى", 10.23, 10.62], ["من", 10.66, 10.74], ["الكوكب.", 10.8, 11.39]]}, {"text": "وأعمقُ حفرةٍ حفرَها البشرُ حتى اليوم، لا يتجاوزُ عمقُها اثني عشرَ كيلومتراً فقط.", "start": 11.82, "end": 18.02, "words": [["وأعمقُ", 11.82, 12.43], ["حفرةٍ", 12.52, 12.97], ["حفرَها", 13.05, 13.5], ["البشرُ", 13.53, 13.98], ["حتى", 14.04, 14.27], ["اليوم،", 14.29, 14.79], ["لا", 15.06, 15.21], ["يتجاوزُ", 15.26, 15.85], ["عمقُها", 15.91, 16.31], ["اثني", 16.34, 16.59], ["عشرَ", 16.65, 16.97], ["كيلومتراً", 17.01, 17.51], ["فقط.", 17.55, 18.02]]}, {"text": "ففي الأسفل، تشتدُّ الحرارةُ بسرعة. وفي الوشاح، تصلُ إلى آلافِ الدرجات، والصخورُ تتحرّكُ ببطءٍ مثلَ العجين.", "start": 18.39, "end": 26.44, "words": [["ففي", 18.39, 18.62], ["الأسفل،", 18.65, 19.21], ["تشتدُّ", 19.25, 19.68], ["الحرارةُ", 19.7, 20.21], ["بسرعة.", 20.27, 20.79], ["وفي", 20.99, 21.21], ["الوشاح،", 21.23, 21.8], ["تصلُ", 21.86, 22.26], ["إلى", 22.32, 22.45], ["آلافِ", 22.52, 22.89], ["الدرجات،", 22.92, 23.66], ["والصخورُ", 23.82, 24.37], ["تتحرّكُ", 24.42, 25.01], ["ببطءٍ", 25.08, 25.55], ["مثلَ", 25.61, 25.84], ["العجين.", 25.87, 26.44]]}, {"text": "وفي اللبّ، تبلغُ الحرارةُ نحوَ ستّةِ آلافِ درجة… أي ما يقاربُ حرارةَ سطحِ الشمس.", "start": 26.7, "end": 32.73, "words": [["وفي", 26.7, 26.96], ["اللبّ،", 26.99, 27.52], ["تبلغُ", 27.71, 28.09], ["الحرارةُ", 28.11, 28.65], ["نحوَ", 28.72, 28.98], ["ستّةِ", 29.04, 29.42], ["آلافِ", 29.49, 29.85], ["درجة…", 29.91, 30.38], ["أي", 30.7, 30.86], ["ما", 30.88, 30.94], ["يقاربُ", 31.0, 31.39], ["حرارةَ", 31.46, 31.87], ["سطحِ", 31.93, 32.18], ["الشمس.", 32.2, 32.73]]}, {"text": "لكن لنفترضْ أنّ النفقَ آمنٌ تماماً، وخالٍ من الهواء.", "start": 33.09, "end": 37.38, "words": [["لكن", 33.09, 33.4], ["لنفترضْ", 33.46, 34.2], ["أنّ", 34.23, 34.45], ["النفقَ", 34.46, 34.91], ["آمنٌ", 34.98, 35.34], ["تماماً،", 35.43, 36.01], ["وخالٍ", 36.21, 36.69], ["من", 36.71, 36.81], ["الهواء.", 36.88, 37.38]]}, {"text": "ستسقطُ وتزدادُ سرعتُك… حتى تعبرَ المركزَ بنحوِ ثمانيةِ كيلومتراتٍ في الثانية.", "start": 37.58, "end": 43.43, "words": [["ستسقطُ", 37.58, 38.23], ["وتزدادُ", 38.26, 38.85], ["سرعتُك…", 38.91, 39.66], ["حتى", 39.9, 40.22], ["تعبرَ", 40.29, 40.66], ["المركزَ", 40.69, 41.15], ["بنحوِ", 41.19, 41.53], ["ثمانيةِ", 41.58, 42.06], ["كيلومتراتٍ", 42.12, 42.73], ["في", 42.8, 42.86], ["الثانية.", 42.89, 43.43]]}, {"text": "ثمّ تبدأُ بالتباطؤ، حتى تصلَ إلى الطرفِ الآخرِ من الأرض… وتتوقّفَ تماماً عند الحافّة.", "start": 43.75, "end": 50.32, "words": [["ثمّ", 43.75, 44.0], ["تبدأُ", 44.07, 44.42], ["بالتباطؤ،", 44.48, 45.2], ["حتى", 45.37, 45.63], ["تصلَ", 45.7, 46.06], ["إلى", 46.09, 46.21], ["الطرفِ", 46.24, 46.63], ["الآخرِ", 46.65, 47.1], ["من", 47.14, 47.23], ["الأرض…", 47.29, 47.81], ["وتتوقّفَ", 48.08, 48.94], ["تماماً", 48.99, 49.51], ["عند", 49.55, 49.73], ["الحافّة.", 49.77, 50.32]]}, {"text": "والمدهشُ أنّ الرحلةَ كلَّها تستغرقُ نحوَ اثنتينِ وأربعينَ دقيقةً فقط!", "start": 50.63, "end": 55.84, "words": [["والمدهشُ", 50.63, 51.22], ["أنّ", 51.29, 51.47], ["الرحلةَ", 51.49, 51.93], ["كلَّها", 51.99, 52.51], ["تستغرقُ", 52.72, 53.34], ["نحوَ", 53.38, 53.6], ["اثنتينِ", 53.63, 54.1], ["وأربعينَ", 54.16, 54.72], ["دقيقةً", 54.78, 55.3], ["فقط!", 55.33, 55.84]]}, {"text": "وإن لم يمسكْك أحد… ستسقطُ من جديد، وتتأرجحُ بينَ طرفَي الأرضِ إلى الأبد.", "start": 56.17, "end": 62.43, "words": [["وإن", 56.17, 56.4], ["لم", 56.45, 56.59], ["يمسكْك", 56.66, 57.1], ["أحد…", 57.21, 57.83], ["ستسقطُ", 58.27, 58.86], ["من", 58.92, 59.0], ["جديد،", 59.06, 59.61], ["وتتأرجحُ", 59.72, 60.64], ["بينَ", 60.69, 60.9], ["طرفَي", 60.96, 61.34], ["الأرضِ", 61.38, 61.74], ["إلى", 61.78, 61.89], ["الأبد.", 61.93, 62.43]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 62.81, "end": 69.15, "words": [["والآن", 62.81, 63.11], ["دورُك:", 63.16, 63.72], ["ماذا", 64.04, 64.32], ["لو…؟", 64.38, 64.89], ["اكتبْ", 65.21, 65.62], ["سؤالَك", 65.64, 66.04], ["في", 66.08, 66.14], ["التعليقات،", 66.17, 67.0], ["وقد", 67.21, 67.55], ["يكونُ", 67.61, 67.94], ["الفيديو", 67.97, 68.3], ["القادم.", 68.33, 69.15]]}]