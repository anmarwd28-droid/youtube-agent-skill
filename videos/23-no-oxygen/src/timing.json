[{"text": "ماذا لو اختفى الأكسجينُ من الهواءِ خمسَ ثوانٍ فقط؟", "start": 0.0, "end": 3.26, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.46], ["اختفى", 0.49, 0.77], ["الأكسجينُ", 0.79, 1.39], ["من", 1.43, 1.53], ["الهواءِ", 1.58, 1.97], ["خمسَ", 2.03, 2.29], ["ثوانٍ", 2.35, 2.66], ["فقط؟", 2.73, 3.26]]}, {"text": "الأكسجينُ خُمسُ الهواء… فيهبطُ الضغطُ فجأةً كأنّك صعدتَ ألفَي متر، وتطقطقُ أذناك.", "start": 3.62, "end": 10.69, "words": [["الأكسجينُ", 3.62, 4.3], ["خُمسُ", 4.37, 4.64], ["الهواء…", 4.68, 5.33], ["فيهبطُ", 5.69, 6.22], ["الضغطُ", 6.25, 6.57], ["فجأةً", 6.64, 7.08], ["كأنّك", 7.16, 7.52], ["صعدتَ", 7.66, 8.06], ["ألفَي", 8.09, 8.38], ["متر،", 8.43, 8.96], ["وتطقطقُ", 9.16, 9.97], ["أذناك.", 10.01, 10.69]]}, {"text": "وكلُّ نارٍ على الأرضِ تنطفئ في لحظة: المواقدُ والشموعُ وحتى حرائقُ الغابات.", "start": 10.99, "end": 17.17, "words": [["وكلُّ", 10.99, 11.38], ["نارٍ", 11.41, 11.63], ["على", 11.7, 11.82], ["الأرضِ", 11.85, 12.17], ["تنطفئ", 12.22, 12.7], ["في", 12.81, 12.89], ["لحظة:", 12.96, 13.46], ["المواقدُ", 13.77, 14.42], ["والشموعُ", 14.44, 15.11], ["وحتى", 15.37, 15.85], ["حرائقُ", 15.93, 16.42], ["الغابات.", 16.44, 17.17]]}, {"text": "ومحرّكاتُ السيّاراتِ تتوقّف، لأنّها تحرقُ الوقودَ بأكسجينِ الهواء… وحتى محرّكاتُ الطائراتِ قد تنطفئ، لكنّ الطيّارين يستطيعون إعادةَ تشغيلِها.", "start": 17.4, "end": 28.39, "words": [["ومحرّكاتُ", 17.4, 18.27], ["السيّاراتِ", 18.29, 18.87], ["تتوقّف،", 18.91, 19.64], ["لأنّها", 19.91, 20.33], ["تحرقُ", 20.42, 20.8], ["الوقودَ", 20.83, 21.29], ["بأكسجينِ", 21.34, 21.94], ["الهواء…", 21.97, 22.61], ["وحتى", 23.01, 23.38], ["محرّكاتُ", 23.42, 24.01], ["الطائراتِ", 24.03, 24.58], ["قد", 24.64, 24.74], ["تنطفئ،", 24.76, 25.39], ["لكنّ", 25.69, 26.03], ["الطيّارين", 26.05, 26.54], ["يستطيعون", 26.6, 27.17], ["إعادةَ", 27.23, 27.66], ["تشغيلِها.", 27.7, 28.39]]}, {"text": "وأنت؟ خمسُ ثوانٍ قصيرةٌ جداً لتؤذيَك؛ فالأكسجينُ في دمِك يُبقي دماغَك يعملُ أطولَ من ذلك.", "start": 28.69, "end": 36.26, "words": [["وأنت؟", 28.69, 29.27], ["خمسُ", 29.57, 29.88], ["ثوانٍ", 29.95, 30.3], ["قصيرةٌ", 30.39, 30.93], ["جداً", 31.0, 31.3], ["لتؤذيَك؛", 31.34, 32.04], ["فالأكسجينُ", 32.35, 33.08], ["في", 33.15, 33.22], ["دمِك", 33.29, 33.6], ["يُبقي", 33.9, 34.27], ["دماغَك", 34.34, 34.81], ["يعملُ", 34.95, 35.28], ["أطولَ", 35.32, 35.61], ["من", 35.66, 35.74], ["ذلك.", 35.78, 36.26]]}, {"text": "والمفاجأة؟ المباني لن تنهار، والماءُ لن يختفي… لأنّ الأكسجينَ فيهما مرتبطٌ بذرّاتٍ أخرى، وليس غازاً حرّاً.", "start": 36.56, "end": 44.94, "words": [["والمفاجأة؟", 36.56, 37.43], ["المباني", 37.73, 38.2], ["لن", 38.26, 38.36], ["تنهار،", 38.42, 39.03], ["والماءُ", 39.2, 39.59], ["لن", 39.64, 39.74], ["يختفي…", 39.81, 40.51], ["لأنّ", 40.77, 41.06], ["الأكسجينَ", 41.1, 41.66], ["فيهما", 41.72, 42.05], ["مرتبطٌ", 42.12, 42.64], ["بذرّاتٍ", 42.7, 43.19], ["أخرى،", 43.22, 43.65], ["وليس", 43.79, 44.12], ["غازاً", 44.21, 44.45], ["حرّاً.", 44.5, 44.94]]}, {"text": "ثمّ يعودُ الأكسجين، فيرتفعُ الضغطُ من جديد، ويشتعلُ الجمرُ الساخنُ مرّةً أخرى.", "start": 45.37, "end": 51.0, "words": [["ثمّ", 45.37, 45.65], ["يعودُ", 45.67, 45.94], ["الأكسجين،", 45.96, 46.68], ["فيرتفعُ", 46.75, 47.38], ["الضغطُ", 47.4, 47.75], ["من", 47.8, 47.87], ["جديد،", 47.93, 48.49], ["ويشتعلُ", 48.65, 49.26], ["الجمرُ", 49.28, 49.65], ["الساخنُ", 49.67, 50.11], ["مرّةً", 50.16, 50.54], ["أخرى.", 50.56, 51.0]]}, {"text": "خمسُ ثوانٍ تكفي لتذكّرَنا: كلُّ نَفَسٍ وكلُّ شعلةٍ تحتاجُ هذا الغازَ الخفيّ.", "start": 51.43, "end": 56.74, "words": [["خمسُ", 51.43, 51.73], ["ثوانٍ", 51.79, 52.12], ["تكفي", 52.19, 52.42], ["لتذكّرَنا:", 52.48, 53.43], ["كلُّ", 53.63, 53.93], ["نَفَسٍ", 53.98, 54.38], ["وكلُّ", 54.46, 54.78], ["شعلةٍ", 54.81, 55.2], ["تحتاجُ", 55.27, 55.66], ["هذا", 55.7, 55.88], ["الغازَ", 55.9, 56.19], ["الخفيّ.", 56.22, 56.74]]}, {"text": "اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 57.12, "end": 60.79, "words": [["اكتبْ", 57.12, 57.52], ["سؤالَك", 57.54, 57.99], ["في", 58.11, 58.17], ["التعليقات،", 58.19, 58.99], ["وقد", 