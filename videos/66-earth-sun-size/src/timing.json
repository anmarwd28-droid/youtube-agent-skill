[{"text": "ماذا لو كبُرَتِ الأرضُ فجأةً… حتّى صارَ حجمُها مثلَ حجمِ الشمس؟", "start": 0.0, "end": 4.88, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.43], ["كبُرَتِ", 0.5, 0.91], ["الأرضُ", 0.94, 1.26], ["فجأةً…", 1.32, 2.06], ["حتّى", 2.32, 2.63], ["صارَ", 2.69, 2.9], ["حجمُها", 2.96, 3.53], ["مثلَ", 3.67, 3.96], ["حجمِ", 4.03, 4.3], ["الشمس؟", 4.32, 4.88]]}, {"text": "الشمسُ أعرضُ من الأرضِ مئةً وتسعَ مرّات، ويتّسعُ جوفُها لأكثرَ من مليونِ أرض.", "start": 5.46, "end": 11.37, "words": [["الشمسُ", 5.46, 5.92], ["أعرضُ", 5.97, 6.33], ["من", 6.37, 6.47], ["الأرضِ", 6.53, 6.88], ["مئةً", 6.93, 7.31], ["وتسعَ", 7.36, 7.78], ["مرّات،", 7.81, 8.42], ["ويتّسعُ", 8.62, 9.28], ["جوفُها", 9.36, 9.81], ["لأكثرَ", 9.9, 10.4], ["من", 10.44, 10.54], ["مليونِ", 10.58, 10.91], ["أرض.", 10.96, 11.37]]}, {"text": "أوّلُ ضحيّة: القمر. فهو يدورُ على بُعدِ ثلاثِمئةٍ وأربعةٍ وثمانينَ ألفَ كيلومتر… وسطحُ الأرضِ الجديدُ أبعدُ من ذلك بكثير.", "start": 11.67, "end": 21.44, "words": [["أوّلُ", 11.67, 12.04], ["ضحيّة:", 12.09, 12.71], ["القمر.", 12.88, 13.55], ["فهو", 13.92, 14.19], ["يدورُ", 14.27, 14.59], ["على", 14.65, 14.78], ["بُعدِ", 14.86, 15.11], ["ثلاثِمئةٍ", 15.17, 15.92], ["وأربعةٍ", 15.99, 16.51], ["وثمانينَ", 16.57, 17.14], ["ألفَ", 17.18, 17.41], ["كيلومتر…", 17.46, 18.17], ["وسطحُ", 18.54, 18.99], ["الأرضِ", 19.02, 19.34], ["الجديدُ", 19.36, 19.82], ["أبعدُ", 19.88, 20.28], ["من", 20.32, 20.42], ["ذلك", 20.48, 20.72], ["بكثير.", 20.83, 21.44]]}, {"text": "فيُدفَنُ القمرُ داخلَ الأرضِ في لحظة.", "start": 21.8, "end": 24.07, "words": [["فيُدفَنُ", 21.8, 22.3], ["القمرُ", 22.33, 22.72], ["داخلَ", 22.78, 23.06], ["الأرضِ", 23.09, 23.39], ["في", 23.46, 23.53], ["لحظة.", 23.6, 24.07]]}, {"text": "لكنَّ الأرضَ ليست غازاً مثلَ الشمس، بل صخورٌ وحديدٌ أثقلُ منها بأربعِ مرّات.", "start": 24.37, "end": 29.98, "words": [["لكنَّ", 24.37, 24.74], ["الأرضَ", 24.76, 25.1], ["ليست", 25.15, 25.45], ["غازاً", 25.52, 25.82], ["مثلَ", 25.84, 26.08], ["الشمس،", 26.1, 26.66], ["بل", 26.92, 27.06], ["صخورٌ", 27.14, 27.56], ["وحديدٌ", 27.63, 28.18], ["أثقلُ", 28.29, 28.66], ["منها", 28.71, 28.94], ["بأربعِ", 29.01, 29.44], ["مرّات.", 29.47, 29.98]]}, {"text": "فتصبحُ كتلتُها نحوَ أربعِ شموسٍ كاملة.", "start": 30.29, "end": 33.67, "words": [["فتصبحُ", 30.29, 30.89], ["كتلتُها", 30.96, 31.65], ["نحوَ", 31.91, 32.23], ["أربعِ", 32.26, 32.62], ["شموسٍ", 32.68, 33.09], ["كاملة.", 33.16, 33.67]]}, {"text": "والجاذبيةُ على سطحِها أقوى مئةً وتسعَ مرّات: من يزنُ سبعينَ كيلوغراماً يصيرُ وزنُه أكثرَ من سبعةِ أطنان.", "start": 34.03, "end": 42.09, "words": [["والجاذبيةُ", 34.03, 34.75], ["على", 34.8, 34.92], ["سطحِها", 34.99, 35.52], ["أقوى", 35.71, 36.06], ["مئةً", 36.11, 36.49], ["وتسعَ", 36.55, 36.95], ["مرّات:", 37.0, 37.52], ["من", 37.83, 37.95], ["يزنُ", 38.02, 38.35], ["سبعينَ", 38.42, 38.77], ["كيلوغراماً", 38.84, 39.52], ["يصيرُ", 39.67, 40.1], ["وزنُه", 40.13, 40.48], ["أكثرَ", 40.6, 41.03], ["من", 41.08, 41.17], ["سبعةِ", 41.22, 41.55], ["أطنان.", 41.59, 42.09]]}, {"text": "لا قلبَ يقدرُ أن يضخَّ الدم، ولا عظمَ يتحمّل، ولا جبلَ يبقى واقفاً.", "start": 42.52, "end": 48.19, "words": [["لا", 42.52, 42.64], ["قلبَ", 42.71, 42.99], ["يقدرُ", 43.03, 43.46], ["أن", 43.5, 43.59], ["يضخَّ", 43.65, 44.04], ["الدم،", 44.06, 44.6], ["ولا", 44.81, 45.08], ["عظمَ", 45.15, 45.5], ["يتحمّل،", 45.53, 46.34], ["ولا", 46.54, 46.8], ["جبلَ", 46.87, 47.17], ["يبقى", 47.23, 47.52], ["واقفاً.", 47.58, 48.19]]}, {"text": "حتّى الشمسُ تصبحُ أخفَّ منّا بأربعِ مرّات، فتبدأُ هي بالدورانِ حولَ الأرض.", "start": 48.47, "end": 54.16, "words": [["حتّى", 48.47, 48.83], ["الشمسُ", 48.85, 49.26], ["تصبحُ", 49.32, 49.83], ["أخفَّ", 49.86, 50.28], ["منّا", 50.33, 50.57], ["بأربعِ", 50.66, 51.13], ["مرّات،", 51.16, 51.76], ["فتبدأُ", 51.95, 52.51], ["هي", 52.58, 52.7], ["بالدورانِ", 52.78, 53.36], ["حولَ", 53.42, 53.63], ["الأرض.", 53.66, 54.16]]}, {"text": "لكنّ الشمسَ لا تنهارُ لأنَّ حرارتَها تدفعُ غازاتِها إلى الخارج، أمّا أرضُنا فباردة.", "start": 54.48, "end": 60.45, "words": [["لكنّ", 54.48, 54.86], ["الشمسَ", 54.88, 55.24], ["لا", 55.29, 55.36], ["تنهارُ", 55.41, 55.9], ["لأنَّ", 56.22, 56.54], ["حرارتَها", 56.59, 57.13], ["تدفعُ", 57.2, 57.55], ["غازاتِها", 57.6, 58.06], ["إلى", 58.09, 58.2], ["الخارج،", 58.22, 58.87], ["أمّا", 59.05, 59.37], ["أرضُنا", 59.41, 59.76], ["فباردة.", 59.83, 60.45]]}, {"text": "فلا شيءَ يمنعُها من الانهيارِ على نفسِها خلالَ دقائقَ معدودة.", "start": 60.84, "end": 65.06, "words": [["فلا", 60.84, 61.07], ["شيءَ", 61.13, 61.37], ["يمنعُها", 61.43, 61.89], ["من", 61.94, 62.03], ["الانهيارِ", 62.09, 62.61], ["على", 62.66, 62.77], ["نفسِها", 62.83, 63.35], ["خلالَ", 63.56, 63.89], ["دقائقَ", 63.95, 64.44], ["معدودة.", 64.48, 65.06]]}, {"text": "وقد ينتهي هذا العملاقُ كلُّه ثقباً أسودَ، عرضُه نحوُ ثلاثةٍ وعشرينَ كيلومتراً فقط.", "start": 65.44, "end": 71.82, "words": [["وقد", 65.44, 65.78], ["ينتهي", 65.84, 66.2], ["هذا", 66.26, 66.45], ["العملاقُ", 66.48, 67.05], ["كلُّه", 67.12, 67.47], ["ثقباً", 67.62, 68.0], ["أسودَ،", 68.03, 68.64], ["عرضُه", 68.92, 69.29], ["نحوُ", 69.4, 69.65], ["ثلاثةٍ", 69.72, 70.19], ["وعشرينَ", 70.26, 70.74], ["كيلومتراً", 70.81, 71.28], ["فقط.", 71.32, 71.82]]}, {"text": "ثقبٌ أسودُ مكانَ بيتِنا، والشمسُ والكواكبُ تدورُ حولَه.", "start": 72.2, "end": 76.56, "words": [["ثقبٌ", 72.2, 72.61], ["أسودُ", 72.67, 73.06], ["مكانَ", 73.11, 73.43], ["بيتِنا،", 73.49, 74.08], ["والشمسُ", 74.36, 74.83], ["والكواكبُ", 74.85, 75.56], ["تدورُ", 75.71, 76.05], ["حولَه.", 76.11, 76.56]]}, {"text": "لو كبرتْ الأرضُ قليلاً فقط، إلى أيِّ حجمٍ تتحمّلُها؟ اكتبْ في التعليقات، واشتركْ.", "start": 77.0, "end": 84.19, "words": [["لو", 77.0, 77.14], ["كبرتْ", 77.22, 77.66], ["الأرضُ", 77.68, 78.04], ["قليلاً", 78.12, 78.52], ["فقط،", 78.58, 79.12], ["إلى", 79.36, 79.54], ["أيِّ", 79.59, 79.83], ["حجمٍ", 79.88, 80.26], ["تتحمّلُها؟", 80.32, 81.26], ["اكتبْ", 81.64, 82.01], ["في", 82.05, 82.12], ["التعليقات،", 82.15, 83.0], ["واشتركْ.", 83.32, 84.19]]}]