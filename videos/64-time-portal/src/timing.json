[{"text": "ماذا لو صنعَ العلماءُ بوابةً… تأخذُك إلى أيِّ زمن؟", "start": 0.0, "end": 4.09, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.41], ["صنعَ", 0.48, 0.77], ["العلماءُ", 0.79, 1.44], ["بوابةً…", 1.49, 2.37], ["تأخذُك", 2.69, 3.17], ["إلى", 3.25, 3.35], ["أيِّ", 3.4, 3.61], ["زمن؟", 3.66, 4.09]]}, {"text": "المفاجأةُ الأولى: السفرُ إلى المستقبلِ حقيقيٌّ أصلاً. فكلّما أسرعتَ، تباطأ زمنُك.", "start": 4.6, "end": 11.27, "words": [["المفاجأةُ", 4.6, 5.28], ["الأولى:", 5.31, 5.83], ["السفرُ", 6.15, 6.64], ["إلى", 6.69, 6.8], ["المستقبلِ", 6.84, 7.43], ["حقيقيٌّ", 7.5, 8.03], ["أصلاً.", 8.06, 8.52], ["فكلّما", 8.85, 9.33], ["أسرعتَ،", 9.37, 10.08], ["تباطأ", 10.25, 10.67], ["زمنُك.", 10.75, 11.27]]}, {"text": "رائدُ فضاءٍ قضى أكثرَ من ثمانمئةِ يومٍ في المدار، عادَ إلى الأرضِ أصغرَ بجزءٍ من خمسينَ من الثانية.", "start": 11.66, "end": 18.12, "words": [["رائدُ", 11.66, 11.92], ["فضاءٍ", 11.97, 12.35], ["قضى", 12.43, 12.64], ["أكثرَ", 12.69, 13.0], ["من", 13.05, 13.12], ["ثمانمئةِ", 13.17, 13.77], ["يومٍ", 13.84, 14.08], ["في", 14.13, 14.19], ["المدار،", 14.21, 14.81], ["عادَ", 15.09, 15.36], ["إلى", 15.39, 15.5], ["الأرضِ", 15.53, 15.87], ["أصغرَ", 15.92, 16.28], ["بجزءٍ", 16.31, 16.75], ["من", 16.81, 16.92], ["خمسينَ", 16.98, 17.37], ["من", 17.41, 17.52], ["الثانية.", 17.57, 18.12]]}, {"text": "أمّا البوابة، فقد تكونُ ثقباً دودياً: نفقاً يصلُ نقطتينِ بعيدتينِ في الزمانِ والمكان.", "start": 18.51, "end": 25.45, "words": [["أمّا", 18.51, 18.73], ["البوابة،", 18.76, 19.52], ["فقد", 19.69, 19.98], ["تكونُ", 20.02, 20.4], ["ثقباً", 20.47, 20.84], ["دودياً:", 20.89, 21.48], ["نفقاً", 21.84, 22.33], ["يصلُ", 22.39, 22.77], ["نقطتينِ", 22.82, 23.37], ["بعيدتينِ", 23.43, 24.2], ["في", 24.25, 24.37], ["الزمانِ", 24.39, 24.82], ["والمكان.", 24.86, 25.45]]}, {"text": "لكنّ إبقاءَه مفتوحاً يحتاجُ مادّةً غريبةً ذاتَ طاقةٍ سالبة، لم يجدْها أحدٌ بكمّيّةٍ كافية.", "start": 25.75, "end": 33.16, "words": [["لكنّ", 25.75, 26.09], ["إبقاءَه", 26.12, 26.57], ["مفتوحاً", 26.66, 27.23], ["يحتاجُ", 27.53, 27.96], ["مادّةً", 27.99, 28.43], ["غريبةً", 28.5, 29.05], ["ذاتَ", 29.35, 29.57], ["طاقةٍ", 29.66, 30.08], ["سالبة،", 30.15, 30.74], ["لم", 31.05, 31.22], ["يجدْها", 31.29, 31.64], ["أحدٌ", 31.68, 32.02], ["بكمّيّةٍ", 32.08, 32.6], ["كافية.", 32.68, 33.16]]}, {"text": "لنفترضْ أنّها نجحت. يصطفُّ الملايينُ لرؤيةِ الأهراماتِ وهي تُبنى، والديناصوراتِ وهي حيّة.", "start": 33.46, "end": 40.04, "words": [["لنفترضْ", 33.46, 34.05], ["أنّها", 34.08, 34.33], ["نجحت.", 34.38, 34.91], ["يصطفُّ", 35.27, 35.75], ["الملايينُ", 35.77, 36.37], ["لرؤيةِ", 36.43, 36.85], ["الأهراماتِ", 36.88, 37.49], ["وهي", 37.51, 37.72], ["تُبنى،", 37.78, 38.29], ["والديناصوراتِ", 38.52, 39.3], ["وهي", 39.35, 39.53], ["حيّة.", 39.6, 40.04]]}, {"text": "لكنْ احذر: تغييرٌ صغيرٌ في الماضي قد يمحو وجودَك. هذه مفارقةُ الجَدّ.", "start": 40.48, "end": 45.87, "words": [["لكنْ", 40.48, 40.83], ["احذر:", 40.85, 41.32], ["تغييرٌ", 41.6, 42.03], ["صغيرٌ", 42.11, 42.43], ["في", 42.49, 42.55], ["الماضي", 42.57, 42.9], ["قد", 42.96, 43.11], ["يمحو", 43.17, 43.5], ["وجودَك.", 43.53, 44.09], ["هذه", 44.42, 44.7], ["مفارقةُ", 44.76, 45.28], ["الجَدّ.", 45.31, 45.87]]}, {"text": "ومَن يعرفُ المستقبلَ يربحُ كلَّ شيء، فتنهارُ البورصاتُ وتفقدُ الرهاناتُ معناها.", "start": 46.2, "end": 52.48, "words": [["ومَن", 46.2, 46.52], ["يعرفُ", 46.6, 46.96], ["المستقبلَ", 46.98, 47.69], ["يربحُ", 47.94, 48.37], ["كلَّ", 48.41, 48.65], ["شيء،", 48.7, 49.13], ["فتنهارُ", 49.31, 49.9], ["البورصاتُ", 49.92, 50.52], ["وتفقدُ", 50.84, 51.39], ["الرهاناتُ", 51.41, 51.88], ["معناها.", 51.93, 52.48]]}, {"text": "لكنّ ستيفن هوكينغ ظنَّ أنّ الطبيعةَ نفسَها تمنعُ ذلك، فالبوابةُ قد تتدمّرُ لحظةَ فتحِها.", "start": 52.86, "end": 59.2, "words": [["لكنّ", 52.86, 53.2], ["ستيفن", 53.23, 53.52], ["هوكينغ", 53.59, 54.01], ["ظنَّ", 54.22, 54.51], ["أنّ", 54.54, 54.68], ["الطبيعةَ", 54.71, 55.18], ["نفسَها", 55.24, 55.6], ["تمنعُ", 55.66, 55.98], ["ذلك،", 56.03, 56.52], ["فالبوابةُ", 56.73, 57.42], ["قد", 57.49, 57.62], ["تتدمّرُ", 57.67, 58.25], ["لحظةَ", 58.28, 58.62], ["فتحِها.", 58.66, 59.2]]}, {"text": "والأغرب؟ حتّى لو نجحت، فلن تعيدَك إلى ما قبلَ يومِ صنعِها.", "start": 59.52, "end": 64.02, "words": [["والأغرب؟", 59.52, 60.26], ["حتّى", 60.46, 60.77], ["لو", 60.8, 60.89], ["نجحت،", 60.95, 61.5], ["فلن", 61.62, 61.92], ["تعيدَك", 61.97, 62.4], ["إلى", 62.52, 62.63], ["ما", 62.7, 62.77], ["قبلَ", 62.86, 63.11], ["يومِ", 63.17, 63.38], ["صنعِها.", 63.45, 64.02]]}, {"text": "لذلك لن يزورَنا أحدٌ من المستقبل… قبلَ أن نصنعَ أوّلَ بوابة.", "start": 64.34, "end": 69.03, "words": [["لذلك", 64.34, 64.82], ["لن", 64.9, 65.02], ["يزورَنا", 65.07, 65.52], ["أحدٌ", 65.56, 65.92], ["من", 65.96, 66.07], ["المستقبل…", 66.11, 66.92], ["قبلَ", 67.2, 67.5], ["أن", 67.55, 67.62], ["نصنعَ", 67.66, 68.11], ["أوّلَ", 68.14, 68.45], ["بوابة.", 68.5, 69.03]]}, {"text": "وعامَ ألفينِ وتسعة، أقامَ هوكينغ حفلةً للمسافرينَ عبرَ الزمن، وأرسلَ الدعواتِ بعدَ انتهائها.", "start": 69.31, "end": 76.36, "words": [["وعامَ", 69.31, 69.73], ["ألفينِ", 69.78, 70.17], ["وتسعة،", 70.22, 70.9], ["أقامَ", 71.08, 71.48], ["هوكينغ", 71.53, 71.86], ["حفلةً", 71.92, 72.34], ["للمسافرينَ", 72.36, 73.08], ["عبرَ", 73.12, 73.35], ["الزمن،", 73.38, 73.91], ["وأرسلَ", 74.12, 74.64], ["الدعواتِ", 74.67, 75.35], ["بعدَ", 75.42, 75.63], ["انتهائها.", 75.65, 76.36]]}, {"text": "ولم يأتِ أحد.", "start": 76.68, "end": 77.8, "words": [["ولم", 76.68, 76.97], ["يأتِ", 77.04, 77.26], ["أحد.", 77.32, 77.8]]}, {"text": "لو فُتحت البوابةُ اليوم، إلى أيِّ زمنٍ تذهب؟ اكتبْ في التعليقات، واشتركْ.", "start": 78.12, "end": 84.19, "words": [["لو", 78.12, 78.27], ["فُتحت", 78.32, 78.68], ["البوابةُ", 78.74, 79.3], ["اليوم،", 79.32, 79.81], ["إلى", 80.05, 80.26], ["أيِّ", 80.33, 80.6], ["زمنٍ", 80.64, 80.97], ["تذهب؟", 81.04, 81.54], ["اكتبْ", 81.75, 82.14], ["في", 82.16, 82.22], ["التعليقات،", 82.26, 83.1], ["واشتركْ.", 83.28, 84.19]]}]