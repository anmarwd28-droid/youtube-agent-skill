[{"text": "ماذا لو استطاعَ كلُّ البشرِ الطيران؟", "start": 0.0, "end": 2.3, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.45], ["استطاعَ", 0.48, 0.91], ["كلُّ", 0.94, 1.17], ["البشرِ", 1.2, 1.6], ["الطيران؟", 1.62, 2.3]]}, {"text": "أوّلاً، ستحتاجُ جناحَين بعرضِ سبعةِ أمتار: بطولِ حافلةٍ صغيرة.", "start": 2.73, "end": 7.85, "words": [["أوّلاً،", 2.73, 3.26], ["ستحتاجُ", 3.41, 3.96], ["جناحَين", 4.03, 4.56], ["بعرضِ", 4.61, 4.97], ["سبعةِ", 5.03, 5.38], ["أمتار:", 5.42, 5.97], ["بطولِ", 6.28, 6.68], ["حافلةٍ", 6.75, 7.26], ["صغيرة.", 7.33, 7.85]]}, {"text": "وعضلاتُ صدرِك يجبُ أن تبلغَ خُمسَ وزنِك، كما عندَ الطيور.", "start": 8.22, "end": 12.74, "words": [["وعضلاتُ", 8.22, 8.92], ["صدرِك", 9.0, 9.35], ["يجبُ", 9.44, 9.75], ["أن", 9.81, 9.89], ["تبلغَ", 9.96, 10.43], ["خُمسَ", 10.51, 10.89], ["وزنِك،", 10.95, 11.48], ["كما", 11.66, 11.9], ["عندَ", 11.96, 12.16], ["الطيور.", 12.18, 12.74]]}, {"text": "وساعةُ طيرانٍ واحدةٌ تحرقُ ألفاً وخمسَمئةِ سعرة: طاقةَ وجبتَين كاملتَين.", "start": 13.05, "end": 19.35, "words": [["وساعةُ", 13.05, 13.62], ["طيرانٍ", 13.69, 14.13], ["واحدةٌ", 14.2, 14.74], ["تحرقُ", 14.91, 15.35], ["ألفاً", 15.39, 15.71], ["وخمسَمئةِ", 15.78, 16.52], ["سعرة:", 16.58, 17.08], ["طاقةَ", 17.39, 17.84], ["وجبتَين", 17.89, 18.47], ["كاملتَين.", 18.59, 19.35]]}, {"text": "وكلّما ارتفعتَ كيلومتراً، بردَ الهواءُ ستَّ درجاتٍ ونصفاً… وقلَّ الأكسجين.", "start": 19.73, "end": 25.72, "words": [["وكلّما", 19.73, 20.18], ["ارتفعتَ", 20.2, 20.72], ["كيلومتراً،", 20.78, 21.51], ["بردَ", 21.69, 21.98], ["الهواءُ", 22.01, 22.44], ["ستَّ", 22.51, 22.8], ["درجاتٍ", 22.85, 23.41], ["ونصفاً…", 23.64, 24.37], ["وقلَّ", 24.57, 24.98], ["الأكسجين.", 25.02, 25.72]]}, {"text": "أمّا المدن؟ ستفرغُ الشوارعُ من الزحام، وتصبحُ الأبوابُ على الأسطح.", "start": 26.02, "end": 31.02, "words": [["أمّا", 26.02, 26.23], ["المدن؟", 26.25, 26.75], ["ستفرغُ", 27.02, 27.59], ["الشوارعُ", 27.61, 28.13], ["من", 28.14, 28.25], ["الزحام،", 28.32, 28.94], ["وتصبحُ", 29.11, 29.73], ["الأبوابُ", 29.76, 30.29], ["على", 30.34, 30.44], ["الأسطح.", 30.48, 31.02]]}, {"text": "لكنّ السماءَ ستحتاجُ إشاراتِ مرور، وعاصفةٌ واحدةٌ تُبقي مدينةً كاملةً على الأرض.", "start": 31.34, "end": 37.42, "words": [["لكنّ", 31.34, 31.7], ["السماءَ", 31.72, 32.15], ["ستحتاجُ", 32.21, 32.79], ["إشاراتِ", 32.82, 33.22], ["مرور،", 33.27, 33.81], ["وعاصفةٌ", 34.04, 34.73], ["واحدةٌ", 34.81, 35.33], ["تُبقي", 35.41, 35.71], ["مدينةً", 35.76, 36.25], ["كاملةً", 36.3, 36.78], ["على", 36.81, 36.92], ["الأرض.", 36.95, 37.42]]}, {"text": "والغريب؟ الإنسانُ طارَ فعلاً بعضلاتِه: طائرةٌ تعملُ بالدوّاساتِ فقط قطعتْ مئةً وخمسةَ عشرَ كيلومتراً فوقَ البحر.", "start": 37.72, "end": 46.58, "words": [["والغريب؟", 37.72, 38.37], ["الإنسانُ", 38.73, 39.24], ["طارَ", 39.3, 39.52], ["فعلاً", 39.59, 39.89], ["بعضلاتِه:", 39.94, 40.78], ["طائرةٌ", 41.11, 41.67], ["تعملُ", 41.75, 42.09], ["بالدوّاساتِ", 42.14, 42.89], ["فقط", 42.95, 43.3], ["قطعتْ", 43.37, 43.84], ["مئةً", 43.87, 44.31], ["وخمسةَ", 44.37, 44.88], ["عشرَ", 44.93, 45.21], ["كيلومتراً", 45.27, 45.77], ["فوقَ", 45.81, 46.04], ["البحر.", 46.08, 46.58]]}, {"text": "إلى أين ستطيرُ أوّلاً؟ اكتبْ في التعليقات… واشتركْ.", "start": 46.96, "end": 51.31, "words": [["إلى", 46.96, 47.19], ["أين", 47.26, 47.47], ["ستطيرُ", 47.56, 48.05], ["أوّلاً؟", 48.1, 48.6], ["اكتبْ", 48.77, 49.16], ["في", 49.18, 49.25], ["التعليقات…", 49.28, 50.2], ["واشتركْ.", 50.38, 51.31]]}]