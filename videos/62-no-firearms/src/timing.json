[{"text": "ماذا لو لم تُخترَعِ الأسلحةُ الناريّةُ أبداً؟", "start": 0.0, "end": 2.9, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.5], ["لم", 0.56, 0.66], ["تُخترَعِ", 0.74, 1.21], ["الأسلحةُ", 1.23, 1.81], ["الناريّةُ", 1.83, 2.37], ["أبداً؟", 2.43, 2.9]]}, {"text": "اليومَ في العالمِ أكثرُ من مليارِ سلاحٍ ناريّ… وكلُّها بدأت بصدفة.", "start": 3.34, "end": 8.51, "words": [["اليومَ", 3.34, 3.74], ["في", 3.8, 3.85], ["العالمِ", 3.89, 4.39], ["أكثرُ", 4.45, 4.89], ["من", 4.93, 5.05], ["مليارِ", 5.11, 5.54], ["سلاحٍ", 5.6, 5.96], ["ناريّ…", 5.99, 6.5], ["وكلُّها", 6.83, 7.43], ["بدأت", 7.5, 7.8], ["بصدفة.", 7.85, 8.51]]}, {"text": "قبلَ نحوِ ألفٍ ومئتي سنة، كان كيميائيّونَ في الصين يبحثونَ عن دواءٍ للخلود، فاكتشفوا البارود.", "start": 8.84, "end": 15.76, "words": [["قبلَ", 8.84, 9.09], ["نحوِ", 9.15, 9.44], ["ألفٍ", 9.48, 9.81], ["ومئتي", 9.88, 10.36], ["سنة،", 10.44, 10.86], ["كان", 11.03, 11.24], ["كيميائيّونَ", 11.33, 11.95], ["في", 12.01, 12.09], ["الصين", 12.11, 12.45], ["يبحثونَ", 12.48, 13.04], ["عن", 13.07, 13.17], ["دواءٍ", 13.21, 13.5], ["للخلود،", 13.54, 14.21], ["فاكتشفوا", 14.49, 15.12], ["البارود.", 15.14, 15.76]]}, {"text": "في عالمِنا صارَ البارودُ مدافعَ وبنادق. أمّا هنا، فيبقى ألعاباً ناريّةً فقط.", "start": 16.03, "end": 22.15, "words": [["في", 16.03, 16.15], ["عالمِنا", 16.27, 16.73], ["صارَ", 16.85, 17.09], ["البارودُ", 17.12, 17.59], ["مدافعَ", 17.65, 18.19], ["وبنادق.", 18.22, 18.98], ["أمّا", 19.31, 19.6], ["هنا،", 19.66, 20.11], ["فيبقى", 20.26, 20.64], ["ألعاباً", 20.67, 21.15], ["ناريّةً", 21.21, 21.66], ["فقط.", 21.7, 22.15]]}, {"text": "فتبقى الحروبُ بالسيوفِ والرماحِ والأقواس، ويبقى الفارسُ بدرعِه الحديديّ سيّدَ المعركة.", "start": 22.44, "end": 29.01, "words": [["فتبقى", 22.44, 22.84], ["الحروبُ", 22.85, 23.27], ["بالسيوفِ", 23.31, 23.84], ["والرماحِ", 23.88, 24.34], ["والأقواس،", 24.36, 25.07], ["ويبقى", 25.34, 25.79], ["الفارسُ", 25.81, 26.38], ["بدرعِه", 26.47, 26.98], ["الحديديّ", 27.03, 27.74], ["سيّدَ", 27.95, 28.39], ["المعركة.", 28.41, 29.01]]}, {"text": "والقلاعُ لا تسقط. أسوارُ القسطنطينيّةِ صمدت ألفَ سنة، حتّى حطّمتها المدافعُ عامَ ألفٍ وأربعمئةٍ وثلاثةٍ وخمسين.", "start": 29.3, "end": 37.97, "words": [["والقلاعُ", 29.3, 29.9], ["لا", 29.92, 29.99], ["تسقط.", 30.05, 30.56], ["أسوارُ", 30.78, 31.2], ["القسطنطينيّةِ", 31.22, 32.17], ["صمدت", 32.41, 32.83], ["ألفَ", 32.89, 33.18], ["سنة،", 33.22, 33.61], ["حتّى", 33.85, 34.12], ["حطّمتها", 34.18, 34.7], ["المدافعُ", 34.73, 35.34], ["عامَ", 35.4, 35.63], ["ألفٍ", 35.66, 35.98], ["وأربعمئةٍ", 36.05, 36.71], ["وثلاثةٍ", 36.77, 37.29], ["وخمسين.", 37.35, 37.97]]}, {"text": "سهمُ القوسِ يطيرُ بنحوِ ستّينَ متراً في الثانية، ورصاصةُ البندقيّةِ الحديثة أسرعُ منه خمسَ عشرةَ مرّة.", "start": 38.35, "end": 46.17, "words": [["سهمُ", 38.35, 38.63], ["القوسِ", 38.65, 39.05], ["يطيرُ", 39.08, 39.39], ["بنحوِ", 39.44, 39.87], ["ستّينَ", 39.93, 40.33], ["متراً", 40.38, 40.67], ["في", 40.72, 40.77], ["الثانية،", 40.81, 41.41], ["ورصاصةُ", 41.74, 42.39], ["البندقيّةِ", 42.41, 43.12], ["الحديثة", 43.14, 43.83], ["أسرعُ", 44.07, 44.58], ["منه", 44.62, 44.83], ["خمسَ", 44.94, 45.24], ["عشرةَ", 45.29, 45.66], ["مرّة.", 45.72, 46.17]]}, {"text": "والرامي الماهرُ يحتاجُ سنواتٍ من التدريب، أمّا البندقيّةُ فيتعلّمُها الجنديُّ في أسابيع. فتبقى الجيوشُ صغيرة.", "start": 46.56, "end": 54.72, "words": [["والرامي", 46.56, 46.99], ["الماهرُ", 47.01, 47.5], ["يحتاجُ", 47.55, 47.97], ["سنواتٍ", 48.02, 48.49], ["من", 48.52, 48.62], ["التدريب،", 48.68, 49.3], ["أمّا", 49.62, 49.89], ["البندقيّةُ", 49.91, 50.68], ["فيتعلّمُها", 50.75, 51.5], ["الجنديُّ", 51.52, 52.0], ["في", 52.02, 52.09], ["أسابيع.", 52.15, 52.79], ["فتبقى", 53.12, 53.59], ["الجيوشُ", 53.62, 54.09], ["صغيرة.", 54.15, 54.72]]}, {"text": "ولا تستطيعُ جيوشٌ صغيرةٌ أن تحكمَ قارّاتٍ بعيدة، فتتغيّرُ خريطةُ العالمِ كلُّها.", "start": 55.04, "end": 61.19, "words": [["ولا", 55.04, 55.25], ["تستطيعُ", 55.31, 55.81], ["جيوشٌ", 55.87, 56.2], ["صغيرةٌ", 56.26, 56.81], ["أن", 57.09, 57.21], ["تحكمَ", 57.3, 57.68], ["قارّاتٍ", 57.74, 58.12], ["بعيدة،", 58.19, 58.75], ["فتتغيّرُ", 58.94, 59.74], ["خريطةُ", 59.8, 60.23], ["العالمِ", 60.26, 60.62], ["كلُّها.", 60.66, 61.19]]}, {"text": "لكنّ الحروبَ لا تختفي، فالبشرُ تقاتلوا آلافَ السنينَ قبلَ البارود.", "start": 61.5, "end": 66.12, "words": [["لكنّ", 61.5, 61.85], ["الحروبَ", 61.87, 62.27], ["لا", 62.29, 62.36], ["تختفي،", 62.42, 63.08], ["فالبشرُ", 63.24, 63.76], ["تقاتلوا", 63.82, 64.35], ["آلافَ", 64.39, 64.8], ["السنينَ", 64.81, 65.24], ["قبلَ", 65.31, 65.52], ["البارود.", 65.54, 66.12]]}, {"text": "والمفاجأة: البنادقُ ساعدت في صنعِ عالمِنا الحديث.", "start": 66.44, "end": 70.08, "words": [["والمفاجأة:", 66.44, 67.34], ["البنادقُ", 67.62, 68.2], ["ساعدت", 68.28, 68.64], ["في", 68.7, 68.74], ["صنعِ", 68.82, 69.11], ["عالمِنا", 69.15, 69.51], ["الحديث.", 69.53, 70.08]]}, {"text": "فآلةٌ صُنعت لثقبِ المدافعِ بدقّة، هي التي صنعت أسطواناتِ أوّلِ محرّكاتٍ بخاريّةٍ قويّة.", "start": 70.45, "end": 77.25, "words": [["فآلةٌ", 70.45, 71.08], ["صُنعت", 71.18, 71.61], ["لثقبِ", 71.67, 72.04], ["المدافعِ", 72.08, 72.67], ["بدقّة،", 72.73, 73.33], ["هي", 73.57, 73.74], ["التي", 73.76, 73.99], ["صنعت", 74.08, 74.45], ["أسطواناتِ", 74.49, 75.04], ["أوّلِ", 75.09, 75.42], ["محرّكاتٍ", 75.47, 76.08], ["بخاريّةٍ", 76.14, 76.69], ["قويّة.", 76.77, 77.25]]}, {"text": "ومصانعُ البنادقِ علّمتِ العالمَ صنعَ قطعٍ متطابقةٍ تماماً، ومنها جاءتِ المصانعُ والسيّاراتُ الحديثة.", "start": 77.69, "end": 85.56, "words": [["ومصانعُ", 77.69, 78.28], ["البنادقِ", 78.3, 79.02], ["علّمتِ", 79.16, 79.6], ["العالمَ", 79.63, 80.03], ["صنعَ", 80.09, 80.35], ["قطعٍ", 80.41, 80.79], ["متطابقةٍ", 80.84, 81.58], ["تماماً،", 81.64, 82.26], ["ومنها", 82.52, 82.97], ["جاءتِ", 83.08, 83.43], ["المصانعُ", 83.47, 84.06], ["والسيّاراتُ", 84.34, 84.94], ["الحديثة.", 84.96, 85.56]]}, {"text": "فعالمٌ بلا بنادق قد يكونُ أهدأَ قليلاً… لكنّه أبطأُ في التقدّم.", "start": 85.94, "end": 91.24, "words": [["فعالمٌ", 85.94, 86.46], ["بلا", 86.53, 86.73], ["بنادق", 86.8, 87.26], ["قد", 87.44, 87.61], ["يكونُ", 87.67, 88.02], ["أهدأَ", 88.09, 88.47], ["قليلاً…", 88.53, 89.12], ["لكنّه", 89.5, 89.97], ["أبطأُ", 90.06, 90.4], ["في", 90.45, 90.51], ["التقدّم.", 90.55, 91.24]]}, {"text": "برأيك، هل يكونُ العالمُ أفضلَ بلا أسلحةٍ ناريّة؟ اكتبْ في التعليقات، واشتركْ.", "start": 91.57, "end": 97.85, "words": [["برأيك،", 91.57, 92.17], ["هل", 92.35, 92.52], ["يكونُ", 92.58, 92.88], ["العالمُ", 92.9, 93.3], ["أفضلَ", 93.33, 93.7], ["بلا", 93.76, 93.94], ["أسلحةٍ", 93.97, 94.47], ["ناريّة؟", 94.52, 95.12], ["اكتبْ", 95.56, 95.97], ["في", 96.0, 96.07], ["التعليقات،", 96.11, 96.91], ["واشتركْ.", 96.98, 97.85]]}]