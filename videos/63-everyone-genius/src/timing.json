[{"text": "ماذا لو استيقظَ كلُّ البشرِ غداً… عباقرة؟", "start": 0.0, "end": 3.22, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.43], ["استيقظَ", 0.46, 0.96], ["كلُّ", 1.02, 1.28], ["البشرِ", 1.3, 1.72], ["غداً…", 1.78, 2.22], ["عباقرة؟", 2.52, 3.22]]}, {"text": "اليومَ، نحوُ اثنينِ بالمئةِ فقط من الناسِ يتجاوزُ مُعامِلُ ذكائِهم مئةً وثلاثين.", "start": 3.56, "end": 10.03, "words": [["اليومَ،", 3.56, 4.12], ["نحوُ", 4.26, 4.55], ["اثنينِ", 4.57, 4.91], ["بالمئةِ", 4.97, 5.6], ["فقط", 5.89, 6.26], ["من", 6.34, 6.43], ["الناسِ", 6.5, 6.85], ["يتجاوزُ", 6.87, 7.45], ["مُعامِلُ", 7.5, 7.93], ["ذكائِهم", 7.99, 8.57], ["مئةً", 8.92, 9.32], ["وثلاثين.", 9.37, 10.03]]}, {"text": "فجأةً، يصبحُ ثمانيةُ ملياراتِ إنسانٍ بذكاءِ أعظمِ العلماء.", "start": 10.44, "end": 15.12, "words": [["فجأةً،", 10.44, 11.12], ["يصبحُ", 11.38, 11.82], ["ثمانيةُ", 11.9, 12.43], ["ملياراتِ", 12.49, 13.0], ["إنسانٍ", 13.06, 13.53], ["بذكاءِ", 13.6, 14.08], ["أعظمِ", 14.12, 14.51], ["العلماء.", 14.54, 15.12]]}, {"text": "والغريب: العبقريّةُ لا تحتاجُ دماغاً أكبر. فدماغُ أينشتاين كانَ أخفَّ من المتوسّط.", "start": 15.52, "end": 21.51, "words": [["والغريب:", 15.52, 16.11], ["العبقريّةُ", 16.35, 17.01], ["لا", 17.07, 17.14], ["تحتاجُ", 17.18, 17.55], ["دماغاً", 17.59, 17.95], ["أكبر.", 17.96, 18.46], ["فدماغُ", 18.71, 19.17], ["أينشتاين", 19.23, 19.77], ["كانَ", 19.88, 20.1], ["أخفَّ", 20.13, 20.49], ["من", 20.54, 20.63], ["المتوسّط.", 20.68, 21.51]]}, {"text": "والدماغُ يستهلكُ عشرينَ بالمئةِ من طاقةِ الجسم، رغمَ أنّ وزنَه اثنانِ بالمئةِ فقط.", "start": 21.84, "end": 27.48, "words": [["والدماغُ", 21.84, 22.31], ["يستهلكُ", 22.36, 22.86], ["عشرينَ", 22.93, 23.34], ["بالمئةِ", 23.39, 23.75], ["من", 23.79, 23.88], ["طاقةِ", 23.94, 24.28], ["الجسم،", 24.3, 24.89], ["رغمَ", 25.22, 25.47], ["أنّ", 25.51, 25.67], ["وزنَه", 25.73, 26.09], ["اثنانِ", 26.12, 26.55], ["بالمئةِ", 26.6, 26.98], ["فقط.", 27.03, 27.48]]}, {"text": "في العالمِ اليومَ نحوُ تسعةِ ملايينِ باحث. تخيّلْ ملياراتٍ منهم يعملونَ معاً.", "start": 27.81, "end": 33.4, "words": [["في", 27.81, 27.91], ["العالمِ", 27.95, 28.39], ["اليومَ", 28.41, 28.92], ["نحوُ", 29.04, 29.34], ["تسعةِ", 29.4, 29.84], ["ملايينِ", 29.89, 30.24], ["باحث.", 30.29, 30.78], ["تخيّلْ", 31.16, 31.59], ["ملياراتٍ", 31.61, 32.18], ["منهم", 32.24, 32.54], ["يعملونَ", 32.6, 32.99], ["معاً.", 33.04, 33.4]]}, {"text": "أمراضٌ احتاجت عقوداً، قد يُوجَدُ علاجُها في سنوات، وتتسارعُ الطاقةُ النظيفةُ والسفرُ إلى الفضاء.", "start": 33.73, "end": 41.42, "words": [["أمراضٌ", 33.73, 34.2], ["احتاجت", 34.23, 34.68], ["عقوداً،", 34.76, 35.38], ["قد", 35.62, 35.79], ["يُوجَدُ", 35.86, 36.2], ["علاجُها", 36.27, 36.72], ["في", 36.8, 36.88], ["سنوات،", 36.97, 37.63], ["وتتسارعُ", 37.91, 38.68], ["الطاقةُ", 38.71, 39.16], ["النظيفةُ", 39.18, 39.84], ["والسفرُ", 40.08, 40.72], ["إلى", 40.74, 40.84], ["الفضاء.", 40.88, 41.42]]}, {"text": "لكنْ مَن سيقودُ الحافلاتِ ويزرعُ القمح؟ سيصنعُ العباقرةُ آلاتٍ تقومُ بذلك.", "start": 41.84, "end": 47.74, "words": [["لكنْ", 41.84, 42.17], ["مَن", 42.19, 42.31], ["سيقودُ", 42.4, 42.9], ["الحافلاتِ", 42.92, 43.49], ["ويزرعُ", 43.5, 43.87], ["القمح؟", 43.9, 44.45], ["سيصنعُ", 44.87, 45.44], ["العباقرةُ", 45.45, 46.21], ["آلاتٍ", 46.29, 46.71], ["تقومُ", 46.78, 47.11], ["بذلك.", 47.15, 47.74]]}, {"text": "وتشيرُ دراساتٌ إلى أنّ الأذكى يعيشونَ أطولَ في المتوسّط.", "start": 48.11, "end": 51.87, "words": [["وتشيرُ", 48.11, 48.67], ["دراساتٌ", 48.73, 49.33], ["إلى", 49.38, 49.53], ["أنّ", 49.59, 49.74], ["الأذكى", 49.77, 50.17], ["يعيشونَ", 50.21, 50.68], ["أطولَ", 50.71, 51.04], ["في", 51.08, 51.14], ["المتوسّط.", 51.16, 51.87]]}, {"text": "فهل تنتهي الحروبُ والخلافات؟ ليس بالضرورة. فالذكاءُ ليس حكمة، والأذكياءُ يتجادلونَ بمهارةٍ أكبر.", "start": 52.29, "end": 59.67, "words": [["فهل", 52.29, 52.58], ["تنتهي", 52.64, 52.99], ["الحروبُ", 53.0, 53.42], ["والخلافات؟", 53.44, 54.24], ["ليس", 54.55, 54.8], ["بالضرورة.", 54.89, 55.54], ["فالذكاءُ", 55.86, 56.4], ["ليس", 56.45, 56.61], ["حكمة،", 56.72, 57.27], ["والأذكياءُ", 57.39, 58.07], ["يتجادلونَ", 58.1, 58.71], ["بمهارةٍ", 58.76, 59.23], ["أكبر.", 59.28, 59.67]]}, {"text": "والمفاجأة؟ اختبارُ الذكاءِ نسبيّ. لو صارَ الجميعُ عباقرة، يُعادُ ضبطُه… فيصبحُ الكلُّ متوسّطين.", "start": 59.98, "end": 68.36, "words": [["والمفاجأة؟", 59.98, 60.81], ["اختبارُ", 61.05, 61.64], ["الذكاءِ", 61.65, 62.15], ["نسبيّ.", 62.18, 62.82], ["لو", 63.18, 63.33], ["صارَ", 63.4, 63.62], ["الجميعُ", 63.66, 64.19], ["عباقرة،", 64.22, 65.02], ["يُعادُ", 65.16, 65.57], ["ضبطُه…", 65.63, 66.26], ["فيصبحُ", 66.51, 67.06], ["الكلُّ", 67.08, 67.44], ["متوسّطين.", 67.47, 68.36]]}, {"text": "بل هذا حدثَ فعلاً: في القرنِ العشرين، ارتفعت درجاتُ الذكاءِ نحوَ ثلاثِ نقاطٍ كلَّ عشرِ سنوات.", "start": 68.72, "end": 75.28, "words": [["بل", 68.72, 68.83], ["هذا", 68.88, 69.06], ["حدثَ", 69.11, 69.4], ["فعلاً:", 69.46, 69.93], ["في", 70.18, 70.26], ["القرنِ", 70.3, 70.61], ["العشرين،", 70.64, 71.32], ["ارتفعت", 71.48, 72.03], ["درجاتُ", 72.06, 72.53], ["الذكاءِ", 72.55, 73.0], ["نحوَ", 73.04, 73.28], ["ثلاثِ", 73.34, 73.65], ["نقاطٍ", 73.71, 74.09], ["كلَّ", 74.14, 74.41], ["عشرِ", 74.42, 74.66], ["سنوات.", 74.71, 75.28]]}, {"text": "فالإنسانُ العاديُّ عامَ ألفٍ وتسعمئة، بمقاييسِ اليوم، يحصلُ على نحوِ سبعين.", "start": 75.72, "end": 81.78, "words": [["فالإنسانُ", 75.72, 76.35], ["العاديُّ", 76.37, 76.89], ["عامَ", 76.92, 77.15], ["ألفٍ", 77.18, 77.47], ["وتسعمئة،", 77.52, 78.42], ["بمقاييسِ", 78.63, 79.39], ["اليوم،", 79.41, 79.98], ["يحصلُ", 80.19, 80.62], ["على", 80.68, 80.81], ["نحوِ", 80.88, 81.12], ["سبعين.", 81.18, 81.78]]}, {"text": "أي أنّ ما تخيّلناه… يحدثُ ببطء، دونَ أن نلاحظ.", "start": 82.11, "end": 86.33, "words": [["أي", 82.11, 82.28], ["أنّ", 82.34, 82.58], ["ما", 82.64, 82.71], ["تخيّلناه…", 82.78, 83.75], ["يحدثُ", 84.0, 84.51], ["ببطء،", 84.58, 85.1], ["دونَ", 85.31, 85.58], ["أن", 85.61, 85.72], ["نلاحظ.", 85.74, 86.33]]}, {"text": "لو صرتَ عبقريّاً غداً، ماذا ستفعل؟ اكتبْ في التعليقات، واشتركْ.", "start": 86.72, "end": 91.81, "words": [["لو", 86.72, 86.84], ["صرتَ", 86.91, 87.13], ["عبقريّاً", 87.16, 87.7], ["غداً،", 87.77, 88.24], ["ماذا", 88.35, 88.61], ["ستفعل؟", 88.67, 89.34], ["اكتبْ", 89.58, 89.99], ["في", 90.01, 90.07], ["التعليقات،", 90.11, 90.87], ["واشتركْ.", 90.94, 91.81]]}]