[{"text": "ماذا لو لم يمرضْ أيُّ إنسانٍ على الأرضِ… بعدَ اليومِ أبداً؟", "start": 0.0, "end": 4.42, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.44], ["لم", 0.51, 0.63], ["يمرضْ", 0.7, 1.07], ["أيُّ", 1.09, 1.33], ["إنسانٍ", 1.36, 1.82], ["على", 1.89, 2.04], ["الأرضِ…", 2.08, 2.71], ["بعدَ", 3.15, 3.4], ["اليومِ", 3.44, 3.81], ["أبداً؟", 3.85, 4.42]]}, {"text": "لا زُكامَ، ولا حُمّى، ولا سرطان. جهازُ المناعةِ ينتصرُ في كلِّ معركة.", "start": 4.87, "end": 10.58, "words": [["لا", 4.87, 5.0], ["زُكامَ،", 5.07, 5.63], ["ولا", 5.7, 5.93], ["حُمّى،", 5.99, 6.47], ["ولا", 6.51, 6.72], ["سرطان.", 6.78, 7.43], ["جهازُ", 8.03, 8.43], ["المناعةِ", 8.46, 9.07], ["ينتصرُ", 9.11, 9.6], ["في", 9.66, 9.73], ["كلِّ", 9.8, 10.02], ["معركة.", 10.05, 10.58]]}, {"text": "في جسمِك الآنَ نحوُ ثمانيةٍ وثلاثينَ تريليونَ بكتيريا، أكثرُ من خلاياكَ نفسِها.", "start": 10.86, "end": 16.92, "words": [["في", 10.86, 10.97], ["جسمِك", 11.09, 11.46], ["الآنَ", 11.53, 11.88], ["نحوُ", 11.94, 12.19], ["ثمانيةٍ", 12.25, 12.86], ["وثلاثينَ", 12.96, 13.6], ["تريليونَ", 13.64, 14.05], ["بكتيريا،", 14.11, 14.79], ["أكثرُ", 15.12, 15.59], ["من", 15.64, 15.72], ["خلاياكَ", 15.79, 16.28], ["نفسِها.", 16.31, 16.92]]}, {"text": "وكلَّ يومٍ تهاجمُك فيروساتٌ وجراثيمُ جديدة، لكنّها في هذا العالمِ تفشلُ دائماً.", "start": 17.24, "end": 23.24, "words": [["وكلَّ", 17.24, 17.66], ["يومٍ", 17.7, 18.01], ["تهاجمُك", 18.09, 18.69], ["فيروساتٌ", 18.81, 19.45], ["وجراثيمُ", 19.53, 20.1], ["جديدة،", 20.16, 20.73], ["لكنّها", 21.06, 21.52], ["في", 21.59, 21.66], ["هذا", 21.71, 21.89], ["العالمِ", 21.91, 22.3], ["تفشلُ", 22.34, 22.71], ["دائماً.", 22.76, 23.24]]}, {"text": "أوّلُ ما يتغيّر: المستشفياتُ تفرغ، ولا يبقى فيها إلّا ضحايا الحوادثِ والولادات.", "start": 23.56, "end": 30.28, "words": [["أوّلُ", 23.56, 23.95], ["ما", 24.01, 24.07], ["يتغيّر:", 24.11, 24.84], ["المستشفياتُ", 25.16, 25.95], ["تفرغ،", 26.02, 26.64], ["ولا", 26.82, 27.06], ["يبقى", 27.12, 27.39], ["فيها", 27.43, 27.7], ["إلّا", 27.77, 27.98], ["ضحايا", 28.05, 28.61], ["الحوادثِ", 28.78, 29.48], ["والولادات.", 29.52, 30.28]]}, {"text": "الصيدلياتُ تُغلق، وملايينُ الأطباءِ والممرّضينَ يبحثونَ عن عملٍ جديد.", "start": 30.64, "end": 36.18, "words": [["الصيدلياتُ", 30.64, 31.38], ["تُغلق،", 31.44, 32.0], ["وملايينُ", 32.15, 32.75], ["الأطباءِ", 32.77, 33.37], ["والممرّضينَ", 33.39, 34.3], ["يبحثونَ", 34.51, 35.09], ["عن", 35.14, 35.25], ["عملٍ", 35.31, 35.6], ["جديد.", 35.64, 36.18]]}, {"text": "والعالمُ ينفقُ اليومَ نحوَ عشرةِ تريليوناتِ دولارٍ كلَّ عامٍ على الصحّة… تذهبُ كلُّها إلى المدارسِ والعلوم.", "start": 36.48, "end": 44.02, "words": [["والعالمُ", 36.48, 37.0], ["ينفقُ", 37.04, 37.47], ["اليومَ", 37.5, 37.86], ["نحوَ", 37.88, 38.17], ["عشرةِ", 38.2, 38.62], ["تريليوناتِ", 38.66, 39.25], ["دولارٍ", 39.3, 39.72], ["كلَّ", 39.96, 40.25], ["عامٍ", 40.32, 40.54], ["على", 40.59, 40.72], ["الصحّة…", 40.75, 41.34], ["تذهبُ", 41.73, 42.17], ["كلُّها", 42.24, 42.61], ["إلى", 42.67, 42.82], ["المدارسِ", 42.85, 43.39], ["والعلوم.", 43.45, 44.02]]}, {"text": "والأهمّ: أكثرُ من ثمانينَ في المئةِ من الوفياتِ في العالمِ سببُها المرض.", "start": 44.27, "end": 49.76, "words": [["والأهمّ:", 44.27, 45.0], ["أكثرُ", 45.33, 45.74], ["من", 45.79, 45.88], ["ثمانينَ", 45.95, 46.44], ["في", 46.51, 46.58], ["المئةِ", 46.61, 47.06], ["من", 47.1, 47.21], ["الوفياتِ", 47.25, 47.82], ["في", 47.88, 47.93], ["العالمِ", 47.96, 48.49], ["سببُها", 48.67, 49.18], ["المرض.", 49.22, 49.76]]}, {"text": "فيعيشُ الناسُ حتّى تشيخَ أجسادُهم ببطء، وقد يتجاوزُ كثيرونَ المئةَ عام.", "start": 50.09, "end": 55.55, "words": [["فيعيشُ", 50.09, 50.57], ["الناسُ", 50.6, 50.93], ["حتّى", 51.02, 51.29], ["تشيخَ", 51.36, 51.82], ["أجسادُهم", 51.84, 52.44], ["ببطء،", 52.49, 53.0], ["وقد", 53.28, 53.6], ["يتجاوزُ", 53.66, 54.28], ["كثيرونَ", 54.32, 54.74], ["المئةَ", 54.77, 55.14], ["عام.", 55.2, 55.55]]}, {"text": "عددُ البشرِ يقفزُ بسرعة، والمدنُ تزدحم، ويصبحُ الطعامُ والماءُ هما التحدّيَ الأكبر.", "start": 55.83, "end": 62.37, "words": [["عددُ", 55.83, 56.17], ["البشرِ", 56.19, 56.65], ["يقفزُ", 56.67, 57.04], ["بسرعة،", 57.08, 57.73], ["والمدنُ", 57.88, 58.36], ["تزدحم،", 58.43, 59.15], ["ويصبحُ", 59.29, 59.93], ["الطعامُ", 59.95, 60.52], ["والماءُ", 60.55, 61.01], ["هما", 61.06, 61.28], ["التحدّيَ", 61.3, 61.81], ["الأكبر.", 61.84, 62.37]]}, {"text": "والأغرب؟ يصبحُ أخطرَ ما يقتلُ البشرَ… السيّارات.", "start": 62.64, "end": 66.65, "words": [["والأغرب؟", 62.64, 63.3], ["يصبحُ", 63.58, 63.99], ["أخطرَ", 64.04, 64.39], ["ما", 64.44, 64.51], ["يقتلُ", 64.55, 64.87], ["البشرَ…", 64.9, 65.66], ["السيّارات.", 65.98, 66.65]]}, {"text": "فحوادثُ الطرقِ وحدَها تقتلُ اليومَ أكثرَ من مليونِ إنسانٍ كلَّ عام.", "start": 66.86, "end": 71.55, "words": [["فحوادثُ", 66.86, 67.56], ["الطرقِ", 67.58, 67.99], ["وحدَها", 68.03, 68.53], ["تقتلُ", 68.67, 69.06], ["اليومَ", 69.09, 69.42], ["أكثرَ", 69.46, 69.82], ["من", 69.87, 69.97], ["مليونِ", 70.02, 70.42], ["إنسانٍ", 70.45, 70.86], ["كلَّ", 70.92, 71.16], ["عام.", 71.22, 71.55]]}, {"text": "لكنّ الجراثيمَ لا تختفي، فالحيواناتُ والنباتاتُ تبقى تمرض… ونحنُ وحدَنا المحصّنون.", "start": 71.87, "end": 78.69, "words": [["لكنّ", 71.87, 72.2], ["الجراثيمَ", 72.23, 72.83], ["لا", 72.89, 72.96], ["تختفي،", 73.04, 73.75], ["فالحيواناتُ", 73.92, 74.7], ["والنباتاتُ", 74.73, 75.27], ["تبقى", 75.31, 75.61], ["تمرض…", 75.65, 76.33], ["ونحنُ", 76.84, 77.28], ["وحدَنا", 77.31, 77.66], ["المحصّنون.", 77.68, 78.69]]}, {"text": "لو لم تمرضْ أبداً، ماذا ستفعلُ أوّلاً؟ اكتبْ في التعليقات، واشتركْ.", "start": 79.02, "end": 84.43, "words": [["لو", 79.02, 79.16], ["لم", 79.2, 79.32], ["تمرضْ", 79.39, 79.84], ["أبداً،", 79.87, 80.4], ["ماذا", 80.55, 80.82], ["ستفعلُ", 80.88, 81.34], ["أوّلاً؟", 81.38, 81.91], ["اكتبْ", 82.23, 82.57], ["في", 82.59, 82.65], ["التعليقات،", 82.69, 83.47], ["واشتركْ.", 83.58, 84.43]]}]