[{"text": "ماذا لو استطعتَ أن تركضَ بسرعةِ الصوت؟", "start": 0.0, "end": 2.57, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.45], ["استطعتَ", 0.49, 0.93], ["أن", 0.96, 1.04], ["تركضَ", 1.09, 1.45], ["بسرعةِ", 1.51, 1.96], ["الصوت؟", 2.0, 2.57]]}, {"text": "هذا أسرعُ من أسرعِ إنسانٍ في التاريخِ بنحوِ ثمانيةٍ وعشرين ضعفاً.", "start": 3.0, "end": 7.16, "words": [["هذا", 3.0, 3.27], ["أسرعُ", 3.32, 3.73], ["من", 3.75, 3.84], ["أسرعِ", 3.88, 4.2], ["إنسانٍ", 4.24, 4.7], ["في", 4.77, 4.84], ["التاريخِ", 4.87, 5.35], ["بنحوِ", 5.38, 5.71], ["ثمانيةٍ", 5.76, 6.22], ["وعشرين", 6.27, 6.58], ["ضعفاً.", 6.64, 7.16]]}, {"text": "عند أوّلِ خطوة، تصنعُ دويّاً صوتيّاً قد يحطّمُ النوافذَ من حولِك.", "start": 7.55, "end": 12.72, "words": [["عند", 7.55, 7.77], ["أوّلِ", 7.84, 8.13], ["خطوة،", 8.17, 8.8], ["تصنعُ", 8.92, 9.38], ["دويّاً", 9.44, 9.89], ["صوتيّاً", 9.96, 10.6], ["قد", 10.77, 10.96], ["يحطّمُ", 11.03, 11.48], ["النوافذَ", 11.51, 12.03], ["من", 12.07, 12.16], ["حولِك.", 12.2, 12.72]]}, {"text": "ويصطدمُ الهواءُ بوجهِك فيسخنُ نحوَ ستّين درجة.", "start": 13.04, "end": 16.81, "words": [["ويصطدمُ", 13.04, 13.61], ["الهواءُ", 13.63, 14.0], ["بوجهِك", 14.03, 14.58], ["فيسخنُ", 14.91, 15.46], ["نحوَ", 15.52, 15.78], ["ستّين", 15.82, 16.17], ["درجة.", 16.23, 16.81]]}, {"text": "ولكي تشقَّ الهواءَ تحتاجُ قوّةً تقاربُ عشرين ميغاواط… مثلَ محطّةِ كهرباءٍ صغيرة.", "start": 17.12, "end": 23.72, "words": [["ولكي", 17.12, 17.53], ["تشقَّ", 17.58, 17.98], ["الهواءَ", 18.01, 18.6], ["تحتاجُ", 18.8, 19.26], ["قوّةً", 19.32, 19.74], ["تقاربُ", 19.77, 20.26], ["عشرين", 20.31, 20.71], ["ميغاواط…", 20.79, 21.47], ["مثلَ", 21.84, 22.12], ["محطّةِ", 22.18, 22.62], ["كهرباءٍ", 22.69, 23.12], ["صغيرة.", 23.17, 23.72]]}, {"text": "دقيقةٌ واحدةٌ من الركض تحرقُ طاقةً تعادلُ طعامَك لأكثرَ من أربعةِ أشهر.", "start": 24.03, "end": 29.49, "words": [["دقيقةٌ", 24.03, 24.59], ["واحدةٌ", 24.67, 25.11], ["من", 25.15, 25.27], ["الركض", 25.33, 25.68], ["تحرقُ", 26.0, 26.43], ["طاقةً", 26.51, 26.96], ["تعادلُ", 27.0, 27.46], ["طعامَك", 27.52, 27.95], ["لأكثرَ", 28.06, 28.49], ["من", 28.53, 28.61], ["أربعةِ", 28.64, 28.99], ["أشهر.", 29.02, 29.49]]}, {"text": "والأخطر؟ التوقّف. لتتوقّفَ بأمان تحتاجُ أكثرَ من كيلومترٍ كامل.", "start": 29.8, "end": 34.95, "words": [["والأخطر؟", 29.8, 30.54], ["التوقّف.", 30.7, 31.48], ["لتتوقّفَ", 31.68, 32.45], ["بأمان", 32.51, 32.93], ["تحتاجُ", 33.0, 33.41], ["أكثرَ", 33.46, 33.78], ["من", 33.82, 33.91], ["كيلومترٍ", 33.97, 34.44], ["كامل.", 34.49, 34.95]]}, {"text": "والغريب؟ لو بلغتَ نحوَ ثمانيةِ كيلومتراتٍ في الثانية… لدرتَ حولَ الأرضِ في مدارٍ مثلَ الأقمارِ الصناعيّة.", "start": 35.38, "end": 42.74, "words": [["والغريب؟", 35.38, 36.1], ["لو", 36.33, 36.47], ["بلغتَ", 36.52, 36.86], ["نحوَ", 36.92, 37.2], ["ثمانيةِ", 37.24, 37.74], ["كيلومتراتٍ", 37.81, 38.39], ["في", 38.46, 38.52], ["الثانية…", 38.56, 39.16], ["لدرتَ", 39.54, 39.94], ["حولَ", 40.01, 40.23], ["الأرضِ", 40.26, 40.63], ["في", 40.69, 40.76], ["مدارٍ", 40.84, 41.25], ["مثلَ", 41.3, 41.53], ["الأقمارِ", 41.55, 42.02], ["الصناعيّة.", 42.04, 42.74]]}, {"text": "اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 43.06, "end": 46.77, "words": [["اكتبْ", 43.06, 43.43], ["سؤالَك", 43.46, 43.8], ["في", 43.86, 43.92], ["التعليقات،", 43.94, 44.72], ["وقد", 44.84, 45.19], ["يكونُ", 45.26, 45.58], ["الفيديو", 45.62, 45.94], ["القادم.", 45.96, 46.77]]}]