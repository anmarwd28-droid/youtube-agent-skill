[{"text": "ماذا لو اختفى البشرُ جميعاً… في لحظةٍ واحدة؟", "start": 0.0, "end": 3.65, "words": [["ماذا", 0.0, 0.3], ["لو", 0.33, 0.45], ["اختفى", 0.49, 0.85], ["البشرُ", 0.87, 1.31], ["جميعاً…", 1.38, 2.09], ["في", 2.4, 2.54], ["لحظةٍ", 2.62, 3.03], ["واحدة؟", 3.1, 3.65]]}, {"text": "الشوارعُ فارغة، والسياراتُ متوقّفةٌ حيثُ كانت.", "start": 4.08, "end": 7.77, "words": [["الشوارعُ", 4.08, 4.71], ["فارغة،", 4.78, 5.38], ["والسياراتُ", 5.55, 6.21], ["متوقّفةٌ", 6.26, 6.94], ["حيثُ", 7.02, 7.27], ["كانت.", 7.33, 7.77]]}, {"text": "وخلالَ ساعات، تنطفئُ أضواءُ المدن، فمحطّاتُ الكهرباء لا تعملُ طويلاً بلا بشر.", "start": 8.08, "end": 13.86, "words": [["وخلالَ", 8.08, 8.52], ["ساعات،", 8.59, 9.15], ["تنطفئُ", 9.32, 9.89], ["أضواءُ", 9.91, 10.26], ["المدن،", 10.29, 10.86], ["فمحطّاتُ", 11.02, 11.66], ["الكهرباء", 11.69, 12.21], ["لا", 12.26, 12.34], ["تعملُ", 12.41, 12.76], ["طويلاً", 12.81, 13.17], ["بلا", 13.21, 13.38], ["بشر.", 13.41, 13.86]]}, {"text": "وبعدَ نحوِ يومين، تغمرُ المياهُ أنفاقَ المترو في مدنٍ مثل نيويورك، لأنّ المضخّاتِ توقّفت.", "start": 14.18, "end": 20.79, "words": [["وبعدَ", 14.18, 14.59], ["نحوِ", 14.65, 14.88], ["يومين،", 14.92, 15.46], ["تغمرُ", 15.64, 16.03], ["المياهُ", 16.06, 16.51], ["أنفاقَ", 16.54, 16.94], ["المترو", 16.97, 17.32], ["في", 17.37, 17.45], ["مدنٍ", 17.51, 17.9], ["مثل", 18.02, 18.27], ["نيويورك،", 18.34, 18.95], ["لأنّ", 19.21, 19.48], ["المضخّاتِ", 19.52, 20.11], ["توقّفت.", 20.15, 20.79]]}, {"text": "وخلالَ أسابيع، يصبحُ الهواءُ أنقى… فلا مصانعَ ولا عوادم.", "start": 21.23, "end": 25.75, "words": [["وخلالَ", 21.23, 21.7], ["أسابيع،", 21.73, 22.27], ["يصبحُ", 22.3, 22.72], ["الهواءُ", 22.74, 23.2], ["أنقى…", 23.25, 23.87], ["فلا", 24.2, 24.44], ["مصانعَ", 24.48, 24.98], ["ولا", 25.01, 25.17], ["عوادم.", 25.2, 25.75]]}, {"text": "وتعودُ الحيواناتُ إلى المدن… كما حدثَ في تشيرنوبل، بعدَ أن هجرها الناس.", "start": 26.08, "end": 31.4, "words": [["وتعودُ", 26.08, 26.52], ["الحيواناتُ", 26.54, 27.14], ["إلى", 27.2, 27.32], ["المدن…", 27.35, 28.03], ["كما", 28.2, 28.44], ["حدثَ", 28.5, 28.82], ["في", 28.86, 28.94], ["تشيرنوبل،", 28.99, 29.71], ["بعدَ", 29.88, 30.2], ["أن", 30.24, 30.34], ["هجرها", 30.41, 30.84], ["الناس.", 30.86, 31.4]]}, {"text": "وبعدَ سنواتٍ قليلة، تشقُّ النباتاتُ الإسفلت، وتتحوّلُ الشوارعُ إلى أرضٍ خضراء.", "start": 31.68, "end": 37.83, "words": [["وبعدَ", 31.68, 32.1], ["سنواتٍ", 32.16, 32.59], ["قليلة،", 32.67, 33.23], ["تشقُّ", 33.38, 33.78], ["النباتاتُ", 33.81, 34.41], ["الإسفلت،", 34.44, 35.17], ["وتتحوّلُ", 35.38, 36.15], ["الشوارعُ", 36.18, 36.77], ["إلى", 36.83, 36.97], ["أرضٍ", 37.01, 37.23], ["خضراء.", 37.29, 37.83]]}, {"text": "وبعدَ عقود، تبدأُ البيوتُ والجسورُ بالانهيار، بعدما يأكلُها الصدأُ والرطوبة.", "start": 38.21, "end": 44.06, "words": [["وبعدَ", 38.21, 38.65], ["عقود،", 38.68, 39.12], ["تبدأُ", 39.15, 39.52], ["البيوتُ", 39.54, 40.04], ["والجسورُ", 40.09, 40.65], ["بالانهيار،", 40.68, 41.46], ["بعدما", 41.74, 42.14], ["يأكلُها", 42.19, 42.69], ["الصدأُ", 42.71, 43.15], ["والرطوبة.", 43.32, 44.06]]}, {"text": "وبعدَ مئاتِ السنين، تسقطُ ناطحاتُ السحاب، وتغطّي الغاباتُ المدن.", "start": 44.43, "end": 49.73, "words": [["وبعدَ", 44.43, 44.85], ["مئاتِ", 44.9, 45.24], ["السنين،", 45.27, 45.99], ["تسقطُ", 46.16, 46.61], ["ناطحاتُ", 46.67, 47.19], ["السحاب،", 47.22, 47.88], ["وتغطّي", 48.03, 48.68], ["الغاباتُ", 48.7, 49.18], ["المدن.", 49.21, 49.73]]}, {"text": "أمّا البلاستيك، فقد يبقى مئاتِ السنين أو أكثر.", "start": 50.11, "end": 53.36, "words": [["أمّا", 50.11, 50.34], ["البلاستيك،", 50.36, 51.14], ["فقد", 51.28, 51.59], ["يبقى", 51.65, 51.91], ["مئاتِ", 51.94, 52.28], ["السنين", 52.3, 52.69], ["أو", 52.72, 52.85], ["أكثر.", 52.89, 53.36]]}, {"text": "وأطولُ أثرٍ لنا؟ إشاراتُ الراديو التي أرسلناها… ما زالت تسافرُ في الفضاء بسرعةِ الضوء.", "start": 53.68, "end": 60.66, "words": [["وأطولُ", 53.68, 54.21], ["أثرٍ", 54.26, 54.59], ["لنا؟", 54.63, 55.04], ["إشاراتُ", 55.41, 55.94], ["الراديو", 55.96, 56.47], ["التي", 56.54, 56.83], ["أرسلناها…", 56.89, 57.71], ["ما", 58.15, 58.26], ["زالت", 58.37, 58.63], ["تسافرُ", 58.66, 59.16], ["في", 59.21, 59.26], ["الفضاء", 59.29, 59.73], ["بسرعةِ", 59.78, 60.19], ["الضوء.", 60.21, 60.66]]}, {"text": "برأيك، ماذا سيبقى من مدينتك؟ اكتبْ في التعليقات… وقد يكونُ سؤالُك الفيديو القادم.", "start": 61.04, "end": 67.99, "words": [["برأيك،", 61.04, 61.79], ["ماذا", 61.96, 62.19], ["سيبقى", 62.26, 62.66], ["من", 62.68, 62.77], ["مدينتك؟", 62.81, 63.53], ["اكتبْ", 63.85, 64.25], ["في", 64.27, 64.33], ["التعليقات…", 64.36, 65.22], ["وقد", 65.55, 65.9], ["يكونُ", 65.95, 66.27], ["سؤالُك", 66.31, 66.72], ["الفيديو", 66.78, 67.15], ["القادم.", 67.17, 67.99]]}]