[{"text": "ماذا لو استيقظَ كلُّ البشرِ غداً بقوّةٍ خارقة؟", "start": 0.0, "end": 3.47, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.43], ["استيقظَ", 0.45, 0.94], ["كلُّ", 1.01, 1.28], ["البشرِ", 1.3, 1.75], ["غداً", 1.81, 2.14], ["بقوّةٍ", 2.23, 2.79], ["خارقة؟", 2.86, 3.47]]}, {"text": "سترفعُ سيّارةً بيدٍ واحدة… لكنّ قوانينَ الفيزياءِ لن تتغيّر.", "start": 3.89, "end": 8.64, "words": [["سترفعُ", 3.89, 4.43], ["سيّارةً", 4.5, 5.04], ["بيدٍ", 5.08, 5.34], ["واحدة…", 5.41, 5.94], ["لكنّ", 6.26, 6.62], ["قوانينَ", 6.71, 7.21], ["الفيزياءِ", 7.25, 7.73], ["لن", 7.78, 7.88], ["تتغيّر.", 7.93, 8.64]]}, {"text": "وإذا دفعتَ جداراً بقوّتِك الخارقة، فسيدفعُك بالقوّةِ نفسِها… وتطيرُ أنت إلى الخلف.", "start": 8.94, "end": 15.71, "words": [["وإذا", 8.94, 9.29], ["دفعتَ", 9.33, 9.72], ["جداراً", 9.8, 10.24], ["بقوّتِك", 10.28, 10.84], ["الخارقة،", 10.91, 11.64], ["فسيدفعُك", 11.84, 12.63], ["بالقوّةِ", 12.74, 13.21], ["نفسِها…", 13.27, 13.87], ["وتطيرُ", 14.11, 14.65], ["أنت", 14.71, 14.91], ["إلى", 14.98, 15.09], ["الخلف.", 15.13, 15.71]]}, {"text": "وقفزةٌ بارتفاعِ عشرةِ طوابق تعني أن تعودَ إلى الأرضِ بسرعةٍ تفوقُ ثمانينَ كيلومتراً في الساعة.", "start": 15.97, "end": 23.42, "words": [["وقفزةٌ", 15.97, 16.72], ["بارتفاعِ", 16.8, 17.29], ["عشرةِ", 17.32, 17.74], ["طوابق", 17.81, 18.27], ["تعني", 18.34, 18.76], ["أن", 19.01, 19.2], ["تعودَ", 19.28, 19.68], ["إلى", 19.74, 19.88], ["الأرضِ", 19.91, 20.31], ["بسرعةٍ", 20.35, 21.0], ["تفوقُ", 21.32, 21.77], ["ثمانينَ", 21.83, 22.21], ["كيلومتراً", 22.26, 22.76], ["في", 22.8, 22.87], ["الساعة.", 22.89, 23.42]]}, {"text": "وأشعّةُ عيونٍ تقطعُ الفولاذ تحتاجُ قدرةَ ألفِ واط: عشرةَ أضعافِ ما ينتجُه جسدُك كلُّه.", "start": 23.75, "end": 30.68, "words": [["وأشعّةُ", 23.75, 24.35], ["عيونٍ", 24.4, 24.78], ["تقطعُ", 24.85, 25.24], ["الفولاذ", 25.25, 25.74], ["تحتاجُ", 26.03, 26.52], ["قدرةَ", 26.59, 26.99], ["ألفِ", 27.04, 27.28], ["واط:", 27.35, 27.81], ["عشرةَ", 28.02, 28.54], ["أضعافِ", 28.57, 29.07], ["ما", 29.13, 29.19], ["ينتجُه", 29.26, 29.71], ["جسدُك", 29.82, 30.22], ["كلُّه.", 30.33, 30.68]]}, {"text": "وإن أصبحتَ غيرَ مرئيّ، فسيمرُّ الضوءُ عبرَ عينيك دونَ أن يتوقّف… وتصبحُ أعمى.", "start": 30.98, "end": 37.09, "words": [["وإن", 30.98, 31.18], ["أصبحتَ", 31.21, 31.7], ["غيرَ", 31.74, 31.97], ["مرئيّ،", 32.02, 32.52], ["فسيمرُّ", 32.71, 33.39], ["الضوءُ", 33.41, 33.85], ["عبرَ", 33.96, 34.27], ["عينيك", 34.28, 34.71], ["دونَ", 34.92, 35.16], ["أن", 35.19, 35.26], ["يتوقّف…", 35.3, 36.01], ["وتصبحُ", 36.18, 36.71], ["أعمى.", 36.75, 37.09]]}, {"text": "ولو قفزَ ثمانيةُ مليارات إنسانٍ خارقٍ معاً؟ لن تتحرّكَ الأرضُ أكثرَ من عرضِ ذرّة.", "start": 37.38, "end": 43.29, "words": [["ولو", 37.38, 37.63], ["قفزَ", 37.7, 38.06], ["ثمانيةُ", 38.12, 38.65], ["مليارات", 38.71, 39.1], ["إنسانٍ", 39.16, 39.49], ["خارقٍ", 39.58, 39.94], ["معاً؟", 39.96, 40.44], ["لن", 40.88, 41.04], ["تتحرّكَ", 41.1, 41.68], ["الأرضُ", 41.7, 42.05], ["أكثرَ", 42.09, 42.41], ["من", 42.45, 42.54], ["عرضِ", 42.6, 42.82], ["ذرّة.", 42.86, 43.29]]}, {"text": "والمفاجأة؟ أنت خارقٌ فعلاً: في دماغِك ستّةٌ وثمانونَ مليارَ خليّةٍ عصبيّة، تعملُ بقدرةِ مصباحٍ صغير.", "start": 43.62, "end": 52.56, "words": [["والمفاجأة؟", 43.62, 44.51], ["أنت", 44.84, 45.1], ["خارقٌ", 45.2, 45.63], ["فعلاً:", 45.72, 46.27], ["في", 46.59, 46.72], ["دماغِك", 46.79, 47.2], ["ستّةٌ", 47.31, 47.76], ["وثمانونَ", 47.94, 48.58], ["مليارَ", 48.63, 48.98], ["خليّةٍ", 49.05, 49.47], ["عصبيّة،", 49.53, 50.21], ["تعملُ", 50.54, 50.99], ["بقدرةِ", 51.04, 51.54], ["مصباحٍ", 51.58, 52.0], ["صغير.", 52.06, 52.56]]}, {"text": "أيَّ قوّةٍ خارقةٍ ستختار؟ اكتبْ في التعليقات.", "start": 52.88, "end": 56.7, "words": [["أيَّ", 52.88, 53.15], ["قوّةٍ", 53.2, 53.57], ["خارقةٍ", 53.65, 54.13], ["ستختار؟", 54.18, 54.91], ["اكتبْ", 55.24, 55.62], ["في", 55.66, 55.72], ["التعليقات.", 55.75, 56.7]]}]