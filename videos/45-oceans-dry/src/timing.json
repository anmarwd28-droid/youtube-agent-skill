[{"text": "ماذا لو جفّتِ المحيطاتُ فجأة؟", "start": 0.0, "end": 2.03, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.46], ["جفّتِ", 0.53, 0.92], ["المحيطاتُ", 0.94, 1.46], ["فجأة؟", 1.52, 2.03]]}, {"text": "يظهرُ قاعٌ لم يرَهُ أحد: أطولُ سلسلةِ جبالٍ في العالم، وخندقٌ أعمقُ من ارتفاعِ إيفرست.", "start": 2.4, "end": 9.36, "words": [["يظهرُ", 2.4, 2.75], ["قاعٌ", 2.83, 3.12], ["لم", 3.18, 3.3], ["يرَهُ", 3.34, 3.62], ["أحد:", 3.66, 4.09], ["أطولُ", 4.41, 4.89], ["سلسلةِ", 4.96, 5.42], ["جبالٍ", 5.5, 5.85], ["في", 5.91, 5.97], ["العالم،", 5.99, 6.58], ["وخندقٌ", 6.76, 7.49], ["أعمقُ", 7.57, 8.01], ["من", 8.06, 8.16], ["ارتفاعِ", 8.21, 8.72], ["إيفرست.", 8.75, 9.36]]}, {"text": "تسقطُ السفنُ إلى قاعٍ عمقُه نحوُ أربعةِ كيلومتراتٍ في المتوسّط.", "start": 9.73, "end": 14.15, "words": [["تسقطُ", 9.73, 10.17], ["السفنُ", 10.19, 10.62], ["إلى", 10.68, 10.81], ["قاعٍ", 10.9, 11.21], ["عمقُه", 11.27, 11.73], ["نحوُ", 11.82, 12.07], ["أربعةِ", 12.11, 12.54], ["كيلومتراتٍ", 12.6, 13.23], ["في", 13.29, 13.35], ["المتوسّط.", 13.39, 14.15]]}, {"text": "ويبقى على القاعِ ملحٌ يكفي لتغطيةِ اليابسةِ كلِّها بطبقةٍ سُمكُها مئةٌ وخمسون مترًا.", "start": 14.52, "end": 21.23, "words": [["ويبقى", 14.52, 14.95], ["على", 14.99, 15.11], ["القاعِ", 15.14, 15.5], ["ملحٌ", 15.55, 15.94], ["يكفي", 16.06, 16.31], ["لتغطيةِ", 16.37, 16.93], ["اليابسةِ", 16.95, 17.5], ["كلِّها", 17.57, 18.07], ["بطبقةٍ", 18.39, 19.05], ["سُمكُها", 19.12, 19.68], ["مئةٌ", 19.78, 20.18], ["وخمسون", 20.26, 20.69], ["مترًا.", 20.76, 21.23]]}, {"text": "ثمّ يكادُ المطرُ يتوقّف، فمعظمُ بخارِ الماءِ يأتي من المحيطات.", "start": 21.64, "end": 26.12, "words": [["ثمّ", 21.64, 21.87], ["يكادُ", 21.92, 22.21], ["المطرُ", 22.23, 22.59], ["يتوقّف،", 22.63, 23.36], ["فمعظمُ", 23.56, 24.07], ["بخارِ", 24.11, 24.44], ["الماءِ", 24.46, 24.88], ["يأتي", 25.02, 25.31], ["من", 25.36, 25.44], ["المحيطات.", 25.48, 26.12]]}, {"text": "تجفُّ الأنهارُ وتموتُ الغابات، وتتحوّلُ اليابسةُ إلى صحراء.", "start": 26.44, "end": 30.68, "words": [["تجفُّ", 26.44, 26.84], ["الأنهارُ", 26.86, 27.35], ["وتموتُ", 27.38, 27.78], ["الغابات،", 27.79, 28.4], ["وتتحوّلُ", 28.59, 29.37], ["اليابسةُ", 29.41, 29.94], ["إلى", 29.98, 30.1], ["صحراء.", 30.17, 30.68]]}, {"text": "نهارٌ حارق، وليلٌ متجمّد، فلا بحرَ يُلطّفُ الحرارة.", "start": 31.05, "end": 34.93, "words": [["نهارٌ", 31.05, 31.41], ["حارق،", 31.49, 31.97], ["وليلٌ", 32.14, 32.51], ["متجمّد،", 32.55, 33.24], ["فلا", 33.38, 33.62], ["بحرَ", 33.67, 33.96], ["يُلطّفُ", 33.98, 34.37], ["الحرارة.", 34.39, 34.93]]}, {"text": "وتهبُّ عواصفُ الغبارِ والملح، فتُدفَنُ المدنُ المهجورةُ تحتَ الرمال.", "start": 35.24, "end": 40.4, "words": [["وتهبُّ", 35.24, 35.77], ["عواصفُ", 35.83, 36.23], ["الغبارِ", 36.27, 36.68], ["والملح،", 36.71, 37.29], ["فتُدفَنُ", 37.49, 38.03], ["المدنُ", 38.05, 38.48], ["المهجورةُ", 38.5, 39.31], ["تحتَ", 39.48, 39.8], ["الرمال.", 39.82, 40.4]]}, {"text": "ونفقدُ العوالقَ البحريّةَ التي تصنعُ نحوَ نصفِ الأكسجين.", "start": 40.84, "end": 45.52, "words": [["ونفقدُ", 40.84, 41.45], ["العوالقَ", 41.48, 42.13], ["البحريّةَ", 42.16, 42.98], ["التي", 43.22, 43.59], ["تصنعُ", 43.68, 44.11], ["نحوَ", 44.15, 44.42], ["نصفِ", 44.45, 44.7], ["الأكسجين.", 44.72, 45.52]]}, {"text": "والمفاجأة؟ هذا حدثَ فعلًا على المريخ: كانت فيه أنهارٌ وبحيراتٌ قبلَ مليارات السنين، واليومَ صحراءُ ميتة.", "start": 45.85, "end": 54.31, "words": [["والمفاجأة؟", 45.85, 46.73], ["هذا", 47.05, 47.3], ["حدثَ", 47.34, 47.69], ["فعلًا", 47.76, 48.13], ["على", 48.18, 48.32], ["المريخ:", 48.35, 48.94], ["كانت", 49.32, 49.6], ["فيه", 49.64, 49.83], ["أنهارٌ", 49.9, 50.41], ["وبحيراتٌ", 50.47, 51.18], ["قبلَ", 51.26, 51.52], ["مليارات", 51.57, 52.02], ["السنين،", 52.07, 52.71], ["واليومَ", 52.88, 53.29], ["صحراءُ", 53.35, 53.75], ["ميتة.", 53.79, 54.31]]}, {"text": "اكتبْ رأيَك في التعليقات… واشتركْ.", "start": 54.64, "end": 57.59, "words": [["اكتبْ", 54.64, 55.03], ["رأيَك", 55.05, 55.33], ["في", 55.45, 55.52], ["التعليقات…", 55.54, 56.38], ["واشتركْ.", 56.7, 57.59]]}]