[{"text": "ماذا لو اختفى كلُّ الزجاجِ في العالمِ خمسَ ثوانٍ فقط؟", "start": 0.0, "end": 3.58, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.45], ["اختفى", 0.5, 0.87], ["كلُّ", 0.93, 1.18], ["الزجاجِ", 1.2, 1.68], ["في", 1.74, 1.79], ["العالمِ", 1.82, 2.25], ["خمسَ", 2.3, 2.61], ["ثوانٍ", 2.67, 3.02], ["فقط؟", 3.09, 3.58]]}, {"text": "النوافذُ تختفي فجأة، فيندفعُ الهواءُ والضجيجُ إلى البيوتِ والمكاتب.", "start": 4.02, "end": 9.37, "words": [["النوافذُ", 4.02, 4.61], ["تختفي", 4.68, 5.1], ["فجأة،", 5.18, 5.75], ["فيندفعُ", 6.01, 6.73], ["الهواءُ", 6.76, 7.26], ["والضجيجُ", 7.29, 7.98], ["إلى", 8.02, 8.15], ["البيوتِ", 8.19, 8.58], ["والمكاتب.", 8.64, 9.37]]}, {"text": "ومن يتّكئُ على واجهةِ ناطحةِ سحاب، يجدُ نفسَه أمامَ فراغٍ على ارتفاعِ مئاتِ الأمتار.", "start": 9.69, "end": 16.27, "words": [["ومن", 9.69, 9.98], ["يتّكئُ", 10.1, 10.62], ["على", 10.69, 10.84], ["واجهةِ", 10.93, 11.39], ["ناطحةِ", 11.45, 11.94], ["سحاب،", 11.99, 12.59], ["يجدُ", 12.91, 13.3], ["نفسَه", 13.38, 13.76], ["أمامَ", 13.86, 14.19], ["فراغٍ", 14.24, 14.63], ["على", 14.7, 14.84], ["ارتفاعِ", 14.86, 15.31], ["مئاتِ", 15.34, 15.66], ["الأمتار.", 15.69, 16.27]]}, {"text": "والسائقون يفقدون الزجاجَ الأماميّ، فتضربُ الرياحُ وجوهَهم على الطريق.", "start": 16.65, "end": 21.97, "words": [["والسائقون", 16.65, 17.32], ["يفقدون", 17.38, 17.83], ["الزجاجَ", 17.88, 18.34], ["الأماميّ،", 18.37, 19.1], ["فتضربُ", 19.37, 19.99], ["الرياحُ", 20.02, 20.49], ["وجوهَهم", 20.53, 21.19], ["على", 21.26, 21.37], ["الطريق.", 21.4, 21.97]]}, {"text": "لكنّ الضربةَ الأكبرَ خفيّة: الإنترنت.", "start": 22.41, "end": 25.43, "words": [["لكنّ", 22.41, 22.77], ["الضربةَ", 22.79, 23.25], ["الأكبرَ", 23.28, 23.71], ["خفيّة:", 23.77, 24.39], ["الإنترنت.", 24.64, 25.43]]}, {"text": "فنحوُ تسعةٍ وتسعين بالمئةِ من البياناتِ بين القارّاتِ تسافرُ ضوءاً داخلَ أليافٍ زجاجيّةٍ تحتَ البحار.", "start": 25.75, "end": 33.44, "words": [["فنحوُ", 25.75, 26.17], ["تسعةٍ", 26.23, 26.63], ["وتسعين", 26.69, 27.18], ["بالمئةِ", 27.25, 27.86], ["من", 28.02, 28.2], ["البياناتِ", 28.26, 28.8], ["بين", 28.86, 29.01], ["القارّاتِ", 29.06, 29.66], ["تسافرُ", 29.94, 30.52], ["ضوءاً", 30.59, 30.95], ["داخلَ", 31.02, 31.39], ["أليافٍ", 31.43, 31.88], ["زجاجيّةٍ", 31.94, 32.55], ["تحتَ", 32.62, 32.83], ["البحار.", 32.86, 33.44]]}, {"text": "خمسُ ثوانٍ تكفي لقطعِ المكالماتِ والبثِّ والمعاملاتِ بين القارّات.", "start": 33.82, "end": 38.19, "words": [["خمسُ", 33.82, 34.15], ["ثوانٍ", 34.23, 34.66], ["تكفي", 34.74, 35.02], ["لقطعِ", 35.09, 35.47], ["المكالماتِ", 35.49, 36.16], ["والبثِّ", 36.22, 36.62], ["والمعاملاتِ", 36.65, 37.31], ["بين", 37.37, 37.52], ["القارّات.", 37.57, 38.19]]}, {"text": "والمفاجأة؟ معظمُ النظّاراتِ ستبقى… لأنّ عدساتِها اليومَ من البلاستيك، لا من الزجاج.", "start": 38.63, "end": 45.24, "words": [["والمفاجأة؟", 38.63, 39.52], ["معظمُ", 39.76, 40.17], ["النظّاراتِ", 40.19, 40.84], ["ستبقى…", 40.9, 41.68], ["لأنّ", 42.0, 42.31], ["عدساتِها", 42.34, 42.91], ["اليومَ", 42.93, 43.27], ["من", 43.32, 43.39], ["البلاستيك،", 43.42, 44.09], ["لا", 44.24, 44.37], ["من", 44.43, 44.53], ["الزجاج.", 44.59, 45.24]]}, {"text": "اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 45.42, "end": 48.85, "words": [["اكتبْ", 45.42, 45.8], ["سؤالَك", 45.82, 46.14], ["في", 46.2, 46.24], ["التعليقات،", 46.27, 46.96], ["وقد", 47.14, 47.41], ["يكونُ", 47.47, 47.74], ["الفيديو", 47.76, 48.05], ["القادم.", 48.08, 48.85]]}]