[{"text": "ماذا لو استيقظَ البشرُ غداً… وكلُّهم يتكلّمونَ لغةً واحدة؟", "start": 0.0, "end": 4.92, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.45], ["استيقظَ", 0.46, 0.93], ["البشرُ", 0.96, 1.41], ["غداً…", 1.46, 2.08], ["وكلُّهم", 2.48, 3.09], ["يتكلّمونَ", 3.23, 3.96], ["لغةً", 4.02, 4.34], ["واحدة؟", 4.4, 4.92]]}, {"text": "اليومَ يتكلّمُ سكّانُ الأرضِ أكثرَ من سبعةِ آلافِ لغة.", "start": 5.39, "end": 8.58, "words": [["اليومَ", 5.39, 5.72], ["يتكلّمُ", 5.76, 6.32], ["سكّانُ", 6.35, 6.72], ["الأرضِ", 6.75, 7.12], ["أكثرَ", 7.15, 7.45], ["من", 7.5, 7.57], ["سبعةِ", 7.62, 7.93], ["آلافِ", 7.96, 8.22], ["لغة.", 8.26, 8.58]]}, {"text": "وفي لحظة، يفهمُ كلُّ مسافرٍ كلَّ لافتة، وكلَّ قائمةِ طعام، في أيِّ بلد.", "start": 8.94, "end": 14.42, "words": [["وفي", 8.94, 9.2], ["لحظة،", 9.27, 9.71], ["يفهمُ", 9.78, 10.17], ["كلُّ", 10.23, 10.45], ["مسافرٍ", 10.48, 11.05], ["كلَّ", 11.11, 11.32], ["لافتة،", 11.37, 11.91], ["وكلَّ", 12.17, 12.55], ["قائمةِ", 12.59, 12.97], ["طعام،", 13.05, 13.48], ["في", 13.58, 13.71], ["أيِّ", 13.77, 13.99], ["بلد.", 14.03, 14.42]]}, {"text": "والإنترنتُ ينفتحُ على الجميع، فنحوُ نصفِ مواقعِه اليومَ بلغةٍ واحدةٍ فقط.", "start": 14.71, "end": 20.49, "words": [["والإنترنتُ", 14.71, 15.39], ["ينفتحُ", 15.45, 15.91], ["على", 15.97, 16.09], ["الجميع،", 16.13, 16.73], ["فنحوُ", 16.87, 17.26], ["نصفِ", 17.32, 17.58], ["مواقعِه", 17.64, 18.16], ["اليومَ", 18.22, 18.69], ["بلغةٍ", 18.98, 19.48], ["واحدةٍ", 19.55, 19.99], ["فقط.", 20.06, 20.49]]}, {"text": "المترجمونَ يفقدونَ عملَهم، وتختفي صناعةٌ بعشراتِ ملياراتِ الدولارات.", "start": 20.84, "end": 25.94, "words": [["المترجمونَ", 20.84, 21.63], ["يفقدونَ", 21.68, 22.15], ["عملَهم،", 22.21, 22.85], ["وتختفي", 23.01, 23.56], ["صناعةٌ", 23.66, 24.15], ["بعشراتِ", 24.22, 24.8], ["ملياراتِ", 24.86, 25.29], ["الدولارات.", 25.31, 25.94]]}, {"text": "والعلماءُ من كلِّ البلدانِ يعملونَ معاً بلا حواجز، فتتسارعُ الاكتشافات.", "start": 26.3, "end": 31.36, "words": [["والعلماءُ", 26.3, 26.91], ["من", 26.95, 27.05], ["كلِّ", 27.11, 27.38], ["البلدانِ", 27.39, 27.95], ["يعملونَ", 28.03, 28.51], ["معاً", 28.55, 28.75], ["بلا", 28.82, 28.96], ["حواجز،", 29.01, 29.63], ["فتتسارعُ", 29.79, 30.51], ["الاكتشافات.", 30.54, 31.36]]}, {"text": "لكنْ هناكَ خسارةٌ كبيرة: كلُّ لغةٍ تحملُ طريقةً خاصّةً لرؤيةِ العالم.", "start": 31.66, "end": 36.86, "words": [["لكنْ", 31.66, 31.93], ["هناكَ", 31.96, 32.26], ["خسارةٌ", 32.32, 32.8], ["كبيرة:", 32.86, 33.45], ["كلُّ", 33.75, 34.03], ["لغةٍ", 34.05, 34.41], ["تحملُ", 34.49, 34.84], ["طريقةً", 34.89, 35.36], ["خاصّةً", 35.43, 35.9], ["لرؤيةِ", 35.93, 36.33], ["العالم.", 36.35, 36.86]]}, {"text": "ففي دراسةٍ علميّة، ثلاثةُ أرباعِ استخداماتِ النباتاتِ الطبّيّة… لا تعرفُها إلّا لغةٌ واحدة.", "start": 37.21, "end": 44.12, "words": [["ففي", 37.21, 37.43], ["دراسةٍ", 37.49, 37.92], ["علميّة،", 37.99, 38.59], ["ثلاثةُ", 38.79, 39.24], ["أرباعِ", 39.29, 39.64], ["استخداماتِ", 39.66, 40.26], ["النباتاتِ", 40.29, 40.84], ["الطبّيّة…", 40.87, 41.59], ["لا", 41.97, 42.14], ["تعرفُها", 42.21, 42.77], ["إلّا", 42.86, 43.09], ["لغةٌ", 43.13, 43.53], ["واحدة.", 43.61, 44.12]]}, {"text": "والأغرب؟ اللغةُ الواحدةُ لن تبقى واحدة.", "start": 44.4, "end": 47.59, "words": [["والأغرب؟", 44.4, 45.15], ["اللغةُ", 45.4, 45.81], ["الواحدةُ", 45.84, 46.42], ["لن", 46.5, 46.61], ["تبقى", 46.68, 47.0], ["واحدة.", 47.04, 47.59]]}, {"text": "فاللاتينيّةُ كانت لغةً واحدة، ثمّ تفرّقت عبرَ القرونِ إلى الإسبانيّةِ والفرنسيّةِ والإيطاليّةِ والبرتغاليّةِ والرومانيّة.", "start": 47.91, "end": 57.02, "words": [["فاللاتينيّةُ", 47.91, 48.75], ["كانت", 48.83, 49.1], ["لغةً", 49.16, 49.51], ["واحدة،", 49.56, 50.12], ["ثمّ", 50.33, 50.61], ["تفرّقت", 50.65, 51.22], ["عبرَ", 51.28, 51.51], ["القرونِ", 51.54, 51.99], ["إلى", 52.02, 52.15], ["الإسبانيّةِ", 52.19, 52.95], ["والفرنسيّةِ", 53.01, 53.89], ["والإيطاليّةِ", 54.17, 55.03], ["والبرتغاليّةِ", 55.09, 56.06], ["والرومانيّة.", 56.27, 57.02]]}, {"text": "وبعدَ ألفِ عام، قد يعودُ البشرُ إلى لغاتٍ كثيرةٍ لا يفهمُ بعضُها بعضاً.", "start": 57.62, "end": 63.12, "words": [["وبعدَ", 57.62, 58.04], ["ألفِ", 58.1, 58.41], ["عام،", 58.49, 58.76], ["قد", 58.78, 58.95], ["يعودُ", 59.01, 59.33], ["البشرُ", 59.36, 59.84], ["إلى", 59.9, 60.03], ["لغاتٍ", 60.09, 60.51], ["كثيرةٍ", 60.59, 61.27], ["لا", 61.65, 61.79], ["يفهمُ", 61.85, 62.17], ["بعضُها", 62.22, 62.58], ["بعضاً.", 62.64, 63.12]]}, {"text": "لو تكلّمَ العالمُ لغةً واحدة، أيَّ لغةٍ تختار؟ اكتبْ في التعليقات، واشتركْ.", "start": 63.45, "end": 69.43, "words": [["لو", 63.45, 63.6], ["تكلّمَ", 63.65, 64.09], ["العالمُ", 64.11, 64.52], ["لغةً", 64.55, 64.9], ["واحدة،", 64.96, 65.49], ["أيَّ", 65.7, 66.04], ["لغةٍ", 66.08, 66.44], ["تختار؟", 66.51, 67.09], ["اكتبْ", 67.3, 67.66], ["في", 67.69, 67.76], ["التعليقات،", 67.78, 68.52], ["واشتركْ.", 68.6, 69.43]]}]