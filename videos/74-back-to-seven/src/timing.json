[{"text": "ماذا لو عُدتَ طفلاً عمرُكَ سبعُ سنوات… وأنتَ تتذكّرُ كلَّ ما تعرفُهُ اليوم؟", "start": 0.0, "end": 5.42, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.43], ["عُدتَ", 0.48, 0.7], ["طفلاً", 0.78, 1.22], ["عمرُكَ", 1.33, 1.78], ["سبعُ", 1.82, 2.08], ["سنوات…", 2.11, 2.73], ["وأنتَ", 3.05, 3.33], ["تتذكّرُ", 3.39, 3.98], ["كلَّ", 4.05, 4.3], ["ما", 4.34, 4.41], ["تعرفُهُ", 4.48, 4.92], ["اليوم؟", 4.95, 5.42]]}, {"text": "تستيقظُ في سريرِكَ القديم. يداكَ صغيرتان، وأمُّكَ تناديكَ إلى المدرسة.", "start": 5.75, "end": 11.32, "words": [["تستيقظُ", 5.75, 6.36], ["في", 6.41, 6.48], ["سريرِكَ", 6.56, 6.99], ["القديم.", 7.01, 7.58], ["يداكَ", 7.91, 8.29], ["صغيرتان،", 8.36, 9.22], ["وأمُّكَ", 9.39, 9.89], ["تناديكَ", 9.95, 10.48], ["إلى", 10.53, 10.65], ["المدرسة.", 10.68, 11.32]]}, {"text": "في الصفّ، كلُّ شيءٍ سهلٌ جدّاً… فأنتَ تعرفُ الجوابَ قبلَ أن يسألَ المعلّم.", "start": 11.64, "end": 17.24, "words": [["في", 11.64, 11.76], ["الصفّ،", 11.8, 12.38], ["كلُّ", 12.55, 12.84], ["شيءٍ", 12.88, 13.19], ["سهلٌ", 13.3, 13.62], ["جدّاً…", 13.7, 14.2], ["فأنتَ", 14.48, 14.79], ["تعرفُ", 14.85, 15.21], ["الجوابَ", 15.23, 15.74], ["قبلَ", 15.81, 16.09], ["أن", 16.13, 16.21], ["يسألَ", 16.27, 16.6], ["المعلّم.", 16.64, 17.24]]}, {"text": "ودماغُكَ الصغيرُ هنا قوّةٌ خارقة: في هذا العمر، يتعلّمُ الطفلُ اللغاتِ بسهولة، ويتكلّمُها بلكنةِ أهلِها.", "start": 17.57, "end": 25.79, "words": [["ودماغُكَ", 17.57, 18.25], ["الصغيرُ", 18.27, 18.7], ["هنا", 18.75, 19.09], ["قوّةٌ", 19.3, 19.71], ["خارقة:", 19.81, 20.39], ["في", 20.65, 20.77], ["هذا", 20.83, 20.99], ["العمر،", 21.01, 21.55], ["يتعلّمُ", 21.71, 22.19], ["الطفلُ", 22.21, 22.55], ["اللغاتِ", 22.57, 22.99], ["بسهولة،", 23.03, 23.7], ["ويتكلّمُها", 23.87, 24.71], ["بلكنةِ", 24.78, 25.25], ["أهلِها.", 25.3, 25.79]]}, {"text": "فتتعلّمُ ثلاثَ لغاتٍ قبلَ العاشرة، وتتدرّبُ على الرياضةِ التي فاتتْك.", "start": 26.02, "end": 31.15, "words": [["فتتعلّمُ", 26.02, 26.74], ["ثلاثَ", 26.8, 27.1], ["لغاتٍ", 27.13, 27.5], ["قبلَ", 27.59, 27.81], ["العاشرة،", 27.83, 28.54], ["وتتدرّبُ", 28.71, 29.47], ["على", 29.54, 29.66], ["الرياضةِ", 29.69, 30.21], ["التي", 30.24, 30.51], ["فاتتْك.", 30.57, 31.15]]}, {"text": "وأنتَ تعرفُ المستقبل: الهواتفَ الذكيّة، ووسائلَ التواصل، وكلَّ ما سيحدث.", "start": 31.52, "end": 37.23, "words": [["وأنتَ", 31.52, 31.82], ["تعرفُ", 31.87, 32.16], ["المستقبل:", 32.18, 32.93], ["الهواتفَ", 33.12, 33.69], ["الذكيّة،", 33.72, 34.46], ["ووسائلَ", 34.6, 35.18], ["التواصل،", 35.2, 35.9], ["وكلَّ", 36.07, 36.49], ["ما", 36.54, 36.58], ["سيحدث.", 36.66, 37.23]]}, {"text": "لكنّ جسمَكَ جسمُ طفل. تحتاجُ إلى النومِ من تسعِ ساعاتٍ إلى اثنتَي عشرةَ ساعةً كلَّ ليلة.", "start": 37.55, "end": 43.4, "words": [["لكنّ", 37.55, 37.91], ["جسمَكَ", 37.98, 38.34], ["جسمُ", 38.41, 38.63], ["طفل.", 38.68, 39.11], ["تحتاجُ", 39.42, 39.87], ["إلى", 39.89, 40.02], ["النومِ", 40.04, 40.4], ["من", 40.44, 40.54], ["تسعِ", 40.59, 40.85], ["ساعاتٍ", 40.91, 41.37], ["إلى", 41.41, 41.54], ["اثنتَي", 41.56, 41.89], ["عشرةَ", 41.94, 42.28], ["ساعةً", 42.34, 42.71], ["كلَّ", 42.76, 42.96], ["ليلة.", 43.0, 43.4]]}, {"text": "ولا أحدَ يصدّقُك. لو حذّرتَ الكبارَ من شيءٍ سيحدث، سيضحكون ويقولون: خيالُ أطفال.", "start": 43.7, "end": 50.33, "words": [["ولا", 43.7, 44.01], ["أحدَ", 44.07, 44.47], ["يصدّقُك.", 44.51, 45.33], ["لو", 45.56, 45.67], ["حذّرتَ", 45.73, 46.13], ["الكبارَ", 46.15, 46.58], ["من", 46.63, 46.72], ["شيءٍ", 46.79, 47.03], ["سيحدث،", 47.12, 47.75], ["سيضحكون", 47.95, 48.55], ["ويقولون:", 48.6, 49.3], ["خيالُ", 49.4, 49.74], ["أطفال.", 49.76, 50.33]]}, {"text": "والأصعب: أصدقاؤكَ أطفال، وأنتَ تفكّرُ كشخصٍ كبير… ستشعرُ بالوحدة.", "start": 50.59, "end": 55.96, "words": [["والأصعب:", 50.59, 51.28], ["أصدقاؤكَ", 51.42, 52.01], ["أطفال،", 52.05, 52.64], ["وأنتَ", 52.8, 53.07], ["تفكّرُ", 53.13, 53.59], ["كشخصٍ", 53.65, 54.03], ["كبير…", 54.1, 54.6], ["ستشعرُ", 54.9, 55.39], ["بالوحدة.", 55.43, 55.96]]}, {"text": "والمفاجأة: سيعودُ الوقتُ بطيئاً كما كان. فالسنةُ عندَ طفلٍ في السابعة هي سُبعُ عمرِهِ كلِّه.", "start": 56.4, "end": 63.49, "words": [["والمفاجأة:", 56.4, 57.28], ["سيعودُ", 57.56, 58.02], ["الوقتُ", 58.04, 58.35], ["بطيئاً", 58.4, 58.91], ["كما", 59.04, 59.26], ["كان.", 59.33, 59.71], ["فالسنةُ", 60.03, 60.53], ["عندَ", 60.59, 60.77], ["طفلٍ", 60.84, 61.12], ["في", 61.17, 61.23], ["السابعة", 61.25, 61.85], ["هي", 62.02, 62.17], ["سُبعُ", 62.25, 62.59], ["عمرِهِ", 62.64, 62.98], ["كلِّه.", 63.05, 63.49]]}, {"text": "هل كنتَ ستعودُ طفلاً لو استطعت؟ اكتبْ في التعليقات، واشتركْ.", "start": 63.82, "end": 68.78, "words": [["هل", 63.82, 63.97], ["كنتَ", 64.03, 64.27], ["ستعودُ", 64.33, 64.76], ["طفلاً", 64.82, 65.22], ["لو", 65.34, 65.53], ["استطعت؟", 65.56, 66.25], ["اكتبْ", 66.49, 66.85], ["في", 66.87, 66.94], ["التعليقات،", 66.97, 67.77], ["واشتركْ.", 67.86, 68.78]]}]