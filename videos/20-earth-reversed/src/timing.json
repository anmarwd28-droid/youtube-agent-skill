.6, 58.07], ["مربّع.", 58.11, 58.7]]}, {"text": "اتّجاهُ دورانِ الأرضِ هو الذي يرسمُ خريطةَ المطرِ والصحارى. اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 59.14, "end": 67.57, "words": [["اتّجاهُ", 59.14, 59.73], ["دورانِ", 59.79, 60.21], ["الأرضِ", 60.24, 60.6], ["هو", 60.65, 60.79], ["الذي", 60.84, 61.15], ["يرسمُ", 61.27, 61.74], ["خريطةَ", 61.82, 62.31], ["المطرِ", 62.35, 62.74], ["والصحارى.", 62.8, 63.48], ["اكتبْ", 63.87, 64.25], ["سؤالَك", 64.27, 64.61], ["في", 64.67, 64.71], ["التعليقات،", 64.75, 65.6], ["وقد", 65.77, 66.08], ["يكونُ", 66.14, 66.48], ["الفيديو", 66.5, 66.81], ["القادم.", 66.84, 67.57]]}]