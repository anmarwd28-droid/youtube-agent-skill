[{"text": "ماذا لو دارتِ الأرضُ بالعكس؟", "start": 0.0, "end": 1.73, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.42], ["دارتِ", 0.49, 0.76], ["الأرضُ", 0.78, 1.08], ["بالعكس؟", 1.14, 1.73]]}, {"text": "ليسَ فجأةً… بل لو كانت تدورُ هكذا منذُ البداية.", "start": 2.23, "end": 6.2, "words": [["ليسَ", 2.23, 2.52], ["فجأةً…", 2.58, 3.32], ["بل", 3.69, 3.87], ["لو", 3.89, 4.0], ["كانت", 4.08, 4.33], ["تدورُ", 4.38, 4.72], ["هكذا", 4.81, 5.2], ["منذُ", 5.28, 5.5], ["البداية.", 5.53, 6.2]]}, {"text": "أوّلُ ما ستلاحظُه: الشمسُ تشرقُ من الغرب، وتغيبُ في الشرق.", "start": 6.63, "end": 11.8, "words": [["أوّلُ", 6.63, 7.06], ["ما", 7.11, 7.16], ["ستلاحظُه:", 7.22, 8.14], ["الشمسُ", 8.51, 9.06], ["تشرقُ", 9.11, 9.58], ["من", 9.62, 9.74], ["الغرب،", 9.79, 10.36], ["وتغيبُ", 10.52, 11.09], ["في", 11.15, 11.2], ["الشرق.", 11.23, 11.8]]}, {"text": "والرياحُ تنعكس… وحتى الأعاصيرُ في نصفِ الكرةِ الشماليِّ تدورُ مع عقاربِ الساعة.", "start": 12.04, "end": 18.23, "words": [["والرياحُ", 12.04, 12.54], ["تنعكس…", 12.59, 13.34], ["وحتى", 13.77, 14.16], ["الأعاصيرُ", 14.18, 14.7], ["في", 14.74, 14.8], ["نصفِ", 14.87, 15.11], ["الكرةِ", 15.13, 15.53], ["الشماليِّ", 15.56, 16.34], ["تدورُ", 16.61, 16.97], ["مع", 17.02, 17.14], ["عقاربِ", 17.18, 17.64], ["الساعة.", 17.66, 18.23]]}, {"text": "علماءُ معهدِ ماكس بلانك اختبروا ذلك في محاكاةٍ لسبعةِ آلافِ سنة… والنتيجةُ مدهشة.", "start": 18.54, "end": 25.46, "words": [["علماءُ", 18.54, 19.1], ["معهدِ", 19.14, 19.49], ["ماكس", 19.55, 19.75], ["بلانك", 19.82, 20.18], ["اختبروا", 20.5, 21.05], ["ذلك", 21.09, 21.37], ["في", 21.49, 21.56], ["محاكاةٍ", 21.63, 22.31], ["لسبعةِ", 22.44, 23.03], ["آلافِ", 23.08, 23.36], ["سنة…", 23.41, 23.8], ["والنتيجةُ", 24.18, 24.84], ["مدهشة.", 24.9, 25.46]]}, {"text": "الصحراءُ الكبرى تختفي وتخضرّ، ويهطلُ مطرٌ أكثرُ على الشرقِ الأوسط… بينما تتحوّلُ مناطقُ من الأمريكتينِ إلى صحارٍ.", "start": 25.83, "end": 34.51, "words": [["الصحراءُ", 25.83, 26.38], ["الكبرى", 26.41, 26.76], ["تختفي", 26.82, 27.21], ["وتخضرّ،", 27.28, 