[{"text": "ماذا لو توقّفَ الزمنُ خمسَ ثوانٍ للجميعِ… إلّا أنت؟", "start": 0.0, "end": 3.94, "words": [["ماذا", 0.0, 0.33], ["لو", 0.37, 0.48], ["توقّفَ", 0.53, 0.97], ["الزمنُ", 1.0, 1.37], ["خمسَ", 1.43, 1.67], ["ثوانٍ", 1.73, 2.04], ["للجميعِ…", 2.08, 2.8], ["إلّا", 3.18, 3.47], ["أنت؟", 3.5, 3.94]]}, {"text": "في خمسِ ثوانٍ عاديّة، يُولَدُ نحوَ عشرينَ طفلاً حولَ العالم، ويلمعُ أكثرُ من مئتي بَرقٍ في سماءِ الأرض.", "start": 4.32, "end": 11.68, "words": [["في", 4.32, 4.42], ["خمسِ", 4.5, 4.75], ["ثوانٍ", 4.82, 5.14], ["عاديّة،", 5.22, 5.85], ["يُولَدُ", 6.05, 6.4], ["نحوَ", 6.46, 6.7], ["عشرينَ", 6.72, 7.12], ["طفلاً", 7.17, 7.48], ["حولَ", 7.54, 7.78], ["العالم،", 7.8, 8.44], ["ويلمعُ", 8.65, 9.27], ["أكثرُ", 9.31, 9.74], ["من", 9.78, 9.87], ["مئتي", 9.9, 10.26], ["بَرقٍ", 10.34, 10.68], ["في", 10.74, 10.82], ["سماءِ", 10.88, 11.17], ["الأرض.", 11.19, 11.68]]}, {"text": "لكنْ فجأةً… يتجمّدُ كلُّ شيء: الناسُ في الشوارع، والطيورُ في السماء، وقطراتُ المطرِ معلّقةٌ في الهواء.", "start": 12.06, "end": 20.13, "words": [["لكنْ", 12.06, 12.38], ["فجأةً…", 12.42, 13.17], ["يتجمّدُ", 13.49, 14.08], ["كلُّ", 14.14, 14.34], ["شيء:", 14.38, 14.78], ["الناسُ", 14.99, 15.31], ["في", 15.37, 15.44], ["الشوارع،", 15.46, 16.17], ["والطيورُ", 16.29, 16.79], ["في", 16.85, 16.92], ["السماء،", 16.94, 17.53], ["وقطراتُ", 17.74, 18.39], ["المطرِ", 18.43, 18.87], ["معلّقةٌ", 18.92, 19.48], ["في", 19.54, 19.59], ["الهواء.", 19.62, 20.13]]}, {"text": "تظنُّ أنّك حرّ؟ لكنّ الضوءَ نفسَه توقّف، فلن يصلَ إلى عينيك… وسيحلُّ ظلامٌ تامّ.", "start": 20.43, "end": 27.03, "words": [["تظنُّ", 20.43, 20.83], ["أنّك", 20.85, 21.11], ["حرّ؟", 21.2, 21.63], ["لكنّ", 21.83, 22.19], ["الضوءَ", 22.21, 22.5], ["نفسَه", 22.54, 22.85], ["توقّف،", 22.95, 23.63], ["فلن", 23.79, 24.08], ["يصلَ", 24.14, 24.47], ["إلى", 24.51, 24.62], ["عينيك…", 24.68, 25.19], ["وسيحلُّ", 25.5, 26.15], ["ظلامٌ", 26.19, 26.54], ["تامّ.", 26.62, 27.03]]}, {"text": "والصوتُ موجةٌ تحملُها جزيئاتُ الهواء، فإذا تجمّدت… صمتٌ مطلق، إلّا دقّاتِ قلبِك داخلَ جسدِك.", "start": 27.39, "end": 34.52, "words": [["والصوتُ", 27.39, 27.83], ["موجةٌ", 27.89, 28.29], ["تحملُها", 28.36, 28.82], ["جزيئاتُ", 28.89, 29.35], ["الهواء،", 29.37, 29.93], ["فإذا", 30.19, 30.53], ["تجمّدت…", 30.59, 31.34], ["صمتٌ", 31.75, 32.05], ["مطلق،", 32.1, 32.48], ["إلّا", 32.53, 32.75], ["دقّاتِ", 32.79, 33.18], ["قلبِك", 33.26, 33.56], ["داخلَ", 33.67, 33.96], ["جسدِك.", 34.01, 34.52]]}, {"text": "وحتّى الهواءُ المتجمّد لن يبتعدَ عن طريقِك، فيصبحُ أمامَك مثلَ جدارٍ صلب.", "start": 34.88, "end": 40.12, "words": [["وحتّى", 34.88, 35.3], ["الهواءُ", 35.32, 35.75], ["المتجمّد", 35.77, 36.42], ["لن", 36.47, 36.62], ["يبتعدَ", 36.66, 37.05], ["عن", 37.08, 37.16], ["طريقِك،", 37.22, 37.77], ["فيصبحُ", 37.93, 38.49], ["أمامَك", 38.52, 38.87], ["مثلَ", 38.97, 39.18], ["جدارٍ", 39.25, 39.61], ["صلب.", 39.67, 40.12]]}, {"text": "ولن يدخلَ رئتيك أيُّ هواء. لحسنِ الحظّ، نفَسٌ واحدٌ يكفيك لخمسِ ثوانٍ.", "start": 40.43, "end": 45.89, "words": [["ولن", 40.43, 40.67], ["يدخلَ", 40.74, 41.05], ["رئتيك", 41.11, 41.56], ["أيُّ", 41.67, 41.92], ["هواء.", 41.95, 42.42], ["لحسنِ", 42.69, 43.02], ["الحظّ،", 43.04, 43.53], ["نفَسٌ", 43.72, 44.08], ["واحدٌ", 44.18, 44.54], ["يكفيك", 44.62, 44.92], ["لخمسِ", 45.01, 45.35], ["ثوانٍ.", 45.41, 45.89]]}, {"text": "ثمّ يعودُ الزمن… ويكملُ العالمُ حركتَه، ولا يلاحظُ أحدٌ أنّ شيئاً حدث.", "start": 46.2, "end": 51.86, "words": [["ثمّ", 46.2, 46.47], ["يعودُ", 46.51, 46.8], ["الزمن…", 46.82, 47.43], ["ويكملُ", 47.69, 48.24], ["العالمُ", 48.27, 48.68], ["حركتَه،", 48.72, 49.42], ["ولا", 49.59, 49.82], ["يلاحظُ", 49.88, 50.4], ["أحدٌ", 50.45, 50.79], ["أنّ", 50.84, 50.99], ["شيئاً", 51.06, 51.32], ["حدث.", 51.37, 51.86]]}, {"text": "خمسُ ثوانٍ فقط… لكنّها ستكونُ أظلمَ لحظةٍ في حياتِك.", "start": 52.13, "end": 56.1, "words": [["خمسُ", 52.13, 52.37], ["ثوانٍ", 52.43, 52.73], ["فقط…", 52.79, 53.29], ["لكنّها", 53.59, 53.97], ["ستكونُ", 54.05, 54.47], ["أظلمَ", 54.51, 54.87], ["لحظةٍ", 54.91, 55.29], ["في", 55.34, 55.41], ["حياتِك.", 55.48, 56.1]]}, {"text": "لو توقّفَ الزمنُ لك وحدَك، ماذا ستفعل؟ اكتبْ في التعليقات.", "start": 56.41, "end": 60.88, "words": [["لو", 56.41, 56.53], ["توقّفَ", 56.59, 56.98], ["الزمنُ", 57.0, 57.4], ["لك", 57.46, 57.6], ["وحدَك،", 57.71, 58.26], ["ماذا", 58.47, 58.72], ["ستفعل؟", 58.77, 59.33], ["اكتبْ", 59.53, 59.86], ["في", 59.88, 59.95], ["التعليقات.", 59.98, 60.88]]}]