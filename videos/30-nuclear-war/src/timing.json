[{"text": "ماذا لو اندلعت حربٌ نوويّةٌ عالميّة؟", "start": 0.0, "end": 2.74, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.5], ["اندلعت", 0.55, 0.99], ["حربٌ", 1.06, 1.37], ["نوويّةٌ", 1.41, 2.02], ["عالميّة؟", 2.1, 2.74]]}, {"text": "في العالمِ اليومَ أكثرُ من اثني عشرَ ألفَ رأسٍ نوويّ.", "start": 3.06, "end": 6.38, "words": [["في", 3.06, 3.18], ["العالمِ", 3.2, 3.61], ["اليومَ", 3.63, 3.97], ["أكثرُ", 4.02, 4.37], ["من", 4.39, 4.49], ["اثني", 4.54, 4.79], ["عشرَ", 4.85, 5.24], ["ألفَ", 5.28, 5.51], ["رأسٍ", 5.57, 5.84], ["نوويّ.", 5.86, 6.38]]}, {"text": "كلُّ انفجارٍ يصنعُ كرةَ نارٍ أسخنَ من سطحِ الشمس، وموجةً تسحقُ مدينةً كاملة.", "start": 6.83, "end": 13.1, "words": [["كلُّ", 6.83, 7.12], ["انفجارٍ", 7.14, 7.72], ["يصنعُ", 7.79, 8.17], ["كرةَ", 8.22, 8.57], ["نارٍ", 8.62, 8.89], ["أسخنَ", 8.95, 9.35], ["من", 9.39, 9.48], ["سطحِ", 9.51, 9.79], ["الشمس،", 9.81, 10.41], ["وموجةً", 10.74, 11.41], ["تسحقُ", 11.49, 11.97], ["مدينةً", 12.02, 12.52], ["كاملة.", 12.57, 13.1]]}, {"text": "ثمّ تحترقُ المدن، ويصعدُ دخانُها الأسودُ إلى أعالي الجوّ: نحوَ مئةٍ وخمسينَ مليونَ طنّ.", "start": 13.48, "end": 20.34, "words": [["ثمّ", 13.48, 13.76], ["تحترقُ", 13.82, 14.35], ["المدن،", 14.37, 14.96], ["ويصعدُ", 15.17, 15.77], ["دخانُها", 15.82, 16.3], ["الأسودُ", 16.34, 16.86], ["إلى", 16.9, 17.03], ["أعالي", 17.09, 17.36], ["الجوّ:", 17.38, 17.93], ["نحوَ", 18.25, 18.57], ["مئةٍ", 18.62, 18.98], ["وخمسينَ", 19.05, 19.49], ["مليونَ", 19.54, 19.85], ["طنّ.", 19.93, 20.34]]}, {"text": "يحجبُ الدخانُ ضوءَ الشمسِ سنوات، وتهبطُ حرارةُ الأرضِ نحوَ تسعِ درجات: إنّه الشتاءُ النوويّ.", "start": 20.72, "end": 27.62, "words": [["يحجبُ", 20.72, 21.15], ["الدخانُ", 21.18, 21.66], ["ضوءَ", 21.72, 21.95], ["الشمسِ", 21.98, 22.35], ["سنوات،", 22.42, 23.13], ["وتهبطُ", 23.27, 23.78], ["حرارةُ", 23.85, 24.28], ["الأرضِ", 24.3, 24.68], ["نحوَ", 24.74, 24.96], ["تسعِ", 25.01, 25.25], ["درجات:", 25.29, 25.89], ["إنّه", 26.2, 26.48], ["الشتاءُ", 26.52, 26.93], ["النوويّ.", 26.97, 27.62]]}, {"text": "تموتُ المحاصيلُ في الحقول، ويجوعُ العالمُ كلُّه.", "start": 28.05, "end": 31.28, "words": [["تموتُ", 28.05, 28.38], ["المحاصيلُ", 28.41, 29.04], ["في", 29.08, 29.13], ["الحقول،", 29.15, 29.82], ["ويجوعُ", 29.9, 30.43], ["العالمُ", 30.45, 30.84], ["كلُّه.", 30.87, 31.28]]}, {"text": "والمفاجأة؟ معظمُ الضحايا لن تقتلَهم القنابل، بل الجوع: أكثرُ من خمسةِ مليارات إنسان.", "start": 31.65, "end": 38.43, "words": [["والمفاجأة؟", 31.65, 32.52], ["معظمُ", 32.83, 33.2], ["الضحايا", 33.23, 33.72], ["لن", 33.76, 33.87], ["تقتلَهم", 33.92, 34.41], ["القنابل،", 34.47, 35.16], ["بل", 35.43, 35.6], ["الجوع:", 35.65, 36.25], ["أكثرُ", 36.45, 36.84], ["من", 36.86, 36.94], ["خمسةِ", 37.0, 37.36], ["مليارات", 37.42, 37.83], ["إنسان.", 37.9, 38.43]]}, {"text": "لهذا يجبُ ألّا تبدأَ هذه الحربُ أبداً. ما رأيُك؟ اكتبْ في التعليقات.", "start": 38.86, "end": 44.35, "words": [["لهذا", 38.86, 39.28], ["يجبُ", 39.35, 39.75], ["ألّا", 39.81, 40.05], ["تبدأَ", 40.12, 40.51], ["هذه", 40.55, 40.83], ["الحربُ", 40.88, 41.24], ["أبداً.", 41.26, 41.7], ["ما", 42.14, 42.26], ["رأيُك؟", 42.34, 42.83], ["اكتبْ", 42.96, 43.34], ["في", 43.36, 43.42], ["التعليقات.", 43.46, 44.35]]}]