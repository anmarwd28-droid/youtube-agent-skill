[{"text": "ماذا لو اندلعت حربٌ نوويّةٌ عالميّة؟", "start": 0.0, "end": 2.58, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.46], ["اندلعت", 0.5, 0.89], ["حربٌ", 0.95, 1.24], ["نوويّةٌ", 1.29, 1.89], ["عالميّة؟", 1.97, 2.58]]}, {"text": "في العالمِ اليومَ أكثرُ من اثني عشرَ ألفَ رأسٍ نوويّ… وتكفي دقائقُ لتنطلق.", "start": 3.0, "end": 8.68, "words": [["في", 3.0, 3.09], ["العالمِ", 3.12, 3.53], ["اليومَ", 3.55, 3.91], ["أكثرُ", 3.96, 4.35], ["من", 4.4, 4.52], ["اثني", 4.55, 4.83], ["عشرَ", 4.89, 5.24], ["ألفَ", 5.28, 5.56], ["رأسٍ", 5.6, 5.88], ["نوويّ…", 5.9, 6.51], ["وتكفي", 6.78, 7.25], ["دقائقُ", 7.31, 7.84], ["لتنطلق.", 7.89, 8.68]]}, {"text": "في كلِّ قارّة، تظهرُ كراتُ نارٍ أسخنُ من سطحِ الشمس، وموجاتٌ تسحقُ مدناً كاملة.", "start": 8.99, "end": 15.23, "words": [["في", 8.99, 9.1], ["كلِّ", 9.2, 9.42], ["قارّة،", 9.48, 9.97], ["تظهرُ", 10.14, 10.56], ["كراتُ", 10.63, 10.98], ["نارٍ", 11.04, 11.31], ["أسخنُ", 11.38, 11.83], ["من", 11.87, 11.95], ["سطحِ", 11.99, 12.27], ["الشمس،", 12.29, 12.88], ["وموجاتٌ", 13.07, 13.77], ["تسحقُ", 13.84, 14.26], ["مدناً", 14.29, 14.65], ["كاملة.", 14.7, 15.23]]}, {"text": "تنطفئُ أضواءُ المدن، وينقطعُ كلُّ اتّصالٍ على الأرض.", "start": 15.55, "end": 19.59, "words": [["تنطفئُ", 15.55, 16.14], ["أضواءُ", 16.17, 16.56], ["المدن،", 16.58, 17.17], ["وينقطعُ", 17.33, 18.09], ["كلُّ", 18.16, 18.39], ["اتّصالٍ", 18.41, 18.9], ["على", 18.96, 19.09], ["الأرض.", 19.12, 19.59]]}, {"text": "ثمّ تحترقُ المدن، ويصعدُ دخانُها الأسودُ إلى أعالي الجوّ: نحوَ مئةٍ وخمسينَ مليونَ طنّ.", "start": 19.9, "end": 26.61, "words": [["ثمّ", 19.9, 20.17], ["تحترقُ", 20.2, 20.65], ["المدن،", 20.68, 21.26], ["ويصعدُ", 21.41, 21.98], ["دخانُها", 22.04, 22.49], ["الأسودُ", 22.51, 23.02], ["إلى", 23.07, 23.18], ["أعالي", 23.23, 23.55], ["الجوّ:", 23.57, 24.12], ["نحوَ", 24.39, 24.72], ["مئةٍ", 24.76, 25.16], ["وخمسينَ", 25.22, 25.74], ["مليونَ", 25.79, 26.09], ["طنّ.", 26.14, 26.61]]}, {"text": "يحجبُ الدخانُ ضوءَ الشمسِ سنوات، وتهبطُ حرارةُ الأرضِ نحوَ تسعِ درجات.", "start": 26.98, "end": 32.3, "words": [["يحجبُ", 26.98, 27.43], ["الدخانُ", 27.46, 27.96], ["ضوءَ", 28.0, 28.26], ["الشمسِ", 28.28, 28.63], ["سنوات،", 28.69, 29.37], ["وتهبطُ", 29.57, 30.15], ["حرارةُ", 30.22, 30.64], ["الأرضِ", 30.66, 30.99], ["نحوَ", 31.03, 31.28], ["تسعِ", 31.34, 31.65], ["درجات.", 31.68, 32.3]]}, {"text": "إنّه الشتاءُ النوويّ: ثلجٌ في الصيف، وعتمةٌ في النهار.", "start": 32.66, "end": 36.92, "words": [["إنّه", 32.66, 32.95], ["الشتاءُ", 32.97, 33.39], ["النوويّ:", 33.41, 34.12], ["ثلجٌ", 34.35, 34.73], ["في", 34.8, 34.84], ["الصيف،", 34.88, 35.46], ["وعتمةٌ", 35.61, 36.19], ["في", 36.26, 36.33], ["النهار.", 36.35, 36.92]]}, {"text": "تموتُ المحاصيلُ في الحقول، ويجوعُ العالمُ كلُّه.", "start": 37.23, "end": 40.82, "words": [["تموتُ", 37.23, 37.58], ["المحاصيلُ", 37.6, 38.2], ["في", 38.23, 38.29], ["الحقول،", 38.31, 39.0], ["ويجوعُ", 39.13, 39.8], ["العالمُ", 39.82, 40.31], ["كلُّه.", 40.36, 40.82]]}, {"text": "والمفاجأة؟ معظمُ الضحايا لن تقتلَهم القنابل، بل الجوع: أكثرُ من خمسةِ مليارات إنسان.", "start": 41.15, "end": 48.38, "words": [["والمفاجأة؟", 41.15, 42.08], ["معظمُ", 42.32, 42.71], ["الضحايا", 42.74, 43.25], ["لن", 43.28, 43.4], ["تقتلَهم", 43.45, 43.96], ["القنابل،", 44.01, 44.76], ["بل", 45.0, 45.16], ["الجوع:", 45.22, 45.83], ["أكثرُ", 46.03, 46.51], ["من", 46.55, 46.65], ["خمسةِ", 46.74, 47.2], ["مليارات", 47.25, 47.73], ["إنسان.", 47.8, 48.38]]}, {"text": "لهذا يجبُ ألّا تبدأَ هذه الحربُ أبداً. ما رأيُك؟ اكتبْ في التعليقات.", "start": 48.76, "end": 54.15, "words": [["لهذا", 48.76, 49.09], ["يجبُ", 49.15, 49.51], ["ألّا", 49.56, 49.9], ["تبدأَ", 49.98, 50.38], ["هذه", 50.41, 50.7], ["الحربُ", 50.74, 51.08], ["أبداً.", 51.12, 51.57], ["ما", 51.9, 52.0], ["رأيُك؟", 52.06, 52.57], ["اكتبْ", 52.81, 53.16], ["في", 53.19, 53.26], ["التعليقات.", 53.28, 54.15]]}]