[{"text": "ماذا لو انفجرَ البركانُ العملاقُ تحتَ يلوستون؟", "start": 0.0, "end": 3.02, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.5], ["انفجرَ", 0.55, 0.97], ["البركانُ", 1.01, 1.49], ["العملاقُ", 1.51, 2.04], ["تحتَ", 2.09, 2.33], ["يلوستون؟", 2.36, 3.02]]}, {"text": "تحتَ هذه الحديقةِ في أمريكا خزّانٌ هائلٌ من الصُّهارة… وقد انفجرَ ثلاثَ مرّاتٍ من قبل.", "start": 3.46, "end": 10.53, "words": [["تحتَ", 3.46, 3.74], ["هذه", 3.8, 4.05], ["الحديقةِ", 4.09, 4.67], ["في", 4.71, 4.79], ["أمريكا", 4.87, 5.38], ["خزّانٌ", 5.76, 6.35], ["هائلٌ", 6.44, 6.84], ["من", 6.88, 7.0], ["الصُّهارة…", 7.06, 7.78], ["وقد", 8.16, 8.52], ["انفجرَ", 8.57, 9.03], ["ثلاثَ", 9.09, 9.45], ["مرّاتٍ", 9.5, 9.9], ["من", 9.94, 10.03], ["قبل.", 10.12, 10.53]]}, {"text": "آخرُها قبلَ ستِّمئةٍ وأربعينَ ألفَ سنة، وقذفَ نحوَ ألفِ كيلومترٍ مكعّبٍ من الصخورِ والرماد.", "start": 10.86, "end": 17.97, "words": [["آخرُها", 10.86, 11.44], ["قبلَ", 11.53, 11.78], ["ستِّمئةٍ", 11.85, 12.52], ["وأربعينَ", 12.59, 13.13], ["ألفَ", 13.18, 13.43], ["سنة،", 13.48, 13.89], ["وقذفَ", 14.21, 14.8], ["نحوَ", 14.85, 15.13], ["ألفِ", 15.17, 15.44], ["كيلومترٍ", 15.51, 16.03], ["مكعّبٍ", 16.08, 16.68], ["من", 16.71, 16.82], ["الصخورِ", 16.88, 17.31], ["والرماد.", 17.34, 17.97]]}, {"text": "لو انفجرَ اليوم، يرتفعُ عمودُ الرمادِ أكثرَ من ثلاثينَ كيلومتراً… ثلاثةَ أضعافِ ارتفاعِ الطائرات.", "start": 18.41, "end": 25.72, "words": [["لو", 18.41, 18.61], ["انفجرَ", 18.66, 19.12], ["اليوم،", 19.14, 19.64], ["يرتفعُ", 19.89, 20.48], ["عمودُ", 20.55, 20.9], ["الرمادِ", 20.92, 21.37], ["أكثرَ", 21.42, 21.76], ["من", 21.8, 21.9], ["ثلاثينَ", 21.95, 22.39], ["كيلومتراً…", 22.46, 23.27], ["ثلاثةَ", 23.59, 24.09], ["أضعافِ", 24.11, 24.51], ["ارتفاعِ", 24.53, 24.96], ["الطائرات.", 24.98, 25.72]]}, {"text": "ويغطّي الرمادُ معظمَ الولاياتِ المتّحدة: أكثرَ من مترٍ قربَ البركان، وبضعةَ سنتيمتراتٍ في وسطِ القارّة.", "start": 25.99, "end": 34.01, "words": [["ويغطّي", 25.99, 26.59], ["الرمادُ", 26.61, 27.1], ["معظمَ", 27.17, 27.5], ["الولاياتِ", 27.53, 28.02], ["المتّحدة:", 28.04, 28.84], ["أكثرَ", 29.08, 29.49], ["من", 29.54, 29.64], ["مترٍ", 29.7, 30.02], ["قربَ", 30.1, 30.35], ["البركان،", 30.37, 31.09], ["وبضعةَ", 31.34, 32.0], ["سنتيمتراتٍ", 32.05, 32.87], ["في", 32.94, 32.99], ["وسطِ", 33.08, 33.38], ["القارّة.", 33.41, 34.01]]}, {"text": "رمادٌ كالزجاجِ المطحون… يوقفُ الطائراتِ ويُتلفُ المحاصيل.", "start": 34.39, "end": 38.93, "words": [["رمادٌ", 34.39, 34.83], ["كالزجاجِ", 34.92, 35.47], ["المطحون…", 35.49, 36.23], ["يوقفُ", 36.56, 37.0], ["الطائراتِ", 37.03, 37.66], ["ويُتلفُ", 37.7, 38.15], ["المحاصيل.", 38.17, 38.93]]}, {"text": "وغازاتُ الكبريتِ تصعدُ إلى أعلى الجوّ، وتلفُّ الأرضَ كلَّها بستارٍ يعكسُ ضوءَ الشمس.", "start": 39.2, "end": 45.59, "words": [["وغازاتُ", 39.2, 39.83], ["الكبريتِ", 39.87, 40.51], ["تصعدُ", 40.56, 41.03], ["إلى", 41.06, 41.19], ["أعلى", 41.25, 41.47], ["الجوّ،", 41.51, 42.04], ["وتلفُّ", 42.25, 42.79], ["الأرضَ", 42.82, 43.15], ["كلَّها", 43.21, 43.54], ["بستارٍ", 43.62, 44.17], ["يعكسُ", 44.27, 44.71], ["ضوءَ", 44.77, 44.97], ["الشمس.", 44.99, 45.59]]}, {"text": "فتبردُ الأرضُ كلُّها لعدّةِ سنوات… شتاءٌ بركانيٌّ يضربُ المزارعَ في كلِّ القارّات.", "start": 45.82, "end": 52.21, "words": [["فتبردُ", 45.82, 46.43], ["الأرضُ", 46.46, 46.82], ["كلُّها", 46.89, 47.26], ["لعدّةِ", 47.33, 47.8], ["سنوات…", 47.87, 48.49], ["شتاءٌ", 48.81, 49.25], ["بركانيٌّ", 49.32, 49.96], ["يضربُ", 49.98, 50.33], ["المزارعَ", 50.35, 51.04], ["في", 51.15, 51.27], ["كلِّ", 51.35, 51.55], ["القارّات.", 51.57, 52.21]]}, {"text": "وقد حدثَ ما هو أصغرُ بكثير: بركانُ تامبورا عامَ ألفٍ وثمانمئةٍ وخمسةَ عشر، جعلَ العامَ التاليَ سنةً بلا صيف.", "start": 52.47, "end": 60.65, "words": [["وقد", 52.47, 52.79], ["حدثَ", 52.85, 53.17], ["ما", 53.23, 53.28], ["هو", 53.34, 53.48], ["أصغرُ", 53.52, 53.87], ["بكثير:", 53.91, 54.54], ["بركانُ", 54.84, 55.25], ["تامبورا", 55.32, 55.74], ["عامَ", 55.8, 56.03], ["ألفٍ", 56.08, 56.34], ["وثمانمئةٍ", 56.38, 57.0], ["وخمسةَ", 57.05, 57.47], ["عشر،", 57.52, 57.99], ["جعلَ", 58.32, 58.58], ["العامَ", 58.61, 58.91], ["التاليَ", 58.93, 59.38], ["سنةً", 59.44, 59.86], ["بلا", 59.93, 60.12], ["صيف.", 60.19, 60.65]]}, {"text": "الخبرُ الجيّد؟ معظمُ الصُّهارةِ تحتَ يلوستون شبهُ صلبة، واحتمالُ انفجارٍ عملاقٍ في أيِّ سنةٍ أقلُّ من واحدٍ في سبعمئةِ ألف.", "start": 60.98, "end": 70.26, "words": [["الخبرُ", 60.98, 61.41], ["الجيّد؟", 61.43, 62.1], ["معظمُ", 62.54, 62.92], ["الصُّهارةِ", 62.95, 63.72], ["تحتَ", 63.87, 64.17], ["يلوستون", 64.2, 64.77], ["شبهُ", 64.95, 65.26], ["صلبة،", 65.35, 65.89], ["واحتمالُ", 66.09, 66.58], ["انفجارٍ", 66.61, 67.06], ["عملاقٍ", 67.13, 67.52], ["في", 67.55, 67.63], ["أيِّ", 67.66, 67.86], ["سنةٍ", 67.89, 68.23], ["أقلُّ", 68.29, 68.65], ["من", 68.67, 68.77], ["واحدٍ", 68.82, 69.16], ["في", 69.22, 69.28], ["سبعمئةِ", 69.35, 69.82], ["ألف.", 69.87, 70.26]]}, {"text": "والعلماءُ يراقبونه كلَّ يوم. اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 70.59, "end": 76.21, "words": [["والعلماءُ", 70.59, 71.23], ["يراقبونه", 71.26, 71.89], ["كلَّ", 71.98, 72.2], ["يوم.", 72.25, 72.6], ["اكتبْ", 72.92, 73.33], ["سؤالَك", 73.35, 73.65], ["في", 73.7, 73.75], ["التعليقات،", 73.78, 74.47], ["وقد", 74.5, 74.78], ["يكونُ", 74.85, 75.13], ["الفيديو", 75.16, 75.48], ["القادم.", 75.5, 76.21]]}]