[{"text": "ماذا لو أصبحتِ الشمسُ زرقاءَ فجأة؟", "start": 0.0, "end": 2.22, "words": [["ماذا", 0.0, 0.29], ["لو", 0.31, 0.43], ["أصبحتِ", 0.45, 0.91], ["الشمسُ", 0.93, 1.26], ["زرقاءَ", 1.33, 1.71], ["فجأة؟", 1.75, 2.22]]}, {"text": "لونُ النجمِ يكشفُ حرارتَه: الأحمرُ أبردُ النجوم، والأصفرُ مثلُ شمسِنا، والأزرقُ هو الأشدُّ حرارة.", "start": 2.59, "end": 10.33, "words": [["لونُ", 2.59, 2.82], ["النجمِ", 2.84, 3.25], ["يكشفُ", 3.27, 3.63], ["حرارتَه:", 3.69, 4.34], ["الأحمرُ", 4.76, 5.31], ["أبردُ", 5.33, 5.67], ["النجوم،", 5.69, 6.33], ["والأصفرُ", 6.49, 7.11], ["مثلُ", 7.14, 7.37], ["شمسِنا،", 7.43, 8.14], ["والأزرقُ", 8.3, 9.04], ["هو", 9.1, 9.25], ["الأشدُّ", 9.3, 9.75], ["حرارة.", 9.79, 10.33]]}, {"text": "فلكي تصبحَ زرقاء، تقفزُ حرارةُ سطحِها من ستّةِ آلافِ درجةٍ إلى عشرةِ آلاف.", "start": 10.65, "end": 16.64, "words": [["فلكي", 10.65, 11.02], ["تصبحَ", 11.08, 11.48], ["زرقاء،", 11.53, 12.07], ["تقفزُ", 12.24, 12.69], ["حرارةُ", 12.76, 13.19], ["سطحِها", 13.25, 13.82], ["من", 13.99, 14.15], ["ستّةِ", 14.23, 14.59], ["آلافِ", 14.65, 15.0], ["درجةٍ", 15.06, 15.51], ["إلى", 15.56, 15.71], ["عشرةِ", 15.77, 16.14], ["آلاف.", 16.18, 16.64]]}, {"text": "وبالحجمِ نفسِه، تُطلقُ طاقةً أكبرَ بتسعِ مرّات.", "start": 16.94, "end": 20.57, "words": [["وبالحجمِ", 16.94, 17.58], ["نفسِه،", 17.61, 18.15], ["تُطلقُ", 18.31, 18.71], ["طاقةً", 18.79, 19.2], ["أكبرَ", 19.24, 19.6], ["بتسعِ", 19.63, 20.05], ["مرّات.", 20.09, 20.57]]}, {"text": "في الشارع، يصبحُ ضوءُ النهارِ أبيضَ مُزرقًّا يُعمي العيون، والسماءُ أشدَّ زُرقة.", "start": 20.93, "end": 26.82, "words": [["في", 20.93, 21.02], ["الشارع،", 21.05, 21.48], ["يصبحُ", 21.5, 21.91], ["ضوءُ", 21.97, 22.19], ["النهارِ", 22.21, 22.77], ["أبيضَ", 22.84, 23.23], ["مُزرقًّا", 23.28, 24.04], ["يُعمي", 24.25, 24.58], ["العيون،", 24.6, 25.2], ["والسماءُ", 25.41, 25.93], ["أشدَّ", 25.96, 26.31], ["زُرقة.", 26.35, 26.82]]}, {"text": "والأخطر: الأشعّةُ فوقَ البنفسجيّة تزيدُ أكثرَ من ثلاثين مرّة، فتحرقُ الجلدَ في أقلَّ من دقيقة.", "start": 27.2, "end": 34.11, "words": [["والأخطر:", 27.2, 27.72], ["الأشعّةُ", 27.77, 28.33], ["فوقَ", 28.39, 28.62], ["البنفسجيّة", 28.64, 29.48], ["تزيدُ", 29.72, 30.12], ["أكثرَ", 30.17, 30.5], ["من", 30.53, 30.63], ["ثلاثين", 30.67, 31.08], ["مرّة،", 31.16, 31.61], ["فتحرقُ", 31.94, 32.51], ["الجلدَ", 32.53, 32.88], ["في", 32.93, 33.01], ["أقلَّ", 33.05, 33.38], ["من", 33.41, 33.49], ["دقيقة.", 33.54, 34.11]]}, {"text": "ثم ترتفعُ حرارةُ الأرضِ إلى أكثرَ من مئتي درجة، فتبدأُ المحيطاتُ بالغليان.", "start": 34.44, "end": 39.72, "words": [["ثم", 34.44, 34.62], ["ترتفعُ", 34.71, 35.21], ["حرارةُ", 35.29, 35.73], ["الأرضِ", 35.76, 36.11], ["إلى", 36.13, 36.26], ["أكثرَ", 36.3, 36.61], ["من", 36.65, 36.75], ["مئتي", 36.78, 37.13], ["درجة،", 37.2, 37.73], ["فتبدأُ", 37.94, 38.42], ["المحيطاتُ", 38.44, 38.95], ["بالغليان.", 39.01, 39.72]]}, {"text": "وبخارُ الماءِ يحبسُ الحرارةَ أكثر، فتصبحُ الأرضُ جحيمًا مثلَ كوكبِ الزُّهرة.", "start": 40.03, "end": 45.78, "words": [["وبخارُ", 40.03, 40.59], ["الماءِ", 40.61, 40.96], ["يحبسُ", 40.99, 41.33], ["الحرارةَ", 41.35, 41.89], ["أكثر،", 41.92, 42.43], ["فتصبحُ", 42.6, 43.2], ["الأرضُ", 43.22, 43.58], ["جحيمًا", 43.65, 44.28], ["مثلَ", 44.48, 44.74], ["كوكبِ", 44.81, 45.2], ["الزُّهرة.", 45.22, 45.78]]}, {"text": "والمفاجأة؟ النجومُ الزرقاءُ الحقيقيّة تحرقُ وقودَها بسرعةٍ هائلة، فتعيشُ ملايينَ السنين فقط، لا مليارات.", "start": 46.09, "end": 54.71, "words": [["والمفاجأة؟", 46.09, 46.97], ["النجومُ", 47.24, 47.69], ["الزرقاءُ", 47.72, 48.22], ["الحقيقيّة", 48.24, 49.05], ["تحرقُ", 49.32, 49.82], ["وقودَها", 49.84, 50.32], ["بسرعةٍ", 50.4, 50.9], ["هائلة،", 50.97, 51.49], ["فتعيشُ", 51.76, 52.28], ["ملايينَ", 52.33, 52.72], ["السنين", 52.74, 53.07], ["فقط،", 53.13, 53.61], ["لا", 53.85, 53.99], ["مليارات.", 54.04, 54.71]]}, {"text": "فلو كانت شمسُنا نجمًا أزرقَ منذ البداية، لماتت قبلَ أن نظهرَ نحن بمليارات السنين.", "start": 54.97, "end": 60.96, "words": [["فلو", 54.97, 55.22], ["كانت", 55.27, 55.49], ["شمسُنا", 55.55, 56.01], ["نجمًا", 56.12, 56.42], ["أزرقَ", 56.45, 56.85], ["منذ", 56.89, 57.06], ["البداية،", 57.11, 57.77], ["لماتت", 58.1, 58.55], ["قبلَ", 58.63, 58.92], ["أن", 58.98, 59.07], ["نظهرَ", 59.12, 59.5], ["نحن", 59.55, 59.77], ["بمليارات", 59.83, 60.36], ["السنين.", 60.41, 60.96]]}, {"text": "أيَّ لونٍ تختارُ لشمسِنا؟ اكتبْ في التعليقات… واشتركْ.", "start": 61.47, "end": 65.94, "words": [["أيَّ", 61.47, 61.73], ["لونٍ", 61.77, 62.01], ["تختارُ", 62.08, 62.48], ["لشمسِنا؟", 62.52, 63.24], ["اكتبْ", 63.41, 63.77], ["في", 63.8, 63.87], ["التعليقات…", 63.89, 64.69], ["واشتركْ.", 65.07, 65.94]]}]