[{"text": "ماذا لو أصبحَ ردُّ فعلِكَ أسرعَ بعشرِ مرّات؟", "start": 0.0, "end": 2.89, "words": [["ماذا", 0.0, 0.27], ["لو", 0.3, 0.41], ["أصبحَ", 0.43, 0.89], ["ردُّ", 0.95, 1.21], ["فعلِكَ", 1.24, 1.62], ["أسرعَ", 1.67, 2.0], ["بعشرِ", 2.03, 2.35], ["مرّات؟", 2.39, 2.89]]}, {"text": "اليوم، يحتاجُ دماغُكَ نحوَ ربعِ ثانيةٍ لكي يرى شيئاً ويتحرّك.", "start": 3.31, "end": 8.32, "words": [["اليوم،", 3.31, 3.92], ["يحتاجُ", 4.12, 4.55], ["دماغُكَ", 4.62, 5.13], ["نحوَ", 5.19, 5.45], ["ربعِ", 5.49, 5.74], ["ثانيةٍ", 5.79, 6.42], ["لكي", 6.73, 7.04], ["يرى", 7.06, 7.26], ["شيئاً", 7.31, 7.58], ["ويتحرّك.", 7.63, 8.32]]}, {"text": "أمّا بعشرةِ أضعاف، فتكفيكَ أقلُّ من ثلاثينَ جزءاً من الألفِ من الثانية.", "start": 8.64, "end": 13.96, "words": [["أمّا", 8.64, 8.9], ["بعشرةِ", 8.95, 9.5], ["أضعاف،", 9.53, 10.14], ["فتكفيكَ", 10.29, 10.88], ["أقلُّ", 10.93, 11.32], ["من", 11.34, 11.42], ["ثلاثينَ", 11.48, 11.91], ["جزءاً", 11.98, 12.4], ["من", 12.54, 12.74], ["الألفِ", 12.79, 13.18], ["من", 13.22, 13.33], ["الثانية.", 13.36, 13.96]]}, {"text": "كوبٌ يسقطُ من الطاولة؟ تلتقطُهُ قبلَ أن يبتعدَ عن يدِك.", "start": 14.38, "end": 18.53, "words": [["كوبٌ", 14.38, 14.73], ["يسقطُ", 14.8, 15.16], ["من", 15.21, 15.29], ["الطاولة؟", 15.34, 15.96], ["تلتقطُهُ", 16.16, 16.89], ["قبلَ", 17.0, 17.26], ["أن", 17.32, 17.43], ["يبتعدَ", 17.48, 17.95], ["عن", 18.0, 18.1], ["يدِك.", 18.14, 18.53]]}, {"text": "وفي السيّارة، بسرعةِ مئةِ كيلومترٍ في الساعة، يقطعُ السائقُ عادةً أكثرَ من عشرينَ متراً قبلَ أن يضغطَ الفرامل… أمّا أنت، فنحوَ مترين.", "start": 18.84, "end": 29.42, "words": [["وفي", 18.84, 19.1], ["السيّارة،", 19.13, 19.83], ["بسرعةِ", 19.97, 20.46], ["مئةِ", 20.52, 20.82], ["كيلومترٍ", 20.89, 21.42], ["في", 21.48, 21.55], ["الساعة،", 21.57, 22.14], ["يقطعُ", 22.35, 22.77], ["السائقُ", 22.79, 23.28], ["عادةً", 23.36, 23.81], ["أكثرَ", 23.88, 24.28], ["من", 24.32, 24.43], ["عشرينَ", 24.46, 24.83], ["متراً", 24.89, 25.3], ["قبلَ", 25.62, 25.91], ["أن", 25.96, 26.04], ["يضغطَ", 26.1, 26.42], ["الفرامل…", 26.45, 27.14], ["أمّا", 27.47, 27.78], ["أنت،", 27.84, 28.24], ["فنحوَ", 28.32, 28.78], ["مترين.", 28.83, 29.42]]}, {"text": "وفي سباقِ المئةِ متر، تنطلقُ قبلَ أن يتحرّكَ أيُّ بطل…", "start": 29.7, "end": 34.04, "words": [["وفي", 29.7, 29.96], ["سباقِ", 30.05, 30.41], ["المئةِ", 30.43, 30.8], ["متر،", 30.87, 31.25], ["تنطلقُ", 31.41, 32.02], ["قبلَ", 32.1, 32.36], ["أن", 32.4, 32.5], ["يتحرّكَ", 32.55, 33.24], ["أيُّ", 33.27, 33.52], ["بطل…", 33.55, 34.04]]}, {"text": "لكنّ الحَكَمَ سيُقصيك! فالقانونُ يعتبرُ أيَّ انطلاقٍ قبلَ عُشرِ ثانيةٍ من الطلقة… بدايةً خاطئة.", "start": 34.42, "end": 42.19, "words": [["لكنّ", 34.42, 34.81], ["الحَكَمَ", 34.84, 35.32], ["سيُقصيك!", 35.38, 36.15], ["فالقانونُ", 36.33, 36.93], ["يعتبرُ", 37.0, 37.53], ["أيَّ", 37.59, 37.84], ["انطلاقٍ", 37.86, 38.42], ["قبلَ", 38.51, 38.75], ["عُشرِ", 38.81, 39.09], ["ثانيةٍ", 39.14, 39.7], ["من", 39.93, 40.08], ["الطلقة…", 40.15, 40.76], ["بدايةً", 41.12, 41.63], ["خاطئة.", 41.7, 42.19]]}, {"text": "لكن هل يستطيعُ جسمُكَ ذلك؟ الإشاراتُ في أعصابِكَ تسيرُ بسرعةِ نحوِ مئةِ مترٍ في الثانية فقط.", "start": 42.49, "end": 48.8, "words": [["لكن", 42.49, 42.75], ["هل", 42.8, 42.89], ["يستطيعُ", 42.92, 43.32], ["جسمُكَ", 43.36, 43.7], ["ذلك؟", 43.76, 44.2], ["الإشاراتُ", 44.57, 45.13], ["في", 45.16, 45.23], ["أعصابِكَ", 45.3, 45.94], ["تسيرُ", 46.02, 46.38], ["بسرعةِ", 46.43, 46.91], ["نحوِ", 46.96, 47.2], ["مئةِ", 47.22, 47.46], ["مترٍ", 47.53, 47.81], ["في", 47.84, 47.9], ["الثانية", 47.94, 48.3], ["فقط.", 48.39, 48.8]]}, {"text": "فلكي تصبحَ أسرعَ بعشرِ مرّات، تحتاجُ أعصاباً أسرع، وعضلاتٍ أقوى، وطاقةً أكبرَ بكثير.", "start": 49.16, "end": 56.27, "words": [["فلكي", 49.16, 49.56], ["تصبحَ", 49.61, 50.07], ["أسرعَ", 50.1, 50.48], ["بعشرِ", 50.52, 50.89], ["مرّات،", 50.92, 51.48], ["تحتاجُ", 51.68, 52.12], ["أعصاباً", 52.16, 52.63], ["أسرع،", 52.65, 53.2], ["وعضلاتٍ", 53.37, 54.0], ["أقوى،", 54.05, 54.58], ["وطاقةً", 54.73, 55.33], ["أكبرَ", 55.38, 55.69], ["بكثير.", 55.73, 56.27]]}, {"text": "والأغرب؟ لو أصبحَ دماغُكَ يلتقطُ الصورَ أسرعَ أيضاً، فسترى العالمَ بالحركةِ البطيئة.", "start": 56.59, "end": 62.75, "words": [["والأغرب؟", 56.59, 57.24], ["لو", 57.48, 57.63], ["أصبحَ", 57.67, 58.03], ["دماغُكَ", 58.07, 58.52], ["يلتقطُ", 58.56, 59.03], ["الصورَ", 59.05, 59.51], ["أسرعَ", 59.56, 59.97], ["أيضاً،", 59.99, 60.51], ["فسترى", 60.69, 61.16], ["العالمَ", 61.19, 61.57], ["بالحركةِ", 61.62, 62.12], ["البطيئة.", 62.15, 62.75]]}, {"text": "تماماً كما تراهُ الذبابة: فعيناها تلتقطانِ نحوَ أربعةِ أضعافِ ما تلتقطُهُ عيناك، ولهذا يصعبُ ضربُها.", "start": 63.08, "end": 71.22, "words": [["تماماً", 63.08, 63.48], ["كما", 63.53, 63.72], ["تراهُ", 63.77, 64.06], ["الذبابة:", 64.09, 64.7], ["فعيناها", 64.91, 65.45], ["تلتقطانِ", 65.5, 66.18], ["نحوَ", 66.23, 66.5], ["أربعةِ", 66.53, 66.95], ["أضعافِ", 67.0, 67.54], ["ما", 67.78, 67.88], ["تلتقطُهُ", 67.94, 68.52], ["عيناك،", 68.59, 69.18], ["ولهذا", 69.31, 69.98], ["يصعبُ", 70.16, 70.61], ["ضربُها.", 70.67, 71.22]]}, {"text": "لو كان ردُّ فعلِكَ أسرعَ بعشرِ مرّات، ماذا ستفعلُ أوّلاً؟ اكتبْ في التعليقات، واشتركْ.", "start": 71.5, "end": 77.74, "words": [["لو", 71.5, 71.62], ["كان", 71.69, 71.86], ["ردُّ", 71.92, 72.16], ["فعلِكَ", 72.2, 72.58], ["أسرعَ", 72.61, 72.95], ["بعشرِ", 72.98, 73.33], ["مرّات،", 73.38, 73.91], ["ماذا", 74.19, 74.41], ["ستفعلُ", 74.45, 74.83], ["أوّلاً؟", 74.85, 75.27], ["اكتبْ", 75.65, 75.97], ["في", 75.99, 76.05], ["التعليقات،", 76.08, 76.85], ["واشتركْ.", 76.89, 77.74]]}]