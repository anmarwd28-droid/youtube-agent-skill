[{"text": "ماذا لو عشتَ على كوكبٍ بحجمِ بيت؟", "start": 0.0, "end": 2.26, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.43], ["عشتَ", 0.46, 0.73], ["على", 0.78, 0.91], ["كوكبٍ", 0.97, 1.38], ["بحجمِ", 1.43, 1.83], ["بيت؟", 1.88, 2.26]]}, {"text": "كوكب صخري قطره عشرون مترًا فقط… ومحيطه ثلاثة وستون مترًا.", "start": 2.63, "end": 7.49, "words": [["كوكب", 2.63, 2.95], ["صخري", 3.02, 3.41], ["قطره", 3.47, 3.9], ["عشرون", 4.0, 4.4], ["مترًا", 4.48, 4.78], ["فقط…", 4.83, 5.38], ["ومحيطه", 5.57, 6.17], ["ثلاثة", 6.22, 6.54], ["وستون", 6.57, 6.95], ["مترًا.", 7.02, 7.49]]}, {"text": "جاذبيته أضعف من جاذبية الأرض بستمئة ألف مرة… فيصبح وزنك عُشرَ غرام فقط.", "start": 7.91, "end": 13.87, "words": [["جاذبيته", 7.91, 8.64], ["أضعف", 8.71, 9.03], ["من", 9.09, 9.15], ["جاذبية", 9.21, 9.68], ["الأرض", 9.74, 10.01], ["بستمئة", 10.05, 10.58], ["ألف", 10.65, 10.82], ["مرة…", 10.9, 11.34], ["فيصبح", 11.66, 12.11], ["وزنك", 12.17, 12.54], ["عُشرَ", 12.61, 12.99], ["غرام", 13.05, 13.35], ["فقط.", 13.41, 13.87]]}, {"text": "ولا يستطيع أن يمسك الهواء، فيهرب إلى الفضاء فورًا… فتعيش ببدلة فضاء.", "start": 14.18, "end": 19.14, "words": [["ولا", 14.18, 14.36], ["يستطيع", 14.41, 14.79], ["أن", 14.83, 14.9], ["يمسك", 14.95, 15.22], ["الهواء،", 15.28, 15.88], ["فيهرب", 16.05, 16.46], ["إلى", 16.5, 16.59], ["الفضاء", 16.62, 16.98], ["فورًا…", 17.02, 17.52], ["فتعيش", 17.82, 18.24], ["ببدلة", 18.32, 18.63], ["فضاء.", 18.68, 19.14]]}, {"text": "والأخطر: خطوة عادية تقذفك إلى الفضاء، ولن تعود أبدًا. يكفي أن تتحرك بسنتيمترين في الثانية.", "start": 19.46, "end": 26.46, "words": [["والأخطر:", 19.46, 20.15], ["خطوة", 20.33, 20.61], ["عادية", 20.63, 21.01], ["تقذفك", 21.05, 21.5], ["إلى", 21.59, 21.69], ["الفضاء،", 21.72, 22.34], ["ولن", 22.5, 22.77], ["تعود", 22.82, 23.09], ["أبدًا.", 23.15, 23.64], ["يكفي", 23.95, 24.23], ["أن", 24.29, 24.35], ["تتحرك", 24.39, 24.9], ["بسنتيمترين", 24.97, 25.75], ["في", 25.81, 25.87], ["الثانية.", 25.9, 26.46]]}, {"text": "لذلك تتنقّل بالحبال مثل روّاد الفضاء، وتربط كل شيء بالأرض.", "start": 26.77, "end": 31.11, "words": [["لذلك", 26.77, 27.17], ["تتنقّل", 27.26, 27.77], ["بالحبال", 27.82, 28.27], ["مثل", 28.3, 28.52], ["روّاد", 28.58, 28.85], ["الفضاء،", 28.87, 29.45], ["وتربط", 29.63, 30.13], ["كل", 30.17, 30.32], ["شيء", 30.41, 30.57], ["بالأرض.", 30.59, 31.11]]}, {"text": "والأفق على بعد ستة أمتار فقط… وبضع حركات تنقلك من النهار إلى الليل.", "start": 31.43, "end": 36.38, "words": [["والأفق", 31.43, 31.87], ["على", 31.95, 32.04], ["بعد", 32.11, 32.3], ["ستة", 32.34, 32.57], ["أمتار", 32.61, 32.89], ["فقط…", 32.92, 33.47], ["وبضع", 33.78, 34.23], ["حركات", 34.3, 34.75], ["تنقلك", 34.77, 35.24], ["من", 35.32, 35.42], ["النهار", 35.47, 35.79], ["إلى", 35.8, 35.92], ["الليل.", 35.96, 36.38]]}, {"text": "والغريب؟ ارمِ كرة بهدوء، بنحو سنتيمتر في الثانية… فتدور حول الكوكب كقمر صغير، وتضرب ظهرك بعد ساعة ونصف.", "start": 36.7, "end": 45.84, "words": [["والغريب؟", 36.7, 37.31], ["ارمِ", 37.52, 37.79], ["كرة", 37.84, 38.02], ["بهدوء،", 38.06, 38.65], ["بنحو", 38.92, 39.27], ["سنتيمتر", 39.32, 39.79], ["في", 39.83, 39.89], ["الثانية…", 39.91, 40.55], ["فتدور", 40.88, 41.44], ["حول", 41.51, 41.74], ["الكوكب", 41.78, 42.31], ["كقمر", 42.42, 42.91], ["صغير،", 43.06, 43.7], ["وتضرب", 43.91, 44.43], ["ظهرك", 44.51, 44.83], ["بعد", 44.9, 45.06], ["ساعة", 45.15, 45.35], ["ونصف.", 45.37, 45.84]]}, {"text": "ولن يكون كرويًّا: الصخر لا يتكوّر إلا في أجسام قطرها مئات الكيلومترات.", "start": 46.22, "end": 51.28, "words": [["ولن", 46.22, 46.51], ["يكون", 46.57, 46.82], ["كرويًّا:", 46.89, 47.63], ["الصخر", 47.96, 48.38], ["لا", 48.45, 48.51], ["يتكوّر", 48.53, 49.06], ["إلا", 49.11, 49.24], ["في", 49.28, 49.35], ["أجسام", 49.41, 49.74], ["قطرها", 49.82, 50.18], ["مئات", 50.22, 50.47], ["الكيلومترات.", 50.5, 51.28]]}, {"text": "هل تعيش عليه؟ اكتبْ جوابك في التعليقات… واشتركْ.", "start": 51.66, "end": 55.82, "words": [["هل", 51.66, 51.8], ["تعيش", 51.85, 52.08], ["عليه؟", 52.2, 52.67], ["اكتبْ", 53.0, 53.36], ["جوابك", 53.38, 53.79], ["في", 53.84, 53.89], ["التعليقات…", 53.92, 54.72], ["واشتركْ.", 54.96, 55.82]]}]