[{"text": "ماذا لو اختفى كلُّ البعوضِ من العالمِ فجأة؟", "start": 0.0, "end": 2.83, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.48], ["اختفى", 0.5, 0.88], ["كلُّ", 0.95, 1.23], ["البعوضِ", 1.25, 1.7], ["من", 1.74, 1.83], ["العالمِ", 1.89, 2.29], ["فجأة؟", 2.35, 2.83]]}, {"text": "لا طنينَ في الليل، ولا لسعاتٍ بعدَ اليوم.", "start": 3.26, "end": 6.24, "words": [["لا", 3.26, 3.41], ["طنينَ", 3.48, 3.81], ["في", 3.87, 3.92], ["الليل،", 3.96, 4.48], ["ولا", 4.62, 4.9], ["لسعاتٍ", 4.95, 5.51], ["بعدَ", 5.56, 5.77], ["اليوم.", 5.79, 6.24]]}, {"text": "هذه الحشرةُ الصغيرةُ هي أخطرُ حيوانٍ على الإنسان:", "start": 6.61, "end": 10.58, "words": [["هذه", 6.61, 6.9], ["الحشرةُ", 6.94, 7.51], ["الصغيرةُ", 7.54, 8.15], ["هي", 8.42, 8.62], ["أخطرُ", 8.7, 9.12], ["حيوانٍ", 9.21, 9.67], ["على", 9.74, 9.86], ["الإنسان:", 9.89, 10.58]]}, {"text": "فهي تنقلُ الملاريا وحُمّى الضَّنْك، وتقتلُ أكثرَ من نصفِ مليونِ إنسانٍ كلَّ عام.", "start": 10.95, "end": 16.82, "words": [["فهي", 10.95, 11.19], ["تنقلُ", 11.26, 11.71], ["الملاريا", 11.74, 12.27], ["وحُمّى", 12.31, 12.7], ["الضَّنْك،", 12.72, 13.32], ["وتقتلُ", 13.51, 14.14], ["أكثرَ", 14.21, 14.59], ["من", 14.64, 14.74], ["نصفِ", 14.81, 15.12], ["مليونِ", 15.17, 15.6], ["إنسانٍ", 15.64, 16.06], ["كلَّ", 16.11, 16.38], ["عام.", 16.43, 16.82]]}, {"text": "ستُنقَذُ ملايينُ الأرواح، ومعظمُها أطفال.", "start": 17.31, "end": 20.75, "words": [["ستُنقَذُ", 17.31, 17.98], ["ملايينُ", 18.04, 18.5], ["الأرواح،", 18.52, 19.21], ["ومعظمُها", 19.39, 20.12], ["أطفال.", 20.16, 20.75]]}, {"text": "لكنْ في البِرَك، يرقاتُ البعوضِ طعامٌ للأسماكِ والضفادع.", "start": 21.06, "end": 24.91, "words": [["لكنْ", 21.06, 21.39], ["في", 21.41, 21.47], ["البِرَك،", 21.5, 22.04], ["يرقاتُ", 22.19, 22.61], ["البعوضِ", 22.64, 23.11], ["طعامٌ", 23.23, 23.57], ["للأسماكِ", 23.6, 24.16], ["والضفادع.", 24.2, 24.91]]}, {"text": "وفي الشمالِ البارد، تأكلُ الطيورُ المهاجرةُ أسرابَه الضخمة.", "start": 25.23, "end": 29.56, "words": [["وفي", 25.23, 25.5], ["الشمالِ", 25.53, 26.01], ["البارد،", 26.04, 26.64], ["تأكلُ", 26.8, 27.18], ["الطيورُ", 27.2, 27.63], ["المهاجرةُ", 27.66, 28.41], ["أسرابَه", 28.47, 28.97], ["الضخمة.", 29.01, 29.56]]}, {"text": "وبعضُ الأزهارِ يلقّحُها البعوضُ نفسُه.", "start": 29.93, "end": 32.73, "words": [["وبعضُ", 29.93, 30.36], ["الأزهارِ", 30.38, 31.07], ["يلقّحُها", 31.13, 31.77], ["البعوضُ", 31.8, 32.24], ["نفسُه.", 32.29, 32.73]]}, {"text": "فهل ينهارُ كلُّ شيء؟ يقولُ معظمُ العلماء: لا، ستأخذُ حشراتٌ أخرى مكانَه.", "start": 33.1, "end": 38.84, "words": [["فهل", 33.1, 33.35], ["ينهارُ", 33.4, 33.75], ["كلُّ", 33.77, 33.99], ["شيء؟", 34.03, 34.38], ["يقولُ", 34.64, 35.02], ["معظمُ", 35.05, 35.36], ["العلماء:", 35.39, 36.06], ["لا،", 36.23, 36.63], ["ستأخذُ", 36.79, 37.36], ["حشراتٌ", 37.44, 37.95], ["أخرى", 38.01, 38.24], ["مكانَه.", 38.29, 38.84]]}, {"text": "والمفاجأة: من ثلاثةِ آلافٍ وخمسِمئةِ نوع، بضعُ مئاتٍ فقط تلسعُ البشر، والإناثُ وحدَها هي التي تلسع.", "start": 39.22, "end": 47.94, "words": [["والمفاجأة:", 39.22, 40.23], ["من", 40.51, 40.61], ["ثلاثةِ", 40.67, 41.12], ["آلافٍ", 41.18, 41.56], ["وخمسِمئةِ", 41.62, 42.37], ["نوع،", 42.42, 42.91], ["بضعُ", 43.12, 43.49], ["مئاتٍ", 43.54, 43.93], ["فقط", 44.0, 44.31], ["تلسعُ", 44.38, 44.83], ["البشر،", 44.85, 45.51], ["والإناثُ", 45.72, 46.31], ["وحدَها", 46.36, 46.74], ["هي", 46.8, 46.98], ["التي", 47.01, 47.3], ["تلسع.", 47.36, 47.94]]}, {"text": "ولهذا يحاولُ العلماءُ اليومَ إزالةَ الأنواعِ الخطيرةِ وحدَها.", "start": 48.26, "end": 53.13, "words": [["ولهذا", 48.26, 48.8], ["يحاولُ", 48.85, 49.28], ["العلماءُ", 49.31, 49.82], ["اليومَ", 49.84, 50.31], ["إزالةَ", 50.59, 51.07], ["الأنواعِ", 51.11, 51.54], ["الخطيرةِ", 51.56, 52.35], ["وحدَها.", 52.47, 53.13]]}, {"text": "هل كنتَ ستمسحُ البعوضَ من العالم؟ اكتبْ في التعليقات، واشتركْ.", "start": 53.45, "end": 58.33, "words": [["هل", 53.45, 53.6], ["كنتَ", 53.66, 53.89], ["ستمسحُ", 53.96, 54.53], ["البعوضَ", 54.55, 55.04], ["من", 55.09, 55.17], ["العالم؟", 55.22, 55.81], ["اكتبْ", 55.98, 56.34], ["في", 56.37, 56.44], ["التعليقات،", 56.46, 57.3], ["واشتركْ.", 57.45, 58.33]]}]