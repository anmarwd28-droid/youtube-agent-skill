[{"text": "ماذا لو لم يسقطْ صدّامُ حسين عامَ ألفين وثلاثة؟", "start": 0.0, "end": 3.17, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.46], ["لم", 0.52, 0.64], ["يسقطْ", 0.71, 1.02], ["صدّامُ", 1.06, 1.42], ["حسين", 1.44, 1.83], ["عامَ", 2.0, 2.25], ["ألفين", 2.26, 2.55], ["وثلاثة؟", 2.59, 3.17]]}, {"text": "في التاسعِ من أبريل، سقطَ تمثالُه في ساحةِ الفِردوس ببغداد… لكنْ في هذا العالم، يبقى واقفاً.", "start": 3.58, "end": 10.88, "words": [["في", 3.58, 3.69], ["التاسعِ", 3.73, 4.31], ["من", 4.35, 4.46], ["أبريل،", 4.5, 5.14], ["سقطَ", 5.36, 5.83], ["تمثالُه", 5.88, 6.36], ["في", 6.47, 6.54], ["ساحةِ", 6.61, 6.97], ["الفِردوس", 6.98, 7.42], ["ببغداد…", 7.46, 8.14], ["لكنْ", 8.56, 8.85], ["في", 8.88, 8.95], ["هذا", 9.01, 9.2], ["العالم،", 9.22, 9.8], ["يبقى", 9.96, 10.29], ["واقفاً.", 10.33, 10.88]]}, {"text": "لا حربَ في ذلك العام، ولا دبّاباتٍ في شوارعِ بغداد.", "start": 11.3, "end": 14.94, "words": [["لا", 11.3, 11.4], ["حربَ", 11.47, 11.71], ["في", 11.77, 11.84], ["ذلك", 11.91, 12.19], ["العام،", 12.25, 12.75], ["ولا", 12.91, 13.13], ["دبّاباتٍ", 13.2, 13.8], ["في", 13.86, 13.93], ["شوارعِ", 14.01, 14.38], ["بغداد.", 14.42, 14.94]]}, {"text": "تلك الحربُ وما تلاها قتلت نحوَ مئتي ألفِ مدنيّ، وهجّرت أكثرَ من أربعةِ ملايينِ عراقيّ.", "start": 15.36, "end": 22.23, "words": [["تلك", 15.36, 15.6], ["الحربُ", 15.65, 16.08], ["وما", 16.1, 16.29], ["تلاها", 16.36, 16.9], ["قتلت", 17.09, 17.5], ["نحوَ", 17.58, 17.86], ["مئتي", 17.91, 18.32], ["ألفِ", 18.38, 18.66], ["مدنيّ،", 18.72, 19.34], ["وهجّرت", 19.57, 20.2], ["أكثرَ", 20.27, 20.62], ["من", 20.67, 20.75], ["أربعةِ", 20.78, 21.2], ["ملايينِ", 21.26, 21.59], ["عراقيّ.", 21.63, 22.23]]}, {"text": "وربّما لم يجدْ تنظيمُ داعش الفوضى التي نما فيها، ولبقيت منارةُ الحدباءِ في الموصل قائمة.", "start": 22.73, "end": 29.55, "words": [["وربّما", 22.73, 23.23], ["لم", 23.28, 23.39], ["يجدْ", 23.46, 23.81], ["تنظيمُ", 23.87, 24.32], ["داعش", 24.38, 24.7], ["الفوضى", 24.76, 25.29], ["التي", 25.46, 25.8], ["نما", 25.87, 26.05], ["فيها،", 26.13, 26.6], ["ولبقيت", 26.77, 27.42], ["منارةُ", 27.49, 27.88], ["الحدباءِ", 27.9, 28.46], ["في", 28.5, 28.55], ["الموصل", 28.58, 28.97], ["قائمة.", 29.06, 29.55]]}, {"text": "لكنْ للقصّةِ وجهٌ آخر: العراقُ كان تحتَ الحصارِ منذ عامِ ألفٍ وتسعِمئةٍ وتسعين.", "start": 30.14, "end": 36.15, "words": [["لكنْ", 30.14, 30.45], ["للقصّةِ", 30.48, 31.0], ["وجهٌ", 31.06, 31.35], ["آخر:", 31.42, 31.92], ["العراقُ", 32.41, 32.94], ["كان", 33.01, 33.16], ["تحتَ", 33.24, 33.46], ["الحصارِ", 33.48, 33.96], ["منذ", 34.01, 34.18], ["عامِ", 34.27, 34.48], ["ألفٍ", 34.52, 34.81], ["وتسعِمئةٍ", 34.85, 35.48], ["وتسعين.", 35.53, 36.15]]}, {"text": "في الثمانينيّات كان الدينارُ يساوي أكثرَ من ثلاثةِ دولارات، وفي التسعينيّات صار الدولارُ بثلاثةِ آلافِ دينار.", "start": 36.75, "end": 44.34, "words": [["في", 36.75, 36.85], ["الثمانينيّات", 36.87, 37.73], ["كان", 37.8, 37.98], ["الدينارُ", 38.01, 38.45], ["يساوي", 38.49, 38.88], ["أكثرَ", 38.94, 39.29], ["من", 39.34, 39.42], ["ثلاثةِ", 39.46, 39.84], ["دولارات،", 39.88, 40.54], ["وفي", 40.93, 41.18], ["التسعينيّات", 41.2, 42.06], ["صار", 42.15, 42.35], ["الدولارُ", 42.39, 42.84], ["بثلاثةِ", 42.88, 43.46], ["آلافِ", 43.52, 43.8], ["دينار.", 43.85, 44.34]]}, {"text": "واليومَ يُنتجُ العراقُ أكثرَ من أربعةِ ملايينِ برميلِ نفطٍ يوميّاً، نحوَ ضِعفِ ما كان يُنتجُه تحتَ الحصار.", "start": 44.78, "end": 52.31, "words": [["واليومَ", 44.78, 45.17], ["يُنتجُ", 45.22, 45.63], ["العراقُ", 45.65, 46.19], ["أكثرَ", 46.27, 46.67], ["من", 46.72, 46.81], ["أربعةِ", 46.86, 47.37], ["ملايينِ", 47.44, 47.84], ["برميلِ", 47.89, 48.23], ["نفطٍ", 48.27, 48.54], ["يوميّاً،", 48.59, 49.24], ["نحوَ", 49.56, 49.88], ["ضِعفِ", 49.95, 50.26], ["ما", 50.33, 50.4], ["كان", 50.47, 50.67], ["يُنتجُه", 50.74, 51.29], ["تحتَ", 51.41, 51.64], ["الحصار.", 51.66, 52.31]]}, {"text": "وكانت الصحونُ اللاقطةُ ممنوعة، والإنترنت محدوداً تراقبُه الدولة.", "start": 52.64, "end": 57.69, "words": [["وكانت", 52.64, 53.13], ["الصحونُ", 53.19, 53.65], ["اللاقطةُ", 53.67, 54.29], ["ممنوعة،", 54.35, 55.01], ["والإنترنت", 55.18, 55.91], ["محدوداً", 55.98, 56.58], ["تراقبُه", 56.68, 57.2], ["الدولة.", 57.24, 57.69]]}, {"text": "والحاكمُ نفسُه منذ عامِ ألفٍ وتسعِمئةٍ وتسعةٍ وسبعين، ونظامُه قصفَ حَلَبْجة بالغازِ الكيميائيّ: نحوُ خمسةِ آلافِ قتيلٍ في يومٍ واحد.", "start": 57.88, "end": 67.78, "words": [["والحاكمُ", 57.88, 58.36], ["نفسُه", 58.4, 58.7], ["منذ", 58.76, 58.93], ["عامِ", 59.04, 59.25], ["ألفٍ", 59.3, 59.62], ["وتسعِمئةٍ", 59.69, 60.4], ["وتسعةٍ", 60.47, 60.93], ["وسبعين،", 60.98, 61.65], ["ونظامُه", 61.94, 62.52], ["قصفَ", 62.64, 62.96], ["حَلَبْجة", 63.01, 63.53], ["بالغازِ", 63.73, 64.15], ["الكيميائيّ:", 64.17, 64.86], ["نحوُ", 65.12, 65.4], ["خمسةِ", 65.46, 65.92], ["آلافِ", 65.98, 66.31], ["قتيلٍ", 66.36, 66.8], ["في", 66.97, 67.08], ["يومٍ", 67.13, 67.34], ["واحد.", 67.39, 67.78]]}, {"text": "وفي ألفين وأحدَ عشر، هبَّ الربيعُ العربيّ من تونس إلى سوريا… فهل كان سيصلُ إلى بغداد؟", "start": 68.07, "end": 74.71, "words": [["وفي", 68.07, 68.28], ["ألفين", 68.34, 68.63], ["وأحدَ", 68.67, 68.93], ["عشر،", 68.97, 69.47], ["هبَّ", 69.69, 69.95], ["الربيعُ", 69.97, 70.38], ["العربيّ", 70.4, 71.08], ["من", 71.17, 71.34], ["تونس", 71.4, 71.69], ["إلى", 71.74, 71.87], ["سوريا…", 71.94, 72.44], ["فهل", 72.72, 73.0], ["كان", 73.08, 73.29], ["سيصلُ", 73.4, 73.86], ["إلى", 73.91, 74.03], ["بغداد؟", 74.09, 74.71]]}, {"text": "واليوم، كان صدّام سيبلغُ تسعةً وثمانين عاماً… فمَن كان سيحكمُ بعدَه؟", "start": 75.04, "end": 80.2, "words": [["واليوم،", 75.04, 75.51], ["كان", 75.53, 75.71], ["صدّام", 75.83, 76.22], ["سيبلغُ", 76.3, 76.73], ["تسعةً", 76.8, 77.23], ["وثمانين", 77.28, 77.75], ["عاماً…", 77.84, 78.33], ["فمَن", 78.66, 78.94], ["كان", 79.01, 79.18], ["سيحكمُ", 79.26, 79.7], ["بعدَه؟", 79.74, 80.2]]}, {"text": "والغريب؟ أسلحةُ الدمارِ الشامل، السببُ الذي قامت عليه الحرب، لم يُعثَرْ عليها أبداً.", "start": 80.53, "end": 87.24, "words": [["والغريب؟", 80.53, 81.28], ["أسلحةُ", 81.49, 82.03], ["الدمارِ", 82.05, 82.48], ["الشامل،", 82.5, 83.17], ["السببُ", 83.42, 83.93], ["الذي", 83.95, 84.23], ["قامت", 84.32, 84.61], ["عليه", 84.67, 84.89], ["الحرب،", 84.96, 85.54], ["لم", 85.82, 86.0], ["يُعثَرْ", 86.06, 86.38], ["عليها", 86.4, 86.7], ["أبداً.", 86.73, 87.24]]}, {"text": "برأيك، كيف كان سيكونُ العراقُ اليوم؟ اكتبْ رأيَك في التعليقات، واشتركْ.", "start": 87.56, "end": 93.44, "words": [["برأيك،", 87.56, 88.27], ["كيف", 88.42, 88.68], ["كان", 88.79, 88.96], ["سيكونُ", 89.04, 89.47], ["العراقُ", 89.49, 89.91], ["اليوم؟", 89.93, 90.4], ["اكتبْ", 90.72, 91.19], ["رأيَك", 91.21, 91.5], ["في", 91.61, 91.68], ["التعليقات،", 91.71, 92.52], ["واشتركْ.", 92.61, 93.44]]}]