[{"text": "ماذا لو كانتِ الأرضُ مربّعة… مكعّباً بستّةِ وجوه؟", "start": 0.0, "end": 3.98, "words": [["ماذا", 0.0, 0.28], ["لو", 0.33, 0.43], ["كانتِ", 0.49, 0.79], ["الأرضُ", 0.81, 1.14], ["مربّعة…", 1.18, 1.92], ["مكعّباً", 2.23, 2.82], ["بستّةِ", 2.87, 3.38], ["وجوه؟", 3.45, 3.98]]}, {"text": "بنفسِ حجمِ الأرضِ اليوم، يكونُ طولُ ضلعِه نحوَ عشرةِ آلافِ كيلومتر.", "start": 4.4, "end": 9.45, "words": [["بنفسِ", 4.4, 4.78], ["حجمِ", 4.85, 5.16], ["الأرضِ", 5.18, 5.51], ["اليوم،", 5.54, 6.01], ["يكونُ", 6.21, 6.59], ["طولُ", 6.66, 6.9], ["ضلعِه", 6.97, 7.37], ["نحوَ", 7.52, 7.85], ["عشرةِ", 7.88, 8.36], ["آلافِ", 8.42, 8.77], ["كيلومتر.", 8.82, 9.45]]}, {"text": "الجاذبيّةُ تسحبُ كلَّ شيءٍ نحوَ المركز، وأقربُ نقطةٍ إليه هي وسطُ كلِّ وجه.", "start": 9.88, "end": 16.05, "words": [["الجاذبيّةُ", 9.88, 10.76], ["تسحبُ", 10.84, 11.31], ["كلَّ", 11.37, 11.61], ["شيءٍ", 11.68, 11.95], ["نحوَ", 11.98, 12.22], ["المركز،", 12.25, 12.92], ["وأقربُ", 13.12, 13.7], ["نقطةٍ", 13.77, 14.19], ["إليه", 14.24, 14.66], ["هي", 14.7, 14.92], ["وسطُ", 14.99, 15.26], ["كلِّ", 15.32, 15.56], ["وجه.", 15.59, 16.05]]}, {"text": "فتهربُ المحيطاتُ من الحوافّ، وتتجمّعُ في ستّةِ بحارٍ مستديرة، أعمقَ من ثمانينَ كيلومتراً.", "start": 16.41, "end": 23.24, "words": [["فتهربُ", 16.41, 16.94], ["المحيطاتُ", 16.95, 17.54], ["من", 17.59, 17.69], ["الحوافّ،", 17.74, 18.44], ["وتتجمّعُ", 18.63, 19.43], ["في", 19.49, 19.57], ["ستّةِ", 19.64, 20.0], ["بحارٍ", 20.06, 20.47], ["مستديرة،", 20.5, 21.3], ["أعمقَ", 21.5, 21.95], ["من", 22.0, 22.08], ["ثمانينَ", 22.15, 22.57], ["كيلومتراً.", 22.63, 23.24]]}, {"text": "والهواءُ أيضاً يجري إلى هناك، فلا تبقى للحياةِ إلّا حلقةٌ ضيّقةٌ حولَ كلِّ بحر.", "start": 23.66, "end": 29.29, "words": [["والهواءُ", 23.66, 24.11], ["أيضاً", 24.16, 24.46], ["يجري", 24.51, 24.75], ["إلى", 24.78, 24.9], ["هناك،", 24.97, 25.48], ["فلا", 25.68, 25.91], ["تبقى", 25.97, 26.25], ["للحياةِ", 26.29, 26.83], ["إلّا", 26.9, 27.17], ["حلقةٌ", 27.23, 27.73], ["ضيّقةٌ", 27.8, 28.3], ["حولَ", 28.38, 28.62], ["كلِّ", 28.66, 28.89], ["بحر.", 28.91, 29.29]]}, {"text": "ابتعدْ عن الشاطئ، فتصعدُ أرضاً مستويةً تماماً، لكنّها تبدو كجبلٍ لا ينتهي.", "start": 29.65, "end": 35.69, "words": [["ابتعدْ", 29.65, 30.14], ["عن", 30.18, 30.29], ["الشاطئ،", 30.33, 30.96], ["فتصعدُ", 31.13, 31.81], ["أرضاً", 31.87, 32.16], ["مستويةً", 32.2, 32.77], ["تماماً،", 32.81, 33.42], ["لكنّها", 33.69, 34.17], ["تبدو", 34.23, 34.47], ["كجبلٍ", 34.52, 34.96], ["لا", 35.0, 35.11], ["ينتهي.", 35.14, 35.69]]}, {"text": "وعلى الحافّة، تقفُ فوقَ قمّةٍ حادّة، وعلى جانبَيكَ منحدرانِ بميلِ خمسٍ وأربعينَ درجة.", "start": 36.05, "end": 42.34, "words": [["وعلى", 36.05, 36.33], ["الحافّة،", 36.36, 37.05], ["تقفُ", 37.19, 37.59], ["فوقَ", 37.64, 37.91], ["قمّةٍ", 37.98, 38.34], ["حادّة،", 38.41, 38.96], ["وعلى", 39.13, 39.38], ["جانبَيكَ", 39.45, 39.94], ["منحدرانِ", 39.98, 40.61], ["بميلِ", 40.67, 41.01], ["خمسٍ", 41.08, 41.35], ["وأربعينَ", 41.41, 41.82], ["درجة.", 41.88, 42.34]]}, {"text": "أمّا الزوايا، فأبعدُ عن المركزِ بنحوِ أربعةِ آلافِ كيلومتر، في الفضاءِ تماماً، بلا هواءٍ ولا ماء.", "start": 42.71, "end": 49.61, "words": [["أمّا", 42.71, 42.98], ["الزوايا،", 43.0, 43.7], ["فأبعدُ", 43.87, 44.35], ["عن", 44.4, 44.5], ["المركزِ", 44.52, 44.94], ["بنحوِ", 44.99, 45.33], ["أربعةِ", 45.37, 45.8], ["آلافِ", 45.86, 46.17], ["كيلومتر،", 46.23, 46.78], ["في", 47.1, 47.18], ["الفضاءِ", 47.22, 47.65], ["تماماً،", 47.71, 48.24], ["بلا", 48.31, 48.54], ["هواءٍ", 48.61, 48.98], ["ولا", 49.04, 49.23], ["ماء.", 49.27, 49.61]]}, {"text": "والغريب: هناك يصبحُ وزنُك أخفَّ بأكثرَ من الثلث.", "start": 49.99, "end": 54.06, "words": [["والغريب:", 49.99, 50.67], ["هناك", 50.86, 51.21], ["يصبحُ", 51.33, 51.77], ["وزنُك", 51.82, 52.21], ["أخفَّ", 52.38, 52.91], ["بأكثرَ", 52.95, 53.35], ["من", 53.38, 53.48], ["الثلث.", 53.52, 54.06]]}, {"text": "وتُشرقُ الشمسُ على الوجهِ كلِّه في اللحظةِ نفسِها، لأنّه مستوٍ.", "start": 54.37, "end": 58.61, "words": [["وتُشرقُ", 54.37, 54.98], ["الشمسُ", 55.01, 55.39], ["على", 55.46, 55.55], ["الوجهِ", 55.58, 55.95], ["كلِّه", 56.02, 56.33], ["في", 56.4, 56.47], ["اللحظةِ", 56.49, 56.9], ["نفسِها،", 56.95, 57.48], ["لأنّه", 57.68, 57.99], ["مستوٍ.", 58.06, 58.61]]}, {"text": "لكنّ المفاجأة: الأرضُ لا تبقى مكعّباً. فجاذبيّتُها الهائلةُ تسحقُ الحوافَّ والزوايا، بزلازلَ لا تتوقّف.", "start": 58.98, "end": 67.91, "words": [["لكنّ", 58.98, 59.33], ["المفاجأة:", 59.34, 60.12], ["الأرضُ", 60.35, 60.74], ["لا", 60.8, 60.87], ["تبقى", 60.94, 61.23], ["مكعّباً.", 61.27, 61.96], ["فجاذبيّتُها", 62.28, 63.13], ["الهائلةُ", 63.16, 63.81], ["تسحقُ", 64.02, 64.53], ["الحوافَّ", 64.55, 65.14], ["والزوايا،", 65.19, 65.98], ["بزلازلَ", 66.21, 66.94], ["لا", 67.01, 67.11], ["تتوقّف.", 67.15, 67.91]]}, {"text": "حتّى تعودَ كرةً من جديد. ولهذا، الأرضُ كرويّة.", "start": 68.22, "end": 72.26, "words": [["حتّى", 68.22, 68.61], ["تعودَ", 68.69, 69.01], ["كرةً", 69.07, 69.44], ["من", 69.46, 69.54], ["جديد.", 69.6, 70.09], ["ولهذا،", 70.36, 71.12], ["الأرضُ", 71.28, 71.63], ["كرويّة.", 71.69, 72.26]]}, {"text": "برأيك، أيُّ شكلٍ نجرّبُ بعدَ المربّع؟ اكتبْ في التعليقات، واشتركْ.", "start": 72.63, "end": 77.74, "words": [["برأيك،", 72.63, 73.29], ["أيُّ", 73.44, 73.75], ["شكلٍ", 73.79, 74.12], ["نجرّبُ", 74.16, 74.65], ["بعدَ", 74.71, 74.91], ["المربّع؟", 74.93, 75.58], ["اكتبْ", 75.83, 76.19], ["في", 76.22, 76.27], ["التعليقات،", 76.3, 76.95], ["واشتركْ.", 76.99, 77.74]]}]