[{"text": "ماذا لو استيقظَ كلُّ البشرِ غداً، وفي حسابِ كلٍّ منهم مليونُ دولار؟", "start": 0.0, "end": 5.14, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.44], ["استيقظَ", 0.48, 0.95], ["كلُّ", 1.01, 1.25], ["البشرِ", 1.28, 1.7], ["غداً،", 1.75, 2.25], ["وفي", 2.45, 2.71], ["حسابِ", 2.77, 3.19], ["كلٍّ", 3.26, 3.59], ["منهم", 3.61, 3.99], ["مليونُ", 4.16, 4.6], ["دولار؟", 4.64, 5.14]]}, {"text": "ثمانيةُ ملياراتِ مليونير! مالٌ يزيدُ على سبعينَ ضعفَ ما ينتجُه العالمُ كلُّه في سنة.", "start": 5.56, "end": 11.84, "words": [["ثمانيةُ", 5.56, 6.05], ["ملياراتِ", 6.09, 6.53], ["مليونير!", 6.58, 7.25], ["مالٌ", 7.55, 7.87], ["يزيدُ", 7.93, 8.34], ["على", 8.39, 8.51], ["سبعينَ", 8.59, 8.99], ["ضعفَ", 9.07, 9.38], ["ما", 9.44, 9.51], ["ينتجُه", 9.58, 10.09], ["العالمُ", 10.14, 10.59], ["كلُّه", 10.63, 10.99], ["في", 11.26, 11.4], ["سنة.", 11.48, 11.84]]}, {"text": "في الصباحِ يركضُ الجميعُ إلى المتاجر، فتفرغُ الرفوفُ بسرعة.", "start": 12.27, "end": 16.9, "words": [["في", 12.27, 12.35], ["الصباحِ", 12.38, 12.91], ["يركضُ", 12.93, 13.3], ["الجميعُ", 13.34, 13.82], ["إلى", 13.84, 13.97], ["المتاجر،", 14.0, 14.72], ["فتفرغُ", 14.92, 15.57], ["الرفوفُ", 15.59, 16.18], ["بسرعة.", 16.27, 16.9]]}, {"text": "لكنَّ البضائعَ لم تزدْ قطعةً واحدة. مالٌ أكثرُ يطاردُ السلعَ نفسَها، فترتفعُ الأسعارُ بجنون. هذا هو التضخُّم.", "start": 17.22, "end": 25.66, "words": [["لكنَّ", 17.22, 17.59], ["البضائعَ", 17.61, 18.23], ["لم", 18.27, 18.39], ["تزدْ", 18.47, 18.77], ["قطعةً", 18.81, 19.25], ["واحدة.", 19.31, 19.78], ["مالٌ", 20.2, 20.53], ["أكثرُ", 20.59, 20.91], ["يطاردُ", 20.96, 21.37], ["السلعَ", 21.4, 21.75], ["نفسَها،", 21.77, 22.33], ["فترتفعُ", 22.52, 23.2], ["الأسعارُ", 23.22, 23.67], ["بجنون.", 23.71, 24.27], ["هذا", 24.57, 24.79], ["هو", 24.83, 24.91], ["التضخُّم.", 24.96, 25.66]]}, {"text": "ثمَّ يتركُ كثيرون أعمالَهم. فمن يخبزُ الخبز، ويقودُ الشاحنات، وينظّفُ الشوارع، ويعالجُ المرضى؟", "start": 25.95, "end": 33.31, "words": [["ثمَّ", 25.95, 26.2], ["يتركُ", 26.24, 26.56], ["كثيرون", 26.61, 27.02], ["أعمالَهم.", 27.06, 27.71], ["فمن", 28.06, 28.33], ["يخبزُ", 28.4, 28.8], ["الخبز،", 28.83, 29.34], ["ويقودُ", 29.36, 29.79], ["الشاحنات،", 29.82, 30.52], ["وينظّفُ", 30.67, 31.29], ["الشوارع،", 31.31, 31.97], ["ويعالجُ", 32.14, 32.76], ["المرضى؟", 32.77, 33.31]]}, {"text": "حدثَ شيءٌ يشبهُ هذا فعلاً: في ألمانيا قبلَ نحوِ مئةِ عام، صارَ رغيفُ الخبزِ بنحوِ مئتَي مليارِ مارك.", "start": 33.67, "end": 41.22, "words": [["حدثَ", 33.67, 34.02], ["شيءٌ", 34.08, 34.34], ["يشبهُ", 34.4, 34.76], ["هذا", 34.83, 35.0], ["فعلاً:", 35.06, 35.49], ["في", 35.84, 35.96], ["ألمانيا", 36.03, 36.41], ["قبلَ", 36.45, 36.7], ["نحوِ", 36.75, 36.99], ["مئةِ", 37.05, 37.35], ["عام،", 37.42, 37.81], ["صارَ", 38.01, 38.31], ["رغيفُ", 38.38, 38.77], ["الخبزِ", 38.79, 39.27], ["بنحوِ", 39.38, 39.82], ["مئتَي", 39.87, 40.31], ["مليارِ", 40.41, 40.8], ["مارك.", 40.84, 41.22]]}, {"text": "وفي زيمبابوي، كانت الأسعارُ تتضاعفُ كلَّ يومٍ تقريباً، وطُبعَت ورقةٌ بمئةِ تريليونِ دولار.", "start": 41.52, "end": 48.33, "words": [["وفي", 41.52, 41.75], ["زيمبابوي،", 41.84, 42.53], ["كانت", 42.69, 42.99], ["الأسعارُ", 43.05, 43.57], ["تتضاعفُ", 43.63, 44.26], ["كلَّ", 44.34, 44.57], ["يومٍ", 44.62, 44.83], ["تقريباً،", 44.87, 45.52], ["وطُبعَت", 45.76, 46.3], ["ورقةٌ", 46.37, 46.85], ["بمئةِ", 46.94, 47.36], ["تريليونِ", 47.39, 47.87], ["دولار.", 47.9, 48.33]]}, {"text": "والمفاجأة؟ لن يصبحَ أحدٌ أغنى حقّاً، فالثروةُ ليست ورقاً، بل طعامٌ وبيوتٌ وعملٌ ننتجُه معاً.", "start": 48.65, "end": 56.15, "words": [["والمفاجأة؟", 48.65, 49.48], ["لن", 49.75, 49.92], ["يصبحَ", 49.96, 50.38], ["أحدٌ", 50.39, 50.76], ["أغنى", 50.84, 51.12], ["حقّاً،", 51.19, 51.69], ["فالثروةُ", 51.85, 52.38], ["ليست", 52.44, 52.72], ["ورقاً،", 52.79, 53.33], ["بل", 53.46, 53.62], ["طعامٌ", 53.69, 54.1], ["وبيوتٌ", 54.17, 54.68], ["وعملٌ", 54.74, 55.18], ["ننتجُه", 55.22, 55.69], ["معاً.", 55.79, 56.15]]}, {"text": "ماذا ستشتري أوّلاً بمليونِك؟ اكتبْ في التعليقات، واشتركْ.", "start": 56.56, "end": 61.21, "words": [["ماذا", 56.56, 56.84], ["ستشتري", 56.9, 57.4], ["أوّلاً", 57.46, 57.79], ["بمليونِك؟", 57.84, 58.5], ["اكتبْ", 58.94, 59.31], ["في", 59.35, 59.41], ["التعليقات،", 59.44, 60.26], ["واشتركْ.", 60.34, 61.21]]}]