[{"text": "تفتحُ عينيك… الشمسُ حارقة، والهواءُ مليءٌ بالغبار.", "start": 0.0, "end": 4.16, "words": [["تفتحُ", 0.0, 0.44], ["عينيك…", 0.5, 1.15], ["الشمسُ", 1.3, 1.78], ["حارقة،", 1.85, 2.44], ["والهواءُ", 2.69, 3.16], ["مليءٌ", 3.22, 3.5], ["بالغبار.", 3.55, 4.16]]}, {"text": "أمامَك جبلٌ أبيضُ يلمعُ كالمرآة، وآلافُ الرجالِ يسحبون حجارةً أثقلَ من سيارة.", "start": 4.5, "end": 10.52, "words": [["أمامَك", 4.5, 4.9], ["جبلٌ", 5.02, 5.32], ["أبيضُ", 5.38, 5.72], ["يلمعُ", 5.78, 6.09], ["كالمرآة،", 6.14, 6.84], ["وآلافُ", 7.09, 7.58], ["الرجالِ", 7.61, 8.02], ["يسحبون", 8.05, 8.44], ["حجارةً", 8.52, 9.14], ["أثقلَ", 9.39, 9.81], ["من", 9.86, 9.94], ["سيارة.", 9.98, 10.52]]}, {"text": "أنت الآنَ في مصرَ، قبلَ أربعةِ آلافٍ وخمسِمئةِ سنة.", "start": 10.81, "end": 14.58, "words": [["أنت", 10.81, 11.08], ["الآنَ", 11.12, 11.4], ["في", 11.46, 11.52], ["مصرَ،", 11.59, 12.05], ["قبلَ", 12.27, 12.55], ["أربعةِ", 12.6, 13.07], ["آلافٍ", 13.13, 13.49], ["وخمسِمئةِ", 13.56, 14.16], ["سنة.", 14.22, 14.58]]}, {"text": "ولديك يومٌ واحدٌ فقط… لتنجوَ فيه.", "start": 14.93, "end": 17.83, "words": [["ولديك", 14.93, 15.36], ["يومٌ", 15.46, 15.72], ["واحدٌ", 15.79, 16.14], ["فقط…", 16.2, 16.67], ["لتنجوَ", 16.96, 17.47], ["فيه.", 17.52, 17.83]]}, {"text": "وفي آخرِ هذا اليوم، ستعرفُ سرّاً عن هذا الجبلِ الأبيض، لا يعرفُه أكثرُ الناس.", "start": 18.12, "end": 24.38, "words": [["وفي", 18.12, 18.38], ["آخرِ", 18.45, 18.75], ["هذا", 18.79, 18.98], ["اليوم،", 19.01, 19.48], ["ستعرفُ", 19.7, 20.21], ["سرّاً", 20.3, 20.64], ["عن", 20.71, 20.8], ["هذا", 20.84, 21.04], ["الجبلِ", 21.06, 21.41], ["الأبيض،", 21.43, 22.04], ["لا", 22.28, 22.41], ["يعرفُه", 22.47, 22.96], ["أكثرُ", 23.06, 23.42], ["الناس.", 23.44, 24.38]]}, {"text": "تستيقظُ على سطحِ بيتٍ من الطين. كثيرٌ من الناسِ هنا ينامون فوقَ السطوح، هرباً من الحرّ.", "start": 26.78, "end": 33.69, "words": [["تستيقظُ", 26.78, 27.45], ["على", 27.54, 27.66], ["سطحِ", 27.74, 28.03], ["بيتٍ", 28.08, 28.37], ["من", 28.41, 28.52], ["الطين.", 28.58, 29.08], ["كثيرٌ", 29.4, 29.82], ["من", 29.85, 29.97], ["الناسِ", 30.02, 30.33], ["هنا", 30.39, 30.7], ["ينامون", 30.94, 31.39], ["فوقَ", 31.47, 31.74], ["السطوح،", 31.76, 32.39], ["هرباً", 32.56, 32.97], ["من", 33.0, 33.1], ["الحرّ.", 33.15, 33.69]]}, {"text": "تحتَ رأسِك لا توجدُ وسادة، بل مِسنَدٌ من الخشب، على شكلِ هلال.", "start": 34.07, "end": 38.99, "words": [["تحتَ", 34.07, 34.36], ["رأسِك", 34.42, 34.74], ["لا", 34.86, 34.94], ["توجدُ", 35.0, 35.36], ["وسادة،", 35.4, 36.08], ["بل", 36.25, 36.44], ["مِسنَدٌ", 36.5, 36.92], ["من", 36.95, 37.07], ["الخشب،", 37.11, 37.69], ["على", 37.9, 38.09], ["شكلِ", 38.17, 38.43], ["هلال.", 38.47, 38.99]]}, {"text": "تنزلُ إلى البيت: غرفٌ صغيرة، جدرانٌ من الطوبِ اللَّبِن، ونوافذُ ضيّقةٌ عاليةٌ تمنعُ الشمس.", "start": 39.38, "end": 46.6, "words": [["تنزلُ", 39.38, 39.78], ["إلى", 39.82, 39.92], ["البيت:", 39.96, 40.53], ["غرفٌ", 40.7, 41.1], ["صغيرة،", 41.19, 41.79], ["جدرانٌ", 41.97, 42.54], ["من", 42.58, 42.71], ["الطوبِ", 42.78, 43.1], ["اللَّبِن،", 43.13, 43.74], ["ونوافذُ", 43.91, 44.59], ["ضيّقةٌ", 44.66, 45.15], ["عاليةٌ", 45.24, 45.67], ["تمنعُ", 45.74, 46.05], ["الشمس.", 46.07, 46.6]]}, {"text": "الفطور: خبزٌ وبصل… وجَرّةٌ من الجِعة.", "start": 46.87, "end": 50.08, "words": [["الفطور:", 46.87, 47.52], ["خبزٌ", 47.69, 48.05], ["وبصل…", 48.15, 48.71], ["وجَرّةٌ", 48.91, 49.44], ["من", 49.47, 49.56], ["الجِعة.", 49.62, 50.08]]}, {"text": "نعم، الجِعة. كانت شراباً يومياً، كثيفةً كالحَساء، وقليلةَ الكحول.", "start": 50.26, "end": 55.34, "words": [["نعم،", 50.26, 50.58], ["الجِعة.", 50.62, 51.12], ["كانت", 51.38, 51.63], ["شراباً", 51.68, 52.03], ["يومياً،", 52.07, 52.66], ["كثيفةً", 52.8, 53.27], ["كالحَساء،", 53.33, 53.96], ["وقليلةَ", 54.17, 54.74], ["الكحول.", 54.77, 55.34]]}, {"text": "تقضمُ الخبز… فتسمعُ صوتاً يطحنُ أسنانَك.", "start": 55.62, "end": 58.81, "words": [["تقضمُ", 55.62, 55.99], ["الخبز…", 56.0, 56.54], ["فتسمعُ", 56.82, 57.3], ["صوتاً", 57.37, 57.72], ["يطحنُ", 57.85, 58.23], ["أسنانَك.", 58.27, 58.81]]}, {"text": "إنه رمل! حبّاتٌ من الرملِ والحجرِ تدخلُ الدقيقَ أثناءَ الطحن.", "start": 59.08, "end": 63.69, "words": [["إنه", 59.08, 59.35], ["رمل!", 59.43, 59.8], ["حبّاتٌ", 60.08, 60.5], ["من", 60.53, 60.65], ["الرملِ", 60.68, 60.96], ["والحجرِ", 61.01, 61.6], ["تدخلُ", 61.8, 62.18], ["الدقيقَ", 62.2, 62.69], ["أثناءَ", 62.71, 63.09], ["الطحن.", 63.11, 63.69]]}, {"text": "ولهذا وجدَ العلماءُ أسنانَ المومياواتِ ممسوحةً ومتآكلة، حتى عندَ الشباب.", "start": 64.07, "end": 69.63, "words": [["ولهذا", 64.07, 64.65], ["وجدَ", 64.71, 65.05], ["العلماءُ", 65.07, 65.62], ["أسنانَ", 65.65, 66.0], ["المومياواتِ", 66.02, 66.71], ["ممسوحةً", 66.74, 67.28], ["ومتآكلة،", 67.3, 68.3], ["حتى", 68.47, 68.76], ["عندَ", 68.8, 68.98], ["الشباب.", 69.01, 69.63]]}, {"text": "وهذه ليست أسوأَ مفاجأةٍ في يومِك.", "start": 69.96, "end": 72.9, "words": [["وهذه", 69.96, 70.32], ["ليست", 70.39, 70.72], ["أسوأَ", 70.77, 71.17], ["مفاجأةٍ", 71.21, 71.83], ["في", 71.9, 71.97], ["يومِك.", 72.05, 72.9]]}, {"text": "تمشي إلى النهر. النيلُ هنا هو كلُّ شيء: الماء، والطعام، والطريق.", "start": 75.3, "end": 80.0, "words": [["تمشي", 75.3, 75.63], ["إلى", 75.66, 75.77], ["النهر.", 75.79, 76.34], ["النيلُ", 76.6, 76.92], ["هنا", 76.94, 77.13], ["هو", 77.19, 77.29], ["كلُّ", 77.37, 77.59], ["شيء:", 77.63, 78.04], ["الماء،", 78.3, 78.76], ["والطعام،", 78.78, 79.3], ["والطريق.", 79.34, 80.0]]}, {"text": "وفي هذا الوقتِ من السنة، النهرُ يفيض، والماءُ يغطّي الحقول.", "start": 80.23, "end": 84.61, "words": [["وفي", 80.23, 80.44], ["هذا", 80.49, 80.66], ["الوقتِ", 80.67, 80.98], ["من", 81.02, 81.12], ["السنة،", 81.18, 81.76], ["النهرُ", 81.96, 82.3], ["يفيض،", 82.35, 82.97], ["والماءُ", 83.13, 83.56], ["يغطّي", 83.59, 83.92], ["الحقول.", 83.94, 84.61]]}, {"text": "المصريون عرفوا موعدَ الفيضانِ من نجمٍ واحد: الشِّعْرى، ألمعُ نجمٍ في السماء.", "start": 84.92, "end": 90.78, "words": [["المصريون", 84.92, 85.62], ["عرفوا", 85.67, 86.05], ["موعدَ", 86.07, 86.43], ["الفيضانِ", 86.45, 87.0], ["من", 87.04, 87.13], ["نجمٍ", 87.17, 87.45], ["واحد:", 87.51, 88.04], ["الشِّعْرى،", 88.28, 89.04], ["ألمعُ", 89.27, 89.71], ["نجمٍ", 89.75, 90.06], ["في", 90.11, 90.17], ["السماء.", 90.2, 90.78]]}, {"text": "حينَ يظهرُ قبلَ الفجرِ بعدَ غيابِه، يعرفون أن الماءَ قادم.", "start": 91.04, "end": 95.06, "words": [["حينَ", 91.04, 91.34], ["يظهرُ", 91.4, 91.8], ["قبلَ", 91.86, 92.11], ["الفجرِ", 92.14, 92.55], ["بعدَ", 92.59, 92.79], ["غيابِه،", 92.84, 93.38], ["يعرفون", 93.62, 94.06], ["أن", 94.1, 94.22], ["الماءَ", 94.28, 94.52], ["قادم.", 94.6, 95.06]]}, {"text": "ومن هنا صنعوا تقويماً من ثلاثِمئةٍ وخمسةٍ وستّينَ يوماً: اثنا عشرَ شهراً، في كلٍّ منها ثلاثون يوماً، وخمسةُ أيامٍ زائدةٍ للأعياد.", "start": 95.31, "end": 105.16, "words": [["ومن", 95.31, 95.57], ["هنا", 95.61, 95.82], ["صنعوا", 95.94, 96.26], ["تقويماً", 96.3, 96.79], ["من", 96.83, 96.92], ["ثلاثِمئةٍ", 96.98, 97.69], ["وخمسةٍ", 97.75, 98.25], ["وستّينَ", 98.31, 98.78], ["يوماً:", 98.84, 99.24], ["اثنا", 99.54, 99.9], ["عشرَ", 99.98, 100.3], ["شهراً،", 100.37, 100.92], ["في", 101.06, 101.16], ["كلٍّ", 101.26, 101.56], ["منها", 101.58, 101.81], ["ثلاثون", 101.87, 102.31], ["يوماً،", 102.37, 102.83], ["وخمسةُ", 103.0, 103.59], ["أيامٍ", 103.62, 104.04], ["زائدةٍ", 104.11, 104.51], ["للأعياد.", 104.53, 105.16]]}, {"text": "لكن انتبه… لا تقتربْ من الماء.", "start": 105.52, "end": 107.92, "words": [["لكن", 105.52, 105.78], ["انتبه…", 105.83, 106.42], ["لا", 106.74, 106.85], ["تقتربْ", 106.9, 107.32], ["من", 107.34, 107.46], ["الماء.", 107.51, 107.92]]}, {"text": "فيه تماسيح، وفيه ما هو أخطرُ منها: فرسُ النهر. حيوانٌ يزنُ أكثرَ من طنٍّ ونصف، ويهاجمُ القوارب.", "start": 108.15, "end": 116.21, "words": [["فيه", 108.15, 108.4], ["تماسيح،", 108.49, 109.15], ["وفيه", 109.2, 109.53], ["ما", 109.61, 109.68], ["هو", 109.73, 109.86], ["أخطرُ", 109.93, 110.29], ["منها:", 110.32, 110.76], ["فرسُ", 111.09, 111.46], ["النهر.", 111.48, 111.96], ["حيوانٌ", 112.34, 112.89], ["يزنُ", 112.98, 113.32], ["أكثرَ", 113.36, 113.68], ["من", 113.71, 113.81], ["طنٍّ", 113.86, 114.14], ["ونصف،", 114.17, 114.7], ["ويهاجمُ", 114.87, 115.52], ["القوارب.", 115.55, 116.21]]}, {"text": "على الماء، ترى قواربَ محمّلةً بحجارةٍ بيضاءَ ضخمة.", "start": 116.53, "end": 119.99, "words": [["على", 116.53, 116.72], ["الماء،", 116.75, 117.09], ["ترى", 117.14, 117.35], ["قواربَ", 117.42, 117.85], ["محمّلةً", 117.88, 118.45], ["بحجارةٍ", 118.5, 119.1], ["بيضاءَ", 119.15, 119.49], ["ضخمة.", 119.54, 119.99]]}, {"text": "ونحن نعرفُ هذا يقيناً، لأن رجلاً اسمُه «مِرِر» كتبَ يومياتِه على ورقِ البَرْدي:", "start": 120.32, "end": 126.31, "words": [["ونحن", 120.32, 120.67], ["نعرفُ", 120.7, 121.03], ["هذا", 121.1, 121.31], ["يقيناً،", 121.35, 121.96], ["لأن", 122.13, 122.37], ["رجلاً", 122.49, 122.91], ["اسمُه", 122.97, 123.36], ["«مِرِر»", 123.4, 123.93], ["كتبَ", 124.14, 124.5], ["يومياتِه", 124.54, 125.14], ["على", 125.23, 125.37], ["ورقِ", 125.45, 125.71], ["البَرْدي:", 125.73, 126.31]]}, {"text": "كيف نقلَ مع فريقِه الحجرَ الجيريَّ الأبيض من مقالعِ طُرّة، عبرَ النيلِ والقنوات، إلى موقعِ البناء.", "start": 126.59, "end": 133.23, "words": [["كيف", 126.59, 126.81], ["نقلَ", 126.89, 127.18], ["مع", 127.23, 127.32], ["فريقِه", 127.39, 127.75], ["الحجرَ", 127.8, 128.21], ["الجيريَّ", 128.24, 128.66], ["الأبيض", 128.68, 129.15], ["من", 129.22, 129.32], ["مقالعِ", 129.36, 129.8], ["طُرّة،", 129.84, 130.36], ["عبرَ", 130.54, 130.81], ["النيلِ", 130.84, 131.12], ["والقنوات،", 131.15, 131.89], ["إلى", 132.07, 132.24], ["موقعِ", 132.31, 132.66], ["البناء.", 132.68, 133.23]]}, {"text": "وهذه اليومياتُ هي أقدمُ أوراقِ برديٍّ مكتوبةٍ عُثِرَ عليها حتى الآن.", "start": 133.61, "end": 138.67, "words": [["وهذه", 133.61, 134.01], ["اليومياتُ", 134.04, 134.67], ["هي", 134.72, 134.83], ["أقدمُ", 134.88, 135.33], ["أوراقِ", 135.37, 135.78], ["برديٍّ", 135.84, 136.28], ["مكتوبةٍ", 136.31, 136.93], ["عُثِرَ", 137.18, 137.59], ["عليها", 137.64, 137.92], ["حتى", 137.99, 138.22], ["الآن.", 138.25, 138.67]]}, {"text": "والقواربُ كلُّها تتّجهُ إلى مكانٍ واحد…", "start": 139.12, "end": 142.59, "words": [["والقواربُ", 139.12, 139.84], ["كلُّها", 139.89, 140.42], ["تتّجهُ", 140.59, 141.15], ["إلى", 141.19, 141.32], ["مكانٍ", 141.38, 141.72], ["واحد…", 141.77, 142.59]]}, {"text": "الهرمُ الأكبر، للملكِ خوفو.", "start": 144.99, "end": 147.31, "words": [["الهرمُ", 144.99, 145.46], ["الأكبر،", 145.49, 146.03], ["للملكِ", 146.19, 146.71], ["خوفو.", 146.78, 147.31]]}, {"text": "ارتفاعُه مئةٌ وستّةٌ وأربعون متراً، مثلَ عمارةٍ من خمسةٍ وأربعينَ طابقاً.", "start": 147.58, "end": 152.96, "words": [["ارتفاعُه", 147.58, 148.18], ["مئةٌ", 148.28, 148.63], ["وستّةٌ", 148.73, 149.27], ["وأربعون", 149.33, 149.74], ["متراً،", 149.82, 150.28], ["مثلَ", 150.48, 150.77], ["عمارةٍ", 150.85, 151.37], ["من", 151.41, 151.5], ["خمسةٍ", 151.56, 151.97], ["وأربعينَ", 152.03, 152.43], ["طابقاً.", 152.5, 152.96]]}, {"text": "فيه نحوُ مليونَين وثلاثِمئةِ ألفِ حجر، ومتوسّطُ وزنِ الحجرِ أكثرُ من طنَّين.", "start": 153.28, "end": 158.92, "words": [["فيه", 153.28, 153.51], ["نحوُ", 153.63, 153.87], ["مليونَين", 153.94, 154.44], ["وثلاثِمئةِ", 154.48, 155.27], ["ألفِ", 155.32, 155.53], ["حجر،", 155.59, 156.05], ["ومتوسّطُ", 156.28, 157.07], ["وزنِ", 157.11, 157.34], ["الحجرِ", 157.36, 157.8], ["أكثرُ", 157.86, 158.25], ["من", 158.29, 158.36], ["طنَّين.", 158.42, 158.92]]}, {"text": "وهو ليس أصفرَ كما نراه اليوم. إنه مكسوٌّ بحجرٍ جيريٍّ أبيضَ مصقول، يعكسُ الشمسَ فيلمعُ من بعيد.", "start": 159.28, "end": 166.59, "words": [["وهو", 159.28, 159.51], ["ليس", 159.59, 159.79], ["أصفرَ", 159.86, 160.28], ["كما", 160.32, 160.51], ["نراه", 160.56, 160.79], ["اليوم.", 160.82, 161.23], ["إنه", 161.54, 161.81], ["مكسوٌّ", 161.89, 162.32], ["بحجرٍ", 162.36, 162.84], ["جيريٍّ", 162.91, 163.39], ["أبيضَ", 163.41, 163.77], ["مصقول،", 163.81, 164.39], ["يعكسُ", 164.65, 165.08], ["الشمسَ", 165.11, 165.48], ["فيلمعُ", 165.55, 165.97], ["من", 165.99, 166.07], ["بعيد.", 166.13, 166.59]]}, {"text": "تتوقّعُ أن ترى عبيداً يُضرَبون بالسياط؟", "start": 166.91, "end": 169.62, "words": [["تتوقّعُ", 166.91, 167.55], ["أن", 167.59, 167.66], ["ترى", 167.71, 167.91], ["عبيداً", 167.94, 168.36], ["يُضرَبون", 168.43, 168.86], ["بالسياط؟", 168.94, 169.62]]}, {"text": "الحقيقةُ مختلفة. أكثرُ العلماءِ اليومَ يرون أن البنّائينَ كانوا عمّالاً يأخذون أجراً: خبزاً وجِعةً ولحماً.", "start": 169.94, "end": 178.11, "words": [["الحقيقةُ", 169.94, 170.52], ["مختلفة.", 170.56, 171.21], ["أكثرُ", 171.53, 171.93], ["العلماءِ", 171.96, 172.54], ["اليومَ", 172.56, 172.92], ["يرون", 172.98, 173.32], ["أن", 173.37, 173.47], ["البنّائينَ", 173.52, 174.1], ["كانوا", 174.17, 174.38], ["عمّالاً", 174.43, 175.0], ["يأخذون", 175.32, 175.85], ["أجراً:", 175.9, 176.42], ["خبزاً", 176.61, 177.01], ["وجِعةً", 177.07, 177.56], ["ولحماً.", 177.61, 178.11]]}, {"text": "فقد وُجِدَت بقربِ الهرمِ قريةُ العمّال، وفيها مخابز، وعظامُ كثيرٍ من الأبقارِ والأغنام.", "start": 178.43, "end": 184.7, "words": [["فقد", 178.43, 178.78], ["وُجِدَت", 178.83, 179.24], ["بقربِ", 179.31, 179.68], ["الهرمِ", 179.7, 180.08], ["قريةُ", 180.14, 180.46], ["العمّال،", 180.48, 181.12], ["وفيها", 181.34, 181.71], ["مخابز،", 181.78, 182.42], ["وعظامُ", 182.58, 183.0], ["كثيرٍ", 183.07, 183.46], ["من", 183.5, 183.6], ["الأبقارِ", 183.66, 184.08], ["والأغنام.", 184.1, 184.7]]}, {"text": "بل وُجِدَت مقابرُهم بجانبِ هرمِ ملكِهم، وهذا شرفٌ لا يُعطى للعبيد.", "start": 185.01, "end": 189.92, "words": [["بل", 185.01, 185.16], ["وُجِدَت", 185.22, 185.62], ["مقابرُهم", 185.71, 186.4], ["بجانبِ", 186.45, 186.89], ["هرمِ", 186.95, 187.22], ["ملكِهم،", 187.27, 187.86], ["وهذا", 188.09, 188.47], ["شرفٌ", 188.51, 188.87], ["لا", 188.94, 189.05], ["يُعطى", 189.09, 189.33], ["للعبيد.", 189.37, 189.92]]}, {"text": "وكانوا فِرَقاً لها أسماء، كتبوها على الحجارة، مثل: «أصدقاءُ خوفو». وفي هرمٍ بُنِيَ بعدَه، فرقةٌ اسمُها: «سُكارى مَنكاورع».", "start": 190.22, "end": 200.34, "words": [["وكانوا", 190.22, 190.66], ["فِرَقاً", 190.68, 191.05], ["لها", 191.11, 191.31], ["أسماء،", 191.33, 191.94], ["كتبوها", 192.16, 192.66], ["على", 192.73, 192.83], ["الحجارة،", 192.87, 193.37], ["مثل:", 193.38, 193.88], ["«أصدقاءُ", 194.02, 194.75], ["خوفو».", 194.81, 195.36], ["وفي", 195.72, 195.98], ["هرمٍ", 196.08, 196.45], ["بُنِيَ", 196.52, 196.83], ["بعدَه،", 196.87, 197.35], ["فرقةٌ", 197.5, 197.97], ["اسمُها:", 198.03, 198.59], ["«سُكارى", 198.74, 199.46], ["مَنكاورع».", 199.53, 200.34]]}, {"text": "ولكن كيف يسحبون حجراً بوزنِ سيارتَين؟", "start": 200.67, "end": 203.73, "words": [["ولكن", 200.67, 201.09], ["كيف", 201.14, 201.37], ["يسحبون", 201.46, 201.95], ["حجراً", 202.04, 202.48], ["بوزنِ", 202.54, 202.91], ["سيارتَين؟", 202.97, 203.73]]}, {"text": "انظرْ إلى الرجلِ أمامَ الزلّاجة. إنه يصبُّ الماءَ على الرمل.", "start": 204.17, "end": 208.61, "words": [["انظرْ", 204.17, 204.58], ["إلى", 204.62, 204.78], ["الرجلِ", 204.8, 205.25], ["أمامَ", 205.3, 205.58], ["الزلّاجة.", 205.6, 206.29], ["إنه", 206.61, 206.93], ["يصبُّ", 207.02, 207.47], ["الماءَ", 207.5, 207.83], ["على", 207.87, 208.04], ["الرمل.", 208.08, 208.61]]}, {"text": "في عامِ ألفَين وأربعةَ عشر، اكتشفَ علماءُ فيزياء أن الرملَ المبلّلَ بالقدرِ المناسب، يقلّلُ قوّةَ السحبِ إلى النصفِ تقريباً.", "start": 209.05, "end": 217.85, "words": [["في", 209.05, 209.16], ["عامِ", 209.24, 209.43], ["ألفَين", 209.47, 209.78], ["وأربعةَ", 209.82, 210.24], ["عشر،", 210.27, 210.66], ["اكتشفَ", 210.87, 211.45], ["علماءُ", 211.5, 211.93], ["فيزياء", 211.98, 212.48], ["أن", 212.51, 212.71], ["الرملَ", 212.75, 213.08], ["المبلّلَ", 213.1, 213.7], ["بالقدرِ", 213.74, 214.16], ["المناسب،", 214.18, 214.8], ["يقلّلُ", 215.12, 215.61], ["قوّةَ", 215.68, 216.01], ["السحبِ", 216.03, 216.49], ["إلى", 216.53, 216.67], ["النصفِ", 216.7, 217.11], ["تقريباً.", 217.18, 217.85]]}, {"text": "وهذا المشهدُ نفسُه مرسومٌ على جدارِ مقبرةٍ مصريةٍ قديمة.", "start": 218.18, "end": 222.24, "words": [["وهذا", 218.18, 218.52], ["المشهدُ", 218.55, 218.98], ["نفسُه", 219.04, 219.4], ["مرسومٌ", 219.47, 219.93], ["على", 220.01, 220.13], ["جدارِ", 220.21, 220.51], ["مقبرةٍ", 220.56, 221.09], ["مصريةٍ", 221.13, 221.6], ["قديمة.", 221.68, 222.24]]}, {"text": "وفي الأعلى، حجارةُ الغرانيت لغرفةِ الملك، جاءت من أسوان، على بُعدِ أكثرَ من ثمانِمئةِ كيلومترٍ عبرَ النيل. بعضُها يزنُ عشراتِ الأطنان.", "start": 222.62, "end": 233.44, "words": [["وفي", 222.62, 222.84], ["الأعلى،", 222.88, 223.49], ["حجارةُ", 223.64, 224.13], ["الغرانيت", 224.17, 224.74], ["لغرفةِ", 224.78, 225.21], ["الملك،", 225.25, 225.82], ["جاءت", 226.09, 226.41], ["من", 226.45, 226.56], ["أسوان،", 226.59, 227.26], ["على", 227.46, 227.64], ["بُعدِ", 227.71, 227.99], ["أكثرَ", 228.04, 228.43], ["من", 228.47, 228.57], ["ثمانِمئةِ", 228.64, 229.3], ["كيلومترٍ", 229.38, 230.02], ["عبرَ", 230.34, 230.69], ["النيل.", 230.72, 231.19], ["بعضُها", 231.52, 231.92], ["يزنُ", 231.99, 232.29], ["عشراتِ", 232.36, 232.79], ["الأطنان.", 232.83, 233.44]]}, {"text": "أدواتُهم؟ أزاميلُ من النحاس، ومطارقُ من الحجرِ الصلب.", "start": 233.65, "end": 238.27, "words": [["أدواتُهم؟", 233.65, 234.55], ["أزاميلُ", 234.87, 235.42], ["من", 235.46, 235.56], ["النحاس،", 235.61, 236.4], ["ومطارقُ", 236.53, 237.19], ["من", 237.24, 237.33], ["الحجرِ", 237.38, 237.77], ["الصلب.", 237.8, 238.27]]}, {"text": "ومع ذلك، الهرمُ موجّهٌ نحوَ الشمالِ الحقيقيّ بخطأٍ أقلَّ من عُشرِ درجة.", "start": 238.55, "end": 243.95, "words": [["ومع", 238.55, 238.84], ["ذلك،", 238.96, 239.31], ["الهرمُ", 239.33, 239.71], ["موجّهٌ", 239.75, 240.21], ["نحوَ", 240.27, 240.51], ["الشمالِ", 240.54, 240.96], ["الحقيقيّ", 240.98, 241.79], ["بخطأٍ", 242.04, 242.52], ["أقلَّ", 242.59, 242.94], ["من", 242.98, 243.07], ["عُشرِ", 243.11, 243.41], ["درجة.", 243.44, 243.95]]}, {"text": "فجأةً… يصرخُ أحدُ العمّال.", "start": 244.33, "end": 247.34, "words": [["فجأةً…", 244.33, 245.2], ["يصرخُ", 245.53, 246.05], ["أحدُ", 246.1, 246.39], ["العمّال.", 246.41, 247.34]]}, {"text": "حجرٌ انزلقَ على ساقِه. العظمُ مكسور.", "start": 249.74, "end": 252.67, "words": [["حجرٌ", 249.74, 250.19], ["انزلقَ", 250.25, 250.65], ["على", 250.68, 250.81], ["ساقِه.", 250.88, 251.37], ["العظمُ", 251.68, 252.1], ["مكسور.", 252.14, 252.67]]}, {"text": "في زمنٍ بلا مستشفيات، تظنُّ أن هذه نهايتُه.", "start": 253.04, "end": 256.43, "words": [["في", 253.04, 253.14], ["زمنٍ", 253.24, 253.56], ["بلا", 253.63, 253.79], ["مستشفيات،", 253.84, 254.7], ["تظنُّ", 254.87, 255.24], ["أن", 255.28, 255.39], ["هذه", 255.48, 255.72], ["نهايتُه.", 255.78, 256.43]]}, {"text": "لكن يأتي الطبيب.", "start": 256.73, "end": 257.86, "words": [["لكن", 256.73, 257.02], ["يأتي", 257.07, 257.23], ["الطبيب.", 257.25, 257.86]]}, {"text": "فالمصريون كتبوا واحداً من أقدمِ كتبِ الجراحةِ في العالم: بَرْدِيّةَ «إدوين سميث». فيها ثمانٍ وأربعون حالةَ إصابة، وكيف تُفحَصُ وتُعالَج.", "start": 258.17, "end": 267.68, "words": [["فالمصريون", 258.17, 258.82], ["كتبوا", 258.91, 259.26], ["واحداً", 259.3, 259.7], ["من", 259.75, 259.85], ["أقدمِ", 259.88, 260.19], ["كتبِ", 260.24, 260.49], ["الجراحةِ", 260.51, 260.94], ["في", 260.98, 261.01], ["العالم:", 261.05, 261.56], ["بَرْدِيّةَ", 261.87, 262.35], ["«إدوين", 262.37, 262.71], ["سميث».", 262.77, 263.21], ["فيها", 263.57, 263.82], ["ثمانٍ", 263.92, 264.23], ["وأربعون", 264.28, 264.74], ["حالةَ", 264.82, 265.11], ["إصابة،", 265.16, 265.72], ["وكيف", 265.95, 266.33], ["تُفحَصُ", 266.44, 266.89], ["وتُعالَج.", 266.95, 267.68]]}, {"text": "الطبيبُ يشدُّ الساق، ويثبّتُها بألواحٍ من الخشب، ويلفُّها بالكتّان.", "start": 268.04, "end": 273.39, "words": [["الطبيبُ", 268.04, 268.54], ["يشدُّ", 268.6, 269.01], ["الساق،", 269.04, 269.58], ["ويثبّتُها", 269.72, 270.44], ["بألواحٍ", 270.51, 270.99], ["من", 271.02, 271.13], ["الخشب،", 271.18, 271.79], ["ويلفُّها", 271.95, 272.62], ["بالكتّان.", 272.68, 273.39]]}, {"text": "وعلى الجرح؟ عسل.", "start": 273.69, "end": 275.39, "words": [["وعلى", 273.69, 273.95], ["الجرح؟", 273.97, 274.54], ["عسل.", 274.84, 275.39]]}, {"text": "يبدو غريباً، لكنّ العلمَ الحديثَ أثبتَ أن العسلَ يقتلُ كثيراً من البكتيريا.", "start": 275.69, "end": 281.19, "words": [["يبدو", 275.69, 276.0], ["غريباً،", 276.04, 276.61], ["لكنّ", 276.77, 277.12], ["العلمَ", 277.15, 277.43], ["الحديثَ", 277.45, 278.1], ["أثبتَ", 278.32, 278.85], ["أن", 278.89, 279.08], ["العسلَ", 279.14, 279.56], ["يقتلُ", 279.61, 279.94], ["كثيراً", 279.98, 280.36], ["من", 280.38, 280.47], ["البكتيريا.", 280.53, 281.19]]}, {"text": "وفي هياكلِ العمّالِ المدفونينَ قربَ الهرم، وجدَ العلماءُ عظاماً مكسورة… التأمَت من جديد.", "start": 281.49, "end": 288.59, "words": [["وفي", 281.49, 281.76], ["هياكلِ", 281.83, 282.26], ["العمّالِ", 282.28, 282.75], ["المدفونينَ", 282.77, 283.49], ["قربَ", 283.63, 283.92], ["الهرم،", 283.94, 284.48], ["وجدَ", 284.72, 285.13], ["العلماءُ", 285.15, 285.71], ["عظاماً", 285.8, 286.22], ["مكسورة…", 286.25, 286.94], ["التأمَت", 287.32, 287.8], ["من", 287.84, 287.93], ["جديد.", 288.0, 288.59]]}, {"text": "أي أن هذا العاملَ قد يعيش، ويعودُ إلى العمل.", "start": 288.91, "end": 292.15, "words": [["أي", 288.91, 289.06], ["أن", 289.1, 289.23], ["هذا", 289.3, 289.49], ["العاملَ", 289.52, 289.93], ["قد", 290.0, 290.14], ["يعيش،", 290.21, 290.79], ["ويعودُ", 290.94, 291.49], ["إلى", 291.52, 291.63], ["العمل.", 291.65, 292.15]]}, {"text": "لكنّ الطبيبَ نفسَه قد يصفُ لك دواءً آخر… فيه روثُ الحيوانات.", "start": 292.53, "end": 297.78, "words": [["لكنّ", 292.53, 292.87], ["الطبيبَ", 292.89, 293.32], ["نفسَه", 293.37, 293.79], ["قد", 294.17, 294.37], ["يصفُ", 294.43, 294.83], ["لك", 294.89, 295.02], ["دواءً", 295.15, 295.48], ["آخر…", 295.52, 296.06], ["فيه", 296.34, 296.61], ["روثُ", 296.73, 296.96], ["الحيوانات.", 296.98, 297.78]]}, {"text": "فالطبُّ هنا خليطٌ من العلمِ والسحر.", "start": 298.11, "end": 300.92, "words": [["فالطبُّ", 298.11, 298.61], ["هنا", 298.65, 298.87], ["خليطٌ", 298.96, 299.37], ["من", 299.42, 299.52], ["العلمِ", 299.58, 299.92], ["والسحر.", 299.97, 300.92]]}, {"text": "في الظهيرة، تذهبُ إلى السوق. أنت جائع… وليس معك نقود.", "start": 303.32, "end": 308.39, "words": [["في", 303.32, 303.46], ["الظهيرة،", 303.49, 304.2], ["تذهبُ", 304.37, 304.77], ["إلى", 304.82, 304.93], ["السوق.", 304.97, 305.48], ["أنت", 305.79, 306.03], ["جائع…", 306.14, 306.75], ["وليس", 307.06, 307.42], ["معك", 307.52, 307.79], ["نقود.", 307.88, 308.39]]}, {"text": "لأنه لا توجدُ نقودٌ أصلاً! أوّلُ العملاتِ في العالمِ لن تُصنَعَ إلا بعدَ نحوِ ألفَي سنة.", "start": 308.69, "end": 314.9, "words": [["لأنه", 308.69, 309.03], ["لا", 309.11, 309.18], ["توجدُ", 309.26, 309.61], ["نقودٌ", 309.66, 310.03], ["أصلاً!", 310.06, 310.57], ["أوّلُ", 310.88, 311.27], ["العملاتِ", 311.29, 311.73], ["في", 311.79, 311.84], ["العالمِ", 311.87, 312.44], ["لن", 312.64, 312.8], ["تُصنَعَ", 312.87, 313.28], ["إلا", 313.33, 313.51], ["بعدَ", 313.57, 313.79], ["نحوِ", 313.84, 314.11], ["ألفَي", 314.17, 314.46], ["سنة.", 314.52, 314.9]]}, {"text": "هنا كلُّ شيءٍ بالمقايضة: سمكٌ مقابلَ خبز، وجَرّةُ زيتٍ مقابلَ صندلٍ من البَرْدي.", "start": 315.21, "end": 321.65, "words": [["هنا", 315.21, 315.54], ["كلُّ", 315.65, 315.87], ["شيءٍ", 315.91, 316.16], ["بالمقايضة:", 316.22, 317.08], ["سمكٌ", 317.39, 317.85], ["مقابلَ", 317.92, 318.38], ["خبز،", 318.46, 318.98], ["وجَرّةُ", 319.15, 319.64], ["زيتٍ", 319.71, 319.98], ["مقابلَ", 320.05, 320.45], ["صندلٍ", 320.52, 320.92], ["من", 320.95, 321.06], ["البَرْدي.", 321.12, 321.65]]}, {"text": "وتلاحظُ أن الرجالَ والنساءَ كلَّهم يضعون الكُحلَ الأسودَ حولَ العيون.", "start": 322.03, "end": 326.7, "words": [["وتلاحظُ", 322.03, 322.63], ["أن", 322.68, 322.81], ["الرجالَ", 322.86, 323.28], ["والنساءَ", 323.33, 323.81], ["كلَّهم", 323.87, 324.38], ["يضعون", 324.53, 324.95], ["الكُحلَ", 324.98, 325.33], ["الأسودَ", 325.35, 325.84], ["حولَ", 325.9, 326.11], ["العيون.", 326.13, 326.7]]}, {"text": "ليس للزينةِ فقط. فقد أشارت دراسةٌ حديثة إلى أن موادَّ في هذا الكُحل، قد تساعدُ العينَ على مقاومةِ الالتهابات، تحتَ شمسٍ قاسيةٍ وذبابٍ كثير.", "start": 327.03, "end": 338.29, "words": [["ليس", 327.03, 327.25], ["للزينةِ", 327.34, 327.75], ["فقط.", 327.8, 328.29], ["فقد", 328.62, 328.94], ["أشارت", 328.99, 329.31], ["دراسةٌ", 329.35, 329.8], ["حديثة", 329.88, 330.29], ["إلى", 330.32, 330.45], ["أن", 330.52, 330.64], ["موادَّ", 330.75, 331.19], ["في", 331.23, 331.31], ["هذا", 331.37, 331.53], ["الكُحل،", 331.55, 332.15], ["قد", 332.39, 332.53], ["تساعدُ", 332.57, 333.02], ["العينَ", 333.04, 333.39], ["على", 333.46, 333.6], ["مقاومةِ", 333.67, 334.26], ["الالتهابات،", 334.28, 335.26], ["تحتَ", 335.5, 335.79], ["شمسٍ", 335.86, 336.19], ["قاسيةٍ", 336.28, 336.93], ["وذبابٍ", 337.1, 337.7], ["كثير.", 337.75, 338.29]]}, {"text": "وكثيرٌ من الأغنياءِ يحلقون رؤوسَهم، ويلبسون شَعراً مستعاراً، ليتخلّصوا من القملِ ومن الحرّ.", "start": 338.73, "end": 345.86, "words": [["وكثيرٌ", 338.73, 339.29], ["من", 339.32, 339.41], ["الأغنياءِ", 339.47, 340.09], ["يحلقون", 340.11, 340.73], ["رؤوسَهم،", 340.79, 341.55], ["ويلبسون", 341.7, 342.4], ["شَعراً", 342.51, 342.84], ["مستعاراً،", 342.86, 343.62], ["ليتخلّصوا", 343.66, 344.45], ["من", 344.48, 344.59], ["القملِ", 344.65, 345.04], ["ومن", 345.08, 345.29], ["الحرّ.", 345.33, 345.86]]}, {"text": "ثم ترى رجلاً يجلسُ متربّعاً، يكتبُ على ورقةٍ صفراء…", "start": 346.3, "end": 350.83, "words": [["ثم", 346.3, 346.53], ["ترى", 346.65, 346.84], ["رجلاً", 346.91, 347.31], ["يجلسُ", 347.37, 347.77], ["متربّعاً،", 347.81, 348.6], ["يكتبُ", 348.69, 349.07], ["على", 349.14, 349.28], ["ورقةٍ", 349.34, 349.76], ["صفراء…", 349.83, 350.83]]}, {"text": "إنه كاتب. ومن أهمِّ الناسِ في مصر.", "start": 353.23, "end": 356.2, "words": [["إنه", 353.23, 353.54], ["كاتب.", 353.66, 354.13], ["ومن", 354.44, 354.71], ["أهمِّ", 354.78, 355.19], ["الناسِ", 355.21, 355.56], ["في", 355.62, 355.68], ["مصر.", 355.76, 356.2]]}, {"text": "لأن القراءةَ والكتابةَ لم يعرفْها إلا قليلٌ جداً من الناس.", "start": 356.51, "end": 360.84, "words": [["لأن", 356.51, 356.77], ["القراءةَ", 356.8, 357.34], ["والكتابةَ", 357.38, 358.11], ["لم", 358.31, 358.54], ["يعرفْها", 358.61, 359.07], ["إلا", 359.15, 359.34], ["قليلٌ", 359.41, 359.74], ["جداً", 359.8, 360.12], ["من", 360.17, 360.28], ["الناس.", 360.34, 360.84]]}, {"text": "الكتابةُ الهيروغليفيّة فيها مئاتُ العلامات: صورُ طيورٍ وعيونٍ وأيدٍ، بعضُها حرف، وبعضُها كلمةٌ كاملة.", "start": 361.16, "end": 369.36, "words": [["الكتابةُ", 361.16, 361.72], ["الهيروغليفيّة", 361.75, 362.65], ["فيها", 362.79, 363.07], ["مئاتُ", 363.13, 363.43], ["العلامات:", 363.45, 364.09], ["صورُ", 364.46, 364.8], ["طيورٍ", 364.88, 365.3], ["وعيونٍ", 365.33, 365.75], ["وأيدٍ،", 365.82, 366.44], ["بعضُها", 366.65, 367.08], ["حرف،", 367.15, 367.6], ["وبعضُها", 367.77, 368.26], ["كلمةٌ", 368.33, 368.76], ["كاملة.", 368.83, 369.36]]}, {"text": "والكاتبُ يحسبُ كلَّ شيء: كم رغيفاً أخذَ العمّال، وكم حجراً وصل، وكم يدفعُ الفلّاحُ من محصولِه ضريبة.", "start": 369.68, "end": 378.56, "words": [["والكاتبُ", 369.68, 370.25], ["يحسبُ", 370.32, 370.73], ["كلَّ", 370.8, 371.01], ["شيء:", 371.08, 371.51], ["كم", 371.95, 372.14], ["رغيفاً", 372.23, 372.73], ["أخذَ", 372.81, 373.14], ["العمّال،", 373.16, 373.9], ["وكم", 374.23, 374.58], ["حجراً", 374.67, 375.06], ["وصل،", 375.11, 375.69], ["وكم", 375.87, 376.21], ["يدفعُ", 376.28, 376.67], ["الفلّاحُ", 376.69, 377.26], ["من", 377.3, 377.4], ["محصولِه", 377.44, 377.94], ["ضريبة.", 378.02, 378.56]]}, {"text": "لو كنتَ تعرفُ القراءةَ والحساب، لكنتَ هنا… من الأغنياء.", "start": 378.94, "end": 383.68, "words": [["لو", 378.94, 379.09], ["كنتَ", 379.15, 379.39], ["تعرفُ", 379.46, 379.84], ["القراءةَ", 379.86, 380.38], ["والحساب،", 380.43, 381.17], ["لكنتَ", 381.45, 381.87], ["هنا…", 381.93, 382.49], ["من", 382.77, 382.92], ["الأغنياء.", 382.98, 383.68]]}, {"text": "والآن، الشمسُ تغيب.", "start": 384.0, "end": 385.73, "words": [["والآن،", 384.0, 384.42], ["الشمسُ", 384.47, 384.85], ["تغيب.", 384.91, 385.73]]}, {"text": "يعودُ العمّالُ إلى القرية. رائحةُ السمكِ المشويّ، والبصل، والخبزِ الساخن.", "start": 388.13, "end": 393.52, "words": [["يعودُ", 388.13, 388.56], ["العمّالُ", 388.59, 389.11], ["إلى", 389.13, 389.24], ["القرية.", 389.27, 389.82], ["رائحةُ", 390.06, 390.54], ["السمكِ", 390.57, 390.98], ["المشويّ،", 391.0, 391.72], ["والبصل،", 391.87, 392.46], ["والخبزِ", 392.49, 392.89], ["الساخن.", 392.92, 393.52]]}, {"text": "وأمامَ أحدِ البيوت، رجلان يلعبان على لوحٍ من ثلاثينَ مربّعاً: لعبةُ «سِنِت»، من أقدمِ ألعابِ اللوحِ في التاريخ.", "start": 393.85, "end": 402.11, "words": [["وأمامَ", 393.85, 394.37], ["أحدِ", 394.41, 394.75], ["البيوت،", 394.79, 395.31], ["رجلان", 395.4, 395.87], ["يلعبان", 395.9, 396.39], ["على", 396.47, 396.62], ["لوحٍ", 396.68, 396.97], ["من", 397.02, 397.1], ["ثلاثينَ", 397.14, 397.57], ["مربّعاً:", 397.62, 398.27], ["لعبةُ", 398.65, 399.17], ["«سِنِت»،", 399.2, 399.84], ["من", 400.01, 400.16], ["أقدمِ", 400.21, 400.63], ["ألعابِ", 400.66, 401.03], ["اللوحِ", 401.06, 401.42], ["في", 401.45, 401.51], ["التاريخ.", 401.54, 402.11]]}, {"text": "تصعدُ إلى السطحِ لتنام. لا يوجدُ أيُّ ضوءٍ صناعيّ، والنجومُ بالآلاف.", "start": 402.55, "end": 407.77, "words": [["تصعدُ", 402.55, 402.99], ["إلى", 403.04, 403.17], ["السطحِ", 403.19, 403.56], ["لتنام.", 403.6, 404.26], ["لا", 404.5, 404.63], ["يوجدُ", 404.7, 405.04], ["أيُّ", 405.1, 405.33], ["ضوءٍ", 405.36, 405.61], ["صناعيّ،", 405.68, 406.36], ["والنجومُ", 406.56, 407.1], ["بالآلاف.", 407.15, 407.77]]}, {"text": "وفي آخرِ الليل، تُشرقُ الشِّعْرى… النجمُ الذي يُعلِنُ فيضانَ النيل.", "start": 408.08, "end": 413.21, "words": [["وفي", 408.08, 408.31], ["آخرِ", 408.38, 408.68], ["الليل،", 408.72, 409.24], ["تُشرقُ", 409.44, 409.93], ["الشِّعْرى…", 409.94, 410.69], ["النجمُ", 411.05, 411.49], ["الذي", 411.52, 411.83], ["يُعلِنُ", 411.92, 412.31], ["فيضانَ", 412.36, 412.76], ["النيل.", 412.78, 413.21]]}, {"text": "لكن قبلَ أن تنام، تذكّرْ: الحياةُ هنا قاسية. متوسّطُ العمرِ نحوُ ثلاثينَ سنة، لأن كثيراً من الأطفالِ لا يكبرون.", "start": 413.52, "end": 422.23, "words": [["لكن", 413.52, 413.8], ["قبلَ", 413.87, 414.11], ["أن", 414.15, 414.22], ["تنام،", 414.27, 414.76], ["تذكّرْ:", 414.92, 415.59], ["الحياةُ", 416.01, 416.49], ["هنا", 416.54, 416.72], ["قاسية.", 416.82, 417.36], ["متوسّطُ", 417.67, 418.32], ["العمرِ", 418.34, 418.67], ["نحوُ", 418.7, 418.94], ["ثلاثينَ", 418.99, 419.45], ["سنة،", 419.52, 419.99], ["لأن", 420.19, 420.44], ["كثيراً", 420.56, 420.92], ["من", 420.94, 421.04], ["الأطفالِ", 421.08, 421.51], ["لا", 421.56, 421.63], ["يكبرون.", 421.66, 422.23]]}, {"text": "ومن يتجاوزُ طفولتَه، قد يعيشُ أربعينَ أو خمسينَ سنة… أو أكثر.", "start": 422.62, "end": 428.49, "words": [["ومن", 422.62, 422.92], ["يتجاوزُ", 422.99, 423.64], ["طفولتَه،", 423.68, 424.4], ["قد", 424.73, 424.94], ["يعيشُ", 425.0, 425.36], ["أربعينَ", 425.4, 425.92], ["أو", 425.97, 426.09], ["خمسينَ", 426.16, 426.61], ["سنة…", 426.68, 427.14], ["أو", 427.47, 427.63], ["أكثر.", 427.7, 428.49]]}, {"text": "والآن، السرُّ الذي وعدتُك به.", "start": 430.89, "end": 433.49, "words": [["والآن،", 430.89, 431.52], ["السرُّ", 431.67, 432.18], ["الذي", 432.2, 432.5], ["وعدتُك", 432.6, 433.05], ["به.", 433.15, 433.49]]}, {"text": "هذا الهرمُ الذي رأيتَه يُبنى اليوم، سيبقى أطولَ بناءٍ صنعَه الإنسانُ على الأرض، نحوَ ثلاثةِ آلافٍ وثمانِمئةِ سنة.", "start": 433.8, "end": 442.22, "words": [["هذا", 433.8, 434.04], ["الهرمُ", 434.07, 434.44], ["الذي", 434.47, 434.74], ["رأيتَه", 434.81, 435.21], ["يُبنى", 435.29, 435.58], ["اليوم،", 435.6, 436.18], ["سيبقى", 436.43, 436.88], ["أطولَ", 436.9, 437.27], ["بناءٍ", 437.33, 437.7], ["صنعَه", 437.79, 438.12], ["الإنسانُ", 438.18, 438.61], ["على", 438.66, 438.76], ["الأرض،", 438.8, 439.31], ["نحوَ", 439.52, 439.83], ["ثلاثةِ", 439.89, 440.37], ["آلافٍ", 440.46, 440.93], ["وثمانِمئةِ", 441.06, 441.8], ["سنة.", 441.85, 442.22]]}, {"text": "وهو قديمٌ إلى درجةِ أن الملكةَ كليوباترا، التي حكمَت مصرَ نفسَها، كانت أقربَ زمنياً إلى هبوطِ الإنسانِ على القمر… منها إلى بناءِ هذا الهرم.", "start": 442.65, "end": 453.33, "words": [["وهو", 442.65, 442.87], ["قديمٌ", 443.02, 443.41], ["إلى", 443.47, 443.61], ["درجةِ", 443.68, 444.14], ["أن", 444.19, 444.37], ["الملكةَ", 444.43, 444.94], ["كليوباترا،", 445.01, 445.84], ["التي", 446.04, 446.32], ["حكمَت", 446.39, 446.78], ["مصرَ", 446.85, 447.13], ["نفسَها،", 447.17, 447.83], ["كانت", 448.03, 448.32], ["أقربَ", 448.37, 448.78], ["زمنياً", 448.84, 449.37], ["إلى", 449.45, 449.62], ["هبوطِ", 449.69, 450.02], ["الإنسانِ", 450.05, 450.52], ["على", 450.58, 450.67], ["القمر…", 450.7, 451.29], ["منها", 451.61, 451.95], ["إلى", 452.02, 452.17], ["بناءِ", 452.24, 452.58], ["هذا", 452.62, 452.81], ["الهرم.", 452.83, 453.33]]}, {"text": "تخيّلْ: حتى الفراعنةُ كانوا يرونه أثراً قديماً.", "start": 453.61, "end": 457.15, "words": [["تخيّلْ:", 453.61, 454.26], ["حتى", 454.41, 454.69], ["الفراعنةُ", 454.71, 455.32], ["كانوا", 455.4, 455.62], ["يرونه", 455.64, 456.1], ["أثراً", 456.21, 456.56], ["قديماً.", 456.62, 457.15]]}, {"text": "فلو عشتَ يوماً واحداً هنا… هل كنتَ ستنجو؟ أم تعودُ مسرعاً إلى زمنِك؟", "start": 457.48, "end": 462.68, "words": [["فلو", 457.48, 457.76], ["عشتَ", 457.79, 458.05], ["يوماً", 458.09, 458.36], ["واحداً", 458.42, 458.81], ["هنا…", 458.85, 459.26], ["هل", 459.54, 459.73], ["كنتَ", 459.78, 460.01], ["ستنجو؟", 460.07, 460.7], ["أم", 460.86, 460.99], ["تعودُ", 461.06, 461.41], ["مسرعاً", 461.46, 461.9], ["إلى", 461.93, 462.05], ["زمنِك؟", 462.13, 462.68]]}, {"text": "اكتبْ جوابَك في التعليقات، وأيَّ زمنٍ تريدُ أن نزورَه في الفيديو القادم.", "start": 462.92, "end": 467.86, "words": [["اكتبْ", 462.92, 463.3], ["جوابَك", 463.34, 463.79], ["في", 463.91, 463.97], ["التعليقات،", 463.99, 464.79], ["وأيَّ", 465.0, 465.38], ["زمنٍ", 465.43, 465.74], ["تريدُ", 465.81, 466.13], ["أن", 466.18, 466.28], ["نزورَه", 466.32, 466.79], ["في", 466.86, 466.93], ["الفيديو", 466.95, 467.28], ["القادم.", 467.3, 467.86]]}, {"text": "واشتركْ في القناة، حتى لا يفوتَك.", "start": 468.13, "end": 470.78, "words": [["واشتركْ", 468.13, 468.68], ["في", 468.7, 468.75], ["القناة،", 468.78, 469.35], ["حتى", 469.53, 469.82], ["لا", 469.88, 469.95], ["يفوتَك.", 469.99, 470.78]]}]