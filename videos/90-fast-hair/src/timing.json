[{"text": "ماذا لو نما شعرُك فجأةً أسرعَ بمئةِ مرّة؟", "start": 0.0, "end": 3.24, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.45], ["نما", 0.51, 0.73], ["شعرُك", 0.85, 1.21], ["فجأةً", 1.25, 1.75], ["أسرعَ", 1.87, 2.32], ["بمئةِ", 2.35, 2.76], ["مرّة؟", 2.81, 3.24]]}, {"text": "اليوم ينمو شعرُ الرأسِ نحوَ سنتيمترٍ واحدٍ في الشهر، أي أقلَّ من نصفِ مليمترٍ يومياً.", "start": 3.74, "end": 9.91, "words": [["اليوم", 3.74, 4.08], ["ينمو", 4.11, 4.34], ["شعرُ", 4.42, 4.69], ["الرأسِ", 4.71, 5.12], ["نحوَ", 5.19, 5.46], ["سنتيمترٍ", 5.49, 6.13], ["واحدٍ", 6.19, 6.53], ["في", 6.58, 6.65], ["الشهر،", 6.68, 7.19], ["أي", 7.51, 7.7], ["أقلَّ", 7.73, 8.21], ["من", 8.27, 8.36], ["نصفِ", 8.41, 8.72], ["مليمترٍ", 8.77, 9.28], ["يومياً.", 9.32, 9.91]]}, {"text": "لكنْ بمئةِ ضعف، سيطولُ نحوَ أربعةِ سنتيمتراتٍ كلَّ يوم، فيصلُ إلى كتفَيك بعدَ أسبوع.", "start": 10.3, "end": 16.95, "words": [["لكنْ", 10.3, 10.63], ["بمئةِ", 10.66, 11.1], ["ضعف،", 11.17, 11.67], ["سيطولُ", 11.91, 12.46], ["نحوَ", 12.52, 12.78], ["أربعةِ", 12.81, 13.23], ["سنتيمتراتٍ", 13.28, 13.96], ["كلَّ", 14.03, 14.26], ["يوم،", 14.29, 14.65], ["فيصلُ", 14.86, 15.43], ["إلى", 15.48, 15.6], ["كتفَيك", 15.69, 16.1], ["بعدَ", 16.17, 16.38], ["أسبوع.", 16.41, 16.95]]}, {"text": "وبعدَ شهرٍ يصبحُ طولُه نحوَ متر، وبعدَ شهرَينِ يجرُّه خلفَك على الأرض.", "start": 17.28, "end": 23.01, "words": [["وبعدَ", 17.28, 17.69], ["شهرٍ", 17.76, 18.04], ["يصبحُ", 18.09, 18.53], ["طولُه", 18.61, 18.92], ["نحوَ", 19.04, 19.31], ["متر،", 19.34, 19.78], ["وبعدَ", 20.03, 20.42], ["شهرَينِ", 20.49, 20.99], ["يجرُّه", 21.3, 21.84], ["خلفَك", 21.97, 22.3], ["على", 22.41, 22.5], ["الأرض.", 22.54, 23.01]]}, {"text": "وهذا يحدثُ للجميع: اللِّحى تطولُ أيضاً، ويصبحُ قصُّ الشعرِ كلَّ يومٍ عادةً، مثلَ تنظيفِ الأسنان.", "start": 23.37, "end": 30.56, "words": [["وهذا", 23.37, 23.7], ["يحدثُ", 23.73, 24.11], ["للجميع:", 24.16, 24.8], ["اللِّحى", 25.22, 25.57], ["تطولُ", 25.61, 25.91], ["أيضاً،", 25.95, 26.46], ["ويصبحُ", 26.62, 27.12], ["قصُّ", 27.19, 27.5], ["الشعرِ", 27.53, 27.89], ["كلَّ", 27.97, 28.2], ["يومٍ", 28.23, 28.47], ["عادةً،", 28.55, 29.15], ["مثلَ", 29.39, 29.63], ["تنظيفِ", 29.68, 29.99], ["الأسنان.", 30.01, 30.56]]}, {"text": "على رأسِك نحوُ مئةِ ألفِ شعرةٍ من الكيراتين، وستأخذُ نحوَ ثلثِ البروتينِ الذي يحتاجُه جسمُك، فتجوعُ أكثر.", "start": 31.03, "end": 39.21, "words": [["على", 31.03, 31.21], ["رأسِك", 31.27, 31.6], ["نحوُ", 31.71, 32.0], ["مئةِ", 32.05, 32.38], ["ألفِ", 32.43, 32.62], ["شعرةٍ", 32.7, 33.09], ["من", 33.12, 33.23], ["الكيراتين،", 33.27, 34.02], ["وستأخذُ", 34.27, 34.98], ["نحوَ", 35.05, 35.28], ["ثلثِ", 35.34, 35.6], ["البروتينِ", 35.63, 36.34], ["الذي", 36.54, 36.91], ["يحتاجُه", 36.93, 37.42], ["جسمُك،", 37.5, 37.99], ["فتجوعُ", 38.19, 38.71], ["أكثر.", 38.73, 39.21]]}, {"text": "وفي العالمِ كلِّه، سنقصُّ عشراتِ آلافِ الأطنانِ من الشعرِ كلَّ يوم.", "start": 39.55, "end": 44.2, "words": [["وفي", 39.55, 39.75], ["العالمِ", 39.79, 40.15], ["كلِّه،", 40.2, 40.69], ["سنقصُّ", 40.89, 41.47], ["عشراتِ", 41.51, 41.98], ["آلافِ", 42.02, 42.27], ["الأطنانِ", 42.3, 42.69], ["من", 42.74, 42.83], ["الشعرِ", 42.89, 43.38], ["كلَّ", 43.54, 43.8], ["يوم.", 43.84, 44.2]]}, {"text": "والشعرُ قويّ: الشعرةُ تحملُ نحوَ مئةِ غرام، فضفيرةٌ من كلِّ شعرِك تحملُ نظرياً عشرةَ أطنان، أثقلَ من فيل.", "start": 44.49, "end": 52.65, "words": [["والشعرُ", 44.49, 44.94], ["قويّ:", 45.01, 45.56], ["الشعرةُ", 45.76, 46.23], ["تحملُ", 46.29, 46.59], ["نحوَ", 46.65, 46.88], ["مئةِ", 46.93, 47.24], ["غرام،", 47.32, 47.8], ["فضفيرةٌ", 48.03, 48.74], ["من", 48.8, 48.9], ["كلِّ", 48.95, 49.17], ["شعرِك", 49.22, 49.51], ["تحملُ", 49.56, 49.9], ["نظرياً", 49.95, 50.52], ["عشرةَ", 50.62, 50.97], ["أطنان،", 51.0, 51.5], ["أثقلَ", 51.7, 52.08], ["من", 52.12, 52.21], ["فيل.", 52.27, 52.65]]}, {"text": "والمفاجأة؟ الشعرةُ تنمو بضعَ سنواتٍ ثم تسقط، لكنْ بهذه السرعة، قد تبلغُ قبلَ سقوطِها عشراتِ الأمتار، كمبنى من عشرةِ طوابق!", "start": 52.95, "end": 62.97, "words": [["والمفاجأة؟", 52.95, 53.77], ["الشعرةُ", 54.07, 54.53], ["تنمو", 54.59, 54.83], ["بضعَ", 54.87, 55.11], ["سنواتٍ", 55.15, 55.62], ["ثم", 55.68, 55.83], ["تسقط،", 55.91, 56.49], ["لكنْ", 56.82, 57.13], ["بهذه", 57.17, 57.56], ["السرعة،", 57.6, 58.2], ["قد", 58.38, 58.54], ["تبلغُ", 58.57, 58.95], ["قبلَ", 59.02, 59.26], ["سقوطِها", 59.31, 59.83], ["عشراتِ", 59.85, 60.28], ["الأمتار،", 60.3, 61.0], ["كمبنى", 61.21, 61.7], ["من", 61.77, 61.87], ["عشرةِ", 61.93, 62.29], ["طوابق!", 62.36, 62.97]]}, {"text": "هل ستقصُّه كلَّ يوم أم تتركُه يطول؟ اكتبْ في التعليقات، واشتركْ.", "start": 63.3, "end": 68.27, "words": [["هل", 63.3, 63.47], ["ستقصُّه", 63.53, 64.12], ["كلَّ", 64.19, 64.41], ["يوم", 64.47, 64.7], ["أم", 64.76, 64.86], ["تتركُه", 64.92, 65.34], ["يطول؟", 65.4, 65.96], ["اكتبْ", 66.28, 66.65], ["في", 66.68, 66.75], ["التعليقات،", 66.77, 67.44], ["واشتركْ.", 67.47, 68.27]]}]