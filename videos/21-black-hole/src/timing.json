[{"text": "ماذا لو ظهرَ ثقبٌ أسودُ بحجمِ حبّةِ عنبٍ في وسطِ مدينة؟", "start": 0.0, "end": 4.1, "words": [["ماذا", 0.0, 0.31], ["لو", 0.35, 0.43], ["ظهرَ", 0.49, 0.77], ["ثقبٌ", 0.82, 1.15], ["أسودُ", 1.21, 1.61], ["بحجمِ", 1.66, 2.08], ["حبّةِ", 2.14, 2.48], ["عنبٍ", 2.57, 2.96], ["في", 3.03, 3.11], ["وسطِ", 3.19, 3.48], ["مدينة؟", 3.54, 4.1]]}, {"text": "لا تستهِنْ بحجمِه… فكتلتُه تساوي كتلةَ الأرضِ كلِّها.", "start": 4.54, "end": 8.71, "words": [["لا", 4.54, 4.66], ["تستهِنْ", 4.71, 5.12], ["بحجمِه…", 5.16, 5.77], ["فكتلتُه", 6.15, 6.79], ["تساوي", 6.88, 7.28], ["كتلةَ", 7.34, 7.69], ["الأرضِ", 7.71, 8.06], ["كلِّها.", 8.13, 8.71]]}, {"text": "على بُعدِ كيلومترٍ واحد، جاذبيّتُه أقوى من جاذبيّةِ الأرضِ بأربعينَ مليونَ مرّة.", "start": 9.3, "end": 15.35, "words": [["على", 9.3, 9.48], ["بُعدِ", 9.55, 9.81], ["كيلومترٍ", 9.88, 10.38], ["واحد،", 10.45, 11.01], ["جاذبيّتُه", 11.21, 12.01], ["أقوى", 12.16, 12.49], ["من", 12.52, 12.6], ["جاذبيّةِ", 12.65, 13.18], ["الأرضِ", 13.2, 13.69], ["بأربعينَ", 13.86, 14.51], ["مليونَ", 14.56, 14.87], ["مرّة.", 14.91, 15.35]]}, {"text": "الهواءُ والمباني والصخورُ تنهمرُ نحوه بسرعةٍ هائلة، وتسخنُ حتى تتوهّج.", "start": 15.94, "end": 21.57, "words": [["الهواءُ", 15.94, 16.41], ["والمباني", 16.44, 16.95], ["والصخورُ", 17.0, 17.51], ["تنهمرُ", 17.55, 18.02], ["نحوه", 18.07, 18.38], ["بسرعةٍ", 18.5, 19.01], ["هائلة،", 19.06, 19.68], ["وتسخنُ", 19.88, 20.45], ["حتى", 20.52, 20.76], ["تتوهّج.", 20.83, 21.57]]}, {"text": "وحتى الضوءُ القريبُ منه ينحني… فترى السماءَ ملتويةً حولَه كالعدسة.", "start": 21.9, "end": 27.38, "words": [["وحتى", 21.9, 22.28], ["الضوءُ", 22.3, 22.65], ["القريبُ", 22.68, 23.13], ["منه", 23.17, 23.39], ["ينحني…", 23.46, 24.1], ["فترى", 24.47, 24.8], ["السماءَ", 24.82, 25.25], ["ملتويةً", 25.3, 26.01], ["حولَه", 26.1, 26.52], ["كالعدسة.", 26.63, 27.38]]}, {"text": "ثمّ يغوصُ نحوَ مركزِ الأرض، والكوكبُ كلُّه ينهارُ حولَه… وتنتهي الأرضُ كما نعرفُها.", "start": 27.7, "end": 33.82, "words": [["ثمّ", 27.7, 27.96], ["يغوصُ", 28.0, 28.36], ["نحوَ", 28.4, 28.62], ["مركزِ", 28.66, 29.01], ["الأرض،", 29.05, 29.58], ["والكوكبُ", 29.76, 30.36], ["كلُّه", 30.41, 30.71], ["ينهارُ", 30.79, 31.15], ["حولَه…", 31.22, 31.71], ["وتنتهي", 31.95, 32.53], ["الأرضُ", 32.55, 32.91], ["كما", 32.97, 33.15], ["نعرفُها.", 33.2, 33.82]]}, {"text": "والغريب؟ لو تحوّلتِ الشمسُ نفسُها إلى ثقبٍ أسودَ بنفسِ كتلتِها، لبقيتِ الأرضُ في مدارِها تماماً.", "start": 34.19, "end": 41.7, "words": [["والغريب؟", 34.19, 34.89], ["لو", 35.21, 35.34], ["تحوّلتِ", 35.39, 35.93], ["الشمسُ", 35.96, 36.33], ["نفسُها", 36.39, 36.78], ["إلى", 36.84, 36.98], ["ثقبٍ", 37.04, 37.36], ["أسودَ", 37.4, 37.84], ["بنفسِ", 37.88, 38.22], ["كتلتِها،", 38.3, 39.16], ["لبقيتِ", 39.39, 39.86], ["الأرضُ", 39.88, 40.29], ["في", 40.37, 40.45], ["مدارِها", 40.52, 40.99], ["تماماً.", 41.06, 41.7]]}, {"text": "سيكونُ قطرُه ستّةَ كيلومتراتٍ فقط… لكنّنا سنتجمّدُ في الظلام.", "start": 42.15, "end": 47.32, "words": [["سيكونُ", 42.15, 42.64], ["قطرُه", 42.7, 43.09], ["ستّةَ", 43.16, 43.57], ["كيلومتراتٍ", 43.65, 44.27], ["فقط…", 44.33, 44.91], ["لكنّنا", 45.23, 45.72], ["سنتجمّدُ", 45.79, 46.55], ["في", 46.6, 46.66], ["الظلام.", 46.68, 47.32]]}, {"text": "أقربُ ثقبٍ أسودَ نعرفُه يبعدُ نحوَ ألفٍ وخمسمئةِ سنةٍ ضوئيّة… فلا داعيَ للقلق.", "start": 47.65, "end": 54.9, "words": [["أقربُ", 47.65, 48.1], ["ثقبٍ", 48.16, 48.53], ["أسودَ", 48.56, 49.03], ["نعرفُه", 49.1, 49.76], ["يبعدُ", 50.14, 50.64], ["نحوَ", 50.71, 50.99], ["ألفٍ", 51.04, 51.39], ["وخمسمئةِ", 51.46, 52.22], ["سنةٍ", 52.29, 52.64], ["ضوئيّة…", 52.7, 53.31], ["فلا", 53.64, 53.89], ["داعيَ", 53.95, 54.25], ["للقلق.", 54.29, 54.9]]}, {"text": "اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 55.23, "end": 59.21, "words": [["اكتبْ", 55.23, 55.62], ["سؤالَك", 55.65, 56.05], ["في", 56.17, 56.24], ["التعليقات،", 56.26, 57.08], ["وقد", 57.28, 57.62], ["يكونُ", 57.7, 58.05], ["الفيديو", 58.07, 58.4], ["القادم.", 58.42, 59.21]]}]