[{"text": "ماذا لو استيقظتَ غداً… وأنتَ آخرُ إنسانٍ على الأرض؟", "start": 0.0, "end": 3.76, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.45], ["استيقظتَ", 0.49, 1.11], ["غداً…", 1.2, 1.71], ["وأنتَ", 1.9, 2.21], ["آخرُ", 2.29, 2.65], ["إنسانٍ", 2.71, 3.1], ["على", 3.17, 3.3], ["الأرض؟", 3.32, 3.76]]}, {"text": "الشوارعُ فارغة، والهواتفُ صامتة، ولا أحدَ يجيبُ في أيِّ مكانٍ في العالم.", "start": 4.24, "end": 9.44, "words": [["الشوارعُ", 4.24, 4.76], ["فارغة،", 4.83, 5.36], ["والهواتفُ", 5.5, 6.14], ["صامتة،", 6.22, 6.78], ["ولا", 6.98, 7.25], ["أحدَ", 7.27, 7.59], ["يجيبُ", 7.65, 8.01], ["في", 8.07, 8.14], ["أيِّ", 8.2, 8.42], ["مكانٍ", 8.45, 8.79], ["في", 8.84, 8.89], ["العالم.", 8.92, 9.44]]}, {"text": "خلالَ يومٍ أو يومين، تتوقّفُ محطّاتُ الكهرباء، فتنطفئُ المدنُ واحدةً بعدَ الأخرى.", "start": 9.85, "end": 16.3, "words": [["خلالَ", 9.85, 10.22], ["يومٍ", 10.29, 10.59], ["أو", 10.65, 10.76], ["يومين،", 10.81, 11.45], ["تتوقّفُ", 11.59, 12.25], ["محطّاتُ", 12.31, 12.83], ["الكهرباء،", 12.86, 13.61], ["فتنطفئُ", 13.8, 14.5], ["المدنُ", 14.52, 15.01], ["واحدةً", 15.09, 15.58], ["بعدَ", 15.62, 15.8], ["الأخرى.", 15.82, 16.3]]}, {"text": "الطعامُ في كلِّ مكان: معلّباتٌ تكفيكَ طوالَ حياتِك.", "start": 16.71, "end": 20.92, "words": [["الطعامُ", 16.71, 17.22], ["في", 17.26, 17.32], ["كلِّ", 17.41, 17.64], ["مكان:", 17.67, 18.18], ["معلّباتٌ", 18.48, 19.23], ["تكفيكَ", 19.39, 19.91], ["طوالَ", 19.97, 20.28], ["حياتِك.", 20.34, 20.92]]}, {"text": "لكنّ الخبزَ يتعفّنُ خلالَ أيّام، والحليبُ يفسدُ بعدَ أسبوع.", "start": 21.3, "end": 25.25, "words": [["لكنّ", 21.3, 21.64], ["الخبزَ", 21.68, 22.02], ["يتعفّنُ", 22.05, 22.56], ["خلالَ", 22.62, 22.89], ["أيّام،", 22.92, 23.46], ["والحليبُ", 23.64, 24.14], ["يفسدُ", 24.18, 24.5], ["بعدَ", 24.53, 24.74], ["أسبوع.", 24.78, 25.25]]}, {"text": "ولكي تعيش، عليكَ أن تجمعَ ماءَ المطر، وتصنعَ النار، وتتعلّمَ الزراعة.", "start": 25.58, "end": 30.65, "words": [["ولكي", 25.58, 25.94], ["تعيش،", 25.98, 26.41], ["عليكَ", 26.46, 26.77], ["أن", 26.8, 26.86], ["تجمعَ", 26.92, 27.3], ["ماءَ", 27.32, 27.49], ["المطر،", 27.52, 28.06], ["وتصنعَ", 28.23, 28.77], ["النار،", 28.79, 29.27], ["وتتعلّمَ", 29.44, 30.04], ["الزراعة.", 30.06, 30.65]]}, {"text": "بعدَ أشهر، تدخلُ الحيواناتُ إلى المدن: غزلانٌ وثعالبُ وذئاب.", "start": 31.03, "end": 35.64, "words": [["بعدَ", 31.03, 31.3], ["أشهر،", 31.34, 31.8], ["تدخلُ", 31.95, 32.31], ["الحيواناتُ", 32.33, 32.93], ["إلى", 32.97, 33.09], ["المدن:", 33.12, 33.67], ["غزلانٌ", 33.91, 34.39], ["وثعالبُ", 34.45, 35.0], ["وذئاب.", 35.04, 35.64]]}, {"text": "وتصبحُ الكلابُ الجائعةُ من أخطرِ ما يهدّدُك.", "start": 35.92, "end": 38.89, "words": [["وتصبحُ", 35.92, 36.54], ["الكلابُ", 36.56, 36.97], ["الجائعةُ", 36.99, 37.6], ["من", 37.65, 37.74], ["أخطرِ", 37.8, 38.16], ["ما", 38.21, 38.27], ["يهدّدُك.", 38.31, 38.89]]}, {"text": "وبعدَ سنواتٍ قليلة، تتشقّقُ الطرق، وتنمو الأشجارُ بينَ السيّارات.", "start": 39.26, "end": 44.41, "words": [["وبعدَ", 39.26, 39.66], ["سنواتٍ", 39.72, 40.16], ["قليلة،", 40.26, 40.84], ["تتشقّقُ", 41.04, 41.7], ["الطرق،", 41.73, 42.27], ["وتنمو", 42.43, 42.9], ["الأشجارُ", 42.92, 43.44], ["بينَ", 43.48, 43.68], ["السيّارات.", 43.7, 44.41]]}, {"text": "لكنّ الخطرَ الأكبرَ ليس الجوعَ ولا الحيوانات… بل الوحدة.", "start": 44.78, "end": 49.45, "words": [["لكنّ", 44.78, 45.15], ["الخطرَ", 45.19, 45.63], ["الأكبرَ", 45.64, 46.31], ["ليس", 46.47, 46.78], ["الجوعَ", 46.85, 47.24], ["ولا", 47.29, 47.46], ["الحيوانات…", 47.47, 48.31], ["بل", 48.62, 48.8], ["الوحدة.", 48.84, 49.45]]}, {"text": "فالعلماءُ وجدوا أنّ العزلةَ الطويلةَ تضرُّ الجسمَ مثلَ تدخينِ خمسَ عشرةَ سيجارةً كلَّ يوم.", "start": 49.76, "end": 56.71, "words": [["فالعلماءُ", 49.76, 50.43], ["وجدوا", 50.48, 50.87], ["أنّ", 50.9, 51.08], ["العزلةَ", 51.11, 51.57], ["الطويلةَ", 51.59, 52.33], ["تضرُّ", 52.5, 52.95], ["الجسمَ", 52.98, 53.48], ["مثلَ", 53.53, 53.78], ["تدخينِ", 53.84, 54.24], ["خمسَ", 54.31, 54.6], ["عشرةَ", 54.66, 55.02], ["سيجارةً", 55.09, 55.69], ["كلَّ", 55.96, 56.26], ["يوم.", 56.31, 56.71]]}, {"text": "والغريب؟ ألواحُ الطاقةِ الشمسيّةِ قد تُبقي بعضَ المصابيحِ مضاءةً لسنوات… لكَ وحدَك.", "start": 56.99, "end": 64.02, "words": [["والغريب؟", 56.99, 57.67], ["ألواحُ", 57.95, 58.38], ["الطاقةِ", 58.4, 58.86], ["الشمسيّةِ", 58.88, 59.63], ["قد", 59.95, 60.13], ["تُبقي", 60.17, 60.46], ["بعضَ", 60.51, 60.76], ["المصابيحِ", 60.78, 61.41], ["مضاءةً", 61.44, 62.01], ["لسنوات…", 62.04, 62.88], ["لكَ", 63.16, 63.41], ["وحدَك.", 63.47, 64.02]]}, {"text": "لو كنتَ آخرَ إنسانٍ على الأرض، ماذا ستفعلُ أوّلاً؟ اكتبْ في التعليقات، واشتركْ.", "start": 64.34, "end": 70.22, "words": [["لو", 64.34, 64.48], ["كنتَ", 64.53, 64.81], ["آخرَ", 64.88, 65.25], ["إنسانٍ", 65.29, 65.72], ["على", 65.81, 65.96], ["الأرض،", 65.99, 66.57], ["ماذا", 66.78, 67.02], ["ستفعلُ", 67.08, 67.57], ["أوّلاً؟", 67.6, 68.1], ["اكتبْ", 68.35, 68.72], ["في", 68.74, 68.8], ["التعليقات،", 68.83, 69.42], ["واشتركْ.", 69.44, 70.22]]}]