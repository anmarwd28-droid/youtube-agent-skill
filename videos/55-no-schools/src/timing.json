[{"text": "ماذا لو اختفت المدارسُ من العالمِ كلِّه؟", "start": 0.0, "end": 2.71, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.43], ["اختفت", 0.45, 0.87], ["المدارسُ", 0.95, 1.56], ["من", 1.59, 1.7], ["العالمِ", 1.75, 2.16], ["كلِّه؟", 2.23, 2.71]]}, {"text": "في صباحٍ واحد، يبقى أكثرُ من مليارٍ ونصفِ طالبٍ في البيوت.", "start": 3.13, "end": 7.59, "words": [["في", 3.13, 3.25], ["صباحٍ", 3.34, 3.73], ["واحد،", 3.79, 4.3], ["يبقى", 4.5, 4.83], ["أكثرُ", 4.85, 5.27], ["من", 5.32, 5.42], ["مليارٍ", 5.48, 6.01], ["ونصفِ", 6.06, 6.42], ["طالبٍ", 6.51, 6.88], ["في", 6.93, 6.99], ["البيوت.", 7.02, 7.59]]}, {"text": "وهذا حدثَ فعلاً عامَ ألفينِ وعشرين، حينَ أغلقت أغلبُ دولِ العالمِ مدارسَها بسببِ كورونا.", "start": 7.96, "end": 15.06, "words": [["وهذا", 7.96, 8.34], ["حدثَ", 8.39, 8.72], ["فعلاً", 8.79, 9.21], ["عامَ", 9.52, 9.79], ["ألفينِ", 9.83, 10.22], ["وعشرين،", 10.25, 10.91], ["حينَ", 11.08, 11.34], ["أغلقت", 11.4, 11.9], ["أغلبُ", 11.97, 12.33], ["دولِ", 12.39, 12.63], ["العالمِ", 12.65, 13.07], ["مدارسَها", 13.13, 13.83], ["بسببِ", 14.04, 14.5], ["كورونا.", 14.57, 15.06]]}, {"text": "لكن لو اختفت إلى الأبد، سنعودُ إلى زمنٍ قبلَ أوّلِ مدرسة، قبلَ أكثرَ من أربعةِ آلافِ عام.", "start": 15.49, "end": 21.99, "words": [["لكن", 15.49, 15.78], ["لو", 15.81, 15.96], ["اختفت", 16.0, 16.39], ["إلى", 16.44, 16.57], ["الأبد،", 16.6, 17.15], ["سنعودُ", 17.32, 17.82], ["إلى", 17.87, 17.98], ["زمنٍ", 18.07, 18.41], ["قبلَ", 18.53, 18.79], ["أوّلِ", 18.84, 19.13], ["مدرسة،", 19.18, 19.8], ["قبلَ", 20.0, 20.27], ["أكثرَ", 20.31, 20.65], ["من", 20.7, 20.78], ["أربعةِ", 20.82, 21.23], ["آلافِ", 21.28, 21.55], ["عام.", 21.62, 21.99]]}, {"text": "يومَها تعلّمَ الأطفالُ بالتقليدِ فقط: من آبائِهم، ومن الحكاياتِ حولَ النار.", "start": 22.37, "end": 27.68, "words": [["يومَها", 22.37, 22.79], ["تعلّمَ", 22.86, 23.24], ["الأطفالُ", 23.27, 23.72], ["بالتقليدِ", 23.77, 24.25], ["فقط:", 24.3, 24.78], ["من", 25.1, 25.24], ["آبائِهم،", 25.31, 26.01], ["ومن", 26.05, 26.3], ["الحكاياتِ", 26.35, 26.95], ["حولَ", 27.0, 27.2], ["النار.", 27.24, 27.68]]}, {"text": "ثمّ في سومر، ظهرَ بيتُ الألواح، أوّلُ مدرسةٍ نعرفُها، يتعلّمُ فيه الأولادُ الكتابةَ المِسماريّة.", "start": 28.06, "end": 35.35, "words": [["ثمّ", 28.06, 28.33], ["في", 28.39, 28.47], ["سومر،", 28.56, 29.12], ["ظهرَ", 29.29, 29.64], ["بيتُ", 29.7, 29.93], ["الألواح،", 29.96, 30.63], ["أوّلُ", 30.8, 31.15], ["مدرسةٍ", 31.2, 31.68], ["نعرفُها،", 31.73, 32.43], ["يتعلّمُ", 32.63, 33.18], ["فيه", 33.23, 33.39], ["الأولادُ", 33.44, 33.9], ["الكتابةَ", 33.92, 34.52], ["المِسماريّة.", 34.54, 35.35]]}, {"text": "بلا مدارس، تبقى القراءةُ سرّاً عندَ قلّة. عامَ ألفٍ وثمانِمئةٍ وعشرين، كان اثنا عشرَ بالمئةِ فقط من البشرِ يقرؤون، واليومَ نحوُ سبعةٍ وثمانين.", "start": 35.73, "end": 46.59, "words": [["بلا", 35.73, 35.95], ["مدارس،", 36.01, 36.54], ["تبقى", 36.57, 36.87], ["القراءةُ", 36.9, 37.48], ["سرّاً", 37.56, 37.88], ["عندَ", 37.94, 38.14], ["قلّة.", 38.21, 38.59], ["عامَ", 38.77, 39.07], ["ألفٍ", 39.1, 39.39], ["وثمانِمئةٍ", 39.45, 40.17], ["وعشرين،", 40.24, 40.95], ["كان", 41.19, 41.41], ["اثنا", 41.45, 41.66], ["عشرَ", 41.74, 42.06], ["بالمئةِ", 42.11, 42.56], ["فقط", 42.63, 42.93], ["من", 42.99, 43.08], ["البشرِ", 43.14, 43.58], ["يقرؤون،", 43.61, 44.29], ["واليومَ", 44.62, 45.06], ["نحوُ", 45.09, 45.34], ["سبعةٍ", 45.41, 45.81], ["وثمانين.", 45.88, 46.59]]}, {"text": "ولن تجدَ طبيباً ولا مهندساً: الطبيبُ يدرسُ نحوَ ثمانيةَ عشرَ عاماً قبلَ أن يعالجَك.", "start": 46.91, "end": 52.91, "words": [["ولن", 46.91, 47.19], ["تجدَ", 47.25, 47.58], ["طبيباً", 47.65, 48.05], ["ولا", 48.09, 48.24], ["مهندساً:", 48.3, 48.97], ["الطبيبُ", 49.3, 49.8], ["يدرسُ", 49.84, 50.21], ["نحوَ", 50.26, 50.48], ["ثمانيةَ", 50.54, 51.01], ["عشرَ", 51.07, 51.42], ["عاماً", 51.47, 51.77], ["قبلَ", 51.84, 52.09], ["أن", 52.12, 52.16], ["يعالجَك.", 52.23, 52.91]]}, {"text": "والأخطر: نصفُ الانخفاضِ في وَفَيَاتِ الأطفالِ منذُ عامِ ألفٍ وتسعِمئةٍ وسبعين، يعودُ إلى تعليمِ الأمّهات.", "start": 53.23, "end": 60.81, "words": [["والأخطر:", 53.23, 53.91], ["نصفُ", 54.11, 54.4], ["الانخفاضِ", 54.44, 55.09], ["في", 55.15, 55.22], ["وَفَيَاتِ", 55.29, 55.7], ["الأطفالِ", 55.73, 56.35], ["منذُ", 56.51, 56.82], ["عامِ", 56.89, 57.12], ["ألفٍ", 57.17, 57.47], ["وتسعِمئةٍ", 57.53, 58.16], ["وسبعين،", 58.22, 58.92], ["يعودُ", 59.23, 59.6], ["إلى", 59.65, 59.78], ["تعليمِ", 59.86, 60.16], ["الأمّهات.", 60.19, 60.81]]}, {"text": "وستبقى المعرفةُ في عائلاتٍ قليلة، وقد يموتُ كلُّ اكتشافٍ مع صاحبِه.", "start": 61.13, "end": 66.25, "words": [["وستبقى", 61.13, 61.67], ["المعرفةُ", 61.68, 62.26], ["في", 62.34, 62.4], ["عائلاتٍ", 62.5, 62.88], ["قليلة،", 62.95, 63.55], ["وقد", 63.73, 64.06], ["يموتُ", 64.13, 64.46], ["كلُّ", 64.54, 64.8], ["اكتشافٍ", 64.82, 65.39], ["مع", 65.44, 65.56], ["صاحبِه.", 65.68, 66.25]]}, {"text": "لكنّ المفاجأة: كلمةُ مدرسة في لغاتِ أوروبا، مثل سْكُول، أصلُها يونانيّ، ومعناها: وقتُ الفراغ!", "start": 66.62, "end": 74.7, "words": [["لكنّ", 66.62, 67.0], ["المفاجأة:", 67.02, 67.83], ["كلمةُ", 68.03, 68.55], ["مدرسة", 68.6, 69.02], ["في", 69.06, 69.14], ["لغاتِ", 69.19, 69.57], ["أوروبا،", 69.61, 70.16], ["مثل", 70.33, 70.6], ["سْكُول،", 70.66, 71.3], ["أصلُها", 71.46, 71.91], ["يونانيّ،", 71.96, 72.57], ["ومعناها:", 72.75, 73.55], ["وقتُ", 73.67, 73.99], ["الفراغ!", 74.03, 74.7]]}, {"text": "فالتعليمُ بدأَ عندَ مَن لديه وقتٌ ليفكّر، ثمّ صارَ حقّاً لكلِّ طفل.", "start": 74.98, "end": 80.26, "words": [["فالتعليمُ", 74.98, 75.58], ["بدأَ", 75.63, 75.92], ["عندَ", 75.95, 76.24], ["مَن", 76.3, 76.42], ["لديه", 76.47, 76.86], ["وقتٌ", 76.97, 77.3], ["ليفكّر،", 77.36, 78.14], ["ثمّ", 78.38, 78.62], ["صارَ", 78.72, 78.94], ["حقّاً", 79.0, 79.35], ["لكلِّ", 79.41, 79.75], ["طفل.", 79.8, 80.26]]}, {"text": "برأيك، ما أهمُّ شيءٍ تعلّمتَه في المدرسة؟ اكتبْ في التعليقات، واشتركْ.", "start": 80.64, "end": 86.24, "words": [["برأيك،", 80.64, 81.21], ["ما", 81.23, 81.34], ["أهمُّ", 81.39, 81.72], ["شيءٍ", 81.77, 82.11], ["تعلّمتَه", 82.19, 82.73], ["في", 82.81, 82.88], ["المدرسة؟", 82.92, 83.56], ["اكتبْ", 83.77, 84.19], ["في", 84.22, 84.29], ["التعليقات،", 84.32, 85.22], ["واشتركْ.", 85.37, 86.24]]}]