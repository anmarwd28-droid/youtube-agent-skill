[{"text": "ماذا لو انتشرَ فيروسٌ يحوّلُ البشرَ إلى زومبي؟", "start": 0.0, "end": 3.03, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.42], ["انتشرَ", 0.45, 0.92], ["فيروسٌ", 0.97, 1.46], ["يحوّلُ", 1.52, 1.96], ["البشرَ", 1.97, 2.38], ["إلى", 2.4, 2.53], ["زومبي؟", 2.59, 3.03]]}, {"text": "الفكرةُ ليستْ خيالاً تماماً: في الغاباتِ فطرٌ يسيطرُ على النمل، فيتسلّقُ النملُ ورقةً، ويعضُّها، ويموتُ هناك.", "start": 3.45, "end": 12.13, "words": [["الفكرةُ", 3.45, 3.92], ["ليستْ", 3.98, 4.46], ["خيالاً", 4.54, 4.97], ["تماماً:", 5.02, 5.56], ["في", 5.72, 5.83], ["الغاباتِ", 5.86, 6.38], ["فطرٌ", 6.42, 6.77], ["يسيطرُ", 6.83, 7.25], ["على", 7.31, 7.43], ["النمل،", 7.46, 7.99], ["فيتسلّقُ", 8.19, 8.96], ["النملُ", 8.97, 9.32], ["ورقةً،", 9.37, 10.02], ["ويعضُّها،", 10.1, 10.96], ["ويموتُ", 11.12, 11.67], ["هناك.", 11.7, 12.13]]}, {"text": "وعندَ البشرِ فيروسٌ قريب: داءُ الكَلَب. يهاجمُ الدماغ، ويسبّبُ الهياجَ والعدوانيّة، وينتقلُ بالعَضّ.", "start": 12.45, "end": 20.43, "words": [["وعندَ", 12.45, 12.81], ["البشرِ", 12.84, 13.28], ["فيروسٌ", 13.34, 13.73], ["قريب:", 13.82, 14.3], ["داءُ", 14.61, 14.86], ["الكَلَب.", 14.88, 15.39], ["يهاجمُ", 15.66, 16.16], ["الدماغ،", 16.17, 16.83], ["ويسبّبُ", 17.0, 17.74], ["الهياجَ", 17.76, 18.18], ["والعدوانيّة،", 18.22, 19.05], ["وينتقلُ", 19.26, 19.88], ["بالعَضّ.", 19.92, 20.43]]}, {"text": "تخيّلْ أنّه بدأَ بشخصٍ واحد، وكلُّ مصابٍ يعضُّ شخصاً واحداً كلَّ يوم: العددُ يتضاعفُ يوميّاً.", "start": 20.79, "end": 28.14, "words": [["تخيّلْ", 20.79, 21.23], ["أنّه", 21.26, 21.43], ["بدأَ", 21.49, 21.71], ["بشخصٍ", 21.76, 22.2], ["واحد،", 22.27, 22.85], ["وكلُّ", 23.05, 23.45], ["مصابٍ", 23.49, 23.99], ["يعضُّ", 24.04, 24.4], ["شخصاً", 24.44, 24.76], ["واحداً", 24.82, 25.22], ["كلَّ", 25.25, 25.5], ["يوم:", 25.54, 25.94], ["العددُ", 26.24, 26.76], ["يتضاعفُ", 26.82, 27.46], ["يوميّاً.", 27.52, 28.14]]}, {"text": "نظريّاً، بعدَ ثلاثةٍ وثلاثينَ يوماً فقط، يتجاوزُ المصابونَ ثمانيةَ مليارات: كلَّ البشر.", "start": 28.5, "end": 35.31, "words": [["نظريّاً،", 28.5, 29.27], ["بعدَ", 29.41, 29.64], ["ثلاثةٍ", 29.7, 30.16], ["وثلاثينَ", 30.23, 30.75], ["يوماً", 30.81, 31.06], ["فقط،", 31.09, 31.57], ["يتجاوزُ", 31.77, 32.38], ["المصابونَ", 32.4, 32.98], ["ثمانيةَ", 33.06, 33.52], ["مليارات:", 33.56, 34.17], ["كلَّ", 34.47, 34.71], ["البشر.", 34.74, 35.31]]}, {"text": "والطائراتُ تسرّعُه: نحوَ مئةِ ألفِ رحلةٍ كلَّ يوم، تحملُ مصابينَ لم تظهرْ عليهم الأعراضُ بعد.", "start": 35.62, "end": 42.71, "words": [["والطائراتُ", 35.62, 36.28], ["تسرّعُه:", 36.35, 37.06], ["نحوَ", 37.33, 37.65], ["مئةِ", 37.7, 38.01], ["ألفِ", 38.06, 38.27], ["رحلةٍ", 38.34, 38.71], ["كلَّ", 38.79, 39.02], ["يوم،", 39.07, 39.53], ["تحملُ", 39.9, 40.27], ["مصابينَ", 40.32, 40.89], ["لم", 40.92, 41.03], ["تظهرْ", 41.1, 41.45], ["عليهم", 41.47, 41.77], ["الأعراضُ", 41.83, 42.25], ["بعد.", 42.3, 42.71]]}, {"text": "المدنُ المزدحمةُ تسقطُ أوّلاً، في أيّام. أمّا القرى والجبالُ البعيدة، فقد تصمدُ شهوراً.", "start": 43.02, "end": 50.11, "words": [["المدنُ", 43.02, 43.47], ["المزدحمةُ", 43.49, 44.26], ["تسقطُ", 44.56, 44.99], ["أوّلاً،", 45.03, 45.6], ["في", 45.71, 45.88], ["أيّام.", 45.93, 46.52], ["أمّا", 46.72, 46.96], ["القرى", 46.99, 47.32], ["والجبالُ", 47.38, 47.86], ["البعيدة،", 47.89, 48.58], ["فقد", 48.72, 49.02], ["تصمدُ", 49.06, 49.48], ["شهوراً.", 49.54, 50.11]]}, {"text": "ومعَ غيابِ العمّال، تنطفئُ الكهرباءُ والإنترنتُ خلالَ أيّامٍ قليلة.", "start": 50.31, "end": 55.52, "words": [["ومعَ", 50.31, 50.68], ["غيابِ", 50.69, 51.03], ["العمّال،", 51.05, 51.75], ["تنطفئُ", 51.91, 52.48], ["الكهرباءُ", 52.49, 53.06], ["والإنترنتُ", 53.09, 53.86], ["خلالَ", 54.08, 54.49], ["أيّامٍ", 54.53, 54.9], ["قليلة.", 54.98, 55.52]]}, {"text": "والمفاجأة؟ مريضُ الكَلَبِ يخافُ الماء، ولا يستطيعُ شربَه. فزومبي مثلُه لن يعيشَ أكثرَ من أيّامٍ قليلة.", "start": 55.83, "end": 63.61, "words": [["والمفاجأة؟", 55.83, 56.74], ["مريضُ", 57.05, 57.38], ["الكَلَبِ", 57.4, 57.87], ["يخافُ", 57.9, 58.27], ["الماء،", 58.29, 58.75], ["ولا", 58.9, 59.15], ["يستطيعُ", 59.19, 59.65], ["شربَه.", 59.71, 60.21], ["فزومبي", 60.53, 61.08], ["مثلُه", 61.12, 61.46], ["لن", 61.55, 61.66], ["يعيشَ", 61.74, 62.13], ["أكثرَ", 62.16, 62.54], ["من", 62.58, 62.67], ["أيّامٍ", 62.71, 63.04], ["قليلة.", 63.12, 63.61]]}, {"text": "فمن يختبئْ في مكانٍ بعيد، قد يرى الموجةَ تنطفئُ وحدَها.", "start": 63.94, "end": 68.07, "words": [["فمن", 63.94, 64.22], ["يختبئْ", 64.27, 64.7], ["في", 64.73, 64.8], ["مكانٍ", 64.87, 65.21], ["بعيد،", 65.27, 65.79], ["قد", 66.0, 66.18], ["يرى", 66.22, 66.36], ["الموجةَ", 66.39, 66.85], ["تنطفئُ", 66.9, 67.47], ["وحدَها.", 67.5, 68.07]]}, {"text": "ولقاحُ الكَلَبِ موجودٌ منذُ عامِ ألفٍ وثمانِمئةٍ وخمسةٍ وثمانين… فالعلمُ سبقَ الزومبي.", "start": 68.35, "end": 75.12, "words": [["ولقاحُ", 68.35, 68.88], ["الكَلَبِ", 68.91, 69.36], ["موجودٌ", 69.42, 70.0], ["منذُ", 70.15, 70.44], ["عامِ", 70.53, 70.74], ["ألفٍ", 70.79, 71.15], ["وثمانِمئةٍ", 71.22, 71.98], ["وخمسةٍ", 72.05, 72.52], ["وثمانين…", 72.57, 73.29], ["فالعلمُ", 73.62, 74.12], ["سبقَ", 74.19, 74.51], ["الزومبي.", 74.54, 75.12]]}, {"text": "هل كنتَ ستنجو؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 75.4, "end": 80.3, "words": [["هل", 75.4, 75.58], ["كنتَ", 75.65, 75.92], ["ستنجو؟", 75.99, 76.67], ["اكتبْ", 77.0, 77.4], ["جوابَك", 77.43, 77.9], ["في", 78.02, 78.09], ["التعليقات…", 78.11, 78.96], ["واشتركْ.", 79.28, 80.3]]}]