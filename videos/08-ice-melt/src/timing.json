[{"text": "ماذا لو ذابَ كلُّ الجليدِ على الأرض؟", "start": 0.0, "end": 2.39, "words": [["ماذا", 0.0, 0.31], ["لو", 0.36, 0.46], ["ذابَ", 0.51, 0.77], ["كلُّ", 0.82, 1.08], ["الجليدِ", 1.1, 1.58], ["على", 1.64, 1.78], ["الأرض؟", 1.8, 2.39]]}, {"text": "جليدُ القطبين، وغرينلاند، وكلُّ الأنهارِ الجليدية… يتحوّلُ إلى ماء.", "start": 2.82, "end": 8.97, "words": [["جليدُ", 2.82, 3.19], ["القطبين،", 3.22, 4.09], ["وغرينلاند،", 4.17, 5.14], ["وكلُّ", 5.39, 5.9], ["الأنهارِ", 5.92, 6.42], ["الجليدية…", 6.44, 7.31], ["يتحوّلُ", 7.64, 8.34], ["إلى", 8.38, 8.52], ["ماء.", 8.6, 8.97]]}, {"text": "فيرتفعُ مستوى البحارِ نحوَ سبعينَ متراً.", "start": 9.3, "end": 12.2, "words": [["فيرتفعُ", 9.3, 10.01], ["مستوى", 10.05, 10.4], ["البحارِ", 10.43, 10.88], ["نحوَ", 10.94, 11.18], ["سبعينَ", 11.24, 11.64], ["متراً.", 11.7, 12.2]]}, {"text": "وبغداد، التي لا يزيدُ ارتفاعُها عن نحوِ أربعةٍ وثلاثينَ متراً… تصبحُ تحتَ الماء.", "start": 12.53, "end": 18.44, "words": [["وبغداد،", 12.53, 13.27], ["التي", 13.29, 13.56], ["لا", 13.62, 13.7], ["يزيدُ", 13.75, 14.05], ["ارتفاعُها", 14.08, 14.64], ["عن", 14.71, 14.84], ["نحوِ", 14.87, 15.16], ["أربعةٍ", 15.2, 15.7], ["وثلاثينَ", 15.76, 16.28], ["متراً…", 16.34, 16.83], ["تصبحُ", 17.15, 17.65], ["تحتَ", 17.69, 17.94], ["الماء.", 17.97, 18.44]]}, {"text": "والخليجُ يزحفُ نحوَ الشمال: تغرقُ البصرةُ والكويتُ والدوحة، ويصبحُ جنوبُ العراقِ بحراً.", "start": 18.76, "end": 25.48, "words": [["والخليجُ", 18.76, 19.39], ["يزحفُ", 19.43, 19.85], ["نحوَ", 19.91, 20.16], ["الشمال:", 20.18, 20.8], ["تغرقُ", 21.22, 21.64], ["البصرةُ", 21.68, 22.23], ["والكويتُ", 22.27, 22.74], ["والدوحة،", 22.78, 23.41], ["ويصبحُ", 23.64, 24.23], ["جنوبُ", 24.29, 24.58], ["العراقِ", 24.6, 25.0], ["بحراً.", 25.05, 25.48]]}, {"text": "وحولَ العالم: لندن، والبندقية، وشنغهاي، ونيويورك… تختفي تحتَ الأمواج.", "start": 25.91, "end": 32.22, "words": [["وحولَ", 25.91, 26.26], ["العالم:", 26.3, 26.82], ["لندن،", 27.13, 27.68], ["والبندقية،", 27.75, 28.65], ["وشنغهاي،", 28.76, 29.59], ["ونيويورك…", 29.66, 30.57], ["تختفي", 31.0, 31.37], ["تحتَ", 31.43, 31.64], ["الأمواج.", 31.66, 32.22]]}, {"text": "ويذوبُ معظمُ الماءِ العذبِ في البحرِ المالح، فنحوُ ثلثيه محبوسٌ اليومَ في الجليد.", "start": 32.53, "end": 38.09, "words": [["ويذوبُ", 32.53, 33.15], ["معظمُ", 33.19, 33.55], ["الماءِ", 33.58, 33.84], ["العذبِ", 33.87, 34.23], ["في", 34.28, 34.34], ["البحرِ", 34.37, 34.67], ["المالح،", 34.69, 35.22], ["فنحوُ", 35.49, 35.93], ["ثلثيه", 35.98, 36.48], ["محبوسٌ", 36.55, 37.05], ["اليومَ", 37.1, 37.41], ["في", 37.45, 37.51], ["الجليد.", 37.53, 38.09]]}, {"text": "لكن لا تقلق… ذوبانُ كلِّ هذا الجليد يحتاجُ آلافَ السنين.", "start": 38.52, "end": 42.82, "words": [["لكن", 38.52, 38.77], ["لا", 38.8, 38.86], ["تقلق…", 38.91, 39.47], ["ذوبانُ", 39.91, 40.41], ["كلِّ", 40.49, 40.74], ["هذا", 40.79, 40.99], ["الجليد", 41.02, 41.48], ["يحتاجُ", 41.53, 41.91], ["آلافَ", 41.95, 42.24], ["السنين.", 42.26, 42.82]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 43.14, "end": 49.46, "words": [["والآن", 43.14, 43.43], ["دورُك:", 43.48, 44.0], ["ماذا", 44.28, 44.51], ["لو…؟", 44.56, 45.08], ["اكتبْ", 45.59, 45.98], ["سؤالَك", 46.0, 46.34], ["في", 46.38, 46.43], ["التعليقات،", 46.46, 47.37], ["وقد", 47.58, 47.93], ["يكونُ", 48.0, 48.33], ["الفيديو", 48.35, 48.66], ["القادم.", 48.68, 49.46]]}]