[{"text": "ماذا لو كان الميغالودون ما زالَ حيّاً حتّى اليوم؟", "start": 0.0, "end": 2.97, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.42], ["كان", 0.49, 0.66], ["الميغالودون", 0.7, 1.33], ["ما", 1.38, 1.45], ["زالَ", 1.57, 1.78], ["حيّاً", 1.85, 2.18], ["حتّى", 2.24, 2.51], ["اليوم؟", 2.53, 2.97]]}, {"text": "إنّه أكبرُ قرشٍ عرفناه، عاشَ قبلَ ثلاثةٍ وعشرينَ مليونَ سنة، وانقرضَ قبلَ نحوِ ثلاثةِ ملايينَ ونصف.", "start": 3.41, "end": 11.08, "words": [["إنّه", 3.41, 3.69], ["أكبرُ", 3.75, 4.12], ["قرشٍ", 4.19, 4.49], ["عرفناه،", 4.57, 5.31], ["عاشَ", 5.51, 5.82], ["قبلَ", 5.88, 6.13], ["ثلاثةٍ", 6.19, 6.68], ["وعشرينَ", 6.75, 7.17], ["مليونَ", 7.23, 7.54], ["سنة،", 7.59, 8.09], ["وانقرضَ", 8.34, 8.9], ["قبلَ", 8.96, 9.21], ["نحوِ", 9.27, 9.57], ["ثلاثةِ", 9.64, 10.1], ["ملايينَ", 10.16, 10.55], ["ونصف.", 10.6, 11.08]]}, {"text": "طولُه بين خمسةَ عشرَ وعشرينَ متراً: أطولُ من حافلة، ونحوُ ثلاثةِ أضعافِ القرشِ الأبيض.", "start": 11.52, "end": 18.36, "words": [["طولُه", 11.52, 11.88], ["بين", 11.99, 12.21], ["خمسةَ", 12.33, 12.83], ["عشرَ", 12.9, 13.28], ["وعشرينَ", 13.34, 13.8], ["متراً:", 13.86, 14.36], ["أطولُ", 14.64, 15.02], ["من", 15.06, 15.15], ["حافلة،", 15.22, 15.78], ["ونحوُ", 15.95, 16.34], ["ثلاثةِ", 16.39, 16.86], ["أضعافِ", 16.92, 17.37], ["القرشِ", 17.4, 17.75], ["الأبيض.", 17.77, 18.36]]}, {"text": "قد تصلُ أسنانُه إلى طولِ يدِك، وعضّتُه تُقدَّرُ بأكثرَ من مئةِ ألفِ نيوتن، حتّى عشرةِ أضعافِ عضّةِ القرشِ الأبيض.", "start": 18.68, "end": 26.87, "words": [["قد", 18.68, 18.83], ["تصلُ", 18.86, 19.24], ["أسنانُه", 19.28, 19.73], ["إلى", 19.78, 19.91], ["طولِ", 19.99, 20.23], ["يدِك،", 20.26, 20.7], ["وعضّتُه", 20.95, 21.5], ["تُقدَّرُ", 21.58, 22.09], ["بأكثرَ", 22.15, 22.67], ["من", 22.72, 22.82], ["مئةِ", 22.87, 23.18], ["ألفِ", 23.23, 23.44], ["نيوتن،", 23.49, 24.09], ["حتّى", 24.27, 24.61], ["عشرةِ", 24.67, 25.12], ["أضعافِ", 25.17, 25.62], ["عضّةِ", 25.68, 25.98], ["القرشِ", 26.02, 26.34], ["الأبيض.", 26.37, 26.87]]}, {"text": "كان يصطادُ الحيتان، فلو عادَ اليوم، لصارت الحيتانُ فريستَه الأولى.", "start": 27.19, "end": 31.85, "words": [["كان", 27.19, 27.4], ["يصطادُ", 27.45, 27.81], ["الحيتان،", 27.84, 28.51], ["فلو", 28.6, 28.83], ["عادَ", 28.89, 29.09], ["اليوم،", 29.12, 29.63], ["لصارت", 29.8, 30.24], ["الحيتانُ", 30.29, 30.72], ["فريستَه", 30.77, 31.29], ["الأولى.", 31.35, 31.85]]}, {"text": "وسيصبحُ الصيدُ خطراً على القواربِ الصغيرة، وتحتاجُ الشواطئُ إلى حواجزَ وأبراجِ مراقبة.", "start": 32.12, "end": 38.6, "words": [["وسيصبحُ", 32.12, 32.95], ["الصيدُ", 32.97, 33.33], ["خطراً", 33.4, 33.77], ["على", 33.82, 33.94], ["القواربِ", 33.96, 34.44], ["الصغيرة،", 34.46, 35.12], ["وتحتاجُ", 35.33, 35.97], ["الشواطئُ", 35.99, 36.63], ["إلى", 36.7, 36.85], ["حواجزَ", 36.93, 37.49], ["وأبراجِ", 37.54, 37.98], ["مراقبة.", 38.01, 38.6]]}, {"text": "لكنَّ محيطاتِ اليومِ أبردُ من زمنِه، فربّما يبقى في البحارِ الدافئة، وتولدُ صغارُه قربَ السواحلِ الضحلة.", "start": 38.96, "end": 46.37, "words": [["لكنَّ", 38.96, 39.34], ["محيطاتِ", 39.37, 39.82], ["اليومِ", 39.83, 40.18], ["أبردُ", 40.21, 40.57], ["من", 40.6, 40.7], ["زمنِه،", 40.76, 41.25], ["فربّما", 41.52, 42.01], ["يبقى", 42.08, 42.35], ["في", 42.4, 42.46], ["البحارِ", 42.49, 42.91], ["الدافئة،", 42.93, 43.62], ["وتولدُ", 43.84, 44.4], ["صغارُه", 44.45, 44.91], ["قربَ", 45.02, 45.28], ["السواحلِ", 45.3, 45.81], ["الضحلة.", 45.84, 46.37]]}, {"text": "والمفاجأة؟ من أسبابِ انقراضِه برودةُ البحار، وقلّةُ فرائسِه، ومنافسةُ قرشٍ أصغرَ منه… القرشُ الأبيض!", "start": 46.68, "end": 54.98, "words": [["والمفاجأة؟", 46.68, 47.52], ["من", 47.79, 47.93], ["أسبابِ", 47.96, 48.33], ["انقراضِه", 48.36, 48.87], ["برودةُ", 48.95, 49.35], ["البحار،", 49.39, 50.02], ["وقلّةُ", 50.21, 50.74], ["فرائسِه،", 50.79, 51.46], ["ومنافسةُ", 51.62, 52.4], ["قرشٍ", 52.47, 52.8], ["أصغرَ", 52.85, 53.21], ["منه…", 53.24, 53.65], ["القرشُ", 53.92, 54.37], ["الأبيض!", 54.38, 54.98]]}, {"text": "لو عادَ الميغالودون، هل ستسبحُ في البحر؟ اكتبْ في التعليقات، واشتركْ.", "start": 55.3, "end": 61.07, "words": [["لو", 55.3, 55.48], ["عادَ", 55.55, 55.74], ["الميغالودون،", 55.76, 56.6], ["هل", 56.75, 56.94], ["ستسبحُ", 57.02, 57.61], ["في", 57.64, 57.69], ["البحر؟", 57.73, 58.28], ["اكتبْ", 58.56, 58.94], ["في", 58.98, 59.04], ["التعليقات،", 59.07, 59.95], ["واشتركْ.", 60.16, 61.07]]}]