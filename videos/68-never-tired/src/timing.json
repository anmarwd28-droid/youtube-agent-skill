[{"text": "ماذا لو لم يشعرِ الإنسانُ بالتعبِ أبداً… مهما ركضَ أو عمل؟", "start": 0.0, "end": 4.23, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.43], ["لم", 0.48, 0.59], ["يشعرِ", 0.66, 0.97], ["الإنسانُ", 1.0, 1.44], ["بالتعبِ", 1.49, 1.9], ["أبداً…", 1.93, 2.46], ["مهما", 2.79, 3.03], ["ركضَ", 3.1, 3.47], ["أو", 3.52, 3.63], ["عمل؟", 3.73, 4.23]]}, {"text": "تركضُ بأقصى سرعتِك ولا تتوقّف، وتحملُ الأثقالَ طوالَ اليوم.", "start": 4.55, "end": 9.12, "words": [["تركضُ", 4.55, 5.02], ["بأقصى", 5.07, 5.49], ["سرعتِك", 5.54, 5.97], ["ولا", 6.04, 6.19], ["تتوقّف،", 6.25, 7.05], ["وتحملُ", 7.22, 7.78], ["الأثقالَ", 7.8, 8.28], ["طوالَ", 8.36, 8.65], ["اليوم.", 8.67, 9.12]]}, {"text": "الرقمُ القياسيُّ للماراثونِ اليومَ نحوُ ساعتين، أمّا بسرعةِ العدّائينَ القصيرة… فيكفي نحوُ ساعةٍ وعشرِ دقائق.", "start": 9.57, "end": 18.26, "words": [["الرقمُ", 9.57, 9.97], ["القياسيُّ", 10.01, 10.75], ["للماراثونِ", 10.77, 11.4], ["اليومَ", 11.42, 11.9], ["نحوُ", 11.98, 12.27], ["ساعتين،", 12.34, 13.05], ["أمّا", 13.49, 13.75], ["بسرعةِ", 13.8, 14.3], ["العدّائينَ", 14.34, 14.95], ["القصيرة…", 14.98, 15.72], ["فيكفي", 16.05, 16.44], ["نحوُ", 16.51, 16.75], ["ساعةٍ", 16.83, 17.24], ["وعشرِ", 17.3, 17.64], ["دقائق.", 17.67, 18.26]]}, {"text": "المصانعُ والمزارعُ تعملُ ليلاً ونهاراً، والإنتاجُ يتضاعف.", "start": 18.7, "end": 22.98, "words": [["المصانعُ", 18.7, 19.35], ["والمزارعُ", 19.38, 19.96], ["تعملُ", 20.03, 20.4], ["ليلاً", 20.47, 20.76], ["ونهاراً،", 20.79, 21.43], ["والإنتاجُ", 21.73, 22.32], ["يتضاعف.", 22.34, 22.98]]}, {"text": "لكنَّ التعبَ ليس عدوَّك… إنّه جرسُ إنذارٍ يحميك.", "start": 23.28, "end": 26.91, "words": [["لكنَّ", 23.28, 23.63], ["التعبَ", 23.65, 24.02], ["ليس", 24.06, 24.21], ["عدوَّك…", 24.32, 24.88], ["إنّه", 25.18, 25.48], ["جرسُ", 25.59, 25.89], ["إنذارٍ", 25.95, 26.32], ["يحميك.", 26.37, 26.91]]}, {"text": "فهو يوقفُك قبلَ أن تتمزّقَ عضلاتُك، أو ترتفعَ حرارتُك إلى درجةٍ خطيرة.", "start": 27.27, "end": 32.71, "words": [["فهو", 27.27, 27.55], ["يوقفُك", 27.63, 28.1], ["قبلَ", 28.24, 28.46], ["أن", 28.5, 28.56], ["تتمزّقَ", 28.62, 29.25], ["عضلاتُك،", 29.29, 30.04], ["أو", 30.2, 30.35], ["ترتفعَ", 30.42, 30.91], ["حرارتُك", 30.94, 31.46], ["إلى", 31.57, 31.68], ["درجةٍ", 31.74, 32.12], ["خطيرة.", 32.18, 32.71]]}, {"text": "فالعضلاتُ تخزّنُ وقوداً يكفي نحوَ ساعتينِ فقط من الجهدِ الشديد.", "start": 33.07, "end": 37.43, "words": [["فالعضلاتُ", 33.07, 33.68], ["تخزّنُ", 33.74, 34.2], ["وقوداً", 34.24, 34.67], ["يكفي", 34.74, 34.96], ["نحوَ", 35.02, 35.24], ["ساعتينِ", 35.28, 35.71], ["فقط", 35.77, 36.12], ["من", 36.26, 36.4], ["الجهدِ", 36.46, 36.78], ["الشديد.", 36.8, 37.43]]}, {"text": "وبلا تعب، يركضُ الناسُ حتّى ينفدَ وقودُهم فجأة، فيسقطونَ دونَ أيِّ إنذار.", "start": 37.78, "end": 43.39, "words": [["وبلا", 37.78, 38.13], ["تعب،", 38.19, 38.53], ["يركضُ", 38.59, 39.01], ["الناسُ", 39.03, 39.39], ["حتّى", 39.45, 39.75], ["ينفدَ", 39.81, 40.22], ["وقودُهم", 40.29, 40.76], ["فجأة،", 40.83, 41.45], ["فيسقطونَ", 41.65, 42.32], ["دونَ", 42.38, 42.55], ["أيِّ", 42.6, 42.81], ["إنذار.", 42.83, 43.39]]}, {"text": "واليومَ، ورغمَ وجودِ التعب، قتلتْ ساعاتُ العملِ الطويلةُ نحوَ سبعمئةٍ وخمسةٍ وأربعينَ ألفَ إنسانٍ في عامٍ واحد.", "start": 43.69, "end": 52.02, "words": [["واليومَ،", 43.69, 44.3], ["ورغمَ", 44.47, 44.83], ["وجودِ", 44.86, 45.19], ["التعب،", 45.2, 45.8], ["قتلتْ", 46.0, 46.41], ["ساعاتُ", 46.43, 46.79], ["العملِ", 46.81, 47.18], ["الطويلةُ", 47.21, 47.93], ["نحوَ", 48.16, 48.43], ["سبعمئةٍ", 48.5, 49.06], ["وخمسةٍ", 49.13, 49.6], ["وأربعينَ", 49.66, 50.08], ["ألفَ", 50.13, 50.38], ["إنسانٍ", 50.4, 50.9], ["في", 51.13, 51.25], ["عامٍ", 51.34, 51.55], ["واحد.", 51.59, 52.02]]}, {"text": "فبلا تعب، قد يعملُ الناسُ حتّى تنهارَ أجسادُهم.", "start": 52.38, "end": 55.84, "words": [["فبلا", 52.38, 52.74], ["تعب،", 52.81, 53.24], ["قد", 53.35, 53.53], ["يعملُ", 53.58, 53.92], ["الناسُ", 53.93, 54.35], ["حتّى", 54.41, 54.68], ["تنهارَ", 54.73, 55.14], ["أجسادُهم.", 55.16, 55.84]]}, {"text": "والأغرب؟ في جسمِك عضلةٌ لا تتعبُ أصلاً: القلب.", "start": 56.15, "end": 60.44, "words": [["والأغرب؟", 56.15, 56.85], ["في", 57.13, 57.26], ["جسمِك", 57.38, 57.77], ["عضلةٌ", 57.85, 58.28], ["لا", 58.35, 58.43], ["تتعبُ", 58.5, 58.87], ["أصلاً:", 58.91, 59.47], ["القلب.", 59.79, 60.44]]}, {"text": "ينبضُ نحوَ ثلاثةِ ملياراتِ مرّةٍ في حياتِك… دونَ أن يستريحَ لحظةً واحدة.", "start": 60.77, "end": 66.36, "words": [["ينبضُ", 60.77, 61.19], ["نحوَ", 61.26, 61.51], ["ثلاثةِ", 61.56, 62.01], ["ملياراتِ", 62.07, 62.59], ["مرّةٍ", 62.66, 63.07], ["في", 63.12, 63.19], ["حياتِك…", 63.27, 63.99], ["دونَ", 64.38, 64.64], ["أن", 64.69, 64.77], ["يستريحَ", 64.83, 65.34], ["لحظةً", 65.39, 65.84], ["واحدة.", 65.89, 66.36]]}, {"text": "لو لم تتعبْ أبداً، ماذا ستفعلُ أوّلاً؟ اكتبْ في التعليقات، واشتركْ.", "start": 66.75, "end": 72.45, "words": [["لو", 66.75, 66.93], ["لم", 66.98, 67.08], ["تتعبْ", 67.15, 67.53], ["أبداً،", 67.56, 68.15], ["ماذا", 68.36, 68.64], ["ستفعلُ", 68.7, 69.18], ["أوّلاً؟", 69.23, 69.73], ["اكتبْ", 70.01, 70.4], ["في", 70.44, 70.51], ["التعليقات،", 70.54, 71.39], ["واشتركْ.", 71.54, 72.45]]}]