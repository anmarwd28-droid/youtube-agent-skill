[{"text": "ماذا لو انقطعَ الإنترنتُ عن العالمِ كلِّه… ليومٍ كامل؟", "start": 0.0, "end": 3.95, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.48], ["انقطعَ", 0.5, 0.94], ["الإنترنتُ", 0.96, 1.64], ["عن", 1.71, 1.82], ["العالمِ", 1.87, 2.24], ["كلِّه…", 2.3, 2.76], ["ليومٍ", 3.08, 3.4], ["كامل؟", 3.47, 3.95]]}, {"text": "تستيقظُ صباحاً: لا رسائل، ولا فيديوهات، ولا خرائط.", "start": 4.26, "end": 8.34, "words": [["تستيقظُ", 4.26, 4.92], ["صباحاً:", 5.0, 5.7], ["لا", 5.9, 6.06], ["رسائل،", 6.12, 6.68], ["ولا", 6.71, 6.94], ["فيديوهات،", 6.99, 7.5], ["ولا", 7.52, 7.69], ["خرائط.", 7.75, 8.34]]}, {"text": "لكنّ المشكلةَ أكبرُ بكثيرٍ من هاتفِك.", "start": 8.7, "end": 11.7, "words": [["لكنّ", 8.7, 9.07], ["المشكلةَ", 9.1, 9.85], ["أكبرُ", 10.01, 10.48], ["بكثيرٍ", 10.52, 11.02], ["من", 11.04, 11.12], ["هاتفِك.", 11.17, 11.7]]}, {"text": "البنوكُ تتعطّل، والصرّافاتُ الآلية تتوقّف، والدفعُ بالبطاقةِ لا يعمل… فتعودُ النقودُ الورقيةُ ملكةً من جديد.", "start": 12.12, "end": 20.6, "words": [["البنوكُ", 12.12, 12.6], ["تتعطّل،", 12.65, 13.47], ["والصرّافاتُ", 13.62, 14.34], ["الآلية", 14.37, 14.78], ["تتوقّف،", 14.8, 15.57], ["والدفعُ", 15.73, 16.16], ["بالبطاقةِ", 16.21, 16.82], ["لا", 16.87, 16.94], ["يعمل…", 16.97, 17.46], ["فتعودُ", 17.77, 18.3], ["النقودُ", 18.32, 18.77], ["الورقيةُ", 18.8, 19.42], ["ملكةً", 19.48, 19.9], ["من", 19.93, 20.0], ["جديد.", 20.07, 20.6]]}, {"text": "والطائراتُ تتأخّر، لأنّ أنظمةَ الحجزِ وتسجيلِ المسافرين تعتمدُ على الشبكة.", "start": 20.92, "end": 27.14, "words": [["والطائراتُ", 20.92, 21.62], ["تتأخّر،", 21.7, 22.54], ["لأنّ", 22.74, 23.07], ["أنظمةَ", 23.13, 23.63], ["الحجزِ", 23.65, 24.21], ["وتسجيلِ", 24.32, 24.86], ["المسافرين", 24.88, 25.62], ["تعتمدُ", 25.87, 26.38], ["على", 26.42, 26.53], ["الشبكة.", 26.56, 27.14]]}, {"text": "والمتاجرُ لا تستطيعُ طلبَ البضائع، والموانئُ تتباطأ… والخسائرُ تصلُ إلى ملياراتِ الدولارات في يومٍ واحد.", "start": 27.47, "end": 35.22, "words": [["والمتاجرُ", 27.47, 28.18], ["لا", 28.23, 28.32], ["تستطيعُ", 28.37, 28.91], ["طلبَ", 28.98, 29.23], ["البضائع،", 29.26, 29.99], ["والموانئُ", 30.16, 30.79], ["تتباطأ…", 30.85, 31.54], ["والخسائرُ", 31.75, 32.51], ["تصلُ", 32.57, 32.95], ["إلى", 32.99, 33.12], ["ملياراتِ", 33.19, 33.7], ["الدولارات", 33.73, 34.3], ["في", 34.35, 34.42], ["يومٍ", 34.48, 34.71], ["واحد.", 34.77, 35.22]]}, {"text": "فالإنترنتُ ليسَ في السماء… بل في كابلاتٍ تحتَ البحار، تحملُ معظمَ بياناتِ العالم.", "start": 35.55, "end": 42.03, "words": [["فالإنترنتُ", 35.55, 36.28], ["ليسَ", 36.34, 36.56], ["في", 36.61, 36.67], ["السماء…", 36.7, 37.28], ["بل", 37.56, 37.7], ["في", 37.76, 37.83], ["كابلاتٍ", 37.94, 38.58], ["تحتَ", 38.75, 39.04], ["البحار،", 39.07, 39.76], ["تحملُ", 40.09, 40.54], ["معظمَ", 40.59, 40.97], ["بياناتِ", 41.03, 41.41], ["العالم.", 41.45, 42.03]]}, {"text": "لكنّ شيئاً جميلاً قد يحدث: يرفعُ الناسُ رؤوسَهم عن الشاشات… ويتحدّثون.", "start": 42.41, "end": 48.25, "words": [["لكنّ", 42.41, 42.74], ["شيئاً", 42.8, 43.07], ["جميلاً", 43.14, 43.52], ["قد", 43.58, 43.71], ["يحدث:", 43.77, 44.24], ["يرفعُ", 44.57, 45.0], ["الناسُ", 45.02, 45.39], ["رؤوسَهم", 45.43, 46.01], ["عن", 46.1, 46.22], ["الشاشات…", 46.24, 47.05], ["ويتحدّثون.", 47.26, 48.25]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 48.69, "end": 55.36, "words": [["والآن", 48.69, 49.06], ["دورُك:", 49.11, 49.67], ["ماذا", 49.99, 50.28], ["لو…؟", 50.34, 50.97], ["اكتبْ", 51.35, 51.76], ["سؤالَك", 51.78, 52.19], ["في", 52.3, 52.36], ["التعليقات،", 52.38, 53.24], ["وقد", 53.42, 53.75], ["يكونُ", 53.82, 54.16], ["الفيديو", 54.2, 54.53], ["القادم.", 54.55, 55.36]]}]