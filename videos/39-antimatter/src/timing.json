[{"text": "ماذا لو كانَ جسمُك مصنوعًا من المادّةِ المضادّة؟", "start": 0.0, "end": 2.86, "words": [["ماذا", 0.0, 0.27], ["لو", 0.31, 0.41], ["كانَ", 0.48, 0.64], ["جسمُك", 0.72, 1.06], ["مصنوعًا", 1.17, 1.62], ["من", 1.65, 1.76], ["المادّةِ", 1.81, 2.19], ["المضادّة؟", 2.22, 2.86]]}, {"text": "المادّةُ المضادّةُ نسخةٌ معكوسةٌ من المادّة: إلكترونٌ موجَب… وبروتونٌ سالِب.", "start": 3.32, "end": 9.44, "words": [["المادّةُ", 3.32, 3.84], ["المضادّةُ", 3.88, 4.55], ["نسخةٌ", 4.66, 5.16], ["معكوسةٌ", 5.22, 5.8], ["من", 5.84, 5.94], ["المادّة:", 6.0, 6.55], ["إلكترونٌ", 6.84, 7.45], ["موجَب…", 7.54, 8.13], ["وبروتونٌ", 8.29, 8.9], ["سالِب.", 8.97, 9.44]]}, {"text": "وحينَ تلمسُ مادّةً عاديّة، يَفنى الاثنانِ معًا، ويتحوّلانِ كلُّهما إلى طاقة.", "start": 9.85, "end": 15.56, "words": [["وحينَ", 9.85, 10.28], ["تلمسُ", 10.34, 10.72], ["مادّةً", 10.77, 11.13], ["عاديّة،", 11.2, 11.8], ["يَفنى", 11.96, 12.22], ["الاثنانِ", 12.25, 12.7], ["معًا،", 12.76, 13.19], ["ويتحوّلانِ", 13.35, 14.24], ["كلُّهما", 14.3, 14.81], ["إلى", 14.87, 15.02], ["طاقة.", 15.12, 15.56]]}, {"text": "لحظةَ ظهورِك، يصطدمُ الهواءُ بجلدِك… فيتوهّجُ جسمُك بأشعّةِ غاما القاتلة.", "start": 16.02, "end": 22.01, "words": [["لحظةَ", 16.02, 16.51], ["ظهورِك،", 16.58, 17.19], ["يصطدمُ", 17.36, 17.84], ["الهواءُ", 17.87, 18.29], ["بجلدِك…", 18.34, 18.96], ["فيتوهّجُ", 19.31, 20.07], ["جسمُك", 20.13, 20.48], ["بأشعّةِ", 20.58, 21.16], ["غاما", 21.23, 21.41], ["القاتلة.", 21.43, 22.01]]}, {"text": "غرامٌ واحدٌ منها فقط يُطلقُ طاقةً تعادلُ ثلاثَ قنابلِ هيروشيما.", "start": 22.5, "end": 27.24, "words": [["غرامٌ", 22.5, 22.91], ["واحدٌ", 22.98, 23.32], ["منها", 23.36, 23.58], ["فقط", 23.65, 23.99], ["يُطلقُ", 24.22, 24.65], ["طاقةً", 24.72, 25.16], ["تعادلُ", 25.2, 25.65], ["ثلاثَ", 25.7, 26.01], ["قنابلِ", 26.08, 26.48], ["هيروشيما.", 26.54, 27.24]]}, {"text": "ولو فَنِيَ جسمُك كلُّه، لانطلقَ نحوُ ثلاثةِ آلافِ ميغاطن… ستّونَ ضعفَ أقوى قنبلةٍ نوويّةٍ في التاريخ.", "start": 27.64, "end": 35.55, "words": [["ولو", 27.64, 27.92], ["فَنِيَ", 28.0, 28.29], ["جسمُك", 28.35, 28.7], ["كلُّه،", 28.79, 29.29], ["لانطلقَ", 29.45, 29.96], ["نحوُ", 30.01, 30.24], ["ثلاثةِ", 30.3, 30.73], ["آلافِ", 30.79, 31.13], ["ميغاطن…", 31.16, 31.89], ["ستّونَ", 32.3, 32.8], ["ضعفَ", 32.88, 33.19], ["أقوى", 33.23, 33.67], ["قنبلةٍ", 33.81, 34.34], ["نوويّةٍ", 34.38, 34.91], ["في", 34.96, 35.0], ["التاريخ.", 35.04, 35.55]]}, {"text": "فلماذا لا نجدُها حولَنا؟ عندَ ولادةِ الكون، صُنِعَ النوعانِ بالتساوي تقريبًا.", "start": 36.02, "end": 41.94, "words": [["فلماذا", 36.02, 36.52], ["لا", 36.59, 36.64], ["نجدُها", 36.7, 37.12], ["حولَنا؟", 37.19, 37.74], ["عندَ", 38.22, 38.5], ["ولادةِ", 38.55, 38.93], ["الكون،", 38.96, 39.55], ["صُنِعَ", 39.71, 40.1], ["النوعانِ", 40.12, 40.73], ["بالتساوي", 40.79, 41.28], ["تقريبًا.", 41.33, 41.94]]}, {"text": "لكنْ مقابلَ كلِّ مليارِ جسيمٍ مضادّ، بقيَ جسيمٌ واحدٌ زائدٌ من المادّة… ومنهُ صُنِعنا نحن.", "start": 42.26, "end": 49.32, "words": [["لكنْ", 42.26, 42.61], ["مقابلَ", 42.64, 43.11], ["كلِّ", 43.17, 43.41], ["مليارِ", 43.43, 43.76], ["جسيمٍ", 43.82, 44.22], ["مضادّ،", 44.27, 44.88], ["بقيَ", 45.13, 45.48], ["جسيمٌ", 45.53, 45.99], ["واحدٌ", 46.08, 46.46], ["زائدٌ", 46.53, 46.87], ["من", 46.89, 47.01], ["المادّة…", 47.05, 47.59], ["ومنهُ", 47.91, 48.3], ["صُنِعنا", 48.35, 48.81], ["نحن.", 48.88, 49.32]]}, {"text": "صنعَها العلماءُ في مختبرِ سيرن… لكنّ كلَّ ما صنعوه لا يكفي لإضاءةِ مصباحٍ بضعَ دقائق.", "start": 49.64, "end": 55.78, "words": [["صنعَها", 49.64, 50.1], ["العلماءُ", 50.13, 50.68], ["في", 50.72, 50.79], ["مختبرِ", 50.86, 51.3], ["سيرن…", 51.35, 51.79], ["لكنّ", 52.07, 52.44], ["كلَّ", 52.5, 52.74], ["ما", 52.79, 52.85], ["صنعوه", 52.96, 53.45], ["لا", 53.55, 53.68], ["يكفي", 53.73, 53.97], ["لإضاءةِ", 54.04, 54.48], ["مصباحٍ", 54.53, 54.95], ["بضعَ", 55.0, 55.2], ["دقائق.", 55.24, 55.78]]}, {"text": "والغريب؟ جسمُك يصنعُ المادّةَ المضادّةَ الآن: أكثرَ من مئةِ بوزيترونٍ كلَّ ساعة، من البوتاسيومِ في جسمِك.", "start": 56.11, "end": 64.12, "words": [["والغريب؟", 56.11, 56.78], ["جسمُك", 56.99, 57.39], ["يصنعُ", 57.48, 57.82], ["المادّةَ", 57.84, 58.34], ["المضادّةَ", 58.36, 58.95], ["الآن:", 58.98, 59.49], ["أكثرَ", 59.77, 60.22], ["من", 60.27, 60.38], ["مئةِ", 60.43, 60.73], ["بوزيترونٍ", 60.78, 61.39], ["كلَّ", 61.47, 61.7], ["ساعة،", 61.74, 62.3], ["من", 62.51, 62.66], ["البوتاسيومِ", 62.72, 63.41], ["في", 63.47, 63.53], ["جسمِك.", 63.61, 64.12]]}, {"text": "هل تصافحُ نسختَك المضادّة؟ اكتبْ جوابَك في التعليقات… واشتركْ.", "start": 64.45, "end": 69.89, "words": [["هل", 64.45, 64.61], ["تصافحُ", 64.66, 65.19], ["نسختَك", 65.24, 65.64], ["المضادّة؟", 65.71, 66.4], ["اكتبْ", 66.68, 67.07], ["جوابَك", 67.11, 67.56], ["في", 67.67, 67.74], ["التعليقات…", 67.77, 68.75], ["واشتركْ.", 69.0, 69.89]]}]