[{"text": "ماذا لو اقتربَ القمرُ من الأرضِ… فجأة؟", "start": 0.0, "end": 3.01, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.45], ["اقتربَ", 0.49, 0.86], ["القمرُ", 0.88, 1.3], ["من", 1.33, 1.42], ["الأرضِ…", 1.45, 1.99], ["فجأة؟", 2.4, 3.01]]}, {"text": "اليوم، يبعدُ القمرُ عنّا نحوَ أربعمئةِ ألفِ كيلومتر.", "start": 3.32, "end": 7.16, "words": [["اليوم،", 3.32, 3.84], ["يبعدُ", 3.94, 4.35], ["القمرُ", 4.38, 4.85], ["عنّا", 4.92, 5.32], ["نحوَ", 5.43, 5.72], ["أربعمئةِ", 5.76, 6.37], ["ألفِ", 6.41, 6.59], ["كيلومتر.", 6.65, 7.16]]}, {"text": "فلو صارَ على نصفِ هذه المسافة… لبدا في السماءِ أكبرَ بمرّتين، وأسطعَ بأربعِ مرّات.", "start": 7.54, "end": 13.96, "words": [["فلو", 7.54, 7.8], ["صارَ", 7.87, 8.12], ["على", 8.17, 8.3], ["نصفِ", 8.36, 8.59], ["هذه", 8.64, 8.86], ["المسافة…", 8.89, 9.54], ["لبدا", 9.97, 10.34], ["في", 10.4, 10.47], ["السماءِ", 10.51, 10.98], ["أكبرَ", 11.03, 11.41], ["بمرّتين،", 11.46, 12.24], ["وأسطعَ", 12.45, 12.93], ["بأربعِ", 12.99, 13.39], ["مرّات.", 13.42, 13.96]]}, {"text": "منظرٌ مذهل… لكنّ المشكلةَ ليست في السماء، بل في البحر.", "start": 14.27, "end": 18.75, "words": [["منظرٌ", 14.27, 14.7], ["مذهل…", 14.73, 15.28], ["لكنّ", 15.55, 15.87], ["المشكلةَ", 15.89, 16.54], ["ليست", 16.68, 17.0], ["في", 17.05, 17.1], ["السماء،", 17.14, 17.69], ["بل", 17.9, 18.04], ["في", 18.1, 18.16], ["البحر.", 18.2, 18.75]]}, {"text": "فجاذبيةُ القمرِ هي التي تصنعُ المدَّ والجزر. وعلى نصفِ المسافة، يصبحُ المدُّ أقوى بثماني مرّات.", "start": 19.06, "end": 26.16, "words": [["فجاذبيةُ", 19.06, 19.85], ["القمرِ", 19.86, 20.33], ["هي", 20.35, 20.53], ["التي", 20.55, 20.83], ["تصنعُ", 20.88, 21.25], ["المدَّ", 21.27, 21.61], ["والجزر.", 21.65, 22.25], ["وعلى", 22.46, 22.73], ["نصفِ", 22.8, 23.03], ["المسافة،", 23.06, 23.75], ["يصبحُ", 23.99, 24.44], ["المدُّ", 24.45, 24.79], ["أقوى", 24.82, 25.12], ["بثماني", 25.17, 25.6], ["مرّات.", 25.65, 26.16]]}, {"text": "مياهُ البحرِ تغمرُ المدنَ الساحلية… مرّتينِ في كلِّ يوم.", "start": 26.45, "end": 30.68, "words": [["مياهُ", 26.45, 26.82], ["البحرِ", 26.85, 27.23], ["تغمرُ", 27.31, 27.74], ["المدنَ", 27.76, 28.18], ["الساحلية…", 28.2, 29.04], ["مرّتينِ", 29.34, 29.88], ["في", 29.94, 30.0], ["كلِّ", 30.07, 30.3], ["يوم.", 30.31, 30.68]]}, {"text": "ولو اقتربَ أكثر، فلن يسحبَ الماءَ فقط… بل الأرضَ نفسَها. زلازلُ في كلِّ مكان، وبراكينُ تستيقظ.", "start": 30.99, "end": 38.89, "words": [["ولو", 30.99, 31.27], ["اقتربَ", 31.32, 31.72], ["أكثر،", 31.75, 32.24], ["فلن", 32.39, 32.67], ["يسحبَ", 32.73, 33.1], ["الماءَ", 33.12, 33.38], ["فقط…", 33.41, 33.94], ["بل", 34.23, 34.38], ["الأرضَ", 34.44, 34.8], ["نفسَها.", 34.84, 35.42], ["زلازلُ", 35.71, 36.23], ["في", 36.28, 36.35], ["كلِّ", 36.42, 36.63], ["مكان،", 36.66, 37.22], ["وبراكينُ", 37.44, 38.13], ["تستيقظ.", 38.19, 38.89]]}, {"text": "لكن لا تقلق… فالقمرُ في الحقيقةِ يبتعدُ عنّا، نحوَ أربعةِ سنتيمتراتٍ كلَّ سنة.", "start": 39.18, "end": 45.69, "words": [["لكن", 39.18, 39.47], ["لا", 39.52, 39.59], ["تقلق…", 39.65, 40.18], ["فالقمرُ", 40.62, 41.16], ["في", 41.2, 41.26], ["الحقيقةِ", 41.28, 41.95], ["يبتعدُ", 41.99, 42.48], ["عنّا،", 42.56, 43.06], ["نحوَ", 43.3, 43.62], ["أربعةِ", 43.65, 44.12], ["سنتيمتراتٍ", 44.18, 44.95], ["كلَّ", 45.02, 45.24], ["سنة.", 45.3, 45.69]]}, {"text": "هذا السؤالُ من أحدِ متابعينا. اكتبْ سؤالَك أنتَ في التعليقات… وقد يكونُ الفيديو القادم.", "start": 46.01, "end": 52.9, "words": [["هذا", 46.01, 46.25], ["السؤالُ", 46.29, 46.72], ["من", 46.77, 46.87], ["أحدِ", 46.92, 47.23], ["متابعينا.", 47.28, 48.12], ["اكتبْ", 48.45, 48.8], ["سؤالَك", 48.82, 49.27], ["أنتَ", 49.39, 49.68], ["في", 49.74, 49.81], ["التعليقات…", 49.84, 50.8], ["وقد", 51.01, 51.36], ["يكونُ", 51.43, 51.78], ["الفيديو", 51.8, 52.11], ["القادم.", 52.13, 52.9]]}]