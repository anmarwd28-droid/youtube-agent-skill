[{"text": "ماذا لو استطعتَ التنفّسَ تحتَ الماء؟", "start": 0.0, "end": 2.29, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.44], ["استطعتَ", 0.48, 0.88], ["التنفّسَ", 0.91, 1.47], ["تحتَ", 1.52, 1.75], ["الماء؟", 1.79, 2.29]]}, {"text": "تقفزُ في البحر… وتبقى هناكَ ساعات، بلا أنبوبٍ ولا خزّانِ أكسجين.", "start": 2.61, "end": 7.95, "words": [["تقفزُ", 2.61, 3.1], ["في", 3.16, 3.22], ["البحر…", 3.25, 3.88], ["وتبقى", 4.2, 4.7], ["هناكَ", 4.74, 5.08], ["ساعات،", 5.14, 5.75], ["بلا", 5.83, 6.07], ["أنبوبٍ", 6.12, 6.58], ["ولا", 6.63, 6.78], ["خزّانِ", 6.85, 7.23], ["أكسجين.", 7.26, 7.95]]}, {"text": "المحيطاتُ تغطّي أكثرَ من سبعينَ في المئةِ من الأرض، وأكثرُ من ثمانينَ في المئةِ منها لم يستكشفْهُ أحد.", "start": 8.39, "end": 16.1, "words": [["المحيطاتُ", 8.39, 9.06], ["تغطّي", 9.11, 9.58], ["أكثرَ", 9.64, 10.03], ["من", 10.08, 10.17], ["سبعينَ", 10.23, 10.65], ["في", 10.7, 10.77], ["المئةِ", 10.81, 11.24], ["من", 11.29, 11.39], ["الأرض،", 11.45, 12.01], ["وأكثرُ", 12.33, 12.85], ["من", 12.89, 12.98], ["ثمانينَ", 13.05, 13.5], ["في", 13.56, 13.63], ["المئةِ", 13.65, 14.06], ["منها", 14.13, 14.54], ["لم", 14.77, 14.95], ["يستكشفْهُ", 15.02, 15.6], ["أحد.", 15.66, 16.1]]}, {"text": "لكنْ هناكَ مشكلة: لترُ الماءِ فيه أكسجينٌ أقلُّ من لترِ الهواءِ بثلاثينَ مرّة.", "start": 16.49, "end": 22.56, "words": [["لكنْ", 16.49, 16.8], ["هناكَ", 16.82, 17.16], ["مشكلة:", 17.21, 17.87], ["لترُ", 18.19, 18.52], ["الماءِ", 18.55, 18.9], ["فيه", 18.96, 19.17], ["أكسجينٌ", 19.24, 19.84], ["أقلُّ", 19.91, 20.28], ["من", 20.32, 20.39], ["لترِ", 20.42, 20.69], ["الهواءِ", 20.71, 21.22], ["بثلاثينَ", 21.43, 22.05], ["مرّة.", 22.09, 22.56]]}, {"text": "فلكي تعيش، يجبُ أن يمرَّ في صدرِكَ أكثرُ من خمسينَ لتراً من الماءِ كلَّ دقيقة.", "start": 22.94, "end": 28.62, "words": [["فلكي", 22.94, 23.37], ["تعيش،", 23.44, 24.07], ["يجبُ", 24.28, 24.6], ["أن", 24.65, 24.72], ["يمرَّ", 24.79, 25.14], ["في", 25.18, 25.25], ["صدرِكَ", 25.34, 25.76], ["أكثرُ", 25.81, 26.18], ["من", 26.22, 26.29], ["خمسينَ", 26.34, 26.74], ["لتراً", 26.8, 27.13], ["من", 27.17, 27.27], ["الماءِ", 27.33, 27.66], ["كلَّ", 27.7, 27.95], ["دقيقة.", 27.98, 28.62]]}, {"text": "والماءُ أثقلُ من الهواءِ بثمانِمئةِ مرّة. رئتاكَ لا تستطيعانِ ذلك… تحتاجُ خياشيمَ مثلَ السمكة.", "start": 28.94, "end": 36.44, "words": [["والماءُ", 28.94, 29.34], ["أثقلُ", 29.4, 29.76], ["من", 29.79, 29.88], ["الهواءِ", 29.93, 30.39], ["بثمانِمئةِ", 30.52, 31.34], ["مرّة.", 31.39, 31.82], ["رئتاكَ", 32.15, 32.66], ["لا", 32.7, 32.77], ["تستطيعانِ", 32.83, 33.48], ["ذلك…", 33.55, 34.06], ["تحتاجُ", 34.39, 34.87], ["خياشيمَ", 34.94, 35.47], ["مثلَ", 35.5, 35.73], ["السمكة.", 35.76, 36.44]]}, {"text": "ثمّ يأتي البرد: الماءُ يسحبُ حرارةَ جسمِكَ أسرعَ من الهواءِ بنحوِ خمسٍ وعشرينَ مرّة.", "start": 36.77, "end": 42.88, "words": [["ثمّ", 36.77, 37.04], ["يأتي", 37.08, 37.28], ["البرد:", 37.3, 37.86], ["الماءُ", 38.07, 38.43], ["يسحبُ", 38.48, 38.91], ["حرارةَ", 38.99, 39.44], ["جسمِكَ", 39.52, 39.94], ["أسرعَ", 39.97, 40.4], ["من", 40.43, 40.54], ["الهواءِ", 40.6, 41.1], ["بنحوِ", 41.15, 41.53], ["خمسٍ", 41.58, 41.89], ["وعشرينَ", 41.95, 42.39], ["مرّة.", 42.45, 42.88]]}, {"text": "وكلّما نزلتَ عشرةَ أمتار، زادَ الضغطُ عليكَ بقدرِ ضغطِ الهواءِ كلِّه فوقَ رأسِك.", "start": 43.2, "end": 49.41, "words": [["وكلّما", 43.2, 43.73], ["نزلتَ", 43.78, 44.16], ["عشرةَ", 44.21, 44.64], ["أمتار،", 44.67, 45.36], ["زادَ", 45.64, 45.89], ["الضغطُ", 45.92, 46.29], ["عليكَ", 46.38, 46.78], ["بقدرِ", 46.82, 47.23], ["ضغطِ", 47.29, 47.54], ["الهواءِ", 47.58, 48.03], ["كلِّه", 48.1, 48.51], ["فوقَ", 48.62, 48.89], ["رأسِك.", 48.95, 49.41]]}, {"text": "لكنْ هنا مفاجأة: رئتاكَ مملوءتانِ بالماء، والماءُ لا يُضغَط… فقد تنزلُ أعمقَ من أيِّ غوّاصٍ اليوم.", "start": 49.74, "end": 57.66, "words": [["لكنْ", 49.74, 50.05], ["هنا", 50.07, 50.26], ["مفاجأة:", 50.32, 51.03], ["رئتاكَ", 51.27, 51.83], ["مملوءتانِ", 51.87, 52.53], ["بالماء،", 52.58, 53.12], ["والماءُ", 53.32, 53.74], ["لا", 53.79, 53.85], ["يُضغَط…", 53.92, 54.57], ["فقد", 54.85, 55.16], ["تنزلُ", 55.19, 55.63], ["أعمقَ", 55.69, 56.13], ["من", 56.18, 56.28], ["أيِّ", 56.34, 56.6], ["غوّاصٍ", 56.65, 57.13], ["اليوم.", 57.18, 57.66]]}, {"text": "والأغرب: في أسابيعِكَ الأولى في بطنِ أمِّك، كانت في رقبتِكَ ثنياتٌ تشبهُ خياشيمَ السمك.", "start": 58.04, "end": 64.31, "words": [["والأغرب:", 58.04, 58.76], ["في", 58.91, 59.02], ["أسابيعِكَ", 59.09, 59.63], ["الأولى", 59.65, 59.93], ["في", 60.0, 60.07], ["بطنِ", 60.13, 60.37], ["أمِّك،", 60.42, 60.89], ["كانت", 61.07, 61.36], ["في", 61.42, 61.48], ["رقبتِكَ", 61.57, 62.17], ["ثنياتٌ", 62.23, 62.76], ["تشبهُ", 62.84, 63.24], ["خياشيمَ", 63.3, 63.77], ["السمك.", 63.8, 64.31]]}, {"text": "ماذا ستستكشفُ أوّلاً تحتَ الماء؟ اكتبْ في التعليقات، واشتركْ.", "start": 64.69, "end": 69.71, "words": [["ماذا", 64.69, 64.94], ["ستستكشفُ", 64.99, 65.69], ["أوّلاً", 65.75, 66.21], ["تحتَ", 66.39, 66.65], ["الماء؟", 66.68, 67.14], ["اكتبْ", 67.38, 67.74], ["في", 67.77, 67.84], ["التعليقات،", 67.87, 68.66], ["واشتركْ.", 68.84, 69.71]]}]