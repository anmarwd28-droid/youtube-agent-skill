[{"text": "ماذا لو اختفى هيكلُك العظميُّ خمسَ ثوانٍ فقط؟", "start": 0.0, "end": 3.31, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.43], ["اختفى", 0.45, 0.82], ["هيكلُك", 0.89, 1.32], ["العظميُّ", 1.38, 2.03], ["خمسَ", 2.15, 2.45], ["ثوانٍ", 2.51, 2.81], ["فقط؟", 2.88, 3.31]]}, {"text": "في جسمِك مئتانِ وستُّ عظمات، هي التي تحملُك وأنت واقف.", "start": 3.66, "end": 7.94, "words": [["في", 3.66, 3.77], ["جسمِك", 3.87, 4.23], ["مئتانِ", 4.31, 4.85], ["وستُّ", 4.89, 5.25], ["عظمات،", 5.28, 5.9], ["هي", 6.09, 6.28], ["التي", 6.32, 6.57], ["تحملُك", 6.63, 7.06], ["وأنت", 7.16, 7.42], ["واقف.", 7.49, 7.94]]}, {"text": "في اللحظةِ الأولى، تنهارُ على الأرضِ ككيسٍ ليّن.", "start": 8.23, "end": 11.48, "words": [["في", 8.23, 8.32], ["اللحظةِ", 8.36, 8.75], ["الأولى،", 8.79, 9.32], ["تنهارُ", 9.48, 10.05], ["على", 10.1, 10.22], ["الأرضِ", 10.25, 10.56], ["ككيسٍ", 10.62, 10.99], ["ليّن.", 11.04, 11.48]]}, {"text": "فالعضلاتُ ما زالت تعمل، لكنّها لا تجدُ عظماً تشدُّه.", "start": 11.83, "end": 16.05, "words": [["فالعضلاتُ", 11.83, 12.52], ["ما", 12.57, 12.63], ["زالت", 12.7, 12.92], ["تعمل،", 12.96, 13.47], ["لكنّها", 13.69, 14.13], ["لا", 14.2, 14.28], ["تجدُ", 14.36, 14.7], ["عظماً", 14.78, 15.28], ["تشدُّه.", 15.44, 16.05]]}, {"text": "وفي كلِّ مكانٍ في العالم، يسقطُ ثمانيةُ ملياراتِ إنسانٍ في اللحظةِ نفسِها.", "start": 16.35, "end": 21.32, "words": [["وفي", 16.35, 16.59], ["كلِّ", 16.67, 16.9], ["مكانٍ", 16.95, 17.3], ["في", 17.36, 17.41], ["العالم،", 17.45, 17.96], ["يسقطُ", 18.16, 18.62], ["ثمانيةُ", 18.69, 19.26], ["ملياراتِ", 19.32, 19.81], ["إنسانٍ", 19.88, 20.28], ["في", 20.34, 20.4], ["اللحظةِ", 20.42, 20.79], ["نفسِها.", 20.84, 21.32]]}, {"text": "الجمجمةُ اختفت، فلا شيءَ يحمي الدماغ. والأضلاعُ اختفت، فيصبحُ التنفّسُ صعباً جدّاً.", "start": 21.57, "end": 27.89, "words": [["الجمجمةُ", 21.57, 22.22], ["اختفت،", 22.25, 22.8], ["فلا", 22.91, 23.12], ["شيءَ", 23.19, 23.41], ["يحمي", 23.45, 23.7], ["الدماغ.", 23.72, 24.25], ["والأضلاعُ", 24.57, 25.12], ["اختفت،", 25.15, 25.7], ["فيصبحُ", 25.88, 26.41], ["التنفّسُ", 26.44, 27.05], ["صعباً", 27.12, 27.41], ["جدّاً.", 27.47, 27.89]]}, {"text": "وتختفي أصغرُ ثلاثِ عظماتٍ في الأذن، فيصمتُ العالمُ تقريباً.", "start": 28.16, "end": 32.46, "words": [["وتختفي", 28.16, 28.75], ["أصغرُ", 28.82, 29.21], ["ثلاثِ", 29.28, 29.57], ["عظماتٍ", 29.63, 30.07], ["في", 30.13, 30.19], ["الأذن،", 30.21, 30.74], ["فيصمتُ", 30.91, 31.46], ["العالمُ", 31.5, 31.89], ["تقريباً.", 31.94, 32.46]]}, {"text": "وحتى الدم: نخاعُ العظمِ الذي يصنعُ نحوَ مليونَي خليّةِ دمٍ حمراءَ كلَّ ثانية، اختفى أيضاً.", "start": 32.83, "end": 40.38, "words": [["وحتى", 32.83, 33.22], ["الدم:", 33.24, 33.72], ["نخاعُ", 34.03, 34.47], ["العظمِ", 34.49, 34.89], ["الذي", 34.91, 35.16], ["يصنعُ", 35.23, 35.76], ["نحوَ", 35.99, 36.32], ["مليونَي", 36.36, 36.73], ["خليّةِ", 36.82, 37.2], ["دمٍ", 37.27, 37.51], ["حمراءَ", 37.58, 38.17], ["كلَّ", 38.41, 38.71], ["ثانية،", 38.77, 39.27], ["اختفى", 39.43, 39.94], ["أيضاً.", 39.95, 40.38]]}, {"text": "ثم تعودُ العظامُ بعد خمسِ ثوانٍ، وينهضُ الناسُ عن الأرضِ مذهولين.", "start": 40.8, "end": 45.59, "words": [["ثم", 40.8, 41.04], ["تعودُ", 41.15, 41.47], ["العظامُ", 41.49, 42.01], ["بعد", 42.05, 42.24], ["خمسِ", 42.33, 42.6], ["ثوانٍ،", 42.67, 43.27], ["وينهضُ", 43.49, 44.07], ["الناسُ", 44.09, 44.43], ["عن", 44.5, 44.59], ["الأرضِ", 44.63, 44.94], ["مذهولين.", 44.98, 45.59]]}, {"text": "والمفاجأة: وُلدتَ بنحوِ ثلاثِمئةِ عظمة، ثم التحمَ كثيرٌ منها حتى بقيَ مئتانِ وستّ.", "start": 45.91, "end": 52.7, "words": [["والمفاجأة:", 45.91, 46.92], ["وُلدتَ", 47.11, 47.53], ["بنحوِ", 47.59, 47.91], ["ثلاثِمئةِ", 47.97, 48.55], ["عظمة،", 48.61, 49.1], ["ثم", 49.41, 49.63], ["التحمَ", 49.68, 50.09], ["كثيرٌ", 50.14, 50.52], ["منها", 50.56, 50.89], ["حتى", 50.96, 51.26], ["بقيَ", 51.32, 51.63], ["مئتانِ", 51.68, 52.14], ["وستّ.", 52.19, 52.7]]}, {"text": "لو اختفت عظامُك خمسَ ثوانٍ، أين تتمنّى أن تكون؟ اكتبْ في التعليقات، واشتركْ.", "start": 53.06, "end": 59.44, "words": [["لو", 53.06, 53.21], ["اختفت", 53.24, 53.63], ["عظامُك", 53.71, 54.14], ["خمسَ", 54.31, 54.6], ["ثوانٍ،", 54.67, 55.31], ["أين", 55.51, 55.73], ["تتمنّى", 55.81, 56.24], ["أن", 56.28, 56.37], ["تكون؟", 56.41, 56.97], ["اكتبْ", 57.2, 57.59], ["في", 57.62, 57.67], ["التعليقات،", 57.7, 58.5], ["واشتركْ.", 58.6, 59.44]]}]