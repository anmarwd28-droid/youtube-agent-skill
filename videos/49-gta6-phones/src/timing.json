[{"text": "ماذا لو كانتْ جي تي إيه سِكس تعملُ على كلِّ الهواتف؟ سيلعبُها الناسُ في كلِّ مكان: في الشوارعِ والحافلاتِ والمقاهي.", "start": 0.0, "end": 8.6, "words": [["ماذا", 0.0, 0.31], ["لو", 0.37, 0.48], ["كانتْ", 0.56, 0.86], ["جي", 0.89, 1.08], ["تي", 1.15, 1.35], ["إيه", 1.42, 1.53], ["سِكس", 1.6, 1.89], ["تعملُ", 2.07, 2.44], ["على", 2.48, 2.59], ["كلِّ", 2.66, 2.87], ["الهواتف؟", 2.89, 3.53], ["سيلعبُها", 3.97, 4.53], ["الناسُ", 4.55, 4.87], ["في", 4.91, 4.97], ["كلِّ", 5.04, 5.24], ["مكان:", 5.26, 5.76], ["في", 6.04, 6.14], ["الشوارعِ", 6.18, 6.91], ["والحافلاتِ", 7.12, 7.85], ["والمقاهي.", 7.89, 8.6]]}, {"text": "لكنّها تصدرُ في التاسعَ عشرَ من نوفمبر، على أجهزةِ البلايستيشن والإكسبوكس فقط.", "start": 8.99, "end": 14.23, "words": [["لكنّها", 8.99, 9.44], ["تصدرُ", 9.5, 9.88], ["في", 9.93, 10.0], ["التاسعَ", 10.03, 10.47], ["عشرَ", 10.53, 10.86], ["من", 10.9, 11.01], ["نوفمبر،", 11.04, 11.66], ["على", 11.87, 12.04], ["أجهزةِ", 12.07, 12.54], ["البلايستيشن", 12.57, 13.21], ["والإكسبوكس", 13.25, 13.75], ["فقط.", 13.78, 14.23]]}, {"text": "وحجمُها أكثرُ من مئتي غيغابايت… بينما تأتي هواتفُ كثيرةٌ بمساحةِ مئةٍ وثمانيةٍ وعشرينَ فقط.", "start": 14.56, "end": 22.52, "words": [["وحجمُها", 14.56, 15.22], ["أكثرُ", 15.29, 15.67], ["من", 15.71, 15.82], ["مئتي", 15.87, 16.39], ["غيغابايت…", 16.57, 17.41], ["بينما", 17.74, 18.07], ["تأتي", 18.15, 18.38], ["هواتفُ", 18.45, 18.88], ["كثيرةٌ", 18.94, 19.46], ["بمساحةِ", 19.54, 20.16], ["مئةٍ", 20.21, 20.48], ["وثمانيةٍ", 20.53, 21.0], ["وعشرينَ", 21.05, 21.58], ["فقط.", 21.99, 22.52]]}, {"text": "ومعالجُ الرسومِ في البلايستيشن خمسة أقوى بعدّةِ مرّاتٍ من أقوى الهواتف.", "start": 22.71, "end": 28.0, "words": [["ومعالجُ", 22.71, 23.36], ["الرسومِ", 23.38, 23.85], ["في", 23.88, 23.94], ["البلايستيشن", 23.98, 24.59], ["خمسة", 24.66, 25.03], ["أقوى", 25.09, 25.53], ["بعدّةِ", 25.8, 26.29], ["مرّاتٍ", 26.36, 26.82], ["من", 26.88, 27.0], ["أقوى", 27.05, 27.32], ["الهواتف.", 27.34, 28.0]]}, {"text": "ولو عملتْ على الهاتف، لسخنَ بسرعة، فيُبطئُ نفسَه ليحميَ قِطعَه.", "start": 28.3, "end": 33.12, "words": [["ولو", 28.3, 28.56], ["عملتْ", 28.64, 28.94], ["على", 28.99, 29.09], ["الهاتف،", 29.12, 29.68], ["لسخنَ", 29.86, 30.27], ["بسرعة،", 30.3, 30.87], ["فيُبطئُ", 31.06, 31.54], ["نفسَه", 31.61, 31.96], ["ليحميَ", 32.16, 32.62], ["قِطعَه.", 32.67, 33.12]]}, {"text": "والبلايستيشن يستهلكُ نحوَ مئتي واط أثناءَ اللعب… بهذه القوّة، تفرغُ بطاريةُ الهاتفِ في نحوِ ستِّ دقائق.", "start": 33.41, "end": 41.59, "words": [["والبلايستيشن", 33.41, 34.17], ["يستهلكُ", 34.2, 34.7], ["نحوَ", 34.76, 35.0], ["مئتي", 35.05, 35.41], ["واط", 35.5, 35.79], ["أثناءَ", 36.1, 36.62], ["اللعب…", 36.64, 37.15], ["بهذه", 37.45, 37.81], ["القوّة،", 37.86, 38.43], ["تفرغُ", 38.59, 39.05], ["بطاريةُ", 39.1, 39.66], ["الهاتفِ", 39.68, 40.18], ["في", 40.25, 40.31], ["نحوِ", 40.39, 40.67], ["ستِّ", 40.72, 41.01], ["دقائق.", 41.04, 41.59]]}, {"text": "ولو حمّلَها الملايينُ معاً، لازدحمتْ شبكاتُ الإنترنتِ في العالم.", "start": 41.87, "end": 46.28, "words": [["ولو", 41.87, 42.14], ["حمّلَها", 42.21, 42.7], ["الملايينُ", 42.73, 43.19], ["معاً،", 43.25, 43.66], ["لازدحمتْ", 43.86, 44.51], ["شبكاتُ", 44.56, 45.05], ["الإنترنتِ", 45.07, 45.63], ["في", 45.65, 45.71], ["العالم.", 45.74, 46.28]]}, {"text": "لكنْ هناك حلّ: الألعابُ السحابيّة. اللعبةُ تعملُ على حاسوبٍ بعيد، وهاتفُك يستقبلُ الصورةَ فقط.", "start": 46.6, "end": 54.6, "words": [["لكنْ", 46.6, 46.91], ["هناك", 46.93, 47.2], ["حلّ:", 47.31, 47.77], ["الألعابُ", 48.1, 48.61], ["السحابيّة.", 48.63, 49.48], ["اللعبةُ", 49.87, 50.39], ["تعملُ", 50.46, 50.79], ["على", 50.88, 50.99], ["حاسوبٍ", 51.07, 51.52], ["بعيد،", 51.57, 52.14], ["وهاتفُك", 52.38, 53.01], ["يستقبلُ", 53.1, 53.63], ["الصورةَ", 53.65, 54.06], ["فقط.", 54.11, 54.6]]}, {"text": "والمفاجأة؟ هاتفُك اليومَ أقوى بعدّةِ مرّاتٍ من البلايستيشن ثلاثة، الذي شغّلَ جي تي إيه فايف عامَ ألفينِ وثلاثةَ عشر.", "start": 54.93, "end": 63.99, "words": [["والمفاجأة؟", 54.93, 55.89], ["هاتفُك", 56.22, 56.69], ["اليومَ", 56.76, 57.12], ["أقوى", 57.17, 57.45], ["بعدّةِ", 57.49, 57.99], ["مرّاتٍ", 58.07, 58.54], ["من", 58.57, 58.69], ["البلايستيشن", 58.75, 59.34], ["ثلاثة،", 59.38, 60.01], ["الذي", 60.29, 60.63], ["شغّلَ", 60.71, 61.07], ["جي", 61.15, 61.27], ["تي", 61.3, 61.52], ["إيه", 61.67, 61.78], ["فايف", 61.82, 62.22], ["عامَ", 62.37, 62.64], ["ألفينِ", 62.67, 63.04], ["وثلاثةَ", 63.09, 63.55], ["عشر.", 63.59, 63.99]]}, {"text": "هل ستلعبُها على هاتفِك؟ اكتبْ في التعليقات… واشتركْ.", "start": 64.32, "end": 68.64, "words": [["هل", 64.32, 64.49], ["ستلعبُها", 64.54, 65.18], ["على", 65.22, 65.34], ["هاتفِك؟", 65.39, 65.96], ["اكتبْ", 66.17, 66.54], ["في", 66.56, 66.62], ["التعليقات…", 66.65, 67.51], ["واشتركْ.", 67.76, 68.64]]}]