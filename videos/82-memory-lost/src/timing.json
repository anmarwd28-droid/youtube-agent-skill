[{"text": "ماذا لو نسيَ كلُّ البشرِ ذاكرتَهم فجأةً، في اللحظةِ نفسِها؟", "start": 0.0, "end": 4.35, "words": [["ماذا", 0.0, 0.31], ["لو", 0.37, 0.46], ["نسيَ", 0.53, 0.81], ["كلُّ", 0.87, 1.11], ["البشرِ", 1.14, 1.6], ["ذاكرتَهم", 1.66, 2.23], ["فجأةً،", 2.3, 3.0], ["في", 3.15, 3.24], ["اللحظةِ", 3.26, 3.68], ["نفسِها؟", 3.73, 4.35]]}, {"text": "تستيقظُ صباحاً… لا تعرفُ اسمَك، ولا مَن هؤلاءِ الذين في بيتِك.", "start": 4.68, "end": 9.75, "words": [["تستيقظُ", 4.68, 5.27], ["صباحاً…", 5.35, 6.09], ["لا", 6.42, 6.55], ["تعرفُ", 6.61, 6.99], ["اسمَك،", 7.01, 7.56], ["ولا", 7.77, 8.03], ["مَن", 8.08, 8.19], ["هؤلاءِ", 8.24, 8.66], ["الذين", 8.68, 9.0], ["في", 9.08, 9.15], ["بيتِك.", 9.22, 9.75]]}, {"text": "وفي كلِّ مدنِ العالم، ينظرُ ثمانيةُ ملياراتِ إنسانٍ بعضُهم إلى بعضٍ كالغرباء.", "start": 10.0, "end": 15.71, "words": [["وفي", 10.0, 10.28], ["كلِّ", 10.39, 10.65], ["مدنِ", 10.68, 10.99], ["العالم،", 11.02, 11.62], ["ينظرُ", 11.8, 12.16], ["ثمانيةُ", 12.21, 12.72], ["ملياراتِ", 12.77, 13.29], ["إنسانٍ", 13.35, 13.83], ["بعضُهم", 13.9, 14.33], ["إلى", 14.41, 14.55], ["بعضٍ", 14.62, 14.87], ["كالغرباء.", 14.93, 15.71]]}, {"text": "كلماتُ السرِّ ضاعت، فتُقفَلُ الهواتفُ والحساباتُ المصرفيّة.", "start": 16.03, "end": 20.46, "words": [["كلماتُ", 16.03, 16.51], ["السرِّ", 16.53, 16.9], ["ضاعت،", 16.96, 17.55], ["فتُقفَلُ", 17.73, 18.31], ["الهواتفُ", 18.33, 18.98], ["والحساباتُ", 19.02, 19.67], ["المصرفيّة.", 19.69, 20.46]]}, {"text": "والطبيبُ لا يتذكّرُ ما درسَه، والمهندسُ لا يعرفُ كيف تعملُ آلاتُه.", "start": 20.78, "end": 25.4, "words": [["والطبيبُ", 20.78, 21.29], ["لا", 21.35, 21.43], ["يتذكّرُ", 21.48, 22.05], ["ما", 22.08, 22.15], ["درسَه،", 22.21, 22.74], ["والمهندسُ", 22.89, 23.59], ["لا", 23.66, 23.72], ["يعرفُ", 23.78, 24.12], ["كيف", 24.18, 24.37], ["تعملُ", 24.45, 24.8], ["آلاتُه.", 24.86, 25.4]]}, {"text": "لكنّ المعرفةَ لم تضِعْ كلُّها، فهي محفوظةٌ في ملايينِ الكتبِ وفي الإنترنت.", "start": 25.73, "end": 31.09, "words": [["لكنّ", 25.73, 26.09], ["المعرفةَ", 26.12, 26.68], ["لم", 26.73, 26.84], ["تضِعْ", 26.91, 27.2], ["كلُّها،", 27.24, 27.79], ["فهي", 27.97, 28.21], ["محفوظةٌ", 28.26, 28.84], ["في", 28.91, 28.98], ["ملايينِ", 29.06, 29.42], ["الكتبِ", 29.44, 30.0], ["وفي", 30.17, 30.41], ["الإنترنت.", 30.43, 31.09]]}, {"text": "والمفاجأة: ستظلُّ تمشي وتتكلّمُ وتقرأ، وربّما تقودُ درّاجتَك!", "start": 31.42, "end": 36.81, "words": [["والمفاجأة:", 31.42, 32.29], ["ستظلُّ", 32.5, 33.06], ["تمشي", 33.11, 33.42], ["وتتكلّمُ", 33.46, 34.21], ["وتقرأ،", 34.24, 34.86], ["وربّما", 35.02, 35.58], ["تقودُ", 35.65, 36.04], ["درّاجتَك!", 36.09, 36.81]]}, {"text": "فدماغُك يحفظُ المهاراتِ في مناطقَ غيرِ التي يحفظُ فيها ذكرياتِ حياتِك.", "start": 37.09, "end": 42.42, "words": [["فدماغُك", 37.09, 37.74], ["يحفظُ", 37.86, 38.24], ["المهاراتِ", 38.27, 38.87], ["في", 38.89, 38.95], ["مناطقَ", 39.03, 39.51], ["غيرِ", 39.58, 39.86], ["التي", 39.88, 40.15], ["يحفظُ", 40.2, 40.59], ["فيها", 40.65, 41.03], ["ذكرياتِ", 41.27, 41.77], ["حياتِك.", 41.85, 42.42]]}, {"text": "وهذا ما حدثَ للموسيقيِّ كلايف ويرينغ: نسيَ حياتَه كلَّها، لكنّه ظلَّ يعزفُ البيانو.", "start": 42.93, "end": 50.29, "words": [["وهذا", 42.93, 43.21], ["ما", 43.26, 43.33], ["حدثَ", 43.4, 43.76], ["للموسيقيِّ", 43.82, 44.64], ["كلايف", 44.97, 45.41], ["ويرينغ:", 45.49, 46.09], ["نسيَ", 46.48, 46.86], ["حياتَه", 46.92, 47.33], ["كلَّها،", 47.43, 48.01], ["لكنّه", 48.25, 48.67], ["ظلَّ", 48.78, 49.08], ["يعزفُ", 49.12, 49.59], ["البيانو.", 49.62, 50.29]]}, {"text": "لو نسيتَ كلَّ شيء، ما أوّلُ شيءٍ تتمنّى أن تتذكّرَه؟ اكتبْ في التعليقات، واشتركْ.", "start": 50.62, "end": 57.45, "words": [["لو", 50.62, 50.78], ["نسيتَ", 50.85, 51.26], ["كلَّ", 51.33, 51.56], ["شيء،", 51.62, 52.05], ["ما", 52.26, 52.37], ["أوّلُ", 52.43, 52.73], ["شيءٍ", 52.8, 53.08], ["تتمنّى", 53.16, 53.8], ["أن", 53.85, 53.96], ["تتذكّرَه؟", 54.03, 54.9], ["اكتبْ", 55.23, 55.66], ["في", 55.68, 55.74], ["التعليقات،", 55.77, 56.56], ["واشتركْ.", 56.62, 57.45]]}]