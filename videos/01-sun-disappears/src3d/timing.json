[{"text": "ماذا لو اختفَتِ الشمسُ الآن… فجأة؟", "start": 0.0, "end": 2.38, "words": [["ماذا", 0.0, 0.23], ["لو", 0.28, 0.38], ["اختفَتِ", 0.41, 0.76], ["الشمسُ", 0.78, 1.1], ["الآن…", 1.13, 1.59], ["فجأة؟", 1.87, 2.38]]}, {"text": "لن تلاحظَ شيئاً… لثماني دقائق.", "start": 2.61, "end": 4.91, "words": [["لن", 2.61, 2.75], ["تلاحظَ", 2.8, 3.16], ["شيئاً…", 3.22, 3.7], ["لثماني", 3.94, 4.37], ["دقائق.", 4.4, 4.91]]}, {"text": "لأنّ ضوءَها يحتاجُ ثماني دقائقَ ليصلَ إلينا.", "start": 5.18, "end": 8.09, "words": [["لأنّ", 5.18, 5.43], ["ضوءَها", 5.49, 5.77], ["يحتاجُ", 5.82, 6.19], ["ثماني", 6.26, 6.56], ["دقائقَ", 6.61, 7.13], ["ليصلَ", 7.2, 7.62], ["إلينا.", 7.64, 8.09]]}, {"text": "ثمّ… ظلامٌ تامّ. حتى القمرُ ينطفئ.", "start": 8.36, "end": 11.68, "words": [["ثمّ…", 8.36, 8.85], ["ظلامٌ", 9.12, 9.53], ["تامّ.", 9.6, 10.01], ["حتى", 10.29, 10.58], ["القمرُ", 10.61, 11.08], ["ينطفئ.", 11.11, 11.68]]}, {"text": "وتنطلقُ الأرضُ في الفضاء… بلا مدار.", "start": 11.95, "end": 14.68, "words": [["وتنطلقُ", 11.95, 12.55], ["الأرضُ", 12.59, 12.93], ["في", 12.99, 13.05], ["الفضاء…", 13.07, 13.63], ["بلا", 13.96, 14.15], ["مدار.", 14.19, 14.68]]}, {"text": "بعدَ أسبوع… ثمانيَ عشرةَ درجةً تحتَ الصفر.", "start": 15.0, "end": 18.31, "words": [["بعدَ", 15.0, 15.24], ["أسبوع…", 15.27, 15.8], ["ثمانيَ", 16.08, 16.49], ["عشرةَ", 16.54, 16.95], ["درجةً", 17.01, 17.47], ["تحتَ", 17.58, 17.81], ["الصفر.", 17.83, 18.31]]}, {"text": "بعدَ سنة… أكثرُ من سبعين. وتتجمّدُ البحار.", "start": 18.57, "end": 22.19, "words": [["بعدَ", 18.57, 18.83], ["سنة…", 18.9, 19.28], ["أكثرُ", 19.55, 19.89], ["من", 19.93, 19.98], ["سبعين.", 20.03, 20.49], ["وتتجمّدُ", 20.7, 21.51], ["البحار.", 21.55, 22.19]]}, {"text": "لكنّ الحياةَ قد تنجو… في أعماقِ المحيط، قربَ حرارةِ باطنِ الأرض.", "start": 22.51, "end": 27.8, "words": [["لكنّ", 22.51, 22.87], ["الحياةَ", 22.91, 23.34], ["قد", 23.39, 23.52], ["تنجو…", 23.56, 24.1], ["في", 24.43, 24.55], ["أعماقِ", 24.61, 25.08], ["المحيط،", 25.1, 25.81], ["قربَ", 26.02, 26.32], ["حرارةِ", 26.38, 26.88], ["باطنِ", 26.95, 27.28], ["الأرض.", 27.32, 27.8]]}, {"text": "ماذا لو؟ اكتبْ سؤالَك في التعليقات.", "start": 28.13, "end": 31.11, "words": [["ماذا", 28.13, 28.42], ["لو؟", 28.48, 28.87], ["اكتبْ", 29.15, 29.54], ["سؤالَك", 29.56, 29.96], ["في", 30.08, 30.14], ["التعليقات.", 30.16, 31.11]]}]