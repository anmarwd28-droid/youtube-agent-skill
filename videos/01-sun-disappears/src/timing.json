[{"text": "ماذا لو اختفَتِ الشمسُ الآن… فجأة؟", "start": 0.0, "end": 2.76, "words": [["ماذا", 0.0, 0.27], ["لو", 0.3, 0.42], ["اختفَتِ", 0.44, 0.86], ["الشمسُ", 0.88, 1.26], ["الآن…", 1.29, 1.88], ["فجأة؟", 2.18, 2.76]]}, {"text": "الغريب؟ لن تلاحظَ شيئاً… لثماني دقائقَ كاملة.", "start": 3.06, "end": 7.15, "words": [["الغريب؟", 3.06, 3.65], ["لن", 4.0, 4.16], ["تلاحظَ", 4.2, 4.66], ["شيئاً…", 4.72, 5.39], ["لثماني", 5.61, 6.08], ["دقائقَ", 6.13, 6.61], ["كاملة.", 6.66, 7.15]]}, {"text": "لأنّ ضوءَ الشمسِ يحتاجُ ثماني دقائقَ تقريباً ليصلَ إلينا. وحتى جاذبيتُها… تحتاجُ الوقتَ نفسَه.", "start": 7.5, "end": 14.07, "words": [["لأنّ", 7.5, 7.78], ["ضوءَ", 7.84, 8.05], ["الشمسِ", 8.06, 8.44], ["يحتاجُ", 8.46, 8.82], ["ثماني", 8.88, 9.15], ["دقائقَ", 9.18, 9.65], ["تقريباً", 9.69, 10.1], ["ليصلَ", 10.12, 10.45], ["إلينا.", 10.48, 10.96], ["وحتى", 11.26, 11.64], ["جاذبيتُها…", 11.73, 12.64], ["تحتاجُ", 12.84, 13.26], ["الوقتَ", 13.28, 13.57], ["نفسَه.", 13.62, 14.07]]}, {"text": "ثمّ… ظلامٌ تامّ. ويختفي القمرُ أيضاً، لأنّه يعكسُ ضوءَ الشمسِ فقط.", "start": 14.42, "end": 20.19, "words": [["ثمّ…", 14.42, 15.08], ["ظلامٌ", 15.3, 15.67], ["تامّ.", 15.77, 16.18], ["ويختفي", 16.59, 17.11], ["القمرُ", 17.15, 17.55], ["أيضاً،", 17.59, 18.07], ["لأنّه", 18.23, 18.53], ["يعكسُ", 18.6, 19.01], ["ضوءَ", 19.08, 19.3], ["الشمسِ", 19.32, 19.66], ["فقط.", 19.71, 20.19]]}, {"text": "وتنطلقُ الأرضُ خارجَ مدارِها، في خطٍّ مستقيم… بسرعةِ ثلاثينَ كيلومتراً في الثانية.", "start": 20.49, "end": 26.84, "words": [["وتنطلقُ", 20.49, 21.12], ["الأرضُ", 21.14, 21.48], ["خارجَ", 21.55, 21.85], ["مدارِها،", 21.89, 22.54], ["في", 22.71, 22.84], ["خطٍّ", 22.93, 23.28], ["مستقيم…", 23.3, 24.18], ["بسرعةِ", 24.51, 25.04], ["ثلاثينَ", 25.11, 25.57], ["كيلومتراً", 25.62, 26.11], ["في", 26.17, 26.23], ["الثانية.", 26.26, 26.84]]}, {"text": "بعدَ أسبوع… تنخفضُ الحرارةُ إلى نحوِ ثمانيَ عشرةَ درجةً تحتَ الصفر.", "start": 27.17, "end": 32.44, "words": [["بعدَ", 27.17, 27.46], ["أسبوع…", 27.48, 28.16], ["تنخفضُ", 28.48, 29.06], ["الحرارةُ", 29.09, 29.65], ["إلى", 29.72, 29.85], ["نحوِ", 29.92, 30.16], ["ثمانيَ", 30.22, 30.63], ["عشرةَ", 30.65, 31.06], ["درجةً", 31.11, 31.58], ["تحتَ", 31.64, 31.86], ["الصفر.", 31.89, 32.44]]}, {"text": "وبعدَ سنة… أكثرُ من سبعينَ درجةً تحتَ الصفر، وتتجمّدُ سطوحُ المحيطات.", "start": 32.76, "end": 38.53, "words": [["وبعدَ", 32.76, 33.22], ["سنة…", 33.27, 33.76], ["أكثرُ", 34.01, 34.41], ["من", 34.45, 34.53], ["سبعينَ", 34.59, 34.91], ["درجةً", 34.97, 35.41], ["تحتَ", 35.46, 35.68], ["الصفر،", 35.7, 36.21], ["وتتجمّدُ", 36.54, 37.36], ["سطوحُ", 37.41, 37.79], ["المحيطات.", 37.81, 38.53]]}, {"text": "لكنّ أعماقَها ستبقى دافئةً لزمنٍ طويل، بفضلِ حرارةِ باطنِ الأرض… وقد تنجو فيها بعضُ الكائنات.", "start": 38.92, "end": 46.74, "words": [["لكنّ", 38.92, 39.31], ["أعماقَها", 39.35, 39.87], ["ستبقى", 39.94, 40.37], ["دافئةً", 40.41, 41.04], ["لزمنٍ", 41.1, 41.51], ["طويل،", 41.58, 42.13], ["بفضلِ", 42.38, 42.81], ["حرارةِ", 42.87, 43.33], ["باطنِ", 43.4, 43.72], ["الأرض…", 43.76, 44.41], ["وقد", 44.73, 45.07], ["تنجو", 45.12, 45.45], ["فيها", 45.5, 45.74], ["بعضُ", 45.8, 46.05], ["الكائنات.", 46.07, 46.74]]}, {"text": "لا تقلق… فأمامَ الشمسِ نحوُ خمسةِ ملياراتِ سنة.", "start": 46.92, "end": 50.79, "words": [["لا", 46.92, 47.04], ["تقلق…", 47.11, 47.7], ["فأمامَ", 48.08, 48.55], ["الشمسِ", 48.58, 48.99], ["نحوُ", 49.05, 49.31], ["خمسةِ", 49.35, 49.76], ["ملياراتِ", 49.82, 50.32], ["سنة.", 50.38, 50.79]]}, {"text": "والآن… ماذا لو؟ اكتبْ سؤالَك في التعليقات.", "start": 51.12, "end": 54.99, "words": [["والآن…", 51.12, 51.87], ["ماذا", 52.15, 52.42], ["لو؟", 52.48, 52.84], ["اكتبْ", 53.08, 53.47], ["سؤالَك", 53.49, 53.86], ["في", 53.98, 54.03], ["التعليقات.", 54.06, 54.99]]}]