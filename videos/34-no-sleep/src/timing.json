[{"text": "ماذا لو لم تنمْ عشرةَ أيّامٍ متواصلة؟", "start": 0.0, "end": 2.73, "words": [["ماذا", 0.0, 0.3], ["لو", 0.35, 0.48], ["لم", 0.53, 0.65], ["تنمْ", 0.73, 1.07], ["عشرةَ", 1.1, 1.49], ["أيّامٍ", 1.52, 1.92], ["متواصلة؟", 1.94, 2.73]]}, {"text": "بعدَ ليلةٍ واحدة، تقلُّ قدرتُك على حفظِ المعلوماتِ الجديدةِ بنحوِ أربعينَ بالمئة.", "start": 3.1, "end": 9.0, "words": [["بعدَ", 3.1, 3.37], ["ليلةٍ", 3.41, 3.75], ["واحدة،", 3.83, 4.46], ["تقلُّ", 4.62, 5.02], ["قدرتُك", 5.06, 5.56], ["على", 5.69, 5.83], ["حفظِ", 5.9, 6.13], ["المعلوماتِ", 6.15, 6.68], ["الجديدةِ", 6.71, 7.31], ["بنحوِ", 7.55, 7.96], ["أربعينَ", 8.0, 8.44], ["بالمئة.", 8.5, 9.0]]}, {"text": "لأنّ دماغَك ينظّفُ نفسَه من الفضلاتِ وأنتَ نائم… وبدونِ نومٍ تتراكمُ فيه.", "start": 9.36, "end": 14.99, "words": [["لأنّ", 9.36, 9.62], ["دماغَك", 9.67, 10.11], ["ينظّفُ", 10.23, 10.68], ["نفسَه", 10.74, 11.03], ["من", 11.11, 11.2], ["الفضلاتِ", 11.24, 11.8], ["وأنتَ", 11.82, 12.09], ["نائم…", 12.13, 12.62], ["وبدونِ", 12.99, 13.5], ["نومٍ", 13.55, 13.87], ["تتراكمُ", 13.99, 14.57], ["فيه.", 14.63, 14.99]]}, {"text": "في اليومِ الثاني، يبدأُ دماغُك بالنومِ رغماً عنك: غفواتٌ لثوانٍ… وعيناكَ مفتوحتان.", "start": 15.35, "end": 21.82, "words": [["في", 15.35, 15.44], ["اليومِ", 15.46, 15.74], ["الثاني،", 15.77, 16.32], ["يبدأُ", 16.5, 16.85], ["دماغُك", 16.89, 17.28], ["بالنومِ", 17.39, 17.77], ["رغماً", 17.83, 18.11], ["عنك:", 18.16, 18.59], ["غفواتٌ", 18.86, 19.39], ["لثوانٍ…", 19.42, 20.19], ["وعيناكَ", 20.43, 20.92], ["مفتوحتان.", 20.97, 21.82]]}, {"text": "ومناعتُك تضعف: فمَن ينامُ أقلَّ من ستِّ ساعاتٍ يُصابُ بالزكامِ أكثرَ بأربعِ مرّات.", "start": 22.14, "end": 27.93, "words": [["ومناعتُك", 22.14, 22.86], ["تضعف:", 22.94, 23.49], ["فمَن", 23.66, 23.92], ["ينامُ", 23.98, 24.3], ["أقلَّ", 24.35, 24.67], ["من", 24.71, 24.8], ["ستِّ", 24.83, 25.09], ["ساعاتٍ", 25.12, 25.55], ["يُصابُ", 25.61, 26.02], ["بالزكامِ", 26.07, 26.62], ["أكثرَ", 26.66, 26.98], ["بأربعِ", 27.03, 27.41], ["مرّات.", 27.45, 27.93]]}, {"text": "بعدَ ثلاثةِ أيّام، تبدأُ الهلوسة: ترى أشخاصاً وأشياءَ ليستْ موجودة.", "start": 28.32, "end": 33.24, "words": [["بعدَ", 28.32, 28.56], ["ثلاثةِ", 28.62, 29.05], ["أيّام،", 29.08, 29.63], ["تبدأُ", 29.84, 30.19], ["الهلوسة:", 30.21, 30.84], ["ترى", 31.08, 31.3], ["أشخاصاً", 31.35, 31.85], ["وأشياءَ", 31.89, 32.31], ["ليستْ", 32.36, 32.65], ["موجودة.", 32.68, 33.24]]}, {"text": "وفي الأيّامِ الأخيرة: اطرحْ سبعةً من مئة… وستتوقّفُ عندَ خمسةٍ وستّين، وقد نسيتَ ماذا كنتَ تفعل.", "start": 33.56, "end": 41.45, "words": [["وفي", 33.56, 33.78], ["الأيّامِ", 33.81, 34.22], ["الأخيرة:", 34.24, 34.9], ["اطرحْ", 35.07, 35.48], ["سبعةً", 35.5, 35.96], ["من", 35.99, 36.1], ["مئة…", 36.13, 36.58], ["وستتوقّفُ", 36.83, 37.76], ["عندَ", 37.8, 37.98], ["خمسةٍ", 38.05, 38.45], ["وستّين،", 38.52, 39.31], ["وقد", 39.49, 39.82], ["نسيتَ", 39.88, 40.26], ["ماذا", 40.33, 40.54], ["كنتَ", 40.6, 40.86], ["تفعل.", 40.91, 41.45]]}, {"text": "والغريب؟ طالبٌ في السابعةَ عشرةَ بقيَ أحدَ عشرَ يوماً بلا نوم… ثمّ نامَ أربعَ عشرةَ ساعةً فقط، واستيقظَ بخير.", "start": 41.83, "end": 51.59, "words": [["والغريب؟", 41.83, 42.67], ["طالبٌ", 42.91, 43.33], ["في", 43.39, 43.46], ["السابعةَ", 43.48, 44.06], ["عشرةَ", 44.12, 44.76], ["بقيَ", 45.08, 45.49], ["أحدَ", 45.53, 45.89], ["عشرَ", 45.94, 46.27], ["يوماً", 46.31, 46.63], ["بلا", 46.67, 46.87], ["نوم…", 46.93, 47.39], ["ثمّ", 47.77, 48.03], ["نامَ", 48.1, 48.31], ["أربعَ", 48.36, 48.7], ["عشرةَ", 48.73, 49.16], ["ساعةً", 49.23, 49.64], ["فقط،", 49.7, 50.25], ["واستيقظَ", 50.4, 51.01], ["بخير.", 51.06, 51.59]]}, {"text": "كم ساعةً تنامُ أنت؟ اكتبْ في التعليقات… واشتركْ.", "start": 52.04, "end": 56.15, "words": [["كم", 52.04, 52.22], ["ساعةً", 52.29, 52.65], ["تنامُ", 52.69, 53.01], ["أنت؟", 53.06, 53.46], ["اكتبْ", 53.58, 53.93], ["في", 53.95, 54.02], ["التعليقات…", 54.06, 54.94], ["واشتركْ.", 55.26, 56.15]]}]