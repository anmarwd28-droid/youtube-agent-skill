[{"text": "ماذا لو اختفى القمرُ… الليلة؟", "start": 0.0, "end": 2.71, "words": [["ماذا", 0.0, 0.33], ["لو", 0.37, 0.51], ["اختفى", 0.55, 0.92], ["القمرُ…", 0.94, 1.74], ["الليلة؟", 2.07, 2.71]]}, {"text": "لن يسقطَ شيءٌ من السماء. لكنّ كلَّ ليلةٍ ستصبحُ مظلمةً تماماً… وتظهرُ آلافُ النجومِ أوضحَ من أيِّ وقتٍ مضى.", "start": 3.03, "end": 11.45, "words": [["لن", 3.03, 3.2], ["يسقطَ", 3.26, 3.68], ["شيءٌ", 3.74, 4.02], ["من", 4.05, 4.17], ["السماء.", 4.23, 4.77], ["لكنّ", 5.1, 5.48], ["كلَّ", 5.55, 5.78], ["ليلةٍ", 5.83, 6.26], ["ستصبحُ", 6.34, 6.88], ["مظلمةً", 6.92, 7.48], ["تماماً…", 7.54, 8.12], ["وتظهرُ", 8.44, 8.97], ["آلافُ", 9.04, 9.39], ["النجومِ", 9.42, 9.88], ["أوضحَ", 9.93, 10.32], ["من", 10.34, 10.44], ["أيِّ", 10.47, 10.7], ["وقتٍ", 10.74, 11.01], ["مضى.", 11.05, 11.45]]}, {"text": "وهذا الظلامُ يُربكُ الحيوانات. فبعضُها يصطادُ على ضوءِ القمر، وبعضُها يختبئُ منه.", "start": 11.77, "end": 17.93, "words": [["وهذا", 11.77, 12.14], ["الظلامُ", 12.17, 12.6], ["يُربكُ", 12.63, 12.96], ["الحيوانات.", 12.98, 13.76], ["فبعضُها", 14.08, 14.65], ["يصطادُ", 14.73, 15.15], ["على", 15.21, 15.31], ["ضوءِ", 15.38, 15.59], ["القمر،", 15.62, 16.23], ["وبعضُها", 16.44, 17.0], ["يختبئُ", 17.07, 17.55], ["منه.", 17.6, 17.93]]}, {"text": "والشعابُ المرجانيةُ تعتمدُ على القمر، لتعرفَ متى تطلقُ بيوضَها كلَّها في ليلةٍ واحدة.", "start": 18.37, "end": 24.14, "words": [["والشعابُ", 18.37, 18.87], ["المرجانيةُ", 18.89, 19.59], ["تعتمدُ", 19.64, 20.11], ["على", 20.17, 20.27], ["القمر،", 20.31, 20.88], ["لتعرفَ", 21.11, 21.61], ["متى", 21.65, 21.84], ["تطلقُ", 21.91, 22.3], ["بيوضَها", 22.36, 22.76], ["كلَّها", 22.8, 23.15], ["في", 23.21, 23.28], ["ليلةٍ", 23.32, 23.64], ["واحدة.", 23.7, 24.14]]}, {"text": "ثمّ البحر. فالقمرُ هو المسؤولُ الأكبرُ عن المدِّ والجزر. وبدونِه، يضعفُ المدُّ إلى نحوِ الثلث.", "start": 24.45, "end": 31.48, "words": [["ثمّ", 24.45, 24.71], ["البحر.", 24.73, 25.25], ["فالقمرُ", 25.57, 26.08], ["هو", 26.12, 26.23], ["المسؤولُ", 26.25, 26.69], ["الأكبرُ", 26.73, 27.21], ["عن", 27.27, 27.39], ["المدِّ", 27.42, 27.76], ["والجزر.", 27.78, 28.38], ["وبدونِه،", 28.69, 29.44], ["يضعفُ", 29.66, 30.12], ["المدُّ", 30.14, 30.51], ["إلى", 30.53, 30.65], ["نحوِ", 30.72, 30.96], ["الثلث.", 30.98, 31.48]]}, {"text": "لكنّ الخطرَ الأكبرَ أبطأُ بكثير.", "start": 31.79, "end": 34.46, "words": [["لكنّ", 31.79, 32.12], ["الخطرَ", 32.15, 32.53], ["الأكبرَ", 32.55, 33.19], ["أبطأُ", 33.42, 33.81], ["بكثير.", 33.85, 34.46]]}, {"text": "فالقمرُ يثبّتُ ميلَ الأرض، مثلَ يدٍ تُمسكُ دوّامةً تدور.", "start": 34.77, "end": 38.94, "words": [["فالقمرُ", 34.77, 35.3], ["يثبّتُ", 35.34, 35.9], ["ميلَ", 35.94, 36.13], ["الأرض،", 36.16, 36.68], ["مثلَ", 36.84, 37.14], ["يدٍ", 37.2, 37.42], ["تُمسكُ", 37.48, 37.86], ["دوّامةً", 37.92, 38.35], ["تدور.", 38.43, 38.94]]}, {"text": "وبدونِه، قد يتأرجحُ هذا الميلُ على مدى ملايينِ السنين… فتنقلبُ الفصول: صيفٌ حارق، وشتاءٌ جليديٌّ طويل.", "start": 39.27, "end": 48.26, "words": [["وبدونِه،", 39.27, 39.9], ["قد", 40.08, 40.24], ["يتأرجحُ", 40.3, 40.94], ["هذا", 40.97, 41.16], ["الميلُ", 41.19, 41.63], ["على", 41.84, 42.04], ["مدى", 42.11, 42.28], ["ملايينِ", 42.34, 42.74], ["السنين…", 42.76, 43.36], ["فتنقلبُ", 43.75, 44.44], ["الفصول:", 44.47, 45.19], ["صيفٌ", 45.51, 45.85], ["حارق،", 45.93, 46.46], ["وشتاءٌ", 46.61, 47.2], ["جليديٌّ", 47.26, 47.73], ["طويل.", 47.76, 48.26]]}, {"text": "القمرُ ليسَ مجرّدَ ضوءٍ في السماء… إنّه حارسُ الأرضِ الصامت.", "start": 48.7, "end": 53.01, "words": [["القمرُ", 48.7, 49.22], ["ليسَ", 49.26, 49.47], ["مجرّدَ", 49.52, 50.02], ["ضوءٍ", 50.07, 50.32], ["في", 50.38, 50.43], ["السماء…", 50.47, 51.05], ["إنّه", 51.33, 51.63], ["حارسُ", 51.71, 52.05], ["الأرضِ", 52.07, 52.38], ["الصامت.", 52.41, 53.01]]}, {"text": "والآن دورُك: ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 53.34, "end": 59.44, "words": [["والآن", 53.34, 53.71], ["دورُك:", 53.77, 54.3], ["ماذا", 54.47, 54.73], ["لو…؟", 54.78, 55.37], ["اكتبْ", 55.65, 56.05], ["سؤالَك", 56.09, 56.48], ["في", 56.54, 56.6], ["التعليقات،", 56.62, 57.44], ["وقد", 57.59, 57.93], ["يكونُ", 58.0, 58.32], ["الفيديو", 58.34, 58.69], ["القادم.", 58.71, 59.44]]}]