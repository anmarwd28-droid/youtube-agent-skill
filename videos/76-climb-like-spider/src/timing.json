[{"text": "ماذا لو استطعتَ تسلّقَ الجدرانِ مثلَ العنكبوت؟", "start": 0.0, "end": 3.26, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.46], ["استطعتَ", 0.5, 1.01], ["تسلّقَ", 1.07, 1.6], ["الجدرانِ", 1.62, 2.19], ["مثلَ", 2.23, 2.46], ["العنكبوت؟", 2.5, 3.26]]}, {"text": "تصعدُ ناطحةَ سحابٍ بيديك، وتمشي على السقف، ولا تنتظرُ المصعدَ بعدَ اليوم.", "start": 3.61, "end": 9.54, "words": [["تصعدُ", 3.61, 4.08], ["ناطحةَ", 4.14, 4.63], ["سحابٍ", 4.7, 5.13], ["بيديك،", 5.2, 5.84], ["وتمشي", 6.03, 6.46], ["على", 6.5, 6.62], ["السقف،", 6.65, 7.23], ["ولا", 7.46, 7.69], ["تنتظرُ", 7.75, 8.29], ["المصعدَ", 8.31, 8.81], ["بعدَ", 8.87, 9.07], ["اليوم.", 9.1, 9.54]]}, {"text": "سرُّ العنكبوتِ في أطرافِ أرجلِه: آلافُ الشُّعيراتِ الدقيقة.", "start": 9.95, "end": 14.2, "words": [["سرُّ", 9.95, 10.25], ["العنكبوتِ", 10.26, 10.91], ["في", 10.97, 11.03], ["أطرافِ", 11.09, 11.45], ["أرجلِه:", 11.48, 11.99], ["آلافُ", 12.4, 12.83], ["الشُّعيراتِ", 12.85, 13.5], ["الدقيقة.", 13.53, 14.2]]}, {"text": "وكلُّ شُعيرةٍ تتفرّعُ إلى أطرافٍ أصغر، تلتصقُ بالجدارِ بقوّةِ جذبٍ ضعيفةٍ بينَ الجزيئات.", "start": 14.5, "end": 21.48, "words": [["وكلُّ", 14.5, 14.93], ["شُعيرةٍ", 14.96, 15.46], ["تتفرّعُ", 15.56, 16.16], ["إلى", 16.17, 16.29], ["أطرافٍ", 16.32, 16.71], ["أصغر،", 16.77, 17.33], ["تلتصقُ", 17.64, 18.2], ["بالجدارِ", 18.26, 18.75], ["بقوّةِ", 18.8, 19.31], ["جذبٍ", 19.38, 19.73], ["ضعيفةٍ", 19.78, 20.33], ["بينَ", 20.47, 20.72], ["الجزيئات.", 20.75, 21.48]]}, {"text": "لكنّها معاً تحملُ وزناً أثقلَ من العنكبوتِ بمئةٍ وسبعينَ مرّة.", "start": 21.83, "end": 26.25, "words": [["لكنّها", 21.83, 22.29], ["معاً", 22.35, 22.62], ["تحملُ", 22.71, 23.09], ["وزناً", 23.15, 23.51], ["أثقلَ", 23.56, 23.95], ["من", 24.0, 24.09], ["العنكبوتِ", 24.14, 24.71], ["بمئةٍ", 24.73, 25.26], ["وسبعينَ", 25.32, 25.79], ["مرّة.", 25.82, 26.25]]}, {"text": "فهل يكفيك هذا؟ لا. فأنتَ أثقلُ من العنكبوتِ بملايينِ المرّات،", "start": 26.5, "end": 31.51, "words": [["فهل", 26.5, 26.76], ["يكفيك", 26.81, 27.12], ["هذا؟", 27.23, 27.68], ["لا.", 27.97, 28.37], ["فأنتَ", 28.63, 29.02], ["أثقلُ", 29.08, 29.48], ["من", 29.51, 29.62], ["العنكبوتِ", 29.66, 30.24], ["بملايينِ", 30.27, 30.84], ["المرّات،", 30.86, 31.51]]}, {"text": "وكلّما كبرَ الجسم، زادَ وزنُه أسرعَ بكثيرٍ من مساحةِ جلدِه.", "start": 31.76, "end": 36.36, "words": [["وكلّما", 31.76, 32.34], ["كبرَ", 32.45, 32.76], ["الجسم،", 32.79, 33.4], ["زادَ", 33.63, 33.92], ["وزنُه", 33.99, 34.37], ["أسرعَ", 34.46, 34.8], ["بكثيرٍ", 34.82, 35.29], ["من", 35.33, 35.42], ["مساحةِ", 35.46, 35.9], ["جلدِه.", 35.97, 36.36]]}, {"text": "لذلك ستحتاجُ وسائدَ لاصقةً تغطّي أربعينَ بالمئةِ من جسمِك… أو حذاءً مقاسُه مئةٌ وخمسةٌ وأربعون!", "start": 36.77, "end": 43.93, "words": [["لذلك", 36.77, 37.19], ["ستحتاجُ", 37.22, 37.74], ["وسائدَ", 37.77, 38.25], ["لاصقةً", 38.29, 38.78], ["تغطّي", 39.0, 39.39], ["أربعينَ", 39.43, 39.81], ["بالمئةِ", 39.87, 40.22], ["من", 40.25, 40.32], ["جسمِك…", 40.34, 40.82], ["أو", 41.13, 41.27], ["حذاءً", 41.33, 41.73], ["مقاسُه", 41.76, 42.25], ["مئةٌ", 42.32, 42.68], ["وخمسةٌ", 42.74, 43.22], ["وأربعون!", 43.3, 43.93]]}, {"text": "والغبارُ والماءُ يُضعفانِ الالتصاق، فقد تنزلقُ في منتصفِ الطريق.", "start": 44.24, "end": 48.59, "words": [["والغبارُ", 44.24, 44.8], ["والماءُ", 44.81, 45.21], ["يُضعفانِ", 45.26, 45.75], ["الالتصاق،", 45.78, 46.54], ["فقد", 46.72, 47.01], ["تنزلقُ", 47.04, 47.52], ["في", 47.58, 47.63], ["منتصفِ", 47.7, 48.13], ["الطريق.", 48.16, 48.59]]}, {"text": "والمفاجأة: صنعَ العلماءُ وسائدَ تقلّدُ أقدامَ الوزَغ، وتسلّقَ بها إنسانٌ جداراً من الزجاج!", "start": 49.01, "end": 56.32, "words": [["والمفاجأة:", 49.01, 49.89], ["صنعَ", 50.2, 50.5], ["العلماءُ", 50.53, 51.12], ["وسائدَ", 51.14, 51.68], ["تقلّدُ", 51.73, 52.26], ["أقدامَ", 52.3, 52.71], ["الوزَغ،", 52.73, 53.36], ["وتسلّقَ", 53.56, 54.25], ["بها", 54.31, 54.48], ["إنسانٌ", 54.55, 54.96], ["جداراً", 55.08, 55.49], ["من", 55.53, 55.63], ["الزجاج!", 55.69, 56.32]]}, {"text": "هل كنتَ ستتسلّقُ ناطحاتِ السحاب؟ اكتبْ في التعليقات، واشتركْ.", "start": 56.63, "end": 61.86, "words": [["هل", 56.63, 56.78], ["كنتَ", 56.83, 57.09], ["ستتسلّقُ", 57.13, 57.89], ["ناطحاتِ", 57.95, 58.39], ["السحاب؟", 58.41, 59.11], ["اكتبْ", 59.43, 59.85], ["في", 59.87, 59.94], ["التعليقات،", 59.98, 60.85], ["واشتركْ.", 60.93, 61.86]]}]