[{"text": "ماذا لو بدأت الأرضُ تبتعدُ عن الشمس؟", "start": 0.0, "end": 2.42, "words": [["ماذا", 0.0, 0.33], ["لو", 0.37, 0.48], ["بدأت", 0.53, 0.88], ["الأرضُ", 0.93, 1.26], ["تبتعدُ", 1.31, 1.73], ["عن", 1.79, 1.88], ["الشمس؟", 1.92, 2.42]]}, {"text": "نحنُ الآن على بُعدِ مئةٍ وخمسينَ مليونَ كيلومتر… في المسافةِ المناسبةِ تماماً ليبقى الماءُ سائلاً.", "start": 2.91, "end": 10.23, "words": [["نحنُ", 2.91, 3.18], ["الآن", 3.22, 3.51], ["على", 3.58, 3.75], ["بُعدِ", 3.83, 4.11], ["مئةٍ", 4.17, 4.57], ["وخمسينَ", 4.69, 5.28], ["مليونَ", 5.33, 5.64], ["كيلومتر…", 5.71, 6.32], ["في", 6.63, 6.73], ["المسافةِ", 6.76, 7.42], ["المناسبةِ", 7.45, 8.16], ["تماماً", 8.21, 8.73], ["ليبقى", 8.93, 9.3], ["الماءُ", 9.32, 9.64], ["سائلاً.", 9.69, 10.23]]}, {"text": "لو ابتعدنا عشرةً في المئةِ فقط، يضعفُ ضوءُ الشمسِ نحوَ السُّدس، وتنخفضُ الحرارةُ أكثرَ من عشرِ درجات.", "start": 10.6, "end": 18.59, "words": [["لو", 10.6, 10.77], ["ابتعدنا", 10.8, 11.3], ["عشرةً", 11.38, 11.91], ["في", 11.96, 12.02], ["المئةِ", 12.05, 12.41], ["فقط،", 12.48, 12.98], ["يضعفُ", 13.19, 13.68], ["ضوءُ", 13.76, 14.03], ["الشمسِ", 14.04, 14.64], ["نحوَ", 14.72, 15.01], ["السُّدس،", 15.04, 15.64], ["وتنخفضُ", 15.76, 16.51], ["الحرارةُ", 16.54, 17.12], ["أكثرَ", 17.19, 17.54], ["من", 17.58, 17.67], ["عشرِ", 17.7, 17.97], ["درجات.", 18.02, 18.59]]}, {"text": "وتطولُ السنةُ إلى نحوِ أربعِمئةٍ وعشرينَ يوماً… ويطولُ الشتاءُ معها.", "start": 18.96, "end": 24.34, "words": [["وتطولُ", 18.96, 19.53], ["السنةُ", 19.55, 20.05], ["إلى", 20.17, 20.31], ["نحوِ", 20.38, 20.65], ["أربعِمئةٍ", 20.7, 21.35], ["وعشرينَ", 21.41, 21.82], ["يوماً…", 21.87, 22.4], ["ويطولُ", 22.78, 23.31], ["الشتاءُ", 23.34, 23.78], ["معها.", 23.82, 24.34]]}, {"text": "ثمّ يتمدّدُ الجليدُ من القطبين، والثلجُ الأبيضُ يعكسُ ضوءَ الشمس… فتبردُ الأرضُ أكثرَ فأكثر.", "start": 24.61, "end": 31.93, "words": [["ثمّ", 24.61, 24.88], ["يتمدّدُ", 24.93, 25.47], ["الجليدُ", 25.5, 25.94], ["من", 25.98, 26.06], ["القطبين،", 26.11, 26.88], ["والثلجُ", 27.12, 27.6], ["الأبيضُ", 27.63, 28.09], ["يعكسُ", 28.14, 28.56], ["ضوءَ", 28.62, 28.85], ["الشمس…", 28.87, 29.54], ["فتبردُ", 29.85, 30.43], ["الأرضُ", 30.46, 30.92], ["أكثرَ", 30.96, 31.3], ["فأكثر.", 31.35, 31.93]]}, {"text": "وعلى بُعدِ المريخ، تبدو الشمسُ أصغر، ويصلُنا أقلُّ من نصفِ ضوئِها… وتتجمّدُ البحارُ من سطحِها.", "start": 32.24, "end": 39.23, "words": [["وعلى", 32.24, 32.51], ["بُعدِ", 32.57, 32.77], ["المريخ،", 32.8, 33.3], ["تبدو", 33.34, 33.58], ["الشمسُ", 33.6, 33.97], ["أصغر،", 34.01, 34.55], ["ويصلُنا", 34.73, 35.4], ["أقلُّ", 35.46, 35.85], ["من", 35.88, 35.97], ["نصفِ", 36.0, 36.25], ["ضوئِها…", 36.32, 36.94], ["وتتجمّدُ", 37.19, 37.94], ["البحارُ", 37.97, 38.44], ["من", 38.48, 38.57], ["سطحِها.", 38.62, 39.23]]}, {"text": "لكنّ الحياةَ قد تصمدُ في الأعماق، قربَ الينابيعِ الحارّةِ في قاعِ المحيط، تحتَ الجليد.", "start": 39.56, "end": 45.86, "words": [["لكنّ", 39.56, 39.94], ["الحياةَ", 39.97, 40.38], ["قد", 40.45, 40.58], ["تصمدُ", 40.62, 41.09], ["في", 41.15, 41.2], ["الأعماق،", 41.24, 42.05], ["قربَ", 42.26, 42.56], ["الينابيعِ", 42.59, 43.19], ["الحارّةِ", 43.21, 43.7], ["في", 43.75, 43.82], ["قاعِ", 43.91, 44.09], ["المحيط،", 44.12, 44.79], ["تحتَ", 44.97, 45.23], ["الجليد.", 45.27, 45.86]]}, {"text": "وماذا عن القمر؟ إنّه يبتعدُ عنّا فعلاً، نحوَ أربعةِ سنتيمتراتٍ كلَّ سنة… لكنّه لن يفلتَ منّا.", "start": 46.19, "end": 53.78, "words": [["وماذا", 46.19, 46.55], ["عن", 46.59, 46.67], ["القمر؟", 46.72, 47.31], ["إنّه", 47.52, 47.81], ["يبتعدُ", 47.89, 48.34], ["عنّا", 48.4, 48.63], ["فعلاً،", 48.7, 49.32], ["نحوَ", 49.49, 49.81], ["أربعةِ", 49.83, 50.31], ["سنتيمتراتٍ", 50.36, 51.11], ["كلَّ", 51.18, 51.41], ["سنة…", 51.47, 51.97], ["لكنّه", 52.24, 52.71], ["لن", 52.79, 52.91], ["يفلتَ", 52.97, 53.28], ["منّا.", 53.34, 53.78]]}, {"text": "والخبرُ الجيّد؟ مدارُ الأرضِ مستقرٌّ منذُ مليارات السنين. اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 54.06, "end": 62.46, "words": [["والخبرُ", 54.06, 54.59], ["الجيّد؟", 54.61, 55.39], ["مدارُ", 55.6, 55.94], ["الأرضِ", 55.96, 56.3], ["مستقرٌّ", 56.34, 56.99], ["منذُ", 57.04, 57.27], ["مليارات", 57.32, 57.76], ["السنين.", 57.81, 58.36], ["اكتبْ", 58.69, 59.06], ["سؤالَك", 59.08, 59.48], ["في", 59.54, 59.58], ["التعليقات،", 59.62, 60.51], ["وقد", 60.66, 60.97], ["يكونُ", 61.02, 61.3], ["الفيديو", 61.32, 61.63], ["القادم.", 61.65, 62.46]]}]