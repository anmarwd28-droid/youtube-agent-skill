[{"text": "ماذا لو كانت لديكَ معدةُ بقرة، وصرتَ تأكلُ العشبَ مثلَها؟", "start": 0.0, "end": 3.99, "words": [["ماذا", 0.0, 0.29], ["لو", 0.33, 0.42], ["كانت", 0.48, 0.71], ["لديكَ", 0.76, 1.09], ["معدةُ", 1.11, 1.47], ["بقرة،", 1.51, 2.04], ["وصرتَ", 2.29, 2.69], ["تأكلُ", 2.74, 3.09], ["العشبَ", 3.11, 3.44], ["مثلَها؟", 3.47, 3.99]]}, {"text": "معدةُ البقرةِ أربعةُ أجزاء: الكَرِش، والشَّبَكيّة، وأمُّ التلافيف، والإنْفَحة.", "start": 4.39, "end": 10.34, "words": [["معدةُ", 4.39, 4.76], ["البقرةِ", 4.79, 5.33], ["أربعةُ", 5.38, 5.8], ["أجزاء:", 5.84, 6.43], ["الكَرِش،", 6.69, 7.36], ["والشَّبَكيّة،", 7.37, 8.27], ["وأمُّ", 8.45, 8.79], ["التلافيف،", 8.81, 9.54], ["والإنْفَحة.", 9.59, 10.34]]}, {"text": "أكبرُها الكَرِش: يتّسعُ لنحوِ مئةٍ وخمسينَ لتراً، وهي سعةُ برميلٍ تقريباً، ومعدتُك اليومَ نحوُ لترٍ واحد.", "start": 10.69, "end": 18.74, "words": [["أكبرُها", 10.69, 11.17], ["الكَرِش:", 11.2, 11.78], ["يتّسعُ", 11.94, 12.47], ["لنحوِ", 12.52, 12.85], ["مئةٍ", 12.9, 13.22], ["وخمسينَ", 13.28, 13.72], ["لتراً،", 13.77, 14.26], ["وهي", 14.5, 14.78], ["سعةُ", 14.88, 15.23], ["برميلٍ", 15.28, 15.65], ["تقريباً،", 15.71, 16.32], ["ومعدتُك", 16.58, 17.24], ["اليومَ", 17.31, 17.66], ["نحوُ", 17.71, 17.96], ["لترٍ", 18.0, 18.25], ["واحد.", 18.32, 18.74]]}, {"text": "فبطنُك سيصبحُ ضخماً، كأنّك تحملُ برميلاً أمامَك.", "start": 19.09, "end": 22.81, "words": [["فبطنُك", 19.09, 19.57], ["سيصبحُ", 19.68, 20.13], ["ضخماً،", 20.19, 20.72], ["كأنّك", 20.9, 21.32], ["تحملُ", 21.39, 21.72], ["برميلاً", 21.77, 22.21], ["أمامَك.", 22.26, 22.81]]}, {"text": "وفي الكرشِ تريليوناتُ الميكروبات تهضمُ السِّليلوز، مادّةَ العشبِ التي لا يهضمُها جسمُك اليوم.", "start": 23.25, "end": 29.52, "words": [["وفي", 23.25, 23.49], ["الكرشِ", 23.52, 23.95], ["تريليوناتُ", 24.01, 24.64], ["الميكروبات", 24.66, 25.27], ["تهضمُ", 25.32, 25.73], ["السِّليلوز،", 25.75, 26.62], ["مادّةَ", 26.87, 27.24], ["العشبِ", 27.26, 27.61], ["التي", 27.63, 27.88], ["لا", 27.93, 28.02], ["يهضمُها", 28.07, 28.57], ["جسمُك", 28.66, 29.0], ["اليوم.", 29.06, 29.52]]}, {"text": "فتأكلُ العشبَ وأوراقَ الشجرِ في أيِّ حديقة، والمراعي تغطّي نحوَ أربعينَ في المئةِ من اليابسة، فقد يقلُّ الجوعُ في العالم.", "start": 29.97, "end": 38.89, "words": [["فتأكلُ", 29.97, 30.55], ["العشبَ", 30.57, 30.98], ["وأوراقَ", 31.02, 31.51], ["الشجرِ", 31.53, 32.0], ["في", 32.04, 32.12], ["أيِّ", 32.17, 32.36], ["حديقة،", 32.4, 33.03], ["والمراعي", 33.36, 33.92], ["تغطّي", 33.98, 34.39], ["نحوَ", 34.45, 34.71], ["أربعينَ", 34.75, 35.4], ["في", 35.57, 35.69], ["المئةِ", 35.72, 36.11], ["من", 36.15, 36.22], ["اليابسة،", 36.27, 36.97], ["فقد", 37.24, 37.55], ["يقلُّ", 37.6, 37.95], ["الجوعُ", 37.98, 38.29], ["في", 38.33, 38.38], ["العالم.", 38.41, 38.89]]}, {"text": "لكنّك ستُعيدُ العشبَ من بطنِك إلى فمِك لتمضغَه مرّةً أخرى، نحوَ ثماني ساعاتٍ كلَّ يوم.", "start": 39.2, "end": 45.99, "words": [["لكنّك", 39.2, 39.61], ["ستُعيدُ", 39.75, 40.23], ["العشبَ", 40.24, 40.69], ["من", 40.74, 40.87], ["بطنِك", 40.93, 41.28], ["إلى", 41.39, 41.52], ["فمِك", 41.61, 41.88], ["لتمضغَه", 42.28, 42.98], ["مرّةً", 43.09, 43.48], ["أخرى،", 43.52, 43.98], ["نحوَ", 44.18, 44.45], ["ثماني", 44.54, 44.85], ["ساعاتٍ", 44.92, 45.33], ["كلَّ", 45.38, 45.6], ["يوم.", 45.65, 45.99]]}, {"text": "والمفاجأة؟ ستتجشّأُ غازَ الميثان، نحوَ مئةِ كيلوغرامٍ في السنة، مثلَ بقرة.", "start": 46.34, "end": 52.24, "words": [["والمفاجأة؟", 46.34, 47.23], ["ستتجشّأُ", 47.46, 48.26], ["غازَ", 48.33, 48.53], ["الميثان،", 48.55, 49.18], ["نحوَ", 49.38, 49.67], ["مئةِ", 49.73, 50.04], ["كيلوغرامٍ", 50.1, 50.64], ["في", 50.69, 50.76], ["السنة،", 50.79, 51.28], ["مثلَ", 51.47, 51.73], ["بقرة.", 51.79, 52.24]]}, {"text": "وثمانيةُ ملياراتِ إنسانٍ يتجشّأون مثلَ خمسةِ أضعافِ أبقارِ العالم، فيسخنُ المناخُ أسرع.", "start": 52.55, "end": 59.48, "words": [["وثمانيةُ", 52.55, 53.28], ["ملياراتِ", 53.35, 53.84], ["إنسانٍ", 53.88, 54.36], ["يتجشّأون", 54.43, 55.15], ["مثلَ", 55.23, 55.45], ["خمسةِ", 55.51, 55.93], ["أضعافِ", 55.96, 56.35], ["أبقارِ", 56.39, 56.76], ["العالم،", 56.78, 57.42], ["فيسخنُ", 57.7, 58.33], ["المناخُ", 58.35, 58.87], ["أسرع.", 58.91, 59.48]]}, {"text": "هل تأكلُ العشبَ لو استطعت؟ اكتبْ في التعليقات، واشتركْ.", "start": 59.8, "end": 64.41, "words": [["هل", 59.8, 59.99], ["تأكلُ", 60.06, 60.44], ["العشبَ", 60.47, 60.91], ["لو", 60.94, 61.06], ["استطعت؟", 61.09, 61.78], ["اكتبْ", 62.1, 62.46], ["في", 62.48, 62.54], ["التعليقات،", 62.57, 63.36], ["واشتركْ.", 63.51, 64.41]]}]