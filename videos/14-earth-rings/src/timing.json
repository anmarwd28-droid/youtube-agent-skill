[{"text": "ماذا لو كان للأرض حلقاتٌ مثلُ زحل؟", "start": 0.0, "end": 2.47, "words": [["ماذا", 0.0, 0.29], ["لو", 0.34, 0.43], ["كان", 0.49, 0.66], ["للأرض", 0.72, 1.03], ["حلقاتٌ", 1.13, 1.61], ["مثلُ", 1.66, 1.89], ["زحل؟", 1.96, 2.47]]}, {"text": "ستدورُ الحلقاتُ فوقَ خطِّ الاستواء، صخورٌ وجليدٌ لا تُحصى.", "start": 2.91, "end": 7.43, "words": [["ستدورُ", 2.91, 3.45], ["الحلقاتُ", 3.47, 4.03], ["فوقَ", 4.09, 4.34], ["خطِّ", 4.41, 4.67], ["الاستواء،", 4.69, 5.4], ["صخورٌ", 5.68, 6.19], ["وجليدٌ", 6.25, 6.78], ["لا", 6.84, 6.91], ["تُحصى.", 6.98, 7.43]]}, {"text": "ومن بغداد، سترى قوساً هائلاً يمتدُّ عبرَ السماءِ الجنوبية… حتى في وضحِ النهار.", "start": 7.75, "end": 14.1, "words": [["ومن", 7.75, 8.06], ["بغداد،", 8.12, 8.59], ["سترى", 8.62, 8.96], ["قوساً", 9.06, 9.39], ["هائلاً", 9.45, 9.91], ["يمتدُّ", 10.24, 10.79], ["عبرَ", 10.86, 11.11], ["السماءِ", 11.13, 11.53], ["الجنوبية…", 11.55, 12.28], ["حتى", 12.67, 12.97], ["في", 13.03, 13.1], ["وضحِ", 13.17, 13.48], ["النهار.", 13.5, 14.1]]}, {"text": "وفي الليل، تلمعُ بضوءِ الشمس فتضيءُ الليلَ أكثرَ من القمر، ويقطعُها ظلُّ الأرضِ الأسود.", "start": 14.48, "end": 21.05, "words": [["وفي", 14.48, 14.76], ["الليل،", 14.79, 15.2], ["تلمعُ", 15.23, 15.65], ["بضوءِ", 15.69, 16.05], ["الشمس", 16.07, 16.41], ["فتضيءُ", 16.52, 17.04], ["الليلَ", 17.07, 17.4], ["أكثرَ", 17.46, 17.83], ["من", 17.87, 17.97], ["القمر،", 18.03, 18.64], ["ويقطعُها", 18.92, 19.71], ["ظلُّ", 19.81, 20.09], ["الأرضِ", 20.11, 20.45], ["الأسود.", 20.47, 21.05]]}, {"text": "لكنَّ ظلَّها يسقطُ على نصفِ الأرضِ في الشتاء، فيصبحُ أشدَّ برودة.", "start": 21.41, "end": 26.18, "words": [["لكنَّ", 21.41, 21.78], ["ظلَّها", 21.84, 22.2], ["يسقطُ", 22.27, 22.69], ["على", 22.77, 22.88], ["نصفِ", 22.95, 23.17], ["الأرضِ", 23.2, 23.5], ["في", 23.55, 23.59], ["الشتاء،", 23.61, 24.2], ["فيصبحُ", 24.51, 25.15], ["أشدَّ", 25.22, 25.65], ["برودة.", 25.69, 26.18]]}, {"text": "وتسقطُ منها صخورٌ صغيرةٌ باستمرار، فنرى شهباً أكثرَ في السماء.", "start": 26.48, "end": 31.16, "words": [["وتسقطُ", 26.48, 27.05], ["منها", 27.12, 27.34], ["صخورٌ", 27.45, 27.86], ["صغيرةٌ", 27.93, 28.39], ["باستمرار،", 28.44, 29.16], ["فنرى", 29.36, 29.73], ["شهباً", 29.83, 30.14], ["أكثرَ", 30.19, 30.5], ["في", 30.55, 30.61], ["السماء.", 30.64, 31.16]]}, {"text": "ويصبحُ إطلاقُ الصواريخِ أخطر، فالحلقاتُ تملأُ المداراتِ القريبة.", "start": 31.52, "end": 36.3, "words": [["ويصبحُ", 31.52, 32.19], ["إطلاقُ", 32.24, 32.63], ["الصواريخِ", 32.66, 33.25], ["أخطر،", 33.31, 33.84], ["فالحلقاتُ", 34.1, 34.8], ["تملأُ", 34.87, 35.22], ["المداراتِ", 35.25, 35.75], ["القريبة.", 35.77, 36.3]]}, {"text": "والمدهش؟ دراسةٌ حديثةٌ تقولُ إنّ الأرضَ ربما امتلكت حلقةً فعلاً… قبلَ نحوِ أربعِمئةٍ وستّينَ مليونَ سنة.", "start": 36.66, "end": 45.07, "words": [["والمدهش؟", 36.66, 37.43], ["دراسةٌ", 37.73, 38.23], ["حديثةٌ", 38.31, 38.78], ["تقولُ", 38.86, 39.24], ["إنّ", 39.3, 39.43], ["الأرضَ", 39.46, 40.02], ["ربما", 40.19, 40.6], ["امتلكت", 40.62, 41.12], ["حلقةً", 41.19, 41.67], ["فعلاً…", 41.74, 42.3], ["قبلَ", 42.62, 42.86], ["نحوِ", 42.91, 43.15], ["أربعِمئةٍ", 43.2, 43.78], ["وستّينَ", 43.84, 44.29], ["مليونَ", 44.34, 44.63], ["سنة.", 44.69, 45.07]]}, {"text": "ماذا لو…؟ اكتبْ سؤالَك في التعليقات، وقد يكونُ الفيديو القادم.", "start": 45.45, "end": 50.25, "words": [["ماذا", 45.45, 45.69], ["لو…؟", 45.73, 46.23], ["اكتبْ", 46.51, 46.89], ["سؤالَك", 46.92, 47.29], ["في", 47.38, 47.44], ["التعليقات،", 47.46, 48.16], ["وقد", 48.31, 48.62], ["يكونُ", 48.67, 48.95], ["الفيديو", 48.97, 49.38], ["القادم.", 49.45, 50.25]]}]