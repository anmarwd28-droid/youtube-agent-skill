[{"text": "ماذا لو عاشَ الإنسانُ ألفَ سنة؟", "start": 0.0, "end": 1.82, "words": [["ماذا", 0.0, 0.28], ["لو", 0.31, 0.4], ["عاشَ", 0.45, 0.65], ["الإنسانُ", 0.67, 1.13], ["ألفَ", 1.16, 1.38], ["سنة؟", 1.43, 1.82]]}, {"text": "أكبرُ معمّرةٍ في التاريخِ عاشت مئةً واثنتينِ وعشرينَ سنة. ألفُ سنةٍ تعني ثمانيةَ أضعافِ ذلك.", "start": 2.14, "end": 9.54, "words": [["أكبرُ", 2.14, 2.6], ["معمّرةٍ", 2.63, 3.24], ["في", 3.31, 3.38], ["التاريخِ", 3.41, 3.96], ["عاشت", 4.0, 4.37], ["مئةً", 4.43, 4.78], ["واثنتينِ", 4.85, 5.36], ["وعشرينَ", 5.42, 5.85], ["سنة.", 5.91, 6.29], ["ألفُ", 6.65, 6.95], ["سنةٍ", 7.04, 7.4], ["تعني", 7.51, 7.86], ["ثمانيةَ", 7.96, 8.53], ["أضعافِ", 8.58, 9.02], ["ذلك.", 9.08, 9.54]]}, {"text": "سيدقُّ قلبُك نحوَ سبعةٍ وثلاثينَ مليارَ دقّة، بدلَ ثلاثةِ مليارات.", "start": 9.91, "end": 15.19, "words": [["سيدقُّ", 9.91, 10.54], ["قلبُك", 10.59, 10.96], ["نحوَ", 11.06, 11.32], ["سبعةٍ", 11.39, 11.81], ["وثلاثينَ", 11.87, 12.42], ["مليارَ", 12.47, 12.82], ["دقّة،", 12.88, 13.38], ["بدلَ", 13.68, 14.01], ["ثلاثةِ", 14.07, 14.5], ["مليارات.", 14.56, 15.19]]}, {"text": "وأسنانُك؟ تنبتُ مرّتينِ فقط، ومينا الأسنانِ لا يتجدّد.", "start": 15.5, "end": 20.04, "words": [["وأسنانُك؟", 15.5, 16.41], ["تنبتُ", 16.64, 17.05], ["مرّتينِ", 17.11, 17.59], ["فقط،", 17.66, 18.22], ["ومينا", 18.38, 18.73], ["الأسنانِ", 18.74, 19.18], ["لا", 19.23, 19.31], ["يتجدّد.", 19.35, 20.04]]}, {"text": "وستعيشُ مع أحفادِ أحفادِك… حتى الجيلِ الثلاثين.", "start": 20.35, "end": 24.14, "words": [["وستعيشُ", 20.35, 21.04], ["مع", 21.08, 21.23], ["أحفادِ", 21.28, 21.7], ["أحفادِك…", 21.73, 22.45], ["حتى", 22.77, 23.04], ["الجيلِ", 23.06, 23.36], ["الثلاثين.", 23.38, 24.14]]}, {"text": "ولو لم يمتْ أحد، لتضاعفَ عددُ سكّانِ الأرضِ خلالَ ستّينَ سنةً فقط.", "start": 24.57, "end": 29.32, "words": [["ولو", 24.57, 24.86], ["لم", 24.91, 25.04], ["يمتْ", 25.11, 25.4], ["أحد،", 25.43, 25.79], ["لتضاعفَ", 25.81, 26.43], ["عددُ", 26.48, 26.79], ["سكّانِ", 26.84, 27.24], ["الأرضِ", 27.27, 27.59], ["خلالَ", 27.66, 27.95], ["ستّينَ", 28.02, 28.39], ["سنةً", 28.45, 28.79], ["فقط.", 28.84, 29.32]]}, {"text": "وحتى بلا شيخوخة، الحوادثُ لا ترحم: بخطرِ واحدٍ في الألفِ كلَّ سنة، لن يبلغَ الألفَ إلّا نحوُ ثلثِ الناس.", "start": 29.68, "end": 37.87, "words": [["وحتى", 29.68, 30.05], ["بلا", 30.11, 30.27], ["شيخوخة،", 30.33, 31.0], ["الحوادثُ", 31.2, 31.86], ["لا", 31.94, 32.0], ["ترحم:", 32.07, 32.61], ["بخطرِ", 32.88, 33.31], ["واحدٍ", 33.37, 33.75], ["في", 33.81, 33.87], ["الألفِ", 33.89, 34.26], ["كلَّ", 34.33, 34.55], ["سنة،", 34.61, 35.06], ["لن", 35.26, 35.42], ["يبلغَ", 35.49, 35.82], ["الألفَ", 35.84, 36.21], ["إلّا", 36.26, 36.46], ["نحوُ", 36.53, 36.87], ["ثلثِ", 36.99, 37.33], ["الناس.", 37.36, 37.87]]}, {"text": "والغريب؟ قرشُ غرينلاند يعيشُ نحوَ أربعمئةِ سنة… فالطبيعةُ سبقتنا.", "start": 38.19, "end": 43.61, "words": [["والغريب؟", 38.19, 38.82], ["قرشُ", 39.25, 39.56], ["غرينلاند", 39.61, 40.08], ["يعيشُ", 40.16, 40.46], ["نحوَ", 40.5, 40.74], ["أربعمئةِ", 40.77, 41.48], ["سنة…", 41.53, 41.89], ["فالطبيعةُ", 42.27, 42.89], ["سبقتنا.", 42.96, 43.61]]}, {"text": "هل تريدُ أن تعيشَ ألفَ سنة؟ اكتبْ في التعليقات.", "start": 43.93, "end": 47.18, "words": [["هل", 43.93, 44.11], ["تريدُ", 44.16, 44.44], ["أن", 44.5, 44.57], ["تعيشَ", 44.62, 44.97], ["ألفَ", 45.0, 45.23], ["سنة؟", 45.27, 45.65], ["اكتبْ", 45.86, 46.2], ["في", 46.22, 46.28], ["التعليقات.", 46.3, 47.18]]}]