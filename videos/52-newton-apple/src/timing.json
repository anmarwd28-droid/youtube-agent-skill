[{"text": "ماذا لو لم تقعِ التفاحةُ على رأسِ نيوتن؟", "start": 0.0, "end": 2.59, "words": [["ماذا", 0.0, 0.3], ["لو", 0.34, 0.46], ["لم", 0.52, 0.64], ["تقعِ", 0.7, 1.01], ["التفاحةُ", 1.03, 1.62], ["على", 1.68, 1.79], ["رأسِ", 1.85, 2.04], ["نيوتن؟", 2.09, 2.59]]}, {"text": "عامَ ألفٍ وستِّمئةٍ وستّةٍ وستّين، أغلقَ الطاعونُ الجامعة، فعادَ نيوتن الشابُّ إلى مزرعةِ أمِّه.", "start": 3.01, "end": 10.66, "words": [["عامَ", 3.01, 3.26], ["ألفٍ", 3.31, 3.62], ["وستِّمئةٍ", 3.68, 4.48], ["وستّةٍ", 4.55, 5.13], ["وستّين،", 5.21, 6.01], ["أغلقَ", 6.37, 6.78], ["الطاعونُ", 6.8, 7.23], ["الجامعة،", 7.26, 7.99], ["فعادَ", 8.26, 8.7], ["نيوتن", 8.74, 9.09], ["الشابُّ", 9.15, 9.53], ["إلى", 9.55, 9.67], ["مزرعةِ", 9.73, 10.21], ["أمِّه.", 10.24, 10.66]]}, {"text": "هناك رأى تفاحةً تسقط، فسأل: إذا كانتِ الأرضُ تسحبُ التفاحة، فلماذا لا يسقطُ القمر؟", "start": 10.93, "end": 18.04, "words": [["هناك", 10.93, 11.32], ["رأى", 11.42, 11.61], ["تفاحةً", 11.67, 12.2], ["تسقط،", 12.26, 12.81], ["فسأل:", 13.0, 13.65], ["إذا", 14.01, 14.26], ["كانتِ", 14.33, 14.66], ["الأرضُ", 14.7, 14.99], ["تسحبُ", 15.05, 15.43], ["التفاحة،", 15.45, 16.18], ["فلماذا", 16.38, 16.89], ["لا", 16.95, 17.02], ["يسقطُ", 17.07, 17.44], ["القمر؟", 17.47, 18.04]]}, {"text": "والجواب: القمرُ يسقطُ فعلاً! كلَّ ثانيةٍ يسقطُ نحوَنا مليمتراً وثلثاً، لكنّه يندفعُ للأمامِ بسرعة، فيبقى يدورُ حولَنا.", "start": 18.34, "end": 28.23, "words": [["والجواب:", 18.34, 19.11], ["القمرُ", 19.34, 19.83], ["يسقطُ", 19.88, 20.26], ["فعلاً!", 20.33, 20.82], ["كلَّ", 21.13, 21.41], ["ثانيةٍ", 21.47, 22.05], ["يسقطُ", 22.25, 22.66], ["نحوَنا", 22.74, 23.09], ["مليمتراً", 23.16, 23.66], ["وثلثاً،", 23.71, 24.37], ["لكنّه", 24.62, 25.02], ["يندفعُ", 25.08, 25.62], ["للأمامِ", 25.66, 26.1], ["بسرعة،", 26.14, 26.71], ["فيبقى", 26.91, 27.35], ["يدورُ", 27.41, 27.68], ["حولَنا.", 27.75, 28.23]]}, {"text": "من هذا السؤال وُلِدَ قانونُ الجاذبيّة. وبلا تلك التفاحة، ربّما تأخّرَ عشراتِ السنين.", "start": 28.54, "end": 34.39, "words": [["من", 28.54, 28.66], ["هذا", 28.71, 28.91], ["السؤال", 28.93, 29.34], ["وُلِدَ", 29.4, 29.62], ["قانونُ", 29.7, 29.98], ["الجاذبيّة.", 30.0, 30.7], ["وبلا", 31.0, 31.35], ["تلك", 31.39, 31.59], ["التفاحة،", 31.65, 32.38], ["ربّما", 32.52, 32.86], ["تأخّرَ", 32.93, 33.34], ["عشراتِ", 33.4, 33.84], ["السنين.", 33.87, 34.39]]}, {"text": "فلا أحدَ يتنبّأُ بعودةِ مذنّبِ هالي،", "start": 34.69, "end": 37.31, "words": [["فلا", 34.69, 34.92], ["أحدَ", 34.96, 35.25], ["يتنبّأُ", 35.29, 35.85], ["بعودةِ", 35.91, 36.35], ["مذنّبِ", 36.4, 36.8], ["هالي،", 36.85, 37.31]]}, {"text": "ولا أحدَ يجدُ كوكبَ نبتون بالقلمِ والورقة، قبلَ أن يراهُ بالتلسكوب.", "start": 37.48, "end": 42.76, "words": [["ولا", 37.48, 37.73], ["أحدَ", 37.79, 38.12], ["يجدُ", 38.16, 38.48], ["كوكبَ", 38.55, 38.95], ["نبتون", 39.0, 39.35], ["بالقلمِ", 39.42, 40.01], ["والورقة،", 40.2, 40.97], ["قبلَ", 41.27, 41.56], ["أن", 41.61, 41.69], ["يراهُ", 41.75, 42.04], ["بالتلسكوب.", 42.09, 42.76]]}, {"text": "ولن نعرفَ أنّ قذيفةً بسرعةِ ثمانيةِ كيلومتراتٍ في الثانية لا تسقطُ أبداً، بل تدورُ حولَ الأرض.", "start": 43.12, "end": 50.09, "words": [["ولن", 43.12, 43.41], ["نعرفَ", 43.46, 43.98], ["أنّ", 44.04, 44.29], ["قذيفةً", 44.35, 44.93], ["بسرعةِ", 44.99, 45.44], ["ثمانيةِ", 45.5, 45.98], ["كيلومتراتٍ", 46.05, 46.64], ["في", 46.71, 46.77], ["الثانية", 46.79, 47.3], ["لا", 47.61, 47.74], ["تسقطُ", 47.8, 48.18], ["أبداً،", 48.23, 48.74], ["بل", 48.88, 49.02], ["تدورُ", 49.08, 49.38], ["حولَ", 49.44, 49.63], ["الأرض.", 49.67, 50.09]]}, {"text": "فلا أقمارَ صناعيّة: لا خرائطَ في هاتفِك، ولا نشرةَ طقس، ولا بثَّ مباشر.", "start": 50.45, "end": 56.11, "words": [["فلا", 50.45, 50.69], ["أقمارَ", 50.72, 51.11], ["صناعيّة:", 51.18, 51.84], ["لا", 52.04, 52.14], ["خرائطَ", 52.21, 52.6], ["في", 52.65, 52.74], ["هاتفِك،", 52.8, 53.45], ["ولا", 53.59, 53.86], ["نشرةَ", 53.89, 54.24], ["طقس،", 54.32, 54.8], ["ولا", 54.93, 55.17], ["بثَّ", 55.23, 55.47], ["مباشر.", 55.51, 56.11]]}, {"text": "وحين طارَ أوّلُ البشرِ إلى القمر، قال أحدُهم: نيوتن هو مَن يقودُ الآن.", "start": 56.47, "end": 62.08, "words": [["وحين", 56.47, 56.78], ["طارَ", 56.9, 57.13], ["أوّلُ", 57.18, 57.49], ["البشرِ", 57.52, 57.98], ["إلى", 58.02, 58.14], ["القمر،", 58.17, 58.76], ["قال", 58.99, 59.2], ["أحدُهم:", 59.25, 59.97], ["نيوتن", 60.48, 60.81], ["هو", 60.87, 61.0], ["مَن", 61.07, 61.17], ["يقودُ", 61.23, 61.56], ["الآن.", 61.58, 62.08]]}, {"text": "والمفاجأة؟ التفاحةُ لم تقعْ على رأسِه أصلاً! نيوتن قال إنّه رآها تسقطُ فقط.", "start": 62.4, "end": 68.74, "words": [["والمفاجأة؟", 62.4, 63.38], ["التفاحةُ", 63.55, 64.14], ["لم", 64.19, 64.28], ["تقعْ", 64.34, 64.63], ["على", 64.66, 64.8], ["رأسِه", 64.86, 65.16], ["أصلاً!", 65.21, 65.74], ["نيوتن", 66.34, 66.65], ["قال", 66.73, 66.99], ["إنّه", 67.11, 67.35], ["رآها", 67.47, 67.8], ["تسقطُ", 67.88, 68.24], ["فقط.", 68.3, 68.74]]}, {"text": "وتلك الشجرةُ ما زالتْ حيّةً حتى اليوم، بعدَ أكثرَ من ثلاثِمئةٍ وخمسينَ عاماً.", "start": 69.07, "end": 74.3, "words": [["وتلك", 69.07, 69.45], ["الشجرةُ", 69.51, 70.03], ["ما", 70.09, 70.15], ["زالتْ", 70.23, 70.51], ["حيّةً", 70.54, 70.93], ["حتى", 70.98, 71.22], ["اليوم،", 71.24, 71.72], ["بعدَ", 71.89, 72.2], ["أكثرَ", 72.25, 72.59], ["من", 72.62, 72.71], ["ثلاثِمئةٍ", 72.76, 73.4], ["وخمسينَ", 73.46, 73.85], ["عاماً.", 73.91, 74.3]]}, {"text": "برأيك، مَن كان سيكتشفُ الجاذبيّةَ لولا نيوتن؟ اكتبْ في التعليقات… واشتركْ.", "start": 74.62, "end": 81.04, "words": [["برأيك،", 74.62, 75.35], ["مَن", 75.52, 75.66], ["كان", 75.73, 75.89], ["سيكتشفُ", 75.98, 76.52], ["الجاذبيّةَ", 76.55, 77.27], ["لولا", 77.31, 77.53], ["نيوتن؟", 77.57, 78.07], ["اكتبْ", 78.51, 78.9], ["في", 78.92, 78.98], ["التعليقات…", 79.02, 79.85], ["واشتركْ.", 80.18, 81.04]]}]